@page
@model Ozikol.Central.Areas.Affiliate.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Partner Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Partner Sign In — Ozikol Affiliate Network</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/affiliate.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="/images/oz-logo-red.png" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: radial-gradient(circle at top, #0f231c 0%, #0b0f19 70%);
            position: relative;
            overflow: hidden;
        }

        .auth-container::before {
            content: "";
            position: absolute;
            top: -20%;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            background: rgba(17, 24, 39, 0.85);
            border: 1px solid rgba(16, 185, 129, 0.2);
            backdrop-filter: blur(24px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            position: relative;
            z-index: 1;
        }

        .auth-badge {
            display: inline-block;
            background: rgba(16, 185, 129, 0.15);
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 12px;
        }
    </style>
</head>
<body class="admin-body">
    <div class="auth-container">
        <div class="auth-card">
            <div style="text-align: center;">
                <a href="/" style="display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 20px;">
                    <img src="/images/oz-logo-red.png" alt="Ozikol" style="height: 38px;" />
                    <span style="font-size: 20px; font-weight: 700; color: #ffffff;">Ozikol Network</span>
                </a>
                <div><span class="auth-badge">Affiliate Partner Network</span></div>
                <h1 style="font-size: 22px; font-weight: 700; color: #ffffff; margin: 0 0 6px 0;">Partner Portal Sign In</h1>
                <p style="font-size: 13.5px; color: var(--admin-text-muted); margin: 0 0 28px 0;">Track referrals, commission earnings, and promotional tools</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="admin-alert admin-alert-danger" role="alert">
                    <span>⚠ @Model.ErrorMessage</span>
                </div>
            }

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Registered Partner Email <span class="required">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="partner@domain.com" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password <span class="required">*</span></label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input asp-for="Password" id="partnerPassword" class="form-control" style="padding-right: 42px;" placeholder="••••••••••••" autocomplete="current-password" />
                        <button type="button" onclick="toggleAffiliatePass()" title="Show password" aria-label="Toggle password visibility" style="position: absolute; right: 10px; background: none; border: none; padding: 6px; color: #94a3b8; cursor: pointer; display: flex; align-items: center; justify-content: center; border-radius: 6px; z-index: 2;">
                            <svg id="affiliateEyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-group" style="margin-top: 8px; margin-bottom: 20px;">
                    <label class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <span style="font-size: 13px; color: var(--admin-text-muted);">Keep me signed in</span>
                    </label>
                </div>

                <!-- Google reCAPTCHA Verification Widget -->
                <div style="margin-bottom: 20px; display: flex; justify-content: center;">
                    <div class="g-recaptcha" data-sitekey="@Model.RecaptchaSiteKey"></div>
                </div>

                <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; padding: 12px; font-size: 14px;">
                    Enter Partner Hub →
                </button>
            </form>

            <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.08); text-align: center; font-size: 13px;">
                <span style="color: var(--admin-text-muted);">Not an affiliate partner yet?</span>
                <a href="/affiliates" style="color: #10b981; text-decoration: none; font-weight: 600; margin-left: 4px;">Apply Now</a>
                <div style="margin-top: 12px;">
                    <a href="/" style="color: var(--admin-text-dim); text-decoration: none; font-size: 12px;">← Back to Ozikol Home</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleAffiliatePass() {
            var passInput = document.getElementById('partnerPassword');
            var eye = document.getElementById('affiliateEyeIcon');
            if (!passInput || !eye) return;
            var isPass = passInput.getAttribute('type') === 'password';
            passInput.setAttribute('type', isPass ? 'text' : 'password');
            eye.innerHTML = isPass
                ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>'
                : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
        }
    </script>
</body>
</html>
