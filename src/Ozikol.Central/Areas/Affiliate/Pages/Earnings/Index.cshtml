@page "/affiliate/earnings"
@model Ozikol.Central.Areas.Affiliate.Pages.Earnings.IndexModel
@{
    ViewData["Title"] = "Earnings & Payouts";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Earnings Ledger &amp; Commission Payouts</h1>
        <p class="admin-subtitle">Inspect your accumulated commission balances, settlement timelines, and historical disbursement receipts.</p>
    </div>
    <div class="admin-actions">
        <a href="/affiliate/profile/banking" class="btn-admin btn-admin-secondary">
            <span>⚙️</span> Payout Settings
        </a>
        <a href="/affiliate/earnings/request-payout" class="btn-admin btn-admin-primary">
            <span>💳</span> Request Payout
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@* ── Wallet Metrics ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 18px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 44px; height: 44px; font-size: 20px;">💵</div>
        <div class="stat-details">
            <span class="stat-label">Available for Payout</span>
            <span class="stat-value" style="font-size: 24px; color: #34d399;">$@Model.Partner.PendingBalance.ToString("N2")</span>
            <span style="font-size: 11px; color: var(--admin-text-muted); margin-top: 4px;">Min payout threshold: $50.00</span>
        </div>
    </div>

    <div class="stat-card" style="padding: 18px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 44px; height: 44px; font-size: 20px;">💰</div>
        <div class="stat-details">
            <span class="stat-label">Lifetime Earned</span>
            <span class="stat-value" style="font-size: 24px;">$@Model.Partner.TotalEarned.ToString("N2")</span>
            <span style="font-size: 11px; color: var(--admin-text-muted); margin-top: 4px;">Cumulative across all referrals</span>
        </div>
    </div>

    <div class="stat-card" style="padding: 18px;">
        <div class="stat-icon-wrapper" style="width: 44px; height: 44px; font-size: 20px; background: rgba(59, 130, 246, 0.2); color: #93c5fd;">🏦</div>
        <div class="stat-details">
            <span class="stat-label">Total Disbursed</span>
            <span class="stat-value" style="font-size: 24px; color: #93c5fd;">$@Model.Partner.PaidBalance.ToString("N2")</span>
            <span style="font-size: 11px; color: var(--admin-text-muted); margin-top: 4px;">Successfully transferred</span>
        </div>
    </div>

    <div class="stat-card" style="padding: 18px;">
        <div class="stat-icon-wrapper" style="width: 44px; height: 44px; font-size: 20px; background: rgba(168, 85, 247, 0.2); color: #c084fc;">📈</div>
        <div class="stat-details">
            <span class="stat-label">Partner Tier Share</span>
            <span class="stat-value" style="font-size: 24px; color: #c084fc;">@Model.Partner.CommissionRatePercentage.ToString("0.##")%</span>
            <span style="font-size: 11px; color: var(--admin-text-muted); margin-top: 4px;">Recurring monthly split</span>
        </div>
    </div>
</div>

@* ── Pending Commission Approvals ── *@
<div class="admin-card" style="padding: 0; overflow: hidden; margin-bottom: 24px;">
    <div style="padding: 18px 20px; border-bottom: 1px solid var(--admin-card-border); display: flex; justify-content: space-between; align-items: center;">
        <h2 style="font-size: 15px; font-weight: 600; color: var(--admin-text); margin: 0;">Pending &amp; Cleared Commissions (@Model.PendingReferrals.Count)</h2>
        @if (Model.Partner.PendingBalance >= 50m)
        {
            <a href="/affiliate/earnings/request-payout" class="btn-admin btn-admin-primary" style="padding: 4px 12px; font-size: 12px;">
                Request Payout of $@Model.Partner.PendingBalance.ToString("N2") →
            </a>
        }
    </div>
    <div style="overflow-x: auto;">
        <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--admin-card-border); background: rgba(255, 255, 255, 0.02);">
                    <th style="padding: 12px 20px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Tenant Organization</th>
                    <th style="padding: 12px 14px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Tenant Key</th>
                    <th style="padding: 12px 14px; text-align: right; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Monthly Bill</th>
                    <th style="padding: 12px 14px; text-align: right; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Commission</th>
                    <th style="padding: 12px 14px; text-align: center; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Status</th>
                    <th style="padding: 12px 20px; text-align: right; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Accrued Date</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.PendingReferrals.Any())
                {
                    <tr>
                        <td colspan="6" style="padding: 30px; text-align: center; color: var(--admin-text-muted); font-size: 13px;">
                            No pending commission balances at this time.
                        </td>
                    </tr>
                }
                @foreach (var p in Model.PendingReferrals)
                {
                    <tr style="border-bottom: 1px solid var(--admin-card-border);">
                        <td style="padding: 14px 20px; font-weight: 600; color: var(--admin-text); font-size: 13px;">
                            @p.ReferredOrganizationName
                        </td>
                        <td style="padding: 14px 14px; font-family: monospace; font-size: 12px; color: #93c5fd;">
                            @p.ReferredTenantKey
                        </td>
                        <td style="padding: 14px 14px; text-align: right; font-size: 13px; color: var(--admin-text);">
                            $@p.SubscriptionAmount.ToString("N2")
                        </td>
                        <td style="padding: 14px 14px; text-align: right; font-size: 13px; font-weight: 600; color: #34d399;">
                            +$@p.CommissionEarned.ToString("N2")
                        </td>
                        <td style="padding: 14px 14px; text-align: center;">
                            @if (p.CommissionStatus == "Approved")
                            {
                                <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">Cleared</span>
                            }
                            else
                            {
                                <span style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">Pending 30-Day Hold</span>
                            }
                        </td>
                        <td style="padding: 14px 20px; text-align: right; font-size: 12px; color: var(--admin-text-muted);">
                            @p.CreatedUtc.ToString("dd MMM yyyy")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Historical Disbursements ── *@
<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 18px 20px; border-bottom: 1px solid var(--admin-card-border);">
        <h2 style="font-size: 15px; font-weight: 600; color: var(--admin-text); margin: 0;">Completed Payout Disbursements (@Model.PaidDisbursements.Count)</h2>
    </div>
    <div style="overflow-x: auto;">
        <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--admin-card-border); background: rgba(255, 255, 255, 0.02);">
                    <th style="padding: 12px 20px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Referred Client</th>
                    <th style="padding: 12px 14px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Tenant Key</th>
                    <th style="padding: 12px 14px; text-align: right; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Disbursed Amount</th>
                    <th style="padding: 12px 14px; text-align: center; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Settlement Status</th>
                    <th style="padding: 12px 20px; text-align: right; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Disbursement Date</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.PaidDisbursements.Any())
                {
                    <tr>
                        <td colspan="5" style="padding: 30px; text-align: center; color: var(--admin-text-muted); font-size: 13px;">
                            No historical payouts have been processed yet.
                        </td>
                    </tr>
                }
                @foreach (var d in Model.PaidDisbursements)
                {
                    <tr style="border-bottom: 1px solid var(--admin-card-border);">
                        <td style="padding: 14px 20px; font-weight: 600; color: var(--admin-text); font-size: 13px;">
                            @d.ReferredOrganizationName
                        </td>
                        <td style="padding: 14px 14px; font-family: monospace; font-size: 12px; color: #93c5fd;">
                            @d.ReferredTenantKey
                        </td>
                        <td style="padding: 14px 14px; text-align: right; font-size: 13px; font-weight: 600; color: #34d399;">
                            $@d.CommissionEarned.ToString("N2")
                        </td>
                        <td style="padding: 14px 14px; text-align: center;">
                            <span style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
                                ✓ Paid Out
                            </span>
                        </td>
                        <td style="padding: 14px 20px; text-align: right; font-size: 12px; color: var(--admin-text-muted);">
                            @(d.PaidUtc.HasValue ? d.PaidUtc.Value.ToString("dd MMM yyyy, HH:mm") + " UTC" : d.CreatedUtc.ToString("dd MMM yyyy"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
