@page
@model Ozikol.Central.Areas.Admin.Pages.Affiliates.CreateModel
@{
    ViewData["Title"] = "Register Affiliate Partner";
    ViewData["BreadcrumbSection"] = "Affiliates";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Register Affiliate Partner</h1>
        <p class="admin-subtitle">Add an agency, influencer, or enterprise growth partner to the master referral network.</p>
    </div>
    <div class="admin-actions">
        <a href="/admin/affiliates" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Partners
        </a>
    </div>
</div>

<form method="post" style="max-width: 800px;">
    @Html.AntiForgeryToken()

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">👤</div>
            <div>
                <h3 class="card-header-title">Partner Identity & Contact</h3>
                <p class="card-header-subtitle">Name, contact details, and marketing channels.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.FullName" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Full Name / Agency <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.FullName" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="e.g. Acme Media Group or Sarah Jenkins" />
                    <span asp-validation-for="Input.FullName" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Email" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Email Address <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.Email" type="email" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="partner@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 8px;">
                <div class="form-group">
                    <label asp-for="Input.PhoneNumber" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Phone Number (Optional)
                    </label>
                    <input asp-for="Input.PhoneNumber" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="+1 (555) 000-0000" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.WebsiteOrChannel" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Primary Reach / Channel
                    </label>
                    <input asp-for="Input.WebsiteOrChannel" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="e.g. youtube.com/c/techhub or acme.agency" />
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">💎</div>
            <div>
                <h3 class="card-header-title">Referral Code & Commission Policy</h3>
                <p class="card-header-subtitle">Unique tracking token and revenue share terms.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.PartnerCode" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Partner Promo Code <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.PartnerCode" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px; font-family: monospace; text-transform: uppercase;" />
                    <span asp-validation-for="Input.PartnerCode" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Used in referral links: ?ref=CODE and checkout voucher codes.</span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.CommissionRatePercentage" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Commission Rate (%) <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.CommissionRatePercentage" type="number" step="0.5" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                    <span asp-validation-for="Input.CommissionRatePercentage" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Default is 20.00% on referred tenant subscription charges.</span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="Input.Status" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Initial Status
                </label>
                <select asp-for="Input.Status" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                    <option value="Active">Active (Ready to Refer & Earn)</option>
                    <option value="UnderReview">Under Review (Requires Background Verification)</option>
                    <option value="Suspended">Suspended (Tracking Paused)</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 8px;">
                <label asp-for="Input.PayoutDetailsJson" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Payout Instructions (Bank / PayPal / Crypto)
                </label>
                <textarea asp-for="Input.PayoutDetailsJson" rows="3" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="e.g. PayPal: payments@partner.com or Bank: First City Bank, Acc: 123456789, SWIFT: FCBKUS33"></textarea>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
        <a href="/admin/affiliates" class="btn-admin btn-admin-secondary">Cancel</a>
        <button type="submit" class="btn-admin btn-admin-primary">
            <span>💾</span> Register Partner
        </button>
    </div>
</form>
