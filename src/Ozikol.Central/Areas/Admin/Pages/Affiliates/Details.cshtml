@page "{id:guid}"
@model Ozikol.Central.Areas.Admin.Pages.Affiliates.DetailsModel
@{
    ViewData["Title"] = $"Partner: {Model.Partner.FullName}";
    ViewData["BreadcrumbSection"] = "Affiliates";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">@Model.Partner.FullName</h1>
        <p class="admin-subtitle">Partner Code: <code style="color: #38bdf8; font-size: 15px; font-weight: 700;">@Model.Partner.PartnerCode</code> &bull; Commission: <span style="color: #fff; font-weight: 600;">@Model.Partner.CommissionRatePercentage.ToString("0.#")%</span></p>
    </div>
    <div class="admin-actions">
        <a href="/admin/affiliates/edit/@Model.Partner.Id" class="btn-admin btn-admin-primary">
            <span>✏️</span> Edit Partner
        </a>
        <a href="/admin/affiliates" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Partners
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@* ── Wallet & Performance Stats ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px; font-size: 18px;">💰</div>
        <div class="stat-details">
            <span class="stat-label">Lifetime Earned</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">$@Model.Partner.TotalEarned.ToString("N2")</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-warning" style="width: 40px; height: 40px; font-size: 18px;">⏳</div>
        <div class="stat-details">
            <span class="stat-label">Pending Payout Balance</span>
            <span class="stat-value" style="font-size: 22px; color: #f59e0b;">$@Model.Partner.PendingBalance.ToString("N2")</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px; font-size: 18px;">✅</div>
        <div class="stat-details">
            <span class="stat-label">Total Disbursed</span>
            <span class="stat-value" style="font-size: 22px;">$@Model.Partner.PaidBalance.ToString("N2")</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-info" style="width: 40px; height: 40px; font-size: 18px;">🏢</div>
        <div class="stat-details">
            <span class="stat-label">Referred Tenants</span>
            <span class="stat-value" style="font-size: 22px;">@Model.ReferralCount</span>
        </div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    @* ── Left: Referred Tenants History Ledger ── *@
    <div>
        <div class="admin-card">
            <div class="card-header-styled" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="card-header-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">📋</div>
                    <div>
                        <h3 class="card-header-title">Referred Tenant Signups & Attributions</h3>
                        <p class="card-header-subtitle">Tenants who registered using partner code @Model.Partner.PartnerCode.</p>
                    </div>
                </div>
            </div>

            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Organization Name</th>
                            <th>Tenant Key</th>
                            <th style="text-align: right;">Plan Amount</th>
                            <th style="text-align: right;">Commission</th>
                            <th>Status</th>
                            <th>Signup Date</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Partner.Referrals.Any())
                        {
                            @foreach (var refItem in Model.Partner.Referrals.OrderByDescending(r => r.CreatedUtc))
                            {
                                var isPending = refItem.CommissionStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase);
                                var isApproved = refItem.CommissionStatus.Equals("Approved", StringComparison.OrdinalIgnoreCase);
                                var isPaid = refItem.CommissionStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase);

                                <tr>
                                    <td style="font-weight: 600; color: #fff;">
                                        @refItem.ReferredOrganizationName
                                    </td>
                                    <td>
                                        <code style="font-family: monospace; color: #38bdf8; font-size: 12px;">@refItem.ReferredTenantKey</code>
                                    </td>
                                    <td style="text-align: right; font-family: monospace; color: var(--admin-text-muted);">
                                        $@refItem.SubscriptionAmount.ToString("N2")
                                    </td>
                                    <td style="text-align: right; font-family: monospace; font-weight: 700; color: #34d399;">
                                        $@refItem.CommissionEarned.ToString("N2")
                                    </td>
                                    <td>
                                        @if (isPaid)
                                        {
                                            <span class="badge badge-success">Paid</span>
                                        }
                                        else if (isApproved)
                                        {
                                            <span class="badge badge-warning">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">Pending</span>
                                        }
                                    </td>
                                    <td style="font-size: 12px; color: var(--admin-text-muted);">
                                        @refItem.CreatedUtc.ToString("MMM dd, yyyy")
                                    </td>
                                    <td style="text-align: right;">
                                        @if (isPending)
                                        {
                                            <form method="post" asp-page-handler="ApproveCommission" asp-route-id="@Model.Partner.Id" asp-route-referralId="@refItem.Id" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-admin btn-admin-primary" style="padding: 4px 8px; font-size: 11px;">
                                                    Approve
                                                </button>
                                            </form>
                                        }
                                        else if (isApproved)
                                        {
                                            <span style="font-size: 11px; color: #f59e0b;">Ready to Pay</span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 11px; color: var(--admin-text-muted);">Settled</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 48px; color: var(--admin-text-muted);">
                                    <div style="font-size: 32px; margin-bottom: 8px;">🏢</div>
                                    <div style="font-size: 16px; font-weight: 500; color: #fff;">No Referrals Yet</div>
                                    <div style="font-size: 13px; margin-top: 4px;">Tenants registering with code @Model.Partner.PartnerCode will appear here automatically.</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Right: Profile, Referral URL & Settlement Action ── *@
    <div>
        @* Payout Settlement Card *@
        <div class="admin-card" style="margin-bottom: 24px;">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">💸</div>
                <div>
                    <h3 class="card-header-title">Commission Settlement</h3>
                    <p class="card-header-subtitle">Disburse pending partner earnings.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                <div style="margin-bottom: 16px;">
                    <div style="font-size: 12px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted);">Current Pending Balance</div>
                    <div style="font-size: 28px; font-weight: 800; color: @(Model.Partner.PendingBalance > 0 ? "#f59e0b" : "#fff"); margin-top: 4px;">
                        $@Model.Partner.PendingBalance.ToString("N2")
                    </div>
                </div>

                @if (Model.Partner.PendingBalance > 0)
                {
                    <form method="post" asp-page-handler="SettlePayout" asp-route-id="@Model.Partner.Id" onsubmit="return confirm('Confirm payout disbursement of $@Model.Partner.PendingBalance.ToString("N2") to @Model.Partner.FullName?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; justify-content: center;">
                            <span>💸</span> Settle & Disburse $@Model.Partner.PendingBalance.ToString("N2")
                        </button>
                    </form>
                }
                else
                {
                    <div style="font-size: 13px; color: var(--admin-text-muted); background: rgba(0, 0, 0, 0.2); padding: 12px; border-radius: 6px;">
                        All approved commissions have been disbursed. No pending balances.
                    </div>
                }
            </div>
        </div>

        @* Referral Link Card *@
        <div class="admin-card" style="margin-bottom: 24px;">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">🔗</div>
                <div>
                    <h3 class="card-header-title">Referral Link</h3>
                    <p class="card-header-subtitle">Assigned onboarding link.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 13px; color: #38bdf8; word-break: break-all; margin-bottom: 12px;">
                    https://ozikol.com/?ref=@Model.Partner.PartnerCode
                </div>
                <button onclick="navigator.clipboard.writeText('https://ozikol.com/?ref=@Model.Partner.PartnerCode'); alert('Referral link copied to clipboard!');" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center;">
                    📋 Copy Referral Link
                </button>
            </div>
        </div>

        @* Contact & Settlement Details *@
        <div class="admin-card">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">🏦</div>
                <div>
                    <h3 class="card-header-title">Payout & Contact Data</h3>
                    <p class="card-header-subtitle">Partner instructions.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
                    <div>
                        <span style="color: var(--admin-text-muted); display: block; font-size: 11px; text-transform: uppercase; font-weight: 700;">Email Address</span>
                        <a href="mailto:@Model.Partner.Email" style="color: #38bdf8;">@Model.Partner.Email</a>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Partner.PhoneNumber))
                    {
                        <div>
                            <span style="color: var(--admin-text-muted); display: block; font-size: 11px; text-transform: uppercase; font-weight: 700;">Phone</span>
                            <span style="color: #fff;">@Model.Partner.PhoneNumber</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Partner.WebsiteOrChannel))
                    {
                        <div>
                            <span style="color: var(--admin-text-muted); display: block; font-size: 11px; text-transform: uppercase; font-weight: 700;">Channel</span>
                            <span style="color: #fff;">@Model.Partner.WebsiteOrChannel</span>
                        </div>
                    }
                    <div>
                        <span style="color: var(--admin-text-muted); display: block; font-size: 11px; text-transform: uppercase; font-weight: 700;">Settlement Instructions</span>
                        <div style="color: #fff; background: rgba(0, 0, 0, 0.25); border-radius: 6px; padding: 8px 10px; margin-top: 4px; font-family: monospace; font-size: 12px;">
                            @(string.IsNullOrWhiteSpace(Model.Partner.PayoutDetailsJson) ? "None specified" : Model.Partner.PayoutDetailsJson)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
