@page "{id:guid}"
@model Ozikol.Central.Areas.Admin.Pages.Creators.EditModel
@{
    ViewData["Title"] = $"Edit Creator: {Model.Input.FullName}";
    ViewData["BreadcrumbSection"] = "Creators";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Edit Creator: @Model.Input.FullName</h1>
        <p class="admin-subtitle">Modify designer contact profile, portfolio URL, specialization, and certification state.</p>
    </div>
    <div class="admin-actions">
        <a href="/admin/creators/details/@Model.Id" class="btn-admin btn-admin-secondary">
            <span>👁️</span> View Profile
        </a>
        <a href="/admin/creators" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Creators
        </a>
    </div>
</div>

<form method="post" style="max-width: 800px;">
    @Html.AntiForgeryToken()

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">👤</div>
            <div>
                <h3 class="card-header-title">Creator Profile & Studio</h3>
                <p class="card-header-subtitle">Identity, studio branding, and communication channels.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.FullName" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Full Legal Name <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.FullName" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                    <span asp-validation-for="Input.FullName" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.StudioOrBrandName" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Studio / Brand Name
                    </label>
                    <input asp-for="Input.StudioOrBrandName" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.Email" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Contact Email <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.Email" type="email" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                    <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.PhoneNumber" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Phone Number
                    </label>
                    <input asp-for="Input.PhoneNumber" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 8px;">
                <div class="form-group">
                    <label asp-for="Input.Specialization" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Specialization <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.Specialization" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                    <span asp-validation-for="Input.Specialization" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.PortfolioUrl" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Portfolio URL <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.PortfolioUrl" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                    <span asp-validation-for="Input.PortfolioUrl" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">⚖️</div>
            <div>
                <h3 class="card-header-title">Certification Status & Notes</h3>
                <p class="card-header-subtitle">Approval status and internal audit evaluation.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="Input.Status" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Program Status <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                </label>
                <select asp-for="Input.Status" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                    <option value="Approved">Approved (Certified Creator)</option>
                    <option value="UnderReview">Under Review (Evaluating Submission)</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 8px;">
                <label asp-for="Input.ReviewNotes" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Internal Review Notes
                </label>
                <textarea asp-for="Input.ReviewNotes" rows="3" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;"></textarea>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
        <a href="/admin/creators/details/@Model.Id" class="btn-admin btn-admin-secondary">Cancel</a>
        <button type="submit" class="btn-admin btn-admin-primary">
            <span>💾</span> Save Changes
        </button>
    </div>
</form>
