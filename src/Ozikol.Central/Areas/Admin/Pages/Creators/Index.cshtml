@page
@model Ozikol.Central.Areas.Admin.Pages.Creators.IndexModel
@{
    ViewData["Title"] = "Template Creators";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Template Creators Network</h1>
        <p class="admin-subtitle">Inspect certified marketplace designers, studio portfolios, template authorship attributions, and creator earnings.</p>
    </div>
    <div class="admin-actions">
        <a href="/admin/creators/applications" class="btn-admin btn-admin-primary">
            <span>📥</span> Review Applications (@Model.PendingApplicationsCount Pending)
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@* ── Creator Stats ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px; font-size: 18px;">🎨</div>
        <div class="stat-details">
            <span class="stat-label">Certified Creators</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">@Model.ApprovedCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-warning" style="width: 40px; height: 40px; font-size: 18px;">⏳</div>
        <div class="stat-details">
            <span class="stat-label">Pending Applications</span>
            <span class="stat-value" style="font-size: 22px; color: #f59e0b;">@Model.PendingApplicationsCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px; font-size: 18px;">📁</div>
        <div class="stat-details">
            <span class="stat-label">Total Submissions</span>
            <span class="stat-value" style="font-size: 22px;">@Model.TotalApplicationsCount</span>
        </div>
    </div>
</div>

@* ── Filters ── *@
<div class="admin-card" style="margin-bottom: 24px; padding: 16px 20px;">
    <form method="get" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px;">
            <input type="text" name="Search" value="@Model.Search" placeholder="Search by creator code, name, brand, or email..." 
                   class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 14px; color: var(--admin-text); font-size: 13px;" />
        </div>
        @if (Model.SpecializationsList.Any())
        {
            <div style="min-width: 160px;">
                <select name="Specialization" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 14px; color: var(--admin-text); font-size: 13px;">
                    <option value="">All Specializations</option>
                    @foreach (var spec in Model.SpecializationsList)
                    {
                        <option value="@spec" selected="@(Model.Specialization == spec)">@spec</option>
                    }
                </select>
            </div>
        }
        <button type="submit" class="btn-admin btn-admin-secondary" style="padding: 8px 16px;">
            <span>🔍</span> Filter
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Specialization))
        {
            <a href="/admin/creators" class="btn-admin btn-admin-secondary" style="padding: 8px 14px;">Clear</a>
        }
    </form>
</div>

@* ── Creators Table ── *@
<div class="admin-card">
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Creator Code</th>
                    <th>Designer & Studio</th>
                    <th>Specialization</th>
                    <th>Portfolio URL</th>
                    <th>Email Contact</th>
                    <th>Approved Date</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Creators.Any())
                {
                    @foreach (var c in Model.Creators)
                    {
                        <tr>
                            <td>
                                <span style="font-family: monospace; font-size: 13px; font-weight: 700; color: #a78bfa; background: rgba(167, 139, 250, 0.1); padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(167, 139, 250, 0.2);">
                                    @c.CreatorCode
                                </span>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: #fff; font-size: 14px;">@c.FullName</div>
                                @if (!string.IsNullOrWhiteSpace(c.StudioOrBrandName))
                                {
                                    <div style="font-size: 12px; color: #38bdf8; margin-top: 2px;">@c.StudioOrBrandName</div>
                                }
                            </td>
                            <td>
                                <span class="badge badge-secondary" style="font-size: 11px;">
                                    @c.Specialization
                                </span>
                            </td>
                            <td>
                                <a href="@c.PortfolioUrl" target="_blank" rel="noopener noreferrer" style="color: #60a5fa; font-size: 13px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                    <span>🔗</span> Portfolio
                                </a>
                            </td>
                            <td style="font-size: 13px; color: var(--admin-text-muted);">
                                @c.Email
                            </td>
                            <td style="font-size: 12px; color: var(--admin-text-muted);">
                                @c.CreatedUtc.ToString("MMM dd, yyyy")
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 6px;">
                                    <a href="/admin/creators/details/@c.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 8px; font-size: 12px;" title="View Profile & Pitch">
                                        👁️
                                    </a>
                                    <a href="/admin/creators/edit/@c.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 8px; font-size: 12px;" title="Edit Creator Profile">
                                        ✏️
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 48px; color: var(--admin-text-muted);">
                            <div style="font-size: 32px; margin-bottom: 8px;">🎨</div>
                            <div style="font-size: 16px; font-weight: 500; color: #fff;">No Approved Creators Yet</div>
                            <div style="font-size: 13px; margin-top: 4px;">Review pending applications to certify designers for the marketplace.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Pagination ── *@
    @if (Model.TotalPages > 1)
    {
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-top: 1px solid rgba(255, 255, 255, 0.08);">
            <div style="font-size: 13px; color: var(--admin-text-muted);">
                Showing page @Model.PageNumber of @Model.TotalPages
            </div>
            <div style="display: flex; gap: 8px;">
                @if (Model.PageNumber > 1)
                {
                    <a href="/admin/creators?PageNumber=@(Model.PageNumber - 1)&Search=@Model.Search&Specialization=@Model.Specialization" 
                       class="btn-admin btn-admin-secondary" style="padding: 6px 12px; font-size: 12px;">&larr; Previous</a>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a href="/admin/creators?PageNumber=@(Model.PageNumber + 1)&Search=@Model.Search&Specialization=@Model.Specialization" 
                       class="btn-admin btn-admin-secondary" style="padding: 6px 12px; font-size: 12px;">Next &rarr;</a>
                }
            </div>
        </div>
    }
</div>
