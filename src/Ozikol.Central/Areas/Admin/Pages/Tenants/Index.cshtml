@page
@model Ozikol.Central.Areas.Admin.Pages.Tenants.IndexModel
@{
    ViewData["Title"] = "Tenant Management";
    ViewData["BreadcrumbSection"] = "Platform Core";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Sovereign Tenant Fleet</h1>
        <p class="admin-subtitle">Inspect, manage, and govern dedicated organization database instances across the platform.</p>
    </div>
    <div class="admin-actions">
        <a href="/admin/tenants/create" class="btn-admin btn-admin-primary">
            <span>+</span> Provision New Tenant
        </a>
    </div>
</div>

@* ── Fleet Summary Stat Cards ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 20px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px; font-size: 18px;">
            🏢
        </div>
        <div class="stat-details">
            <span class="stat-label">Total Fleet</span>
            <span class="stat-value" style="font-size: 20px;">@(Model.ActiveCount + Model.SuspendedCount)</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px; font-size: 18px;">
            ✓
        </div>
        <div class="stat-details">
            <span class="stat-label">Active Tenants</span>
            <span class="stat-value" style="font-size: 20px; color: var(--admin-success);">@Model.ActiveCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-warning" style="width: 40px; height: 40px; font-size: 18px;">
            ⏸
        </div>
        <div class="stat-details">
            <span class="stat-label">Suspended</span>
            <span class="stat-value" style="font-size: 20px; color: var(--admin-warning);">@Model.SuspendedCount</span>
        </div>
    </div>
</div>

@* ── Tenant Table Card ── *@
<div class="admin-card">
    <div class="table-toolbar">
        <form method="get" class="table-filters" style="flex: 1; display: flex; gap: 12px; align-items: center;">
            <div class="table-search-box">
                <span class="search-icon">🔍</span>
                <input type="text" name="search" value="@Model.Search" placeholder="Search by name, key, domain, email..." />
            </div>

            <select name="status" class="form-select" style="width: 160px; padding: 8px 12px; font-size: 13px;">
                <option value="">All Statuses</option>
                <option value="active" selected="@(Model.Status == "active")">Active Only</option>
                <option value="suspended" selected="@(Model.Status == "suspended")">Suspended Only</option>
            </select>

            <button type="submit" class="btn-admin btn-admin-secondary btn-admin-sm">Filter</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
            {
                <a href="/admin/tenants" class="btn-admin btn-admin-secondary btn-admin-sm" style="color: var(--admin-danger);">Clear</a>
            }
        </form>

        <div style="font-size: 12.5px; color: var(--admin-text-muted);">
            Showing @Model.Tenants.Count of @Model.TotalCount organizations
        </div>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Organization</th>
                    <th>Subdomain & Domain</th>
                    <th>Database</th>
                    <th>Modules</th>
                    <th>Status</th>
                    <th>Provisioned</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tenants.Any())
                {
                    @foreach (var tenant in Model.Tenants)
                    {
                        <tr>
                            <td>
                                <div>
                                    <strong style="color: var(--admin-text); font-size: 14px;">@tenant.OrganizationName</strong>
                                    <div style="font-size: 11.5px; color: var(--admin-text-dim); margin-top: 2px;">
                                        Key: <code style="color: var(--admin-primary);">@tenant.TenantKey</code>
                                        @if (!string.IsNullOrEmpty(tenant.AdminEmail))
                                        {
                                            <span> • @tenant.AdminEmail</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="font-size: 13px;">
                                    <a href="https://@tenant.PrimaryDomain" target="_blank" style="color: var(--admin-info); text-decoration: none;">
                                        @tenant.PrimaryDomain ↗
                                    </a>
                                </div>
                                @if (!string.IsNullOrEmpty(tenant.CustomDomain))
                                {
                                    <div style="font-size: 11.5px; color: var(--admin-text-muted);">
                                        Custom: @tenant.CustomDomain
                                    </div>
                                }
                            </td>
                            <td>
                                <span style="font-family: monospace; font-size: 12px; color: var(--admin-text-muted); background: var(--admin-bg-surface-elevated); padding: 3px 6px; border-radius: 4px;">
                                    @tenant.DatabaseName
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-indigo">
                                    @(tenant.FeatureSubscriptions?.Count(s => s.IsActive) ?? 0) Active
                                </span>
                            </td>
                            <td>
                                @if (tenant.IsActive)
                                {
                                    <span class="badge badge-success">
                                        <span class="badge-dot"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        <span class="badge-dot"></span> Suspended
                                    </span>
                                }
                            </td>
                            <td style="font-size: 12px; color: var(--admin-text-dim);">
                                @tenant.CreatedUtc.ToString("MMM dd, yyyy")
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; align-items: center; gap: 6px;">
                                    <a href="/admin/tenants/details?id=@tenant.Id" class="btn-admin btn-admin-secondary btn-admin-sm" title="View details">
                                        Details
                                    </a>
                                    <a href="/admin/tenants/features?id=@tenant.Id" class="btn-admin btn-admin-secondary btn-admin-sm" title="Manage feature subscriptions">
                                        Modules
                                    </a>
                                    <a href="/admin/tenants/edit?id=@tenant.Id" class="btn-admin btn-admin-secondary btn-admin-sm" title="Edit tenant profile">
                                        Edit
                                    </a>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@tenant.Id" style="display: inline; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-admin @(tenant.IsActive ? "btn-admin-danger" : "btn-admin-primary") btn-admin-sm" onclick="return confirm('Are you sure you want to @(tenant.IsActive ? "suspend" : "activate") tenant @tenant.OrganizationName?');">
                                            @(tenant.IsActive ? "Suspend" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state">
                                <div class="empty-state-icon">🏢</div>
                                <h3 class="empty-state-title">No Tenants Found</h3>
                                <p class="empty-state-desc">No sovereign organization databases match your current search or filter query.</p>
                                <a href="/admin/tenants/create" class="btn-admin btn-admin-primary btn-admin-sm">+ Provision First Tenant</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pagination *@
    @if (Model.TotalPages > 1)
    {
        <div class="admin-card-footer">
            <div style="font-size: 12.5px; color: var(--admin-text-muted);">
                Page @Model.PageNumber of @Model.TotalPages
            </div>
            <ul class="admin-pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)&search=@Model.Search&status=@Model.Status">‹ Previous</a>
                </li>
                @for (int p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="?pageNumber=@p&search=@Model.Search&status=@Model.Status">@p</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)&search=@Model.Search&status=@Model.Status">Next ›</a>
                </li>
            </ul>
        </div>
    }
</div>
