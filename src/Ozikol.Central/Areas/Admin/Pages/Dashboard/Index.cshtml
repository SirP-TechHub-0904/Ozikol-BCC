@page
@model Ozikol.Central.Areas.Admin.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Platform Overview";
    ViewData["BreadcrumbSection"] = "Overview";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Platform Operations Dashboard</h1>
        <p class="admin-subtitle">Real-time telemetry across sovereign tenant databases, subscription activations, and administrative audit logs.</p>
    </div>
    <div class="admin-actions">
        <a href="/admin/tenants/create" class="btn-admin btn-admin-primary">
            <span>+</span> Provision New Tenant
        </a>
        <a href="/admin/billing" class="btn-admin btn-admin-secondary">
            <span>💰</span> View Billing
        </a>
    </div>
</div>

@* ── KPI Stat Cards ── *@
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon-wrapper stat-icon-primary">
            🏢
        </div>
        <div class="stat-details">
            <span class="stat-label">Total Tenants</span>
            <span class="stat-value">@Model.TotalTenants</span>
            <span class="stat-subtext">
                <strong style="color: var(--admin-success);">@Model.ActiveTenants</strong> active databases
            </span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon-wrapper stat-icon-indigo">
            ⚡
        </div>
        <div class="stat-details">
            <span class="stat-label">Active Subscriptions</span>
            <span class="stat-value">@Model.ActiveSubscriptions</span>
            <span class="stat-subtext">Across 37 modular capabilities</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon-wrapper stat-icon-success">
            💳
        </div>
        <div class="stat-details">
            <span class="stat-label">Monthly Revenue</span>
            <span class="stat-value">$@Model.MonthlyRevenue.ToString("N2")</span>
            <span class="stat-subtext">Recorded calendar month</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon-wrapper stat-icon-warning">
            🎫
        </div>
        <div class="stat-details">
            <span class="stat-label">Open Support Tickets</span>
            <span class="stat-value">@Model.OpenTickets</span>
            <span class="stat-subtext">
                @if (Model.OpenTickets > 0)
                {
                    <span class="stat-trend-down">Awaiting operator review</span>
                }
                else
                {
                    <span class="stat-trend-up">All tickets addressed</span>
                }
            </span>
        </div>
    </div>
</div>

@* ── Dashboard Grid: Tenants Table + Audit Log & Fleet Status ── *@
<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    @* Left Column *@
    <div>
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">🏢 Recently Registered Tenants</h2>
                <a href="/admin/tenants" class="btn-admin btn-admin-secondary btn-admin-sm">View All Tenants →</a>
            </div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Organization</th>
                            <th>Tenant Key</th>
                            <th>Primary Domain</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentTenants.Any())
                        {
                            @foreach (var tenant in Model.RecentTenants)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: var(--admin-text);">@tenant.OrganizationName</strong>
                                    </td>
                                    <td>
                                        <code style="background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; font-size: 12px;">@tenant.TenantKey</code>
                                    </td>
                                    <td style="color: var(--admin-text-muted);">
                                        @tenant.PrimaryDomain
                                    </td>
                                    <td>
                                        @if (tenant.IsActive)
                                        {
                                            <span class="badge badge-success">
                                                <span class="badge-dot"></span> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger">
                                                <span class="badge-dot"></span> Suspended
                                            </span>
                                        }
                                    </td>
                                    <td style="color: var(--admin-text-dim); font-size: 12px;">
                                        @tenant.CreatedUtc.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        <a href="/admin/tenants/details?id=@tenant.Id" class="btn-admin btn-admin-secondary btn-admin-sm">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 32px; color: var(--admin-text-muted);">
                                    No tenant organizations registered yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Quick Launchpad *@
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">🚀 Administrative Operations Launchpad</h2>
            </div>
            <div class="admin-card-body" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; padding: 20px;">
                <a href="/admin/features" style="display: flex; align-items: center; gap: 12px; padding: 14px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); text-decoration: none; color: var(--admin-text); transition: var(--transition);">
                    <span style="font-size: 24px;">⚡</span>
                    <div>
                        <div style="font-weight: 600; font-size: 13.5px;">Feature Catalog</div>
                        <div style="font-size: 11.5px; color: var(--admin-text-muted);">37 modular modules</div>
                    </div>
                </a>

                <a href="/admin/subscriptions" style="display: flex; align-items: center; gap: 12px; padding: 14px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); text-decoration: none; color: var(--admin-text); transition: var(--transition);">
                    <span style="font-size: 24px;">📋</span>
                    <div>
                        <div style="font-weight: 600; font-size: 13.5px;">Subscriptions</div>
                        <div style="font-size: 11.5px; color: var(--admin-text-muted);">Activation matrix</div>
                    </div>
                </a>

                <a href="/admin/templates" style="display: flex; align-items: center; gap: 12px; padding: 14px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); text-decoration: none; color: var(--admin-text); transition: var(--transition);">
                    <span style="font-size: 24px;">🎨</span>
                    <div>
                        <div style="font-weight: 600; font-size: 13.5px;">Marketplace</div>
                        <div style="font-size: 11.5px; color: var(--admin-text-muted);">UI templates & creators</div>
                    </div>
                </a>

                <a href="/admin/platform-settings" style="display: flex; align-items: center; gap: 12px; padding: 14px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); text-decoration: none; color: var(--admin-text); transition: var(--transition);">
                    <span style="font-size: 24px;">⚙️</span>
                    <div>
                        <div style="font-weight: 600; font-size: 13.5px;">Platform Settings</div>
                        <div style="font-size: 11.5px; color: var(--admin-text-muted);">Global configuration</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    @* Right Column: Audit Log + Fleet Health *@
    <div>
        @* Fleet Health Card *@
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">🛡️ Fleet Architecture</h2>
            </div>
            <div class="admin-card-body" style="padding: 18px 20px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--admin-text-muted); font-size: 13px;">Master Catalog DB:</span>
                        <span class="badge badge-success"><span class="badge-dot"></span> Connected</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--admin-text-muted); font-size: 13px;">Tenant Isolation:</span>
                        <span class="badge badge-indigo">Database-per-Tenant</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--admin-text-muted); font-size: 13px;">Affiliate Partners:</span>
                        <span style="font-weight: 600; color: var(--admin-text);">@Model.TotalAffiliates</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--admin-text-muted); font-size: 13px;">Template Creators:</span>
                        <span style="font-weight: 600; color: var(--admin-text);">@Model.TotalCreators</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--admin-text-muted); font-size: 13px;">Audit Logging:</span>
                        <span class="badge badge-success">Immutable Active</span>
                    </div>
                </div>
            </div>
        </div>

        @* Live Audit Trail *@
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">📝 Recent Audit Trail</h2>
                <a href="/admin/audit-log" class="btn-admin btn-admin-secondary btn-admin-sm">Log →</a>
            </div>
            <div class="admin-card-body" style="padding: 12px 16px;">
                @if (Model.RecentAuditLogs.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <div style="padding-bottom: 10px; border-bottom: 1px solid var(--admin-border);">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                    <span class="badge @(log.Action switch { "Create" => "badge-success", "Update" => "badge-info", "Delete" => "badge-danger", "Login" => "badge-indigo", _ => "badge-neutral" })">
                                        @log.Action
                                    </span>
                                    <span style="font-size: 11px; color: var(--admin-text-dim);">
                                        @log.CreatedUtc.ToString("HH:mm:ss")
                                    </span>
                                </div>
                                <div style="font-size: 12.5px; color: var(--admin-text); font-weight: 500;">
                                    @(log.Summary ?? $"{log.Action} on {log.EntityType}")
                                </div>
                                <div style="font-size: 11px; color: var(--admin-text-dim); margin-top: 2px;">
                                    by @(log.UserName ?? log.UserId ?? "System")
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; color: var(--admin-text-muted); padding: 24px 0; font-size: 13px;">
                        No audit events recorded yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
