@page "/centralwks/users"
@model Ozikol.Central.Areas.Centralwks.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Platform Operators";
    ViewData["BreadcrumbSection"] = "Identity";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Central Platform Operators &amp; Identity</h1>
        <p class="admin-subtitle">Manage administrative staff, security credentials, RBAC role assignments, and lockout parameters across Centralwks.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/users/roles" class="btn-admin btn-admin-secondary" style="display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 16px;">security</span> Manage Roles (@Model.AvailableRoles.Count)
        </a>
        <a href="/centralwks/users/create" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 16px;">person_add</span> Invite Operator
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@if (TempData["NewOperatorSetupUrl"] != null)
{
    var opName = TempData["NewOperatorName"]?.ToString() ?? "Operator";
    var opUser = TempData["NewOperatorUserName"]?.ToString() ?? "";
    var opEmail = TempData["NewOperatorEmail"]?.ToString() ?? "";
    var opDept = TempData["NewOperatorDepartment"]?.ToString() ?? "Administration";
    var opRoles = TempData["NewOperatorRoles"]?.ToString() ?? "Admin";
    var setupUrl = TempData["NewOperatorSetupUrl"]?.ToString() ?? "";
    
    var clipboardText = $"Platform Operator Invitation - Centralwks\n" +
                        $"Name: {opName}\n" +
                        $"Username: {opUser}\n" +
                        $"Email: {opEmail}\n" +
                        $"Department: {opDept}\n" +
                        $"Assigned Roles: {opRoles}\n" +
                        $"Activation Link: {setupUrl}\n\n" +
                        $"Please click the activation link above to establish your permanent password and access the Central platform.";

    <div class="admin-card" style="background: var(--admin-bg-surface, #ffffff); border: 1px solid rgba(16, 185, 129, 0.35); border-left: 5px solid #10b981; border-radius: 12px; padding: 22px 24px; margin-bottom: 24px; position: relative; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px;">
            <div style="display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); display: flex; align-items: center; justify-content: center; color: #059669; flex-shrink: 0;">
                    <span class="material-symbols-outlined" style="font-size: 24px;">mark_email_read</span>
                </div>
                <div>
                    <h3 style="font-size: 16.5px; font-weight: 700; color: var(--admin-text, #0f172a); margin: 0;">Operator Account Created Successfully</h3>
                    <p style="font-size: 13px; color: var(--admin-text-muted, #64748b); margin: 3px 0 0 0;">
                        Share the activation credentials directly or copy the onboarding package below.
                    </p>
                </div>
            </div>
            <button type="button" onclick="this.closest('.admin-card').style.display='none'" title="Dismiss" style="background: transparent; border: none; color: var(--admin-text-muted, #94a3b8); cursor: pointer; padding: 4px; display: flex; align-items: center;">
                <span class="material-symbols-outlined" style="font-size: 20px;">close</span>
            </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; background: var(--admin-bg-surface-elevated, #f8fafc); border: 1px solid var(--admin-border, #e2e8f0); border-radius: 8px; padding: 16px; margin-bottom: 18px;">
            <div>
                <span style="font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted, #64748b); font-weight: 700; letter-spacing: 0.5px;">Full Name</span>
                <div style="font-size: 14px; font-weight: 700; color: var(--admin-text, #0f172a); margin-top: 3px;">@opName</div>
            </div>
            <div>
                <span style="font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted, #64748b); font-weight: 700; letter-spacing: 0.5px;">Username</span>
                <div style="margin-top: 3px;">
                    <code style="background: rgba(37, 99, 235, 0.08); color: #2563eb; padding: 2px 6px; border-radius: 4px; font-size: 12.5px; font-weight: 600;">@@@opUser</code>
                </div>
            </div>
            <div>
                <span style="font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted, #64748b); font-weight: 700; letter-spacing: 0.5px;">Email Address</span>
                <div style="font-size: 13.5px; color: var(--admin-text, #1e293b); font-weight: 500; margin-top: 3px;">@opEmail</div>
            </div>
            <div>
                <span style="font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted, #64748b); font-weight: 700; letter-spacing: 0.5px;">Assigned Roles</span>
                <div style="margin-top: 3px;">
                    <span style="background: #ede9fe; color: #6d28d9; border: 1px solid #ddd6fe; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600;">@opRoles</span>
                </div>
            </div>
        </div>

        <div style="margin-bottom: 18px;">
            <label style="display: block; font-size: 12.5px; font-weight: 600; color: var(--admin-text, #334155); margin-bottom: 6px;">
                Direct Activation Link <span style="font-size: 11.5px; color: var(--admin-text-muted, #64748b); font-weight: normal;">(Operator sets their password here - valid for 24h)</span>:
            </label>
            <div style="display: flex; gap: 8px; align-items: center;">
                <input type="text" id="setupUrlInput" readonly value="@setupUrl" 
                       style="flex: 1; background: var(--admin-bg-surface, #ffffff); border: 1px solid var(--admin-border, #cbd5e1); border-radius: 6px; padding: 9px 12px; font-family: monospace; font-size: 12.5px; color: #0284c7; font-weight: 600;" />
                <button type="button" id="copyUrlBtn" onclick="copySetupUrl()" class="btn-admin btn-admin-secondary" style="white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; padding: 9px 14px; font-size: 12.5px; font-weight: 600;">
                    <span class="material-symbols-outlined" style="font-size: 16px;">link</span>
                    <span>Copy Link</span>
                </button>
            </div>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end;">
            <textarea id="rawInviteText" style="display: none;">@clipboardText</textarea>
            <button type="button" id="copyDetailsBtn" onclick="copyFullDetails()" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 6px; padding: 9px 18px; background: #059669; border-color: #047857; color: #ffffff; font-weight: 600; font-size: 13px; box-shadow: 0 2px 6px rgba(5, 150, 105, 0.2);">
                <span class="material-symbols-outlined" style="font-size: 18px;">content_copy</span>
                <span id="copyDetailsText">Copy Full Invitation Details</span>
            </button>
        </div>
    </div>
}

@* ── Identity Metrics ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">group</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Total Operators</span>
            <span class="stat-value" style="font-size: 22px;">@Model.TotalCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">check_circle</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Active Staff</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">@Model.ActiveCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper" style="width: 40px; height: 40px; background: rgba(168, 85, 247, 0.2); color: #c084fc;">
            <span class="material-symbols-outlined" style="font-size: 20px;">admin_panel_settings</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">System Roles</span>
            <span class="stat-value" style="font-size: 22px; color: #c084fc;">@Model.AvailableRoles.Count</span>
        </div>
    </div>
</div>

@* ── Filters ── *@
<div class="admin-card" style="padding: 16px 20px; margin-bottom: 24px;">
    <form method="get" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center;">
        <div style="flex: 1; min-width: 220px;">
            <input type="text" name="search" value="@Model.Search" placeholder="Search by name, email, username, or department..." 
                   class="form-control" />
        </div>

        <div style="min-width: 160px;">
            <select name="roleFilter" class="form-select">
                <option value="">All Roles</option>
                @foreach (var r in Model.AvailableRoles)
                {
                    <option value="@r" selected="@(Model.RoleFilter == r ? "selected" : null)">@r</option>
                }
            </select>
        </div>

        <div style="min-width: 130px;">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active" ? "selected" : null)">Active</option>
                <option value="Inactive" selected="@(Model.StatusFilter == "Inactive" ? "selected" : null)">Suspended</option>
                <option value="LockedOut" selected="@(Model.StatusFilter == "LockedOut" ? "selected" : null)">Locked Out</option>
            </select>
        </div>

        <button type="submit" class="btn-admin btn-admin-secondary" style="padding: 8px 16px;">Filter</button>
        <a href="/centralwks/users" class="btn-admin btn-admin-secondary" style="padding: 8px 14px;">Reset</a>
    </form>
</div>

@* ── Users Table ── *@
<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="overflow-x: auto;">
        <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--admin-card-border); background: var(--admin-bg-surface-elevated, rgba(0, 0, 0, 0.02));">
                    <th style="padding: 14px 16px; width: 50px; text-align: center; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted, #475569);">S/N</th>
                    <th style="padding: 14px 20px; text-align: left; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted, #475569);">Operator</th>
                    <th style="padding: 14px 14px; text-align: left; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted, #475569);">Department</th>
                    <th style="padding: 14px 14px; text-align: left; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted, #475569);">Assigned Roles</th>
                    <th style="padding: 14px 14px; text-align: center; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted, #475569);">Security</th>
                    <th style="padding: 14px 14px; text-align: center; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted, #475569);">Status</th>
                    <th style="padding: 14px 20px; text-align: right; font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted, #475569);">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="7" style="padding: 40px; text-align: center; color: var(--admin-text-muted);">
                            No platform operators match your active filter criteria. Click "Invite Operator" to create an account.
                        </td>
                    </tr>
                }
                @for (int i = 0; i < Model.Users.Count; i++)
                {
                    var u = Model.Users[i];
                    <tr style="border-bottom: 1px solid var(--admin-card-border);">
                        <td style="padding: 14px 16px; text-align: center;">
                            <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600; font-size: 11.5px;">@(i + 1)</span>
                        </td>
                        <td style="padding: 14px 20px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #8b5cf6); display: flex; align-items: center; justify-content: center; font-weight: 600; color: #fff; font-size: 14px; flex-shrink: 0;">
                                    @(string.IsNullOrEmpty(u.FullName) ? u.UserName.Substring(0, 1).ToUpper() : u.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div style="font-weight: 700; color: var(--admin-text, #0f172a); font-size: 14px;">
                                        <a href="/centralwks/users/details/@u.Id" style="color: var(--admin-text, #0f172a); text-decoration: none;">
                                            @(string.IsNullOrEmpty(u.FullName) ? u.UserName : u.FullName)
                                        </a>
                                    </div>
                                    <div style="font-size: 12px; color: var(--admin-text-muted, #64748b); margin-top: 2px;">
                                        <span style="color: #334155; font-weight: 500;">@u.Email</span> • <code style="color: #2563eb; background: rgba(37, 99, 235, 0.08); padding: 1px 6px; border-radius: 4px; font-size: 11.5px; font-weight: 600;">@@@u.UserName</code>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td style="padding: 14px 14px; font-size: 13.5px; font-weight: 500; color: var(--admin-text, #1e293b);">
                            @(u.Department ?? "Administration")
                        </td>
                        <td style="padding: 14px 14px;">
                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                @if (!u.Roles.Any())
                                {
                                    <span style="font-size: 11.5px; color: var(--admin-text-muted, #64748b);">No roles assigned</span>
                                }
                                @foreach (var r in u.Roles)
                                {
                                    <span style="font-size: 11.5px; font-weight: 600; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; padding: 2px 9px; border-radius: 9999px;">
                                        @r
                                    </span>
                                }
                            </div>
                        </td>
                        <td style="padding: 14px 14px; text-align: center; font-size: 12.5px;">
                            @if (u.TwoFactorEnabled)
                            {
                                <span style="color: #047857; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;" title="Two-Factor Authentication Enabled">
                                    <span class="material-symbols-outlined" style="font-size: 15px;">verified_user</span> 2FA On
                                </span>
                            }
                            else
                            {
                                <span style="color: #334155; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;" title="Two-Factor Authentication Disabled">
                                    <span class="material-symbols-outlined" style="font-size: 15px; color: #64748b;">shield</span> 2FA Off
                                </span>
                            }

                            @if (u.IsLockedOut)
                            {
                                <div style="color: #dc2626; font-weight: 700; margin-top: 4px; display: flex; align-items: center; justify-content: center; gap: 2px;">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">lock</span> Locked
                                </div>
                            }
                        </td>
                        <td style="padding: 14px 14px; text-align: center;">
                            @if (u.IsLockedOut)
                            {
                                <form method="post" asp-page-handler="Unlock" asp-route-id="@u.Id" style="display: inline;">
                                    <button type="submit" class="btn-admin" style="background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; padding: 3px 10px; border-radius: 9999px; font-size: 11.5px; font-weight: 700; cursor: pointer;">
                                        Unlock
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ToggleActive" asp-route-id="@u.Id" style="display: inline;">
                                    @if (u.IsActive)
                                    {
                                        <button type="submit" title="Click to suspend account" style="background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; padding: 3px 10px; border-radius: 9999px; font-size: 11.5px; font-weight: 700; cursor: pointer;">
                                            ● Active
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" title="Click to activate account" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 3px 10px; border-radius: 9999px; font-size: 11.5px; font-weight: 600; cursor: pointer;">
                                            ○ Suspended
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                        <td style="padding: 14px 20px; text-align: right; white-space: nowrap;">
                            <a href="/centralwks/users/details/@u.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; margin-right: 4px;">
                                View
                            </a>
                            <a href="/centralwks/users/edit/@u.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; margin-right: 4px;">
                                Edit
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" style="display: inline;">
                                <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 10px; font-size: 12px;" onclick="return confirm('Permanently delete operator @u.UserName?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function copySetupUrl() {
            var copyText = document.getElementById("setupUrlInput");
            if (!copyText) return;
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value).then(function() {
                var btn = document.getElementById("copyUrlBtn");
                if (btn) {
                    var originalHtml = btn.innerHTML;
                    btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px; color: #34d399;">check</span> Copied!';
                    setTimeout(function() { btn.innerHTML = originalHtml; }, 2500);
                }
            });
        }

        function copyFullDetails() {
            var raw = document.getElementById("rawInviteText");
            if (!raw) return;
            navigator.clipboard.writeText(raw.value).then(function() {
                var textSpan = document.getElementById("copyDetailsText");
                if (textSpan) {
                    var originalText = textSpan.innerText;
                    textSpan.innerText = "Invitation Details Copied!";
                    setTimeout(function() { textSpan.innerText = originalText; }, 2500);
                }
            });
        }
    </script>
}
