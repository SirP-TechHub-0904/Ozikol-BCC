@page "/centralwks/users"
@model Ozikol.Central.Areas.Centralwks.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Platform Operators";
    ViewData["BreadcrumbSection"] = "Identity";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Central Platform Operators &amp; Identity</h1>
        <p class="admin-subtitle">Manage administrative staff, security credentials, RBAC role assignments, and lockout parameters across Centralwks.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/users/roles" class="btn-admin btn-admin-secondary">
            <span>🛡️</span> Manage Roles (@Model.AvailableRoles.Count)
        </a>
        <a href="/centralwks/users/create" class="btn-admin btn-admin-primary">
            <span>➕</span> Invite Operator
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@* ── Identity Metrics ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px; font-size: 18px;">👤</div>
        <div class="stat-details">
            <span class="stat-label">Total Operators</span>
            <span class="stat-value" style="font-size: 22px;">@Model.TotalCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px; font-size: 18px;">🟢</div>
        <div class="stat-details">
            <span class="stat-label">Active Staff</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">@Model.ActiveCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper" style="width: 40px; height: 40px; font-size: 18px; background: rgba(168, 85, 247, 0.2); color: #c084fc;">🛡️</div>
        <div class="stat-details">
            <span class="stat-label">System Roles</span>
            <span class="stat-value" style="font-size: 22px; color: #c084fc;">@Model.AvailableRoles.Count</span>
        </div>
    </div>
</div>

@* ── Filters ── *@
<div class="admin-card" style="padding: 16px 20px; margin-bottom: 24px;">
    <form method="get" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center;">
        <div style="flex: 1; min-width: 220px;">
            <input type="text" name="search" value="@Model.Search" placeholder="Search by name, email, username, or department..." 
                   class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 14px; color: var(--admin-text); font-size: 13px;" />
        </div>

        <div style="min-width: 160px;">
            <select name="roleFilter" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;">
                <option value="">All Roles</option>
                @foreach (var r in Model.AvailableRoles)
                {
                    <option value="@r" selected="@(Model.RoleFilter == r ? "selected" : null)">@r</option>
                }
            </select>
        </div>

        <div style="min-width: 130px;">
            <select name="statusFilter" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active" ? "selected" : null)">Active</option>
                <option value="Inactive" selected="@(Model.StatusFilter == "Inactive" ? "selected" : null)">Suspended</option>
                <option value="LockedOut" selected="@(Model.StatusFilter == "LockedOut" ? "selected" : null)">Locked Out</option>
            </select>
        </div>

        <button type="submit" class="btn-admin btn-admin-secondary" style="padding: 8px 16px;">Filter</button>
        <a href="/centralwks/users" class="btn-admin btn-admin-secondary" style="padding: 8px 14px;">Reset</a>
    </form>
</div>

@* ── Users Table ── *@
<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="overflow-x: auto;">
        <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--admin-card-border); background: rgba(255, 255, 255, 0.02);">
                    <th style="padding: 14px 16px; width: 50px; text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted);">S/N</th>
                    <th style="padding: 14px 20px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted);">Operator</th>
                    <th style="padding: 14px 14px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted);">Department</th>
                    <th style="padding: 14px 14px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted);">Assigned Roles</th>
                    <th style="padding: 14px 14px; text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted);">Security</th>
                    <th style="padding: 14px 14px; text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted);">Status</th>
                    <th style="padding: 14px 20px; text-align: right; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-muted);">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="7" style="padding: 40px; text-align: center; color: var(--admin-text-muted);">
                            No platform operators match your active filter criteria. Click "Invite Operator" to create an account.
                        </td>
                    </tr>
                }
                @for (int i = 0; i < Model.Users.Count; i++)
                {
                    var u = Model.Users[i];
                    <tr style="border-bottom: 1px solid var(--admin-card-border);">
                        <td style="padding: 14px 16px; text-align: center;">
                            <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600; font-size: 11.5px;">@(i + 1)</span>
                        </td>
                        <td style="padding: 14px 20px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6, #8b5cf6); display: flex; align-items: center; justify-content: center; font-weight: 600; color: #fff; font-size: 14px; flex-shrink: 0;">
                                    @(string.IsNullOrEmpty(u.FullName) ? u.UserName.Substring(0, 1).ToUpper() : u.FullName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: var(--admin-text); font-size: 14px;">
                                        <a href="/centralwks/users/details/@u.Id" style="color: var(--admin-text); text-decoration: none;">
                                            @(string.IsNullOrEmpty(u.FullName) ? u.UserName : u.FullName)
                                        </a>
                                    </div>
                                    <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 2px;">
                                        @u.Email • <code style="color: #93c5fd; font-size: 11px;">@@@u.UserName</code>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td style="padding: 14px 14px; font-size: 13px; color: #cbd5e1;">
                            @(u.Department ?? "Engineering & Architecture")
                        </td>
                        <td style="padding: 14px 14px;">
                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                @if (!u.Roles.Any())
                                {
                                    <span style="font-size: 11px; color: var(--admin-text-muted);">No roles assigned</span>
                                }
                                @foreach (var r in u.Roles)
                                {
                                    <span style="font-size: 11px; font-weight: 600; background: rgba(59, 130, 246, 0.15); color: #93c5fd; padding: 2px 7px; border-radius: 9999px;">
                                        @r
                                    </span>
                                }
                            </div>
                        </td>
                        <td style="padding: 14px 14px; text-align: center; font-size: 12px;">
                            @if (u.TwoFactorEnabled)
                            {
                                <span style="color: #34d399; font-weight: 600;" title="Two-Factor Authentication Enabled">🛡️ 2FA On</span>
                            }
                            else
                            {
                                <span style="color: #94a3b8;" title="Two-Factor Authentication Disabled">2FA Off</span>
                            }

                            @if (u.IsLockedOut)
                            {
                                <div style="color: #f87171; font-weight: 600; margin-top: 4px;">🔒 Locked</div>
                            }
                        </td>
                        <td style="padding: 14px 14px; text-align: center;">
                            @if (u.IsLockedOut)
                            {
                                <form method="post" asp-page-handler="Unlock" asp-route-id="@u.Id" style="display: inline;">
                                    <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 3px 8px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                        Unlock
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="ToggleActive" asp-route-id="@u.Id" style="display: inline;">
                                    @if (u.IsActive)
                                    {
                                        <button type="submit" title="Click to suspend account" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 3px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                            ● Active
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" title="Click to activate account" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); padding: 3px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                            ○ Suspended
                                        </button>
                                    }
                                </form>
                            }
                        </td>
                        <td style="padding: 14px 20px; text-align: right; white-space: nowrap;">
                            <a href="/centralwks/users/details/@u.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; margin-right: 4px;">
                                View
                            </a>
                            <a href="/centralwks/users/edit/@u.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; margin-right: 4px;">
                                Edit
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" style="display: inline;">
                                <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 10px; font-size: 12px;" onclick="return confirm('Permanently delete operator @u.UserName?');">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
