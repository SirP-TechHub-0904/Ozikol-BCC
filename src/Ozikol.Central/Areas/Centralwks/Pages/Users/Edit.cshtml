@page "/centralwks/users/edit/{id?}"
@model Ozikol.Central.Areas.Centralwks.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit Operator: " + Model.UserName;
    ViewData["BreadcrumbSection"] = "Identity";
}

<div class="admin-page-header" style="width: 100%; margin-bottom: 24px;">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/users/details/@Model.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; text-decoration: none;">
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span> Back to Details
            </a>
            <span style="color: var(--admin-text-muted); font-size: 12px;">•</span>
            <a href="/centralwks/users" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">All Operators</a>
        </div>
        <h1 class="admin-title">Edit Operator: @Model.UserName</h1>
        <p class="admin-subtitle">Update contact details, RBAC security roles, or reset login password.</p>
    </div>
</div>

<form method="post" style="width: 100%;">
    @Html.AntiForgeryToken()
    <div style="display: flex; flex-direction: column; gap: 24px; width: 100%;">

        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger" role="alert" style="margin-bottom: 0;"></div>

        @* ── Section 1: Personal & Contact Information ── *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="display: flex; align-items: center; gap: 14px; padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-md); background: rgba(14, 165, 233, 0.12); border: 1px solid rgba(14, 165, 233, 0.25); color: #0284c7; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <span class="material-symbols-outlined" style="font-size: 22px;">badge</span>
                </div>
                <div>
                    <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0; letter-spacing: -0.01em;">Operator Profile &amp; Contact Details</h2>
                    <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Basic profile identity and organizational department.</p>
                </div>
            </div>

            <div style="padding: 24px; background: var(--admin-bg-surface);">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
                    <div>
                        <label asp-for="Input.FirstName" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            First Name <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="Input.FirstName" class="form-control" placeholder="e.g. First Name" 
                               style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.FirstName" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="Input.LastName" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Last Name <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="Input.LastName" class="form-control" placeholder="e.g. Last Name" 
                               style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.LastName" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="Input.PhoneNumber" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Phone Number
                        </label>
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="e.g. +0 (000) 000-0000" 
                               style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
                    <div>
                        <label asp-for="Input.Email" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Email Address <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="Input.Email" type="email" placeholder="name@@company.com" class="form-control" 
                               style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.Email" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Department" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Department <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <select asp-for="Input.Department" class="form-select" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border); color: var(--admin-text);">
                            @foreach (var dept in Ozikol.Central.Areas.Centralwks.Pages.Users.EditModel.DepartmentOptions)
                            {
                                <option value="@dept" selected="@(Model.Input.Department == dept ? "selected" : null)">@dept</option>
                            }
                        </select>
                        <span style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Functional organizational unit for alerts &amp; routing.</span>
                    </div>
                </div>
            </div>
        </div>

        @* ── Section 2: Role-Based Access Control (RBAC) Assignment ── *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="display: flex; align-items: center; justify-content: space-between; padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 14px;">
                    <div style="width: 40px; height: 40px; border-radius: var(--radius-md); background: rgba(139, 92, 246, 0.12); border: 1px solid rgba(139, 92, 246, 0.25); color: #7c3aed; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <span class="material-symbols-outlined" style="font-size: 22px;">admin_panel_settings</span>
                    </div>
                    <div>
                        <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0; letter-spacing: -0.01em;">Assigned Administrative Roles</h2>
                        <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Manage security roles and permission boundaries for @Model.UserName.</p>
                    </div>
                </div>
                <span style="font-size: 12px; color: var(--admin-text-muted);">Assign multiple roles for blended duties</span>
            </div>

            <div style="padding: 24px; background: var(--admin-bg-surface);">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
                    @for (int i = 0; i < Model.AvailableRoles.Count; i++)
                    {
                        var role = Model.AvailableRoles[i];
                        var isChecked = Model.Input.SelectedRoles != null && Model.Input.SelectedRoles.Contains(role.Name);
                        <label style="display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); cursor: pointer; transition: var(--transition);">
                            <input type="checkbox" name="Input.SelectedRoles" value="@role.Name" @(isChecked ? "checked" : "") 
                                   style="width: 18px; height: 18px; margin-top: 3px; accent-color: var(--admin-primary); cursor: pointer;" />
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                                    <strong style="color: var(--admin-text); font-size: 14px;">@role.Name</strong>
                                    @if (role.Name == "SuperAdmin")
                                    {
                                        <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: var(--admin-danger); font-size: 11px;">Full Access</span>
                                    }
                                    else if (role.Name == "Admin")
                                    {
                                        <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-size: 11px;">Recommended</span>
                                    }
                                </div>
                                <p style="font-size: 12px; color: var(--admin-text-muted); margin: 0; line-height: 1.45;">@role.Description</p>
                            </div>
                        </label>
                    }
                </div>
                <span asp-validation-for="Input.SelectedRoles" style="color: var(--admin-danger); font-size: 12px; margin-top: 10px; display: block;"></span>
            </div>
        </div>

        @* ── Section 3: Password Reset & Account Governance ── *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="display: flex; align-items: center; gap: 14px; padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-md); background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); color: #059669; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <span class="material-symbols-outlined" style="font-size: 22px;">lock</span>
                </div>
                <div>
                    <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0; letter-spacing: -0.01em;">Credentials &amp; Security Policy</h2>
                    <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Reset login credentials or enforce two-factor authentication.</p>
                </div>
            </div>

            <div style="padding: 24px; background: var(--admin-bg-surface);">
                <div style="margin-bottom: 20px; padding: 18px 20px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md);">
                    <label asp-for="Input.NewPassword" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 4px;">
                        Reset Password (Leave blank to keep current)
                    </label>
                    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 0 0 10px 0;">Enter a new password (min 8 characters) to reset the operator's credentials immediately.</p>
                    <input asp-for="Input.NewPassword" type="password" placeholder="••••••••••••" class="form-control" 
                           style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                    <span asp-validation-for="Input.NewPassword" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px;">
                    <div style="padding: 16px 20px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; align-items: center; gap: 12px;">
                        <input type="checkbox" id="Input_IsActive" asp-for="Input.IsActive" class="form-check-input" style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--admin-primary);" />
                        <div>
                            <label for="Input_IsActive" style="font-size: 13.5px; font-weight: 600; color: var(--admin-text); cursor: pointer; margin: 0;">
                                Operator Account is Active
                            </label>
                            <span style="font-size: 12px; color: var(--admin-text-muted); display: block; margin-top: 2px;">Allow this operator to sign in to platform management portals.</span>
                        </div>
                    </div>

                    <div style="padding: 16px 20px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; align-items: center; gap: 12px;">
                        <input type="checkbox" id="Input_TwoFactorEnabled" asp-for="Input.TwoFactorEnabled" class="form-check-input" style="width: 18px; height: 18px; cursor: pointer; accent-color: var(--admin-primary);" />
                        <div>
                            <label for="Input_TwoFactorEnabled" style="font-size: 13.5px; font-weight: 600; color: var(--admin-text); cursor: pointer; margin: 0;">
                                Enforce Two-Factor Authentication (2FA)
                            </label>
                            <span style="font-size: 12px; color: var(--admin-text-muted); display: block; margin-top: 2px;">Requires a 6-digit email OTP verification code at login.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Action Buttons Footer ── *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--admin-text-muted);">
                <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-text-dim);">security</span>
                <span>Permission changes take effect immediately on the operator's active session.</span>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/centralwks/users/details/@Model.Id" class="btn-admin btn-admin-secondary" style="padding: 10px 22px; font-size: 13.5px; border: 1px solid var(--admin-border);">Cancel</a>
                <button type="submit" class="btn-admin btn-admin-primary" style="padding: 10px 28px; font-size: 13.5px;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</form>
