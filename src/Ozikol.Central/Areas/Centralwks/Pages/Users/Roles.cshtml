@page "/centralwks/users/roles"
@model Ozikol.Central.Areas.Centralwks.Pages.Users.RolesModel
@{
    ViewData["Title"] = "Platform Security Roles";
    ViewData["BreadcrumbSection"] = "Identity";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/users" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Operators</a>
        </div>
        <h1 class="admin-title">Role-Based Access Control (RBAC)</h1>
        <p class="admin-subtitle">Define and audit central platform security roles and inspect assigned operator distribution.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
    @* Left Column: Roles Table *@
    <div class="admin-card" style="padding: 0; overflow: hidden;">
        <div style="padding: 18px 20px; border-bottom: 1px solid var(--admin-card-border);">
            <h2 style="font-size: 15px; font-weight: 600; color: var(--admin-text); margin: 0;">Defined Roles (@Model.Roles.Count)</h2>
        </div>
        <div style="overflow-x: auto;">
            <table class="admin-table" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--admin-card-border); background: rgba(255, 255, 255, 0.02);">
                        <th style="padding: 12px 20px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Role Name</th>
                        <th style="padding: 12px 14px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Description</th>
                        <th style="padding: 12px 14px; text-align: center; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Members</th>
                        <th style="padding: 12px 20px; text-align: right; font-size: 11px; text-transform: uppercase; color: var(--admin-text-muted);">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model.Roles)
                    {
                        <tr style="border-bottom: 1px solid var(--admin-card-border);">
                            <td style="padding: 14px 20px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="font-size: 16px;">🛡️</span>
                                    <span style="font-weight: 600; color: #93c5fd; font-size: 14px;">@role.Name</span>
                                </div>
                            </td>
                            <td style="padding: 14px 14px; font-size: 13px; color: #cbd5e1;">
                                @(string.IsNullOrEmpty(role.Description) ? "Standard security role" : role.Description)
                            </td>
                            <td style="padding: 14px 14px; text-align: center;">
                                <a href="/centralwks/users?roleFilter=@role.Name" style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; padding: 3px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; text-decoration: none;">
                                    @role.UserCount users
                                </a>
                            </td>
                            <td style="padding: 14px 20px; text-align: right;">
                                @if (role.UserCount == 0 && role.Name != "SuperAdmin" && role.Name != "Admin")
                                {
                                    <form method="post" asp-page-handler="DeleteRole" asp-route-id="@role.Id" style="display: inline;">
                                        <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 10px; font-size: 11px;" onclick="return confirm('Delete role @role.Name?');">
                                            Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="font-size: 11px; color: var(--admin-text-muted);">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Right Column: Create Role Form *@
    <div class="admin-card" style="padding: 20px;">
        <h3 style="font-size: 14px; font-weight: 600; color: var(--admin-text); margin-bottom: 16px;">Create Custom Role</h3>
        
        <form method="post" asp-page-handler="CreateRole">
            <div style="margin-bottom: 14px;">
                <label asp-for="Input.RoleName" style="display: block; font-size: 12px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Role Name <span style="color: #f87171;">*</span>
                </label>
                <input asp-for="Input.RoleName" placeholder="e.g. AuditInspector" 
                       class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
                <span asp-validation-for="Input.RoleName" style="color: #f87171; font-size: 11px; margin-top: 4px; display: block;"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label asp-for="Input.Description" style="display: block; font-size: 12px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Role Description
                </label>
                <textarea asp-for="Input.Description" rows="3" placeholder="Access privileges and security scope of this role..." 
                          class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;"></textarea>
            </div>

            <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%;">
                Create Role
            </button>
        </form>
    </div>
</div>
