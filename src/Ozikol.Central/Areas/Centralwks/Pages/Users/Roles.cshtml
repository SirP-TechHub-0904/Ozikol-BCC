@page "/centralwks/users/roles"
@model Ozikol.Central.Areas.Centralwks.Pages.Users.RolesModel
@{
    ViewData["Title"] = "Platform Security Roles";
    ViewData["BreadcrumbSection"] = "Identity";
}

<div class="admin-page-header" style="width: 100%; margin-bottom: 24px;">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/users" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; text-decoration: none;">
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span> Back to Operators
            </a>
        </div>
        <h1 class="admin-title">Role-Based Access Control (RBAC)</h1>
        <p class="admin-subtitle">Define and audit central platform security roles and inspect assigned operator distribution.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="admin-alert admin-alert-info" style="width: 100%; margin-bottom: 24px;">
        <span class="material-symbols-outlined alert-icon">info</span>
        <div class="alert-message">@Model.StatusMessage</div>
    </div>
}

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start; width: 100%;">
    @* Left Column: Roles Table *@
    <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; align-items: center; justify-content: space-between;">
            <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0;">Defined Roles (@Model.Roles.Count)</h2>
            <span style="font-size: 12px; color: var(--admin-text-muted);">Platform Access Tiers</span>
        </div>
        <div style="overflow-x: auto;">
            <table class="admin-table" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                        <th style="padding: 12px 20px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-dim);">Role Name</th>
                        <th style="padding: 12px 16px; text-align: left; font-size: 11px; text-transform: uppercase; color: var(--admin-text-dim);">Description</th>
                        <th style="padding: 12px 16px; text-align: center; font-size: 11px; text-transform: uppercase; color: var(--admin-text-dim);">Members</th>
                        <th style="padding: 12px 20px; text-align: right; font-size: 11px; text-transform: uppercase; color: var(--admin-text-dim);">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model.Roles)
                    {
                        <tr style="border-bottom: 1px solid var(--admin-border);">
                            <td style="padding: 14px 20px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span class="material-symbols-outlined" style="font-size: 20px; color: var(--admin-primary);">shield</span>
                                    <span style="font-weight: 600; color: var(--admin-text); font-size: 14px;">@role.Name</span>
                                </div>
                            </td>
                            <td style="padding: 14px 16px; font-size: 13px; color: var(--admin-text-muted);">
                                @(string.IsNullOrEmpty(role.Description) ? "Standard security role" : role.Description)
                            </td>
                            <td style="padding: 14px 16px; text-align: center;">
                                <a href="/centralwks/users?roleFilter=@role.Name" class="badge badge-indigo" style="text-decoration: none; padding: 4px 10px;">
                                    @role.UserCount users
                                </a>
                            </td>
                            <td style="padding: 14px 20px; text-align: right;">
                                @if (role.UserCount == 0 && role.Name != "SuperAdmin" && role.Name != "Admin")
                                {
                                    <form method="post" asp-page-handler="DeleteRole" asp-route-id="@role.Id" style="display: inline;">
                                        <button type="submit" class="btn-admin btn-admin-danger" style="padding: 4px 10px; font-size: 11.5px;" onclick="return confirm('Delete role @role.Name?');">
                                            Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span style="font-size: 11.5px; color: var(--admin-text-dim); font-weight: 500;">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Right Column: Create Role Form *@
    <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden;">
        <div style="padding: 18px 20px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
            <h3 style="font-size: 14.5px; font-weight: 600; color: var(--admin-text); margin: 0;">Create Custom Role</h3>
        </div>
        
        <div style="padding: 20px;">
            <form method="post" asp-page-handler="CreateRole">
                <div style="margin-bottom: 16px;">
                    <label asp-for="Input.RoleName" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                        Role Name <span style="color: var(--admin-danger);">*</span>
                    </label>
                    <input asp-for="Input.RoleName" placeholder="e.g. AuditInspector" class="form-control" 
                           style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                    <span asp-validation-for="Input.RoleName" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                </div>

                <div style="margin-bottom: 20px;">
                    <label asp-for="Input.Description" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                        Role Description
                    </label>
                    <textarea asp-for="Input.Description" rows="3" placeholder="Access privileges and security scope of this role..." 
                              class="form-control" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);"></textarea>
                </div>

                <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; padding: 10px;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">add_moderator</span>
                    Create Role
                </button>
            </form>
        </div>
    </div>
</div>
