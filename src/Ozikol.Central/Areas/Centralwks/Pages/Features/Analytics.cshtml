@page
@model Ozikol.Central.Areas.Centralwks.Pages.Features.AnalyticsModel
@using System.Text.Json
@{
    ViewData["Title"] = "Tenant Feature Adoption & Subscriptions";
    ViewData["BreadcrumbSection"] = "Platform Core";

    int tenantStartRow = Model.TotalFilteredTenants == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    int tenantEndRow = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalFilteredTenants);

    int featStartRow = Model.TotalFilteredFeatures == 0 ? 0 : ((Model.FeaturePageNumber - 1) * Model.FeaturePageSize) + 1;
    int featEndRow = Math.Min(Model.FeaturePageNumber * Model.FeaturePageSize, Model.TotalFilteredFeatures);
}

<style>
    .tfa-shell {
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding-bottom: 40px;
    }

    /* ── 4 Balanced Dual-Metric Dashboard KPI Cards ── */
    .tfa-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }

    @@media (max-width: 1200px) {
        .tfa-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 640px) {
        .tfa-kpi-grid {
            grid-template-columns: 1fr;
        }
    }

    .tfa-kpi-card {
        background: var(--admin-bg-surface, #ffffff);
        border: 1px solid var(--admin-border, #e2e8f0);
        border-radius: 14px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
        transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
    }

    .tfa-kpi-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.06);
        border-color: #cbd5e1;
    }

    .tfa-kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .tfa-kpi-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
        flex: 1;
    }

    .tfa-kpi-label {
        font-size: 12px;
        font-weight: 700;
        color: #64748b;
        letter-spacing: 0.01em;
    }

    .tfa-kpi-dual {
        display: flex;
        align-items: baseline;
        gap: 10px;
        flex-wrap: wrap;
    }

    .tfa-kpi-num {
        font-size: 23px;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: #0f172a;
    }

    .tfa-kpi-sep {
        font-size: 17px;
        font-weight: 400;
        color: #cbd5e1;
    }

    .tfa-kpi-sub {
        font-size: 11.5px;
        font-weight: 600;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    /* ── Clean 2-Tab Bar ── */
    .tfa-tabs-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid var(--admin-border, #e2e8f0);
        padding-bottom: 0;
    }

    .tfa-tab-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        font-size: 13.5px;
        font-weight: 700;
        color: #64748b;
        text-decoration: none;
        border-bottom: 2.5px solid transparent;
        margin-bottom: -1px;
        transition: all 0.15s ease;
        cursor: pointer;
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
    }

    .tfa-tab-link:hover {
        color: #0f172a;
    }

    .tfa-tab-link.active {
        color: #0050E5;
        border-bottom-color: #0050E5;
    }

    .tfa-tab-count {
        font-size: 11px;
        font-weight: 800;
        padding: 2px 8px;
        border-radius: 999px;
        background: #eff6ff;
        color: #0050E5;
    }

    /* ── Main Card & Sleek Material Design 3 Filter Toolbar ── */
    .tfa-card {
        background: var(--admin-bg-surface, #ffffff);
        border: 1px solid var(--admin-border, #e2e8f0);
        border-radius: 14px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
        overflow: hidden;
    }

    .tfa-toolbar {
        padding: 16px 20px;
        border-bottom: 1px solid var(--admin-border, #e2e8f0);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        background: #ffffff;
    }

    .tfa-filter-form {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        flex: 1;
        margin: 0;
    }

    .tfa-search-wrap {
        position: relative;
        flex: 1 1 260px;
        max-width: 360px;
        min-width: 220px;
    }

    .tfa-search-wrap .material-symbols-outlined {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: #94a3b8;
        pointer-events: none;
    }

    .tfa-search-input {
        width: 100%;
        height: 38px;
        padding: 0 12px 0 38px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #0f172a;
        font-size: 13px;
        font-weight: 500;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    }

    .tfa-search-input::placeholder {
        color: #94a3b8;
        font-weight: 400;
    }

    .tfa-search-input:focus {
        background: #ffffff;
        border-color: #0050E5;
        box-shadow: 0 0 0 3px rgba(0, 80, 229, 0.1);
    }

    .tfa-select {
        height: 38px;
        padding: 0 32px 0 12px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 12.5px;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .tfa-select:focus {
        background-color: #ffffff;
        border-color: #0050E5;
        box-shadow: 0 0 0 3px rgba(0, 80, 229, 0.1);
    }

    .tfa-btn-filter {
        height: 38px;
        padding: 0 16px;
        border-radius: 10px;
        border: 1px solid #0050E5;
        background: #0050E5;
        color: #ffffff;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .tfa-btn-filter:hover {
        background: #003eb3;
    }

    .tfa-btn-clear {
        height: 38px;
        padding: 0 12px;
        border-radius: 10px;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #dc2626;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
    }

    .tfa-showing-meta {
        font-size: 12.5px;
        color: #64748b;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    /* ── Policy Pills in Table ── */
    .tfa-policy-stack {
        display: flex;
        flex-direction: column;
        gap: 5px;
        align-items: flex-start;
    }

    .tfa-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
    }

    .tfa-pill-general {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .tfa-pill-custom-price {
        background: #eff6ff;
        color: #0050E5;
        border: 1px solid #bfdbfe;
    }

    .tfa-pill-custom-avail {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    /* ── Pagination Bar ── */
    .tfa-pagination-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 14px 20px;
        border-top: 1px solid var(--admin-border, #e2e8f0);
        background: #f8fafc;
    }

    .tfa-page-info {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12.5px;
        color: #64748b;
        font-weight: 500;
    }

    .tfa-page-controls {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .tfa-page-btn {
        min-width: 34px;
        height: 34px;
        padding: 0 10px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        color: #334155;
        font-size: 12.5px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    .tfa-page-btn:hover:not(.disabled):not(.active) {
        border-color: #0050E5;
        color: #0050E5;
        background: #eff6ff;
    }

    .tfa-page-btn.active {
        background: #0050E5;
        border-color: #0050E5;
        color: #ffffff;
    }

    .tfa-page-btn.disabled {
        opacity: 0.45;
        pointer-events: none;
        background: #f1f5f9;
    }
</style>

<div class="tfa-shell">
    @* ── Page Header ── *@
    <div class="admin-page-header" style="margin-bottom: 0;">
        <div class="admin-title-group">
            <h1 class="admin-title">Tenant Feature Adoption &amp; Subscriptions</h1>
            <p class="admin-subtitle">Manage tenant active capabilities, General vs. Custom Pricing, General vs. Custom Availability, and recurring feature revenue.</p>
        </div>
        <div class="admin-actions">
            <a href="/centralwks/features" class="btn-admin btn-admin-secondary">
                <span class="material-symbols-outlined" style="font-size: 16px;">list_alt</span>
                Master Feature Directory
            </a>
            <a href="/centralwks/subscriptions" class="btn-admin btn-admin-primary">
                <span class="material-symbols-outlined" style="font-size: 16px;">subscriptions</span>
                Subscription Matrix
            </a>
        </div>
    </div>

    @* ── 4 Balanced Dual-Metric Dashboard KPI Cards ── *@
    <div class="tfa-kpi-grid">
        @* Card 1: Tenants (Active / Suspended) *@
        <div class="tfa-kpi-card">
            <div class="tfa-kpi-icon" style="background: #eff6ff; color: #0050E5;">
                <span class="material-symbols-outlined" style="font-size: 24px;">domain</span>
            </div>
            <div class="tfa-kpi-body">
                <span class="tfa-kpi-label">Tenants (Active / Suspended)</span>
                <div class="tfa-kpi-dual">
                    <span class="tfa-kpi-num" style="color: #059669;" title="Active Tenants">@Model.ActiveTenantsCount</span>
                    <span class="tfa-kpi-sep">/</span>
                    <span class="tfa-kpi-num" style="color: #64748b;" title="Suspended or Inactive Tenants">@Model.SuspendedTenantsCount</span>
                </div>
                <div class="tfa-kpi-sub">
                    <span><strong>@Model.PaidTierTenantsCount</strong> Paid Tier</span>
                    <span>•</span>
                    <span><strong>@Model.FreeTierTenantsCount</strong> Free Tier</span>
                </div>
            </div>
        </div>

        @* Card 2: Capabilities (Available / Coming Soon) *@
        <div class="tfa-kpi-card">
            <div class="tfa-kpi-icon" style="background: #ecfdf5; color: #059669;">
                <span class="material-symbols-outlined" style="font-size: 24px;">verified</span>
            </div>
            <div class="tfa-kpi-body">
                <span class="tfa-kpi-label">Available / Coming Soon</span>
                <div class="tfa-kpi-dual">
                    <span class="tfa-kpi-num" style="color: #059669;" title="Available for Use">@Model.AvailableForUseCount</span>
                    <span class="tfa-kpi-sep">/</span>
                    <span class="tfa-kpi-num" style="color: #d97706;" title="Coming Soon">@Model.ComingSoonCount</span>
                </div>
                <div class="tfa-kpi-sub">
                    <span><strong>@Model.TotalCapabilities</strong> Capabilities across <strong>10 Suites</strong></span>
                </div>
            </div>
        </div>

        @* Card 3: Custom Pricing / Custom Availability *@
        <div class="tfa-kpi-card">
            <div class="tfa-kpi-icon" style="background: #f5f3ff; color: #7c3aed;">
                <span class="material-symbols-outlined" style="font-size: 24px;">tune</span>
            </div>
            <div class="tfa-kpi-body">
                <span class="tfa-kpi-label">Custom Pricing / Availability</span>
                <div class="tfa-kpi-dual">
                    <a href="/centralwks/features/analytics?activeTab=tenants&policyFilter=CustomPricing" style="text-decoration: none;" title="Filter tenants with Custom Pricing">
                        <span class="tfa-kpi-num" style="color: #0050E5;">@Model.CustomPricingTenantsCount</span>
                    </a>
                    <span class="tfa-kpi-sep">/</span>
                    <a href="/centralwks/features/analytics?activeTab=tenants&policyFilter=CustomAvailability" style="text-decoration: none;" title="Filter tenants with Custom Availability">
                        <span class="tfa-kpi-num" style="color: #059669;">@Model.CustomAvailabilityTenantsCount</span>
                    </a>
                </div>
                <div class="tfa-kpi-sub">
                    <span>Custom $ Tenants</span>
                    <span>•</span>
                    <span>Custom Availability</span>
                </div>
            </div>
        </div>

        @* Card 4: Monthly Feature Revenue (MRR) *@
        <div class="tfa-kpi-card">
            <div class="tfa-kpi-icon" style="background: #eff6ff; color: #0050E5;">
                <span class="material-symbols-outlined" style="font-size: 24px;">payments</span>
            </div>
            <div class="tfa-kpi-body">
                <span class="tfa-kpi-label">Monthly Feature Revenue (MRR)</span>
                <div class="tfa-kpi-dual">
                    <a href="/centralwks/features/analytics?activeTab=tenants&policyFilter=PaidTier" style="text-decoration: none;">
                        <span class="tfa-kpi-num" style="color: #0050E5;">$@Model.TotalSubscriptionMrr.ToString("N2")<span style="font-size: 12px; font-weight: 600; color: #64748b;">/mo</span></span>
                    </a>
                </div>
                <div class="tfa-kpi-sub">
                    <span>Across <strong>@Model.TotalPaidAddonSubscriptions</strong> active add-on subscriptions</span>
                </div>
            </div>
        </div>
    </div>

    @* ── Simplified 2-Tab Navigation Bar ── *@
    <div class="tfa-tabs-bar">
        <a href="/centralwks/features/analytics?activeTab=tenants" class="tfa-tab-link @(Model.ActiveTab == "tenants" ? "active" : "")">
            <span class="material-symbols-outlined" style="font-size: 18px;">domain_verification</span>
            Tenants &amp; Subscriptions
            <span class="tfa-tab-count">@Model.TotalFilteredTenants</span>
        </a>
        <a href="/centralwks/features/analytics?activeTab=ranking" class="tfa-tab-link @(Model.ActiveTab == "ranking" ? "active" : "")">
            <span class="material-symbols-outlined" style="font-size: 18px;">bar_chart</span>
            Capability Adoption &amp; Revenue
            <span class="tfa-tab-count">@Model.TotalFilteredFeatures</span>
        </a>
    </div>

    @* ========================================================================= *@
    @* ── TAB 1: TENANTS & SUBSCRIPTIONS ── *@
    @* ========================================================================= *@
    @if (Model.ActiveTab == "tenants")
    {
        <div class="tfa-card">
            @* Sleek Single-Row Search & Filter Toolbar *@
            <div class="tfa-toolbar">
                <form method="get" class="tfa-filter-form">
                    <input type="hidden" name="activeTab" value="tenants" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />

                    <div class="tfa-search-wrap">
                        <span class="material-symbols-outlined">search</span>
                        <input type="text" name="tenantSearch" value="@Model.TenantSearch" placeholder="Search tenant name, key, domain, email..." class="tfa-search-input" />
                    </div>

                    <select name="policyFilter" class="tfa-select" onchange="this.form.submit()">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.PolicyFilter) || Model.PolicyFilter == "All")">All Pricing &amp; Policies</option>
                        <option value="CustomPricing" selected="@(Model.PolicyFilter == "CustomPricing")">Custom Pricing Enabled (@Model.CustomPricingTenantsCount)</option>
                        <option value="GeneralPricing" selected="@(Model.PolicyFilter == "GeneralPricing")">General Pricing Only</option>
                        <option value="CustomAvailability" selected="@(Model.PolicyFilter == "CustomAvailability")">Custom Availability (@Model.CustomAvailabilityTenantsCount)</option>
                        <option value="PaidTier" selected="@(Model.PolicyFilter == "PaidTier")">Paid Tier Tenants (@Model.PaidTierTenantsCount)</option>
                        <option value="FreeTier" selected="@(Model.PolicyFilter == "FreeTier")">Free Tier Tenants (@Model.FreeTierTenantsCount)</option>
                    </select>

                    <select name="usageFilter" class="tfa-select" onchange="this.form.submit()">
                        <option value="All" selected="@(string.IsNullOrEmpty(Model.UsageFilter) || Model.UsageFilter == "All")">All Activity Levels</option>
                        <option value="High Activity" selected="@(Model.UsageFilter == "High Activity")">High Activity (&lt; 24h)</option>
                        <option value="Active" selected="@(Model.UsageFilter == "Active")">Active (&lt; 7d)</option>
                        <option value="Moderate" selected="@(Model.UsageFilter == "Moderate")">Moderate (&lt; 30d)</option>
                        <option value="Dormant" selected="@(Model.UsageFilter == "Dormant")">Dormant</option>
                    </select>

                    <button type="submit" class="tfa-btn-filter">
                        <span class="material-symbols-outlined" style="font-size: 16px;">filter_list</span>
                        Filter
                    </button>

                    @if (!string.IsNullOrEmpty(Model.TenantSearch) || (!string.IsNullOrEmpty(Model.UsageFilter) && Model.UsageFilter != "All") || (!string.IsNullOrEmpty(Model.PolicyFilter) && Model.PolicyFilter != "All"))
                    {
                        <a href="/centralwks/features/analytics?activeTab=tenants&pageSize=@Model.PageSize" class="tfa-btn-clear">
                            <span class="material-symbols-outlined" style="font-size: 15px;">close</span>
                            Reset
                        </a>
                    }
                </form>

                <div class="tfa-showing-meta">
                    <span class="material-symbols-outlined" style="font-size: 16px;">format_list_numbered</span>
                    Showing <strong>@tenantStartRow–@tenantEndRow</strong> of <strong>@Model.TotalFilteredTenants</strong> tenants
                </div>
            </div>

            @* Tenants Table *@
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width: 52px; text-align: center;">S/N</th>
                            <th>Tenant Organization</th>
                            <th>Active / Not Active</th>
                            <th>Pricing &amp; Availability Policy</th>
                            <th>Last Activity</th>
                            <th>Monthly Spend (MRR)</th>
                            <th>Status</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PaginatedTenants.Any())
                        {
                            @for (int i = 0; i < Model.PaginatedTenants.Count; i++)
                            {
                                var t = Model.PaginatedTenants[i];
                                int rowNumber = ((Model.PageNumber - 1) * Model.PageSize) + i + 1;
                                <tr>
                                    <td style="text-align: center;">
                                        <span class="badge" style="background: #f1f5f9; color: #475569; font-weight: 700; font-size: 11px;">@rowNumber</span>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #eff6ff; color: #0050E5; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; flex-shrink: 0;">
                                                @(t.OrganizationName.Length > 0 ? t.OrganizationName.Substring(0, 1).ToUpperInvariant() : "T")
                                            </div>
                                            <div>
                                                <div style="font-weight: 700; color: #0f172a; font-size: 13.5px;">
                                                    @t.OrganizationName
                                                </div>
                                                <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                                                    <code style="font-size: 11px; padding: 1px 6px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 4px; color: #0050E5; font-weight: 700;">
                                                        @t.TenantKey
                                                    </code>
                                                    <span style="font-size: 11.5px; color: #64748b;">
                                                        @t.PrimaryDomain
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="min-width: 155px;">
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                                                <span style="font-size: 12.5px; font-weight: 700; color: #0f172a;">
                                                    <span style="color: #059669;">@t.TotalActiveFeaturesCount Active</span>
                                                    <span style="color: #cbd5e1; margin: 0 3px;">/</span>
                                                    <span style="color: #64748b;">@t.InactiveFeaturesCount Off</span>
                                                </span>
                                                <span style="font-size: 11.5px; font-weight: 700; color: #0050E5;">
                                                    @t.AdoptionPercentage.ToString("F0")%
                                                </span>
                                            </div>
                                            <div style="height: 6px; background: #f1f5f9; border-radius: 3px; overflow: hidden;">
                                                <div style="height: 100%; width: @Math.Min(100, Math.Max(5, t.AdoptionPercentage))%; background: linear-gradient(90deg, #0050E5 0%, #10b981 100%); border-radius: 3px;"></div>
                                            </div>
                                            <div style="font-size: 11px; color: #64748b; margin-top: 3px;">
                                                @t.CompulsoryFeaturesCount Core + @t.SubscribedAddonsCount Add-ons
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="tfa-policy-stack">
                                            @if (t.UseCustomPricing)
                                            {
                                                <span class="tfa-pill tfa-pill-custom-price" title="Tenant uses custom feature pricing">
                                                    <span class="material-symbols-outlined" style="font-size: 13px;">sell</span>
                                                    Custom Pricing @(t.CustomPricedFeaturesCount > 0 ? $"({t.CustomPricedFeaturesCount})" : "")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tfa-pill tfa-pill-general" title="Inherits Master Catalog pricing">
                                                    <span class="material-symbols-outlined" style="font-size: 13px;">public</span>
                                                    General Pricing
                                                </span>
                                            }

                                            @if (t.UseCustomAvailability)
                                            {
                                                <span class="tfa-pill tfa-pill-custom-avail" title="Tenant uses custom feature availability">
                                                    <span class="material-symbols-outlined" style="font-size: 13px;">tune</span>
                                                    Custom Availability @(t.CustomAvailabilityFeaturesCount > 0 ? $"({t.CustomAvailabilityFeaturesCount})" : "")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="tfa-pill tfa-pill-general" title="Inherits Master Catalog availability">
                                                    <span class="material-symbols-outlined" style="font-size: 13px;">check_circle</span>
                                                    General Availability
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div style="display: flex; flex-direction: column; gap: 3px; align-items: flex-start;">
                                            <span class="badge" style="background: @(t.UsageLevelColor)18; color: @t.UsageLevelColor; border: 1px solid @(t.UsageLevelColor)40; font-weight: 700; font-size: 11px;">
                                                <span class="badge-dot" style="background-color: @t.UsageLevelColor;"></span>
                                                @t.UsageLevel
                                            </span>
                                            <span style="font-size: 11px; color: #64748b;">
                                                @t.LastUsedDisplay
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (t.MonthlyRevenueMrr > 0)
                                        {
                                            <div style="font-size: 13.5px; font-weight: 800; color: #0f172a;">
                                                $@t.MonthlyRevenueMrr.ToString("N2") <span style="font-size: 11px; font-weight: 500; color: #64748b;">/mo</span>
                                            </div>
                                            @if (t.UseCustomPricing)
                                            {
                                                <div style="font-size: 10.5px; font-weight: 700; color: #0050E5;">Custom Rate Active</div>
                                            }
                                        }
                                        else
                                        {
                                            <div style="font-size: 13px; font-weight: 700; color: #64748b;">
                                                $0.00 <span style="font-size: 10px; padding: 2px 6px; background: #ecfdf5; color: #059669; border-radius: 4px; font-weight: 700;">Free Tier</span>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (t.IsSuspended)
                                        {
                                            <span class="badge badge-danger" style="font-size: 11px;">Suspended</span>
                                        }
                                        else if (t.IsActive)
                                        {
                                            <span class="badge badge-success" style="font-size: 11px;">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-neutral" style="font-size: 11px;">Inactive</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <div style="display: inline-flex; gap: 6px; align-items: center;">
                                            <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" onclick='openFeatureModal(@Html.Raw(JsonSerializer.Serialize(t.OrganizationName)), @Html.Raw(JsonSerializer.Serialize(t.TenantKey)), "@t.TenantId", @Html.Raw(t.AllFeaturesJson))' title="Quick Inspect Active & Inactive Features">
                                                <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span>
                                                Inspect
                                            </button>
                                            <a href="/centralwks/tenants/features?tenantId=@t.TenantId" class="btn-admin btn-admin-primary btn-admin-sm" title="Manage Active/Not Active, Custom Pricing & Availability">
                                                <span class="material-symbols-outlined" style="font-size: 15px;">tune</span>
                                                Manage
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state" style="padding: 48px 20px; text-align: center;">
                                        <span class="material-symbols-outlined" style="font-size: 38px; color: #94a3b8; margin-bottom: 8px;">domain_disabled</span>
                                        <h3 style="margin: 0 0 4px 0; font-size: 15px; font-weight: 700; color: #0f172a;">No Tenants Match Your Filter</h3>
                                        <p style="margin: 0; font-size: 13px; color: #64748b;">Try clearing the search box or switching the policy/activity dropdown.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination Footer *@
            <div class="tfa-pagination-bar">
                <div class="tfa-page-info">
                    <span>Showing <strong>@tenantStartRow</strong> to <strong>@tenantEndRow</strong> of <strong>@Model.TotalFilteredTenants</strong> tenants</span>
                    <form method="get" style="display: inline-flex; align-items: center; gap: 6px; margin: 0;">
                        <input type="hidden" name="activeTab" value="tenants" />
                        <input type="hidden" name="tenantSearch" value="@Model.TenantSearch" />
                        <input type="hidden" name="usageFilter" value="@Model.UsageFilter" />
                        <input type="hidden" name="policyFilter" value="@Model.PolicyFilter" />
                        <input type="hidden" name="pageNumber" value="1" />
                        <label style="font-size: 12px; color: #64748b;">Rows:</label>
                        <select name="pageSize" onchange="this.form.submit()" class="tfa-select" style="height: 32px; padding: 0 24px 0 10px; font-size: 12px;">
                            <option value="10" selected="@(Model.PageSize == 10)">10 / page</option>
                            <option value="20" selected="@(Model.PageSize == 20)">20 / page</option>
                            <option value="50" selected="@(Model.PageSize == 50)">50 / page</option>
                        </select>
                    </form>
                </div>

                <div class="tfa-page-controls">
                    @{
                        string BuildTenantPageUrl(int targetPage) =>
                            $"/centralwks/features/analytics?activeTab=tenants&pageNumber={targetPage}&pageSize={Model.PageSize}&tenantSearch={Uri.EscapeDataString(Model.TenantSearch ?? "")}&usageFilter={Uri.EscapeDataString(Model.UsageFilter ?? "All")}&policyFilter={Uri.EscapeDataString(Model.PolicyFilter ?? "All")}";
                    }
                    <a href="@BuildTenantPageUrl(Math.Max(1, Model.PageNumber - 1))" class="tfa-page-btn @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <span class="material-symbols-outlined" style="font-size: 16px;">chevron_left</span>
                        Prev
                    </a>

                    @for (int p = 1; p <= Model.TotalTenantPages; p++)
                    {
                        if (p == 1 || p == Model.TotalTenantPages || Math.Abs(p - Model.PageNumber) <= 2)
                        {
                            <a href="@BuildTenantPageUrl(p)" class="tfa-page-btn @(p == Model.PageNumber ? "active" : "")">@p</a>
                        }
                        else if (Math.Abs(p - Model.PageNumber) == 3)
                        {
                            <span style="color: #94a3b8; padding: 0 4px;">…</span>
                        }
                    }

                    <a href="@BuildTenantPageUrl(Math.Min(Model.TotalTenantPages, Model.PageNumber + 1))" class="tfa-page-btn @(Model.PageNumber >= Model.TotalTenantPages ? "disabled" : "")">
                        Next
                        <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
                    </a>
                </div>
            </div>
        </div>
    }

    @* ========================================================================= *@
    @* ── TAB 2: CAPABILITY ADOPTION & REVENUE (BY SUITE) ── *@
    @* ========================================================================= *@
    @if (Model.ActiveTab == "ranking")
    {
        <div class="tfa-card">
            <div class="tfa-toolbar">
                <form method="get" class="tfa-filter-form">
                    <input type="hidden" name="activeTab" value="ranking" />
                    <input type="hidden" name="featurePageSize" value="@Model.FeaturePageSize" />

                    <div class="tfa-search-wrap">
                        <span class="material-symbols-outlined">search</span>
                        <input type="text" name="search" value="@Model.Search" placeholder="Search capability name, code, or suite..." class="tfa-search-input" />
                    </div>

                    <select name="category" class="tfa-select" onchange="this.form.submit()">
                        <option value="">All 10 Suites (@Model.TotalCapabilities)</option>
                        @foreach (var s in AnalyticsModel.CanonicalSuites)
                        {
                            <option value="@s.Name" selected="@(Model.Category == s.Name)">@s.Code — @s.Name</option>
                        }
                    </select>

                    <button type="submit" class="tfa-btn-filter">
                        <span class="material-symbols-outlined" style="font-size: 16px;">filter_list</span>
                        Filter
                    </button>

                    @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Category))
                    {
                        <a href="/centralwks/features/analytics?activeTab=ranking&featurePageSize=@Model.FeaturePageSize" class="tfa-btn-clear">
                            <span class="material-symbols-outlined" style="font-size: 15px;">close</span>
                            Reset
                        </a>
                    }
                </form>

                <div class="tfa-showing-meta">
                    <span class="material-symbols-outlined" style="font-size: 16px;">format_list_numbered</span>
                    Showing <strong>@featStartRow–@featEndRow</strong> of <strong>@Model.TotalFilteredFeatures</strong> capabilities
                </div>
            </div>

            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width: 52px; text-align: center;">S/N</th>
                            <th>Capability &amp; Code</th>
                            <th>Suite</th>
                            <th>Catalog Status</th>
                            <th>General Price</th>
                            <th>Active Tenants</th>
                            <th>Monthly Revenue (MRR)</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PaginatedRankedFeatures.Any())
                        {
                            @for (int i = 0; i < Model.PaginatedRankedFeatures.Count; i++)
                            {
                                var item = Model.PaginatedRankedFeatures[i];
                                var feat = item.Feature;
                                var iconName = string.IsNullOrEmpty(feat.Icon) ? "extension" : feat.Icon;
                                int rowNumber = ((Model.FeaturePageNumber - 1) * Model.FeaturePageSize) + i + 1;
                                <tr>
                                    <td style="text-align: center;">
                                        <span class="badge" style="background: #f1f5f9; color: #475569; font-weight: 700; font-size: 11px;">@rowNumber</span>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <div style="width: 34px; height: 34px; border-radius: 8px; background: #eff6ff; color: #0050E5; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">@iconName</span>
                                            </div>
                                            <div>
                                                <div style="font-weight: 700; color: #0f172a; font-size: 13.5px;">@feat.Name</div>
                                                <code style="font-size: 11px; color: #0050E5;">@feat.FeatureCode</code>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 6px;">
                                            <span style="font-size: 10.5px; font-weight: 800; padding: 2px 7px; border-radius: 5px; background: #0050E5; color: #ffffff;">@item.SuiteCode</span>
                                            <span style="font-size: 12px; font-weight: 600; color: #334155;">@feat.Category</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 5px; flex-wrap: wrap;">
                                            @if (feat.IsAvailableForUse)
                                            {
                                                <span class="tfa-pill tfa-pill-custom-avail">Available</span>
                                            }
                                            else
                                            {
                                                <span class="tfa-pill" style="background: #fffbeb; color: #d97706; border: 1px solid #fde68a;">Coming Soon</span>
                                            }
                                            @if (feat.IsCompulsory)
                                            {
                                                <span class="tfa-pill tfa-pill-custom-price">Compulsory Core</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (feat.IsCompulsory && feat.MonthlyPrice <= 0)
                                        {
                                            <span style="font-size: 12.5px; font-weight: 700; color: #059669;">Included Free</span>
                                        }
                                        else
                                        {
                                            <span style="font-size: 13px; font-weight: 800; color: #0f172a;">$@feat.MonthlyPrice.ToString("N2")<span style="font-size: 11px; font-weight: 500; color: #64748b;">/mo</span></span>
                                        }
                                    </td>
                                    <td>
                                        <div style="min-width: 130px;">
                                            <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; margin-bottom: 3px;">
                                                <span>@item.SubscribersCount / @Model.TotalTenants Tenants</span>
                                                <span style="color: #0050E5;">@item.AdoptionRate.ToString("F0")%</span>
                                            </div>
                                            <div style="height: 6px; background: #f1f5f9; border-radius: 3px; overflow: hidden;">
                                                <div style="height: 100%; width: @Math.Min(100, Math.Max(4, item.AdoptionRate))%; background: @item.StatusColor; border-radius: 3px;"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-size: 13.5px; font-weight: 800; color: #0f172a;">
                                            $@item.MonthlyRecurringRevenue.ToString("N2") <span style="font-size: 11px; font-weight: 500; color: #64748b;">/mo</span>
                                        </div>
                                    </td>
                                    <td style="text-align: right;">
                                        <a href="/centralwks/features/edit?id=@feat.Id" class="btn-admin btn-admin-secondary btn-admin-sm">
                                            <span class="material-symbols-outlined" style="font-size: 15px;">edit</span>
                                            Edit Master
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* Pagination Footer for Tab 2 *@
            <div class="tfa-pagination-bar">
                <div class="tfa-page-info">
                    <span>Showing <strong>@featStartRow</strong> to <strong>@featEndRow</strong> of <strong>@Model.TotalFilteredFeatures</strong> capabilities</span>
                    <form method="get" style="display: inline-flex; align-items: center; gap: 6px; margin: 0;">
                        <input type="hidden" name="activeTab" value="ranking" />
                        <input type="hidden" name="search" value="@Model.Search" />
                        <input type="hidden" name="category" value="@Model.Category" />
                        <input type="hidden" name="featurePageNumber" value="1" />
                        <label style="font-size: 12px; color: #64748b;">Rows:</label>
                        <select name="featurePageSize" onchange="this.form.submit()" class="tfa-select" style="height: 32px; padding: 0 24px 0 10px; font-size: 12px;">
                            <option value="10" selected="@(Model.FeaturePageSize == 10)">10 / page</option>
                            <option value="20" selected="@(Model.FeaturePageSize == 20)">20 / page</option>
                            <option value="50" selected="@(Model.FeaturePageSize == 50)">50 / page</option>
                        </select>
                    </form>
                </div>

                <div class="tfa-page-controls">
                    @{
                        string BuildFeaturePageUrl(int targetPage) =>
                            $"/centralwks/features/analytics?activeTab=ranking&featurePageNumber={targetPage}&featurePageSize={Model.FeaturePageSize}&search={Uri.EscapeDataString(Model.Search ?? "")}&category={Uri.EscapeDataString(Model.Category ?? "")}";
                    }
                    <a href="@BuildFeaturePageUrl(Math.Max(1, Model.FeaturePageNumber - 1))" class="tfa-page-btn @(Model.FeaturePageNumber <= 1 ? "disabled" : "")">
                        <span class="material-symbols-outlined" style="font-size: 16px;">chevron_left</span>
                        Prev
                    </a>

                    @for (int p = 1; p <= Model.TotalFeaturePages; p++)
                    {
                        <a href="@BuildFeaturePageUrl(p)" class="tfa-page-btn @(p == Model.FeaturePageNumber ? "active" : "")">@p</a>
                    }

                    <a href="@BuildFeaturePageUrl(Math.Min(Model.TotalFeaturePages, Model.FeaturePageNumber + 1))" class="tfa-page-btn @(Model.FeaturePageNumber >= Model.TotalFeaturePages ? "disabled" : "")">
                        Next
                        <span class="material-symbols-outlined" style="font-size: 16px;">chevron_right</span>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@* ── Instant Tenant Capabilities Inspection Modal ── *@
<div id="featureModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; width: 92%; max-width: 820px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 24px 48px rgba(15, 23, 42, 0.22); overflow: hidden;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div style="width: 40px; height: 40px; border-radius: 10px; background: #eff6ff; color: #0050E5; display: flex; align-items: center; justify-content: center;">
                    <span class="material-symbols-outlined" style="font-size: 22px;">domain</span>
                </div>
                <div>
                    <h3 id="modalTenantName" style="margin: 0; font-size: 16px; font-weight: 800; color: #0f172a;">Tenant Capabilities</h3>
                    <code id="modalTenantKey" style="font-size: 11.5px; color: #0050E5; font-weight: 700;">tenant</code>
                </div>
            </div>
            <button type="button" onclick="closeFeatureModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #64748b;">&times;</button>
        </div>

        <div id="modalFeatureList" style="padding: 18px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; flex: 1;">
        </div>

        <div style="padding: 14px 24px; border-top: 1px solid #e2e8f0; background: #f8fafc; display: flex; justify-content: space-between; align-items: center;">
            <div id="modalSummaryCount" style="font-size: 12.5px; font-weight: 700; color: #475569;"></div>
            <div style="display: flex; gap: 10px;">
                <button type="button" onclick="closeFeatureModal()" class="btn-admin btn-admin-secondary btn-admin-sm">Close</button>
                <a id="modalManageBtn" href="#" class="btn-admin btn-admin-primary btn-admin-sm">
                    <span class="material-symbols-outlined" style="font-size: 16px;">tune</span>
                    Manage Active, Pricing &amp; Availability
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function openFeatureModal(orgName, tenantKey, tenantId, features) {
        document.getElementById('modalTenantName').textContent = orgName;
        document.getElementById('modalTenantKey').textContent = tenantKey;
        document.getElementById('modalManageBtn').href = '/centralwks/tenants/features?tenantId=' + tenantId;

        const container = document.getElementById('modalFeatureList');
        container.innerHTML = '';

        let activeCount = 0;
        let customPriceCount = 0;

        features.forEach(f => {
            if (f.isActive) activeCount++;
            if (f.hasCustomPrice) customPriceCount++;

            const item = document.createElement('div');
            item.style.cssText = 'display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;gap:12px;';

            const activeBadge = f.isActive
                ? '<span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;">● Active</span>'
                : '<span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0;">○ Not Active</span>';

            const availBadge = f.isAvailableForUse
                ? '<span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:#eff6ff;color:#0050E5;">Available</span>'
                : '<span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:#fffbeb;color:#d97706;">Coming Soon</span>';

            const priceNum = Number(f.recurringPrice ?? f.monthlyPrice ?? 0);
            const priceText = (f.isCompulsory && priceNum <= 0)
                ? 'Included Free'
                : ('$' + priceNum.toFixed(2) + '/mo' + (f.hasCustomPrice ? ' (Custom)' : ''));

            item.innerHTML = `
                <div style="display:flex;align-items:center;gap:10px;min-width:0;">
                    <div style="width:32px;height:32px;border-radius:8px;background:#eff6ff;color:#0050E5;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <span class="material-symbols-outlined" style="font-size:17px;">${f.icon || 'extension'}</span>
                    </div>
                    <div style="min-width:0;">
                        <div style="font-size:13px;font-weight:700;color:#0f172a;">${f.name}</div>
                        <div style="font-size:11px;color:#64748b;"><strong>${f.suiteCode || 'SUITE'}</strong> • ${f.category} • <strong>${priceText}</strong></div>
                    </div>
                </div>
                <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                    ${availBadge}
                    ${activeBadge}
                </div>
            `;
            container.appendChild(item);
        });

        document.getElementById('modalSummaryCount').textContent =
            `${activeCount} / ${features.length} Capabilities Active • ${customPriceCount} Custom Price Overrides`;
        document.getElementById('featureModal').style.display = 'flex';
    }

    function closeFeatureModal() {
        document.getElementById('featureModal').style.display = 'none';
    }

    window.addEventListener('click', function (e) {
        const modal = document.getElementById('featureModal');
        if (e.target === modal) {
            closeFeatureModal();
        }
    });
</script>
