@page
@model Ozikol.Central.Areas.Centralwks.Pages.Features.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Feature.Name}";
    ViewData["BreadcrumbSection"] = "Platform Core";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Edit Modular Capability</h1>
        <p class="admin-subtitle">Modify specifications, USD base pricing schedule, and governance status for <code>@Model.Feature.FeatureCode</code>.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/features/details?id=@Model.Id" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
            Back to Details
        </a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger" role="alert"></div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
        <div>
            @* ── Specifications Card ── *@
            <div class="admin-card" style="margin-bottom: 20px;">
                <div class="admin-card-header">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="font-size: 20px; color: var(--admin-primary);">settings</span>
                        <h2 class="admin-card-title">Feature Specifications</h2>
                    </div>
                </div>
                <div class="admin-card-body">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label asp-for="Input.Name" class="form-label">Full Feature Title (Details &amp; Table) <span class="required">*</span></label>
                            <input asp-for="Input.Name" class="form-control" placeholder="e.g. Community Messenger &amp; Team Chat" />
                            <span asp-validation-for="Input.Name" class="field-validation-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.MenuTitle" class="form-label">Sidebar Menu Title (Short Label) <span class="required">*</span></label>
                            <input asp-for="Input.MenuTitle" class="form-control" maxlength="60" placeholder="e.g. Chat Messenger" />
                            <small style="display:block;font-size:11px;color:var(--admin-text-muted);margin-top:3px;">Concise label shown in the tenant left sidebar so it never truncates.</small>
                            <span asp-validation-for="Input.MenuTitle" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label asp-for="Input.Category" class="form-label">Feature Suite <span class="required">*</span></label>
                            <select asp-for="Input.Category" class="form-select">
                                @if (Model.Suites.Any())
                                {
                                    foreach (var suite in Model.Suites)
                                    {
                                        <option value="@suite.Name" selected="@(Model.Input.Category == suite.Name || Model.Input.MasterFeatureSuiteId == suite.Id)">@suite.Name (Menu: @suite.MenuTitle)</option>
                                    }
                                }
                                else
                                {
                                    foreach (var suite in EditModel.CanonicalSuites)
                                    {
                                        <option value="@suite" selected="@(Model.Input.Category == suite)">@suite</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="Input.Category" class="field-validation-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Icon" class="form-label">Material Icon Identifier</label>
                            <input asp-for="Input.Icon" class="form-control" placeholder="e.g. chat, groups, payments" />
                            <span asp-validation-for="Input.Icon" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Description" class="form-label">Summary Description</label>
                        <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Explain the business value and features of this module..."></textarea>
                        <span asp-validation-for="Input.Description" class="field-validation-error"></span>
                    </div>
                </div>
            </div>

            @* ── Pricing Matrix in USD ── *@
            <div class="admin-card">
                <div class="admin-card-header" style="display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="font-size: 20px; color: var(--admin-success);">paid</span>
                        <h2 class="admin-card-title">Commercial Pricing (USD Base)</h2>
                    </div>
                    <span class="badge badge-primary" style="font-size: 11px;">USD ($) Canonical</span>
                </div>
                <div class="admin-card-body">
                    <div class="form-group">
                        <label asp-for="Input.BillingType" class="form-label">Billing Model Classification</label>
                        <select asp-for="Input.BillingType" class="form-select">
                            <option value="1">Flat Subscription (Fixed recurring monthly/yearly)</option>
                            <option value="2">Pay As You Go (Metered usage only)</option>
                            <option value="3">Hybrid (Base subscription + metered overages)</option>
                            <option value="4">Custom Enterprise (Negotiated contract)</option>
                        </select>
                    </div>

                    @* Billing Cadence Selector *@
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label class="form-label" style="font-weight: 700;">Subscription Cadence</label>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                            <label style="display: flex; align-items: flex-start; gap: 10px; padding: 14px; background: var(--admin-bg-surface-elevated); border: 2px solid var(--admin-border); border-radius: var(--radius-md); cursor: pointer;" id="cadenceMonthlyLabel">
                                <input type="radio" asp-for="Input.BillingCadence" value="Monthly" id="cadenceMonthlyRadio" style="margin-top: 3px;" />
                                <div>
                                    <strong style="display: block; color: var(--admin-text); font-size: 13.5px;">Monthly Recurring</strong>
                                    <span style="font-size: 12px; color: var(--admin-text-muted);">Enter monthly price; quarterly &amp; yearly discounted prices calculate automatically.</span>
                                </div>
                            </label>

                            <label style="display: flex; align-items: flex-start; gap: 10px; padding: 14px; background: var(--admin-bg-surface-elevated); border: 2px solid var(--admin-border); border-radius: var(--radius-md); cursor: pointer;" id="cadenceYearlyLabel">
                                <input type="radio" asp-for="Input.BillingCadence" value="Yearly" id="cadenceYearlyRadio" style="margin-top: 3px;" />
                                <div>
                                    <strong style="display: block; color: var(--admin-text); font-size: 13.5px;">Yearly Only</strong>
                                    <span style="font-size: 12px; color: var(--admin-text-muted);">Fixed annual rate ($ USD). Monthly billing is disabled ($0).</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    @* Container for Monthly Recurring *@
                    <div id="monthlySection" style="padding: 16px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); margin-bottom: 16px;">
                        <div style="display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 16px;">
                            @* Monthly Price input *@
                            <div class="form-group" style="margin: 0;">
                                <label asp-for="Input.MonthlyPrice" class="form-label" style="font-weight: 600;">Monthly Price ($ USD)</label>
                                <div class="input-group" style="display: flex;">
                                    <span style="padding: 8px 12px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-right: none; border-radius: var(--radius-md) 0 0 var(--radius-md); font-weight: 700; color: var(--admin-text);">$</span>
                                    <input asp-for="Input.MonthlyPrice" type="number" step="0.01" class="form-control" style="border-radius: 0 var(--radius-md) var(--radius-md) 0; font-weight: 700; font-size: 15px;" id="monthlyPriceInput" placeholder="25.00" />
                                </div>
                                <span asp-validation-for="Input.MonthlyPrice" class="field-validation-error"></span>
                            </div>

                            @* Quarterly Discount % *@
                            <div class="form-group" style="margin: 0;">
                                <label asp-for="Input.QuarterlyDiscountPercent" class="form-label">Quarterly Discount</label>
                                <div class="input-group" style="display: flex;">
                                    <input asp-for="Input.QuarterlyDiscountPercent" type="number" min="0" max="100" class="form-control" style="border-radius: var(--radius-md) 0 0 var(--radius-md);" id="qDiscountInput" />
                                    <span style="padding: 8px 12px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-left: none; border-radius: 0 var(--radius-md) var(--radius-md) 0; font-weight: 600; color: var(--admin-text-muted);">%</span>
                                </div>
                                <div style="font-size: 11.5px; color: var(--admin-text-dim); margin-top: 4px;">
                                    = <strong id="calcQuarterlyUsd" style="color: var(--admin-text);">$0.00</strong> / quarter
                                </div>
                            </div>

                            @* Yearly Discount % *@
                            <div class="form-group" style="margin: 0;">
                                <label asp-for="Input.YearlyDiscountPercent" class="form-label">Yearly Discount</label>
                                <div class="input-group" style="display: flex;">
                                    <input asp-for="Input.YearlyDiscountPercent" type="number" min="0" max="100" class="form-control" style="border-radius: var(--radius-md) 0 0 var(--radius-md);" id="yDiscountInput" />
                                    <span style="padding: 8px 12px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-left: none; border-radius: 0 var(--radius-md) var(--radius-md) 0; font-weight: 600; color: var(--admin-text-muted);">%</span>
                                </div>
                                <div style="font-size: 11.5px; color: var(--admin-success); margin-top: 4px;">
                                    = <strong id="calcYearlyUsd" style="color: var(--admin-primary);">$0.00</strong> / year
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Container for Yearly Only *@
                    <div id="yearlySection" style="display: none; padding: 16px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); margin-bottom: 16px;">
                        <div class="form-group" style="margin: 0; max-width: 320px;">
                            <label asp-for="Input.YearlyPrice" class="form-label" style="font-weight: 600;">Annual Fixed Price ($ USD)</label>
                            <div class="input-group" style="display: flex;">
                                <span style="padding: 8px 12px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-right: none; border-radius: var(--radius-md) 0 0 var(--radius-md); font-weight: 700; color: var(--admin-text);">$</span>
                                <input asp-for="Input.YearlyPrice" type="number" step="0.01" class="form-control" style="border-radius: 0 var(--radius-md) var(--radius-md) 0; font-weight: 700; font-size: 15px;" id="directYearlyPriceInput" placeholder="240.00" />
                            </div>
                            <span asp-validation-for="Input.YearlyPrice" class="field-validation-error"></span>
                        </div>
                    </div>

                    @* Live Regional Currency Conversion Preview *@
                    <div style="margin-top: 14px; padding: 14px 16px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md);">
                        <div style="font-size: 11.5px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                            <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-primary);">currency_exchange</span>
                            <span>Regional Currency Live Conversion (Master Exchange Rates)</span>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; font-size: 12.5px;">
                            <div style="padding: 8px 12px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-sm);">
                                <div style="color: var(--admin-text-dim); font-size: 11px;">Nigerian Naira (NGN ₦)</div>
                                <strong id="previewNgn" style="color: var(--admin-text); font-size: 13.5px;">₦0.00</strong>
                            </div>
                            <div style="padding: 8px 12px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-sm);">
                                <div style="color: var(--admin-text-dim); font-size: 11px;">British Pound (GBP £)</div>
                                <strong id="previewGbp" style="color: var(--admin-text); font-size: 13.5px;">£0.00</strong>
                            </div>
                            <div style="padding: 8px 12px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-sm);">
                                <div style="color: var(--admin-text-dim); font-size: 11px;">Euro (EUR €)</div>
                                <strong id="previewEur" style="color: var(--admin-text); font-size: 13.5px;">0,00 €</strong>
                            </div>
                        </div>
                    </div>

                    @* Metering Configuration *@
                    <div style="margin-top: 14px; padding: 16px; background: var(--admin-bg-surface-elevated); border-radius: var(--radius-md); border: 1px solid var(--admin-border);">
                        <div class="form-group" style="margin-bottom: 12px;">
                            <label class="form-check">
                                <input asp-for="Input.IsMetered" class="form-check-input" type="checkbox" />
                                <span style="font-weight: 600; color: var(--admin-text);">Enable Additional Metered Charges</span>
                            </label>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                            <div class="form-group" style="margin: 0;">
                                <label asp-for="Input.MeterUnitName" class="form-label">Unit Name</label>
                                <input asp-for="Input.MeterUnitName" class="form-control" placeholder="e.g. SMS, token, GB" />
                            </div>
                            <div class="form-group" style="margin: 0;">
                                <label asp-for="Input.MeterUnitPrice" class="form-label">Price per Unit ($ USD)</label>
                                <input asp-for="Input.MeterUnitPrice" type="number" step="0.0001" class="form-control" />
                            </div>
                            <div class="form-group" style="margin: 0;">
                                <label asp-for="Input.MeterBatchSize" class="form-label">Batch Size</label>
                                <input asp-for="Input.MeterBatchSize" type="number" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="admin-card-footer" style="display: flex; justify-content: flex-end; gap: 10px;">
                    <a href="/centralwks/features/details?id=@Model.Id" class="btn-admin btn-admin-secondary">Cancel</a>
                    <button type="submit" class="btn-admin btn-admin-primary">
                        <span class="material-symbols-outlined" style="font-size: 16px;">save</span>
                        Save Capability &amp; Prices
                    </button>
                </div>
            </div>
        </div>

        @* ── Availability & Core Flags ── *@
        <div>
            <div class="admin-card">
                <div class="admin-card-header">
                    <h2 class="admin-card-title">Governance &amp; Status</h2>
                </div>
                <div class="admin-card-body" style="display: flex; flex-direction: column; gap: 16px;">
                    @* 1. Published vs Unpublished (Visibility to Tenants) *@
                    <div class="form-group" style="margin: 0; padding: 12px; background: rgba(0, 80, 229, 0.04); border: 1px solid rgba(0, 80, 229, 0.16); border-radius: 10px;">
                        <label class="form-check" style="margin: 0;">
                            <input asp-for="Input.IsPublished" class="form-check-input" type="checkbox" id="chkIsPublished" />
                            <div>
                                <span style="font-weight: 700; color: #0050e5; display: inline-flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 15px;">public</span>
                                    Published (Visible to Tenants)
                                </span>
                                <div style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 2px;">When checked, appears on Tenant Billing &amp; Get Started pages. Uncheck to Unpublish (hide).</div>
                            </div>
                        </label>
                    </div>

                    @* 2. Available for Use vs Coming Soon *@
                    <div class="form-group" style="margin: 0; padding: 12px; background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 10px;">
                        <label class="form-check" style="margin: 0;">
                            <input asp-for="Input.IsAvailableForUse" class="form-check-input" type="checkbox" id="chkIsAvailableForUse" />
                            <div>
                                <span style="font-weight: 700; color: #059669; display: inline-flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 15px;">verified</span>
                                    Available for Use (vs. Coming Soon)
                                </span>
                                <div style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 2px;">When checked, shows as <strong>Available for Use</strong>. When unchecked, shows as <strong>Coming Soon</strong>.</div>
                            </div>
                        </label>
                    </div>

                    @* 3. First-Time Free Trial Days Before Payment (General Mode) *@
                    <div class="form-group" style="margin: 0; padding: 12px; background: rgba(124, 58, 237, 0.05); border: 1px solid rgba(124, 58, 237, 0.22); border-radius: 10px;">
                        <label asp-for="Input.FreeTrialDays" class="form-label" style="font-weight: 700; color: #6d28d9; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">redeem</span>
                            <span>First-Time Free Trial Days (Before Payment)</span>
                        </label>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <input asp-for="Input.FreeTrialDays" type="number" min="0" max="365" class="form-control" style="font-weight: 700;" placeholder="e.g. 7" />
                            <span style="font-size: 12px; font-weight: 700; color: var(--admin-text-muted); white-space: nowrap;">Days Free</span>
                        </div>
                        <span class="form-help" style="font-size: 11.5px; display: block; margin-top: 4px;">
                            General Mode default free days granted the <strong>first time</strong> a tenant activates &amp; tests this capability before payment is required (0 = immediate payment required).
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.DisplayOrder" class="form-label">Catalog Sort Order</label>
                        <input asp-for="Input.DisplayOrder" type="number" class="form-control" />
                        <span class="form-help">Determines ordering in the feature directory.</span>
                    </div>

                    <div style="padding: 12px; background: var(--admin-bg-surface-elevated); border-radius: var(--radius-sm); border: 1px solid var(--admin-border);">
                        <div style="font-size: 11px; color: var(--admin-text-dim); text-transform: uppercase; font-weight: 600;">Stable Unique Code</div>
                        <code style="font-size: 13px; color: var(--admin-info); display: block; margin-top: 3px;">
                            @Model.Feature.FeatureCode
                        </code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const ngnRate = @Model.NgnRate;
            const gbpRate = @Model.GbpRate;
            const eurRate = @Model.EurRate;

            const monthlyRadio = document.getElementById('cadenceMonthlyRadio');
            const yearlyRadio = document.getElementById('cadenceYearlyRadio');
            const monthlyLabel = document.getElementById('cadenceMonthlyLabel');
            const yearlyLabel = document.getElementById('cadenceYearlyLabel');
            const monthlySection = document.getElementById('monthlySection');
            const yearlySection = document.getElementById('yearlySection');

            const monthlyInput = document.getElementById('monthlyPriceInput');
            const qDiscInput = document.getElementById('qDiscountInput');
            const yDiscInput = document.getElementById('yDiscountInput');
            const directYearlyInput = document.getElementById('directYearlyPriceInput');

            const calcQuarterlyUsd = document.getElementById('calcQuarterlyUsd');
            const calcYearlyUsd = document.getElementById('calcYearlyUsd');

            const previewNgn = document.getElementById('previewNgn');
            const previewGbp = document.getElementById('previewGbp');
            const previewEur = document.getElementById('previewEur');

            function updateCadenceUI() {
                const isMonthly = monthlyRadio.checked;
                if (isMonthly) {
                    monthlySection.style.display = 'block';
                    yearlySection.style.display = 'none';
                    monthlyLabel.style.borderColor = 'var(--admin-primary)';
                    yearlyLabel.style.borderColor = 'var(--admin-border)';
                } else {
                    monthlySection.style.display = 'none';
                    yearlySection.style.display = 'block';
                    monthlyLabel.style.borderColor = 'var(--admin-border)';
                    yearlyLabel.style.borderColor = 'var(--admin-primary)';
                }
                recalculate();
            }

            function recalculate() {
                const isMonthly = monthlyRadio.checked;
                if (isMonthly) {
                    const monthly = parseFloat(monthlyInput.value) || 0;
                    const qDisc = Math.min(100, Math.max(0, parseFloat(qDiscInput.value) || 0));
                    const yDisc = Math.min(100, Math.max(0, parseFloat(yDiscInput.value) || 0));

                    const quarterly = (monthly * 3) * (1 - (qDisc / 100));
                    const yearly = (monthly * 12) * (1 - (yDisc / 100));

                    calcQuarterlyUsd.textContent = '$' + quarterly.toFixed(2);
                    calcYearlyUsd.textContent = '$' + yearly.toFixed(2);

                    // Sync to directYearlyInput as fallback
                    if (directYearlyInput) directYearlyInput.value = yearly.toFixed(2);

                    // Update live conversions
                    previewNgn.textContent = '₦' + (monthly * ngnRate).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / mo';
                    previewGbp.textContent = '£' + (monthly * gbpRate).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / mo';
                    previewEur.textContent = (monthly * eurRate).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' € / mo';
                } else {
                    const yearly = parseFloat(directYearlyInput.value) || 0;
                    previewNgn.textContent = '₦' + (yearly * ngnRate).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / yr';
                    previewGbp.textContent = '£' + (yearly * gbpRate).toLocaleString('en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' / yr';
                    previewEur.textContent = (yearly * eurRate).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' € / yr';
                }
            }

            monthlyRadio.addEventListener('change', updateCadenceUI);
            yearlyRadio.addEventListener('change', updateCadenceUI);

            monthlyInput.addEventListener('input', recalculate);
            qDiscInput.addEventListener('input', recalculate);
            yDiscInput.addEventListener('input', recalculate);
            directYearlyInput.addEventListener('input', recalculate);

            updateCadenceUI();
        })();
    </script>
}
