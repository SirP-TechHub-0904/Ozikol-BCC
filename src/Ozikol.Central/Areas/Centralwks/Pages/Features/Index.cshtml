<div id="instantToggleToast" style="display: none; position: fixed; bottom: 24px; right: 24px; z-index: 10000; background: #0f172a; color: #ffffff; padding: 12px 18px; border-radius: 10px; font-size: 13px; font-weight: 600; box-shadow: 0 12px 28px rgba(15, 23, 42, 0.25); align-items: center; gap: 10px; border: 1px solid rgba(255,255,255,0.12);">
    <span id="instantToggleToastIcon" class="material-symbols-outlined" style="font-size: 18px; color: #10b981;">check_circle</span>
    <span id="instantToggleToastText">Updated</span>
</div>

@section Scripts {
    <script>
        let toastTimer = null;
        function showInstantToast(message, isSuccess = true) {
            const toast = document.getElementById('instantToggleToast');
            const icon = document.getElementById('instantToggleToastIcon');
            const text = document.getElementById('instantToggleToastText');
            if (!toast || !text) return;
            text.textContent = message;
            if (icon) {
                icon.textContent = isSuccess ? 'check_circle' : 'error';
                icon.style.color = isSuccess ? '#10b981' : '#ef4444';
            }
            toast.style.display = 'inline-flex';
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.style.display = 'none';
            }, 2800);
        }

        function updateKpiDelta(positiveId, negativeId, turnedOn) {
            const posEl = document.getElementById(positiveId);
            const negEl = document.getElementById(negativeId);
            if (posEl && negEl) {
                const posVal = parseInt((posEl.textContent || '0').replace(/,/g, ''), 10) || 0;
                const negVal = parseInt((negEl.textContent || '0').replace(/,/g, ''), 10) || 0;
                posEl.textContent = Math.max(0, posVal + (turnedOn ? 1 : -1)).toLocaleString();
                negEl.textContent = Math.max(0, negVal + (turnedOn ? -1 : 1)).toLocaleString();
            }
        }

        function applyPillVisualState(btn, kind, newState) {
            btn.setAttribute('data-state', newState ? 'true' : 'false');
            const iconEl = btn.querySelector('.toggle-pill-icon');
            const labelEl = btn.querySelector('.toggle-pill-label');

            if (kind === 'availability') {
                btn.classList.toggle('pill-available', newState);
                btn.classList.toggle('pill-coming-soon', !newState);
                if (iconEl) iconEl.textContent = newState ? 'verified' : 'schedule';
                if (labelEl) labelEl.textContent = newState ? 'Available for Use' : 'Coming Soon';
            } else {
                btn.classList.toggle('pill-published', newState);
                btn.classList.toggle('pill-unpublished', !newState);
                if (iconEl) iconEl.textContent = newState ? 'public' : 'visibility_off';
                if (labelEl) labelEl.textContent = newState ? 'Published' : 'Unpublished';
            }
        }

        function instantToggleFeature(event, form, kind, featureId, featureName) {
            if (event) event.preventDefault();
            const btn = form.querySelector('.status-toggle-pill');
            if (!btn || btn.classList.contains('is-saving')) return false;

            const currentState = btn.getAttribute('data-state') === 'true';
            const nextState = !currentState;

            // Optimistically flip all matching pills for this feature on the page
            const allMatchingPills = document.querySelectorAll(`.status-toggle-pill[data-feature-id="${featureId}"][data-toggle-kind="${kind}"]`);
            allMatchingPills.forEach(p => {
                p.classList.add('is-saving');
                applyPillVisualState(p, kind, nextState);
            });

            if (kind === 'availability') {
                updateKpiDelta('kpiAvailableCount', 'kpiComingSoonCount', nextState);
            } else {
                updateKpiDelta('kpiPublishedCount', 'kpiUnpublishedCount', nextState);
            }

            const formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(res => {
                if (!res.ok) throw new Error('Request failed');
                const statusLabel = kind === 'availability'
                    ? (nextState ? 'Available for Use' : 'Coming Soon')
                    : (nextState ? 'Published' : 'Unpublished');
                showInstantToast(`${featureName} switched to ${statusLabel}`, true);
            })
            .catch(() => {
                // Revert optimistic state on failure
                allMatchingPills.forEach(p => applyPillVisualState(p, kind, currentState));
                if (kind === 'availability') {
                    updateKpiDelta('kpiAvailableCount', 'kpiComingSoonCount', currentState);
                } else {
                    updateKpiDelta('kpiPublishedCount', 'kpiUnpublishedCount', currentState);
                }
                showInstantToast(`Could not update ${featureName}. Please try again.`, false);
            })
            .finally(() => {
                allMatchingPills.forEach(p => p.classList.remove('is-saving'));
            });

            return false;
        }

        function toggleFeatureActionMenu(event, menuId) {
            event.stopPropagation();
            const allMenus = document.querySelectorAll('.feature-action-dropdown-menu.open');
            allMenus.forEach(m => {
                if (m.id !== menuId) m.classList.remove('open');
            });
            const menu = document.getElementById(menuId);
            if (menu) {
                menu.classList.toggle('open');
            }
        }

        function stepOrderAndSubmit(btn, delta) {
            const form = btn.closest('form');
            if (!form) return;
            const input = form.querySelector('input[type="number"]');
            if (!input) return;
            const currentVal = parseInt(input.value, 10) || 1;
            const minVal = parseInt(input.min, 10) || 1;
            const maxVal = parseInt(input.max, 10) || 999;
            const nextVal = Math.max(minVal, Math.min(maxVal, currentVal + delta));
            if (nextVal !== currentVal) {
                input.value = nextVal;
                form.submit();
            }
        }

        document.addEventListener('click', function () {
            document.querySelectorAll('.feature-action-dropdown-menu.open').forEach(m => {
                m.classList.remove('open');
            });
        });

        // Live client-side instant search filter
        const searchInput = document.getElementById('featureSearchInput');
        const cards = document.querySelectorAll('.admin-feature-card');
        const suiteSections = document.querySelectorAll('.suite-group-section');
        const visibleText = document.getElementById('visibleCountText');

        if (searchInput && cards.length > 0) {
            searchInput.addEventListener('input', function () {
                const query = this.value.trim().toLowerCase();
                let visibleCount = 0;

                cards.forEach(card => {
                    const name = card.getAttribute('data-name') || '';
                    const code = card.getAttribute('data-code') || '';
                    const desc = card.getAttribute('data-desc') || '';

                    const matches = !query || name.includes(query) || code.includes(query) || desc.includes(query);
                    if (matches) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Hide empty suite sections
                suiteSections.forEach(section => {
                    const visibleInSuite = section.querySelectorAll('.admin-feature-card:not([style*="display: none"])');
                    section.style.display = visibleInSuite.length > 0 ? 'block' : 'none';
                });

                if (visibleText) {
                    visibleText.textContent = visibleCount;
                }
            });
        }
    </script>
}

@* ── Manage Feature Suites Modal (Edit Full Title & Menu Title for all 10 Suites) ── *@
<div id="manageSuitesModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); z-index: 9999; align-items: center; justify-content: center; padding: 24px;">
    <div style="background: #ffffff; border-radius: 16px; max-width: 920px; width: 100%; max-height: 88vh; display: flex; flex-direction: column; box-shadow: 0 24px 48px rgba(15, 23, 42, 0.25); overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">Manage Platform Feature Suites (MasterFeatureSuites)</h2>
                <p style="font-size: 12.5px; color: #64748b; margin: 4px 0 0;">Edit <strong>Sort Order</strong> (automatically rearranges Suite A–K and feature numbering), <strong>Suite Full Title</strong>, and <strong>Suite Menu Title</strong>.</p>
            </div>
            <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" onclick="document.getElementById('manageSuitesModal').style.display='none'">
                <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
                <span>Close</span>
            </button>
        </div>
        <div style="padding: 20px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px;">
            @foreach (var s in Model.Suites.OrderBy(x => x.SortOrder))
            {
                <form method="post" asp-page-handler="UpdateSuite" style="display: grid; grid-template-columns: 70px 118px 1.4fr 1fr auto; gap: 12px; align-items: end; padding: 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="suiteId" value="@s.Id" />
                    <input type="hidden" name="description" value="@s.Description" />
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 700; color: #64748b; margin-bottom: 4px;">SUITE</label>
                        <span style="display: inline-flex; align-items: center; justify-content: center; height: 36px; padding: 0 12px; background: #0050e5; color: #fff; font-weight: 800; font-size: 12px; border-radius: 6px;">
                            Suite @s.SuiteLetter
                        </span>
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 700; color: #0050e5; margin-bottom: 4px;">ORDER (UP/DOWN)</label>
                        <div style="display: flex; align-items: center; gap: 3px; height: 36px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 0 4px;">
                            <button type="button" class="btn-order-step" title="Move Suite Up" onclick="stepOrderAndSubmit(this, -1)" disabled="@(s.SortOrder <= 1)">
                                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_upward</span>
                            </button>
                            <input type="number" name="sortOrder" min="1" max="@Model.Suites.Count" value="@s.SortOrder" class="form-control" style="height: 28px; width: 46px; font-size: 13px; font-weight: 800; text-align: center; padding: 0 2px;" required />
                            <button type="button" class="btn-order-step" title="Move Suite Down" onclick="stepOrderAndSubmit(this, 1)" disabled="@(s.SortOrder >= Model.Suites.Count)">
                                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_downward</span>
                            </button>
                        </div>
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">Suite Full Title (Table &amp; Details Page)</label>
                        <input type="text" name="name" value="@s.Name" class="form-control" style="height: 36px; font-size: 13px;" required />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 700; color: #0050e5; margin-bottom: 4px;">Suite Menu Title (Sidebar Header)</label>
                        <input type="text" name="menuTitle" value="@s.MenuTitle" class="form-control" maxlength="30" style="height: 36px; font-size: 13px;" required />
                    </div>
                    <div>
                        <button type="submit" class="btn-admin btn-admin-primary" style="height: 36px; padding: 0 14px; font-size: 12.5px;">
                            <span class="material-symbols-outlined" style="font-size: 15px;">save</span>
                            <span>Save</span>
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
