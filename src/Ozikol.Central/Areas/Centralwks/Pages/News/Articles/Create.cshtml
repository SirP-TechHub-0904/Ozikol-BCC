@page "/centralwks/news/articles/create"
@model Ozikol.Central.Areas.Centralwks.Pages.News.Articles.CreateModel
@{
    ViewData["Title"] = "Write New Article";
    ViewData["BreadcrumbSection"] = "Content";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
            <a href="/centralwks/news/articles" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px;">
                ← Back to Articles
            </a>
        </div>
        <h1 class="admin-title">Author Corporate Article</h1>
        <p class="admin-subtitle">Compose announcements, architectural deep-dives, press notices, or feature highlights for the public website and customer portal.</p>
    </div>
</div>

<div class="admin-card" style="max-width: 900px; padding: 28px;">
    <form method="post">
        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Title" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Article Title <span style="color: #f87171;">*</span>
            </label>
            <input asp-for="Input.Title" id="articleTitleInput" placeholder="e.g. Announcing Dedicated Multi-Tenant Database Clusters" class="form-control" style="font-size: 15px; font-weight: 500;" />
            <span asp-validation-for="Input.Title" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.Slug" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    URL Permalink Slug <span style="color: #f87171;">*</span>
                </label>
                <div style="display: flex; align-items: center; border: 1px solid var(--admin-border); border-radius: 8px; overflow: hidden; background: var(--admin-bg-surface);">
                    <span style="padding: 10px 12px; color: var(--admin-text-muted); font-size: 13px; background: rgba(255, 255, 255, 0.03); border-right: 1px solid var(--admin-border); font-family: monospace;">
                        /news/
                    </span>
                    <input asp-for="Input.Slug" id="articleSlugInput" placeholder="e.g. announcing-dedicated-database-clusters" 
                           class="form-control" style="flex: 1; border: none; background: transparent; padding: 10px 14px; color: #93c5fd; font-size: 13px; font-family: monospace;" />
                </div>
                <span asp-validation-for="Input.Slug" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div>
                <label asp-for="Input.MasterNewsCategoryId" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Editorial Category <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.MasterNewsCategoryId" class="form-select">
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id">@cat.Name (@cat.Key)</option>
                    }
                </select>
                <span asp-validation-for="Input.MasterNewsCategoryId" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Excerpt" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Card Excerpt / Lead Summary <span style="color: #f87171;">*</span>
            </label>
            <textarea asp-for="Input.Excerpt" rows="3" placeholder="Brief executive summary displayed on public feed cards and RSS syndication..." class="form-control" style="resize: vertical;"></textarea>
            <span asp-validation-for="Input.Excerpt" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.ContentHtml" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Article Body Content (HTML / Rich Format) <span style="color: #f87171;">*</span>
            </label>
            <textarea asp-for="Input.ContentHtml" rows="12" placeholder="<p>Detailed announcement body...</p><h3>Key Features</h3><ul><li>Feature 1</li></ul>" class="form-control" style="font-family: monospace; line-height: 1.5; resize: vertical;"></textarea>
            <span asp-validation-for="Input.ContentHtml" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.AuthorName" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Author Name
                </label>
                <input asp-for="Input.AuthorName" class="form-control" placeholder="e.g. First Last" />
                <span asp-validation-for="Input.AuthorName" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div>
                <label asp-for="Input.AuthorRole" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Author Role
                </label>
                <input asp-for="Input.AuthorRole" class="form-control" placeholder="e.g. Lead Cloud Architect" />
            </div>

            <div>
                <label asp-for="Input.ReadTimeText" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Estimated Read Time
                </label>
                <input asp-for="Input.ReadTimeText" class="form-control" placeholder="e.g. 5 min read" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; margin-bottom: 24px;">
            <div>
                <label asp-for="Input.TagsInput" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Topic Tags (Comma-separated)
                </label>
                <input asp-for="Input.TagsInput" placeholder="e.g. Architecture, Security, Multi-Tenant, Cloud" class="form-control" />
            </div>

            <div>
                <label asp-for="Input.CoverGradientClass" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Card Visual Gradient
                </label>
                <select asp-for="Input.CoverGradientClass" class="form-select">
                    <option value="oz-news-cover-indigo">Indigo Wave</option>
                    <option value="oz-news-cover-emerald">Emerald Cloud</option>
                    <option value="oz-news-cover-crimson">Crimson Sunset</option>
                    <option value="oz-news-cover-amber">Amber Horizon</option>
                    <option value="oz-news-cover-violet">Violet Nebula</option>
                </select>
            </div>
        </div>

        <div style="display: flex; gap: 28px; margin-bottom: 24px; padding: 16px; background: var(--admin-bg-surface); border-radius: 8px; border: 1px solid var(--admin-card-border);">
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--admin-text); font-size: 13px;">
                <input asp-for="Input.IsFeatured" type="checkbox" style="width: 18px; height: 18px; cursor: pointer;" />
                <span style="font-weight: 600; color: #f59e0b; display: inline-flex; align-items: center; gap: 4px;">
                    <span class="material-symbols-outlined" style="font-size: 16px;">star</span> Feature as Top Headline Story
                </span>
            </label>
            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; color: var(--admin-text); font-size: 13px;">
                <input asp-for="Input.IsPublished" type="checkbox" style="width: 18px; height: 18px; cursor: pointer;" />
                <span style="font-weight: 600; color: var(--admin-success); display: inline-flex; align-items: center; gap: 4px;">
                    <span class="material-symbols-outlined" style="font-size: 16px;">public</span> Publish Live Immediately
                </span>
            </label>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--admin-card-border); padding-top: 18px;">
            <a href="/centralwks/news/articles" class="btn-admin btn-admin-secondary" style="padding: 10px 20px;">
                Cancel
            </a>
            <button type="submit" class="btn-admin btn-admin-primary" style="padding: 10px 24px;">
                <span class="material-symbols-outlined" style="font-size: 16px;">save</span>
                Publish Article
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const titleInput = document.getElementById("articleTitleInput");
        const slugInput = document.getElementById("articleSlugInput");
        if (titleInput && slugInput) {
            titleInput.addEventListener("input", function () {
                if (!slugInput.dataset.manual) {
                    slugInput.value = titleInput.value
                        .toLowerCase()
                        .trim()
                        .replace(/[^a-z0-9\s-]/g, "")
                        .replace(/\s+/g, "-");
                }
            });
            slugInput.addEventListener("input", function () {
                slugInput.dataset.manual = "true";
            });
        }
    });
</script>
