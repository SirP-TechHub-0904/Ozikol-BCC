@page "/centralwks/news/articles"
@model Ozikol.Central.Areas.Centralwks.Pages.News.Articles.IndexModel
@{
    ViewData["Title"] = "News & Blog CMS";
    ViewData["BreadcrumbSection"] = "Content";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">News, Announcements & Releases</h1>
        <p class="admin-subtitle">Curate and publish corporate communications, platform architecture insights, feature release notes, and executive announcements.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/news/categories" class="btn-admin btn-admin-secondary">
            <span>🏷</span> Categories (@Model.CategoriesCount)
        </a>
        <a href="/centralwks/news/articles/create" class="btn-admin btn-admin-primary">
            <span>➕</span> Write Article
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@* ── CMS Metrics ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px; font-size: 18px;">📰</div>
        <div class="stat-details">
            <span class="stat-label">Total Articles</span>
            <span class="stat-value" style="font-size: 22px;">@Model.TotalCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px; font-size: 18px;">🌐</div>
        <div class="stat-details">
            <span class="stat-label">Published Online</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">@Model.PublishedCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper" style="width: 40px; height: 40px; font-size: 18px; background: rgba(245, 158, 11, 0.2); color: #f59e0b;">⭐</div>
        <div class="stat-details">
            <span class="stat-label">Featured Headlines</span>
            <span class="stat-value" style="font-size: 22px; color: #f59e0b;">@Model.FeaturedCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper" style="width: 40px; height: 40px; font-size: 18px; background: rgba(147, 51, 234, 0.2); color: #c084fc;">🏷️</div>
        <div class="stat-details">
            <span class="stat-label">Editorial Categories</span>
            <span class="stat-value" style="font-size: 22px; color: #c084fc;">@Model.CategoriesCount</span>
        </div>
    </div>
</div>

@* ── Filters ── *@
<div class="admin-card" style="margin-bottom: 24px; padding: 16px 20px;">
    <form method="get" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px;">
            <input type="text" name="Search" value="@Model.Search" placeholder="Search by article title, excerpt, slug, or author..." 
                   class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 14px; color: var(--admin-text); font-size: 13px;" />
        </div>
        <div style="width: 180px;">
            <select name="CategoryFilter" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.CategoryFilter) || Model.CategoryFilter == "All")">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Key" selected="@(Model.CategoryFilter == cat.Key || Model.CategoryFilter == cat.Slug)">@cat.Name</option>
                }
            </select>
        </div>
        <div style="width: 150px;">
            <select name="PublishFilter" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.PublishFilter) || Model.PublishFilter == "All")">All Statuses</option>
                <option value="Published" selected="@(Model.PublishFilter == "Published")">Published</option>
                <option value="Draft" selected="@(Model.PublishFilter == "Draft")">Draft / Hidden</option>
            </select>
        </div>
        <div>
            <button type="submit" class="btn-admin btn-admin-primary" style="padding: 8px 16px;">
                <span>🔍</span> Filter
            </button>
            @if (!string.IsNullOrEmpty(Model.Search) || (!string.IsNullOrEmpty(Model.CategoryFilter) && Model.CategoryFilter != "All") || (!string.IsNullOrEmpty(Model.PublishFilter) && Model.PublishFilter != "All"))
            {
                <a href="/centralwks/news/articles" class="btn-admin btn-admin-secondary" style="padding: 8px 12px; margin-left: 6px;">Clear</a>
            }
        </div>
    </form>
</div>

@* ── Articles Table ── *@
<div class="admin-card" style="padding: 0; overflow: hidden;">
    <div style="padding: 16px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); display: flex; justify-content: space-between; align-items: center;">
        <h2 style="font-size: 15px; font-weight: 600; margin: 0; color: var(--admin-text);">
            Article Repository (@Model.Articles.Count)
        </h2>
    </div>

    @if (!Model.Articles.Any())
    {
        <div style="padding: 48px; text-align: center; color: var(--admin-text-muted);">
            <span style="font-size: 40px; display: block; margin-bottom: 12px;">📰</span>
            <p style="font-size: 14px; margin: 0 0 16px 0;">No articles match the current filter criteria.</p>
            <a href="/centralwks/news/articles/create" class="btn-admin btn-admin-primary">Create Your First Article</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table" style="width: 100%; border-collapse: collapse; font-size: 13px;">
                <thead>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08); text-align: left; color: var(--admin-text-muted);">
                        <th style="padding: 12px 20px; width: 40%;">Article</th>
                        <th style="padding: 12px 14px;">Category</th>
                        <th style="padding: 12px 14px;">Author</th>
                        <th style="padding: 12px 14px;">Published</th>
                        <th style="padding: 12px 14px;">Featured</th>
                        <th style="padding: 12px 14px;">Status</th>
                        <th style="padding: 12px 20px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var article in Model.Articles)
                    {
                        <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.04); transition: background 0.15s ease;">
                            <td style="padding: 14px 20px;">
                                <a href="/centralwks/news/articles/details/@article.Id" style="color: var(--admin-text); font-weight: 600; text-decoration: none; font-size: 14px;">
                                    @article.Title
                                </a>
                                <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @article.Excerpt
                                </div>
                                <div style="font-family: monospace; font-size: 11px; color: #60a5fa; margin-top: 4px;">
                                    /@article.Slug
                                </div>
                            </td>
                            <td style="padding: 14px 14px;">
                                <span style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; border: 1px solid rgba(59, 130, 246, 0.3); padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 500;">
                                    @(article.Category?.Name ?? article.CategoryKey)
                                </span>
                            </td>
                            <td style="padding: 14px 14px;">
                                <div style="font-weight: 500; color: var(--admin-text);">@article.AuthorName</div>
                                <div style="font-size: 11px; color: var(--admin-text-muted);">@article.AuthorRole</div>
                            </td>
                            <td style="padding: 14px 14px; font-size: 12px; color: var(--admin-text-muted);">
                                <div>@article.PublishedAtUtc.ToString("yyyy-MM-dd")</div>
                                <div style="font-size: 10px; color: #64748b;">@article.ReadTimeText</div>
                            </td>
                            <td style="padding: 14px 14px;">
                                <form method="post" asp-page-handler="ToggleFeatured" asp-route-id="@article.Id" style="display: inline;">
                                    @if (article.IsFeatured)
                                    {
                                        <button type="submit" title="Click to remove from featured" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); padding: 3px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                            ★ Featured
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" title="Click to feature" style="background: rgba(255, 255, 255, 0.05); color: #94a3b8; border: 1px solid rgba(255, 255, 255, 0.1); padding: 3px 8px; border-radius: 9999px; font-size: 11px; cursor: pointer;">
                                            ☆ Standard
                                        </button>
                                    }
                                </form>
                            </td>
                            <td style="padding: 14px 14px;">
                                <form method="post" asp-page-handler="TogglePublish" asp-route-id="@article.Id" style="display: inline;">
                                    @if (article.IsPublished)
                                    {
                                        <button type="submit" title="Click to unpublish" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); padding: 3px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                            ● Published
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" title="Click to publish" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); padding: 3px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600; cursor: pointer;">
                                            ○ Draft
                                        </button>
                                    }
                                </form>
                            </td>
                            <td style="padding: 14px 20px; text-align: right; white-space: nowrap;">
                                <a href="/centralwks/news/articles/details/@article.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; margin-right: 4px;">
                                    View
                                </a>
                                <a href="/centralwks/news/articles/edit/@article.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; margin-right: 4px;">
                                    Edit
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@article.Id" style="display: inline;">
                                    <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 10px; font-size: 12px;" onclick="return confirm('Permanently delete this article?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
