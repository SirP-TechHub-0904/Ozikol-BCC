@page "/centralwks/templates/import"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.ImportModel
@{
    ViewData["Title"] = "Modular Section Studio";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

@section Styles {
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/material-darker.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.css" />
<style>
    /* ── CodeMirror Full-Height Editor & Code Folding ── */
    .CodeMirror {
        height: 100% !important;
        font-family: 'JetBrains Mono', Consolas, 'Fira Code', monospace;
        font-size: 13px;
        line-height: 1.55;
        border-radius: var(--radius-md);
        border: 1px solid var(--admin-border);
        background: #181a20 !important;
        color: #e2e8f0 !important;
    }
    .CodeMirror-gutters {
        background: #131418 !important;
        border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding-right: 4px;
    }
    .CodeMirror-linenumber {
        color: #64748b !important;
        font-size: 11.5px;
    }
    .CodeMirror-foldmarker {
        color: #60a5fa !important;
        text-shadow: none;
        font-family: monospace;
        font-weight: 700;
        cursor: pointer;
        padding: 0 4px;
        background: rgba(59, 130, 246, 0.2);
        border-radius: 3px;
    }
    .CodeMirror-foldgutter {
        width: 14px;
    }
    .CodeMirror-foldgutter-open:after {
        content: "▾";
        color: #94a3b8;
        font-size: 13px;
        cursor: pointer;
    }
    .CodeMirror-foldgutter-folded:after {
        content: "▸";
        color: #f59e0b;
        font-size: 13px;
        cursor: pointer;
        font-weight: bold;
    }
    .code-editor-container {
        flex: 1;
        width: 100%;
        height: calc(100% - 30px);
        min-height: 300px;
        overflow: hidden;
        border-radius: var(--radius-md);
    }

    /* ── Modal Inspector Tab Buttons (Distinct Button Styling) ── */
    .preview-modal-tabs {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--admin-bg-surface-elevated);
        border-bottom: 1px solid var(--admin-border);
        padding: 8px 16px;
        flex-shrink: 0;
        overflow-x: auto;
        white-space: nowrap;
    }
    .modal-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--admin-text-muted);
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-sm);
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
        transition: all 0.2s ease;
    }
    .modal-tab-btn:hover {
        color: var(--admin-text);
        background: var(--admin-bg-hover);
        border-color: var(--admin-border-focus);
    }
    .modal-tab-btn.active {
        color: #ffffff !important;
        background: var(--admin-primary) !important;
        border-color: var(--admin-primary) !important;
        font-weight: 600;
        box-shadow: 0 2px 8px var(--admin-primary-glow);
    }
    .modal-tab-btn.active .material-symbols-outlined {
        color: #ffffff !important;
    }
    .studio-step-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        border-radius: var(--radius-full);
        font-size: 13px;
        font-weight: 600;
        color: var(--admin-text-muted);
        background: transparent;
        border: none;
        cursor: pointer;
        transition: var(--transition);
    }
    .studio-step-btn:hover {
        color: var(--admin-text);
        background: var(--admin-bg-hover);
    }
    .studio-step-btn.active {
        background: var(--admin-primary);
        color: #ffffff;
        box-shadow: 0 2px 8px var(--admin-primary-glow);
    }
    .studio-step-btn .step-number {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
    }

    /* ── Tab Bar Navigation ── */
    .studio-nav-tabs {
        display: flex;
        border-bottom: 1px solid var(--admin-border);
        background: var(--admin-bg-surface);
    }
    .studio-tab-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 16px 20px;
        font-size: 14px;
        font-weight: 600;
        color: var(--admin-text-muted);
        background: transparent;
        border: none;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        transition: var(--transition);
    }
    .studio-tab-btn:hover {
        color: var(--admin-text);
        background: var(--admin-bg-hover);
    }
    .studio-tab-btn.active {
        color: var(--admin-primary);
        border-bottom-color: var(--admin-primary);
        background: var(--admin-primary-light);
    }

    /* ── Dropzone Area ── */
    .studio-dropzone {
        display: block;
        border: 2px dashed var(--admin-border);
        border-radius: var(--radius-lg);
        padding: 36px 24px;
        text-align: center;
        background: var(--admin-bg-surface-elevated);
        position: relative;
        cursor: pointer;
        user-select: none;
        -webkit-user-select: none;
        transition: var(--transition);
    }
    .studio-dropzone.dragover,
    .studio-dropzone:hover {
        border-color: var(--admin-primary);
        background: var(--admin-primary-light);
    }
    .studio-dropzone input[type="file"] {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 5;
    }
    .studio-dropzone * {
        pointer-events: none;
    }

    /* ── Prominent Attached File Box ── */
    .attached-file-box {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px;
        background: var(--admin-bg-surface-elevated);
        border: 2px solid var(--admin-primary);
        border-radius: var(--radius-lg);
        box-shadow: 0 4px 16px var(--admin-primary-glow);
        gap: 16px;
        animation: fadeIn 0.2s ease-in-out;
    }
    .attached-file-info {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }
    .attached-file-icon {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        background: var(--admin-primary-light);
        color: var(--admin-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .attached-file-icon .material-symbols-outlined {
        font-size: 28px;
    }
    .attached-file-thumb {
        width: 54px;
        height: 54px;
        border-radius: var(--radius-md);
        object-fit: cover;
        border: 1px solid var(--admin-border);
        flex-shrink: 0;
    }
    .attached-file-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }
    .attached-file-name {
        font-weight: 700;
        font-size: 15px;
        color: var(--admin-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .attached-file-sub {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
    }

    /* ── Form Layout Utilities ── */
    .form-row-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }
    @@media (max-width: 768px) {
        .form-row-grid {
            grid-template-columns: 1fr;
        }
    }
    .form-group-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 20px;
    }
    .form-label-bold {
        font-size: 13px;
        font-weight: 600;
        color: var(--admin-text);
    }
    .form-input-styled {
        width: 100%;
        padding: 10px 14px;
        font-size: 13.5px;
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-md);
        background: var(--admin-bg-surface);
        color: var(--admin-text);
        outline: none;
        transition: var(--transition);
    }
    .form-input-styled:focus {
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px var(--admin-primary-light);
    }
    .form-textarea-styled {
        width: 100%;
        padding: 12px 14px;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 13px;
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-md);
        background: var(--admin-bg-surface);
        color: var(--admin-text);
        outline: none;
        resize: vertical;
        transition: var(--transition);
    }
    .form-textarea-styled:focus {
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px var(--admin-primary-light);
    }

    /* ── Workbench Layout: Grid & Table Views ── */
    .section-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 20px;
    }
    .section-card-item {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: var(--transition);
    }
    .section-card-item:hover {
        border-color: rgba(255, 255, 255, 0.18);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }
    .section-card-header {
        padding: 14px 18px;
        border-bottom: 1px solid var(--admin-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--admin-bg-surface-elevated);
    }
    .section-card-body {
        padding: 18px;
        flex: 1;
    }
    .section-card-footer {
        padding: 12px 18px;
        border-top: 1px solid var(--admin-border);
        background: var(--admin-bg-surface-elevated);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    /* ── Workbench Table Matrix View ── */
    .workbench-table-wrap {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin-bottom: 24px;
    }
    .workbench-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 13.5px;
    }
    .workbench-table th {
        background: var(--admin-bg-surface-elevated);
        padding: 14px 16px;
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--admin-text-muted);
        border-bottom: 1px solid var(--admin-border);
    }
    .workbench-table td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--admin-border);
        color: var(--admin-text);
        vertical-align: middle;
    }
    .workbench-table tr:hover td {
        background: var(--admin-bg-hover);
    }

    /* ── Badge Pill ── */
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: var(--radius-full);
        font-size: 11.5px;
        font-weight: 600;
        text-transform: capitalize;
    }
    .badge-pill-primary { background: var(--admin-primary-light); color: var(--admin-primary); }
    .badge-pill-success { background: var(--admin-success-light); color: var(--admin-success); }
    .badge-pill-info { background: var(--admin-info-light); color: var(--admin-info); }
    /* ── Floating Preview Modal Dialog ── */
    .preview-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.78);
        backdrop-filter: blur(8px);
        z-index: 2000;
        align-items: center;
        justify-content: center;
        padding: 24px;
        box-sizing: border-box;
    }
    .preview-modal-overlay.is-active {
        display: flex;
        animation: modalBackdropFadeIn 0.2s ease-out;
    }
    @@keyframes modalBackdropFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .preview-modal-dialog {
        width: 95vw;
        max-width: 1540px;
        height: 90vh;
        max-height: 920px;
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border);
        border-radius: 16px;
        box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: modalCardSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @@keyframes modalCardSlideUp {
        from { opacity: 0; transform: translateY(16px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .preview-modal-bar {
        height: 56px;
        background: var(--admin-bg-surface);
        border-bottom: 1px solid var(--admin-border);
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
        gap: 16px;
    }
    .preview-modal-tabs {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        background: var(--admin-bg-surface-elevated);
        border-bottom: 1px solid var(--admin-border);
        padding: 0 20px;
        flex-shrink: 0;
    }
    .preview-modal-content {
        flex: 1;
        display: flex;
        overflow: hidden;
        background: var(--admin-bg);
    }
    .preview-viewport-wrap {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        overflow: auto;
        background: var(--admin-bg);
    }
    .preview-viewport-frame {
        background: #0b0f19;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--admin-border);
        transition: width 0.3s ease, background 0.2s ease;
        height: 100%;
        max-width: 100%;
    }
    .preview-viewport-frame.canvas-bright {
        background: #ffffff !important;
    }
    .preview-viewport-frame.canvas-dark {
        background: #0b0f19 !important;
    }
    .preview-tab-pane {
        flex: 1;
        width: 100%;
        height: 100%;
        overflow: hidden;
        animation: tabPaneFadeIn 0.15s ease-out;
    }
    @@keyframes tabPaneFadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ── Interactive Tokens Matrix Table in Inspector ── */
    .tokens-editor-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
    }
    .tokens-editor-table th {
        padding: 10px 12px;
        background: var(--admin-bg-surface-elevated);
        border-bottom: 1px solid var(--admin-border);
        color: var(--admin-text-muted);
        font-size: 11px;
        text-transform: uppercase;
    }
    .tokens-editor-table td {
        padding: 8px 12px;
        border-bottom: 1px solid var(--admin-border);
    }

    /* ── High-Visibility Studio Loading Overlay ── */
    .studio-loading-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(11, 15, 25, 0.88);
        backdrop-filter: blur(12px);
        z-index: 3000;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }
    .studio-loading-card {
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-lg);
        padding: 36px 40px;
        max-width: 520px;
        width: 100%;
        text-align: center;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6);
        position: relative;
        overflow: hidden;
    }
    .loading-pulse-ring {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        border: 3px solid var(--admin-primary-light);
        border-top-color: var(--admin-primary);
        animation: spin 1s linear infinite;
        margin: 0 auto 20px auto;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .loading-step-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 24px;
        text-align: left;
        background: var(--admin-bg-surface-elevated);
        padding: 16px 20px;
        border-radius: var(--radius-md);
        border: 1px solid var(--admin-border);
    }
    .loading-step-item {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: var(--admin-text-muted);
        transition: var(--transition);
    }
    .loading-step-item .material-symbols-outlined {
        font-size: 18px;
        color: var(--admin-text-dim);
    }
    .loading-step-item.step-active {
        color: var(--admin-primary);
        font-weight: 600;
    }
    .loading-step-item.step-active .material-symbols-outlined {
        color: var(--admin-primary);
        animation: spin 1s linear infinite;
    }
    .loading-step-item.step-done {
        color: var(--admin-success);
    }
    .loading-step-item.step-done .material-symbols-outlined {
        color: var(--admin-success);
    }

    @@keyframes spin {
        100% { transform: rotate(360deg); }
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
}

<!-- Header -->
<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/templates" class="btn-admin btn-admin-secondary btn-admin-sm">
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
                Templates
            </a>
            <span class="badge-pill badge-pill-primary">
                <span class="material-symbols-outlined" style="font-size: 14px;">magic_button</span>
                Multi-Channel Ingestion Studio
            </span>
        </div>
        <h1 class="admin-title">Modular Section Studio</h1>
        <p class="admin-subtitle">Decompose templates, live demo URLs, or UI screenshots into zero-collision modular marketplace sections.</p>
    </div>

    <!-- Studio Step Selector -->
    <div class="studio-stepper">
        <button type="button" class="studio-step-btn active" id="pillStep1" onclick="jumpToStep(1)">
            <span class="step-number">1</span> Ingest
        </button>
        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-text-dim);">chevron_right</span>
        <button type="button" class="studio-step-btn" id="pillStep2" onclick="jumpToStep(2)">
            <span class="step-number">2</span> Workbench
        </button>
        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-text-dim);">chevron_right</span>
        <button type="button" class="studio-step-btn" id="pillStep3" onclick="jumpToStep(3)">
            <span class="step-number">3</span> Preview &amp; Publish
        </button>
    </div>
</div>

<!-- Hidden State Holder -->
<div id="rawExtractionJsonData" style="display:none;">@Model.ExtractionResultJson</div>

<!-- ========================================================================= -->
<!-- STEP 1: INPUT CHANNELS -->
<!-- ========================================================================= -->
<div id="stepPanel1" class="studio-step-panel">
    <div class="admin-card" style="width: 100%; overflow: hidden;">
        <!-- Tabs Header -->
        <div class="studio-nav-tabs">
            <button type="button" class="studio-tab-btn active" id="tabBtnSource" onclick="switchImportTab('source')">
                <span class="material-symbols-outlined">html</span>
                1. HTML File / Paste Source
            </button>
            <button type="button" class="studio-tab-btn" id="tabBtnUrl" onclick="switchImportTab('url')">
                <span class="material-symbols-outlined">language</span>
                2. Live Website URL
            </button>
            <button type="button" class="studio-tab-btn" id="tabBtnImage" onclick="switchImportTab('image')">
                <span class="material-symbols-outlined">image</span>
                3. UI Screenshot Mockup
            </button>
        </div>

        <div style="padding: 28px;">
            <!-- TAB 1: HTML FILE / PASTE -->
            <div id="panelSourceExtractor">
                <form id="formSourceIngest" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="form-row-grid">
                        <div class="form-group-block">
                            <label class="form-label-bold">Theme Suite / Family Name</label>
                            <input type="text" class="form-input-styled" id="sourceSuiteName" name="suiteName" value="@Model.SuiteName" placeholder="e.g. Creative Agency Suite" required />
                        </div>
                        <div class="form-group-block">
                            <label class="form-label-bold">Brand Name to Debrand</label>
                            <input type="text" class="form-input-styled" id="sourceBrandName" name="brandName" value="@Model.BrandName" placeholder="e.g. Enterprise Workspace" />
                        </div>
                    </div>

                    <div class="form-group-block">
                        <label class="form-label-bold">Base URL / Demo Asset Origin <span style="font-weight: 400; color: var(--admin-text-muted); font-size: 12px;">(Optional — for resolving relative CSS, JS, and images)</span></label>
                        <input type="url" class="form-input-styled" id="sourceBaseUrl" name="baseUrl" placeholder="e.g. https://demo.example.com" />
                        <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: flex; align-items: center; gap: 4px;">
                            <span class="material-symbols-outlined" style="font-size: 15px;">info</span>
                            Used to download relative assets (e.g. <code>assets/css/style.css</code>, <code>assets/img/hero.jpg</code>) and upload them to your CDN.
                        </div>
                    </div>

                    <div class="form-group-block">
                        <label class="form-label-bold">Upload Template .html File</label>
                        
                        <!-- Initial Dropzone -->
                        <label for="sourceHtmlFileInput" class="studio-dropzone" id="htmlDropzoneArea">
                            <input type="file" id="sourceHtmlFileInput" name="htmlFile" accept=".html,.htm" onchange="handleHtmlFileSelect(this)" />
                            <span class="material-symbols-outlined" style="font-size: 40px; color: var(--admin-primary); margin-bottom: 8px; display: block;">cloud_upload</span>
                            <div style="font-weight: 700; color: var(--admin-text); font-size: 14px;">Drag &amp; drop your template .html file here, or click to browse</div>
