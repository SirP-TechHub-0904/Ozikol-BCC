                                <img id="attachedImageThumb" class="attached-file-thumb" src="" alt="Thumbnail" />
                                <div class="attached-file-meta">
                                    <div class="attached-file-name" id="attachedImageFileName">screenshot.png</div>
                                    <div class="attached-file-sub">
