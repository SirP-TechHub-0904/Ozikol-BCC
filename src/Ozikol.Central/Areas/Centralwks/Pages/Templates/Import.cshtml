                    <div style="display: flex; justify-content: flex-end;">
                        <button type="button" class="btn-admin btn-admin-primary btn-admin-lg" id="btnRunImageIngest" onclick="executeImageIngest()">
                            <span class="material-symbols-outlined">auto_awesome</span>
