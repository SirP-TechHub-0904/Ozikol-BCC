                                <label for="visionScreenshotInput" class="btn-admin btn-admin-secondary btn-admin-sm" style="cursor: pointer;">
                                    <span class="material-symbols-outlined">sync</span> Change Image
                                </label>
                                <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" onclick="clearImageFile()">
                                    <span class="material-symbols-outlined">close</span> Remove
                                </button>
                            </div>
                        </div>
