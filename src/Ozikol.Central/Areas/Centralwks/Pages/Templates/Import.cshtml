    <div class="studio-loading-card">
        <div class="loading-pulse-ring">
            <span class="material-symbols-outlined" style="font-size: 32px; color: var(--admin-primary);">auto_awesome</span>
        </div>
        <h3 style="font-size: 18px; font-weight: 700; color: var(--admin-text); margin: 0 0 6px 0;" id="loadingOverlayTitle">Preparing Your Sections...</h3>
        <p style="font-size: 13px; color: var(--admin-text-muted); margin: 0 0 16px 0;" id="loadingOverlaySubtitle">Reading your design, organizing sections, styling components, and preparing your live preview.</p>
        <span class="badge-pill badge-pill-secondary" id="loadingOverlayTimer">0s elapsed</span>

        <div class="loading-step-list">
            <div class="loading-step-item step-active" id="loadStep1">
                <span class="material-symbols-outlined">sync</span>
                <span>1. Reading page layout and stylesheets</span>
            </div>
            <div class="loading-step-item" id="loadStep2">
                <span class="material-symbols-outlined">radio_button_unchecked</span>
                <span>2. Creating customizable text and image tags</span>
            </div>
            <div class="loading-step-item" id="loadStep3">
                <span class="material-symbols-outlined">radio_button_unchecked</span>
                <span>3. Cleaning and scoping component styles</span>
            </div>
            <div class="loading-step-item" id="loadStep4">
                <span class="material-symbols-outlined">radio_button_unchecked</span>
                <span>4. Saving modular sections ready for preview</span>
            </div>
        </div>
    </div>
</div>

