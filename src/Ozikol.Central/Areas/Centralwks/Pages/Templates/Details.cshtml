@page "{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.DetailsModel
@{
    ViewData["Title"] = $"Template: {Model.Template.Name}";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">@Model.Template.Name</h1>
        <p class="admin-subtitle">Programmatic Variant Code: <code style="color: #38bdf8; font-size: 14px;">@Model.Template.VariantCode</code></p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/templates/edit/@Model.Template.Id" class="btn-admin btn-admin-primary">
            <span>✏️</span> Edit Template
        </a>
        <a href="/centralwks/templates" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Templates
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@* ── Template Identity Hero Card ── *@
<div class="admin-card" style="margin-bottom: 24px; overflow: hidden;">
    <div style="height: 120px; background: @Model.Template.ThumbnailGradient; position: relative; padding: 24px; display: flex; align-items: flex-end;">
        <div style="position: absolute; top: 16px; right: 16px; display: flex; gap: 8px;">
            <span class="badge @(Model.Template.IsActive ? "badge-success" : "badge-secondary")" style="font-size: 12px; padding: 6px 14px;">
                @(Model.Template.IsActive ? "Active & Published" : "Hidden Blueprint")
            </span>
            @if (!string.IsNullOrWhiteSpace(Model.Template.Badge))
            {
                <span class="badge badge-warning" style="font-size: 12px; padding: 6px 12px;">
                    @Model.Template.Badge
                </span>
            }
        </div>
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; border-radius: 12px; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; font-size: 26px; color: #fff;">
                <span>◈</span>
            </div>
            <div>
                <h2 style="font-size: 22px; font-weight: 800; color: #fff; margin: 0; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);">
                    @Model.Template.Name
                </h2>
                <div style="font-size: 13px; color: rgba(255, 255, 255, 0.8); margin-top: 2px;">
                    Category: <strong style="color: #fff;">@(Model.Template.Category?.Name ?? Model.Template.CategoryKey)</strong> &bull;
                    Tag: <span style="font-weight: 600;">#@Model.Template.Tag</span> &bull;
                    Version: <span style="font-family: monospace;">v@Model.Template.Version</span>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Template.Description))
    {
        <div style="padding: 16px 24px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 14px; color: var(--admin-text-muted); line-height: 1.6;">
            @Model.Template.Description
        </div>
    }
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    @* ── Left: Source Code Inspector ── *@
    <div>
        <div class="admin-card" style="margin-bottom: 24px;">
            <div class="card-header-styled" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                <div class="card-header-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">💻</div>
                <div>
                    <h3 class="card-header-title">Source Markup & Code</h3>
                    <p class="card-header-subtitle">Inspect the underlying template source code and stylesheets.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                @* HTML Template *@
                <div style="margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-muted);">
                            Semantic HTML (Mustache Syntax)
                        </span>
                        <span style="font-size: 11px; font-family: monospace; color: #38bdf8;">@Model.Template.HtmlTemplate.Length chars</span>
                    </div>
                    <pre style="background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 16px; color: #38bdf8; font-family: monospace; font-size: 12px; line-height: 1.5; overflow-x: auto; max-height: 280px; margin: 0;"><code>@Model.Template.HtmlTemplate</code></pre>
                </div>

                @* Scoped CSS *@
                <div style="margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-muted);">
                            Scoped CSS Stylesheet
                        </span>
                        <span style="font-size: 11px; font-family: monospace; color: #a78bfa;">@Model.Template.CssStyles.Length chars</span>
                    </div>
                    <pre style="background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 16px; color: #a78bfa; font-family: monospace; font-size: 12px; line-height: 1.5; overflow-x: auto; max-height: 240px; margin: 0;"><code>@Model.Template.CssStyles</code></pre>
                </div>

                @* Sandboxed JS *@
                @if (!string.IsNullOrWhiteSpace(Model.Template.JsScript))
                {
                    <div style="margin-bottom: 20px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-muted);">
                                Sandboxed JavaScript Execution
                            </span>
                            <span style="font-size: 11px; font-family: monospace; color: #facc15;">@Model.Template.JsScript.Length chars</span>
                        </div>
                        <pre style="background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 16px; color: #facc15; font-family: monospace; font-size: 12px; line-height: 1.5; overflow-x: auto; max-height: 180px; margin: 0;"><code>@Model.Template.JsScript</code></pre>
                    </div>
                }

                @* Mock Lists JSON *@
                @if (!string.IsNullOrWhiteSpace(Model.Template.DefaultSectionListsJson))
                {
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-muted);">
                                Mock Section List Items (JSON)
                            </span>
                        </div>
                        <pre style="background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 16px; color: #4ade80; font-family: monospace; font-size: 12px; line-height: 1.5; overflow-x: auto; max-height: 180px; margin: 0;"><code>@Model.Template.DefaultSectionListsJson</code></pre>
                    </div>
                }
            </div>
        </div>

        @* ── Simulated Preview ── *@
        <div class="admin-card">
            <div class="card-header-styled" style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">👁️</div>
                <div>
                    <h3 class="card-header-title">Rendered HTML Simulation</h3>
                    <p class="card-header-subtitle">Substituted mock parameters evaluated against template markup.</p>
                </div>
            </div>

            <div style="padding: 24px; background: rgba(0, 0, 0, 0.2); border-radius: 0 0 12px 12px;">
                <div style="background: #0f172a; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 24px; min-height: 160px;">
                    <style>
                        @Html.Raw(Model.Template.CssStyles)
                    </style>
                    @Html.Raw(Model.RenderedPreviewHtml)
                </div>
            </div>
        </div>
    </div>

    @* ── Right: Template Attributes & Actions ── *@
    <div>
        <div class="admin-card" style="margin-bottom: 24px;">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">📊</div>
                <div>
                    <h3 class="card-header-title">Blueprint Metrics</h3>
                    <p class="card-header-subtitle">Configuration parameters.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                <div style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted);">Unique ID</div>
                        <div style="font-family: monospace; font-size: 12px; color: #fff; margin-top: 2px;">@Model.Template.Id</div>
                    </div>

                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted);">Variant Code</div>
                        <div style="font-family: monospace; font-size: 13px; color: #38bdf8; font-weight: 600; margin-top: 2px;">@Model.Template.VariantCode</div>
                    </div>

                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted);">Display Sort Order</div>
                        <div style="font-size: 14px; font-weight: 600; color: #fff; margin-top: 2px;">#@Model.Template.SortOrder</div>
                    </div>

                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted);">Registered Date</div>
                        <div style="font-size: 13px; color: #fff; margin-top: 2px;">@Model.Template.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
                    </div>

                    @if (Model.Template.UpdatedUtc.HasValue)
                    {
                        <div>
                            <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted);">Last Modified</div>
                            <div style="font-size: 13px; color: #fff; margin-top: 2px;">@Model.Template.UpdatedUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">⚡</div>
                <div>
                    <h3 class="card-header-title">Management Actions</h3>
                    <p class="card-header-subtitle">Administrative controls.</p>
                </div>
            </div>

            <div style="padding: 20px; display: flex; flex-direction: column; gap: 10px;">
                <a href="/centralwks/templates/edit/@Model.Template.Id" class="btn-admin btn-admin-primary" style="justify-content: center;">
                    <span>✏️</span> Edit Template
                </a>

                <form method="post" asp-page-handler="ToggleActive" asp-route-id="@Model.Template.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center;">
                        <span>@(Model.Template.IsActive ? "⏸️" : "▶️")</span>
                        @(Model.Template.IsActive ? "Hide from Marketplace" : "Publish to Marketplace")
                    </button>
                </form>

                <a href="/centralwks/templates" class="btn-admin btn-admin-secondary" style="justify-content: center;">
                    Back to All Templates
                </a>
            </div>
        </div>
    </div>
</div>
