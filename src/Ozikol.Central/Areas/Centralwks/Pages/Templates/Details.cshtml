@page "/centralwks/templates/{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.DetailsModel
@{
    ViewData["Title"] = $"Inspect {Model.Template.Name}";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

@section Styles {
<style>
    .details-split-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 24px;
    }
    @@media (max-width: 1024px) {
        .details-split-grid {
            grid-template-columns: 1fr;
        }
    }
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: var(--radius-full);
        font-size: 11.5px;
        font-weight: 600;
        text-transform: capitalize;
    }
    .badge-pill-primary { background: var(--admin-primary-light); color: var(--admin-primary); }
    .badge-pill-secondary { background: var(--admin-bg-hover); color: var(--admin-text-muted); }
</style>
}

<!-- Header -->
<div class="admin-page-header">
        <div class="admin-title-group">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <a href="/centralwks/templates" class="btn-admin btn-admin-secondary btn-admin-sm">
                    <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
                    Templates
                </a>
                <span class="badge-pill badge-pill-primary">@Model.Template.CategoryKey</span>
                <span style="font-family: monospace; font-size: 11px; color: var(--admin-text-muted);">@Model.Template.VariantCode</span>
            </div>
            <h1 class="admin-title">@Model.Template.Name</h1>
            <p class="admin-subtitle">@(string.IsNullOrEmpty(Model.Template.Description) ? "Modular website marketplace section." : Model.Template.Description)</p>
        </div>

        <div class="admin-actions">
            <a href="/centralwks/templates/@Model.Template.Id/edit" class="btn-admin btn-admin-primary">
                <span class="material-symbols-outlined">edit</span>
                Edit Section Code
            </a>
        </div>
    </div>

    <!-- Inspector Split Layout -->
    <div class="details-split-grid">
        <!-- Left: Live Sandbox Viewport -->
        <div class="admin-card" style="overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 14px 20px; border-bottom: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between; background: var(--admin-bg-surface-elevated);">
                <div style="font-weight: 700; font-size: 13.5px; color: var(--admin-text); display: flex; align-items: center; gap: 6px;">
                    <span class="material-symbols-outlined" style="color: var(--admin-primary); font-size: 18px;">desktop_windows</span>
                    Live Sandbox Viewport
                </div>
                <div style="display: flex; gap: 4px;">
                    <button type="button" class="btn-admin btn-admin-primary btn-admin-sm" id="btnWDesktop" onclick="setIframeWidth('100%', this)">Desktop</button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" id="btnWTablet" onclick="setIframeWidth('768px', this)">Tablet</button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" id="btnWMobile" onclick="setIframeWidth('375px', this)">Mobile</button>
                </div>
            </div>
            <div style="flex: 1; padding: 20px; background: var(--admin-bg); display: flex; justify-content: center; align-items: center; min-height: 520px; overflow: auto;">
                <iframe id="detailsPreviewFrame" style="width: 100%; height: 520px; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); border: 1px solid var(--admin-border); background: #ffffff;" sandbox="allow-scripts allow-same-origin"></iframe>
            </div>
        </div>

        <!-- Right: Code Tabs -->
        <div class="admin-card" style="overflow: hidden; display: flex; flex-direction: column;">
            <div style="display: flex; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <button type="button" class="btn-admin btn-admin-primary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="btnTabHtml" onclick="switchDetailTab('html')">
                    <span class="material-symbols-outlined" style="font-size: 16px;">html</span> HTML Template
                </button>
                <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="btnTabCss" onclick="switchDetailTab('css')">
                    <span class="material-symbols-outlined" style="font-size: 16px;">css</span> Scoped CSS
                </button>
                <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="btnTabJson" onclick="switchDetailTab('json')">
                    <span class="material-symbols-outlined" style="font-size: 16px;">data_object</span> Mock JSON
                </button>
                <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="btnTabJs" onclick="switchDetailTab('js')">
                    <span class="material-symbols-outlined" style="font-size: 16px;">javascript</span> JS
                </button>
            </div>

            <div style="padding: 16px; flex: 1; overflow: auto; background: var(--admin-bg); max-height: 540px;">
                <div id="contentTabHtml">
                    <pre style="margin: 0; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12.5px; color: var(--admin-text); white-space: pre-wrap;"><code>@Model.Template.HtmlTemplate</code></pre>
                </div>
                <div id="contentTabCss" style="display:none;">
                    <pre style="margin: 0; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12.5px; color: var(--admin-text); white-space: pre-wrap;"><code>@Model.Template.CssStyles</code></pre>
                </div>
                <div id="contentTabJson" style="display:none;">
                    <pre style="margin: 0; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12.5px; color: var(--admin-text); white-space: pre-wrap;"><code>@(string.IsNullOrEmpty(Model.Template.DefaultSectionListsJson) ? "/* No default JSON lists */" : Model.Template.DefaultSectionListsJson)</code></pre>
                </div>
                <div id="contentTabJs" style="display:none;">
                    <pre style="margin: 0; font-family: 'JetBrains Mono', Consolas, monospace; font-size: 12.5px; color: var(--admin-text); white-space: pre-wrap;"><code>@(string.IsNullOrEmpty(Model.Template.JsScript) ? "/* No custom JS logic */" : Model.Template.JsScript)</code></pre>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        var previewHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SandboxPreviewHtml));

        document.addEventListener('DOMContentLoaded', function() {
            var iframe = document.getElementById('detailsPreviewFrame');
            if (iframe && previewHtml) {
                var doc = iframe.contentDocument || iframe.contentWindow.document;
                doc.open();
                doc.write(previewHtml);
                doc.close();
            }
        });

        function setIframeWidth(width, btn) {
            var iframe = document.getElementById('detailsPreviewFrame');
            if (iframe) iframe.style.width = width;
            document.querySelectorAll('#btnWDesktop, #btnWTablet, #btnWMobile').forEach(function(b) {
                b.classList.remove('btn-admin-primary');
                b.classList.add('btn-admin-secondary');
            });
            btn.classList.remove('btn-admin-secondary');
            btn.classList.add('btn-admin-primary');
        }

        function switchDetailTab(tab) {
            ['html', 'css', 'json', 'js'].forEach(function(t) {
                var btn = document.getElementById('btnTab' + t.charAt(0).toUpperCase() + t.slice(1));
                var content = document.getElementById('contentTab' + t.charAt(0).toUpperCase() + t.slice(1));
                if (btn) {
                    btn.classList.remove('btn-admin-primary');
                    btn.classList.add('btn-admin-secondary');
                }
                if (content) content.style.display = 'none';
            });

            var activeBtn = document.getElementById('btnTab' + tab.charAt(0).toUpperCase() + tab.slice(1));
            var activeContent = document.getElementById('contentTab' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (activeBtn) {
                activeBtn.classList.remove('btn-admin-secondary');
                activeBtn.classList.add('btn-admin-primary');
            }
            if (activeContent) activeContent.style.display = 'block';
        }
    </script>
}
