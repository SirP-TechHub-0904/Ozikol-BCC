@page "/centralwks/templates/create"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.CreateModel
@{
    ViewData["Title"] = "Create Manual Section";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

@section Styles {
<style>
    .create-split-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 24px;
    }
    @@media (max-width: 1024px) {
        .create-split-grid {
            grid-template-columns: 1fr;
        }
    }
    .form-group-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 18px;
    }
    .form-label-bold {
        font-size: 13px;
        font-weight: 600;
        color: var(--admin-text);
    }
    .form-input-styled {
        width: 100%;
        padding: 10px 14px;
        font-size: 13.5px;
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-md);
        background: var(--admin-bg-surface-elevated);
        color: var(--admin-text);
        outline: none;
        transition: var(--transition);
    }
    .form-input-styled:focus {
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px var(--admin-primary-light);
    }
    .form-textarea-styled {
        width: 100%;
        padding: 12px 14px;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 13px;
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-md);
        background: var(--admin-bg-surface-elevated);
        color: var(--admin-text);
        outline: none;
        resize: vertical;
        transition: var(--transition);
    }
    .form-textarea-styled:focus {
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px var(--admin-primary-light);
    }
</style>
}

<!-- Header -->
<div class="admin-page-header">
        <div class="admin-title-group">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <a href="/centralwks/templates" class="btn-admin btn-admin-secondary btn-admin-sm">
                    <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
                    Cancel &amp; Back
                </a>
            </div>
            <h1 class="admin-title">Create Modular Section</h1>
            <p class="admin-subtitle">Build an isolated, zero-collision template section from scratch.</p>
        </div>
    </div>

    <!-- Create Form -->
    <form method="post">
        @Html.AntiForgeryToken()

        <div class="create-split-grid">
            <!-- Left: Metadata -->
            <div class="admin-card" style="padding: 24px; height: fit-content;">
                <h3 style="font-size: 16px; font-weight: 700; color: var(--admin-text); margin-bottom: 20px;">Section Metadata</h3>

                <div class="form-group-block">
                    <label asp-for="Input.Name" class="form-label-bold">Display Name</label>
                    <input asp-for="Input.Name" class="form-input-styled" placeholder="e.g. Split Hero Showcase" required />
                    <span asp-validation-for="Input.Name" style="color: var(--admin-danger); font-size: 12px;"></span>
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.VariantCode" class="form-label-bold">Variant Code (Unique)</label>
                    <input asp-for="Input.VariantCode" class="form-input-styled" style="font-family: monospace;" placeholder="e.g. hero_split_01" required />
                    <span asp-validation-for="Input.VariantCode" style="color: var(--admin-danger); font-size: 12px;"></span>
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.CategoryKey" class="form-label-bold">Category</label>
                    <select asp-for="Input.CategoryKey" class="form-input-styled">
                        <option value="menu">Menu / Nav</option>
                        <option value="hero" selected>Hero Section</option>
                        <option value="bodysections">Body &amp; Features</option>
                        <option value="blog">Blog &amp; Cards</option>
                        <option value="contact">Contact</option>
                        <option value="footer">Footer</option>
                    </select>
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.Badge" class="form-label-bold">Badge (Optional)</label>
                    <input asp-for="Input.Badge" class="form-input-styled" placeholder="e.g. New, Popular, Pro" />
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.Description" class="form-label-bold">Description</label>
                    <textarea asp-for="Input.Description" class="form-input-styled" rows="3" placeholder="Describe this section..."></textarea>
                </div>

                <button type="submit" class="btn-admin btn-admin-primary btn-admin-lg" style="width: 100%; margin-top: 10px;">
                    <span class="material-symbols-outlined">cloud_upload</span>
                    Save to Marketplace
                </button>
            </div>

            <!-- Right: Code Blocks -->
            <div class="admin-card" style="overflow: hidden; display: flex; flex-direction: column;">
                <div style="display: flex; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                    <button type="button" class="btn-admin btn-admin-primary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="cTabBtnHtml" onclick="switchCreateTab('html')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">html</span> HTML Template
                    </button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="cTabBtnCss" onclick="switchCreateTab('css')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">css</span> Scoped CSS
                    </button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="cTabBtnJson" onclick="switchCreateTab('json')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">data_object</span> Mock JSON
                    </button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="cTabBtnJs" onclick="switchCreateTab('js')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">javascript</span> JS Script
                    </button>
                </div>

                <div style="padding: 20px; flex: 1; background: var(--admin-bg);">
                    <!-- HTML Editor -->
                    <div id="cPanelHtml">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Mustache-Parameterized Semantic HTML</label>
                        <textarea asp-for="Input.HtmlTemplate" class="form-textarea-styled" rows="20" placeholder="<section class='...'>...</section>" required></textarea>
                    </div>

                    <!-- Scoped CSS Editor -->
                    <div id="cPanelCss" style="display:none;">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Scoped CSS Rules</label>
                        <textarea asp-for="Input.CssStyles" class="form-textarea-styled" rows="20" placeholder=".header-area { ... }"></textarea>
                    </div>

                    <!-- Mock JSON Editor -->
                    <div id="cPanelJson" style="display:none;">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Default Section Content Mock JSON</label>
                        <textarea asp-for="Input.DefaultSectionListsJson" class="form-textarea-styled" rows="20" placeholder="[ { 'Title': 'Item 1' } ]"></textarea>
                    </div>

                    <!-- JS Script Editor -->
                    <div id="cPanelJs" style="display:none;">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Optional Component JavaScript Logic</label>
                        <textarea asp-for="Input.JsScript" class="form-textarea-styled" rows="20" placeholder="// Component JS logic"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </form>

@section Scripts {
    <script>
        function switchCreateTab(tab) {
            ['html', 'css', 'json', 'js'].forEach(function(t) {
                var btn = document.getElementById('cTabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                var panel = document.getElementById('cPanel' + t.charAt(0).toUpperCase() + t.slice(1));
                if (btn) {
                    btn.classList.remove('btn-admin-primary');
                    btn.classList.add('btn-admin-secondary');
                }
                if (panel) panel.style.display = 'none';
            });

            var activeBtn = document.getElementById('cTabBtn' + tab.charAt(0).toUpperCase() + tab.slice(1));
            var activePanel = document.getElementById('cPanel' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (activeBtn) {
                activeBtn.classList.remove('btn-admin-secondary');
                activeBtn.classList.add('btn-admin-primary');
            }
            if (activePanel) activePanel.style.display = 'block';
        }
    </script>
}
