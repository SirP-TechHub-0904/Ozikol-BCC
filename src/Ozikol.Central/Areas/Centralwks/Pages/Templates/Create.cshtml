@page
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.CreateModel
@{
    ViewData["Title"] = "Create Marketplace Template";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

<style>
    .studio-header-card {
        background: linear-gradient(135deg, #0b1120 0%, #1e293b 50%, #0f172a 100%);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    .studio-tab-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(15, 23, 42, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: none;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        padding: 0 16px;
        flex-wrap: wrap;
        gap: 8px;
    }
    .studio-tab-group {
        display: flex;
        gap: 4px;
        overflow-x: auto;
    }
    .studio-tab-btn {
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: #94a3b8;
        padding: 14px 16px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        transition: all 0.15s ease;
    }
    .studio-tab-btn:hover {
        color: #fff;
    }
    .studio-tab-btn.active {
        color: #38bdf8;
        border-bottom-color: #38bdf8;
        background: rgba(56, 189, 248, 0.06);
    }
    .studio-editor-pane {
        display: none;
        background: #020617;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        padding: 20px;
    }
    .studio-editor-pane.active {
        display: block;
    }
    .code-textarea {
        width: 100%;
        height: 480px;
        background: #090e1a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 8px;
        padding: 16px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 13px;
        line-height: 1.6;
        tab-size: 4;
        color: #f1f5f9;
        box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.6);
        resize: vertical;
        transition: height 0.2s ease;
    }
    .code-textarea:focus {
        outline: none;
        border-color: #38bdf8;
        box-shadow: inset 0 2px 8px rgba(0,0,0,0.6), 0 0 0 1px #38bdf8;
    }
    .token-chip-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        padding: 10px 14px;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        margin-bottom: 12px;
    }
    .token-chip {
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.25);
        color: #38bdf8;
        padding: 3px 8px;
        border-radius: 6px;
        font-family: monospace;
        font-size: 11px;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }
    .token-chip:hover {
        background: rgba(56, 189, 248, 0.25);
        border-color: #38bdf8;
        color: #fff;
    }
    .height-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #94a3b8;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.15s ease;
    }
    .height-btn:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }
    .height-btn.active {
        background: rgba(56, 189, 248, 0.2);
        color: #38bdf8;
        border-color: rgba(56, 189, 248, 0.4);
    }
</style>

<form method="post">
    @Html.AntiForgeryToken()

    @* ── Studio Top Action & Title Header ── *@
    <div class="admin-page-header">
        <div class="admin-title-group">
            <h1 class="admin-title">Create Marketplace Template</h1>
            <p class="admin-subtitle">Author a new modular UI block blueprint with full-width code workspace and token hydration.</p>
        </div>
        <div class="admin-actions" style="display: flex; gap: 10px; align-items: center;">
            <a href="/centralwks/templates" class="btn-admin btn-admin-secondary">
                Cancel
            </a>
            <button type="submit" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; padding: 10px 22px;">
                <span class="material-symbols-outlined" style="font-size: 18px;">add_box</span> Create Blueprint
            </button>
        </div>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    @* ── Compact Identity & Blueprint Metadata Bar ── *@
    <div class="studio-header-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-outlined" style="color: #38bdf8; font-size: 20px;">tune</span>
                <span style="font-size: 14px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 0.03em;">Blueprint Parameters & Identity</span>
            </div>
            <button type="button" class="height-btn" onclick="toggleMetadataBar(this)">
                <span id="metadataToggleIcon" class="material-symbols-outlined" style="font-size: 16px;">expand_less</span>
                <span id="metadataToggleText">Collapse Settings</span>
            </button>
        </div>

        <div id="metadataFieldsContainer">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 16px;">
                <div class="form-group">
                    <label asp-for="Input.Name" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Template Name <span style="color: var(--admin-danger);">*</span>
                    </label>
                    <input asp-for="Input.Name" class="form-control" placeholder="e.g. Modern Feature Grid Showcase" />
                    <span asp-validation-for="Input.Name" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.VariantCode" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Programmatic Variant Code <span style="color: var(--admin-danger);">*</span>
                    </label>
                    <input asp-for="Input.VariantCode" class="form-control" style="font-family: monospace; color: #38bdf8;" placeholder="e.g. BODY_09" />
                    <span asp-validation-for="Input.VariantCode" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.CategoryId" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Category <span style="color: var(--admin-danger);">*</span>
                    </label>
                    <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="Input.CategoryId" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Tag" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Style Classification
                    </label>
                    <select asp-for="Input.Tag" class="form-select">
                        <option value="modern">Modern & Clean</option>
                        <option value="dark">Dark & Futuristic</option>
                        <option value="minimal">Minimalist</option>
                        <option value="corporate">Corporate & Enterprise</option>
                        <option value="ecommerce">E-Commerce</option>
                        <option value="creative">Creative & Portfolio</option>
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div class="form-group">
                    <label asp-for="Input.Description" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Short Summary Description
                    </label>
                    <input asp-for="Input.Description" class="form-control" placeholder="e.g. Modular body section with isolated scoped CSS and responsive items." />
                </div>

                <div class="form-group">
                    <label asp-for="Input.Version" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Version
                    </label>
                    <input asp-for="Input.Version" class="form-control" style="font-family: monospace;" value="1.0.0" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.SortOrder" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Display Sort Order
                    </label>
                    <input asp-for="Input.SortOrder" type="number" class="form-control" value="10" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.Badge" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Badge (Optional)
                    </label>
                    <input asp-for="Input.Badge" class="form-control" placeholder="e.g. New" />
                </div>

                <div class="form-group" style="display: flex; flex-direction: column; justify-content: flex-end;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding-bottom: 10px;">
                        <input asp-for="Input.IsActive" type="checkbox" checked style="width: 18px; height: 18px; accent-color: var(--admin-primary);" />
                        <span style="font-size: 13px; font-weight: 600; color: #34d399;">Active & Published</span>
                    </label>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
                <div class="form-group">
                    <label asp-for="Input.PreviewTitle" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Preview Title Override (Optional)
                    </label>
                    <input asp-for="Input.PreviewTitle" class="form-control" placeholder="e.g. Default title in builder" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.PreviewImageUrl" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Demo Image URL (Optional)
                    </label>
                    <input asp-for="Input.PreviewImageUrl" class="form-control" placeholder="https://..." />
                </div>

                <div class="form-group">
                    <label asp-for="Input.ThumbnailGradient" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Thumbnail Gradient (CSS)
                    </label>
                    <input asp-for="Input.ThumbnailGradient" class="form-control" style="font-family: monospace;" value="linear-gradient(135deg, #1e293b 0%, #0f172a 100%)" />
                </div>
            </div>
        </div>
    </div>

    @* ── Full-Width Tabbed Code Studio ── *@
    <div style="margin-bottom: 30px;">
        <div class="studio-tab-bar">
            <div class="studio-tab-group">
                <button type="button" class="studio-tab-btn active" onclick="switchStudioTab('html', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #38bdf8;">code</span>
                    Semantic HTML Template
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('css', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #a78bfa;">palette</span>
                    Scoped CSS Styles
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('js', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #facc15;">javascript</span>
                    Sandboxed JavaScript
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('json', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #4ade80;">data_object</span>
                    Default Mock JSON Items
                </button>
            </div>

            <div style="display: flex; gap: 6px; align-items: center; padding: 6px 0;">
                <span style="font-size: 11px; color: var(--admin-text-muted); margin-right: 4px;">Editor Height:</span>
                <button type="button" class="height-btn" onclick="setEditorHeight(320, this)" title="Minimise Editor View">
                    <span class="material-symbols-outlined" style="font-size: 14px;">compress</span> Compact
                </button>
                <button type="button" class="height-btn active" onclick="setEditorHeight(520, this)" title="Standard Editor View">
                    <span class="material-symbols-outlined" style="font-size: 14px;">aspect_ratio</span> Standard
                </button>
                <button type="button" class="height-btn" onclick="setEditorHeight(780, this)" title="Expand Full Height">
                    <span class="material-symbols-outlined" style="font-size: 14px;">expand</span> Expanded
                </button>
            </div>
        </div>

        @* ── Tab 1: HTML Editor ── *@
        <div id="studio-pane-html" class="studio-editor-pane active">
            <div class="token-chip-bar">
                <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">Insert Token:</span>
                <span class="token-chip" onclick="insertToken('{{ Title }}')">{{ Title }}</span>
                <span class="token-chip" onclick="insertToken('{{ Subtitle }}')">{{ Subtitle }}</span>
                <span class="token-chip" onclick="insertToken('{{ MiniTitle }}')">{{ MiniTitle }}</span>
                <span class="token-chip" onclick="insertToken('{{ Description }}')">{{ Description }}</span>
                <span class="token-chip" onclick="insertToken('{{ ImageUrl }}')">{{ ImageUrl }}</span>
                <span class="token-chip" onclick="insertToken('{{ ButtonText }}')">{{ ButtonText }}</span>
                <span class="token-chip" onclick="insertToken('{{ ButtonUrl }}')">{{ ButtonUrl }}</span>
                <span class="token-chip" onclick="insertToken('{{#each SectionLists}}\n    <div class=\"item\">\n        <h3>{{ Title }}</h3>\n        <p>{{ Description }}</p>\n    </div>\n{{/each}}')">{{#each SectionLists}}...{{/each}}</span>
                <span class="token-chip" onclick="insertToken('{{ IconName }}')">{{ IconName }}</span>
            </div>

            <textarea asp-for="Input.HtmlTemplate" id="htmlTextarea" class="code-textarea" style="color: #38bdf8;" spellcheck="false" placeholder="Write semantic HTML markup containing mustache tags..."></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                <span asp-validation-for="Input.HtmlTemplate" class="text-danger" style="font-size: 12px; color: var(--admin-danger);"></span>
                <span id="htmlCharCounter" style="font-size: 11px; font-family: monospace; color: var(--admin-text-muted);">0 characters</span>
            </div>
        </div>

        @* ── Tab 2: CSS Editor ── *@
        <div id="studio-pane-css" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 12px; color: #a78bfa; font-weight: 600;">Scoped CSS Stylesheet (Scoped to section class)</span>
                <button type="button" class="height-btn" onclick="formatCss()">
                    <span class="material-symbols-outlined" style="font-size: 14px;">format_align_left</span> Auto Format
                </button>
            </div>
            <textarea asp-for="Input.CssStyles" id="cssTextarea" class="code-textarea" style="color: #a78bfa;" spellcheck="false" placeholder=".sec-variant-... { ... }"></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                <span asp-validation-for="Input.CssStyles" class="text-danger" style="font-size: 12px; color: var(--admin-danger);"></span>
                <span id="cssCharCounter" style="font-size: 11px; font-family: monospace; color: var(--admin-text-muted);">0 characters</span>
            </div>
        </div>

        @* ── Tab 3: JS Editor ── *@
        <div id="studio-pane-js" class="studio-editor-pane">
            <div style="margin-bottom: 10px; font-size: 12px; color: #facc15;">
                Client-Side JavaScript execution logic. Runs in isolated container upon hydration.
            </div>
            <textarea asp-for="Input.JsScript" id="jsTextarea" class="code-textarea" style="color: #facc15;" spellcheck="false" placeholder="// e.g. initialize carousels, tabs, or modal behaviors..."></textarea>
        </div>

        @* ── Tab 4: JSON Editor ── *@
        <div id="studio-pane-json" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 12px; color: #4ade80;">JSON array of default mock items when template is inserted into site builder.</span>
                <button type="button" class="height-btn" onclick="formatJson()">
                    <span class="material-symbols-outlined" style="font-size: 14px;">data_object</span> Format JSON
                </button>
            </div>
            <textarea asp-for="Input.DefaultSectionListsJson" id="jsonTextarea" class="code-textarea" style="color: #4ade80;" spellcheck="false" placeholder='[{"Title": "Feature 1", "Description": "Description...", "Icon": "star"}]'></textarea>
        </div>
    </div>

    @* ── Bottom Action Bar ── *@
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px;">
        <a href="/centralwks/templates" class="btn-admin btn-admin-secondary">
            &larr; Back to Templates List
        </a>
        <button type="submit" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; padding: 12px 28px;">
            <span class="material-symbols-outlined" style="font-size: 18px;">add_box</span> Create Template Blueprint
        </button>
    </div>
</form>

<script>
    function switchStudioTab(tabId, btn) {
        document.querySelectorAll('.studio-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.studio-editor-pane').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const pane = document.getElementById('studio-pane-' + tabId);
        if (pane) pane.classList.add('active');
    }

    function setEditorHeight(heightPx, btn) {
        document.querySelectorAll('.height-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.code-textarea').forEach(ta => {
            ta.style.height = heightPx + 'px';
        });
    }

    function toggleMetadataBar(btn) {
        const container = document.getElementById('metadataFieldsContainer');
        const icon = document.getElementById('metadataToggleIcon');
        const text = document.getElementById('metadataToggleText');
        if (container.style.display === 'none') {
            container.style.display = 'block';
            icon.textContent = 'expand_less';
            text.textContent = 'Collapse Settings';
        } else {
            container.style.display = 'none';
            icon.textContent = 'expand_more';
            text.textContent = 'Expand Settings';
        }
    }

    function insertToken(token) {
        const textarea = document.getElementById('htmlTextarea');
        if (!textarea) return;
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        textarea.value = text.substring(0, start) + token + text.substring(end);
        textarea.selectionStart = textarea.selectionEnd = start + token.length;
        textarea.focus();
        updateCharCounts();
    }

    // Enable Tab key indent in all code textareas
    document.querySelectorAll('.code-textarea').forEach(ta => {
        ta.addEventListener('keydown', function(e) {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = this.selectionStart;
                const end = this.selectionEnd;

                if (start === end) {
                    // Single line indent
                    this.value = this.value.substring(0, start) + '    ' + this.value.substring(end);
                    this.selectionStart = this.selectionEnd = start + 4;
                } else {
                    // Multi-line indent or de-indent
                    const lines = this.value.substring(start, end).split('\n');
                    if (e.shiftKey) {
                        // De-indent
                        const modified = lines.map(line => line.startsWith('    ') ? line.substring(4) : (line.startsWith(' ') ? line.trimStart() : line)).join('\n');
                        this.value = this.value.substring(0, start) + modified + this.value.substring(end);
                    } else {
                        // Indent
                        const modified = lines.map(line => '    ' + line).join('\n');
                        this.value = this.value.substring(0, start) + modified + this.value.substring(end);
                    }
                    this.selectionStart = start;
                    this.selectionEnd = start + this.value.substring(start, end).length;
                }
                updateCharCounts();
            }
        });

        ta.addEventListener('input', updateCharCounts);
    });

    function updateCharCounts() {
        const htmlTa = document.getElementById('htmlTextarea');
        if (htmlTa) {
            document.getElementById('htmlCharCounter').textContent = htmlTa.value.length.toLocaleString() + ' characters';
        }
        const cssTa = document.getElementById('cssTextarea');
        if (cssTa) {
            document.getElementById('cssCharCounter').textContent = cssTa.value.length.toLocaleString() + ' characters';
        }
    }

    function formatJson() {
        const ta = document.getElementById('jsonTextarea');
        if (!ta || !ta.value.trim()) return;
        try {
            const parsed = JSON.parse(ta.value);
            ta.value = JSON.stringify(parsed, null, 4);
            alert('JSON formatted successfully!');
        } catch(err) {
            alert('Invalid JSON: ' + err.message);
        }
    }

    function formatCss() {
        const ta = document.getElementById('cssTextarea');
        if (!ta || !ta.value.trim()) return;
        let css = ta.value;
        css = css.replace(/\s*{\s*/g, ' {\n    ')
                 .replace(/;\s*/g, ';\n    ')
                 .replace(/\s*}\s*/g, '\n}\n\n')
                 .replace(/\n    \n/g, '\n');
        ta.value = css.trim();
    }

    // Init character counts
    updateCharCounts();
</script>

