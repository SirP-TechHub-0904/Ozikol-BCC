@page "/centralwks/templates/{id:guid}/edit"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Input.Name}";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

@section Styles {
<style>
    .edit-split-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 24px;
    }
    @@media (max-width: 1024px) {
        .edit-split-grid {
            grid-template-columns: 1fr;
        }
    }
    .form-group-block {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 18px;
    }
    .form-label-bold {
        font-size: 13px;
        font-weight: 600;
        color: var(--admin-text);
    }
    .form-input-styled {
        width: 100%;
        padding: 10px 14px;
        font-size: 13.5px;
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-md);
        background: var(--admin-bg-surface-elevated);
        color: var(--admin-text);
        outline: none;
        transition: var(--transition);
    }
    .form-input-styled:focus {
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px var(--admin-primary-light);
    }
    .form-textarea-styled {
        width: 100%;
        padding: 12px 14px;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 13px;
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-md);
        background: var(--admin-bg-surface-elevated);
        color: var(--admin-text);
        outline: none;
        resize: vertical;
        transition: var(--transition);
    }
    .form-textarea-styled:focus {
        border-color: var(--admin-border-focus);
        box-shadow: 0 0 0 3px var(--admin-primary-light);
    }
    .badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: var(--radius-full);
        font-size: 11.5px;
        font-weight: 600;
        text-transform: capitalize;
    }
    .badge-pill-primary { background: var(--admin-primary-light); color: var(--admin-primary); }

    /* Modal */
    .tweak-modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        z-index: 2000;
        align-items: center;
        justify-content: center;
    }
    .tweak-modal-overlay.is-active {
        display: flex;
    }
    .tweak-modal-box {
        width: 100%;
        max-width: 640px;
        background: var(--admin-bg-surface);
        border: 1px solid var(--admin-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
    }
</style>
}

<!-- Header -->
<div class="admin-page-header">
        <div class="admin-title-group">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <a href="/centralwks/templates/@Model.Input.Id" class="btn-admin btn-admin-secondary btn-admin-sm">
                    <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
                    Cancel &amp; Back
                </a>
                <span class="badge-pill badge-pill-primary">@Model.Input.CategoryKey</span>
            </div>
            <h1 class="admin-title">Edit Section: @Model.Input.Name</h1>
        </div>

        <div class="admin-actions">
            <button type="button" class="btn-admin btn-admin-secondary" onclick="openAiTweakModal()">
                <span class="material-symbols-outlined" style="color: var(--admin-indigo);">auto_awesome</span>
                AI Section Assistant
            </button>
        </div>
    </div>

    <!-- Edit Form -->
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Input.Id" />

        <div class="edit-split-grid">
            <!-- Left: Metadata -->
            <div class="admin-card" style="padding: 24px; height: fit-content;">
                <h3 style="font-size: 16px; font-weight: 700; color: var(--admin-text); margin-bottom: 20px;">Section Metadata</h3>

                <div class="form-group-block">
                    <label asp-for="Input.Name" class="form-label-bold">Display Name</label>
                    <input asp-for="Input.Name" class="form-input-styled" placeholder="e.g. Modern Split Hero" required />
                    <span asp-validation-for="Input.Name" style="color: var(--admin-danger); font-size: 12px;"></span>
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.VariantCode" class="form-label-bold">Variant Code (Unique)</label>
                    <input asp-for="Input.VariantCode" class="form-input-styled" style="font-family: monospace;" placeholder="e.g. hero_split_01" required />
                    <span asp-validation-for="Input.VariantCode" style="color: var(--admin-danger); font-size: 12px;"></span>
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.CategoryKey" class="form-label-bold">Category</label>
                    <select asp-for="Input.CategoryKey" class="form-input-styled">
                        <option value="menu">Menu / Nav</option>
                        <option value="hero">Hero Section</option>
                        <option value="bodysections">Body &amp; Features</option>
                        <option value="blog">Blog &amp; Cards</option>
                        <option value="contact">Contact</option>
                        <option value="footer">Footer</option>
                    </select>
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.Badge" class="form-label-bold">Badge (Optional)</label>
                    <input asp-for="Input.Badge" class="form-input-styled" placeholder="e.g. Popular, New, Pro" />
                </div>

                <div class="form-group-block">
                    <label asp-for="Input.Description" class="form-label-bold">Description</label>
                    <textarea asp-for="Input.Description" class="form-input-styled" rows="3" placeholder="Describe the purpose and layout of this section..."></textarea>
                </div>

                <button type="submit" class="btn-admin btn-admin-primary btn-admin-lg" style="width: 100%; margin-top: 10px;">
                    <span class="material-symbols-outlined">check_circle</span>
                    Save Changes
                </button>
            </div>

            <!-- Right: Code Blocks -->
            <div class="admin-card" style="overflow: hidden; display: flex; flex-direction: column;">
                <div style="display: flex; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                    <button type="button" class="btn-admin btn-admin-primary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="tabBtnHtml" onclick="switchEditorTab('html')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">html</span> HTML Template
                    </button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="tabBtnCss" onclick="switchEditorTab('css')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">css</span> Scoped CSS
                    </button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="tabBtnJson" onclick="switchEditorTab('json')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">data_object</span> Mock JSON
                    </button>
                    <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-radius: 0; padding: 12px 18px;" id="tabBtnJs" onclick="switchEditorTab('js')">
                        <span class="material-symbols-outlined" style="font-size: 16px;">javascript</span> JS Script
                    </button>
                </div>

                <div style="padding: 20px; flex: 1; background: var(--admin-bg);">
                    <!-- HTML Editor -->
                    <div id="editorPanelHtml">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Mustache-Parameterized Semantic HTML</label>
                        <textarea asp-for="Input.HtmlTemplate" id="editorHtml" class="form-textarea-styled" rows="20" placeholder="<section class='...'>...</section>" required></textarea>
                    </div>

                    <!-- Scoped CSS Editor -->
                    <div id="editorPanelCss" style="display:none;">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Scoped CSS Rules (Author Selectors)</label>
                        <textarea asp-for="Input.CssStyles" id="editorCss" class="form-textarea-styled" rows="20" placeholder=".header-area { ... }"></textarea>
                    </div>

                    <!-- Mock JSON Editor -->
                    <div id="editorPanelJson" style="display:none;">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Default Section Content Mock JSON</label>
                        <textarea asp-for="Input.DefaultSectionListsJson" id="editorJson" class="form-textarea-styled" rows="20" placeholder="[ { 'Title': 'Item 1' } ]"></textarea>
                    </div>

                    <!-- JS Script Editor -->
                    <div id="editorPanelJs" style="display:none;">
                        <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Optional Component JavaScript Logic</label>
                        <textarea asp-for="Input.JsScript" id="editorJs" class="form-textarea-styled" rows="20" placeholder="// Component JS logic"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- AI Tweak Modal -->
<div class="tweak-modal-overlay" id="aiTweakModal">
    <div class="tweak-modal-box">
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center; background: var(--admin-bg-surface-elevated);">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="material-symbols-outlined" style="font-size: 28px; color: var(--admin-indigo);">auto_awesome</span>
                <div>
                    <h4 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--admin-text);">AI Section Assistant</h4>
                    <p style="margin: 0; font-size: 12.5px; color: var(--admin-text-muted);">Provide plain-English instructions to refine the HTML, styling, or placeholders.</p>
                </div>
            </div>
            <button type="button" class="btn-admin-icon" onclick="closeAiTweakModal()">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div style="padding: 24px;">
            <label class="form-label-bold" style="margin-bottom: 8px; display: block;">Instructions for AI</label>
            <textarea class="form-textarea-styled" id="aiTweakPrompt" rows="5" placeholder="e.g. Add a secondary CTA button, adjust padding on mobile, or add a 3-column feature grid..."></textarea>
        </div>
        <div style="padding: 16px 24px; border-top: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center; background: var(--admin-bg-surface-elevated);">
            <button type="button" class="btn-admin btn-admin-secondary" onclick="closeAiTweakModal()">Cancel</button>
            <button type="button" class="btn-admin btn-admin-primary" id="btnExecuteAiTweak" onclick="runAiTweak()">
                <span class="material-symbols-outlined">magic_button</span> Apply AI Refinements
            </button>
        </div>
    </div>

@section Scripts {
    <script>
        function openAiTweakModal() {
            var m = document.getElementById('aiTweakModal');
            if (m) m.classList.add('is-active');
        }

        function closeAiTweakModal() {
            var m = document.getElementById('aiTweakModal');
            if (m) m.classList.remove('is-active');
        }

        function switchEditorTab(tab) {
            ['html', 'css', 'json', 'js'].forEach(function(t) {
                var btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
                var panel = document.getElementById('editorPanel' + t.charAt(0).toUpperCase() + t.slice(1));
                if (btn) {
                    btn.classList.remove('btn-admin-primary');
                    btn.classList.add('btn-admin-secondary');
                }
                if (panel) panel.style.display = 'none';
            });

            var activeBtn = document.getElementById('tabBtn' + tab.charAt(0).toUpperCase() + tab.slice(1));
            var activePanel = document.getElementById('editorPanel' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if (activeBtn) {
                activeBtn.classList.remove('btn-admin-secondary');
                activeBtn.classList.add('btn-admin-primary');
            }
            if (activePanel) activePanel.style.display = 'block';
        }

        async function runAiTweak() {
            var prompt = document.getElementById('aiTweakPrompt').value;
            if (!prompt) {
                alert('Please enter instructions for the AI.');
                return;
            }

            var btn = document.getElementById('btnExecuteAiTweak');
            btn.disabled = true;
            btn.innerHTML = '<span class="material-symbols-outlined" style="animation: spin 1s linear infinite;">sync</span> Refining...';

            var payload = {
                section_key: document.getElementById('Input_VariantCode').value,
                category_key: document.getElementById('Input_CategoryKey').value,
                title: document.getElementById('Input_Name').value,
                html_template: document.getElementById('editorHtml').value,
                scoped_css: document.getElementById('editorCss').value,
                user_prompt: prompt
            };

            try {
                var resp = await fetch('?handler=AiTweak', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(payload)
                });
                var result = await resp.json();
                if (result.success) {
                    if (result.html_template) document.getElementById('editorHtml').value = result.html_template;
                    if (result.scoped_css) document.getElementById('editorCss').value = result.scoped_css;
                    closeAiTweakModal();
                    alert('AI refinement applied successfully!');
                } else {
                    alert(result.error_message || 'AI tweak failed.');
                }
            } catch (err) {
                alert('Server error processing AI tweak.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<span class="material-symbols-outlined">magic_button</span> Apply AI Refinements';
            }
        }
    </script>
}
