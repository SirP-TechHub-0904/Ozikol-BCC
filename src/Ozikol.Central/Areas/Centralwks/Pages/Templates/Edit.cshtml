@page "{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.EditModel
@{
    ViewData["Title"] = $"Edit Template: {Model.Input.Name}";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

<!-- CodeMirror 5 Dependencies -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/material-darker.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.css" />

<style>
    .studio-hero-card {
        background: var(--admin-bg-surface, #ffffff);
        border: 1px solid var(--admin-border, rgba(0, 0, 0, 0.08));
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.04));
    }
    .studio-tab-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--admin-bg-surface-elevated, #f8fafc);
        border: 1px solid var(--admin-border, rgba(0, 0, 0, 0.08));
        border-bottom: none;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        padding: 8px 14px;
        flex-wrap: wrap;
        gap: 10px;
    }
    .studio-tab-group {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        align-items: center;
    }
    .studio-tab-btn {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--admin-text-muted, #64748b);
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
        transition: all 0.18s ease;
    }
    .studio-tab-btn:hover {
        background: rgba(0, 0, 0, 0.04);
        color: var(--admin-text, #0f172a);
    }
    .studio-tab-btn.active {
        background: #ffffff;
        color: var(--admin-text, #0f172a);
        border-color: rgba(0, 0, 0, 0.08);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }
    .tab-badge {
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        padding: 2px 7px;
        border-radius: 6px;
        background: var(--admin-bg-surface-elevated, #f1f5f9);
        color: var(--admin-text-muted, #64748b);
        font-weight: 500;
    }
    .studio-tab-btn.active .tab-badge {
        background: #eff6ff;
        color: #2563eb;
    }
    .studio-editor-pane {
        display: none;
        background: #0b1120;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        padding: 16px;
    }
    .studio-editor-pane.active {
        display: block;
    }
    .studio-settings-pane {
        display: none;
        background: var(--admin-bg-surface, #ffffff);
        border: 1px solid var(--admin-border, rgba(0, 0, 0, 0.08));
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        padding: 24px;
    }
    .studio-settings-pane.active {
        display: block;
    }
    .CodeMirror {
        height: 520px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 13px;
        line-height: 1.6;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .token-chip-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        padding: 10px 14px;
        background: #020617;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        margin-bottom: 12px;
    }
    .token-chip {
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);
        color: #38bdf8;
        padding: 3px 8px;
        border-radius: 6px;
        font-family: monospace;
        font-size: 11px;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }
    .token-chip:hover {
        background: rgba(56, 189, 248, 0.25);
        border-color: #38bdf8;
        color: #fff;
    }
    .height-btn {
        background: var(--admin-bg-surface, #ffffff);
        border: 1px solid var(--admin-border, rgba(0, 0, 0, 0.1));
        color: var(--admin-text-muted, #64748b);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.15s ease;
    }
    .height-btn:hover {
        background: var(--admin-bg-hover, #e2e8f0);
        color: var(--admin-text, #0f172a);
    }
    .height-btn.active {
        background: var(--admin-primary-light, rgba(229, 23, 63, 0.1));
        color: var(--admin-primary, #e5173f);
        border-color: var(--admin-primary, #e5173f);
    }
    .sample-repeater-card {
        background: #020617;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.15s ease;
    }
    .sample-repeater-card:hover {
        border-color: rgba(56, 189, 248, 0.3);
    }
    .sample-form-control {
        width: 100%;
        background: #090e1a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        padding: 8px 12px;
        color: #f1f5f9;
        font-size: 12.5px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s ease;
    }
    .sample-form-control:focus {
        border-color: #38bdf8;
    }
    .sample-view-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--admin-text-muted, #94a3b8);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.15s ease;
    }
    .sample-view-btn:hover {
        color: #f1f5f9;
    }
    .sample-view-btn.active {
        background: rgba(5, 150, 105, 0.2);
        color: #34d399;
        border-color: rgba(5, 150, 105, 0.4);
    }
    .settings-section-card {
        background: var(--admin-bg-surface-elevated, #f8fafc);
        border: 1px solid var(--admin-border, rgba(0,0,0,0.08));
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 20px;
    }
    .settings-section-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--admin-text, #0f172a);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<form method="post" id="templateEditForm">
    @Html.AntiForgeryToken()

    @* ── Top Breadcrumb Navigation ── *@
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 8px; font-size: 13px;">
            <a href="/centralwks/templates" style="color: var(--admin-text-muted, #64748b); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-weight: 500;">
                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span> Back to Templates
            </a>
            <span style="color: var(--admin-border, rgba(0,0,0,0.15));">/</span>
            <span style="color: var(--admin-text-muted, #64748b);">Marketplace</span>
            <span style="color: var(--admin-border, rgba(0,0,0,0.15));">/</span>
            <span style="color: var(--admin-text, #0f172a); font-weight: 600;">@Model.Input.VariantCode</span>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <a href="/centralwks/templates/details/@Model.Id" class="btn-admin btn-admin-secondary btn-admin-sm" style="display: inline-flex; align-items: center; gap: 6px;">
                <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span> Live Preview & Inspect
            </a>
            <button type="submit" class="btn-admin btn-admin-primary btn-admin-sm" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; padding: 8px 18px;">
                <span class="material-symbols-outlined" style="font-size: 16px;">save</span> Save Modifications
            </button>
        </div>
    </div>

    @* ── Compact Identity Hero Header ── *@
    <div class="studio-hero-card">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(37, 99, 235, 0.1); color: #2563eb; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <span class="material-symbols-outlined" style="font-size: 26px;">code_blocks</span>
            </div>
            <div>
                <h1 style="font-size: 20px; font-weight: 800; color: var(--admin-text, #0f172a); margin: 0 0 6px 0; line-height: 1.2;">@Model.Input.Name</h1>
                <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <span style="font-family: monospace; font-size: 11px; padding: 2px 8px; border-radius: 4px; background: rgba(37,99,235,0.1); color: #2563eb; font-weight: 700;">@Model.Input.VariantCode</span>
                    <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: var(--admin-bg-surface-elevated, #f1f5f9); color: var(--admin-text-muted, #64748b); font-weight: 600;">v@(Model.Input.Version)</span>
                    <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: var(--admin-bg-surface-elevated, #f1f5f9); color: var(--admin-text-muted, #64748b); text-transform: uppercase;">@Model.Input.Tag</span>
                    <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: @(Model.Input.IsActive ? "rgba(5,150,105,0.1)" : "rgba(100,116,139,0.1)"); color: @(Model.Input.IsActive ? "#059669" : "#64748b"); font-weight: 600;">
                        @(Model.Input.IsActive ? "Active & Published" : "Draft / Hidden")
                    </span>
                </div>
            </div>
        </div>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 20px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    @* ── Full-Width 5-Tab Studio Workspace ── *@
    <div style="margin-bottom: 30px;">
        <div class="studio-tab-bar">
            <div class="studio-tab-group">
                <button type="button" class="studio-tab-btn active" onclick="switchStudioTab('html', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #0284c7;">code</span>
                    Semantic HTML
                    <span class="tab-badge" id="htmlTabBadge">HTML</span>
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('css', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #7c3aed;">palette</span>
                    Scoped CSS
                    <span class="tab-badge" id="cssTabBadge">CSS</span>
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('js', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #d97706;">javascript</span>
                    JavaScript
                    <span class="tab-badge">JS</span>
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('sample', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #059669;">dataset</span>
                    Sample Data
                    <span class="tab-badge" id="sampleItemsCountBadge">0 Items</span>
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('settings', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #475569;">tune</span>
                    Blueprint Settings
                    <span class="tab-badge">Config</span>
                </button>
            </div>

            <div id="editorHeightControls" style="display: flex; gap: 6px; align-items: center; padding: 4px 0;">
                <span style="font-size: 11px; color: var(--admin-text-muted); margin-right: 4px;">Editor Height:</span>
                <button type="button" class="height-btn" onclick="setEditorHeight(320, this)" title="Minimise Editor View">
                    <span class="material-symbols-outlined" style="font-size: 14px;">compress</span> Compact
                </button>
                <button type="button" class="height-btn active" onclick="setEditorHeight(520, this)" title="Standard Editor View">
                    <span class="material-symbols-outlined" style="font-size: 14px;">aspect_ratio</span> Standard
                </button>
                <button type="button" class="height-btn" onclick="setEditorHeight(780, this)" title="Expand Full Height">
                    <span class="material-symbols-outlined" style="font-size: 14px;">expand</span> Expanded
                </button>
            </div>
        </div>

        @* ── Tab 1: HTML Editor ── *@
        <div id="studio-pane-html" class="studio-editor-pane active">
            <div class="token-chip-bar">
                <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">Insert Token:</span>
                <span class="token-chip" onclick="insertToken('{{ Title }}')">{{ Title }}</span>
                <span class="token-chip" onclick="insertToken('{{ Subtitle }}')">{{ Subtitle }}</span>
                <span class="token-chip" onclick="insertToken('{{ MiniTitle }}')">{{ MiniTitle }}</span>
                <span class="token-chip" onclick="insertToken('{{ Description }}')">{{ Description }}</span>
                <span class="token-chip" onclick="insertToken('{{ ImageUrl }}')">{{ ImageUrl }}</span>
                <span class="token-chip" onclick="insertToken('{{ ButtonText }}')">{{ ButtonText }}</span>
                <span class="token-chip" onclick="insertToken('{{ ButtonUrl }}')">{{ ButtonUrl }}</span>
                <span class="token-chip" onclick="insertToken('{{ IconName }}')">{{ IconName }}</span>
                <span class="token-chip" onclick="insertSectionSnippet()">{{#each SectionLists}}...{{/each}}</span>
            </div>

            <textarea asp-for="Input.HtmlTemplate" id="htmlEditorTextarea"></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                <span asp-validation-for="Input.HtmlTemplate" class="text-danger" style="font-size: 12px; color: var(--admin-danger);"></span>
                <span id="htmlCharCounter" style="font-size: 11px; font-family: monospace; color: #94a3b8;">0 characters</span>
            </div>
        </div>

        @* ── Tab 2: CSS Editor ── *@
        <div id="studio-pane-css" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 12px; color: #a78bfa; font-weight: 600;">Scoped CSS Stylesheet (Isolated to component scope)</span>
                <button type="button" class="height-btn" onclick="formatCss()">
                    <span class="material-symbols-outlined" style="font-size: 14px;">format_align_left</span> Auto Format
                </button>
            </div>
            <textarea asp-for="Input.CssStyles" id="cssEditorTextarea"></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                <span asp-validation-for="Input.CssStyles" class="text-danger" style="font-size: 12px; color: var(--admin-danger);"></span>
                <span id="cssCharCounter" style="font-size: 11px; font-family: monospace; color: #94a3b8;">0 characters</span>
            </div>
        </div>

        @* ── Tab 3: JS Editor ── *@
        <div id="studio-pane-js" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 12px; color: #facc15;">Client-Side JavaScript execution logic. Runs in isolated container upon hydration.</span>
            </div>
            <textarea asp-for="Input.JsScript" id="jsEditorTextarea"></textarea>
        </div>

        @* ── Tab 4: Sample Data (Visual Form + Raw JSON Editor) ── *@
        <div id="studio-pane-sample" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: #34d399; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;">Sample Data Items</span>
                    <span style="font-size: 12px; color: #94a3b8;">— Used to populate repeating lists and preview mock content</span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <div style="display: inline-flex; background: #020617; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 2px;">
                        <button type="button" id="btnSampleModeForm" class="sample-view-btn active" onclick="switchSampleMode('form')">
                            <span class="material-symbols-outlined" style="font-size: 14px;">list_alt</span> Visual Form
                        </button>
                        <button type="button" id="btnSampleModeJson" class="sample-view-btn" onclick="switchSampleMode('json')">
                            <span class="material-symbols-outlined" style="font-size: 14px;">data_object</span> Raw JSON
                        </button>
                    </div>
                    <button type="button" id="btnAddSampleItemBtn" class="height-btn" onclick="addNewSampleItem()" style="background: #059669; color: #ffffff; border-color: #059669; font-weight: 600;">
                        <span class="material-symbols-outlined" style="font-size: 14px;">add</span> Add Item
                    </button>
                </div>
            </div>

            <!-- Visual Form Mode -->
            <div id="sampleVisualFormContainer">
                <div id="sampleItemsRepeaterList"></div>
                <div id="noSampleItemsMsg" style="display: none; text-align: center; padding: 40px 20px; background: #020617; border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px;">
                    <span class="material-symbols-outlined" style="font-size: 36px; color: #64748b; margin-bottom: 8px; display: block;">dataset</span>
                    <div style="font-weight: 600; font-size: 14px; color: #cbd5e1; margin-bottom: 4px;">No Sample Data Configured</div>
                    <p style="font-size: 12.5px; color: #64748b; margin-bottom: 16px;">This template variant currently has no default repeating child items.</p>
                    <button type="button" class="btn-admin btn-admin-primary" onclick="addNewSampleItem()" style="font-size: 12px; padding: 6px 14px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">add</span> Add First Sample Item
                    </button>
                </div>
            </div>

            <!-- Raw JSON Mode -->
            <div id="sampleRawJsonContainer" style="display: none;">
                <div style="display: flex; justify-content: flex-end; margin-bottom: 8px;">
                    <button type="button" class="height-btn" onclick="formatSampleJson()">
                        <span class="material-symbols-outlined" style="font-size: 14px;">data_object</span> Format JSON
                    </button>
                </div>
                <textarea asp-for="Input.DefaultSectionListsJson" id="jsonEditorTextarea"></textarea>
            </div>
        </div>

        @* ── Tab 5: Blueprint Settings & Parameters ── *@
        <div id="studio-pane-settings" class="studio-settings-pane">
            <div class="settings-section-card">
                <div class="settings-section-title">
                    <span class="material-symbols-outlined" style="color: var(--admin-primary); font-size: 18px;">badge</span>
                    Template Identity & Categorization
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
                    <div class="form-group">
                        <label asp-for="Input.Name" class="form-label">
                            Template Name <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="Input.Name" class="form-control" placeholder="e.g. Strategies and Insights" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.VariantCode" class="form-label">
                            Programmatic Variant Code <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="Input.VariantCode" class="form-control" style="font-family: monospace; color: #0284c7; font-weight: 600;" placeholder="e.g. BLOG_10" />
                        <span asp-validation-for="Input.VariantCode" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.CategoryId" class="form-label">
                            Category <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" class="form-select"></select>
                        <span asp-validation-for="Input.CategoryId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Tag" class="form-label">Style Classification</label>
                        <select asp-for="Input.Tag" class="form-select">
                            <option value="modern">Modern & Clean</option>
                            <option value="dark">Dark & Futuristic</option>
                            <option value="minimal">Minimalist</option>
                            <option value="corporate">Corporate & Enterprise</option>
                            <option value="ecommerce">E-Commerce</option>
                            <option value="creative">Creative & Portfolio</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="settings-section-card">
                <div class="settings-section-title">
                    <span class="material-symbols-outlined" style="color: #7c3aed; font-size: 18px;">description</span>
                    Blueprint Description & Release Control
                </div>
                <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                    <div class="form-group">
                        <label asp-for="Input.Description" class="form-label">Short Summary Description</label>
                        <input asp-for="Input.Description" class="form-control" placeholder="e.g. Developing personalized customer journeys..." />
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Version" class="form-label">Version</label>
                        <input asp-for="Input.Version" class="form-control" style="font-family: monospace;" placeholder="e.g. 1.0.0" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.SortOrder" class="form-label">Display Sort Order</label>
                        <input asp-for="Input.SortOrder" type="number" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Badge" class="form-label">Badge Label (Optional)</label>
                        <input asp-for="Input.Badge" class="form-control" placeholder="e.g. New" />
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 8px; padding-top: 6px;">
                    <input asp-for="Input.IsActive" type="checkbox" id="chkIsActive" style="width: 18px; height: 18px; accent-color: var(--admin-primary); cursor: pointer;" />
                    <label for="chkIsActive" style="font-size: 13.5px; font-weight: 600; color: #059669; cursor: pointer; margin: 0;">
                        Active & Published in Marketplace Catalog
                    </label>
                </div>
            </div>

