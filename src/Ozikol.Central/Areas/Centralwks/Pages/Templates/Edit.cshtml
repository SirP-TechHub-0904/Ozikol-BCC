@page "{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.EditModel
@{
    ViewData["Title"] = $"Edit Template: {Model.Input.Name}";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Edit Template: @Model.Input.Name</h1>
        <p class="admin-subtitle">Modify blueprint markup, scoped stylesheets, preview presentation card, and publishing status.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/templates/details/@Model.Id" class="btn-admin btn-admin-secondary">
            <span>👁️</span> View Details & Code
        </a>
        <a href="/centralwks/templates" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Templates
        </a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 24px;">
        @* ── Left: Main Identity & Markup ── *@
        <div>
            <div class="admin-card" style="margin-bottom: 24px;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">🎨</div>
                    <div>
                        <h3 class="card-header-title">Identity & Categorization</h3>
                        <p class="card-header-subtitle">Basic metadata, variant key, and category placement.</p>
                    </div>
                </div>

                <div style="padding: 24px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div class="form-group">
                            <label asp-for="Input.Name" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Template Name <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                            </label>
                            <input asp-for="Input.Name" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                            <span asp-validation-for="Input.Name" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.VariantCode" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Programmatic Variant Code <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                            </label>
                            <input asp-for="Input.VariantCode" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px; font-family: monospace;" />
                            <span asp-validation-for="Input.VariantCode" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div class="form-group">
                            <label asp-for="Input.CategoryId" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Category <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                            </label>
                            <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                            </select>
                            <span asp-validation-for="Input.CategoryId" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Tag" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Style Tag
                            </label>
                            <select asp-for="Input.Tag" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                                <option value="modern">Modern & Clean</option>
                                <option value="dark">Dark & Futuristic</option>
                                <option value="minimal">Minimalist</option>
                                <option value="corporate">Corporate & Enterprise</option>
                                <option value="ecommerce">E-Commerce</option>
                                <option value="creative">Creative & Portfolio</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 8px;">
                        <label asp-for="Input.Description" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Template Description
                        </label>
                        <textarea asp-for="Input.Description" rows="2" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;"></textarea>
                    </div>
                </div>
            </div>

            @* ── Code Markup Tabs ── *@
            <div class="admin-card" style="margin-bottom: 24px;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">💻</div>
                    <div>
                        <h3 class="card-header-title">Template Code & Stylesheets</h3>
                        <p class="card-header-subtitle">Semantic markup with Mustache tokens, isolated CSS rules, and client scripts.</p>
                    </div>
                </div>

                <div style="padding: 24px;">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label asp-for="Input.HtmlTemplate" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Semantic HTML Template (Mustache Syntax) <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                        </label>
                        <textarea asp-for="Input.HtmlTemplate" rows="10" class="form-control" style="width: 100%; background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 8px; padding: 12px 14px; color: #38bdf8; font-family: monospace; font-size: 13px; line-height: 1.5; tab-size: 4;"></textarea>
                        <span asp-validation-for="Input.HtmlTemplate" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label asp-for="Input.CssStyles" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Scoped CSS Styles <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                        </label>
                        <textarea asp-for="Input.CssStyles" rows="8" class="form-control" style="width: 100%; background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 8px; padding: 12px 14px; color: #a78bfa; font-family: monospace; font-size: 13px; line-height: 1.5; tab-size: 4;"></textarea>
                        <span asp-validation-for="Input.CssStyles" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label asp-for="Input.JsScript" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Sandboxed Client JavaScript (Optional)
                        </label>
                        <textarea asp-for="Input.JsScript" rows="5" class="form-control" style="width: 100%; background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 8px; padding: 12px 14px; color: #facc15; font-family: monospace; font-size: 13px; line-height: 1.5; tab-size: 4;"></textarea>
                    </div>

                    <div class="form-group" style="margin-bottom: 8px;">
                        <label asp-for="Input.DefaultSectionListsJson" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Default Section List Mock Items (JSON)
                        </label>
                        <textarea asp-for="Input.DefaultSectionListsJson" rows="4" class="form-control" style="width: 100%; background: #0b1120; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 8px; padding: 12px 14px; color: #4ade80; font-family: monospace; font-size: 13px; line-height: 1.5; tab-size: 4;"></textarea>
                    </div>
                </div>
            </div>
        </div>

        @* ── Right: Preview & Configuration ── *@
        <div>
            <div class="admin-card" style="margin-bottom: 24px;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">🖼️</div>
                    <div>
                        <h3 class="card-header-title">Marketplace Card Preview</h3>
                        <p class="card-header-subtitle">Card parameters and thumbnail appearance.</p>
                    </div>
                </div>

                <div style="padding: 20px;">
                    <div class="form-group" style="margin-bottom: 16px;">
                        <label asp-for="Input.ThumbnailGradient" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Thumbnail Gradient (CSS)
                        </label>
                        <input asp-for="Input.ThumbnailGradient" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px; font-family: monospace;" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                        <div class="form-group">
                            <label asp-for="Input.PreviewIcon" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Icon / Emoji
                            </label>
                            <input asp-for="Input.PreviewIcon" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Badge" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Badge (Optional)
                            </label>
                            <input asp-for="Input.Badge" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label asp-for="Input.PreviewTitle" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Preview Title
                        </label>
                        <input asp-for="Input.PreviewTitle" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
                    </div>

                    <div class="form-group" style="margin-bottom: 16px;">
                        <label asp-for="Input.PreviewImageUrl" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                            Demo Image URL (Optional)
                        </label>
                        <input asp-for="Input.PreviewImageUrl" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
                    </div>
                </div>
            </div>

            <div class="admin-card" style="margin-bottom: 24px;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">⚙️</div>
                    <div>
                        <h3 class="card-header-title">Publishing & Version</h3>
                        <p class="card-header-subtitle">Release settings and sorting.</p>
                    </div>
                </div>

                <div style="padding: 20px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                        <div class="form-group">
                            <label asp-for="Input.Version" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Version
                            </label>
                            <input asp-for="Input.Version" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px; font-family: monospace;" />
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.SortOrder" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                                Sort Order
                            </label>
                            <input asp-for="Input.SortOrder" type="number" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
                        </div>
                    </div>

                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding-top: 4px;">
                        <input asp-for="Input.IsActive" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--admin-primary);" />
                        <span style="font-size: 14px; color: #fff;">Active & Published in Marketplace</span>
                    </label>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button type="submit" class="btn-admin btn-admin-primary" style="justify-content: center; width: 100%;">
                    <span>💾</span> Save Modifications
                </button>
                <a href="/centralwks/templates" class="btn-admin btn-admin-secondary" style="justify-content: center; width: 100%;">
                    Cancel
                </a>
            </div>
        </div>
    </div>
</form>
