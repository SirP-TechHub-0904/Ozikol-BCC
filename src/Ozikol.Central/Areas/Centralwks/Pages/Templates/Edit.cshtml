@page "{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Templates.EditModel
@{
    ViewData["Title"] = $"Edit Template: {Model.Input.Name}";
    ViewData["BreadcrumbSection"] = "Marketplace";
}

<!-- CodeMirror 5 Dependencies -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/material-darker.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.css" />

<style>
    .studio-header-card {
        background: var(--admin-bg-surface, #ffffff);
        border: 1px solid var(--admin-border, rgba(0, 0, 0, 0.08));
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 20px;
        box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.04));
    }
    .studio-tab-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--admin-bg-surface-elevated, #f8fafc);
        border: 1px solid var(--admin-border, rgba(0, 0, 0, 0.08));
        border-bottom: none;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        padding: 6px 14px;
        flex-wrap: wrap;
        gap: 8px;
    }
    .studio-tab-group {
        display: flex;
        gap: 6px;
        overflow-x: auto;
    }
    .studio-tab-btn {
        background: transparent;
        border: 1px solid transparent;
        border-radius: 8px;
        color: var(--admin-text-muted, #64748b);
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        transition: all 0.18s ease;
    }
    .studio-tab-btn:hover {
        background: rgba(0, 0, 0, 0.04);
        color: var(--admin-text, #0f172a);
    }
    .studio-tab-btn.active {
        background: #ffffff;
        color: var(--admin-text, #0f172a);
        border-color: rgba(0, 0, 0, 0.08);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }
    .tab-badge {
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        padding: 2px 7px;
        border-radius: 6px;
        background: var(--admin-bg-surface-elevated, #f1f5f9);
        color: var(--admin-text-muted, #64748b);
        font-weight: 500;
    }
    .studio-tab-btn.active .tab-badge {
        background: #eff6ff;
        color: #2563eb;
    }
    .studio-editor-pane {
        display: none;
        background: #0b1120;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        padding: 16px;
    }
    .studio-editor-pane.active {
        display: block;
    }
    .CodeMirror {
        height: 520px;
        font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
        font-size: 13px;
        line-height: 1.6;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .token-chip-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        padding: 10px 14px;
        background: #020617;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        margin-bottom: 12px;
    }
    .token-chip {
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.25);
        color: #38bdf8;
        padding: 3px 8px;
        border-radius: 6px;
        font-family: monospace;
        font-size: 11px;
        cursor: pointer;
        transition: all 0.15s ease;
        user-select: none;
    }
    .token-chip:hover {
        background: rgba(56, 189, 248, 0.25);
        border-color: #38bdf8;
        color: #fff;
    }
    .height-btn {
        background: var(--admin-bg-surface, #ffffff);
        border: 1px solid var(--admin-border, rgba(0, 0, 0, 0.1));
        color: var(--admin-text-muted, #64748b);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.15s ease;
    }
    .height-btn:hover {
        background: var(--admin-bg-hover, #e2e8f0);
        color: var(--admin-text, #0f172a);
    }
    .height-btn.active {
        background: var(--admin-primary-light, rgba(229, 23, 63, 0.1));
        color: var(--admin-primary, #e5173f);
        border-color: var(--admin-primary, #e5173f);
    }
    .sample-repeater-card {
        background: #020617;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.15s ease;
    }
    .sample-repeater-card:hover {
        border-color: rgba(56, 189, 248, 0.3);
    }
    .sample-form-control {
        width: 100%;
        background: #090e1a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        padding: 8px 12px;
        color: #f1f5f9;
        font-size: 12.5px;
        font-family: inherit;
        outline: none;
        transition: border-color 0.15s ease;
    }
    .sample-form-control:focus {
        border-color: #38bdf8;
    }
    .sample-view-btn {
        background: transparent;
        border: 1px solid transparent;
        color: var(--admin-text-muted, #94a3b8);
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.15s ease;
    }
    .sample-view-btn:hover {
        color: #f1f5f9;
    }
    .sample-view-btn.active {
        background: rgba(5, 150, 105, 0.2);
        color: #34d399;
        border-color: rgba(5, 150, 105, 0.4);
    }
</style>

<form method="post" id="templateEditForm">
    @Html.AntiForgeryToken()

    @* ── Studio Top Action & Title Header ── *@
    <div class="admin-page-header">
        <div class="admin-title-group">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; font-size: 13px;">
                <a href="/centralwks/templates" style="color: var(--admin-text-muted, #64748b); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-weight: 500;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span> Back to Templates
                </a>
                <span style="color: var(--admin-border, rgba(0,0,0,0.15));">/</span>
                <span style="color: var(--admin-text-muted, #64748b);">Marketplace</span>
                <span style="color: var(--admin-border, rgba(0,0,0,0.15));">/</span>
                <span style="color: var(--admin-text, #0f172a); font-weight: 600;">@Model.Input.VariantCode</span>
            </div>
            <h1 class="admin-title">Template Studio: @Model.Input.Name</h1>
            <p class="admin-subtitle">Interactive code editor with live syntax highlighting, token hydration, and sample data repeater.</p>
        </div>
        <div class="admin-actions" style="display: flex; gap: 10px; align-items: center;">
            <a href="/centralwks/templates/details/@Model.Id" class="btn-admin btn-admin-secondary" style="display: inline-flex; align-items: center; gap: 6px;">
                <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span> Live Preview & Inspect
            </a>
            <a href="/centralwks/templates" class="btn-admin btn-admin-secondary">
                Cancel
            </a>
            <button type="submit" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 6px; font-weight: 700; padding: 10px 22px;">
                <span class="material-symbols-outlined" style="font-size: 18px;">save</span> Save Modifications
            </button>
        </div>
    </div>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    @* ── Compact Identity & Blueprint Metadata Bar ── *@
    <div class="studio-header-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; border-bottom: 1px solid var(--admin-border, rgba(0, 0, 0, 0.08)); padding-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-outlined" style="color: var(--admin-primary, #e5173f); font-size: 20px;">tune</span>
                <span style="font-size: 14px; font-weight: 700; color: var(--admin-text, #0f172a); text-transform: uppercase; letter-spacing: 0.03em;">Blueprint Parameters & Identity</span>
            </div>
            <button type="button" class="height-btn" onclick="toggleMetadataBar(this)">
                <span id="metadataToggleIcon" class="material-symbols-outlined" style="font-size: 16px;">expand_less</span>
                <span id="metadataToggleText">Collapse Settings</span>
            </button>
        </div>

        <div id="metadataFieldsContainer">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 16px;">
                <div class="form-group">
                    <label asp-for="Input.Name" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Template Name <span style="color: var(--admin-danger);">*</span>
                    </label>
                    <input asp-for="Input.Name" class="form-control" placeholder="e.g. Strategies and Insights" />
                    <span asp-validation-for="Input.Name" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.VariantCode" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Programmatic Variant Code <span style="color: var(--admin-danger);">*</span>
                    </label>
                    <input asp-for="Input.VariantCode" class="form-control" style="font-family: monospace; color: #0284c7;" placeholder="e.g. BLOG_10" />
                    <span asp-validation-for="Input.VariantCode" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.CategoryId" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Category <span style="color: var(--admin-danger);">*</span>
                    </label>
                    <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" class="form-select"></select>
                    <span asp-validation-for="Input.CategoryId" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Tag" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Style Classification
                    </label>
                    <select asp-for="Input.Tag" class="form-select">
                        <option value="modern">Modern & Clean</option>
                        <option value="dark">Dark & Futuristic</option>
                        <option value="minimal">Minimalist</option>
                        <option value="corporate">Corporate & Enterprise</option>
                        <option value="ecommerce">E-Commerce</option>
                        <option value="creative">Creative & Portfolio</option>
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div class="form-group">
                    <label asp-for="Input.Description" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Short Summary Description
                    </label>
                    <input asp-for="Input.Description" class="form-control" placeholder="e.g. Developing personalized customer journeys to increase satisfaction." />
                </div>

                <div class="form-group">
                    <label asp-for="Input.Version" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Version
                    </label>
                    <input asp-for="Input.Version" class="form-control" style="font-family: monospace;" placeholder="e.g. 1.0.0" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.SortOrder" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Display Sort Order
                    </label>
                    <input asp-for="Input.SortOrder" type="number" class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.Badge" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Badge (Optional)
                    </label>
                    <input asp-for="Input.Badge" class="form-control" placeholder="e.g. New" />
                </div>

                <div class="form-group" style="display: flex; flex-direction: column; justify-content: flex-end;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding-bottom: 10px;">
                        <input asp-for="Input.IsActive" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--admin-primary);" />
                        <span style="font-size: 13px; font-weight: 600; color: #059669;">Active & Published</span>
                    </label>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
                <div class="form-group">
                    <label asp-for="Input.PreviewTitle" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Preview Title Override (Optional)
                    </label>
                    <input asp-for="Input.PreviewTitle" class="form-control" placeholder="e.g. Default title in builder" />
                </div>

                <div class="form-group">
                    <label asp-for="Input.PreviewImageUrl" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Demo Image URL (Optional)
                    </label>
                    <input asp-for="Input.PreviewImageUrl" class="form-control" placeholder="https://..." />
                </div>

                <div class="form-group">
                    <label asp-for="Input.ThumbnailGradient" class="form-label" style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 12px; color: var(--admin-text-muted);">
                        Thumbnail Gradient (CSS)
                    </label>
                    <input asp-for="Input.ThumbnailGradient" class="form-control" style="font-family: monospace;" placeholder="linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)" />
                </div>
            </div>
        </div>
    </div>

    @* ── Full-Width Tabbed Code Studio ── *@
    <div style="margin-bottom: 30px;">
        <div class="studio-tab-bar">
            <div class="studio-tab-group">
                <button type="button" class="studio-tab-btn active" onclick="switchStudioTab('html', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #0284c7;">code</span>
                    Semantic HTML
                    <span class="tab-badge" id="htmlTabBadge">HTML</span>
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('css', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #7c3aed;">palette</span>
                    Scoped CSS
                    <span class="tab-badge" id="cssTabBadge">CSS</span>
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('js', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #d97706;">javascript</span>
                    JavaScript
                    <span class="tab-badge">JS</span>
                </button>
                <button type="button" class="studio-tab-btn" onclick="switchStudioTab('sample', this)">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #059669;">dataset</span>
                    Sample Data
                    <span class="tab-badge" id="sampleItemsCountBadge">0 Items</span>
                </button>
            </div>

            <div style="display: flex; gap: 6px; align-items: center; padding: 4px 0;">
                <span style="font-size: 11px; color: var(--admin-text-muted); margin-right: 4px;">Editor Height:</span>
                <button type="button" class="height-btn" onclick="setEditorHeight(320, this)" title="Minimise Editor View">
                    <span class="material-symbols-outlined" style="font-size: 14px;">compress</span> Compact
                </button>
                <button type="button" class="height-btn active" onclick="setEditorHeight(520, this)" title="Standard Editor View">
                    <span class="material-symbols-outlined" style="font-size: 14px;">aspect_ratio</span> Standard
                </button>
                <button type="button" class="height-btn" onclick="setEditorHeight(780, this)" title="Expand Full Height">
                    <span class="material-symbols-outlined" style="font-size: 14px;">expand</span> Expanded
                </button>
            </div>
        </div>

        @* ── Tab 1: HTML Editor ── *@
        <div id="studio-pane-html" class="studio-editor-pane active">
            <div class="token-chip-bar">
                <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">Insert Token:</span>
                <span class="token-chip" onclick="insertToken('{{ Title }}')">{{ Title }}</span>
                <span class="token-chip" onclick="insertToken('{{ Subtitle }}')">{{ Subtitle }}</span>
                <span class="token-chip" onclick="insertToken('{{ MiniTitle }}')">{{ MiniTitle }}</span>
                <span class="token-chip" onclick="insertToken('{{ Description }}')">{{ Description }}</span>
                <span class="token-chip" onclick="insertToken('{{ ImageUrl }}')">{{ ImageUrl }}</span>
                <span class="token-chip" onclick="insertToken('{{ ButtonText }}')">{{ ButtonText }}</span>
                <span class="token-chip" onclick="insertToken('{{ ButtonUrl }}')">{{ ButtonUrl }}</span>
                <span class="token-chip" onclick="insertToken('{{#each SectionLists}}\n    <div class=\"item\">\n        <h3>{{ Title }}</h3>\n        <p>{{ Description }}</p>\n    </div>\n{{/each}}')">{{#each SectionLists}}...{{/each}}</span>
                <span class="token-chip" onclick="insertToken('{{ IconName }}')">{{ IconName }}</span>
            </div>

            <textarea asp-for="Input.HtmlTemplate" id="htmlEditorTextarea"></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                <span asp-validation-for="Input.HtmlTemplate" class="text-danger" style="font-size: 12px; color: var(--admin-danger);"></span>
                <span id="htmlCharCounter" style="font-size: 11px; font-family: monospace; color: #94a3b8;">0 characters</span>
            </div>
        </div>

        @* ── Tab 2: CSS Editor ── *@
        <div id="studio-pane-css" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 12px; color: #a78bfa; font-weight: 600;">Scoped CSS Stylesheet (Isolated to component scope)</span>
                <button type="button" class="height-btn" onclick="formatCss()">
                    <span class="material-symbols-outlined" style="font-size: 14px;">format_align_left</span> Auto Format
                </button>
            </div>
            <textarea asp-for="Input.CssStyles" id="cssEditorTextarea"></textarea>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
                <span asp-validation-for="Input.CssStyles" class="text-danger" style="font-size: 12px; color: var(--admin-danger);"></span>
                <span id="cssCharCounter" style="font-size: 11px; font-family: monospace; color: #94a3b8;">0 characters</span>
            </div>
        </div>

        @* ── Tab 3: JS Editor ── *@
        <div id="studio-pane-js" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <span style="font-size: 12px; color: #facc15;">Client-Side JavaScript execution logic. Runs in isolated container upon hydration.</span>
            </div>
            <textarea asp-for="Input.JsScript" id="jsEditorTextarea"></textarea>
        </div>

        @* ── Tab 4: Sample Data (Visual Form + Raw JSON Editor) ── *@
        <div id="studio-pane-sample" class="studio-editor-pane">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-size: 12px; color: #34d399; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;">Sample Data Items</span>
                    <span style="font-size: 12px; color: #94a3b8;">— Used to populate repeating lists and preview mock content</span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <div style="display: inline-flex; background: #020617; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; padding: 2px;">
                        <button type="button" id="btnSampleModeForm" class="sample-view-btn active" onclick="switchSampleMode('form')">
                            <span class="material-symbols-outlined" style="font-size: 14px;">list_alt</span> Visual Form
                        </button>
                        <button type="button" id="btnSampleModeJson" class="sample-view-btn" onclick="switchSampleMode('json')">
                            <span class="material-symbols-outlined" style="font-size: 14px;">data_object</span> Raw JSON
                        </button>
                    </div>
                    <button type="button" id="btnAddSampleItemBtn" class="height-btn" onclick="addNewSampleItem()" style="background: #059669; color: #ffffff; border-color: #059669; font-weight: 600;">
                        <span class="material-symbols-outlined" style="font-size: 14px;">add</span> Add Item
                    </button>
                </div>
            </div>

            <!-- Visual Form Mode -->
            <div id="sampleVisualFormContainer">
                <div id="sampleItemsRepeaterList"></div>
                <div id="noSampleItemsMsg" style="display: none; text-align: center; padding: 40px 20px; background: #020617; border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px;">
                    <span class="material-symbols-outlined" style="font-size: 36px; color: #64748b; margin-bottom: 8px; display: block;">dataset</span>
                    <div style="font-weight: 600; font-size: 14px; color: #cbd5e1; margin-bottom: 4px;">No Sample Data Items</div>
                    <p style="font-size: 12.5px; color: #64748b; margin-bottom: 16px;">Add sample items to preview repeating list elements such as features, cards, or team members.</p>
                    <button type="button" class="btn-admin btn-admin-primary" onclick="addNewSampleItem()" style="font-size: 12px; padding: 6px 14px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">add</span> Add First Sample Item
                    </button>
                </div>
            </div>

            <!-- Raw JSON Mode -->
            <div id="sampleRawJsonContainer" style="display: none;">
                <div style="display: flex; justify-content: flex-end; margin-bottom: 8px;">
                    <button type="button" class="height-btn" onclick="formatSampleJson()">
                        <span class="material-symbols-outlined" style="font-size: 14px;">data_object</span> Format JSON
                    </button>
                </div>
                <textarea asp-for="Input.DefaultSectionListsJson" id="jsonEditorTextarea"></textarea>
            </div>
        </div>
    </div>

    @* ── Bottom Action Bar ── *@
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px;">
        <a href="/centralwks/templates" class="btn-admin btn-admin-secondary">
            &larr; Back to Templates List
        </a>
        <div style="display: flex; gap: 12px;">
            <a href="/centralwks/templates/details/@Model.Id" class="btn-admin btn-admin-secondary">
                Discard Changes
            </a>
            <button type="submit" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; padding: 12px 28px;">
                <span class="material-symbols-outlined" style="font-size: 18px;">save</span> Save Template Changes
            </button>
        </div>
    </div>
</form>

<!-- CodeMirror 5 Core & Modes -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/htmlmixed/htmlmixed.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/brace-fold.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/xml-fold.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closebrackets.min.js"></script>

<script>
    const editors = {
        html: null,
        css: null,
        js: null,
        json: null
    };

    let sampleItems = [];

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize CodeMirror Editors
        editors.html = CodeMirror.fromTextArea(document.getElementById('htmlEditorTextarea'), {
            mode: 'htmlmixed',
            theme: 'material-darker',
            lineNumbers: true,
            foldGutter: true,
            matchBrackets: true,
            autoCloseBrackets: true,
            gutters: ['CodeMirror-linenumbers', 'CodeMirror-foldgutter']
        });

        editors.css = CodeMirror.fromTextArea(document.getElementById('cssEditorTextarea'), {
            mode: 'css',
            theme: 'material-darker',
            lineNumbers: true,
            foldGutter: true,
            matchBrackets: true,
            autoCloseBrackets: true,
            gutters: ['CodeMirror-linenumbers', 'CodeMirror-foldgutter']
        });

        editors.js = CodeMirror.fromTextArea(document.getElementById('jsEditorTextarea'), {
            mode: 'javascript',
            theme: 'material-darker',
            lineNumbers: true,
            foldGutter: true,
            matchBrackets: true,
            autoCloseBrackets: true,
            gutters: ['CodeMirror-linenumbers', 'CodeMirror-foldgutter']
        });

        editors.json = CodeMirror.fromTextArea(document.getElementById('jsonEditorTextarea'), {
            mode: 'application/json',
            theme: 'material-darker',
            lineNumbers: true,
            foldGutter: true,
            matchBrackets: true,
            autoCloseBrackets: true,
            gutters: ['CodeMirror-linenumbers', 'CodeMirror-foldgutter']
        });

        // Initialize Sample Data from JSON
        parseInitialSampleData();
        renderSampleRepeater();

        // Attach change listeners for counters
        editors.html.on('change', updateCharCounts);
        editors.css.on('change', updateCharCounts);
        editors.json.on('change', function() {
            // Sync JSON text to internal sampleItems model if valid
            try {
                const val = editors.json.getValue();
                if (val && val.trim()) {
                    const parsed = JSON.parse(val);
                    if (Array.isArray(parsed)) {
                        sampleItems = parsed;
                        updateSampleBadge();
                    }
                }
            } catch(e) {}
        });

        updateCharCounts();

        // Hook form submission to save CodeMirror values back to hidden textareas
        const form = document.getElementById('templateEditForm');
        if (form) {
            form.addEventListener('submit', function() {
                // Ensure sample data is serialized from repeater model
                syncRepeaterToJson();
                editors.html.save();
                editors.css.save();
                editors.js.save();
                editors.json.save();
            });
        }
    });

    function parseInitialSampleData() {
        try {
            const raw = editors.json.getValue();
            if (raw && raw.trim()) {
                const parsed = JSON.parse(raw);
                if (Array.isArray(parsed)) {
                    sampleItems = parsed;
                }
            }
        } catch(e) {
            sampleItems = [];
        }
    }

    function switchStudioTab(tabId, btn) {
        document.querySelectorAll('.studio-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.studio-editor-pane').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        const pane = document.getElementById('studio-pane-' + tabId);
        if (pane) pane.classList.add('active');

        setTimeout(() => {
            if (tabId === 'html' && editors.html) editors.html.refresh();
            if (tabId === 'css' && editors.css) editors.css.refresh();
            if (tabId === 'js' && editors.js) editors.js.refresh();
            if (tabId === 'sample' && editors.json) {
                editors.json.refresh();
                renderSampleRepeater();
            }
        }, 50);
    }

    function setEditorHeight(heightPx, btn) {
        document.querySelectorAll('.height-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.CodeMirror').forEach(cm => {
            cm.style.height = heightPx + 'px';
        });
        Object.values(editors).forEach(ed => {
            if (ed) ed.refresh();
        });
    }

    function toggleMetadataBar(btn) {
        const container = document.getElementById('metadataFieldsContainer');
        const icon = document.getElementById('metadataToggleIcon');
        const text = document.getElementById('metadataToggleText');
        if (container.style.display === 'none') {
            container.style.display = 'block';
            icon.textContent = 'expand_less';
            text.textContent = 'Collapse Settings';
        } else {
            container.style.display = 'none';
            icon.textContent = 'expand_more';
            text.textContent = 'Expand Settings';
        }
    }

    function insertToken(token) {
        if (!editors.html) return;
        editors.html.replaceSelection(token);
        editors.html.focus();
        updateCharCounts();
    }

    function updateCharCounts() {
        if (editors.html) {
            const len = editors.html.getValue().length;
            document.getElementById('htmlCharCounter').textContent = len.toLocaleString() + ' characters';
            document.getElementById('htmlTabBadge').textContent = len > 0 ? (len > 1000 ? (len/1000).toFixed(1) + 'k' : len) : 'HTML';
        }
        if (editors.css) {
            const len = editors.css.getValue().length;
            document.getElementById('cssCharCounter').textContent = len.toLocaleString() + ' characters';
            document.getElementById('cssTabBadge').textContent = len > 0 ? (len > 1000 ? (len/1000).toFixed(1) + 'k' : len) : 'CSS';
        }
    }

    function formatCss() {
        if (!editors.css) return;
        let css = editors.css.getValue();
        if (!css.trim()) return;
        css = css.replace(/\s*{\s*/g, ' {\n    ')
                 .replace(/;\s*/g, ';\n    ')
                 .replace(/\s*}\s*/g, '\n}\n\n')
                 .replace(/\n    \n/g, '\n');
        editors.css.setValue(css.trim());
    }

    function switchSampleMode(mode) {
        const formCont = document.getElementById('sampleVisualFormContainer');
        const jsonCont = document.getElementById('sampleRawJsonContainer');
        const btnForm = document.getElementById('btnSampleModeForm');
        const btnJson = document.getElementById('btnSampleModeJson');
        const btnAdd = document.getElementById('btnAddSampleItemBtn');

        if (mode === 'form') {
            // Parse CodeMirror JSON into sampleItems
            try {
                const raw = editors.json.getValue();
                if (raw && raw.trim()) {
                    const parsed = JSON.parse(raw);
                    if (Array.isArray(parsed)) {
                        sampleItems = parsed;
                    }
                }
            } catch(e) {}
            renderSampleRepeater();

            formCont.style.display = 'block';
            jsonCont.style.display = 'none';
            btnForm.classList.add('active');
            btnJson.classList.remove('active');
            btnAdd.style.display = 'inline-flex';
        } else {
            // Sync repeater to JSON
            syncRepeaterToJson();
            formCont.style.display = 'none';
            jsonCont.style.display = 'block';
            btnForm.classList.remove('active');
            btnJson.classList.add('active');
            btnAdd.style.display = 'none';
            setTimeout(() => editors.json.refresh(), 50);
        }
    }

    function renderSampleRepeater() {
        const list = document.getElementById('sampleItemsRepeaterList');
        const empty = document.getElementById('noSampleItemsMsg');

        if (!sampleItems || sampleItems.length === 0) {
            list.innerHTML = '';
            empty.style.display = 'block';
            updateSampleBadge();
            return;
        }

        empty.style.display = 'none';
        list.innerHTML = '';

        sampleItems.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = 'sample-repeater-card';
            card.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #34d399; text-transform: uppercase;">Item #${index + 1}</span>
                        <span style="font-size: 12px; font-weight: 600; color: #cbd5e1;">${escapeHtml(item.Title || 'Untitled Item')}</span>
                    </div>
                    <div style="display: flex; gap: 4px;">
                        <button type="button" class="height-btn" onclick="moveSampleItem(${index}, -1)" ${index === 0 ? 'disabled style="opacity:0.3;cursor:not-allowed;"' : ''} title="Move Up">
                            <span class="material-symbols-outlined" style="font-size: 14px;">arrow_upward</span>
                        </button>
                        <button type="button" class="height-btn" onclick="moveSampleItem(${index}, 1)" ${index === sampleItems.length - 1 ? 'disabled style="opacity:0.3;cursor:not-allowed;"' : ''} title="Move Down">
                            <span class="material-symbols-outlined" style="font-size: 14px;">arrow_downward</span>
                        </button>
                        <button type="button" class="height-btn" onclick="deleteSampleItem(${index})" style="color: #f87171;" title="Delete Item">
                            <span class="material-symbols-outlined" style="font-size: 14px;">delete</span>
                        </button>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-bottom: 10px;">
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Title</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Title || '')}" placeholder="e.g. Modern Web Design" oninput="updateSampleItemField(${index}, 'Title', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Subtitle / Short Desc</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Subtitle || '')}" placeholder="e.g. High performance web apps" oninput="updateSampleItemField(${index}, 'Subtitle', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Tag / Badge</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Tag || '')}" placeholder="e.g. Popular" oninput="updateSampleItemField(${index}, 'Tag', this.value)" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px;">
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Icon Class</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Icon || '')}" placeholder="e.g. bi bi-laptop" oninput="updateSampleItemField(${index}, 'Icon', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Image URL</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.ImageUrl || '')}" placeholder="https://..." oninput="updateSampleItemField(${index}, 'ImageUrl', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Button / Link Text</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.ButtonText || '')}" placeholder="e.g. Learn More" oninput="updateSampleItemField(${index}, 'ButtonText', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Link URL</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Url || '')}" placeholder="e.g. /services" oninput="updateSampleItemField(${index}, 'Url', this.value)" />
                    </div>
                </div>
            `;
            list.appendChild(card);
        });

        updateSampleBadge();
    }

    function addNewSampleItem() {
        sampleItems.push({
            Title: 'New Item ' + (sampleItems.length + 1),
            Subtitle: 'Description of sample capability or feature.',
            Tag: 'Feature',
            Icon: 'bi bi-check-circle',
            ImageUrl: '',
            Url: '#',
            ButtonText: 'Learn More'
        });
        renderSampleRepeater();
        syncRepeaterToJson();
    }

    function updateSampleItemField(index, field, value) {
        if (!sampleItems[index]) return;
        sampleItems[index][field] = value;
        syncRepeaterToJson();
    }

    function moveSampleItem(index, direction) {
        const newIndex = index + direction;
        if (newIndex < 0 || newIndex >= sampleItems.length) return;
        const item = sampleItems.splice(index, 1)[0];
        sampleItems.splice(newIndex, 0, item);
        renderSampleRepeater();
        syncRepeaterToJson();
    }

    function deleteSampleItem(index) {
        sampleItems.splice(index, 1);
        renderSampleRepeater();
        syncRepeaterToJson();
    }

    function syncRepeaterToJson() {
        const jsonStr = sampleItems.length > 0 ? JSON.stringify(sampleItems, null, 4) : '';
        if (editors.json) {
            editors.json.setValue(jsonStr);
        }
        updateSampleBadge();
    }

    function updateSampleBadge() {
        const badge = document.getElementById('sampleItemsCountBadge');
        if (badge) {
            badge.textContent = sampleItems.length + (sampleItems.length === 1 ? ' Item' : ' Items');
        }
    }

    function formatSampleJson() {
        if (!editors.json) return;
        try {
            const raw = editors.json.getValue();
            if (!raw.trim()) return;
            const parsed = JSON.parse(raw);
            editors.json.setValue(JSON.stringify(parsed, null, 4));
        } catch(e) {
            alert('Invalid JSON syntax: ' + e.message);
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
</script>
