    function getActiveCategoryPlaceholders() {
        const catSelect = document.querySelector('select[name="Input.CategoryId"]');
        let selectedText = '';
        if (catSelect && catSelect.selectedIndex >= 0) {
            selectedText = (catSelect.options[catSelect.selectedIndex].text || '').toLowerCase();
        }
        for (const [key, schema] of Object.entries(categorySchemas)) {
            if (selectedText.includes(key)) {
                return schema;
            }
        }
        return categorySchemas.feature;
    }

    function renderSampleRepeater() {
        const list = document.getElementById('sampleItemsRepeaterList');
        const empty = document.getElementById('noSampleItemsMsg');
        const placeholders = getActiveCategoryPlaceholders();

        if (!sampleItems || sampleItems.length === 0) {
            list.innerHTML = '';
            empty.style.display = 'block';
            updateSampleBadge();
            return;
        }

        empty.style.display = 'none';
        list.innerHTML = '';

        sampleItems.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = 'sample-repeater-card';
            card.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="font-size: 11px; font-weight: 700; color: #34d399; text-transform: uppercase;">Item #${index + 1}</span>
                        <span style="font-size: 12px; font-weight: 600; color: #cbd5e1;">${escapeHtml(item.Title || placeholders.title.replace('e.g. ', ''))}</span>
                    </div>
                    <div style="display: flex; gap: 4px;">
                        <button type="button" class="height-btn" onclick="moveSampleItem(${index}, -1)" ${index === 0 ? 'disabled style="opacity:0.3;cursor:not-allowed;"' : ''} title="Move Up">
                            <span class="material-symbols-outlined" style="font-size: 14px;">arrow_upward</span>
                        </button>
                        <button type="button" class="height-btn" onclick="moveSampleItem(${index}, 1)" ${index === sampleItems.length - 1 ? 'disabled style="opacity:0.3;cursor:not-allowed;"' : ''} title="Move Down">
                            <span class="material-symbols-outlined" style="font-size: 14px;">arrow_downward</span>
                        </button>
                        <button type="button" class="height-btn" onclick="deleteSampleItem(${index})" style="color: #f87171;" title="Delete Item">
                            <span class="material-symbols-outlined" style="font-size: 14px;">delete</span>
                        </button>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-bottom: 10px;">
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Title</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Title || '')}" placeholder="${escapeHtml(placeholders.title)}" oninput="updateSampleItemField(${index}, 'Title', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Subtitle / Short Desc</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Subtitle || '')}" placeholder="${escapeHtml(placeholders.subtitle)}" oninput="updateSampleItemField(${index}, 'Subtitle', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Tag / Badge</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Tag || '')}" placeholder="${escapeHtml(placeholders.tag)}" oninput="updateSampleItemField(${index}, 'Tag', this.value)" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px;">
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Icon Class</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Icon || '')}" placeholder="${escapeHtml(placeholders.icon)}" oninput="updateSampleItemField(${index}, 'Icon', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Image URL</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.ImageUrl || '')}" placeholder="https://..." oninput="updateSampleItemField(${index}, 'ImageUrl', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Button / Link Text</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.ButtonText || '')}" placeholder="${escapeHtml(placeholders.buttonText || 'e.g. Learn More')}" oninput="updateSampleItemField(${index}, 'ButtonText', this.value)" />
                    </div>
                    <div>
                        <label style="display: block; font-size: 11px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Link URL</label>
                        <input type="text" class="sample-form-control" value="${escapeHtml(item.Url || '')}" placeholder="${escapeHtml(placeholders.url || 'e.g. /services')}" oninput="updateSampleItemField(${index}, 'Url', this.value)" />
                    </div>
                </div>
            `;
            list.appendChild(card);
        });

        updateSampleBadge();
    }

    function addNewSampleItem() {
        sampleItems.push({
            Title: '',
            Subtitle: '',
            Tag: '',
            Icon: '',
            ImageUrl: '',
            Url: '',
            ButtonText: ''
        });
        renderSampleRepeater();
        syncRepeaterToJson();
    }

    const catDropdown = document.querySelector('select[name="Input.CategoryId"]');
    if (catDropdown) {
        catDropdown.addEventListener('change', function() {
            renderSampleRepeater();
        });
    }

    function updateSampleItemField(index, field, value) {
        if (!sampleItems[index]) return;
        sampleItems[index][field] = value;
        syncRepeaterToJson();
    }

    function moveSampleItem(index, direction) {
        const newIndex = index + direction;
        if (newIndex < 0 || newIndex >= sampleItems.length) return;
        const item = sampleItems.splice(index, 1)[0];
        sampleItems.splice(newIndex, 0, item);
        renderSampleRepeater();
        syncRepeaterToJson();
    }

    function deleteSampleItem(index) {
        sampleItems.splice(index, 1);
        renderSampleRepeater();
        syncRepeaterToJson();
    }

    function syncRepeaterToJson() {
        const jsonStr = sampleItems.length > 0 ? JSON.stringify(sampleItems, null, 4) : '';
        if (editors.json) {
            editors.json.setValue(jsonStr);
        }
        updateSampleBadge();
    }

    function updateSampleBadge() {
        const badge = document.getElementById('sampleItemsCountBadge');
        if (badge) {
            badge.textContent = sampleItems.length + (sampleItems.length === 1 ? ' Item' : ' Items');
        }
    }

    function formatSampleJson() {
        if (!editors.json) return;
        try {
            const raw = editors.json.getValue();
            if (!raw.trim()) return;
            const parsed = JSON.parse(raw);
            editors.json.setValue(JSON.stringify(parsed, null, 4));
            if (window.ozToast) {
                window.ozToast('JSON formatted successfully!', 'success', 2500);
            }
        } catch(e) {
            if (window.ozToast) {
                window.ozToast('Invalid JSON syntax: ' + e.message, 'error', 3500);
            }
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
</script>
