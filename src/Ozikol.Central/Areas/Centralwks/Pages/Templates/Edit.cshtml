            <a href="/centralwks/templates/details/@Model.Id" class="btn-admin btn-admin-secondary">
                Discard Changes
            </a>
            <button type="submit" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; padding: 10px 24px;">
                <span class="material-symbols-outlined" style="font-size: 18px;">save</span> Save Template Changes
            </button>
        </div>
    </div>
</form>

