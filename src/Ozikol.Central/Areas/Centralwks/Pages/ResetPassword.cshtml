@page
@model Ozikol.Central.Areas.Centralwks.Pages.ResetPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set New Password";
    ViewData["CardTitle"] = "Set New Password";
    ViewData["CardSubtitle"] = "Enter the 6-digit code sent to your email and your new password";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-box alert-danger" role="alert">
        <span style="display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 16px;">error</span>
            @Model.ErrorMessage
        </span>
    </div>
}

<div id="resendAlert" class="alert-box" style="display: none; padding: 10px 14px; font-size: 13px; margin-bottom: 16px;"></div>

<form method="post" id="resetPasswordForm">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Input.Email" class="form-label">Email <span class="required">*</span></label>
        <input asp-for="Input.Email" id="operatorEmailInput" class="form-control" placeholder="name@@company.com" autocomplete="email" readonly="readonly" style="background-color: #f1f5f9; cursor: not-allowed; color: #475569;" />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.OtpCode" class="form-label">6-Digit Security Code <span class="required">*</span></label>
        <input asp-for="Input.OtpCode" class="form-control otp-control" placeholder="123456" maxlength="6" autocomplete="one-time-code" autofocus />
        <span asp-validation-for="Input.OtpCode" class="field-validation-error"></span>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: -12px; margin-bottom: 20px; font-size: 13px;">
        <span style="color: #64748b;">Didn't receive the code?</span>
        <button type="button" id="btnResendOtp" class="btn-resend" style="border: none; background: none; font-size: 13px; font-weight: 600; color: #94a3b8; cursor: not-allowed; text-decoration: none; padding: 2px 4px;" disabled>
            Resend code (<span id="resendCountdown">60</span>s)
        </button>
    </div>

    <div class="form-group">
        <label asp-for="Input.NewPassword" class="form-label">New Password <span class="required">*</span></label>
        <div class="password-input-wrap">
            <input asp-for="Input.NewPassword" id="newPasswordInput" class="form-control" placeholder="••••••••••••" autocomplete="new-password" />
            <button type="button" class="password-toggle-btn" onclick="togglePassVisibility('newPasswordInput', this)" title="Show password" aria-label="Toggle password visibility">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>
        <span asp-validation-for="Input.NewPassword" class="field-validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm New Password <span class="required">*</span></label>
        <div class="password-input-wrap">
            <input asp-for="Input.ConfirmPassword" id="confirmPasswordInput" class="form-control" placeholder="••••••••••••" autocomplete="new-password" />
            <button type="button" class="password-toggle-btn" onclick="togglePassVisibility('confirmPasswordInput', this)" title="Show password" aria-label="Toggle password visibility">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn-submit">
        <span>Update Password &amp; Sign In</span>
        <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
    </button>
</form>

@section Footer {
    <div class="auth-footer">
        <a href="/centralwks/login">← Back to Sign In</a>
    </div>
}

@section Scripts {
    <script>
        function togglePassVisibility(inputId, btn) {
            var input = document.getElementById(inputId);
            if (!input) return;
            var isPass = input.getAttribute('type') === 'password';
            input.setAttribute('type', isPass ? 'text' : 'password');
            btn.setAttribute('title', isPass ? 'Hide password' : 'Show password');
            btn.innerHTML = isPass
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
        }

        (function () {
            var countdown = 60;
            var btnResend = document.getElementById('btnResendOtp');
            var alertBox = document.getElementById('resendAlert');
            var emailInput = document.getElementById('operatorEmailInput');
            var timer = null;

            function startTimer() {
                countdown = 60;
                if (!btnResend) return;
                btnResend.disabled = true;
                btnResend.style.color = '#94a3b8';
                btnResend.style.cursor = 'not-allowed';
                btnResend.style.textDecoration = 'none';
                btnResend.innerHTML = 'Resend code (<span id="resendCountdown">' + countdown + '</span>s)';

                if (timer) clearInterval(timer);
                timer = setInterval(function () {
                    countdown--;
                    var cEl = document.getElementById('resendCountdown');
                    if (cEl) cEl.textContent = countdown;
                    if (countdown <= 0) {
                        clearInterval(timer);
                        btnResend.disabled = false;
                        btnResend.style.color = 'var(--auth-primary, #0050e5)';
                        btnResend.style.cursor = 'pointer';
                        btnResend.style.textDecoration = 'underline';
                        btnResend.textContent = 'Resend code';
                    }
                }, 1000);
            }

            // Begin 60-second countdown immediately on page load
            startTimer();

            if (btnResend) {
                btnResend.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (countdown > 0) return;

                    var email = emailInput ? emailInput.value.trim() : '';
                    if (!email) return;

                    btnResend.disabled = true;
                    btnResend.textContent = 'Sending code...';

                    var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    var token = tokenEl ? tokenEl.value : '';

                    fetch('?handler=Resend', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ email: email })
                    })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (alertBox) {
                            alertBox.style.display = 'flex';
                            if (data.success) {
                                alertBox.className = 'alert-box alert-success';
                                alertBox.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> ' + data.message;
                            } else {
                                alertBox.className = 'alert-box alert-danger';
                                alertBox.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px;">error</span> ' + data.message;
                            }
                        }
                        startTimer();
                    })
                    .catch(function () {
                        if (alertBox) {
                            alertBox.style.display = 'flex';
                            alertBox.className = 'alert-box alert-danger';
                            alertBox.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px;">error</span> Failed to dispatch code. Please try again.';
                        }
                        startTimer();
                    });
                });
            }
        })();
    </script>
}
