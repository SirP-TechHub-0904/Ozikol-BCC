@page
@model Ozikol.Central.Areas.Centralwks.Pages.ForgotPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Password Recovery";
    ViewData["CardTitle"] = "Password Recovery";
    ViewData["CardSubtitle"] = "Enter your registered operator work email to receive a 6-digit verification code";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-box alert-danger" role="alert">
        <span style="display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 16px;">error</span>
            @Model.ErrorMessage
        </span>
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="Input.Email" class="form-label">Operator Work Email <span class="required">*</span></label>
        <input asp-for="Input.Email" class="form-control" placeholder="name@@company.com" autocomplete="email" autofocus />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
    </div>

    <button type="submit" class="btn-submit">
        <span>Send Verification Code</span>
        <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
    </button>
</form>

@section Footer {
    <div class="auth-footer">
        <a href="/centralwks/login">← Back to Sign In</a>
    </div>
}
