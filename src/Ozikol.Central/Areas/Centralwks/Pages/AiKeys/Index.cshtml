@page "/centralwks/ai-keys"
@model Ozikol.Central.Areas.Centralwks.Pages.AiKeys.IndexModel
@{
    ViewData["Title"] = "AI Key Pool & Telemetry Hub";
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                    <i class="fa-brands fa-google me-1"></i> Google Gemini Free Pool
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="fa-solid fa-shield-halved me-1"></i> 429 Cooldown Failover Active
                </span>
            </div>
            <h2 class="fw-bold mb-1">Google Gemini Key Pool &amp; Telemetry Hub</h2>
            <p class="text-muted small mb-0">Manage rotating free Google Gemini API keys (1,500 reqs/day per key), monitor live quota consumption, and review execution latency.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#logsModal">
                <i class="fa-solid fa-list-check me-1"></i> Request Telemetry Logs
            </button>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addKeyModal">
                <i class="fa-solid fa-plus me-1"></i> Register New API Key
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-@(Model.StatusMessageType ?? "info") alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-info me-2"></i> @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-medium">Active Key Pool</span>
                        <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-circle-check"></i></span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold mb-0">@Model.Summary.ActiveKeys</h3>
                        <span class="text-muted small">/ @Model.Summary.TotalKeys Total Keys</span>
                    </div>
                    <div class="text-muted small mt-2">
                        @if (Model.Summary.CoolingDownKeys > 0)
                        {
                            <span class="text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>@Model.Summary.CoolingDownKeys in Cooldown</span>
                        }
                        else
                        {
                            <span class="text-success"><i class="fa-solid fa-bolt me-1"></i>All keys operational</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-medium">Daily Request Capacity</span>
                        <span class="badge bg-primary-subtle text-primary"><i class="fa-solid fa-gauge-high"></i></span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold mb-0">@Model.Summary.TotalDailyCapacity.ToString("N0")</h3>
                        <span class="text-muted small">reqs/day</span>
                    </div>
                    <div class="text-muted small mt-2">
                        <span>Free tier quota pool</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-medium">Today's Usage</span>
                        <span class="badge bg-info-subtle text-info"><i class="fa-solid fa-chart-line"></i></span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold mb-0">@Model.Summary.TotalRequestsToday</h3>
                        <span class="text-muted small">
                            @if (Model.Summary.TotalDailyCapacity > 0)
                            {
                                @($"{((double)Model.Summary.TotalRequestsToday / Model.Summary.TotalDailyCapacity * 100):F1}% utilized")
                            }
                        </span>
                    </div>
                    <div class="progress mt-2" style="height: 4px;">
                        <div class="progress-bar bg-info" role="progressbar" style="width: @(Model.Summary.TotalDailyCapacity > 0 ? Math.Min(100, (double)Model.Summary.TotalRequestsToday / Model.Summary.TotalDailyCapacity * 100) : 0)%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-medium">Avg Latency (7 Days)</span>
                        <span class="badge bg-secondary-subtle text-secondary"><i class="fa-solid fa-stopwatch"></i></span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h3 class="fw-bold mb-0">@Model.Summary.AverageLatencyMs</h3>
                        <span class="text-muted small">ms</span>
                    </div>
                    <div class="text-muted small mt-2">
                        <span>Across @Model.Summary.TotalLifetimeRequests.ToString("N0") lifetime requests</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Registry Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="fa-solid fa-key text-primary me-2"></i>Active Key Pool Registry</h5>
            <span class="badge bg-light text-dark border">@Model.Summary.Keys.Count Registered</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Provider</th>
                        <th>Alias & Key ID</th>
                        <th>API Key (Masked)</th>
                        <th>Today's Quota</th>
                        <th>Lifetime Usage</th>
                        <th>Status</th>
                        <th>Last Used</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Summary.Keys.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-key fa-2x mb-2 d-block opacity-25"></i>
                                No AI API keys registered yet. Click <strong>"Register New API Key"</strong> above to add your first key.
                            </td>
                        </tr>
                    }
                    @foreach (var key in Model.Summary.Keys)
                    {
                        var maskedKey = key.ApiKey.Length > 10 ? key.ApiKey.Substring(0, 6) + "••••••••" + key.ApiKey.Substring(key.ApiKey.Length - 4) : "••••••••";
                        var isCooling = key.RateLimitCooldownUntilUtc.HasValue && key.RateLimitCooldownUntilUtc.Value > DateTime.UtcNow;
                        var isExhausted = key.TodayRequestsCount >= key.DailyQuotaLimit;

                        <tr>
                            <td class="ps-3">
                                @if (key.Provider.Equals("Gemini", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="fa-brands fa-google me-1"></i> Google Gemini
                                    </span>
                                }
                                else if (key.Provider.Equals("DeepSeek", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                        <i class="fa-solid fa-brain me-1"></i> DeepSeek
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        <i class="fa-solid fa-robot me-1"></i> @key.Provider
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@key.KeyAlias</div>
                                <div class="text-muted font-monospace" style="font-size: 0.75rem;">ID: @key.Id.ToString().Substring(0, 8)...</div>
                            </td>
                            <td>
                                <span class="font-monospace text-muted small bg-light px-2 py-1 rounded border">@maskedKey</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 6px; width: 80px;">
                                        <div class="progress-bar @(isExhausted ? "bg-danger" : "bg-success")" role="progressbar" style="width: @Math.Min(100, (double)key.TodayRequestsCount / key.DailyQuotaLimit * 100)%"></div>
                                    </div>
                                    <span class="small fw-medium">@key.TodayRequestsCount / @key.DailyQuotaLimit</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@key.TotalRequestsCount.ToString("N0") reqs</span>
                            </td>
                            <td>
                                @if (!key.IsActive)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Disabled</span>
                                }
                                else if (isCooling)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                        <i class="fa-solid fa-clock me-1"></i> Cooldown (@Math.Ceiling((key.RateLimitCooldownUntilUtc!.Value - DateTime.UtcNow).TotalSeconds)s)
                                    </span>
                                }
                                else if (isExhausted)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Quota Full</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="fa-solid fa-circle-check me-1"></i> Ready
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="text-muted small">
                                    @(key.LastUsedAtUtc.HasValue ? key.LastUsedAtUtc.Value.ToString("MMM dd, HH:mm UTC") : "Never")
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@key.Id" class="d-inline">
                                        <button type="submit" class="btn btn-outline-secondary" title="@(key.IsActive ? "Pause Key" : "Activate Key")">
                                            <i class="fa-solid @(key.IsActive ? "fa-pause text-warning" : "fa-play text-success")"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="DeleteKey" asp-route-id="@key.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @key.KeyAlias from the pool?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Key">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add New API Key -->
<div class="modal fade" id="addKeyModal" tabindex="-1" aria-labelledby="addKeyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="AddKey" id="addKeyForm">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="addKeyModalLabel"><i class="fa-brands fa-google text-primary me-2"></i>Register Google Gemini Free API Key</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" asp-for="Input.Provider" value="Gemini" id="inputProvider" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Key Alias / Label</label>
                        <input asp-for="Input.KeyAlias" class="form-control" placeholder="e.g. Gemini Free Key #1" />
                        <div class="form-text">A friendly name to identify this key in metrics.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">API Key Secret</label>
                        <div class="input-group">
                            <input asp-for="Input.ApiKey" id="inputApiKey" type="password" class="form-control font-monospace" placeholder="e.g. AIzaSyD-xxxxxxxxxxxxxx" required />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility()"><i class="fa-solid fa-eye" id="eyeIcon"></i></button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Daily Request Quota</label>
                        <input asp-for="Input.DailyQuotaLimit" class="form-control" type="number" value="1500" />
                        <div class="form-text">Default is 1,500 requests/day for Gemini Free Tier.</div>
                    </div>

                    <!-- Connection Test Area -->
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold small">Pre-flight Verification</div>
                                <div class="text-muted small" id="testResultText">Test authentication before saving to pool.</div>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnTestConn" onclick="testKeyConnection()">
                                <i class="fa-solid fa-plug me-1"></i> Test Key
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Register to Pool</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Telemetry Request Logs -->
<div class="modal fade" id="logsModal" tabindex="-1" aria-labelledby="logsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="logsModalLabel"><i class="fa-solid fa-list-check text-primary me-2"></i>Recent AI Request Telemetry (Last 50)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 font-monospace small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Timestamp (UTC)</th>
                                <th>Key Alias</th>
                                <th>Action / Endpoint</th>
                                <th>Latency</th>
                                <th>Status</th>
                                <th>Tokens</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentLogs.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No telemetry logs recorded yet.</td>
                                </tr>
                            }
                            @foreach (var log in Model.RecentLogs)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@log.RequestTimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="fw-semibold">@(log.MasterAiApiKey?.KeyAlias ?? "Local/Deleted")</td>
                                    <td><span class="badge bg-light text-dark border">@log.ActionName</span></td>
                                    <td>@log.ResponseTimeMs ms</td>
                                    <td>
                                        @if (log.StatusCode == 200)
                                        {
                                            <span class="badge bg-success">200 OK</span>
                                        }
                                        else if (log.StatusCode == 429)
                                        {
                                            <span class="badge bg-warning text-dark">429 Rate Limited</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@log.StatusCode Error</span>
                                        }
                                    </td>
                                    <td class="text-muted">@(log.PromptTokens.HasValue ? $"{log.PromptTokens}+{log.CompletionTokens}" : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswordVisibility() {
            const input = document.getElementById('inputApiKey');
            const icon = document.getElementById('eyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        async function testKeyConnection() {
            const provider = document.getElementById('inputProvider').value;
            const apiKey = document.getElementById('inputApiKey').value;
            const resultText = document.getElementById('testResultText');
            const btn = document.getElementById('btnTestConn');

            if (!apiKey || apiKey.trim() === '') {
                resultText.innerHTML = '<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Please enter an API key first.</span>';
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Testing...';
            resultText.innerHTML = '<span class="text-muted">Verifying credentials with provider...</span>';

            try {
                const response = await fetch('?handler=TestConnection', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ provider: provider, apiKey: apiKey })
                });

                const data = await response.json();
                if (data.success) {
                    resultText.innerHTML = `<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i>${data.message}</span>`;
                } else {
                    resultText.innerHTML = `<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i>${data.message}</span>`;
                }
            } catch (err) {
                resultText.innerHTML = `<span class="text-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Failed to connect: ${err.message}</span>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-plug me-1"></i> Test Key';
            }
        }
    </script>
}
