@page "{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Creators.DetailsModel
@{
    ViewData["Title"] = $"Creator Application: {Model.Application.FullName}";
    ViewData["BreadcrumbSection"] = "Creators";

    var isApproved = Model.Application.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase);
    var isRejected = Model.Application.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase);
    var isUnderReview = Model.Application.Status.Equals("UnderReview", StringComparison.OrdinalIgnoreCase);
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">@Model.Application.FullName</h1>
        <p class="admin-subtitle">Creator Code: <code style="color: #a78bfa; font-size: 15px; font-weight: 700;">@Model.Application.CreatorCode</code> &bull; Specialization: <span style="color: #fff; font-weight: 600;">@Model.Application.Specialization</span></p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/creators/edit/@Model.Application.Id" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">edit</span> Edit Profile
        </a>
        <a href="/centralwks/creators/applications" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Queue
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    @* ── Left: Pitch, Portfolio & Profile ── *@
    <div>
        <div class="admin-card" style="padding: 28px; margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 20px; margin-bottom: 24px;">
                <div>
                    <div style="font-size: 20px; font-weight: 700; color: #fff;">@Model.Application.FullName</div>
                    @if (!string.IsNullOrWhiteSpace(Model.Application.StudioOrBrandName))
                    {
                        <div style="font-size: 14px; color: #38bdf8; margin-top: 2px;">Studio / Agency: @Model.Application.StudioOrBrandName</div>
                    }
                    <div style="font-size: 13px; color: var(--admin-text-muted); margin-top: 4px;">
                        Contact: <a href="mailto:@Model.Application.Email" style="color: #60a5fa;">@Model.Application.Email</a>
                        @if (!string.IsNullOrWhiteSpace(Model.Application.PhoneNumber))
                        {
                            <span> &bull; @Model.Application.PhoneNumber</span>
                        }
                    </div>
                </div>
                <div>
                    @if (isApproved)
                    {
                        <span class="badge badge-success" style="font-size: 13px; padding: 6px 14px; display: inline-flex; align-items: center; gap: 4px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span> Approved Creator
                        </span>
                    }
                    else if (isRejected)
                    {
                        <span class="badge badge-danger" style="font-size: 13px; padding: 6px 14px; display: inline-flex; align-items: center; gap: 4px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">cancel</span> Rejected
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-warning" style="font-size: 13px; padding: 6px 14px; display: inline-flex; align-items: center; gap: 4px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">hourglass_top</span> Under Review
                        </span>
                    }
                </div>
            </div>

            @* Portfolio Link Banner *@
            <div style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 8px; padding: 16px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: #93c5fd;">Candidate Portfolio / Figma / GitHub</div>
                    <div style="font-family: monospace; font-size: 14px; color: #fff; margin-top: 4px; word-break: break-all;">
                        @Model.Application.PortfolioUrl
                    </div>
                </div>
                <a href="@Model.Application.PortfolioUrl" target="_blank" rel="noopener noreferrer" class="btn-admin btn-admin-primary" style="white-space: nowrap; display: inline-flex; align-items: center; gap: 4px;">
                    <span class="material-symbols-outlined" style="font-size: 14px;">link</span> Open Portfolio &rarr;
                </a>
            </div>

            @* Proposal Pitch *@
            <div style="margin-bottom: 24px;">
                <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-muted); letter-spacing: 0.5px; margin-bottom: 10px;">
                    Template Proposal Pitch & Vision
                </h3>
                <div style="background: var(--admin-bg-surface); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 20px; font-size: 14px; color: #e2e8f0; line-height: 1.7; white-space: pre-wrap;">@Model.Application.ProposalPitch</div>
            </div>

            @* Internal Review Notes Editor *@
            <form method="post" asp-page-handler="SaveNotes" asp-route-id="@Model.Application.Id">
                @Html.AntiForgeryToken()
                <h3 style="font-size: 14px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-muted); letter-spacing: 0.5px; margin-bottom: 10px;">
                    Internal Admin Review Notes
                </h3>
                <textarea asp-for="ReviewNotes" rows="3" class="form-control" style="margin-bottom: 10px;" placeholder="Add internal evaluations, design quality notes, or feedback..."></textarea>
                <button type="submit" class="btn-admin btn-admin-secondary" style="font-size: 12px;">
                    Save Review Notes
                </button>
            </form>
        </div>
    </div>

    @* ── Right: Decision & Review Controls ── *@
    <div>
        <div class="admin-card" style="margin-bottom: 24px;">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(139, 92, 246, 0.15); color: #a78bfa;">
                    <span class="material-symbols-outlined" style="font-size: 20px;">gavel</span>
                </div>
                <div>
                    <h3 class="card-header-title">Application Decision</h3>
                    <p class="card-header-subtitle">Certify or reject this designer.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                @if (isUnderReview)
                {
                    <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Application.Id" style="margin-bottom: 12px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; justify-content: center; display: inline-flex; align-items: center; gap: 6px;" onclick="return confirm('Officially certify and approve creator @Model.Application.FullName?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">check</span> Approve Creator & Grant Access
                        </button>
                    </form>

                    <form method="post" asp-page-handler="Reject" asp-route-id="@Model.Application.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-danger" style="width: 100%; justify-content: center; display: inline-flex; align-items: center; gap: 6px;" onclick="return confirm('Reject this creator application?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">close</span> Reject Application
                        </button>
                    </form>
                }
                else if (isApproved)
                {
                    <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 6px; padding: 12px; margin-bottom: 12px; font-size: 13px; color: #34d399;">
                        This creator is approved and authorized to publish UI templates to the marketplace.
                    </div>

                    <form method="post" asp-page-handler="Reject" asp-route-id="@Model.Application.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-danger" style="width: 100%; justify-content: center; display: inline-flex; align-items: center; gap: 6px;" onclick="return confirm('Revoke certification and reject this creator?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">close</span> Revoke Certification (Reject)
                        </button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Application.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; justify-content: center; display: inline-flex; align-items: center; gap: 6px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">check</span> Re-Open & Approve Creator
                        </button>
                    </form>
                }
            </div>
        </div>

        <div class="admin-card">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">
                    <span class="material-symbols-outlined" style="font-size: 20px;">description</span>
                </div>
                <div>
                    <h3 class="card-header-title">Application Metadata</h3>
                    <p class="card-header-subtitle">Timestamp & terms agreement.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                <div style="display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
                    <div>
                        <span style="color: var(--admin-text-muted); display: block; font-size: 11px; text-transform: uppercase; font-weight: 700;">Submitted Date</span>
                        <span style="color: #fff;">@Model.Application.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
                    </div>
                    <div>
                        <span style="color: var(--admin-text-muted); display: block; font-size: 11px; text-transform: uppercase; font-weight: 700;">Terms & Conditions</span>
                        <span style="color: @(Model.Application.TermsAgreed ? "#34d399" : "var(--admin-danger)"); font-weight: 600;">
                            @(Model.Application.TermsAgreed ? "Agreed to Creator License" : "Not Agreed")
                        </span>
                    </div>
                    <div>
                        <span style="color: var(--admin-text-muted); display: block; font-size: 11px; text-transform: uppercase; font-weight: 700;">Specialization</span>
                        <span style="color: #fff;">@Model.Application.Specialization</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
