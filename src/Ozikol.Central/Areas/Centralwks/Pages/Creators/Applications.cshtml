@page
@model Ozikol.Central.Areas.Centralwks.Pages.Creators.ApplicationsModel
@{
    ViewData["Title"] = "Creator Applications Queue";
    ViewData["BreadcrumbSection"] = "Creators";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Creator Applications Review Queue</h1>
        <p class="admin-subtitle">Evaluate portfolio submissions, review design specializations, and approve or reject creator program applicants.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/creators" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Approved Creators
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

@* ── Review Queue Stats / Filter Pills ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <a href="/centralwks/creators/applications?Status=UnderReview" style="text-decoration: none;">
        <div class="stat-card" style="padding: 16px; border: @(Model.Status == "UnderReview" ? "1px solid var(--admin-primary)" : "1px solid rgba(255, 255, 255, 0.08)");">
            <div class="stat-icon-wrapper stat-icon-warning" style="width: 40px; height: 40px;">
                <span class="material-symbols-outlined" style="font-size: 20px;">hourglass_top</span>
            </div>
            <div class="stat-details">
                <span class="stat-label">Pending Review</span>
                <span class="stat-value" style="font-size: 22px; color: #f59e0b;">@Model.PendingCount</span>
            </div>
        </div>
    </a>
    <a href="/centralwks/creators/applications?Status=Approved" style="text-decoration: none;">
        <div class="stat-card" style="padding: 16px; border: @(Model.Status == "Approved" ? "1px solid var(--admin-primary)" : "1px solid rgba(255, 255, 255, 0.08)");">
            <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px;">
                <span class="material-symbols-outlined" style="font-size: 20px;">check_circle</span>
            </div>
            <div class="stat-details">
                <span class="stat-label">Approved</span>
                <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">@Model.ApprovedCount</span>
            </div>
        </div>
    </a>
    <a href="/centralwks/creators/applications?Status=Rejected" style="text-decoration: none;">
        <div class="stat-card" style="padding: 16px; border: @(Model.Status == "Rejected" ? "1px solid var(--admin-primary)" : "1px solid rgba(255, 255, 255, 0.08)");">
            <div class="stat-icon-wrapper stat-icon-danger" style="width: 40px; height: 40px;">
                <span class="material-symbols-outlined" style="font-size: 20px;">cancel</span>
            </div>
            <div class="stat-details">
                <span class="stat-label">Rejected</span>
                <span class="stat-value" style="font-size: 22px; color: var(--admin-danger);">@Model.RejectedCount</span>
            </div>
        </div>
    </a>
</div>

@* ── Applications Table ── *@
<div class="admin-card">
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Applicant & Studio</th>
                    <th>Specialization</th>
                    <th>Portfolio</th>
                    <th>Proposal Pitch Snippet</th>
                    <th>Submitted</th>
                    <th>Status</th>
                    <th style="text-align: right;">Review Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Applications.Any())
                {
                    @foreach (var app in Model.Applications)
                    {
                        var isPending = app.Status.Equals("UnderReview", StringComparison.OrdinalIgnoreCase);
                        var isApproved = app.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase);
                        var isRejected = app.Status.Equals("Rejected", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td>
                                <code style="font-family: monospace; font-size: 13px; font-weight: 700; color: #a78bfa;">
                                    @app.CreatorCode
                                </code>
                            </td>
                            <td>
                                <div style="font-weight: 600; color: #fff; font-size: 14px;">@app.FullName</div>
                                @if (!string.IsNullOrWhiteSpace(app.StudioOrBrandName))
                                {
                                    <div style="font-size: 12px; color: #38bdf8; margin-top: 2px;">@app.StudioOrBrandName</div>
                                }
                                <div style="font-size: 12px; color: var(--admin-text-muted);">@app.Email</div>
                            </td>
                            <td>
                                <span class="badge badge-secondary" style="font-size: 11px;">
                                    @app.Specialization
                                </span>
                            </td>
                            <td>
                                <a href="@app.PortfolioUrl" target="_blank" rel="noopener noreferrer" style="color: #60a5fa; font-size: 13px; display: inline-flex; align-items: center; gap: 4px; text-decoration: none;">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">link</span> Portfolio
                                </a>
                            </td>
                            <td style="max-width: 260px;">
                                <div style="font-size: 12px; color: var(--admin-text-muted); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @app.ProposalPitch
                                </div>
                            </td>
                            <td style="font-size: 12px; color: var(--admin-text-muted);">
                                @app.CreatedUtc.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                @if (isApproved)
                                {
                                    <span class="badge badge-success">Approved</span>
                                }
                                else if (isRejected)
                                {
                                    <span class="badge badge-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Under Review</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 6px;">
                                    <a href="/centralwks/creators/details/@app.Id" class="btn-admin btn-admin-secondary" style="padding: 4px 8px; font-size: 12px;" title="Inspect Full Application">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">visibility</span>
                                    </a>

                                    @if (isPending)
                                    {
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@app.Id" style="display: inline;" onsubmit="return confirm('Approve creator @app.FullName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-admin btn-admin-primary" style="padding: 4px 8px; font-size: 12px;" title="Approve Creator">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">check</span>
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="Reject" asp-route-id="@app.Id" style="display: inline;" onsubmit="return confirm('Reject application from @app.FullName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-admin btn-admin-danger" style="padding: 4px 8px; font-size: 12px;" title="Reject Application">
                                                <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 48px; color: var(--admin-text-muted);">
                            <div style="font-size: 32px; margin-bottom: 8px;">
                                <span class="material-symbols-outlined" style="font-size: 36px; color: var(--admin-text-muted);">inbox</span>
                            </div>
                            <div style="font-size: 16px; font-weight: 500; color: #fff;">No Applications in this Queue</div>
                            <div style="font-size: 13px; margin-top: 4px;">There are no creator applications matching the selected filter.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
