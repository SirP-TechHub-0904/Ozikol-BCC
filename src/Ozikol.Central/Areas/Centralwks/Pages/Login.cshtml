@page
@model Ozikol.Central.Areas.Centralwks.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Admin Console Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Sign In — Ozikol Console</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="/images/oz-logo.png" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif);
            background: linear-gradient(135deg, #f8fafc 0%, #eef2f6 50%, #f1f5f9 100%);
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            overflow-x: hidden;
        }

        /* Subtle glowing background orbs */
        body::before {
            content: "";
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(225, 29, 72, 0.08) 0%, rgba(244, 63, 94, 0.02) 50%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        body::after {
            content: "";
            position: absolute;
            bottom: -150px;
            right: 10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.05) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        .auth-container {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
        }

        .auth-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 40px 36px;
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.07), 0 0 1px 1px rgba(15, 23, 42, 0.04);
            position: relative;
        }

        .auth-brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 20px;
        }

        .auth-brand img {
            height: 38px;
            width: auto;
        }

        .auth-brand-text {
            font-size: 21px;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.03em;
        }

        .auth-brand-accent {
            color: #e11d48;
        }

        .auth-title {
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }

        .auth-subtitle {
            font-size: 13.5px;
            color: #64748b;
            line-height: 1.5;
            margin-bottom: 28px;
        }

        .alert-box {
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 13.5px;
            line-height: 1.4;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .alert-danger {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .alert-success {
            background-color: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-label .required {
            color: #e11d48;
        }

        .form-control {
            width: 100%;
            height: 44px;
            padding: 10px 14px;
            font-size: 14px;
            color: #0f172a;
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            transition: all 0.2s ease;
            outline: none;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #e11d48;
            box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.15);
        }

        .form-control::placeholder {
            color: #94a3b8;
        }

        .password-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-input-wrap .form-control {
            padding-right: 42px;
        }

        .password-toggle-btn {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            padding: 6px;
            color: #94a3b8;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease, transform 0.1s ease;
            border-radius: 6px;
            z-index: 2;
        }

        .password-toggle-btn:hover {
            color: #334155;
        }

        .password-toggle-btn:focus-visible {
            outline: 2px solid #e11d48;
            outline-offset: 2px;
        }

        .field-validation-error {
            display: block;
            color: #dc2626;
            font-size: 12px;
            margin-top: 5px;
            font-weight: 500;
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 6px;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: #475569;
            user-select: none;
        }

        .form-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            accent-color: #e11d48;
            cursor: pointer;
        }

        .forgot-link {
            color: #e11d48;
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: #be123c;
            text-decoration: underline;
        }

        .btn-submit {
            width: 100%;
            height: 46px;
            background-color: #e11d48;
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 14.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(225, 29, 72, 0.25);
        }

        .btn-submit:hover {
            background-color: #be123c;
            box-shadow: 0 6px 16px rgba(225, 29, 72, 0.35);
            transform: translateY(-1px);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .auth-footer {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
            text-align: center;
            font-size: 12.5px;
            color: #94a3b8;
        }

        .auth-footer a {
            color: #64748b;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .auth-footer a:hover {
            color: #0f172a;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div style="text-align: center;">
                <a href="/" class="auth-brand" title="Return to Home">
                    <img src="/images/oz-logo.png" alt="Ozikol Logo" />
                    <span class="auth-brand-text">Ozikol <span class="auth-brand-accent">Console</span></span>
                </a>
                <h1 class="auth-title">Administrative Sign In</h1>
                <p class="auth-subtitle">Authorized platform operators &amp; system administrators authenticate here</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert-box alert-success" role="alert">
                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">check_circle</span>
                        @Model.StatusMessage
                    </span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert-box alert-danger" role="alert">
                    <span style="display: inline-flex; align-items: center; gap: 6px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">error</span>
                        @Model.ErrorMessage
                    </span>
                </div>
            }

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Operator Work Email <span class="required">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="name@@company.com" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password <span class="required">*</span></label>
                    <div class="password-input-wrap">
                        <input asp-for="Password" id="adminPasswordInput" class="form-control" placeholder="••••••••••••" autocomplete="current-password" />
                        <button type="button" class="password-toggle-btn" id="togglePasswordBtn" title="Show password" aria-label="Toggle password visibility">
                            <svg id="eyeOpenIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="eyeSlashIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;" aria-hidden="true">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-options">
                    <label class="form-check">
                        <input asp-for="RememberMe" type="checkbox" />
                        <span>Keep me signed in</span>
                    </label>
                    <a href="/centralwks/forgot-password" class="forgot-link">Forgot password?</a>
                </div>

                <!-- Google reCAPTCHA Verification Widget -->
                <div style="margin-bottom: 20px; display: flex; justify-content: center;">
                    <div class="g-recaptcha" data-sitekey="@Model.RecaptchaSiteKey"></div>
                </div>

                <button type="submit" class="btn-submit">
                    <span>Sign In to Console</span>
                    <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
                </button>
            </form>

            <div class="auth-footer">
                <div>Protected by Isolated Master Architecture &amp; Immutable Audit Trail</div>
                <div style="margin-top: 8px;">
                    <a href="/">← Return to Public Website</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggleBtn = document.getElementById('togglePasswordBtn');
            var passwordInput = document.getElementById('adminPasswordInput');
            var eyeOpen = document.getElementById('eyeOpenIcon');
            var eyeSlash = document.getElementById('eyeSlashIcon');

            if (toggleBtn && passwordInput) {
                toggleBtn.addEventListener('click', function () {
                    var isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    eyeOpen.style.display = isPassword ? 'none' : 'block';
                    eyeSlash.style.display = isPassword ? 'block' : 'none';
                    toggleBtn.setAttribute('title', isPassword ? 'Hide password' : 'Show password');
                });
            }
        });
    </script>
</body>
</html>
