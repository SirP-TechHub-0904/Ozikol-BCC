@page "/centralwks/careers/openings/create"
@model Ozikol.Central.Areas.Centralwks.Pages.Careers.Openings.CreateModel
@{
    ViewData["Title"] = "Post Job Opening";
    ViewData["BreadcrumbSection"] = "Careers";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/careers/openings" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Openings</a>
        </div>
        <h1 class="admin-title">Post Career Opportunity</h1>
        <p class="admin-subtitle">Publish a new engineering, operations, or administrative position to the Ozikol careers board.</p>
    </div>
</div>

<div class="admin-card" style="max-width: 900px; padding: 28px;">
    <form method="post">
        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Title" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Position Title <span style="color: #f87171;">*</span>
            </label>
            <input asp-for="Input.Title" id="jobTitleInput" placeholder="e.g. Senior Distributed Systems Engineer (C# / .NET 9)" 
                   class="form-control" style="font-size: 15px; font-weight: 500;" />
            <span asp-validation-for="Input.Title" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.Slug" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    URL Permalink Slug <span style="color: #f87171;">*</span>
                </label>
                <div style="display: flex; align-items: center; background: var(--admin-bg-surface); border: 1px solid var(--admin-card-border); border-radius: 8px; overflow: hidden;">
                    <span style="padding: 10px 12px; color: var(--admin-text-muted); font-size: 13px; background: rgba(255, 255, 255, 0.03); border-right: 1px solid var(--admin-card-border); font-family: monospace;">
                        /careers/
                    </span>
                    <input asp-for="Input.Slug" id="jobSlugInput" placeholder="senior-distributed-systems-engineer" 
                           class="form-control" style="flex: 1; background: transparent; border: none; padding: 10px 14px; color: #93c5fd; font-size: 13px; font-family: monospace;" />
                </div>
                <span asp-validation-for="Input.Slug" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div>
                <label asp-for="Input.Department" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Department <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.Department" class="form-select">
                    <option value="Engineering & Architecture">Engineering & Architecture</option>
                    <option value="Cloud Operations & SRE">Cloud Operations & SRE</option>
                    <option value="Security & Compliance">Security & Compliance</option>
                    <option value="Product Design & UX">Product Design & UX</option>
                    <option value="Growth & Commercial">Growth & Commercial</option>
                    <option value="Customer Success & Support">Customer Success & Support</option>
                    <option value="Finance & Administration">Finance & Administration</option>
                </select>
                <span asp-validation-for="Input.Department" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.Location" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Location / Work Model <span style="color: #f87171;">*</span>
                </label>
                <input asp-for="Input.Location" class="form-control" placeholder="Remote (Global) or Lagos, NG" />
                <span asp-validation-for="Input.Location" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div>
                <label asp-for="Input.EmploymentType" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Employment Type <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.EmploymentType" class="form-select">
                    <option value="Full-time">Full-time</option>
                    <option value="Contract">Contract</option>
                    <option value="Part-time">Part-time</option>
                    <option value="Internship">Internship</option>
                </select>
            </div>

            <div>
                <label asp-for="Input.ExperienceLevel" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Seniority Level <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.ExperienceLevel" class="form-select">
                    <option value="Senior">Senior</option>
                    <option value="Staff / Principal">Staff / Principal</option>
                    <option value="Mid-Level">Mid-Level</option>
                    <option value="Junior">Junior</option>
                    <option value="Lead / Executive">Lead / Executive</option>
                </select>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.LanguageRequirements" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Language Requirements <span style="color: #f87171;">*</span>
                </label>
                <input asp-for="Input.LanguageRequirements" class="form-control" placeholder="e.g. English, French & English" />
            </div>

            <div>
                <label asp-for="Input.SortOrder" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Display Sort Order
                </label>
                <input asp-for="Input.SortOrder" type="number" min="1" class="form-control" />
            </div>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Summary" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Directory Card Summary
            </label>
            <textarea asp-for="Input.Summary" rows="3" placeholder="Brief 1-2 sentence lead text appearing on public career directory cards..." 
                      class="form-control"></textarea>
            <span asp-validation-for="Input.Summary" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.DescriptionHtml" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Job Description (HTML) <span style="color: #f87171;">*</span>
            </label>
            <textarea asp-for="Input.DescriptionHtml" rows="8" placeholder="Detailed role description in HTML..." 
                      class="form-control" style="font-family: monospace; font-size: 13px; line-height: 1.5;"></textarea>
            <span asp-validation-for="Input.DescriptionHtml" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.ResponsibilitiesText" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Core Responsibilities (One item per line)
                </label>
                <textarea asp-for="Input.ResponsibilitiesText" rows="6" placeholder="Design highly available distributed data partitions&#10;Implement end-to-end telemetry and tracing&#10;Conduct security and load reviews" 
                          class="form-control"></textarea>
            </div>

            <div>
                <label asp-for="Input.QualificationsText" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Required Qualifications (One item per line)
                </label>
                <textarea asp-for="Input.QualificationsText" rows="6" placeholder="5+ years building distributed backend services with C# and .NET&#10;Deep expertise in PostgreSQL or SQL Server concurrency&#10;Proven track record designing zero-trust SaaS systems" 
                          class="form-control"></textarea>
            </div>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.BenefitsText" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Benefits & Compensation Perks (One item per line)
            </label>
            <textarea asp-for="Input.BenefitsText" rows="4" placeholder="Competitive USD compensation package with annual review&#10;Full hardware setup allowance (MacBook Pro or high-spec Linux)&#10;Flexible remote working hours across timezones&#10;Comprehensive global health and wellness coverage" 
                      class="form-control"></textarea>
        </div>

        <div style="margin-bottom: 24px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 12px 16px;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--admin-text); cursor: pointer;">
                <input type="checkbox" asp-for="Input.IsActive" style="accent-color: var(--admin-accent); width: 16px; height: 16px;" />
                Actively accepting applications (published to careers board)
            </label>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <a href="/centralwks/careers/openings" class="btn-admin btn-admin-secondary">Cancel</a>
            <button type="submit" class="btn-admin btn-admin-primary">Post Opportunity</button>
        </div>
    </form>
</div>

<script>
    const titleInput = document.getElementById('jobTitleInput');
    const slugInput = document.getElementById('jobSlugInput');

    titleInput?.addEventListener('input', function() {
        if (!slugInput.value || slugInput.dataset.touched !== 'true') {
            slugInput.value = this.value.toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '');
        }
    });

    slugInput?.addEventListener('input', () => slugInput.dataset.touched = 'true');
</script>
