@page "{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Billing.DetailsModel
@{
    ViewData["Title"] = $"Invoice {Model.Transaction.InvoiceNumber ?? Model.Transaction.Id.ToString().Substring(0, 8)}";
    ViewData["BreadcrumbSection"] = "Billing";

    var isCompleted = string.Equals(Model.Transaction.Status, "Completed", StringComparison.OrdinalIgnoreCase);
    var isPending = string.Equals(Model.Transaction.Status, "Pending", StringComparison.OrdinalIgnoreCase);
    var isRefunded = string.Equals(Model.Transaction.Status, "Refunded", StringComparison.OrdinalIgnoreCase);
    var isFailed = string.Equals(Model.Transaction.Status, "Failed", StringComparison.OrdinalIgnoreCase);

    var badgeClass = isCompleted ? "badge-success" : (isPending ? "badge-warning" : (isRefunded ? "badge-info" : "badge-danger"));
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Invoice & Settlement Details</h1>
        <p class="admin-subtitle">Master ledger transaction reference #@(Model.Transaction.InvoiceNumber ?? Model.Transaction.Id.ToString())</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/billing" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Ledger
        </a>
        <button onclick="window.print()" class="btn-admin btn-admin-secondary">
            <span>🖨️</span> Print Invoice
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    @* ── Left: Formal Printable Invoice Card ── *@
    <div>
        <div class="admin-card" style="padding: 32px; background: rgba(15, 23, 42, 0.7); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px;">
            @* Invoice Header *@
            <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid rgba(255, 255, 255, 0.08); padding-bottom: 24px; margin-bottom: 24px;">
                <div>
                    <div style="font-size: 24px; font-weight: 800; color: #fff; letter-spacing: -0.5px; display: flex; align-items: center; gap: 8px;">
                        <span style="color: var(--admin-primary); font-size: 28px;">⚡</span> OZIKOL
                    </div>
                    <p style="font-size: 13px; color: var(--admin-text-muted); margin: 4px 0 0 0;">Autonomous Sovereign Multi-Tenant Cloud</p>
                    <p style="font-size: 12px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Central Financial & Settlement Portal</p>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 20px; font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 1px;">INVOICE</div>
                    <div style="font-size: 14px; font-family: monospace; color: var(--admin-primary); font-weight: 600; margin-top: 4px;">
                        @(Model.Transaction.InvoiceNumber ?? "PENDING-REF")
                    </div>
                    <div style="margin-top: 8px;">
                        <span class="badge @badgeClass" style="font-size: 12px; padding: 4px 10px;">@Model.Transaction.Status</span>
                    </div>
                </div>
            </div>

            @* Billed To & Dates *@
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 32px;">
                <div>
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; color: var(--admin-text-muted); margin-bottom: 8px;">Billed To (Tenant)</div>
                    @if (Model.Transaction.Tenant != null)
                    {
                        <div style="font-size: 16px; font-weight: 600; color: #fff;">@Model.Transaction.Tenant.OrganizationName</div>
                        <div style="font-size: 13px; color: var(--admin-text-muted); margin-top: 2px;">Domain: @Model.Transaction.Tenant.PrimaryDomain</div>
                        <div style="font-size: 13px; color: var(--admin-text-muted);">Database: @Model.Transaction.Tenant.DatabaseName</div>
                        <div style="font-size: 13px; color: var(--admin-text-muted);">Status: @(Model.Transaction.Tenant.IsActive ? "Active" : "Suspended")</div>
                    }
                    else
                    {
                        <div style="font-size: 14px; color: var(--admin-text-muted); font-style: italic;">Tenant #@Model.Transaction.MasterTenantCatalogId (Archived / Unspecified)</div>
                    }
                </div>

                <div style="text-align: right;">
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px; color: var(--admin-text-muted); margin-bottom: 8px;">Invoice Summary</div>
                    <div style="font-size: 13px; color: var(--admin-text-muted); margin-bottom: 4px;">
                        Issue Date: <span style="color: #fff; font-weight: 500;">@Model.Transaction.CreatedUtc.ToString("MMMM dd, yyyy HH:mm") UTC</span>
                    </div>
                    <div style="font-size: 13px; color: var(--admin-text-muted); margin-bottom: 4px;">
                        Settlement Provider: <span style="color: #fff; font-weight: 500;">@(Model.Transaction.PaymentProvider ?? "Direct / Manual")</span>
                    </div>
                    @if (Model.Transaction.UpdatedUtc.HasValue)
                    {
                        <div style="font-size: 13px; color: var(--admin-text-muted);">
                            Last Updated: <span style="color: #fff; font-weight: 500;">@Model.Transaction.UpdatedUtc.Value.ToString("MMMM dd, yyyy HH:mm") UTC</span>
                        </div>
                    }
                </div>
            </div>

            @* Line Items Table *@
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 32px;">
                <thead>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.1); text-align: left;">
                        <th style="padding: 12px 8px; font-size: 12px; text-transform: uppercase; color: var(--admin-text-muted); font-weight: 600;">Description</th>
                        <th style="padding: 12px 8px; font-size: 12px; text-transform: uppercase; color: var(--admin-text-muted); font-weight: 600; text-align: center;">Cycle / Scope</th>
                        <th style="padding: 12px 8px; font-size: 12px; text-transform: uppercase; color: var(--admin-text-muted); font-weight: 600; text-align: right;">Amount (@Model.Transaction.Currency)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                        <td style="padding: 16px 8px;">
                            @if (Model.Transaction.FeatureSubscription != null)
                            {
                                <div style="font-weight: 600; color: #fff;">
                                    @(Model.Transaction.FeatureSubscription.MasterFeatureCatalog?.Name ?? "Modular Feature Subscription")
                                </div>
                                <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 2px;">
                                    Subscription ID: @Model.Transaction.FeatureSubscription.Id
                                </div>
                            }
                            else
                            {
                                <div style="font-weight: 600; color: #fff;">Platform License / Manual Adjustment</div>
                                <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 2px;">
                                    @(Model.Transaction.Notes ?? "General ledger credit or settlement")
                                </div>
                            }
                        </td>
                        <td style="padding: 16px 8px; text-align: center; color: var(--admin-text-muted); font-size: 13px;">
                            @(Model.Transaction.FeatureSubscription?.DurationType.ToString() ?? "Ad-hoc")
                        </td>
                        <td style="padding: 16px 8px; text-align: right; font-weight: 600; font-size: 15px; color: @(Model.Transaction.Amount >= 0 ? "#fff" : "var(--admin-danger)");">
                            @Model.Transaction.Amount.ToString("N2")
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr style="border-top: 2px solid rgba(255, 255, 255, 0.15);">
                        <td colspan="2" style="padding: 16px 8px; font-weight: 700; font-size: 16px; color: #fff; text-align: right;">Total Amount Due / Settled:</td>
                        <td style="padding: 16px 8px; font-weight: 800; font-size: 18px; color: var(--admin-primary); text-align: right;">
                            @Model.Transaction.Currency @Model.Transaction.Amount.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>

            @* Payment Verification & Audit Reference *@
            <div style="background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 8px; padding: 16px;">
                <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted); margin-bottom: 6px;">Provider Audit Hash / Reference</div>
                <div style="font-family: monospace; font-size: 13px; color: #38bdf8; word-break: break-all;">
                    @(Model.Transaction.TransactionRef ?? "N/A — No external transaction reference logged")
                </div>
                @if (!string.IsNullOrEmpty(Model.Transaction.Notes))
                {
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted); margin: 12px 0 4px 0;">Audit Notes</div>
                    <div style="font-size: 13px; color: var(--admin-text-muted); line-height: 1.5;">@Model.Transaction.Notes</div>
                }
            </div>
        </div>
    </div>

    @* ── Right: Admin Management & Status Controls ── *@
    <div>
        <div class="admin-card" style="margin-bottom: 24px;">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">⚙️</div>
                <div>
                    <h3 class="card-header-title">Settlement Actions</h3>
                    <p class="card-header-subtitle">Update transaction state in the master ledger.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                @if (isPending)
                {
                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Transaction.Id" asp-route-newStatus="Completed" style="margin-bottom: 12px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; justify-content: center;" onclick="return confirm('Confirm settlement and mark transaction as Completed?')">
                            <span>✅</span> Mark as Completed (Settled)
                        </button>
                    </form>

                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Transaction.Id" asp-route-newStatus="Failed" style="margin-bottom: 12px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-danger" style="width: 100%; justify-content: center;" onclick="return confirm('Mark this transaction as Failed / Voided?')">
                            <span>❌</span> Mark as Failed / Voided
                        </button>
                    </form>
                }
                else if (isCompleted)
                {
                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Transaction.Id" asp-route-newStatus="Refunded" style="margin-bottom: 12px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-warning" style="width: 100%; justify-content: center;" onclick="return confirm('Issue refund and flag this transaction as Refunded?')">
                            <span>🔄</span> Mark as Refunded
                        </button>
                    </form>

                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Transaction.Id" asp-route-newStatus="Pending">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center;">
                            <span>⏳</span> Revert to Pending
                        </button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@Model.Transaction.Id" asp-route-newStatus="Completed" style="margin-bottom: 12px;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; justify-content: center;">
                            <span>✅</span> Re-open as Completed
                        </button>
                    </form>
                }
            </div>
        </div>

        @* Tenant Fast Link *@
        @if (Model.Transaction.Tenant != null)
        {
            <div class="admin-card">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">🏢</div>
                    <div>
                        <h3 class="card-header-title">Tenant Context</h3>
                        <p class="card-header-subtitle">Quick access to organization details.</p>
                    </div>
                </div>

                <div style="padding: 20px;">
                    <div style="font-weight: 600; font-size: 15px; color: #fff;">@Model.Transaction.Tenant.OrganizationName</div>
                    <div style="font-size: 12px; color: var(--admin-text-muted); margin: 4px 0 16px 0;">Domain: @Model.Transaction.Tenant.PrimaryDomain</div>

                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <a href="/centralwks/tenants/details/@Model.Transaction.Tenant.Id" class="btn-admin btn-admin-secondary" style="justify-content: center;">
                            View Tenant Details
                        </a>
                        <a href="/centralwks/tenants/features/@Model.Transaction.Tenant.Id" class="btn-admin btn-admin-secondary" style="justify-content: center;">
                            Manage Subscriptions
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
