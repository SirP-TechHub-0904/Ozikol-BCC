@page
@model Ozikol.Central.Areas.Centralwks.Pages.Billing.CreateModel
@{
    ViewData["Title"] = "Record Billing Transaction";
    ViewData["BreadcrumbSection"] = "Billing";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Record Financial Transaction</h1>
        <p class="admin-subtitle">Issue manual invoices, record offline wire settlements, log gateway debits, or process manual tenant refunds.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/billing" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Ledger
        </a>
    </div>
</div>

<form method="post" style="max-width: 800px;">
    @Html.AntiForgeryToken()

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(139, 92, 246, 0.15); color: #a78bfa;">🏢</div>
            <div>
                <h3 class="card-header-title">Target Tenant & Allocation</h3>
                <p class="card-header-subtitle">Assign this transaction to a sovereign tenant database and an optional active feature subscription.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="Input.TenantId" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Tenant Organization <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                </label>
                <select asp-for="Input.TenantId" asp-items="Model.TenantOptions" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                    <option value="">-- Select Sovereign Tenant Organization --</option>
                </select>
                <span asp-validation-for="Input.TenantId" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
            </div>

            <div class="form-group" style="margin-bottom: 8px;">
                <label asp-for="Input.SubscriptionId" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Linked Feature Subscription (Optional)
                </label>
                <select asp-for="Input.SubscriptionId" asp-items="Model.SubscriptionOptions" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                    <option value="">-- General Account Balance / No Specific Subscription --</option>
                </select>
                <span asp-validation-for="Input.SubscriptionId" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Link this payment directly to an active feature subscription cycle, or leave blank for platform credit.</span>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">💵</div>
            <div>
                <h3 class="card-header-title">Financial Particulars</h3>
                <p class="card-header-subtitle">Specify currency, amount, settlement gateway, and provider reference identifiers.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.Amount" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Amount <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <div style="position: relative;">
                        <input asp-for="Input.Amount" type="number" step="0.01" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Input.Amount" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Use positive amounts for payments or adjustments, negative amounts for refunds.</span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Currency" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Currency Code <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <select asp-for="Input.Currency" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                        <option value="USD">USD - US Dollar ($)</option>
                        <option value="EUR">EUR - Euro (€)</option>
                        <option value="GBP">GBP - British Pound (£)</option>
                        <option value="NGN">NGN - Nigerian Naira (₦)</option>
                        <option value="ZAR">ZAR - South African Rand (R)</option>
                        <option value="CAD">CAD - Canadian Dollar ($)</option>
                        <option value="AUD">AUD - Australian Dollar ($)</option>
                    </select>
                    <span asp-validation-for="Input.Currency" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.PaymentProvider" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Payment Provider / Channel <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <select asp-for="Input.PaymentProvider" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                        <option value="Stripe">Stripe Gateway</option>
                        <option value="PayPal">PayPal</option>
                        <option value="Flutterwave">Flutterwave</option>
                        <option value="BankTransfer">Direct Bank Wire / SWIFT</option>
                        <option value="Manual">Manual Operator Credit</option>
                        <option value="SystemCredit">System Promo / Courtesy Credit</option>
                    </select>
                    <span asp-validation-for="Input.PaymentProvider" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Status" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Settlement Status <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <select asp-for="Input.Status" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;">
                        <option value="Completed">Completed (Settled)</option>
                        <option value="Pending">Pending Verification</option>
                        <option value="Refunded">Refunded</option>
                        <option value="Failed">Failed / Voided</option>
                    </select>
                    <span asp-validation-for="Input.Status" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="Input.TransactionRef" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    External Reference ID / Wire Confirmation
                </label>
                <input asp-for="Input.TransactionRef" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px; font-family: monospace;" placeholder="e.g. ch_3N5d7vF9a4bc or WIRE-20260908-01" />
                <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Leave empty to automatically generate an internal audit reference hash.</span>
            </div>

            <div class="form-group" style="margin-bottom: 8px;">
                <label asp-for="Input.Notes" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Internal Memo / Audit Notes
                </label>
                <textarea asp-for="Input.Notes" rows="3" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="Optional notes regarding the purpose of this manual invoice or reconciliation details..."></textarea>
                <span asp-validation-for="Input.Notes" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
        <a href="/centralwks/billing" class="btn-admin btn-admin-secondary">Cancel</a>
        <button type="submit" class="btn-admin btn-admin-primary">
            <span>💾</span> Save Transaction & Generate Invoice
        </button>
    </div>
</form>
