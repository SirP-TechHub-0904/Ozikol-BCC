@page
@model Ozikol.Central.Areas.Centralwks.Pages.Billing.CreateModel
@{
    ViewData["Title"] = "Record Billing Transaction";
    ViewData["BreadcrumbSection"] = "Billing";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Record Financial Transaction</h1>
        <p class="admin-subtitle">Issue manual invoices, record offline wire settlements, log gateway debits, or process manual tenant refunds.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/billing" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
            Back to Ledger
        </a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25); color: var(--admin-danger); border-radius: var(--radius-md); padding: 14px 18px; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px; font-weight: 600;">
                <span class="material-symbols-outlined" style="font-size: 20px;">error</span>
                Please resolve the following issues:
            </div>
            <div asp-validation-summary="All" style="margin: 0; padding-left: 28px; font-size: 13px;"></div>
        </div>
    }

    <div style="display: grid; grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr); gap: 24px; align-items: start;">
        <!-- Left / Primary Column -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Tenant & Allocation Card -->
            <div class="admin-card" style="margin-bottom: 0;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(99, 102, 241, 0.12); color: var(--admin-indigo);">
                        <span class="material-symbols-outlined" style="font-size: 20px;">domain</span>
                    </div>
                    <div>
                        <h3 class="card-header-title">Target Tenant &amp; Allocation</h3>
                        <p class="card-header-subtitle">Assign this transaction to a tenant database and an optional active feature subscription.</p>
                    </div>
                </div>

                <div class="admin-card-body">
                    <div class="form-group" style="margin-bottom: 20px;">
                        <label asp-for="Input.TenantId" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                            Tenant Organization <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                        </label>
                        <select asp-for="Input.TenantId" asp-items="Model.TenantOptions" class="form-select">
                            <option value="">-- Select Tenant Organization --</option>
                        </select>
                        <span asp-validation-for="Input.TenantId" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label asp-for="Input.SubscriptionId" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                            Linked Feature Subscription (Optional)
                        </label>
                        <select asp-for="Input.SubscriptionId" asp-items="Model.SubscriptionOptions" class="form-select">
                            <option value="">-- General Account Balance / No Specific Subscription --</option>
                        </select>
                        <span asp-validation-for="Input.SubscriptionId" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                        <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 6px; display: block;">Link this payment directly to an active feature subscription cycle, or leave blank for platform credit.</span>
                    </div>
                </div>
            </div>

            <!-- Financial Particulars Card -->
            <div class="admin-card" style="margin-bottom: 0;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success);">
                        <span class="material-symbols-outlined" style="font-size: 20px;">payments</span>
                    </div>
                    <div>
                        <h3 class="card-header-title">Financial Particulars &amp; Channel</h3>
                        <p class="card-header-subtitle">Specify settlement currency, total amount, payment channel, and reconciliation state.</p>
                    </div>
                </div>

                <div class="admin-card-body">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div class="form-group">
                            <label asp-for="Input.Amount" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                                Amount <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                            </label>
                            <input asp-for="Input.Amount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            <span asp-validation-for="Input.Amount" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                            <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 6px; display: block;">Positive amounts for payments or adjustments; negative for refunds.</span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Currency" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                                Currency Code <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                            </label>
                            <select asp-for="Input.Currency" class="form-select">
                                <option value="USD">USD - US Dollar ($)</option>
                                <option value="EUR">EUR - Euro (€)</option>
                                <option value="GBP">GBP - British Pound (£)</option>
                                <option value="NGN">NGN - Nigerian Naira (₦)</option>
                                <option value="ZAR">ZAR - South African Rand (R)</option>
                                <option value="CAD">CAD - Canadian Dollar ($)</option>
                                <option value="AUD">AUD - Australian Dollar ($)</option>
                            </select>
                            <span asp-validation-for="Input.Currency" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div class="form-group">
                            <label asp-for="Input.PaymentProvider" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                                Payment Provider / Channel <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                            </label>
                            <select asp-for="Input.PaymentProvider" class="form-select">
                                <option value="BankTransfer">Direct Bank Wire / SWIFT</option>
                                <option value="Stripe">Stripe Gateway</option>
                                <option value="PayPal">PayPal</option>
                                <option value="Flutterwave">Flutterwave</option>
                                <option value="Manual">Manual Operator Credit</option>
                                <option value="SystemCredit">System Promo / Courtesy Credit</option>
                            </select>
                            <span asp-validation-for="Input.PaymentProvider" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Status" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                                Settlement Status <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                            </label>
                            <select asp-for="Input.Status" class="form-select">
                                <option value="Completed">Completed (Settled)</option>
                                <option value="Pending">Pending Verification</option>
                                <option value="Refunded">Refunded</option>
                                <option value="Failed">Failed / Voided</option>
                            </select>
                            <span asp-validation-for="Input.Status" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                        </div>
                    </div>

                    <div class="form-group" style="margin-bottom: 20px;">
                        <label asp-for="Input.TransactionRef" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                            External Reference ID / Wire Confirmation
                        </label>
                        <input asp-for="Input.TransactionRef" class="form-control" style="font-family: monospace;" placeholder="e.g. WIRE-20260918-01 or ch_3N5d7vF9a4bc" />
                        <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 6px; display: block;">Leave blank to automatically generate an internal cryptographic audit hash.</span>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label asp-for="Input.Notes" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: var(--admin-text);">
                            Internal Memo / Audit Notes
                        </label>
                        <textarea asp-for="Input.Notes" rows="3" class="form-control" placeholder="Optional notes regarding the purpose of this manual invoice or reconciliation details..."></textarea>
                        <span asp-validation-for="Input.Notes" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right / Sidebar Column -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Actions & Execution Card -->
            <div class="admin-card" style="margin-bottom: 0;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(245, 158, 11, 0.12); color: var(--admin-warning);">
                        <span class="material-symbols-outlined" style="font-size: 20px;">task_alt</span>
                    </div>
                    <div>
                        <h3 class="card-header-title">Post Transaction</h3>
                        <p class="card-header-subtitle">Commit entry to the master ledger.</p>
                    </div>
                </div>

                <div class="admin-card-body">
                    <div style="margin-bottom: 16px;">
                        <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 18px; font-size: 14px; font-weight: 600;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                            Save &amp; Generate Invoice
                        </button>
                    </div>

                    <div>
                        <a href="/centralwks/billing" class="btn-admin btn-admin-secondary" style="width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 18px; font-size: 13px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
                            Cancel
                        </a>
                    </div>

                    <div style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--admin-border); display: flex; flex-direction: column; gap: 10px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 12px;">
                            <span style="color: var(--admin-text-muted);">Invoice Format:</span>
                            <span style="color: var(--admin-text); font-family: monospace; font-weight: 600;">INV-@DateTime.UtcNow.ToString("yyyyMM")-XXXXX</span>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 12px;">
                            <span style="color: var(--admin-text-muted);">Timestamp:</span>
                            <span style="color: var(--admin-text); font-weight: 500;">@DateTime.UtcNow.ToString("MMM dd, yyyy HH:mm") UTC</span>
                        </div>
                        <div style="display: flex; align-items: center; justify-content: space-between; font-size: 12px;">
                            <span style="color: var(--admin-text-muted);">Audit Trail:</span>
                            <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: var(--radius-sm);">Automated</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ledger Compliance & Guide Card -->
            <div class="admin-card" style="margin-bottom: 0;">
                <div class="card-header-styled">
                    <div class="card-header-icon" style="background: rgba(14, 165, 233, 0.12); color: var(--admin-info);">
                        <span class="material-symbols-outlined" style="font-size: 20px;">info</span>
                    </div>
                    <div>
                        <h3 class="card-header-title">Reconciliation Notes</h3>
                        <p class="card-header-subtitle">Standard ledger guidelines.</p>
                    </div>
                </div>

                <div class="admin-card-body" style="font-size: 12.5px; color: var(--admin-text-muted); line-height: 1.6;">
                    <div style="display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px;">
                        <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-indigo); flex-shrink: 0; margin-top: 1px;">receipt_long</span>
                        <div><strong>Invoice Generation:</strong> Saving will immediately create a master ledger invoice record with a verifiable audit hash.</div>
                    </div>
                    <div style="display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px;">
                        <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-success); flex-shrink: 0; margin-top: 1px;">account_balance</span>
                        <div><strong>Wire Reconciliations:</strong> Use the bank swift confirmation code as the External Reference ID to ease monthly statement audits.</div>
                    </div>
                    <div style="display: flex; align-items: flex-start; gap: 10px;">
                        <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-warning); flex-shrink: 0; margin-top: 1px;">currency_exchange</span>
                        <div><strong>Multi-Currency Settlement:</strong> The amount will be booked in the chosen ISO currency and reflected in tenant statements.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

