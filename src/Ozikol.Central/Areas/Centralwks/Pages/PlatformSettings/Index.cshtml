<script>
    function setTrialDays(days) {
        var input = document.getElementById('trialDaysInput');
        if (input) {
            input.value = days;
            input.dispatchEvent(new Event('input', { bubbles: true }));
            updateActivePreset(days);
        }
    }

    function updateActivePreset(activeDays) {
        var buttons = document.querySelectorAll('.trial-preset-btn');
        buttons.forEach(function(btn) {
            var days = parseInt(btn.getAttribute('data-days'), 10);
            if (days === parseInt(activeDays, 10)) {
                btn.style.background = 'var(--admin-primary)';
                btn.style.color = '#ffffff';
                btn.style.borderColor = 'var(--admin-primary)';
            } else {
                btn.style.background = 'var(--admin-bg-surface-elevated)';
                btn.style.color = 'var(--admin-text)';
                btn.style.borderColor = 'var(--admin-border)';
            }
        });
    }

    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        if (!input) return;
        var icon = btn.querySelector('.material-symbols-outlined');
        if (input.type === 'password') {
            input.type = 'text';
            if (icon) icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            if (icon) icon.textContent = 'visibility';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        var input = document.getElementById('trialDaysInput');
        if (input) {
            updateActivePreset(input.value);
            input.addEventListener('input', function() {
                updateActivePreset(input.value);
            });
        }
    });
</script>
