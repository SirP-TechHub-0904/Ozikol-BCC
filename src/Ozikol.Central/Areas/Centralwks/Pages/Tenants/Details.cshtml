@page
@model Ozikol.Central.Areas.Centralwks.Pages.Tenants.DetailsModel
@{
    ViewData["Title"] = $"{Model.Tenant.OrganizationName} — Tenant Governance";
    ViewData["BreadcrumbSection"] = "Tenants";
    var isSuspended = Model.Tenant.IsSuspended || !Model.Tenant.IsActive;
}

<div class="admin-page-header" style="margin-bottom: 20px;">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <h1 class="admin-title" style="margin: 0;">@Model.Tenant.OrganizationName</h1>
            @if (Model.Tenant.IsDeleted)
            {
                <span class="badge badge-danger">
                    <span class="badge-dot" style="background-color: var(--admin-danger);"></span>
                    Deactivated (Soft-Deleted)
                </span>
            }
            else if (isSuspended)
            {
                <span class="badge badge-warning" title="@Model.Tenant.SuspensionReason">
                    <span class="badge-dot" style="background-color: var(--admin-warning);"></span>
                    Suspended
                </span>
            }
            else
            {
                <span class="badge badge-success">
                    <span class="badge-dot" style="background-color: var(--admin-success);"></span>
                    Active
                </span>
            }
        </div>
        <p class="admin-subtitle" style="margin-top: 6px;">
            Subdomain Key: <code style="color: var(--admin-primary); font-weight: 700; background: var(--admin-bg-surface-elevated); padding: 2px 6px; border-radius: 4px;">@Model.Tenant.TenantKey</code> •
            Database: <span style="font-family: monospace; color: var(--admin-text-muted);">@Model.Tenant.DatabaseName</span>
        </p>
    </div>
    <div class="admin-actions" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <a href="https://@Model.Tenant.PrimaryDomain" target="_blank" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">open_in_new</span>
            Visit Workspace
        </a>
        <a href="/centralwks/tenants/databases/details?tenantKey=@Model.Tenant.TenantKey" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-primary);">database</span>
            Database Health
        </a>
        @if (!Model.Tenant.IsDeleted)
        {
            <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@Model.Id" style="display: inline; margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-admin @(isSuspended ? "btn-admin-primary" : "btn-admin-danger")" onclick="return confirm('Are you sure you want to @(isSuspended ? "reactivate" : "suspend") @Model.Tenant.OrganizationName?');">
                    <span class="material-symbols-outlined" style="font-size: 16px;">@(isSuspended ? "play_circle" : "pause_circle")</span>
                    @(isSuspended ? "Reactivate Organization" : "Suspend Organization")
                </button>
            </form>
        }
    </div>
</div>

@* ── Material Segmented Navigation Tabs ── *@
<div class="material-tabs-container" style="margin-bottom: 24px; border-bottom: 1px solid var(--admin-border); display: flex; gap: 8px; overflow-x: auto;">
    <button type="button" class="tab-btn active" data-tab="tab-overview" onclick="switchTenantTab('tab-overview', this);">
        <span class="material-symbols-outlined" style="font-size: 18px;">dashboard</span>
        Overview &amp; Profile
    </button>
    <button type="button" class="tab-btn" data-tab="tab-governance" onclick="switchTenantTab('tab-governance', this);">
        <span class="material-symbols-outlined" style="font-size: 18px;">admin_panel_settings</span>
        Lifecycle Governance
    </button>
    <button type="button" class="tab-btn" data-tab="tab-features" onclick="switchTenantTab('tab-features', this);">
        <span class="material-symbols-outlined" style="font-size: 18px;">toggle_on</span>
        Modular Features (@(Model.FeatureMatrix.Count(f => f.IsActive)))
    </button>
    <button type="button" class="tab-btn" data-tab="tab-billing" onclick="switchTenantTab('tab-billing', this);">
        <span class="material-symbols-outlined" style="font-size: 18px;">receipt_long</span>
        Billing &amp; Ledger (@Model.BillingTransactions.Count)
    </button>
    <button type="button" class="tab-btn" data-tab="tab-logs" onclick="switchTenantTab('tab-logs', this);">
        <span class="material-symbols-outlined" style="font-size: 18px;">history</span>
        Audit &amp; Trace Logs (@Model.AuditLogs.Count)
    </button>
    <button type="button" class="tab-btn" data-tab="tab-errors" onclick="switchTenantTab('tab-errors', this);">
        <span class="material-symbols-outlined" style="font-size: 18px;">bug_report</span>
        API Error Logs (@Model.ApiErrorLogs.Count)
    </button>
    <button type="button" class="tab-btn" data-tab="tab-consumption" onclick="switchTenantTab('tab-consumption', this);">
        <span class="material-symbols-outlined" style="font-size: 18px;">monitoring</span>
        Resource Consumption
    </button>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 1: OVERVIEW & PROFILE
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="tenant-tab-content active" id="tab-overview">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 24px;">
        @* Card 1: Domains & Networking *@
        <div class="admin-card" style="margin: 0;">
            <div class="admin-card-header" style="padding: 14px 20px;">
                <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px;">
                    <span class="material-symbols-outlined" style="color: var(--admin-primary); font-size: 18px;">language</span>
                    Domains &amp; Networking
                </div>
            </div>
            <div class="admin-card-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Primary Platform Domain</span>
                    <a href="https://@Model.Tenant.PrimaryDomain" target="_blank" style="font-weight: 600; color: var(--admin-primary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                        @Model.Tenant.PrimaryDomain
                        <span class="material-symbols-outlined" style="font-size: 14px;">open_in_new</span>
                    </a>
                </div>
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Custom Mapped Domain</span>
                    @if (!string.IsNullOrEmpty(Model.Tenant.CustomDomain))
                    {
                        <div style="font-weight: 600; color: var(--admin-success); display: flex; align-items: center; gap: 4px;">
                            <span class="material-symbols-outlined" style="font-size: 14px;">verified</span>
                            @Model.Tenant.CustomDomain
                        </div>
                    }
                    else
                    {
                        <span style="color: var(--admin-text-muted);">None mapped (using primary domain)</span>
                    }
                </div>
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Website URL</span>
                    <div>@(Model.Tenant.WebsiteUrl ?? "Default Platform Web App")</div>
                </div>
            </div>
        </div>

        @* Card 2: Database & Identity Details *@
        <div class="admin-card" style="margin: 0;">
            <div class="admin-card-header" style="padding: 14px 20px;">
                <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px;">
                    <span class="material-symbols-outlined" style="color: var(--admin-info); font-size: 18px;">storage</span>
                    Database &amp; Identity
                </div>
            </div>
            <div class="admin-card-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Database Name</span>
                    <code style="display: block; color: var(--admin-text); background: var(--admin-bg-surface-elevated); padding: 4px 8px; border-radius: 4px; font-weight: 600;">
                        @Model.Tenant.DatabaseName
                    </code>
                    <div style="margin-top: 6px;">
                        <a href="/centralwks/tenants/databases/details?tenantKey=@Model.Tenant.TenantKey#editConnection" class="btn-admin btn-admin-secondary btn-admin-sm" style="display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px;">
                            <span class="material-symbols-outlined" style="font-size: 14px; color: var(--admin-primary);">tune</span>
                            Edit Connection String
                        </a>
                    </div>
                </div>
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Primary Admin Email</span>
                    <div style="font-weight: 500;">@(Model.Tenant.AdminEmail ?? "Not specified")</div>
                </div>
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Affiliate Partner Code</span>
                    <div style="font-weight: 500;">@(Model.Tenant.ReferredByPartnerCode ?? "Organic / Direct Platform Sign-up")</div>
                </div>
            </div>
        </div>

        @* Card 3: Strict Timestamps & User Attribution *@
        <div class="admin-card" style="margin: 0;">
            <div class="admin-card-header" style="padding: 14px 20px;">
                <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px;">
                    <span class="material-symbols-outlined" style="color: var(--admin-success); font-size: 18px;">schedule</span>
                    Timestamps &amp; Audit Trail
                </div>
            </div>
            <div class="admin-card-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; font-size: 13px;">
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Provisioned Date (UTC)</span>
                    <div style="font-weight: 600;">@Model.Tenant.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                    <span style="font-size: 11.5px; color: var(--admin-text-dim);">By: @(Model.Tenant.CreatedBy ?? "Onboarding Gateway")</span>
                </div>
                <div>
                    <span style="color: var(--admin-text-dim); font-size: 12px; display: block; margin-bottom: 2px;">Last Modified (UTC)</span>
                    @if (Model.Tenant.UpdatedUtc.HasValue)
                    {
                        <div style="font-weight: 600;">@Model.Tenant.UpdatedUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                        <span style="font-size: 11.5px; color: var(--admin-text-dim);">By: @(Model.Tenant.LastUpdatedBy ?? "SuperAdmin")</span>
                    }
                    else
                    {
                        <span style="color: var(--admin-text-muted);">Never modified since provisioning</span>
                    }
                </div>
                @if (Model.Tenant.IsSuspended && Model.Tenant.SuspendedUtc.HasValue)
                {
                    <div style="padding: 10px; background: rgba(234, 179, 8, 0.1); border-left: 3px solid var(--admin-warning); border-radius: 4px;">
                        <span style="font-weight: 600; color: var(--admin-warning); display: block; font-size: 12px;">Suspension Details</span>
                        <div style="font-size: 12px;">Suspended on @Model.Tenant.SuspendedUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC by @(Model.Tenant.SuspendedBy ?? "Admin")</div>
                        <div style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 2px;">Reason: @(Model.Tenant.SuspensionReason ?? "No reason recorded")</div>
                    </div>
                }
                @if (Model.Tenant.IsDeleted && Model.Tenant.DeletedUtc.HasValue)
                {
                    <div style="padding: 10px; background: rgba(239, 68, 68, 0.1); border-left: 3px solid var(--admin-danger); border-radius: 4px;">
                        <span style="font-weight: 600; color: var(--admin-danger); display: block; font-size: 12px;">Deactivation Details</span>
                        <div style="font-size: 12px;">Soft-deleted on @Model.Tenant.DeletedUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC by @(Model.Tenant.DeletedBy ?? "Admin")</div>
                        <div style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 2px;">Reason: @(Model.Tenant.DeletionReason ?? "No reason recorded")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 2: LIFECYCLE GOVERNANCE
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="tenant-tab-content" id="tab-governance">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px;">
        @* Form: Edit Organization Metadata *@
        <div class="admin-card" style="margin: 0;">
            <div class="admin-card-header" style="padding: 16px 20px;">
                <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px;">
                    <span class="material-symbols-outlined" style="color: var(--admin-primary);">edit_note</span>
                    Edit Organization Profile
                </div>
            </div>
            <form method="post" asp-page-handler="UpdateMetadata" style="margin: 0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="admin-card-body" style="padding: 20px; display: flex; flex-direction: column; gap: 16px;">
                    <div class="form-group" style="margin: 0;">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">Organization Display Name</label>
                        <input type="text" name="organizationName" class="form-control" value="@Model.Tenant.OrganizationName" required />
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">Primary Administrator Email</label>
                        <input type="email" name="adminEmail" class="form-control" value="@Model.Tenant.AdminEmail" placeholder="admin@domain.com" />
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">Custom Domain (Optional)</label>
                        <input type="text" name="customDomain" class="form-control" value="@Model.Tenant.CustomDomain" placeholder="portal.clientcompany.com" />
                        <span style="font-size: 11.5px; color: var(--admin-text-dim); display: block; margin-top: 4px;">Must have a CNAME pointing to @Model.Tenant.PrimaryDomain</span>
                    </div>

                    <div class="form-group" style="margin: 0;">
                        <label class="form-label" style="font-weight: 600; font-size: 13px;">Website / Landing URL</label>
                        <input type="url" name="websiteUrl" class="form-control" value="@Model.Tenant.WebsiteUrl" placeholder="https://organization.com" />
                    </div>
                </div>

                <div class="admin-card-footer" style="padding: 14px 20px; border-top: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; justify-content: flex-end;">
                    <button type="submit" class="btn-admin btn-admin-primary btn-admin-sm">
                        <span class="material-symbols-outlined" style="font-size: 16px;">save</span>
                        Save Metadata Changes
                    </button>
                </div>
            </form>
        </div>

        @* Danger & Lifecycle Action Center *@
        <div style="display: flex; flex-direction: column; gap: 20px;">
            @* Action 1: Suspend / Reactivate *@
            <div class="admin-card" style="margin: 0; border-left: 4px solid var(--admin-warning);">
                <div class="admin-card-body" style="padding: 20px;">
                    <div style="font-weight: 700; font-size: 15px; color: var(--admin-text); display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="color: var(--admin-warning);">pause_circle</span>
                        Operational State Control
                    </div>
                    <p style="font-size: 13px; color: var(--admin-text-muted); margin: 8px 0 16px 0;">
                        @(isSuspended ? "This organization is currently suspended. Reactivating it will immediately restore access for all tenant users." : "Temporarily suspend user access. The isolated database remains untouched, and access can be resumed anytime.")
                    </p>

                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@Model.Id" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        @if (!isSuspended)
                        {
                            <div class="form-group" style="margin-bottom: 12px;">
                                <input type="text" name="reason" class="form-control" placeholder="Optional reason for suspension (logged to audit trail)" />
                            </div>
                        }
                        <button type="submit" class="btn-admin @(isSuspended ? "btn-admin-primary" : "btn-admin-secondary") btn-admin-sm" onclick="return confirm('Confirm operational state change?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">@(isSuspended ? "play_circle" : "pause_circle")</span>
                            @(isSuspended ? "Reactivate Workspace" : "Suspend Workspace")
                        </button>
                    </form>
                </div>
            </div>

            @* Action 2: Temporal Soft Delete *@
            <div class="admin-card" style="margin: 0; border-left: 4px solid var(--admin-danger);">
                <div class="admin-card-body" style="padding: 20px;">
                    <div style="font-weight: 700; font-size: 15px; color: var(--admin-text); display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="color: var(--admin-danger);">delete_outline</span>
                        Temporal Deactivation (Soft Delete)
                    </div>
                    <p style="font-size: 13px; color: var(--admin-text-muted); margin: 8px 0 16px 0;">
                        Marks this tenant as deleted across the platform. The dedicated database and historical records are safely preserved in cold storage.
                    </p>

                    <form method="post" asp-page-handler="SoftDelete" asp-route-id="@Model.Id" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <div class="form-group" style="margin-bottom: 12px;">
                            <input type="text" name="reason" class="form-control" placeholder="Reason for deactivation / soft deletion" required />
                        </div>
                        <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm" onclick="return confirm('Are you sure you want to deactivate (soft delete) @Model.Tenant.OrganizationName?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">delete_outline</span>
                            Deactivate Organization
                        </button>
                    </form>
                </div>
            </div>

            @* Action 3: Dangerous Permanent Hard Scrub *@
            <div class="admin-card" style="margin: 0; border: 1px solid var(--admin-danger); background: rgba(239, 68, 68, 0.03);">
                <div class="admin-card-body" style="padding: 20px;">
                    <div style="font-weight: 700; font-size: 15px; color: var(--admin-danger); display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined">delete_forever</span>
                        Permanent Hard Delete &amp; Database Drop
                    </div>
                    <p style="font-size: 13px; color: var(--admin-text); margin: 8px 0 14px 0;">
                        <strong>Warning:</strong> This permanently deletes all master catalog records and attempts to <strong>DROP</strong> the dedicated SQL database <code>@Model.Tenant.DatabaseName</code>. This action cannot be undone.
                    </p>

                    <form method="post" asp-page-handler="PermanentDelete" asp-route-id="@Model.Id" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <div class="form-group" style="margin-bottom: 12px;">
                            <label class="form-label" style="font-size: 12px; font-weight: 600;">Type tenant key <code style="color: var(--admin-danger); font-weight: 700;">@Model.Tenant.TenantKey</code> to confirm:</label>
                            <input type="text" name="confirmKey" class="form-control" placeholder="Enter '@Model.Tenant.TenantKey'" required autocomplete="off" />
                        </div>
                        <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm" onclick="return confirm('CRITICAL WARNING: This will drop the database @Model.Tenant.DatabaseName forever. Are you 100% sure?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">delete_forever</span>
                            Permanently Scrub &amp; Drop Database
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 3: MODULAR FEATURES
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="tenant-tab-content" id="tab-features">
    <div class="admin-card">
        <div class="admin-card-header" style="padding: 16px 20px; display: flex; align-items: center; justify-content: space-between;">
            <div>
                <h3 class="admin-card-title" style="font-size: 15px; margin: 0;">Modular Platform Capabilities</h3>
                <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Toggle capabilities on or off for this organization instance in real time.</p>
            </div>
            <span class="badge badge-info" id="featureActiveBadge">
                @(Model.FeatureMatrix.Count(f => f.IsActive)) Enabled
            </span>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 50px; text-align: center;">S/N</th>
                        <th>Capability Name</th>
                        <th>Feature Code</th>
                        <th>Category</th>
                        <th>Pricing Model</th>
                        <th>Subscription Status</th>
                        <th style="text-align: right;">Toggle Access</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.FeatureMatrix.Count; i++)
                    {
                        var item = Model.FeatureMatrix[i];
                        <tr>
                            <td style="text-align: center;">
                                <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600; font-size: 11.5px;">@(i + 1)</span>
                            </td>
                            <td>
                                <strong style="color: var(--admin-text); font-size: 13.5px;">@item.Feature.Name</strong>
                                @if (!string.IsNullOrEmpty(item.Feature.Description))
                                {
                                    <div style="font-size: 12px; color: var(--admin-text-dim); margin-top: 2px;">@item.Feature.Description</div>
                                }
                            </td>
                            <td>
                                <code style="font-size: 11.5px; padding: 2px 6px; background: var(--admin-bg-surface-elevated); border-radius: 4px;">@item.Feature.FeatureCode</code>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted);">@item.Feature.Category</span>
                            </td>
                            <td>
                                <span style="font-size: 13px; font-weight: 500;">
                                    $@item.Feature.MonthlyPrice.ToString("F2")/mo
                                </span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success" id="badge_@item.Feature.Id">
                                        <span class="badge-dot" style="background-color: var(--admin-success);"></span>
                                        Enabled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" id="badge_@item.Feature.Id">
                                        <span class="badge-dot" style="background-color: var(--admin-text-dim);"></span>
                                        Disabled
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <label class="switch-toggle" style="position: relative; display: inline-block; width: 44px; height: 24px; margin: 0;">
                                    <input type="checkbox" @(item.IsActive ? "checked" : "") onchange="toggleTenantFeature('@item.Feature.Id', this.checked, '@Model.Id');" style="opacity: 0; width: 0; height: 0;" />
                                    <span class="slider" style="position: absolute; cursor: pointer; inset: 0; background-color: #cbd5e1; transition: .25s; border-radius: 24px;"></span>
                                </label>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 4: COMMERCIAL & BILLING
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="tenant-tab-content" id="tab-billing">
    <div class="admin-card">
        <div class="admin-card-header" style="padding: 16px 20px;">
            <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px;">
                <span class="material-symbols-outlined" style="color: var(--admin-success);">receipt_long</span>
                Payment &amp; Billing Transaction Ledger
            </div>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 50px; text-align: center;">S/N</th>
                        <th>Transaction Ref</th>
                        <th>Date (UTC)</th>
                        <th>Amount</th>
                        <th>Currency</th>
                        <th>Payment Method</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.BillingTransactions.Any())
                    {
                        @for (int i = 0; i < Model.BillingTransactions.Count; i++)
                        {
                            var tx = Model.BillingTransactions[i];
                            <tr>
                                <td style="text-align: center;">
                                    <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600; font-size: 11.5px;">@(i + 1)</span>
                                </td>
                                <td>
                                    <code style="font-size: 12px; color: var(--admin-text);">@(tx.TransactionRef ?? tx.InvoiceNumber ?? tx.Id.ToString().Substring(0, 8))</code>
                                </td>
                                <td>@tx.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                <td><strong>@tx.Amount.ToString("N2")</strong></td>
                                <td><span class="badge badge-secondary">@tx.Currency</span></td>
                                <td>@(tx.PaymentProvider ?? "Card / Auto-Debit")</td>
                                <td>
                                    @if (tx.Status == "Success" || tx.Status == "Paid")
                                    {
                                        <span class="badge badge-success"><span class="badge-dot" style="background-color: var(--admin-success);"></span> @tx.Status</span>
                                    }
                                    else if (tx.Status == "Pending")
                                    {
                                        <span class="badge badge-warning"><span class="badge-dot" style="background-color: var(--admin-warning);"></span> @tx.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger"><span class="badge-dot" style="background-color: var(--admin-danger);"></span> @tx.Status</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 32px 20px; color: var(--admin-text-muted);">
                                No payment transactions recorded for this organization yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 5: ERROR & AUDIT LOGS
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="tenant-tab-content" id="tab-logs">
    <div class="admin-card">
        <div class="admin-card-header" style="padding: 16px 20px;">
            <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px;">
                <span class="material-symbols-outlined" style="color: var(--admin-info);">history</span>
                Immutable Audit Trail &amp; Activity History
            </div>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 50px; text-align: center;">S/N</th>
                        <th>Timestamp (UTC)</th>
                        <th>Action Verb</th>
                        <th>Admin User</th>
                        <th>Summary / Details</th>
                        <th>Client IP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AuditLogs.Any())
                    {
                        @for (int i = 0; i < Model.AuditLogs.Count; i++)
                        {
                            var log = Model.AuditLogs[i];
                            <tr>
                                <td style="text-align: center;">
                                    <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600; font-size: 11.5px;">@(i + 1)</span>
                                </td>
                                <td style="white-space: nowrap; font-size: 12.5px;">
                                    @log.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td>
                                    <code style="font-size: 11.5px; padding: 2px 6px; background: var(--admin-bg-surface-elevated); border-radius: 4px; color: var(--admin-primary); font-weight: 600;">
                                        @log.Action
                                    </code>
                                </td>
                                <td>
                                    <div style="font-weight: 600; font-size: 13px;">@(log.UserName ?? "System")</div>
                                </td>
                                <td>
                                    <div style="font-size: 13px; color: var(--admin-text);">@log.Summary</div>
                                </td>
                                <td>
                                    <span style="font-size: 12px; color: var(--admin-text-dim);">@(log.IpAddress ?? "Internal")</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 32px 20px; color: var(--admin-text-muted);">
                                No audit events logged for this tenant yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 5B: TENANT-ISOLATED API ERROR LOGS (Custom Error vs. Real Error)
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="tenant-tab-content" id="tab-errors">
    <div class="admin-card">
        <div class="admin-card-header" style="padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px;">
                <span class="material-symbols-outlined" style="color: var(--admin-danger);">bug_report</span>
                Tenant API Error Logs — Custom Error vs. Real Error (@Model.ApiErrorLogs.Count)
            </div>
            <a href="/centralwks/error-logs?ViewMode=by-tenant&TenantId=@Model.Tenant.Id" class="btn-admin btn-admin-secondary" style="font-size: 12px; text-decoration: none;">
                <span class="material-symbols-outlined" style="font-size: 15px;">open_in_new</span>
                Open in Error Telemetry Center
            </a>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 145px;">Timestamp (UTC)</th>
                        <th style="width: 115px;">Error Code</th>
                        <th style="width: 220px;">Custom Error (Shown to Tenant)</th>
                        <th>Real Error (Central Only)</th>
                        <th style="width: 200px;">Endpoint</th>
                        <th style="width: 150px;">User &amp; IP</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ApiErrorLogs.Any())
                    {
                        @foreach (var err in Model.ApiErrorLogs)
                        {
                            <tr>
                                <td style="white-space: nowrap; font-size: 12px;">
                                    <div style="font-weight: 600;">@err.CreatedUtc.ToString("yyyy-MM-dd")</div>
                                    <div style="color: var(--admin-text-muted);">@err.CreatedUtc.ToString("HH:mm:ss") UTC</div>
                                </td>
                                <td>
                                    <span class="badge badge-danger" style="font-family: monospace; font-size: 12px; font-weight: 800;">@err.ErrorCode</span>
                                    <div style="font-size: 10.5px; color: var(--admin-text-muted); margin-top: 2px;">HTTP @err.HttpStatusCode</div>
                                </td>
                                <td>
                                    <div style="font-weight: 700; font-size: 13px; color: var(--admin-text);">@err.CustomError</div>
                                    <div style="font-size: 11px; color: var(--admin-text-dim); margin-top: 2px;">@err.Category</div>
                                </td>
                                <td>
                                    <div style="font-family: monospace; font-size: 12px; color: #dc2626; background: rgba(220, 38, 38, 0.06); border: 1px solid rgba(220, 38, 38, 0.18); border-radius: 6px; padding: 6px 8px; word-break: break-word;">
                                        @err.RealError
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(err.TraceId))
                                    {
                                        <div style="font-size: 10.5px; color: var(--admin-text-dim); margin-top: 3px;">
                                            Trace: <code>@err.TraceId</code>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge badge-secondary" style="font-size: 10px; font-weight: 700;">@err.HttpMethod</span>
                                    <div style="font-family: monospace; font-size: 11.5px; color: var(--admin-text); margin-top: 3px; word-break: break-all;">@err.Endpoint</div>
                                </td>
                                <td style="font-size: 12px;">
                                    <div style="font-weight: 600;">@(string.IsNullOrWhiteSpace(err.UserEmail) ? "Anonymous" : err.UserEmail)</div>
                                    <div style="color: var(--admin-text-dim); font-size: 11px;">@(err.IpAddress ?? "—")</div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 32px 20px; color: var(--admin-text-muted);">
                                No API errors logged for this tenant organization.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 6: SERVER & RESOURCE CONSUMPTION
   ══════════════════════════════════════════════════════════════════════════ *@
<div class="tenant-tab-content" id="tab-consumption">
    @if (Model.DatabaseDeepDive != null)
    {
        <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 20px;">
            <div class="stat-card">
                <div class="stat-icon-wrapper stat-icon-primary">
                    <span class="material-symbols-outlined">storage</span>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Total DB Storage</span>
                    <span class="stat-value">@Model.DatabaseDeepDive.FormattedTotalStorage</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrapper stat-icon-info">
                    <span class="material-symbols-outlined">table_chart</span>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Physical Tables</span>
                    <span class="stat-value">@Model.DatabaseDeepDive.TotalTablesCount</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrapper stat-icon-success">
                    <span class="material-symbols-outlined">dns</span>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Total Rows / Records</span>
                    <span class="stat-value">@Model.DatabaseDeepDive.FormattedTotalRecords</span>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrapper @(Model.DatabaseDeepDive.IsReachable ? "stat-icon-success" : "stat-icon-danger")">
                    <span class="material-symbols-outlined">@(Model.DatabaseDeepDive.IsReachable ? "network_ping" : "cloud_off")</span>
                </div>
                <div class="stat-details">
                    <span class="stat-label">Connectivity</span>
                    <span class="stat-value" style="font-size: 16px; color: @(Model.DatabaseDeepDive.IsReachable ? "var(--admin-success)" : "var(--admin-danger)");">
                        @(Model.DatabaseDeepDive.IsReachable ? "Online & Reachable" : "Unreachable")
                    </span>
                </div>
            </div>
        </div>

        @* ── Tenant Activity & Ingestion Telemetry Grid ── *@
        <div class="activity-card-grid">
            @* Weekly Distribution Bar Chart *@
            <div class="admin-card" style="margin: 0;">
                <div class="admin-card-header" style="padding: 16px 20px; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px;">
                        <span class="material-symbols-outlined" style="color: var(--admin-primary);">calendar_view_week</span>
                        Days in a Week Volume (Activity Heatmap)
                    </div>
                    @if (Model.DatabaseDeepDive.ActivityDistribution.HasData)
                    {
                        <span class="badge badge-success">
                            Peak: @Model.DatabaseDeepDive.ActivityDistribution.PeakDay
                        </span>
                    }
                </div>
                <div class="admin-card-body" style="padding: 16px 20px;">
                    @if (Model.DatabaseDeepDive.ActivityDistribution.HasData)
                    {
                        <div class="weekday-bar-container">
                            @foreach (var day in Model.DatabaseDeepDive.ActivityDistribution.WeeklyDistribution)
                            {
                                var heightPct = Math.Max(day.Percentage, 4.0);
                                <div class="weekday-bar-col" title="@day.DayName: @day.RecordCount.ToString("N0") records">
                                    <span class="weekday-bar-val">@(day.RecordCount > 0 ? day.RecordCount.ToString("N0") : "-")</span>
                                    <div class="weekday-bar-track">
                                        <div class="weekday-bar-fill @(day.IsPeak ? "is-peak" : "")" style="height: @(heightPct.ToString("F1"))%;"></div>
                                    </div>
                                    <span class="weekday-bar-label" style="@(day.IsPeak ? "color: var(--admin-primary); font-weight: 700;" : "")">@day.ShortName</span>
                                </div>
                            }
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; font-size: 12px; color: var(--admin-text-dim);">
                            <span>Tracked across @Model.DatabaseDeepDive.ActivityDistribution.TrackedTablesCount tables</span>
                            <span>Total Analyzed: <strong>@Model.DatabaseDeepDive.ActivityDistribution.TotalAnalyzedRecords.ToString("N0")</strong> records</span>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 24px 12px; color: var(--admin-text-muted);">
                            <span class="material-symbols-outlined" style="font-size: 30px; color: var(--admin-text-dim); display: block; margin-bottom: 6px;">event_busy</span>
                            <span style="font-size: 12.5px;">No timestamped record activity detected in this database yet.</span>
                        </div>
                    }
                </div>
            </div>

            @* Hourly 24-Hour Time Distribution Bar Curve *@
            <div class="admin-card" style="margin: 0;">
                <div class="admin-card-header" style="padding: 16px 20px; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px;">
                        <span class="material-symbols-outlined" style="color: var(--admin-info);">schedule</span>
                        Time in a Day (24-Hour Peak Ingestion)
                    </div>
                    @if (Model.DatabaseDeepDive.ActivityDistribution.HasData)
                    {
                        <span class="badge badge-warning">
                            Window: @Model.DatabaseDeepDive.ActivityDistribution.PeakHourWindow
                        </span>
                    }
                </div>
                <div class="admin-card-body" style="padding: 16px 20px;">
                    @if (Model.DatabaseDeepDive.ActivityDistribution.HasData)
                    {
                        <div class="hour-timeline-container">
                            @foreach (var hour in Model.DatabaseDeepDive.ActivityDistribution.HourlyDistribution)
                            {
                                var heightPct = Math.Max(hour.Percentage, 3.0);
                                <div class="hour-bar-col" title="@hour.Label UTC (@hour.DisplayLabel): @hour.RecordCount.ToString("N0") records">
                                    <div class="hour-bar-track">
                                        <div class="hour-bar-fill @(hour.IsPeak ? "is-peak" : "")" style="height: @(heightPct.ToString("F1"))%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="hour-timeline-axis">
                            <span>12 AM (00:00)</span>
                            <span>6 AM</span>
                            <span>12 PM (12:00)</span>
                            <span>6 PM</span>
                            <span>11 PM (23:00)</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; font-size: 12px; color: var(--admin-text-dim);">
                            <span>Timeline (UTC Engine Time)</span>
                            <span>Peak Window: <strong>@Model.DatabaseDeepDive.ActivityDistribution.PeakHourWindow</strong></span>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 24px 12px; color: var(--admin-text-muted);">
                            <span class="material-symbols-outlined" style="font-size: 30px; color: var(--admin-text-dim); display: block; margin-bottom: 6px;">query_builder</span>
                            <span style="font-size: 12.5px;">No hourly ingestion telemetry available.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header" style="padding: 16px 20px;">
                <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px;">
                    <span class="material-symbols-outlined" style="color: var(--admin-primary);">analytics</span>
                    Physical Table Breakdown &amp; Storage Share
                </div>
            </div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width: 50px; text-align: center;">S/N</th>
                            <th>Table Name</th>
                            <th>Row Count</th>
                            <th>Allocated Storage</th>
                            <th style="width: 240px;">Storage Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DatabaseDeepDive.Tables.Any())
                        {
                            var maxBytes = Model.DatabaseDeepDive.Tables.Max(t => t.UsedSpaceKb);
                            if (maxBytes <= 0) maxBytes = 1;
                            var topTables = Model.DatabaseDeepDive.Tables.OrderByDescending(t => t.UsedSpaceKb).Take(15).ToList();

                            @for (int i = 0; i < topTables.Count; i++)
                            {
                                var table = topTables[i];
                                var pct = (table.UsedSpaceKb / (double)maxBytes) * 100.0;
                                <tr>
                                    <td style="text-align: center;">
                                        <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600; font-size: 11.5px;">@(i + 1)</span>
                                    </td>
                                    <td>
                                        <code style="font-weight: 600; color: var(--admin-text); font-size: 13px;">@table.FullName</code>
                                    </td>
                                    <td>@table.FormattedRows</td>
                                    <td><strong>@table.FormattedStorage</strong></td>
                                    <td>
                                        <div style="background: var(--admin-border); height: 8px; border-radius: 4px; overflow: hidden; width: 100%;">
                                            <div style="background: var(--admin-primary); height: 100%; width: @(pct.ToString("F1"))%;"></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 24px; color: var(--admin-text-muted);">
                                    No physical user tables found in database.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="admin-card" style="padding: 32px; text-align: center;">
            <span class="material-symbols-outlined" style="font-size: 40px; color: var(--admin-text-dim);">database</span>
            <div style="font-weight: 600; margin-top: 8px;">Database Diagnostics Offline</div>
            <div style="font-size: 13px; color: var(--admin-text-muted); margin-top: 4px;">Unable to fetch real-time SQL metrics for this database.</div>
        </div>
    }
</div>

@section Styles {
    <style>
        .material-tabs-container .tab-btn {
            background: transparent;
            border: none;
            border-bottom: 2px solid transparent;
            padding: 10px 16px;
            font-size: 13.5px;
            font-weight: 600;
            color: var(--admin-text-muted);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            transition: all 0.2s ease;
        }
        .material-tabs-container .tab-btn:hover {
            color: var(--admin-text);
            background: var(--admin-bg-hover);
            border-radius: var(--radius-sm) var(--radius-sm) 0 0;
        }
        .material-tabs-container .tab-btn.active {
            color: var(--admin-primary);
            border-bottom-color: var(--admin-primary);
        }
        .tenant-tab-content {
            display: none;
        }
        .tenant-tab-content.active {
            display: block;
        }
        .switch-toggle input:checked + .slider {
            background-color: var(--admin-primary) !important;
        }
        .switch-toggle .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .25s;
            border-radius: 50%;
        }
        .switch-toggle input:checked + .slider:before {
            transform: translateX(20px);
        }
    </style>
}

@section Scripts {
    <script>
        function switchTenantTab(tabId, button) {
            document.querySelectorAll('.tenant-tab-content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.material-tabs-container .tab-btn').forEach(b => b.classList.remove('active'));
            
            const target = document.getElementById(tabId);
            if (target) {
                target.classList.add('active');
                button.classList.add('active');
            }
        }

        async function toggleTenantFeature(featureId, isEnabled, tenantId) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('featureId', featureId);
            formData.append('enable', isEnabled);
            formData.append('id', tenantId);

            try {
                const response = await fetch(`?handler=ToggleFeature&id=${tenantId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await response.json();
                const badge = document.getElementById('badge_' + featureId);
                if (badge) {
                    if (data.isActive) {
                        badge.className = 'badge badge-success';
                        badge.innerHTML = '<span class="badge-dot" style="background-color: var(--admin-success);"></span> Enabled';
                    } else {
                        badge.className = 'badge badge-secondary';
                        badge.innerHTML = '<span class="badge-dot" style="background-color: var(--admin-text-dim);"></span> Disabled';
                    }
                }
            } catch (err) {
                console.error('Feature toggle error', err);
            }
        }
    </script>
}
