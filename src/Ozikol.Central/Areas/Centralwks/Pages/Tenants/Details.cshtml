@page
@model Ozikol.Central.Areas.Centralwks.Pages.Tenants.DetailsModel
@{
    ViewData["Title"] = Model.Tenant.OrganizationName;
    ViewData["BreadcrumbSection"] = "Tenants";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 12px;">
            <h1 class="admin-title">@Model.Tenant.OrganizationName</h1>
            @if (Model.Tenant.IsActive)
            {
                <span class="badge badge-success"><span class="badge-dot"></span> Active</span>
            }
            else
            {
                <span class="badge badge-danger"><span class="badge-dot"></span> Suspended</span>
            }
        </div>
        <p class="admin-subtitle">
            Subdomain Key: <code style="color: var(--admin-primary); font-weight: 600;">@Model.Tenant.TenantKey</code> •
            Database: <span style="font-family: monospace; color: var(--admin-text-muted);">@Model.Tenant.DatabaseName</span>
        </p>
    </div>
    <div class="admin-actions">
        <a href="https://@Model.Tenant.PrimaryDomain" target="_blank" class="btn-admin btn-admin-secondary">
            <span>↗</span> Visit Workspace
        </a>
        <a href="/centralwks/tenants/features?id=@Model.Id" class="btn-admin btn-admin-secondary">
            <span>⚡</span> Modules (@Model.Subscriptions.Count(s => s.IsActive))
        </a>
        <a href="/centralwks/tenants/edit?id=@Model.Id" class="btn-admin btn-admin-secondary">
            <span>✏️</span> Edit
        </a>
        <form method="post" asp-page-handler="ToggleStatus" style="display: inline; margin: 0;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-admin @(Model.Tenant.IsActive ? "btn-admin-danger" : "btn-admin-primary")" onclick="return confirm('Are you sure you want to @(Model.Tenant.IsActive ? "suspend" : "activate") this tenant?');">
                @(Model.Tenant.IsActive ? "Suspend Tenant" : "Activate Tenant")
            </button>
        </form>
    </div>
</div>

@* ── Meta Cards Grid ── *@
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 24px;">
    <div class="admin-card" style="margin: 0;">
        <div class="admin-card-header" style="padding: 14px 20px;">
            <h3 class="admin-card-title" style="font-size: 14px;">🌐 Domains & Networking</h3>
        </div>
        <div class="admin-card-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
            <div>
                <span style="color: var(--admin-text-dim);">Primary Domain:</span>
                <div style="font-weight: 600; color: var(--admin-info);">@Model.Tenant.PrimaryDomain</div>
            </div>
            <div>
                <span style="color: var(--admin-text-dim);">Custom Domain:</span>
                <div>@(Model.Tenant.CustomDomain ?? "None mapped")</div>
            </div>
            <div>
                <span style="color: var(--admin-text-dim);">Website URL:</span>
                <div>@(Model.Tenant.WebsiteUrl ?? "Default")</div>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin: 0;">
        <div class="admin-card-header" style="padding: 14px 20px;">
            <h3 class="admin-card-title" style="font-size: 14px;">🔒 Database Isolation</h3>
        </div>
        <div class="admin-card-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
            <div>
                <span style="color: var(--admin-text-dim);">Database Name:</span>
                <code style="display: block; color: var(--admin-text); background: var(--admin-bg-surface-elevated); padding: 2px 6px; border-radius: 4px; margin-top: 2px;">
                    @Model.Tenant.DatabaseName
                </code>
            </div>
            <div>
                <span style="color: var(--admin-text-dim);">Admin Email:</span>
                <div style="font-weight: 500;">@(Model.Tenant.AdminEmail ?? "Not specified")</div>
            </div>
            <div>
                <span style="color: var(--admin-text-dim);">Provisioned UTC:</span>
                <div>@Model.Tenant.CreatedUtc.ToString("MMMM dd, yyyy HH:mm") UTC</div>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin: 0;">
        <div class="admin-card-header" style="padding: 14px 20px;">
            <h3 class="admin-card-title" style="font-size: 14px;">🤝 Commercial & Billing</h3>
        </div>
        <div class="admin-card-body" style="padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
            <div>
                <span style="color: var(--admin-text-dim);">Active Modules:</span>
                <div style="font-weight: 700; color: var(--admin-success); font-size: 16px;">
                    @Model.Subscriptions.Count(s => s.IsActive) activated
                </div>
            </div>
            <div>
                <span style="color: var(--admin-text-dim);">Affiliate Referral:</span>
                <div>@(Model.Tenant.ReferredByPartnerCode ?? "Organic / Direct")</div>
            </div>
            <div>
                <span style="color: var(--admin-text-dim);">Recorded Transactions:</span>
                <div>@Model.BillingTransactions.Count transactions</div>
            </div>
        </div>
    </div>
</div>

@* ── Activated Modules Table ── *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">⚡ Activated Modular Capability Subscriptions</h2>
        <a href="/centralwks/tenants/features?id=@Model.Id" class="btn-admin btn-admin-primary btn-admin-sm">
            + Manage Modules
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Capability Name</th>
                    <th>Billing Cadence</th>
                    <th>Recurring Price</th>
                    <th>Starts At</th>
                    <th>Expires At</th>
                    <th>Auto-Renew</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Subscriptions.Any())
                {
                    @foreach (var sub in Model.Subscriptions)
                    {
                        <tr>
                            <td>
                                <div>
                                    <strong style="color: var(--admin-text);">@(sub.MasterFeatureCatalog?.Name ?? "Modular Capability")</strong>
                                    <div style="font-size: 11.5px; color: var(--admin-text-dim);">
                                        <code>@(sub.MasterFeatureCatalog?.FeatureCode ?? sub.MasterFeatureCatalogId.ToString())</code>
                                    </div>
                                </div>
                            </td>
                            <td>@sub.DurationType</td>
                            <td>
                                @if (sub.CustomPriceOverride.HasValue)
                                {
                                    <span style="color: var(--admin-warning); font-weight: 600;">$@sub.CustomPriceOverride.Value.ToString("N2")</span>
                                    <small style="color: var(--admin-text-dim);">(Override)</small>
                                }
                                else
                                {
                                    <span>$@sub.RecurringPrice.ToString("N2")</span>
                                }
                            </td>
                            <td style="font-size: 12px; color: var(--admin-text-muted);">@sub.StartsAtUtc.ToString("MMM dd, yyyy")</td>
                            <td style="font-size: 12px; color: var(--admin-text-muted);">@sub.ExpiresAtUtc.ToString("MMM dd, yyyy")</td>
                            <td>@(sub.AutoRenew ? "Yes" : "No")</td>
                            <td>
                                @if (sub.IsActive)
                                {
                                    <span class="badge badge-success"><span class="badge-dot"></span> @sub.Status</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><span class="badge-dot"></span> @sub.Status</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 28px; color: var(--admin-text-muted);">
                            No modular feature subscriptions activated for this tenant.
                            <div style="margin-top: 8px;">
                                <a href="/centralwks/tenants/features?id=@Model.Id" class="btn-admin btn-admin-secondary btn-admin-sm">Activate Capabilities</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Billing Transactions Table ── *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">💰 Billing & Payment History</h2>
        <a href="/centralwks/billing/create?tenantId=@Model.Id" class="btn-admin btn-admin-secondary btn-admin-sm">
            + Record Transaction
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Invoice / Ref</th>
                    <th>Amount</th>
                    <th>Provider</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.BillingTransactions.Any())
                {
                    @foreach (var tx in Model.BillingTransactions)
                    {
                        <tr>
                            <td>
                                <code style="font-size: 12px; color: var(--admin-info);">@(tx.InvoiceNumber ?? tx.TransactionRef ?? tx.Id.ToString().Substring(0, 8))</code>
                            </td>
                            <td>
                                <strong style="color: var(--admin-text);">$@tx.Amount.ToString("N2")</strong>
                                <span style="font-size: 11px; color: var(--admin-text-dim);">@tx.Currency</span>
                            </td>
                            <td>@(tx.PaymentProvider ?? "Direct")</td>
                            <td>
                                <span class="badge @(tx.Status == "Completed" ? "badge-success" : tx.Status == "Pending" ? "badge-warning" : "badge-danger")">
                                    @tx.Status
                                </span>
                            </td>
                            <td style="font-size: 12px; color: var(--admin-text-muted);">@tx.CreatedUtc.ToString("MMM dd, yyyy HH:mm")</td>
                            <td style="font-size: 12px; color: var(--admin-text-dim);">@(tx.Notes ?? "—")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 24px; color: var(--admin-text-muted);">
                            No billing transactions recorded yet for this tenant.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Audit Log ── *@
@if (Model.AuditLogs.Any())
{
    <div class="admin-card">
        <div class="admin-card-header">
            <h2 class="admin-card-title">📝 Entity Audit Trail</h2>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Summary</th>
                        <th>User</th>
                        <th>IP Address</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.AuditLogs)
                    {
                        <tr>
                            <td>
                                <span class="badge @(log.Action == "Create" ? "badge-success" : log.Action == "Update" ? "badge-info" : "badge-warning")">
                                    @log.Action
                                </span>
                            </td>
                            <td style="color: var(--admin-text);">@log.Summary</td>
                            <td style="color: var(--admin-text-muted);">@(log.UserName ?? log.UserId ?? "System")</td>
                            <td style="font-size: 12px; color: var(--admin-text-dim);">@(log.IpAddress ?? "—")</td>
                            <td style="font-size: 12px; color: var(--admin-text-dim);">@log.CreatedUtc.ToString("MMM dd, yyyy HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
