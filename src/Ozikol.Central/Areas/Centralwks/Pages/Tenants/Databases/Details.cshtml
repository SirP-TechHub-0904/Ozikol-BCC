                    <div id="pingErrorMessage" style="font-family: monospace; font-size: 12px; word-break: break-all;"></div>
                </div>

                <!-- Diagnostics Properties Breakdown -->
                <div style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: 8px; overflow: hidden; font-size: 12.5px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--admin-border);">
                        <span style="color: var(--admin-text-dim);">Target Server Host</span>
                        <code id="pingPropHost" style="font-weight: 600; color: var(--admin-text);">@Model.ServerHost</code>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--admin-border);">
                        <span style="color: var(--admin-text-dim);">Dedicated Database</span>
                        <code id="pingPropDatabase" style="font-weight: 600; color: var(--admin-primary);">@Model.Tenant.DatabaseName</code>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--admin-border);">
                        <span style="color: var(--admin-text-dim);">SQL Principal</span>
                        <code id="pingPropUser" style="color: var(--admin-text);">@(!string.IsNullOrWhiteSpace(Model.CurrentUserId) ? Model.CurrentUserId : "Default")</code>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; border-bottom: 1px solid var(--admin-border);">
                        <span style="color: var(--admin-text-dim);">Engine Version</span>
                        <span id="pingPropVersion" style="color: var(--admin-text); max-width: 320px; text-align: right; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">Microsoft SQL Server</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px;">
                        <span style="color: var(--admin-text-dim);">Server UTC Clock</span>
                        <span id="pingPropUtc" style="color: var(--admin-text); font-family: monospace;">--</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-modal-footer" style="padding: 12px 20px; border-top: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; justify-content: space-between; align-items: center;">
            <div style="font-size: 11.5px; color: var(--admin-text-muted); display: inline-flex; align-items: center; gap: 4px;">
                <span class="material-symbols-outlined" style="font-size: 14px; color: var(--admin-success);">security</span>
                <span>Encrypted TLS Socket Handshake</span>
            </div>
            <div style="display: flex; gap: 8px;">
                <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" onclick="closePingModal();">Close</button>
                <button type="button" class="btn-admin btn-admin-primary btn-admin-sm" onclick="runPingProbe();" id="btnRePing">
                    <span class="material-symbols-outlined" style="font-size: 15px;">refresh</span>
                    Ping Again
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@section Scripts {
    <script>
        let isResettingSqlPassword = false;

        window.addEventListener('DOMContentLoaded', function() {
            if (window.location.hash === '#editConnection' || window.location.hash === '#resetPassword') {
                openResetSqlPasswordModal();
            }
        });

        function openResetSqlPasswordModal() {
            const modal = document.getElementById('resetSqlPasswordModal');
            if (modal) {
                const pwdInput = document.getElementById('resetSqlPasswordInput');
                if (pwdInput && !pwdInput.value) {
                    generateStrongSqlPassword();
                }
                modal.style.display = 'flex';
            }
        }

        function closeResetSqlPasswordModal() {
            // Prevent accidental closing while update / password reset is running
            if (isResettingSqlPassword) return;
            const modal = document.getElementById('resetSqlPasswordModal');
            if (modal) modal.style.display = 'none';
        }

        // Handle form submission: lock modal and display active spinner
        document.getElementById('formResetSqlPwd')?.addEventListener('submit', function() {
            isResettingSqlPassword = true;
            const btn = document.getElementById('btnSubmitResetSql');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px; display: inline-block; animation: spin 1s linear infinite;">sync</span> Resetting SQL Login & Updating...';
            }
        });

        function generateStrongSqlPassword() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!@@#$%^&*()-_=+';
            const array = new Uint32Array(28);
            window.crypto.getRandomValues(array);
            let pwd = 'Ozi!';
            for (let i = 0; i < array.length; i++) {
                pwd += chars[array[i] % chars.length];
            }
            const pwdInput = document.getElementById('resetSqlPasswordInput');
            if (pwdInput) pwdInput.value = pwd;
        }

        function copyResetSqlPassword() {
            const pwdInput = document.getElementById('resetSqlPasswordInput');
            if (pwdInput && pwdInput.value) {
                navigator.clipboard.writeText(pwdInput.value);
            }
        }

        function switchConnMode(mode) {
            document.getElementById('connConfigMode').value = mode;
            const btnStructured = document.getElementById('btnModeStructured');
            const btnRaw = document.getElementById('btnModeRaw');
            const secStructured = document.getElementById('sectionStructuredMode');
            const secRaw = document.getElementById('sectionRawMode');

            if (mode === 'Structured') {
                btnStructured.style.background = 'var(--admin-primary)';
                btnStructured.style.color = 'white';
                btnStructured.className = 'btn-admin btn-admin-sm';
                btnRaw.style.background = '';
                btnRaw.style.color = '';
                btnRaw.className = 'btn-admin btn-admin-sm btn-admin-secondary';
                secStructured.style.display = 'block';
                secRaw.style.display = 'none';
            } else {
                btnRaw.style.background = 'var(--admin-primary)';
                btnRaw.style.color = 'white';
                btnRaw.className = 'btn-admin btn-admin-sm';
                btnStructured.style.background = '';
                btnStructured.style.color = '';
                btnStructured.className = 'btn-admin btn-admin-sm btn-admin-secondary';
                secStructured.style.display = 'none';
                secRaw.style.display = 'block';
            }
        }

        function toggleAuthFields(authType) {
            const secSql = document.getElementById('sectionSqlAuthCredentials');
            if (secSql) {
                secSql.style.display = authType === 'Windows' ? 'none' : 'block';
            }
        }

        async function runModalConnectionTest() {
            const btn = document.getElementById('btnTestModalConn');
            const resultBox = document.getElementById('connTestResultBox');
            const origHtml = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px; animation: spin 1s infinite linear;">sync</span> Testing...';
            btn.disabled = true;

            const mode = document.getElementById('connConfigMode').value;
            const payload = {
                tenantKey: '@Model.Tenant.TenantKey',
                mode: mode,
                server: document.getElementById('inputConnServer')?.value,
                databaseName: document.getElementById('inputConnDatabase')?.value,
                authType: document.getElementById('selectConnAuthType')?.value,
                userId: document.getElementById('inputConnUser')?.value,
                password: document.getElementById('inputConnPassword')?.value,
                trustServerCertificate: document.querySelector('input[name="TrustServerCertificate"]')?.checked ?? true,
                multipleActiveResultSets: document.querySelector('input[name="MultipleActiveResultSets"]')?.checked ?? true,
                rawConnectionString: document.getElementById('inputRawConnStr')?.value
            };

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch('?handler=TestConnectionString', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                resultBox.style.display = 'block';

                if (data.success) {
                    resultBox.style.background = 'rgba(34, 197, 94, 0.12)';
                    resultBox.style.border = '1px solid rgba(34, 197, 94, 0.3)';
                    resultBox.style.color = 'var(--admin-success)';
                    resultBox.innerHTML = `
                        <div style="display: flex; align-items: flex-start; gap: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 18px; margin-top: 1px;">check_circle</span>
                            <div>
                                <div style="font-weight: 700;">Connection Successful! (${data.latencyMs}ms)</div>
                                <div style="font-size: 11.5px; margin-top: 2px; color: var(--admin-text);">${data.serverVersion}</div>
                                <div style="font-size: 11.5px; margin-top: 2px;">Host: <code>${data.dataSource}</code> &bull; DB: <code>${data.databaseName}</code></div>
                            </div>
                        </div>`;
                } else {
                    resultBox.style.background = 'rgba(239, 68, 68, 0.12)';
                    resultBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                    resultBox.style.color = 'var(--admin-danger)';
                    resultBox.innerHTML = `
                        <div style="display: flex; align-items: flex-start; gap: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 18px; margin-top: 1px;">error</span>
                            <div>
                                <div style="font-weight: 700;">Connection Failed</div>
                                <div style="font-size: 12px; margin-top: 2px; color: var(--admin-text);">${data.message}</div>
                            </div>
                        </div>`;
                }
            } catch (err) {
                resultBox.style.display = 'block';
                resultBox.style.background = 'rgba(239, 68, 68, 0.12)';
                resultBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                resultBox.style.color = 'var(--admin-danger)';
                resultBox.innerHTML = `Connection test encountered a network error: ${err.message}`;
            } finally {
                btn.innerHTML = origHtml;
                btn.disabled = false;
            }
        }
        function filterPhysicalTables() {
            const term = document.getElementById('tableFilterInput').value.toLowerCase();
            const rows = document.querySelectorAll('#physicalTablesList tbody .table-row-item');
            
            rows.forEach(row => {
                const name = row.querySelector('.table-name-text')?.textContent.toLowerCase() || '';
                row.style.display = name.includes(term) ? '' : 'none';
            });
        }

        function setSqlQuery(sql) {
            const input = document.getElementById('sqlQueryInput');
            if (input) {
                input.value = sql;
                input.focus();
                input.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        function clearSqlQuery() {
            const input = document.getElementById('sqlQueryInput');
            if (input) input.value = '';
            document.getElementById('sqlExecutionStatus').style.display = 'none';
            document.getElementById('sqlResultsContainer').style.display = 'none';
        }

        document.getElementById('sqlQueryInput')?.addEventListener('keydown', function (e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                executeEmergencySql();
            }
        });

        async function executeEmergencySql() {
            const input = document.getElementById('sqlQueryInput');
            const query = input?.value?.trim();
            const statusDiv = document.getElementById('sqlExecutionStatus');
            const resultsContainer = document.getElementById('sqlResultsContainer');
            const thead = document.getElementById('sqlResultsThead');
            const tbody = document.getElementById('sqlResultsTbody');
            const btn = document.getElementById('btnExecuteSql');

            if (!query) {
                alert('Please enter a SQL statement to execute.');
                input?.focus();
                return;
            }

            const upper = query.toUpperCase();
            if (upper.includes('DROP ') || upper.includes('TRUNCATE ') || upper.includes('DELETE FROM')) {
                const confirmMsg = "⚠️ WARNING: You are executing a destructive SQL command on '@Model.Tenant.DatabaseName'.\n\nCommand:\n" + query + "\n\nDo you want to proceed?";
                if (!confirm(confirmMsg)) {
                    return;
                }
            }

            const originalBtnHtml = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 18px; animation: spin 1s infinite linear;">sync</span> Executing...';
            btn.disabled = true;

            statusDiv.style.display = 'block';
            statusDiv.innerHTML = '<div style="padding: 10px 14px; background: var(--admin-bg-surface-elevated); border-radius: 6px; font-size: 13px; color: var(--admin-text); display: flex; align-items: center; gap: 8px;"><span class="material-symbols-outlined" style="font-size: 16px; animation: spin 1s infinite linear; color: var(--admin-primary);">sync</span> Running query on database...</div>';
            resultsContainer.style.display = 'none';

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            try {
                const response = await fetch('?handler=ExecuteQuery', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tenantKey: '@Model.Tenant.TenantKey',
                        sqlQuery: query
                    })
                });

                const data = await response.json();

                if (data.success) {
                    const hasPendingMigrate = !!document.getElementById('formMigrateNow');
                    statusDiv.innerHTML = `
                        <div style="padding: 12px 16px; background: rgba(34, 197, 94, 0.12); border: 1px solid var(--admin-success); border-radius: 6px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="material-symbols-outlined" style="color: var(--admin-success); font-size: 20px;">check_circle</span>
                                <span style="font-weight: 600; font-size: 13.5px; color: var(--admin-text);">${data.message}</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 11.5px;">
                                <span class="badge badge-success">Latency: ${data.executionTimeMs} ms</span>
                                <span class="badge badge-secondary">Rows Affected: ${data.rowsAffected}</span>
                                ${hasPendingMigrate ? '<button type="button" class="btn-admin btn-admin-primary btn-admin-sm" onclick="document.getElementById(\'formMigrateNow\').submit();" style="font-weight: 700; margin-left: 6px;"><span class="material-symbols-outlined" style="font-size: 15px;">sync</span> Apply Migrations Now</button>' : ''}
                            </div>
                        </div>
                    `;

                    if (data.hasResultSet && data.columns && data.columns.length > 0) {
                        // Render headers
                        thead.innerHTML = '<tr>' + data.columns.map(c => `<th>${c}</th>`).join('') + '</tr>';
                        
                        // Render rows
                        if (data.rows && data.rows.length > 0) {
                            tbody.innerHTML = data.rows.map(row => {
                                return '<tr>' + row.map(cell => `<td style="font-family: monospace; font-size: 12px;">${cell === null || cell === 'NULL' ? '<span style="color: var(--admin-text-dim); font-style: italic;">NULL</span>' : cell}</td>`).join('') + '</tr>';
                            }).join('');
                        } else {
                            tbody.innerHTML = `<tr><td colspan="${data.columns.length}" style="text-align: center; padding: 20px; color: var(--admin-text-muted);">No rows returned (0 records).</td></tr>`;
                        }

                        resultsContainer.style.display = 'block';
                    } else {
                        resultsContainer.style.display = 'none';
                    }
                } else {
                    statusDiv.innerHTML = `
                        <div style="padding: 12px 16px; background: rgba(239, 68, 68, 0.12); border: 1px solid var(--admin-danger); border-radius: 6px; display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                            <div style="display: flex; align-items: flex-start; gap: 8px;">
                                <span class="material-symbols-outlined" style="color: var(--admin-danger); font-size: 20px; margin-top: 2px;">error</span>
                                <div>
                                    <div style="font-weight: 700; font-size: 13.5px; color: var(--admin-danger);">SQL Execution Error</div>
                                    <div style="font-size: 12.5px; color: var(--admin-text); margin-top: 4px; font-family: monospace;">${data.message}</div>
                                </div>
                            </div>
                            <span class="badge badge-danger">Elapsed: ${data.executionTimeMs || 0} ms</span>
                        </div>
                    `;
                    resultsContainer.style.display = 'none';
                }
            } catch (err) {
                console.error('SQL Execution failed', err);
                statusDiv.innerHTML = `
                    <div style="padding: 12px 16px; background: rgba(239, 68, 68, 0.12); border: 1px solid var(--admin-danger); border-radius: 6px; color: var(--admin-danger); font-size: 13px;">
                        Network or server error executing SQL query: ${err.message || 'Unknown error'}
                    </div>
                `;
                resultsContainer.style.display = 'none';
            } finally {
                btn.innerHTML = originalBtnHtml;
                btn.disabled = false;
            }
        }

        let currentAiRecommendedSql = '';

        async function diagnoseWithGemini() {
            const box = document.getElementById('aiDoctorBox');
            const loading = document.getElementById('aiDoctorLoading');
            const content = document.getElementById('aiDoctorContent');
            const btn = document.getElementById('btnAiDiagnose');

            box.style.display = 'block';
            loading.style.display = 'block';
            content.style.display = 'none';
            box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

            const originalBtnHtml = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px; animation: spin 1s infinite linear;">sync</span> Consulting Gemini...';
            btn.disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            let queryError = document.getElementById('sqlExecutionStatus')?.innerText?.trim() || '';
            const editorText = document.getElementById('sqlQueryInput')?.value?.trim() || '';
            if (!queryError) {
                const alertEl = document.querySelector('.alert-danger, [class*="alert-danger"], .admin-alert-danger, .admin-alert');
                if (alertEl) queryError = alertEl.innerText.trim();
            }
            if (!queryError) {
                queryError = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]?.ToString() ?? ""))';
            }

            try {
                const response = await fetch('?handler=AiDiagnose', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        tenantKey: '@Model.Tenant.TenantKey',
                        errorMessage: queryError,
                        userNotes: editorText
                    })
                });

                const data = await response.json();
                loading.style.display = 'none';

                if (data.success) {
                    content.style.display = 'block';
                    document.getElementById('aiDoctorDiagnosis').innerText = data.diagnosis;
                    document.getElementById('aiDoctorExplanation').innerText = data.explanation;
                    document.getElementById('aiDoctorSqlCode').innerText = data.recommendedSql;
                    currentAiRecommendedSql = data.recommendedSql;

                    if (data.keyAliasUsed) {
                        document.getElementById('aiDoctorKeyBadge').innerText = `${data.keyAliasUsed} (${data.latencyMs}ms)`;
                    }
                    if (data.latencyMs) {
                        document.getElementById('aiDoctorLatency').innerText = `Generated in ${data.latencyMs} ms`;
                    }
                } else {
                    content.style.display = 'block';
                    document.getElementById('aiDoctorDiagnosis').innerHTML = `<span style="color: var(--admin-danger); font-weight: 700;">AI Diagnosis Failed:</span> ${data.message}`;
                    document.getElementById('aiDoctorExplanation').innerText = 'Please ensure you have active Google Gemini API keys configured in /centralwks/aikeys.';
                    document.getElementById('aiDoctorSqlCode').innerText = '-- No script generated';
                    currentAiRecommendedSql = '';
                }
            } catch (err) {
                loading.style.display = 'none';
                content.style.display = 'block';
                document.getElementById('aiDoctorDiagnosis').innerText = 'Network error connecting to Gemini AI Doctor: ' + err.message;
            } finally {
                btn.innerHTML = originalBtnHtml;
                btn.disabled = false;
            }
        }

        function applyAiPrescription(executeNow) {
            if (!currentAiRecommendedSql) {
                alert('No recommended SQL to apply.');
                return;
            }
            // Clean up any batch separators or redundant USE statements for direct ADO.NET execution
            let cleanSql = currentAiRecommendedSql
                .replace(/^\s*USE\s+\[?[a-zA-Z0-9_]+\]?\s*;?\s*(\r?\n)+/im, '')
                .replace(/^\s*GO\s*$/gim, '')
                .trim();

            setSqlQuery(cleanSql || currentAiRecommendedSql);
            if (executeNow) {
                executeEmergencySql();
            }
        }

        function openPingModal() {
            const modal = document.getElementById('pingModal');
            if (modal) {
                modal.style.display = 'flex';
                runPingProbe();
            }
        }

        function closePingModal() {
            const modal = document.getElementById('pingModal');
            if (modal) modal.style.display = 'none';
        }

        async function runPingProbe() {
            const tenantKey = '@Model.Tenant.TenantKey';
            const loadingState = document.getElementById('pingLoadingState');
            const resultState = document.getElementById('pingResultState');
            const btnRePing = document.getElementById('btnRePing');

            if (loadingState) loadingState.style.display = 'block';
            if (resultState) resultState.style.display = 'none';
            if (btnRePing) {
                btnRePing.disabled = true;
                btnRePing.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px; animation: spin 1s infinite linear;">sync</span> Pinging...';
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            formData.append('tenantKey', tenantKey);

            try {
                const response = await fetch(`?handler=Ping&tenantKey=${tenantKey}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const data = await response.json();
                renderPingResults(data);
            } catch (err) {
                renderPingResults({
                    success: false,
                    latencyMs: null,
                    message: err.message || 'Network error attempting to reach Central server.'
                });
            } finally {
                if (loadingState) loadingState.style.display = 'none';
                if (resultState) resultState.style.display = 'flex';
                if (btnRePing) {
                    btnRePing.disabled = false;
                    btnRePing.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px;">refresh</span> Ping Again';
                }
            }
        }

        function renderPingResults(data) {
            const heroBanner = document.getElementById('pingHeroBanner');
            const iconBox = document.getElementById('pingHeroIconBox');
            const icon = document.getElementById('pingHeroIcon');
            const title = document.getElementById('pingHeroTitle');
            const subtitle = document.getElementById('pingHeroSubtitle');
            const badge = document.getElementById('pingLatencyBadge');
            const errorBox = document.getElementById('pingErrorBox');
            const errorMessage = document.getElementById('pingErrorMessage');
            const errorType = document.getElementById('pingErrorType');
            const propHost = document.getElementById('pingPropHost');
            const propDatabase = document.getElementById('pingPropDatabase');
            const propUser = document.getElementById('pingPropUser');
            const propVersion = document.getElementById('pingPropVersion');
            const propUtc = document.getElementById('pingPropUtc');
            const mainBadge = document.getElementById('pingStatusBadge');

            if (propHost) propHost.innerText = data.serverHost || '@Model.ServerHost';
            if (propDatabase) propDatabase.innerText = data.databaseName || '@Model.Tenant.DatabaseName';
            if (propUser) propUser.innerText = data.userId || '@Model.CurrentUserId' || 'Default';
            if (propVersion) propVersion.innerText = data.serverVersion || 'Microsoft SQL Server';
            if (propUtc) propUtc.innerText = data.serverUtc || new Date().toUTCString();

            if (data.success) {
                if (heroBanner) {
                    heroBanner.style.background = 'rgba(16, 185, 129, 0.08)';
                    heroBanner.style.borderColor = 'rgba(16, 185, 129, 0.25)';
                }
                if (iconBox) {
                    iconBox.style.background = 'rgba(16, 185, 129, 0.15)';
                    iconBox.style.color = 'var(--admin-success)';
                }
                if (icon) icon.innerText = 'check_circle';
                if (title) {
                    title.innerText = 'Connected & Verified';
                    title.style.color = 'var(--admin-success)';
                }
                if (subtitle) subtitle.innerText = data.message || 'Round-trip query executed successfully';
                if (badge) {
                    badge.innerText = `${data.latencyMs} ms`;
                    badge.style.background = 'rgba(16, 185, 129, 0.15)';
                    badge.style.color = 'var(--admin-success)';
                }
                if (errorBox) errorBox.style.display = 'none';

                if (mainBadge) {
                    mainBadge.className = 'badge badge-success';
                    mainBadge.innerHTML = `<span class="badge-dot" style="background-color: var(--admin-success);"></span> Online (${data.latencyMs}ms)`;
                }
            } else {
                if (heroBanner) {
                    heroBanner.style.background = 'rgba(239, 68, 68, 0.08)';
                    heroBanner.style.borderColor = 'rgba(239, 68, 68, 0.25)';
                }
                if (iconBox) {
                    iconBox.style.background = 'rgba(239, 68, 68, 0.15)';
                    iconBox.style.color = 'var(--admin-danger)';
                }
                if (icon) icon.innerText = 'error';
                if (title) {
                    title.innerText = 'Connection Failed';
                    title.style.color = 'var(--admin-danger)';
                }
                if (subtitle) subtitle.innerText = 'Database unreachable or credentials rejected';
                if (badge) {
                    badge.innerText = data.latencyMs ? `${data.latencyMs} ms` : 'Timeout';
                    badge.style.background = 'rgba(239, 68, 68, 0.15)';
                    badge.style.color = 'var(--admin-danger)';
                }
                if (errorBox) {
                    errorBox.style.display = 'block';
                    if (errorType) errorType.innerText = data.errorType || 'SQL Exception';
                    if (errorMessage) errorMessage.innerText = data.message || 'Unknown database connectivity error.';
                }

                if (mainBadge) {
                    mainBadge.className = 'badge badge-danger';
                    mainBadge.innerHTML = `<span class="badge-dot" style="background-color: var(--admin-danger);"></span> Unreachable`;
                }
            }
        }
    </script>
}
