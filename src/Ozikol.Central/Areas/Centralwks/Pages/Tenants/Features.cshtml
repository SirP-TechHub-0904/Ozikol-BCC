@section Scripts {
    <script>
        var currentModalGeneralTrialDays = 14;

        function toggleActionMenu(btn) {
            var menu = btn.nextElementSibling;
            var isOpen = menu && menu.style.display === 'block';
            document.querySelectorAll('.action-dropdown-menu').forEach(function (el) {
                el.style.display = 'none';
            });
            if (menu && !isOpen) {
                menu.style.display = 'block';
            }
        }

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.action-dropdown-wrapper')) {
                document.querySelectorAll('.action-dropdown-menu').forEach(function (el) {
                    el.style.display = 'none';
                });
            }
        });

        function openCustomPriceModal(featureId, featureName, masterPrice, currentPrice, masterTrialDays, currentTrialDays, hasUsedTrial, hasCustomTrialOverride) {
            currentModalGeneralTrialDays = (masterTrialDays !== undefined && masterTrialDays !== null) ? masterTrialDays : 14;
            document.getElementById('modalFeatureId').value = featureId;
            document.getElementById('modalFeatureName').textContent = featureName;
            document.getElementById('modalMasterPrice').textContent = '$' + masterPrice;
            document.getElementById('modalCustomPriceInput').value = currentPrice;
            var masterTrialEl = document.getElementById('modalMasterTrialDays');
            if (masterTrialEl) masterTrialEl.textContent = currentModalGeneralTrialDays + ' days';
            var customTrialEl = document.getElementById('modalCustomTrialDaysInput');
            if (customTrialEl) customTrialEl.value = (currentTrialDays !== undefined && currentTrialDays !== null) ? currentTrialDays : currentModalGeneralTrialDays;
            var enableChk = document.getElementById('modalEnableCustomTrialCheckbox');
            if (enableChk) enableChk.checked = true;
            var resetTrialChk = document.getElementById('modalResetTrialCheckbox');
            if (resetTrialChk) resetTrialChk.checked = false;
            onToggleCustomTrialCheckbox();
            document.getElementById('customPriceModalBackdrop').style.display = 'flex';
        }

        function onToggleCustomTrialCheckbox() {
            var enableChk = document.getElementById('modalEnableCustomTrialCheckbox');
            var inputGroup = document.getElementById('modalCustomTrialInputGroup');
            var customInput = document.getElementById('modalCustomTrialDaysInput');
            var isEnabled = !enableChk || enableChk.checked;
            if (inputGroup) {
                inputGroup.style.opacity = isEnabled ? '1' : '0.5';
            }
            if (customInput) {
                customInput.disabled = !isEnabled;
            }
            updateCustomTrialOverrideNote();
        }

        function updateCustomTrialOverrideNote() {
            var enableChk = document.getElementById('modalEnableCustomTrialCheckbox');
            var customInput = document.getElementById('modalCustomTrialDaysInput');
            var summaryEl = document.getElementById('modalTrialOverrideSummary');
            if (!summaryEl) return;
            var isEnabled = !enableChk || enableChk.checked;
            var customDays = customInput ? (parseInt(customInput.value, 10) || 0) : currentModalGeneralTrialDays;
            if (isEnabled) {
                summaryEl.textContent = 'Custom Free Trial (' + customDays + ' days) will override General Free Trial (' + currentModalGeneralTrialDays + ' days) for this tenant.';
                summaryEl.style.color = '#5b21b6';
                summaryEl.style.background = 'rgba(124, 58, 237, 0.1)';
            } else {
                summaryEl.textContent = 'Using General Free Trial (' + currentModalGeneralTrialDays + ' days) from Master Catalog.';
                summaryEl.style.color = '#475569';
                summaryEl.style.background = '#f1f5f9';
            }
        }

        function closeCustomPriceModal() {
            document.getElementById('customPriceModalBackdrop').style.display = 'none';
        }

        function openAdjustExpiryModal(featureId, featureName, currentRemainingDays) {
            document.querySelectorAll('.action-dropdown-menu').forEach(function (el) {
                el.style.display = 'none';
            });
            document.getElementById('adjustExpiryFeatureId').value = featureId;
            document.getElementById('adjustExpiryFeatureName').textContent = featureName;
            var inputEl = document.getElementById('adjustExpiryDaysInput');
            if (inputEl) {
                inputEl.value = (currentRemainingDays !== undefined && currentRemainingDays !== null) ? currentRemainingDays : 0;
            }
            document.getElementById('adjustExpiryModalBackdrop').style.display = 'flex';
        }

        function setAdjustExpiryPreset(days) {
            var inputEl = document.getElementById('adjustExpiryDaysInput');
            if (inputEl) {
                inputEl.value = days;
            }
        }

        function closeAdjustExpiryModal() {
            document.getElementById('adjustExpiryModalBackdrop').style.display = 'none';
        }
    </script>
