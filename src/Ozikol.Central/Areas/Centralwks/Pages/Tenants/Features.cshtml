                                                <span class="material-symbols-outlined" style="font-size: 15px;">visibility_off</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ToggleTenantAvailability" style="margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tenantId" value="@Model.Tenant.Id" />
                                        <input type="hidden" name="featureId" value="@feat.Id" />
                                        <input type="hidden" name="tab" value="@Model.ActiveTab" />
                                        <button type="submit" class="btn-admin btn-admin-primary btn-admin-sm">
                                            <span class="material-symbols-outlined" style="font-size: 14px;">add_circle</span>
                                            <span>Make Available</span>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Custom Tenant Price & First-Time Free Trial Modal ── *@
<div id="customPriceModalBackdrop" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #ffffff; border-radius: 16px; max-width: 500px; width: 100%; border: 1px solid #e2e8f0; box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2); overflow: hidden;">
        <div style="padding: 18px 22px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="material-symbols-outlined" style="color: #0050e5;">payments</span>
                <h3 style="margin: 0; font-size: 15.5px; font-weight: 800; color: #0f172a;">Custom Tenant Price &amp; Free Trial Override</h3>
            </div>
            <button type="button" onclick="closeCustomPriceModal()" style="background: none; border: none; cursor: pointer; color: #64748b;">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form method="post" asp-page-handler="SetCustomPrice" style="margin: 0; padding: 22px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tenantId" value="@Model.Tenant.Id" />
            <input type="hidden" name="tab" value="@Model.ActiveTab" />
            <input type="hidden" name="featureId" id="modalFeatureId" />

            <div style="margin-bottom: 14px; padding: 10px 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
                <div style="font-size: 11.5px; color: #64748b;">Capability for <strong>@Model.Tenant.OrganizationName</strong></div>
                <div id="modalFeatureName" style="font-size: 14.5px; font-weight: 800; color: #0f172a; margin-top: 2px;"></div>
                <div style="font-size: 12px; color: #64748b; margin-top: 4px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                    <span>General Price: <strong id="modalMasterPrice" style="color: #0f172a;"></strong>/mo</span>
                    <span>•</span>
                    <span>General Free Trial: <strong id="modalMasterTrialDays" style="color: #6d28d9;">14 days</strong></span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label" style="font-weight: 700; font-size: 12.5px;">Custom Monthly Base Price ($ USD)</label>
                <input type="number" step="0.01" min="0" name="customPrice" id="modalCustomPriceInput" class="form-control" placeholder="e.g. 0.00" required />
                <span class="form-help" style="font-size: 11.5px; color: #64748b;">
                    Automatically converts to <strong>@Model.TenantCurrencyCode (@Model.TenantCurrencySymbol)</strong> and marks this capability Available for @Model.Tenant.OrganizationName.
                </span>
            </div>

            <div class="form-group" style="margin-bottom: 16px; padding: 14px; background: rgba(124, 58, 237, 0.05); border: 1.5px solid rgba(124, 58, 237, 0.25); border-radius: 10px;">
                <label style="display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 12.5px; color: #6d28d9; cursor: pointer; margin-bottom: 10px;">
                    <input type="checkbox" name="enableCustomFreeTrial" value="true" id="modalEnableCustomTrialCheckbox" checked onchange="onToggleCustomTrialCheckbox()" />
                    <span class="material-symbols-outlined" style="font-size: 16px;">redeem</span>
                    <span>Enable Custom Free Trial Override (Overrides General Free Trial)</span>
                </label>

                <div id="modalCustomTrialInputGroup" style="display: flex; align-items: center; gap: 8px;">
                    <input type="number" min="0" max="365" name="customFreeTrialDays" id="modalCustomTrialDaysInput" class="form-control" placeholder="e.g. 30" oninput="updateCustomTrialOverrideNote()" />
                    <span style="font-size: 12px; font-weight: 700; color: #475569; white-space: nowrap;">Days Free</span>
                </div>

                <div id="modalTrialOverrideSummary" style="font-size: 11.5px; color: #5b21b6; background: rgba(124, 58, 237, 0.1); padding: 6px 10px; border-radius: 6px; margin-top: 8px; font-weight: 600;">
                    Custom Free Trial will override General Free Trial for @Model.Tenant.OrganizationName.
                </div>

                <label style="display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 12px; font-weight: 600; color: #0f172a; cursor: pointer;">
                    <input type="checkbox" name="resetFreeTrialUsed" value="true" id="modalResetTrialCheckbox" />
                    <span>Reset First-Time Free Trial eligibility (allow tenant to test for free again)</span>
                </label>
            </div>

            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
                <button type="submit" name="resetToGeneral" value="true" class="btn-admin btn-admin-secondary" style="color: #dc2626;" title="Clear custom price and custom free trial override and revert to General Catalog defaults">
                    <span class="material-symbols-outlined" style="font-size: 15px;">restart_alt</span>
                    <span>Reset to General</span>
                </button>
                <div style="display: flex; gap: 8px; margin-left: auto;">
                    <button type="button" class="btn-admin btn-admin-secondary" onclick="closeCustomPriceModal()">Cancel</button>
                    <button type="submit" class="btn-admin btn-admin-primary">
                        <span class="material-symbols-outlined" style="font-size: 16px;">save</span>
                        <span>Save &amp; Override</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@* ── Adjust Remaining Days / Expiry Modal (Preserves General Mode, Does Not Enable Custom Mode) ── *@
<div id="adjustExpiryModalBackdrop" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #ffffff; border-radius: 16px; max-width: 480px; width: 100%; border: 1px solid #e2e8f0; box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2); overflow: hidden;">
        <div style="padding: 18px 22px; background: #fffbeb; border-bottom: 1px solid #fde68a; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="material-symbols-outlined" style="color: #b45309;">timer</span>
                <div>
                    <h3 style="margin: 0; font-size: 15px; font-weight: 800; color: #0f172a;">Adjust Remaining Days / Trigger Payment</h3>
                    <div style="font-size: 11px; color: #92400e; font-weight: 600;">Stays in General Mode — does NOT turn on Custom Pricing</div>
                </div>
            </div>
            <button type="button" onclick="closeAdjustExpiryModal()" style="background: none; border: none; cursor: pointer; color: #64748b;">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <form method="post" asp-page-handler="AdjustSubscriptionExpiryDays" style="margin: 0; padding: 22px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tenantId" value="@Model.Tenant.Id" />
            <input type="hidden" name="tab" value="@Model.ActiveTab" />
            <input type="hidden" name="featureId" id="adjustExpiryFeatureId" />

            <div style="margin-bottom: 14px; padding: 10px 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
                <div style="font-size: 11.5px; color: #64748b;">Active Capability on <strong>@Model.Tenant.OrganizationName</strong></div>
                <div id="adjustExpiryFeatureName" style="font-size: 14.5px; font-weight: 800; color: #0f172a; margin-top: 2px;"></div>
            </div>

            <div class="form-group" style="margin-bottom: 14px;">
                <label class="form-label" style="font-weight: 700; font-size: 12.5px;">Remaining Days Before Expiry / Payment</label>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <input type="number" min="-365" max="365" name="remainingDays" id="adjustExpiryDaysInput" class="form-control" placeholder="e.g. 0 or -2" required />
                    <span style="font-size: 12px; font-weight: 700; color: #475569; white-space: nowrap;">Days</span>
                </div>
                <span class="form-help" style="font-size: 11.5px; color: #64748b; display: block; margin-top: 6px;">
                    Set <strong>0</strong> or <strong>-2</strong> to expire immediately and trigger payment, or <strong>1 to 30</strong> to test the 30-day renewal banner, notification list, and email.
                </span>
            </div>

            <div style="margin-bottom: 18px;">
                <div style="font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 8px;">Quick Test Presets:</div>
                <div style="display: flex; align-items: center; gap: 6px; flex-wrap: wrap;">
                    <button type="button" onclick="setAdjustExpiryPreset(-2)" class="badge" style="background: rgba(239, 68, 68, 0.12); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.3); font-weight: 800; font-size: 11.5px; padding: 5px 10px; cursor: pointer;">-2d (Overdue)</button>
                    <button type="button" onclick="setAdjustExpiryPreset(0)" class="badge" style="background: rgba(239, 68, 68, 0.12); color: #dc2626; border: 1px solid rgba(239, 68, 68, 0.3); font-weight: 800; font-size: 11.5px; padding: 5px 10px; cursor: pointer;">0d (Trigger Payment)</button>
                    <button type="button" onclick="setAdjustExpiryPreset(1)" class="badge" style="background: rgba(245, 158, 11, 0.15); color: #b45309; border: 1px solid rgba(245, 158, 11, 0.35); font-weight: 800; font-size: 11.5px; padding: 5px 10px; cursor: pointer;">1d (24hr Alert)</button>
                    <button type="button" onclick="setAdjustExpiryPreset(7)" class="badge" style="background: rgba(245, 158, 11, 0.12); color: #b45309; border: 1px solid rgba(245, 158, 11, 0.3); font-weight: 700; font-size: 11.5px; padding: 5px 10px; cursor: pointer;">7d Left</button>
                    <button type="button" onclick="setAdjustExpiryPreset(14)" class="badge" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; border: 1px solid rgba(14, 165, 233, 0.3); font-weight: 700; font-size: 11.5px; padding: 5px 10px; cursor: pointer;">14d Left</button>
                    <button type="button" onclick="setAdjustExpiryPreset(25)" class="badge" style="background: rgba(14, 165, 233, 0.12); color: #0284c7; border: 1px solid rgba(14, 165, 233, 0.3); font-weight: 700; font-size: 11.5px; padding: 5px 10px; cursor: pointer;">25d Left (&le;30d)</button>
                </div>
            </div>

            <div style="display: flex; align-items: center; justify-content: flex-end; gap: 8px;">
                <button type="button" class="btn-admin btn-admin-secondary" onclick="closeAdjustExpiryModal()">Cancel</button>
                <button type="submit" class="btn-admin btn-admin-primary">
                    <span class="material-symbols-outlined" style="font-size: 16px;">timer</span>
                    <span>Update Remaining Days</span>
                </button>
            </div>
        </form>
    </div>
</div>

