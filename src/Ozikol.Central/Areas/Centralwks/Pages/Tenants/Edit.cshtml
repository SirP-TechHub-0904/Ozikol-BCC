@page
@model Ozikol.Central.Areas.Centralwks.Pages.Tenants.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Tenant.OrganizationName}";
    ViewData["BreadcrumbSection"] = "Tenants";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Edit Organization Settings</h1>
        <p class="admin-subtitle">Modify routing domains, administrative contacts, and platform status for tenant <strong>@Model.Tenant.TenantKey</strong>.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/tenants/details?id=@Model.Id" class="btn-admin btn-admin-secondary">
            ← Back to Details
        </a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger" role="alert"></div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
        @* Core Settings *@
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">🏢 Organization & Domain Settings</h2>
            </div>
            <div class="admin-card-body">
                <div class="form-group">
                    <label asp-for="Input.OrganizationName" class="form-label">
                        Organization Display Name <span class="required">*</span>
                    </label>
                    <input asp-for="Input.OrganizationName" class="form-control" />
                    <span asp-validation-for="Input.OrganizationName" class="field-validation-error"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label asp-for="Input.PrimaryDomain" class="form-label">
                            Primary Platform Domain <span class="required">*</span>
                        </label>
                        <input asp-for="Input.PrimaryDomain" class="form-control" />
                        <span asp-validation-for="Input.PrimaryDomain" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.CustomDomain" class="form-label">Custom Domain (CNAME)</label>
                        <input asp-for="Input.CustomDomain" class="form-control" placeholder="e.g. portal.acme.com" />
                        <span asp-validation-for="Input.CustomDomain" class="field-validation-error"></span>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label asp-for="Input.WebsiteUrl" class="form-label">Website URL</label>
                        <input asp-for="Input.WebsiteUrl" class="form-control" placeholder="https://acme.com" />
                        <span asp-validation-for="Input.WebsiteUrl" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ApiUrl" class="form-label">Dedicated API URL</label>
                        <input asp-for="Input.ApiUrl" class="form-control" placeholder="https://api.acme.ozikol.cloud" />
                        <span asp-validation-for="Input.ApiUrl" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.AdminEmail" class="form-label">Primary Administrative Email</label>
                    <input asp-for="Input.AdminEmail" class="form-control" />
                    <span asp-validation-for="Input.AdminEmail" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ReferredByPartnerCode" class="form-label">Affiliate Partner Referral Code</label>
                    <input asp-for="Input.ReferredByPartnerCode" class="form-control" placeholder="e.g. PARTNER-1029" />
                    <span asp-validation-for="Input.ReferredByPartnerCode" class="field-validation-error"></span>
                </div>

                <div class="form-group" style="margin-top: 12px;">
                    <label class="form-check">
                        <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" />
                        <div>
                            <span style="font-weight: 600; font-size: 13.5px; color: var(--admin-text);">Accepting Traffic & Active</span>
                            <div style="font-size: 12px; color: var(--admin-text-muted);">When unchecked, tenant workspace is suspended and displays an offline notice.</div>
                        </div>
                    </label>
                </div>
            </div>
            <div class="admin-card-footer">
                <a href="/centralwks/tenants/details?id=@Model.Id" class="btn-admin btn-admin-secondary">Cancel</a>
                <button type="submit" class="btn-admin btn-admin-primary">Save Changes</button>
            </div>
        </div>

        @* Database & Security Diagnostics (Read Only) *@
        <div>
            <div class="admin-card">
                <div class="admin-card-header">
                    <h2 class="admin-card-title">🔒 Sovereign Fleet Meta</h2>
                </div>
                <div class="admin-card-body" style="display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Tenant Key</div>
                        <div style="font-size: 14px; font-weight: 600; color: var(--admin-text);">@Model.Tenant.TenantKey</div>
                    </div>

                    <div>
                        <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Physical Database Name</div>
                        <code style="font-size: 12.5px; color: var(--admin-info); background: var(--admin-bg-surface-elevated); padding: 4px 8px; border-radius: 4px; display: block; margin-top: 2px;">
                            @Model.Tenant.DatabaseName
                        </code>
                    </div>

                    <div>
                        <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Provisioned UTC</div>
                        <div style="font-size: 13px; color: var(--admin-text-muted);">@Model.Tenant.CreatedUtc.ToString("MMMM dd, yyyy HH:mm:ss") UTC</div>
                    </div>

                    @if (Model.Tenant.UpdatedUtc.HasValue)
                    {
                        <div>
                            <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Last Updated UTC</div>
                            <div style="font-size: 13px; color: var(--admin-text-muted);">@Model.Tenant.UpdatedUtc.Value.ToString("MMMM dd, yyyy HH:mm:ss") UTC</div>
                        </div>
                    }

                    <div style="margin-top: 8px;">
                        <a href="/centralwks/tenants/features?id=@Model.Id" class="btn-admin btn-admin-secondary" style="width: 100%;">
                            ⚡ Manage Modular Modules
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
