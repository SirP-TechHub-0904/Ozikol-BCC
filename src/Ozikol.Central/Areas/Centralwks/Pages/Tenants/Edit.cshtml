@page
@model Ozikol.Central.Areas.Centralwks.Pages.Tenants.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Tenant.OrganizationName}";
    ViewData["BreadcrumbSection"] = "Tenants";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Edit Organization Settings</h1>
        <p class="admin-subtitle">Modify routing domains, administrative contacts, and platform status for tenant <strong>@Model.Tenant.TenantKey</strong>.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/tenants/details?id=@Model.Id" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
            Back to Details
        </a>
    </div>
</div>

<form method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger" role="alert"></div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
        @* Core Settings *@
        <div class="admin-card">
            <div class="admin-card-header" style="padding: 16px 20px;">
                <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px;">
                    <span class="material-symbols-outlined" style="color: var(--admin-primary);">edit_square</span>
                    Organization &amp; Domain Settings
                </div>
            </div>
            <div class="admin-card-body" style="padding: 20px;">
                <div class="form-group">
                    <label asp-for="Input.OrganizationName" class="form-label">
                        Organization Display Name <span class="required">*</span>
                    </label>
                    <input asp-for="Input.OrganizationName" class="form-control" />
                    <span asp-validation-for="Input.OrganizationName" class="field-validation-error"></span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-group">
                        <label asp-for="Input.PrimaryDomain" class="form-label">
                            Primary Platform Domain <span class="required">*</span>
                        </label>
                        <input asp-for="Input.PrimaryDomain" class="form-control" />
                        <span asp-validation-for="Input.PrimaryDomain" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.CustomDomain" class="form-label">Custom Domain (CNAME)</label>
                        <input asp-for="Input.CustomDomain" class="form-control" placeholder="portal.yourdomain.com" />
                        <span asp-validation-for="Input.CustomDomain" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.WebsiteUrl" class="form-label">Website URL</label>
                    <input asp-for="Input.WebsiteUrl" class="form-control" placeholder="https://yourdomain.com" />
                    <span asp-validation-for="Input.WebsiteUrl" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.AdminEmail" class="form-label">Primary Administrative Email</label>
                    <input asp-for="Input.AdminEmail" class="form-control" />
                    <span asp-validation-for="Input.AdminEmail" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ReferredByPartnerCode" class="form-label">Affiliate Partner Referral Code</label>
                    <input asp-for="Input.ReferredByPartnerCode" class="form-control" placeholder="PARTNER-CODE" />
                    <span asp-validation-for="Input.ReferredByPartnerCode" class="field-validation-error"></span>
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label asp-for="Input.ConnectionString" class="form-label" style="margin: 0; font-weight: 700; font-size: 13.5px; color: var(--admin-text); display: flex; align-items: center; gap: 6px;">
                            <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-primary);">database</span>
                            Dedicated Database Connection String
                        </label>
                        <span style="font-size: 11.5px; color: var(--admin-success); font-weight: 600; background: rgba(34, 197, 94, 0.1); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(34, 197, 94, 0.25);">
                            <span class="material-symbols-outlined" style="font-size: 12px; vertical-align: middle;">lock</span> AES-256-GCM Encrypted at Rest
                        </span>
                    </div>

                    <div style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 8px;">
                        Decrypted in memory with your workspace credentials. Edit the <code>Server=...</code> portion (e.g. set to <code>2.24.162.42,1433</code>) and test connectivity before saving.
                    </div>

                    <div style="display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
                        <button type="button" class="btn-admin btn-admin-sm btn-admin-secondary" onclick="quickSetServerHost('2.24.162.42,1433');" style="font-size: 11.5px;">
                            <span class="material-symbols-outlined" style="font-size: 13px;">cloud</span> Set VPS Host: 2.24.162.42,1433
                        </button>
                        <button type="button" class="btn-admin btn-admin-sm btn-admin-secondary" onclick="quickSetServerHost('127.0.0.1,1433');" style="font-size: 11.5px;">
                            <span class="material-symbols-outlined" style="font-size: 13px;">computer</span> Set Localhost: 127.0.0.1,1433
                        </button>
                    </div>

                    <textarea asp-for="Input.ConnectionString" id="inputConnectionString" class="form-control" rows="4" style="font-family: monospace; font-size: 12.5px; resize: vertical; line-height: 1.5;" placeholder="Server=2.24.162.42,1433;Database=...;User Id=...;Password=...;TrustServerCertificate=True;"></textarea>
                    <span asp-validation-for="Input.ConnectionString" class="field-validation-error"></span>

                    @* Test Connection Action & Result Box *@
                    <div style="margin-top: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                        <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" id="btnTestConn" onclick="testConnectionNow();">
                            <span class="material-symbols-outlined" style="font-size: 15px; color: var(--admin-primary);">network_ping</span>
                            Test Connection
                        </button>
                        <span style="font-size: 11.5px; color: var(--admin-text-dim);">Probes SQL port 1433 and validates credentials</span>
                    </div>

                    <div id="testConnResultBox" style="display: none; margin-top: 10px; padding: 12px 14px; border-radius: 8px; font-size: 12.5px;"></div>
                </div>

                <div class="form-group" style="margin-top: 12px;">
                    <label class="form-check" style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer;">
                        <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" style="margin-top: 3px;" />
                        <div>
                            <span style="font-weight: 600; font-size: 13.5px; color: var(--admin-text);">Accepting Traffic &amp; Active</span>
                            <div style="font-size: 12px; color: var(--admin-text-muted);">When unchecked, tenant workspace is suspended and displays an offline notice.</div>
                        </div>
                    </label>
                </div>
            </div>
            <div class="admin-card-footer" style="padding: 14px 20px; border-top: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; justify-content: flex-end; gap: 10px;">
                <a href="/centralwks/tenants/details?id=@Model.Id" class="btn-admin btn-admin-secondary">Cancel</a>
                <button type="submit" class="btn-admin btn-admin-primary">
                    <span class="material-symbols-outlined" style="font-size: 16px;">save</span>
                    Save Changes
                </button>
            </div>
        </div>

        @* Database & Security Diagnostics (Read Only) *@
        <div>
            <div class="admin-card">
                <div class="admin-card-header" style="padding: 16px 20px;">
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px;">
                        <span class="material-symbols-outlined" style="color: var(--admin-info);">storage</span>
                        Tenant Suite Meta
                    </div>
                </div>
                <div class="admin-card-body" style="padding: 20px; display: flex; flex-direction: column; gap: 14px;">
                    <div>
                        <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Tenant Key</div>
                        <div style="font-size: 14px; font-weight: 600; color: var(--admin-text);">@Model.Tenant.TenantKey</div>
                    </div>

                    <div>
                        <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Physical Database Name</div>
                        <code style="font-size: 12.5px; color: var(--admin-info); background: var(--admin-bg-surface-elevated); padding: 4px 8px; border-radius: 4px; display: block; margin-top: 2px;">
                            @Model.Tenant.DatabaseName
                        </code>
                    </div>

                    <div>
                        <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Provisioned UTC</div>
                        <div style="font-size: 13px; color: var(--admin-text-muted);">@Model.Tenant.CreatedUtc.ToString("MMMM dd, yyyy HH:mm:ss") UTC</div>
                    </div>

                    @if (Model.Tenant.UpdatedUtc.HasValue)
                    {
                        <div>
                            <div style="font-size: 11.5px; color: var(--admin-text-dim); text-transform: uppercase;">Last Updated UTC</div>
                            <div style="font-size: 13px; color: var(--admin-text-muted);">@Model.Tenant.UpdatedUtc.Value.ToString("MMMM dd, yyyy HH:mm:ss") UTC</div>
                        </div>
                    }

                    <div style="margin-top: 8px;">
                        <a href="/centralwks/tenants/details?id=@Model.Id#tab-features" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">toggle_on</span>
                            Manage Capability Modules
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function quickSetServerHost(newHost) {
            const textarea = document.getElementById('inputConnectionString');
            if (!textarea) return;
            let val = textarea.value;
            if (/Server\s*=\s*[^;]+/i.test(val)) {
                val = val.replace(/Server\s*=\s*[^;]+/i, `Server=${newHost}`);
            } else if (/Data\s+Source\s*=\s*[^;]+/i.test(val)) {
                val = val.replace(/Data\s+Source\s*=\s*[^;]+/i, `Data Source=${newHost}`);
            } else {
                val = `Server=${newHost};` + val;
            }
            textarea.value = val;
        }

        async function testConnectionNow() {
            const textarea = document.getElementById('inputConnectionString');
            const btn = document.getElementById('btnTestConn');
            const resultBox = document.getElementById('testConnResultBox');
            if (!textarea || !textarea.value.trim()) {
                alert('Please enter a connection string to test.');
                return;
            }

            const origHtml = btn.innerHTML;
            btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px; animation: spin 1s infinite linear;">sync</span> Testing...';
            btn.disabled = true;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch('?handler=TestConnection', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ connectionString: textarea.value.trim() })
                });

                const data = await response.json();
                resultBox.style.display = 'block';

                if (data.success) {
                    resultBox.style.background = 'rgba(34, 197, 94, 0.12)';
                    resultBox.style.border = '1px solid rgba(34, 197, 94, 0.3)';
                    resultBox.style.color = 'var(--admin-success)';
                    resultBox.innerHTML = `
                        <div style="display: flex; align-items: flex-start; gap: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 18px; margin-top: 1px;">check_circle</span>
                            <div>
                                <div style="font-weight: 700;">Connection Successful! (${data.latencyMs}ms)</div>
                                <div style="font-size: 12px; margin-top: 2px; color: var(--admin-text);">${data.serverVersion}</div>
                                <div style="font-size: 11.5px; margin-top: 2px;">Host: <code>${data.dataSource}</code> &bull; Database: <code>${data.databaseName}</code></div>
                            </div>
                        </div>`;
                } else {
                    resultBox.style.background = 'rgba(239, 68, 68, 0.12)';
                    resultBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                    resultBox.style.color = 'var(--admin-danger)';
                    resultBox.innerHTML = `
                        <div style="display: flex; align-items: flex-start; gap: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 18px; margin-top: 1px;">error</span>
                            <div>
                                <div style="font-weight: 700;">Connection Failed</div>
                                <div style="font-size: 12px; margin-top: 2px; color: var(--admin-text);">${data.message}</div>
                            </div>
                        </div>`;
                }
            } catch (err) {
                resultBox.style.display = 'block';
                resultBox.style.background = 'rgba(239, 68, 68, 0.12)';
                resultBox.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                resultBox.style.color = 'var(--admin-danger)';
                resultBox.innerHTML = `Connection test encountered a network error: ${err.message}`;
            } finally {
                btn.innerHTML = origHtml;
                btn.disabled = false;
            }
        }
    </script>
}
