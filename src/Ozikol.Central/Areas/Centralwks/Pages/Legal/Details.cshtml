@page "/centralwks/legal/details/{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Legal.DetailsModel
@{
    ViewData["Title"] = Model.Document.Title;
    ViewData["BreadcrumbSection"] = "Compliance";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/centralwks/legal" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Legal Docs</a>
            <span style="color: var(--admin-text-muted); font-size: 12px;">•</span>
            <span style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
                @Model.Document.Category
            </span>
            <span style="font-family: monospace; font-size: 11px; background: rgba(255, 255, 255, 0.05); color: #cbd5e1; padding: 2px 8px; border-radius: 9999px;">
                v@Model.Document.Version
            </span>
            <span style="font-size: 11px; font-weight: 600; background: rgba(255, 255, 255, 0.05); color: #cbd5e1; padding: 2px 6px; border-radius: 4px;">
                @Model.Document.Culture.ToUpperInvariant()
            </span>
            @if (Model.Document.IsPublished)
            {
                <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">● Live</span>
            }
            else
            {
                <span style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">○ Draft</span>
            }
        </div>
        <h1 class="admin-title">@Model.Document.Title</h1>
        <p class="admin-subtitle">Permalink: <code>/legal/@Model.Document.Slug</code> (Effective: @Model.Document.EffectiveDate.ToString("dd MMM yyyy"))</p>
    </div>
    <div class="admin-actions">
        <form method="post" asp-page-handler="TogglePublish" asp-route-id="@Model.Document.Id" style="display: inline;">
            <button type="submit" class="btn-admin btn-admin-secondary">
                <span class="material-symbols-outlined" style="font-size: 16px;">@(Model.Document.IsPublished ? "visibility_off" : "public")</span>
                @(Model.Document.IsPublished ? "Unpublish" : "Publish Live")
            </button>
        </form>
        <a href="/centralwks/legal/edit/@Model.Document.Id" class="btn-admin btn-admin-primary">
            <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
            Edit Policy
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
    @* Left Column: Policy Body *@
    <div>
        <div class="admin-card" style="padding: 24px; margin-bottom: 24px;">
            <h2 style="font-size: 16px; font-weight: 600; color: var(--admin-text); margin-bottom: 12px;">Executive Summary</h2>
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 16px; line-height: 1.6; color: #cbd5e1; font-size: 14px;">
                @Model.Document.Summary
            </div>

            <h2 style="font-size: 16px; font-weight: 600; color: var(--admin-text); margin-top: 24px; margin-bottom: 12px;">Full Policy Content</h2>
            <div style="background: var(--admin-bg-surface); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 24px; line-height: 1.7; color: var(--admin-text); font-size: 14px;">
                @Html.Raw(Model.Document.ContentHtml)
            </div>
        </div>
    </div>

    @* Right Column: Metadata & Actions *@
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <div class="admin-card" style="padding: 20px;">
            <h3 style="font-size: 14px; font-weight: 600; color: var(--admin-text); margin-bottom: 16px;">Policy Governance Audit</h3>
            
            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Category</div>
                <div style="font-size: 13px; font-weight: 500; color: var(--admin-text);">@Model.Document.Category</div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Version Identifier</div>
                <div style="font-size: 13px; font-family: monospace; color: #93c5fd;">v@Model.Document.Version</div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Language Culture</div>
                <div style="font-size: 13px; color: var(--admin-text);">@Model.Document.Culture.ToUpperInvariant()</div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Effective Date</div>
                <div style="font-size: 13px; color: var(--admin-text);">@Model.Document.EffectiveDate.ToString("dd MMM yyyy")</div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Last Updated</div>
                <div style="font-size: 13px; color: var(--admin-text);">@Model.Document.LastUpdatedUtc.ToString("dd MMM yyyy, HH:mm") UTC</div>
            </div>

            <div>
                <div style="font-size: 11px; color: var(--admin-text-muted);">Public Route</div>
                <div style="font-size: 12px; font-family: monospace; color: #94a3b8; word-break: break-all;">
                    /legal/@Model.Document.Slug
                </div>
            </div>
        </div>

        <div class="admin-card" style="padding: 20px; border-color: rgba(239, 68, 68, 0.2);">
            <h3 style="font-size: 14px; font-weight: 600; color: #f87171; margin-bottom: 8px;">Danger Zone</h3>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 12px;">Permanently deletes this legal policy document and removes it from public compliance portals.</p>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Document.Id">
                <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); width: 100%;" onclick="return confirm('Permanently delete legal document @Model.Document.Title?');">
                    Permanently Delete Policy
                </button>
            </form>
        </div>
    </div>
</div>
