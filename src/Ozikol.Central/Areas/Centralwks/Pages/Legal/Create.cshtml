@page "/centralwks/legal/create"
@model Ozikol.Central.Areas.Centralwks.Pages.Legal.CreateModel
@{
    ViewData["Title"] = "New Legal Policy";
    ViewData["BreadcrumbSection"] = "Compliance";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/legal" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Legal Docs</a>
        </div>
        <h1 class="admin-title">Draft Legal Document & Policy</h1>
        <p class="admin-subtitle">Author enforceable terms, security commitments, SLA parameters, or regional privacy disclosures.</p>
    </div>
</div>

<div class="admin-card" style="max-width: 900px; padding: 28px;">
    <form method="post">
        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Title" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Policy Title <span style="color: #f87171;">*</span>
            </label>
            <input asp-for="Input.Title" id="legalTitleInput" placeholder="e.g. Cloud Data Processing Agreement & SLA" 
                   class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 15px; font-weight: 500;" />
            <span asp-validation-for="Input.Title" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.Slug" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    URL Permalink Slug <span style="color: #f87171;">*</span>
                </label>
                <div style="display: flex; align-items: center; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; overflow: hidden;">
                    <span style="padding: 10px 12px; color: var(--admin-text-muted); font-size: 13px; background: rgba(255, 255, 255, 0.03); border-right: 1px solid rgba(255, 255, 255, 0.06); font-family: monospace;">
                        /legal/
                    </span>
                    <input asp-for="Input.Slug" id="legalSlugInput" placeholder="enterprise-cloud-dpa" 
                           class="form-control" style="flex: 1; background: transparent; border: none; padding: 10px 14px; color: #93c5fd; font-size: 13px; font-family: monospace;" />
                </div>
                <span asp-validation-for="Input.Slug" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div>
                <label asp-for="Input.Category" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Governance Category <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.Category" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 13px;">
                    <option value="Privacy">Privacy Notice</option>
                    <option value="Terms">Terms of Service</option>
                    <option value="SLA">Service Level Agreement (SLA)</option>
                    <option value="Cookies">Cookie Policy</option>
                    <option value="Compliance">Security & Compliance</option>
                    <option value="Governance">Corporate Governance</option>
                </select>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.Version" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Version Code <span style="color: #f87171;">*</span>
                </label>
                <input asp-for="Input.Version" class="form-control" placeholder="e.g. 2026.1" 
                       style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
            </div>

            <div>
                <label asp-for="Input.Culture" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Language <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.Culture" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;">
                    <option value="en">English (en)</option>
                    <option value="fr">French (fr)</option>
                    <option value="es">Spanish (es)</option>
                    <option value="de">German (de)</option>
                </select>
            </div>

            <div>
                <label asp-for="Input.EffectiveDate" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Effective Date
                </label>
                <input asp-for="Input.EffectiveDate" type="date" class="form-control" 
                       style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
            </div>

            <div>
                <label asp-for="Input.SortOrder" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Sort Order
                </label>
                <input asp-for="Input.SortOrder" type="number" min="0" class="form-control" 
                       style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 8px 12px; color: var(--admin-text); font-size: 13px;" />
            </div>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Summary" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Summary / Meta Excerpt <span style="color: #f87171;">*</span>
            </label>
            <textarea asp-for="Input.Summary" rows="3" placeholder="Concise 1-2 sentence lead text appearing on index cards, search results, and legal hubs..." 
                      class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 13px;"></textarea>
            <span asp-validation-for="Input.Summary" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.ContentHtml" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Policy Body (HTML) <span style="color: #f87171;">*</span>
            </label>
            <textarea asp-for="Input.ContentHtml" rows="14" placeholder="Full formal policy markup in HTML..." 
                      class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 12px 14px; color: #e2e8f0; font-family: monospace; font-size: 13px; line-height: 1.5;"></textarea>
            <span asp-validation-for="Input.ContentHtml" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="margin-bottom: 24px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 12px 16px;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--admin-text); cursor: pointer;">
                <input type="checkbox" asp-for="Input.IsPublished" style="accent-color: var(--admin-accent); width: 16px; height: 16px;" />
                Published live to public legal portal
            </label>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <a href="/centralwks/legal" class="btn-admin btn-admin-secondary">Cancel</a>
            <button type="submit" class="btn-admin btn-admin-primary">Publish Policy</button>
        </div>
    </form>
</div>

<script>
    const titleInput = document.getElementById('legalTitleInput');
    const slugInput = document.getElementById('legalSlugInput');

    titleInput?.addEventListener('input', function() {
        if (!slugInput.value || slugInput.dataset.touched !== 'true') {
            slugInput.value = this.value.toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '');
        }
    });

    slugInput?.addEventListener('input', () => slugInput.dataset.touched = 'true');
</script>
