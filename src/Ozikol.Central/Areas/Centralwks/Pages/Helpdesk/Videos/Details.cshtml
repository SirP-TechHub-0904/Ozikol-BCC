@page "/centralwks/helpdesk/videos/details/{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Helpdesk.Videos.DetailsModel
@{
    ViewData["Title"] = Model.Video.Title;
    ViewData["BreadcrumbSection"] = "Helpdesk";
    var mins = Model.Video.DurationSeconds / 60;
    var secs = Model.Video.DurationSeconds % 60;
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/centralwks/helpdesk/videos" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Videos</a>
            <span style="color: var(--admin-text-muted); font-size: 12px;">•</span>
            <span style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
                @Model.Video.SuiteCode
            </span>
            <span style="font-size: 11px; font-weight: 600; background: rgba(255, 255, 255, 0.05); color: #cbd5e1; padding: 2px 6px; border-radius: 4px;">
                @Model.Video.Culture.ToUpperInvariant()
            </span>
            @if (Model.Video.IsPublished)
            {
                <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">● Live</span>
            }
            else
            {
                <span style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">○ Draft</span>
            }
        </div>
        <h1 class="admin-title">@Model.Video.Title</h1>
        <p class="admin-subtitle">YouTube ID: <code>@Model.Video.YouTubeVideoId</code> • Runtime: @mins:@secs.ToString("00")</p>
    </div>
    <div class="admin-actions">
        <form method="post" asp-page-handler="TogglePublish" asp-route-id="@Model.Video.Id" style="display: inline;">
            <button type="submit" class="btn-admin btn-admin-secondary">
                @(Model.Video.IsPublished ? "Unpublish" : "Publish Live")
            </button>
        </form>
        <a href="/centralwks/helpdesk/videos/edit/@Model.Video.Id" class="btn-admin btn-admin-primary">
            <span>✏️</span> Edit Video
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
    @* Left Column: Embedded Player & Notes *@
    <div>
        <div class="admin-card" style="padding: 24px; margin-bottom: 24px;">
            @* Embedded Responsive YouTube Player *@
            <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #000; margin-bottom: 20px; border: 1px solid var(--admin-card-border);">
                <iframe src="https://www.youtube.com/embed/@Model.Video.YouTubeVideoId?rel=0" 
                        title="@Model.Video.Title" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen 
                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></iframe>
            </div>

            <h2 style="font-size: 16px; font-weight: 600; color: var(--admin-text); margin-bottom: 12px;">Walkthrough Description &amp; Chapters</h2>
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 20px; line-height: 1.7; color: #cbd5e1; font-size: 14px; white-space: pre-wrap;">
                @Model.Video.Description
            </div>
        </div>
    </div>

    @* Right Column: Metadata & Actions *@
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <div class="admin-card" style="padding: 20px;">
            <h3 style="font-size: 14px; font-weight: 600; color: var(--admin-text); margin-bottom: 16px;">Video Specifications</h3>
            
            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Enterprise Suite</div>
                <div style="font-size: 13px; font-weight: 500; color: var(--admin-text);">@Model.Video.SuiteCode</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Video.FeatureCode))
            {
                <div style="margin-bottom: 12px;">
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Feature Permocode</div>
                    <div style="font-size: 13px; font-family: monospace; color: #cbd5e1;">@Model.Video.FeatureCode</div>
                </div>
            }

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Content Duration</div>
                <div style="font-size: 13px; color: var(--admin-text);">@mins minutes @secs seconds</div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Total Audience Views</div>
                <div style="font-size: 13px; font-weight: 600; color: #93c5fd;">@Model.Video.ViewCount.ToString("N0")</div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Direct YouTube URL</div>
                <div style="margin-top: 4px;">
                    <a href="https://www.youtube.com/watch?v=@Model.Video.YouTubeVideoId" target="_blank" style="font-size: 12px; color: #93c5fd; text-decoration: none; word-break: break-all;">
                        youtube.com/watch?v=@Model.Video.YouTubeVideoId ↗
                    </a>
                </div>
            </div>

            <div>
                <div style="font-size: 11px; color: var(--admin-text-muted);">Added Date</div>
                <div style="font-size: 13px; color: var(--admin-text);">@Model.Video.CreatedUtc.ToString("dd MMM yyyy, HH:mm") UTC</div>
            </div>
        </div>

        <div class="admin-card" style="padding: 20px; border-color: rgba(239, 68, 68, 0.2);">
            <h3 style="font-size: 14px; font-weight: 600; color: #f87171; margin-bottom: 8px;">Danger Zone</h3>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 12px;">Permanently deletes this video walkthrough tutorial from the public portal.</p>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Video.Id">
                <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); width: 100%;" onclick="return confirm('Permanently delete video guide @Model.Video.Title?');">
                    Permanently Delete Video
                </button>
            </form>
        </div>
    </div>
</div>
