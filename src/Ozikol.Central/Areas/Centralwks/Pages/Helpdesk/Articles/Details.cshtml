@page "/centralwks/helpdesk/articles/details/{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Helpdesk.Articles.DetailsModel
@{
    ViewData["Title"] = Model.Article.Title;
    ViewData["BreadcrumbSection"] = "Helpdesk";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/centralwks/helpdesk/articles" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Articles</a>
            <span style="color: var(--admin-text-muted); font-size: 12px;">•</span>
            <span style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
                @Model.Article.SuiteCode
            </span>
            <span style="background: rgba(255, 255, 255, 0.05); color: #cbd5e1; padding: 2px 8px; border-radius: 9999px; font-size: 11px;">
                @Model.Article.Category
            </span>
            <span style="font-size: 11px; font-weight: 600; background: rgba(255, 255, 255, 0.05); color: #cbd5e1; padding: 2px 6px; border-radius: 4px;">
                @Model.Article.Culture.ToUpperInvariant()
            </span>
            @if (Model.Article.IsPublished)
            {
                <span style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">● Live</span>
            }
            else
            {
                <span style="background: rgba(148, 163, 184, 0.15); color: #94a3b8; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">○ Draft</span>
            }
        </div>
        <h1 class="admin-title">@Model.Article.Title</h1>
        <p class="admin-subtitle">Permalink: <code>/help/@Model.Article.Slug</code> • ~@Model.Article.EstimatedReadMinutes min read</p>
    </div>
    <div class="admin-actions">
        <form method="post" asp-page-handler="TogglePublish" asp-route-id="@Model.Article.Id" style="display: inline;">
            <button type="submit" class="btn-admin btn-admin-secondary">
                @(Model.Article.IsPublished ? "Unpublish" : "Publish Live")
            </button>
        </form>
        <a href="/centralwks/helpdesk/articles/edit/@Model.Article.Id" class="btn-admin btn-admin-primary">
            <span>✏️</span> Edit Article
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #93c5fd; border-radius: 8px; padding: 12px 18px; margin-bottom: 24px;">
        @Model.StatusMessage
    </div>
}

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
    @* Left Column: Guide Content *@
    <div>
        <div class="admin-card" style="padding: 24px; margin-bottom: 24px;">
            <h2 style="font-size: 16px; font-weight: 600; color: var(--admin-text); margin-bottom: 12px;">Executive Overview</h2>
            <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 16px; line-height: 1.6; color: #cbd5e1; font-size: 14px;">
                @Model.Article.Summary
            </div>

            <h2 style="font-size: 16px; font-weight: 600; color: var(--admin-text); margin-top: 24px; margin-bottom: 12px;">Guide Content</h2>
            <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 24px; line-height: 1.7; color: #e2e8f0; font-size: 14px;">
                @Html.Raw(Model.Article.ContentHtml)
            </div>
        </div>
    </div>

    @* Right Column: Metrics & Metadata *@
    <div style="display: flex; flex-direction: column; gap: 24px;">
        @* Readership Card *@
        <div class="admin-card" style="padding: 20px;">
            <h3 style="font-size: 14px; font-weight: 600; color: var(--admin-text); margin-bottom: 16px;">Engagement Metrics</h3>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px;">
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); border-radius: 6px; padding: 12px; text-align: center;">
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Total Views</div>
                    <div style="font-size: 18px; font-weight: 600; color: #93c5fd; margin-top: 2px;">@Model.Article.ViewCount.ToString("N0")</div>
                </div>
                <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); border-radius: 6px; padding: 12px; text-align: center;">
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Helpful Upvotes</div>
                    <div style="font-size: 18px; font-weight: 600; color: #34d399; margin-top: 2px;">@Model.Article.HelpfulCount.ToString("N0")</div>
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Enterprise Suite</div>
                <div style="font-size: 13px; font-weight: 500; color: var(--admin-text);">@Model.Article.SuiteCode</div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Article.FeatureCode))
            {
                <div style="margin-bottom: 12px;">
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Feature Permocode</div>
                    <div style="font-size: 13px; font-family: monospace; color: #cbd5e1;">@Model.Article.FeatureCode</div>
                </div>
            }

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Category Classification</div>
                <div style="font-size: 13px; color: var(--admin-text);">@Model.Article.Category</div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Estimated Read Duration</div>
                <div style="font-size: 13px; color: var(--admin-text);">@Model.Article.EstimatedReadMinutes minutes</div>
            </div>

            <div>
                <div style="font-size: 11px; color: var(--admin-text-muted);">Last Revised</div>
                <div style="font-size: 13px; color: var(--admin-text);">@Model.Article.UpdatedUtc.ToString("dd MMM yyyy, HH:mm") UTC</div>
            </div>
        </div>

        @* Danger Zone *@
        <div class="admin-card" style="padding: 20px; border-color: rgba(239, 68, 68, 0.2);">
            <h3 style="font-size: 14px; font-weight: 600; color: #f87171; margin-bottom: 8px;">Danger Zone</h3>
            <p style="font-size: 12px; color: var(--admin-text-muted); margin-bottom: 12px;">Permanently deletes this knowledge base guide from customer help centers.</p>
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Article.Id">
                <button type="submit" class="btn-admin" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); width: 100%;" onclick="return confirm('Permanently delete helpdesk article @Model.Article.Title?');">
                    Permanently Delete Guide
                </button>
            </form>
        </div>
    </div>
</div>
