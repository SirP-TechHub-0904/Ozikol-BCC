@page "/centralwks/helpdesk/articles/edit/{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.Helpdesk.Articles.EditModel
@{
    ViewData["Title"] = "Edit Helpdesk Article";
    ViewData["BreadcrumbSection"] = "Helpdesk";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/helpdesk/articles/details/@Model.Id" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Details</a>
            <span style="color: var(--admin-text-muted); font-size: 12px;">•</span>
            <a href="/centralwks/helpdesk/articles" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">All Articles</a>
        </div>
        <h1 class="admin-title">Edit Article: @Model.Input.Title</h1>
        <p class="admin-subtitle">Update guide contents, category classification, feature codes, or publication status.</p>
    </div>
</div>

<div class="admin-card" style="max-width: 900px; padding: 28px;">
    <form method="post">
        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Title" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Article Title <span style="color: #f87171;">*</span>
            </label>
            <input asp-for="Input.Title" class="form-control" placeholder="e.g. Article Title" style="font-size: 15px; font-weight: 500;" />
            <span asp-validation-for="Input.Title" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.Slug" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    URL Permalink Slug <span style="color: #f87171;">*</span>
                </label>
                <div style="display: flex; align-items: center; border: 1px solid var(--admin-border); border-radius: 8px; overflow: hidden; background: var(--admin-bg-surface);">
                    <span style="padding: 10px 12px; color: var(--admin-text-muted); font-size: 13px; background: rgba(255, 255, 255, 0.03); border-right: 1px solid var(--admin-border); font-family: monospace;">
                        /help/
                    </span>
                    <input asp-for="Input.Slug" class="form-control" style="flex: 1; border: none; background: transparent; padding: 10px 14px; color: #93c5fd; font-size: 13px; font-family: monospace;" />
                </div>
                <span asp-validation-for="Input.Slug" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
            </div>

            <div>
                <label asp-for="Input.SuiteCode" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Enterprise Suite <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.SuiteCode" class="form-select">
                    <option value="suite-operations">Operations & Logistics (suite-operations)</option>
                    <option value="suite-inventory">Multi-Warehouse Inventory (suite-inventory)</option>
                    <option value="suite-pos">Retail Point of Sale (suite-pos)</option>
                    <option value="suite-people">Workforce & People (suite-people)</option>
                    <option value="suite-ecommerce">Global Storefronts (suite-ecommerce)</option>
                    <option value="suite-billing">Ledger & Financials (suite-billing)</option>
                    <option value="suite-analytics">Predictive AI Analytics (suite-analytics)</option>
                    <option value="suite-platform">Platform Core & API (suite-platform)</option>
                </select>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 16px; margin-bottom: 18px;">
            <div>
                <label asp-for="Input.FeatureCode" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Feature Code (Optional)
                </label>
                <input asp-for="Input.FeatureCode" class="form-control" placeholder="e.g. staff-rota" />
            </div>

            <div>
                <label asp-for="Input.Category" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Category <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.Category" class="form-select">
                    <option value="Getting Started">Getting Started</option>
                    <option value="Configuration">Configuration</option>
                    <option value="Troubleshooting">Troubleshooting</option>
                    <option value="Best Practices">Best Practices</option>
                    <option value="API & Webhooks">API & Webhooks</option>
                </select>
            </div>

            <div>
                <label asp-for="Input.Culture" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Language <span style="color: #f87171;">*</span>
                </label>
                <select asp-for="Input.Culture" class="form-select">
                    <option value="en">English (en)</option>
                    <option value="fr">French (fr)</option>
                    <option value="es">Spanish (es)</option>
                    <option value="de">German (de)</option>
                </select>
            </div>

            <div>
                <label asp-for="Input.EstimatedReadMinutes" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                    Read Minutes
                </label>
                <input asp-for="Input.EstimatedReadMinutes" type="number" min="1" max="60" class="form-control" />
            </div>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.Summary" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Summary / Card Excerpt <span style="color: #f87171;">*</span>
            </label>
            <textarea asp-for="Input.Summary" rows="3" class="form-control" placeholder="Summary of helpdesk article..." style="resize: vertical;"></textarea>
            <span asp-validation-for="Input.Summary" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="margin-bottom: 18px;">
            <label asp-for="Input.ContentHtml" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 6px;">
                Article Body (HTML) <span style="color: #f87171;">*</span>
            </label>
            <textarea asp-for="Input.ContentHtml" rows="14" class="form-control" placeholder="Full knowledge base article content in HTML format..." style="font-family: monospace; font-size: 13px; line-height: 1.5; resize: vertical;"></textarea>
            <span asp-validation-for="Input.ContentHtml" style="color: #f87171; font-size: 12px; margin-top: 4px; display: block;"></span>
        </div>

        <div style="margin-bottom: 24px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 12px 16px;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--admin-text); cursor: pointer;">
                <input type="checkbox" asp-for="Input.IsPublished" style="accent-color: var(--admin-accent); width: 16px; height: 16px;" />
                Publish live immediately to knowledge base
            </label>
        </div>

        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <a href="/centralwks/helpdesk/articles/details/@Model.Id" class="btn-admin btn-admin-secondary">Cancel</a>
            <button type="submit" class="btn-admin btn-admin-primary">
                <span class="material-symbols-outlined" style="font-size: 16px;">save</span>
                Save Changes
            </button>
        </div>
    </form>
</div>
