@page "/centralwks/profile"
@model Ozikol.Central.Areas.Centralwks.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "My Profile & Security Hub";
    ViewData["BreadcrumbSection"] = "Account";
    var userInitials = (Model.CurrentUser.FirstName?.Length > 0 ? Model.CurrentUser.FirstName[0].ToString() : "") +
                       (Model.CurrentUser.LastName?.Length > 0 ? Model.CurrentUser.LastName[0].ToString() : "");
    if (string.IsNullOrWhiteSpace(userInitials))
    {
        userInitials = Model.CurrentUser.UserName?.Substring(0, Math.Min(2, Model.CurrentUser.UserName.Length)).ToUpperInvariant() ?? "AD";
    }
}

<div class="admin-page-header" style="width: 100%; margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; width: 100%; flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; border: 2px solid var(--admin-border); box-shadow: var(--shadow-sm);">
                @userInitials.ToUpperInvariant()
            </div>
            <div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <h1 class="admin-title" style="margin: 0; font-size: 22px;">@Model.CurrentUser.FirstName @Model.CurrentUser.LastName</h1>
                    <span style="font-size: 11.5px; font-family: monospace; color: var(--admin-text-muted); background: var(--admin-bg-surface-elevated); padding: 2px 8px; border-radius: 4px; border: 1px solid var(--admin-border);">
                        @@@Model.CurrentUser.UserName
                    </span>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; margin-top: 4px; font-size: 12.5px; color: var(--admin-text-muted);">
                    <span>@Model.CurrentUser.Email</span>
                    <span>&bull;</span>
                    <span style="color: var(--admin-primary); font-weight: 600;">@Model.CurrentUser.Department</span>
                    <span>&bull;</span>
                    <span>Joined @Model.CurrentUser.CreatedUtc.ToString("MMM yyyy")</span>
                </div>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
            @foreach (var role in Model.AssignedRoles)
            {
                <span style="background: rgba(124, 58, 237, 0.12); color: #7c3aed; border: 1px solid rgba(124, 58, 237, 0.25); padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700;">
                    @role
                </span>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="admin-alert admin-alert-info" style="background: rgba(37, 99, 235, 0.12); border: 1px solid rgba(37, 99, 235, 0.25); color: #2563eb; border-radius: var(--radius-md); padding: 14px 18px; margin-bottom: 24px; font-size: 13.5px; display: flex; align-items: center; gap: 10px;">
        <span class="material-symbols-outlined" style="font-size: 20px;">info</span>
        <span>@Model.StatusMessage</span>
    </div>
}

@* ── Navigation Tabs ── *@
<div style="display: flex; gap: 6px; padding: 4px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); margin-bottom: 24px; overflow-x: auto;">
    <a href="/centralwks/profile?tab=profile" class="btn-admin @(Model.ActiveTab == "profile" ? "btn-admin-primary" : "btn-admin-secondary")" style="padding: 8px 18px; font-size: 13px; text-decoration: none; border: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
        <span class="material-symbols-outlined" style="font-size: 18px;">badge</span>
        Personal Profile
    </a>
    <a href="/centralwks/profile?tab=security" class="btn-admin @(Model.ActiveTab == "security" ? "btn-admin-primary" : "btn-admin-secondary")" style="padding: 8px 18px; font-size: 13px; text-decoration: none; border: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
        <span class="material-symbols-outlined" style="font-size: 18px;">lock</span>
        Password &amp; Security
    </a>
    <a href="/centralwks/profile?tab=2fa" class="btn-admin @(Model.ActiveTab == "2fa" ? "btn-admin-primary" : "btn-admin-secondary")" style="padding: 8px 18px; font-size: 13px; text-decoration: none; border: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
        <span class="material-symbols-outlined" style="font-size: 18px;">verified_user</span>
        Two-Factor Authentication (2FA)
    </a>
    <a href="/centralwks/profile?tab=roles" class="btn-admin @(Model.ActiveTab == "roles" ? "btn-admin-primary" : "btn-admin-secondary")" style="padding: 8px 18px; font-size: 13px; text-decoration: none; border: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
        <span class="material-symbols-outlined" style="font-size: 18px;">admin_panel_settings</span>
        My Roles &amp; Capabilities
    </a>
    <a href="/centralwks/profile?tab=activity" class="btn-admin @(Model.ActiveTab == "activity" ? "btn-admin-primary" : "btn-admin-secondary")" style="padding: 8px 18px; font-size: 13px; text-decoration: none; border: none; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
        <span class="material-symbols-outlined" style="font-size: 18px;">history</span>
        My Activity Log
    </a>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   TAB 1: PERSONAL PROFILE
   ══════════════════════════════════════════════════════════════════════════ *@
@if (Model.ActiveTab == "profile")
{
    <form method="post" asp-page-handler="UpdateProfile" style="width: 100%;">
        @Html.AntiForgeryToken()
        <div class="admin-card" style="width: 100%; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0;">Personal Operator Information</h2>
                    <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Update your display name, contact phone number, and organizational unit.</p>
                </div>
            </div>

            <div style="padding: 24px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
                    <div>
                        <label asp-for="ProfileInput.FirstName" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            First Name <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="ProfileInput.FirstName" class="form-control" placeholder="e.g. First Name" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="ProfileInput.FirstName" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="ProfileInput.LastName" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Last Name <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="ProfileInput.LastName" class="form-control" placeholder="e.g. Last Name" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="ProfileInput.LastName" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="ProfileInput.PhoneNumber" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Phone Number
                        </label>
                        <input asp-for="ProfileInput.PhoneNumber" class="form-control" placeholder="e.g. +0 (000) 000-0000" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="ProfileInput.PhoneNumber" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Work Email (System Identifier)
                        </label>
                        <input value="@Model.CurrentUser.Email" class="form-control" disabled style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); color: var(--admin-text-muted);" />
                        <span style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Email changes must be requested through SuperAdmin governance.</span>
                    </div>

                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Username
                        </label>
                        <input value="@Model.CurrentUser.UserName" class="form-control" disabled style="font-family: monospace; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); color: var(--admin-text-muted);" />
                    </div>

                    <div>
                        <label asp-for="ProfileInput.Department" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Department
                        </label>
                        <select asp-for="ProfileInput.Department" class="form-select" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border); color: var(--admin-text);">
                            @foreach (var dept in Ozikol.Central.Areas.Centralwks.Pages.Users.CreateModel.DepartmentOptions)
                            {
                                <option value="@dept">@dept</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div style="padding: 16px 24px; background: var(--admin-bg-surface-elevated); border-top: 1px solid var(--admin-border); display: flex; justify-content: flex-end;">
                <button type="submit" class="btn-admin btn-admin-primary" style="padding: 9px 24px; font-size: 13px;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                    Save Profile Changes
                </button>
            </div>
        </div>
    </form>
}

@* ══════════════════════════════════════════════════════════════════════════
   TAB 2: PASSWORD & SECURITY
   ══════════════════════════════════════════════════════════════════════════ *@
@if (Model.ActiveTab == "security")
{
    <form method="post" asp-page-handler="ChangePassword" style="width: 100%;">
        @Html.AntiForgeryToken()
        <div class="admin-card" style="width: 100%; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0;">Change Account Password</h2>
                <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Ensure you use a strong, unique password with at least 8 characters, numbers, and symbols.</p>
            </div>

            <div style="padding: 24px;">
                <div style="max-width: 480px; display: flex; flex-direction: column; gap: 18px;">
                    <div>
                        <label asp-for="PasswordInput.CurrentPassword" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Current Password <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="PasswordInput.CurrentPassword" type="password" class="form-control" placeholder="••••••••••••" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="PasswordInput.CurrentPassword" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="PasswordInput.NewPassword" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            New Password <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="PasswordInput.NewPassword" type="password" class="form-control" placeholder="••••••••••••" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="PasswordInput.NewPassword" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="PasswordInput.ConfirmPassword" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Confirm New Password <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="PasswordInput.ConfirmPassword" type="password" class="form-control" placeholder="••••••••••••" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="PasswordInput.ConfirmPassword" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>
                </div>
            </div>

            <div style="padding: 16px 24px; background: var(--admin-bg-surface-elevated); border-top: 1px solid var(--admin-border); display: flex; justify-content: flex-end;">
                <button type="submit" class="btn-admin btn-admin-primary" style="padding: 9px 24px; font-size: 13px;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">key</span>
                    Update Password
                </button>
            </div>
        </div>
    </form>
}

@* ══════════════════════════════════════════════════════════════════════════
   TAB 3: TWO-FACTOR AUTHENTICATION (2FA)
   ══════════════════════════════════════════════════════════════════════════ *@
@if (Model.ActiveTab == "2fa")
{
    <div style="display: flex; flex-direction: column; gap: 24px; width: 100%;">
        <div class="admin-card" style="width: 100%; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div>
                    <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0;">Two-Factor Authentication (2FA) Security</h2>
                    <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Adds an extra layer of protection by requiring a 6-digit one-time passcode (OTP) at sign-in.</p>
                </div>
                <div>
                    @if (Model.CurrentUser.TwoFactorEnabled)
                    {
                        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #059669; background: rgba(5, 150, 105, 0.12); border: 1px solid rgba(5, 150, 105, 0.3); padding: 4px 12px; border-radius: 9999px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">verified_user</span>
                            2FA ACTIVE &amp; ENFORCED
                        </span>
                    }
                    else
                    {
                        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #d97706; background: rgba(217, 119, 6, 0.12); border: 1px solid rgba(217, 119, 6, 0.3); padding: 4px 12px; border-radius: 9999px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">warning</span>
                            2FA DISABLED
                        </span>
                    }
                </div>
            </div>

            <div style="padding: 24px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
                    <div style="padding: 20px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md);">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <span class="material-symbols-outlined" style="color: #2563eb; font-size: 22px;">mail</span>
                            <strong style="color: var(--admin-text); font-size: 14px;">Email OTP Verification (Default)</strong>
                        </div>
                        <p style="font-size: 12.5px; color: var(--admin-text-muted); line-height: 1.5; margin-bottom: 16px;">
                            When enabled, signing in to Centralwks will dispatch a high-priority 6-digit numeric OTP to <strong>@Model.CurrentUser.Email</strong> valid for 10 minutes.
                        </p>
                        <form method="post" asp-page-handler="SendTwoFactorOtpTest" style="display: inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-admin btn-admin-secondary" style="font-size: 12px; padding: 6px 14px;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">send</span>
                                Send Test 2FA OTP Email
                            </button>
                        </form>
                    </div>

                    <div style="padding: 20px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                                <span class="material-symbols-outlined" style="color: #7c3aed; font-size: 22px;">shield</span>
                                <strong style="color: var(--admin-text); font-size: 14px;">Governance Recommendation</strong>
                            </div>
                            <p style="font-size: 12.5px; color: var(--admin-text-muted); line-height: 1.5; margin: 0;">
                                Platform security policy recommends all operators with <code>SuperAdmin</code> or <code>Admin</code> permissions enforce 2FA to prevent unauthorized credential reuse.
                            </p>
                        </div>
                        <div style="margin-top: 16px;">
                            <form method="post" asp-page-handler="ToggleTwoFactor" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                @if (Model.CurrentUser.TwoFactorEnabled)
                                {
                                    <button type="submit" class="btn-admin btn-admin-secondary" style="font-size: 12.5px; padding: 8px 18px; color: var(--admin-danger);">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">lock_open</span>
                                        Disable 2FA Protection
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn-admin btn-admin-primary" style="font-size: 12.5px; padding: 8px 22px;">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">verified_user</span>
                                        Enable 2FA Protection Now
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Browser Desktop Push Alerts Management Card ── *@
        <div class="admin-card" style="width: 100%; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div>
                    <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0; display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="font-size: 20px; color: var(--admin-primary);">notifications_active</span>
                        Browser Desktop Push Notifications
                    </h2>
                    <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Receive instant OS-level push notifications for background jobs, billing cycles, and security events.</p>
                </div>
                <div id="pushStatusBadge">
                    <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--admin-text-muted); background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); padding: 4px 12px; border-radius: 9999px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">pending</span>
                        CHECKING...
                    </span>
                </div>
            </div>

            <div style="padding: 24px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
                    <div style="padding: 20px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md);">
                        <h4 style="font-size: 13.5px; font-weight: 700; color: var(--admin-text); margin: 0 0 8px 0; display: flex; align-items: center; gap: 8px;">
                            <span class="material-symbols-outlined" style="color: #2563eb; font-size: 20px;">devices</span>
                            Device &amp; Browser Subscription
                        </h4>
                        <p style="font-size: 12.5px; color: var(--admin-text-muted); line-height: 1.5; margin: 0 0 16px 0;">
                            Your browser session will be linked securely to your Central operator account (<strong>@@@Model.CurrentUser.UserName</strong>) via OneSignal.
                        </p>
                        <div id="pushActionWrapper">
                            <button type="button" id="profileEnablePushBtn" class="btn-admin btn-admin-primary" style="font-size: 12.5px; padding: 8px 18px; display: inline-flex; align-items: center; gap: 6px;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">notifications_active</span>
                                Enable Browser Push Alerts
                            </button>
                        </div>
                    </div>

                    <div style="padding: 20px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md);">
                        <h4 style="font-size: 13.5px; font-weight: 700; color: var(--admin-text); margin: 0 0 8px 0; display: flex; align-items: center; gap: 8px;">
                            <span class="material-symbols-outlined" style="color: #059669; font-size: 20px;">info</span>
                            Privacy &amp; Control
                        </h4>
                        <p style="font-size: 12.5px; color: var(--admin-text-muted); line-height: 1.5; margin: 0;">
                            You will only receive critical operational broadcasts and background alerts relevant to your assigned security roles. You can disable permissions at any time through your browser settings.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════════════
   TAB 4: MY ROLES & CAPABILITIES MATRIX
   ══════════════════════════════════════════════════════════════════════════ *@
@if (Model.ActiveTab == "roles")
{
    var isSuperAdmin = Model.AssignedRoles.Contains("SuperAdmin");
    var isAdmin = Model.AssignedRoles.Contains("Admin") || isSuperAdmin;
    var isSupport = Model.AssignedRoles.Contains("Support") || isSuperAdmin;
    var isBilling = Model.AssignedRoles.Contains("Billing") || isSuperAdmin;

    <div style="display: flex; flex-direction: column; gap: 24px; width: 100%;">
        <div class="admin-card" style="width: 100%; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0;">Assigned Security Roles &amp; Administrative Scope</h2>
                <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">These roles determine your access permissions across central and tenant modules.</p>
            </div>

            <div style="padding: 24px;">
                <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px;">
                    @foreach (var role in Model.AssignedRoles)
                    {
