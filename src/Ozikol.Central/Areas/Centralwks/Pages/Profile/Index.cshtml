                            @(isAdmin ? "check_circle" : "cancel")
                        </span>
                        <div>
                            <strong style="color: var(--admin-text); font-size: 13.5px;">Tenant Organizations Management</strong>
                            <p style="font-size: 12px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Provision, inspect, suspend, and configure tenant environments.</p>
                        </div>
                    </div>

                    <div style="padding: 14px 18px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; align-items: flex-start; gap: 12px;">
                        <span class="material-symbols-outlined" style="color: @(isAdmin ? "#059669" : "var(--admin-text-muted)"); font-size: 22px;">
                            @(isAdmin ? "check_circle" : "cancel")
                        </span>
                        <div>
                            <strong style="color: var(--admin-text); font-size: 13.5px;">Feature Catalog &amp; Capability Flags</strong>
                            <p style="font-size: 12px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Manage canonical features, add-ons, pricing, and tenant entitlements.</p>
                        </div>
                    </div>

                    <div style="padding: 14px 18px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; align-items: flex-start; gap: 12px;">
                        <span class="material-symbols-outlined" style="color: @(isSuperAdmin ? "#059669" : "var(--admin-text-muted)"); font-size: 22px;">
                            @(isSuperAdmin ? "check_circle" : "cancel")
                        </span>
                        <div>
                            <strong style="color: var(--admin-text); font-size: 13.5px;">Background Automation &amp; Workers Hub</strong>
                            <p style="font-size: 12px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Trigger, schedule, inspect, and pause automated platform jobs.</p>
                        </div>
                    </div>

                    <div style="padding: 14px 18px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; align-items: flex-start; gap: 12px;">
                        <span class="material-symbols-outlined" style="color: @(isBilling ? "#059669" : "var(--admin-text-muted)"); font-size: 22px;">
                            @(isBilling ? "check_circle" : "cancel")
                        </span>
                        <div>
                            <strong style="color: var(--admin-text); font-size: 13.5px;">Billing, MRR &amp; Coupon Vouchers</strong>
                            <p style="font-size: 12px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Inspect subscription revenue, grant promo codes, review payouts.</p>
                        </div>
                    </div>

                    <div style="padding: 14px 18px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; align-items: flex-start; gap: 12px;">
                        <span class="material-symbols-outlined" style="color: @(isSuperAdmin ? "#059669" : "var(--admin-text-muted)"); font-size: 22px;">
                            @(isSuperAdmin ? "check_circle" : "cancel")
                        </span>
                        <div>
                            <strong style="color: var(--admin-text); font-size: 13.5px;">Operator Identity &amp; RBAC Governance</strong>
                            <p style="font-size: 12px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Provision operators, modify roles, lock accounts, send notices.</p>
                        </div>
                    </div>

                    <div style="padding: 14px 18px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); display: flex; align-items: flex-start; gap: 12px;">
                        <span class="material-symbols-outlined" style="color: @(isSupport ? "#059669" : "var(--admin-text-muted)"); font-size: 22px;">
                            @(isSupport ? "check_circle" : "cancel")
                        </span>
                        <div>
                            <strong style="color: var(--admin-text); font-size: 13.5px;">Support Helpdesk &amp; Inquiries</strong>
                            <p style="font-size: 12px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Manage customer support tickets, replies, and partner applications.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ══════════════════════════════════════════════════════════════════════════
   TAB 5: MY ACTIVITY LOG & SESSION HISTORY
   ══════════════════════════════════════════════════════════════════════════ *@
@if (Model.ActiveTab == "activity")
{
    <div class="admin-card" style="width: 100%; padding: 0; overflow: hidden; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
        <div style="padding: 18px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h2 style="font-size: 15.5px; font-weight: 600; color: var(--admin-text); margin: 0;">My Personal Audit Trail &amp; Activity History</h2>
                <p style="font-size: 12.5px; color: var(--admin-text-muted); margin: 2px 0 0 0;">Every action, sign-in, and configuration change performed under your identity.</p>
            </div>
            <a href="/centralwks/audit-log" class="btn-admin btn-admin-secondary" style="font-size: 12px; padding: 6px 14px;">
                View System Audit Trail &rarr;
            </a>
        </div>

        @if (Model.PersonalAuditLogs.Count == 0)
        {
            <div style="text-align: center; padding: 48px 24px;">
                <span class="material-symbols-outlined" style="font-size: 40px; color: var(--admin-text-muted);">history</span>
                <p style="font-size: 13px; color: var(--admin-text-muted); margin-top: 8px;">No audit events recorded for this session yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="admin-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="background: var(--admin-bg-surface-elevated); border-bottom: 1px solid var(--admin-border); font-size: 12px; color: var(--admin-text-muted); text-transform: uppercase; letter-spacing: 0.5px;">
                            <th style="padding: 12px 18px;">Timestamp (UTC)</th>
                            <th style="padding: 12px 18px;">Action</th>
                            <th style="padding: 12px 18px;">Entity</th>
                            <th style="padding: 12px 18px;">Summary</th>
                            <th style="padding: 12px 18px;">IP Address</th>
                            <th style="padding: 12px 18px; text-align: right;">Diff</th>
                        </tr>
                    </thead>
                    <tbody style="font-size: 13px; color: var(--admin-text);">
                        @foreach (var log in Model.PersonalAuditLogs)
                        {
                            <tr style="border-bottom: 1px solid var(--admin-border); transition: var(--transition);">
                                <td style="padding: 14px 18px; font-weight: 600; font-family: monospace;">
                                    @log.CreatedUtc.ToString("MMM dd, yyyy HH:mm:ss")
                                </td>
                                <td style="padding: 14px 18px;">
                                    <span style="font-weight: 700; color: #2563eb; background: rgba(37, 99, 235, 0.12); padding: 2px 8px; border-radius: 4px; font-size: 11.5px;">
                                        @log.Action
                                    </span>
                                </td>
                                <td style="padding: 14px 18px; font-weight: 600;">
                                    @log.EntityType
                                </td>
                                <td style="padding: 14px 18px; max-width: 320px;">
                                    <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@log.Summary">
                                        @(log.Summary ?? "—")
                                    </div>
                                </td>
                                <td style="padding: 14px 18px; font-family: monospace; font-size: 12px; color: var(--admin-text-muted);">
                                    @(log.IpAddress ?? "127.0.0.1")
                                </td>
                                <td style="padding: 14px 18px; text-align: right;">
                                    <a href="/centralwks/audit-log/details?id=@log.Id" class="btn-admin btn-admin-secondary" style="font-size: 11.5px; padding: 4px 10px; text-decoration: none;">
                                        Inspect
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const badge = document.getElementById('pushStatusBadge');
            const actionWrapper = document.getElementById('pushActionWrapper');

            if (!badge || !actionWrapper || !window.OzikolPush) return;

            async function refreshPushUI() {
                const perm = await window.OzikolPush.getPermission();
                if (perm === 'granted') {
                    badge.innerHTML = `
                        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #059669; background: rgba(5, 150, 105, 0.12); border: 1px solid rgba(5, 150, 105, 0.3); padding: 4px 12px; border-radius: 9999px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">verified</span>
                            PUSH ALERTS ACTIVE
                        </span>`;
                    actionWrapper.innerHTML = `
                        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                            <span style="font-size: 12.5px; color: #059669; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">check_circle</span>
                                Subscribed on this browser
                            </span>
                            <button type="button" id="profileTestPushBtn" class="btn-admin btn-admin-secondary" style="font-size: 12px; padding: 6px 14px; display: inline-flex; align-items: center; gap: 6px;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">send</span>
                                Send Test Push Alert
                            </button>
                        </div>`;

                    const testBtn = document.getElementById('profileTestPushBtn');
                    if (testBtn) {
                        testBtn.addEventListener('click', async () => {
                            testBtn.disabled = true;
                            testBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px;">hourglass_empty</span> Sending...';
                            await window.OzikolPush.sendTestNotification();
                            setTimeout(() => {
                                testBtn.disabled = false;
                                testBtn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px;">send</span> Send Test Push Alert';
                            }, 1500);
                        });
                    }
                } else if (perm === 'denied') {
                    badge.innerHTML = `
                        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #dc2626; background: rgba(220, 38, 38, 0.12); border: 1px solid rgba(220, 38, 38, 0.3); padding: 4px 12px; border-radius: 9999px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">block</span>
                            BLOCKED IN BROWSER
                        </span>`;
                    actionWrapper.innerHTML = `
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <span style="font-size: 12.5px; color: var(--admin-danger); line-height: 1.5;">
                                <strong>Notifications are blocked:</strong> To enable push alerts, click the lock / tune settings icon in your browser address bar (next to the URL) and change <strong>Notifications</strong> to <strong>Allow</strong>, then refresh this page.
                            </span>
                        </div>`;
                } else {
                    badge.innerHTML = `
                        <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: #d97706; background: rgba(217, 119, 6, 0.12); border: 1px solid rgba(217, 119, 6, 0.3); padding: 4px 12px; border-radius: 9999px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">notifications_paused</span>
                            NOT ENABLED
                        </span>`;
                    actionWrapper.innerHTML = `
                        <button type="button" id="profileEnablePushBtn" class="btn-admin btn-admin-primary" style="font-size: 12.5px; padding: 8px 18px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">notifications_active</span>
                            Enable Browser Push Alerts
                        </button>`;

                    const btn = document.getElementById('profileEnablePushBtn');
                    if (btn) {
                        btn.addEventListener('click', async () => {
                            btn.disabled = true;
                            btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 16px;">hourglass_top</span> Requesting...';
                            await window.OzikolPush.enablePush();
                            await refreshPushUI();
                        });
                    }
                }
            }

            await refreshPushUI();
            window.addEventListener('ozikol-push-changed', () => refreshPushUI());
        });
    </script>
}
