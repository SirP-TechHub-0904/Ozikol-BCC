@page "/centralwks/audit-log"
@model Ozikol.Central.Areas.Centralwks.Pages.AuditLog.IndexModel
@{
    ViewData["Title"] = "Security Audit Trail";
    ViewData["BreadcrumbSection"] = "Security";
}

<div class="admin-page-header" style="width: 100%; margin-bottom: 24px;">
    <div class="admin-title-group">
        <h1 class="admin-title">Immutable Security Audit Trail</h1>
        <p class="admin-subtitle">Real-time cryptographic and regulatory compliance feed recording administrative operations, role changes, and data modifications.</p>
    </div>
</div>

@* ── Audit Metrics ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">shield</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Total Audit Events</span>
            <span class="stat-value" style="font-size: 22px;">@Model.TotalCount.ToString("N0")</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">bolt</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Events Logged Today</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">@Model.EventsTodayCount.ToString("N0")</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper" style="width: 40px; height: 40px; background: rgba(59, 130, 246, 0.15); color: #3b82f6;">
            <span class="material-symbols-outlined" style="font-size: 20px;">group</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Contributing Operators</span>
            <span class="stat-value" style="font-size: 22px; color: #3b82f6;">@Model.OperatorsCount</span>
        </div>
    </div>
</div>

@* ── Filters ── *@
<div class="admin-card" style="padding: 16px 20px; margin-bottom: 24px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg);">
    <form method="get" style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center;">
        <div style="flex: 1; min-width: 220px;">
            <input type="text" name="search" value="@Model.Search" placeholder="Search by operator username, summary, target ID, or IP address..." 
                   class="form-control" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
        </div>

        <div style="min-width: 150px;">
            <select name="actionFilter" class="form-select" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);">
                <option value="">All Actions</option>
                @foreach (var a in Model.AvailableActions)
                {
                    <option value="@a" selected="@(Model.ActionFilter == a ? "selected" : null)">@a</option>
                }
            </select>
        </div>

        <div style="min-width: 160px;">
            <select name="entityFilter" class="form-select" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);">
                <option value="">All Entity Types</option>
                @foreach (var e in Model.AvailableEntities)
                {
                    <option value="@e" selected="@(Model.EntityFilter == e ? "selected" : null)">@e</option>
                }
            </select>
        </div>

        <button type="submit" class="btn-admin btn-admin-secondary" style="padding: 8px 16px;">Filter</button>
        <a href="/centralwks/audit-log" class="btn-admin btn-admin-secondary" style="padding: 8px 14px;">Reset</a>
    </form>
</div>

@* ── Audit Logs Table ── *@
<div class="admin-card" style="padding: 0; overflow: hidden; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg);">
    <div style="overflow-x: auto;">
        <table class="admin-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                    <th style="padding: 14px 16px; width: 50px; text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-dim);">S/N</th>
                    <th style="padding: 14px 20px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-dim);">Timestamp (UTC)</th>
                    <th style="padding: 14px 14px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-dim);">Operator &amp; Source</th>
                    <th style="padding: 14px 14px; text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-dim);">Action</th>
                    <th style="padding: 14px 14px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-dim);">Entity</th>
                    <th style="padding: 14px 14px; text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-dim);">Event Summary</th>
                    <th style="padding: 14px 20px; text-align: right; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--admin-text-dim);">Inspector</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.AuditLogs.Any())
                {
                    <tr>
                        <td colspan="7" style="padding: 40px; text-align: center; color: var(--admin-text-muted);">
                            No security audit log entries match your active filter criteria.
                        </td>
                    </tr>
                }
                @for (int i = 0; i < Model.AuditLogs.Count; i++)
                {
                    var log = Model.AuditLogs[i];
                    <tr style="border-bottom: 1px solid var(--admin-border);">
                        <td style="padding: 14px 16px; text-align: center;">
                            <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600; font-size: 11.5px;">@(i + 1)</span>
                        </td>
                        <td style="padding: 14px 20px; white-space: nowrap; font-family: monospace; font-size: 12px; color: var(--admin-text);">
                            <div>@log.CreatedUtc.ToString("yyyy-MM-dd")</div>
                            <div style="color: var(--admin-text-muted); font-size: 11px;">@log.CreatedUtc.ToString("HH:mm:ss") UTC</div>
                        </td>
                        <td style="padding: 14px 14px;">
                            <div style="font-weight: 600; color: var(--admin-text); font-size: 13px;">
                                @(string.IsNullOrEmpty(log.UserName) ? "System Automation" : log.UserName)
                            </div>
                            <div style="font-size: 11px; font-family: monospace; color: var(--admin-text-dim); margin-top: 2px;">
                                @(string.IsNullOrEmpty(log.IpAddress) ? "Internal / System" : log.IpAddress)
                            </div>
                        </td>
                        <td style="padding: 14px 14px; text-align: center;">
                            @switch (log.Action)
                            {
                                case "Create":
                                    <span class="badge badge-success">CREATE</span>
                                    break;
                                case "Update":
                                    <span class="badge badge-indigo">UPDATE</span>
                                    break;
                                case "Delete":
                                    <span class="badge badge-danger">DELETE</span>
                                    break;
                                case "Suspend":
                                    <span class="badge badge-warning">SUSPEND</span>
                                    break;
                                case "Login":
                                    <span class="badge" style="background: rgba(168, 85, 247, 0.15); color: #a855f7;">LOGIN</span>
                                    break;
                                default:
                                    <span class="badge badge-neutral">@log.Action.ToUpperInvariant()</span>
                                    break;
                            }
                        </td>
                        <td style="padding: 14px 14px;">
                            <span style="font-size: 12.5px; font-weight: 600; color: var(--admin-text);">@log.EntityType</span>
                            @if (!string.IsNullOrEmpty(log.EntityId))
                            {
                                <div style="font-size: 10.5px; font-family: monospace; color: var(--admin-text-dim); margin-top: 2px; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@log.EntityId">
                                    #@log.EntityId
                                </div>
                            }
                        </td>
                        <td style="padding: 14px 14px; font-size: 13px; color: var(--admin-text); max-width: 320px;">
                            @(log.Summary ?? "Administrative action executed.")
                        </td>
                        <td style="padding: 14px 20px; text-align: right; white-space: nowrap;">
                            <a href="/centralwks/audit-log/details/@log.Id" class="btn-admin btn-admin-secondary btn-admin-sm" style="display: inline-flex; align-items: center; gap: 4px;">
                                <span class="material-symbols-outlined" style="font-size: 14px;">visibility</span> Inspect
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
