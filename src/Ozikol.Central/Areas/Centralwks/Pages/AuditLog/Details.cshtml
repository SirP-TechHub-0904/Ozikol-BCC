@page "/centralwks/audit-log/details/{id:guid}"
@model Ozikol.Central.Areas.Centralwks.Pages.AuditLog.DetailsModel
@{
    ViewData["Title"] = "Audit Event: " + Model.AuditEntry.Action + " " + Model.AuditEntry.EntityType;
    ViewData["BreadcrumbSection"] = "Security";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="/centralwks/audit-log" style="color: var(--admin-text-muted); text-decoration: none; font-size: 13px;">← Back to Audit Trail</a>
            <span style="color: var(--admin-text-muted); font-size: 12px;">•</span>
            <span style="font-family: monospace; font-size: 11px; color: #94a3b8;">
                #@Model.AuditEntry.Id
            </span>
            <span style="background: rgba(59, 130, 246, 0.15); color: #93c5fd; padding: 2px 8px; border-radius: 9999px; font-size: 11px; font-weight: 600;">
                @Model.AuditEntry.Action
            </span>
            <span style="background: rgba(255, 255, 255, 0.05); color: #cbd5e1; padding: 2px 8px; border-radius: 9999px; font-size: 11px;">
                @Model.AuditEntry.EntityType
            </span>
        </div>
        <h1 class="admin-title">@(Model.AuditEntry.Summary ?? $"{Model.AuditEntry.Action} {Model.AuditEntry.EntityType}")</h1>
        <p class="admin-subtitle">Recorded on @Model.AuditEntry.CreatedUtc.ToString("dd MMMM yyyy, HH:mm:ss") UTC by @(string.IsNullOrEmpty(Model.AuditEntry.UserName) ? "System Automation" : Model.AuditEntry.UserName)</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
    @* Left Column: Event Summary & JSON Diff Viewer *@
    <div>
        @* Event Summary Card *@
        <div class="admin-card" style="padding: 24px; margin-bottom: 24px;">
            <h2 style="font-size: 16px; font-weight: 600; color: var(--admin-text); margin-bottom: 16px;">Operation Overview</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                <div>
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Operation Verb</div>
                    <div style="font-size: 14px; font-weight: 600; color: #93c5fd; margin-top: 2px;">
                        @Model.AuditEntry.Action
                    </div>
                </div>

                <div>
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Target Entity Class</div>
                    <div style="font-size: 14px; font-weight: 500; color: var(--admin-text); margin-top: 2px;">
                        @Model.AuditEntry.EntityType
                    </div>
                </div>

                <div style="grid-column: span 2;">
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Target Record Identifier (EntityId)</div>
                    <div style="font-size: 13px; font-family: monospace; color: #cbd5e1; margin-top: 2px; word-break: break-all;">
                        @(Model.AuditEntry.EntityId ?? "N/A (Global / Aggregate)")
                    </div>
                </div>

                <div style="grid-column: span 2;">
                    <div style="font-size: 11px; color: var(--admin-text-muted);">Human Description</div>
                    <div style="font-size: 14px; color: var(--admin-text); margin-top: 2px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--admin-card-border); padding: 12px; border-radius: 6px;">
                        @(Model.AuditEntry.Summary ?? "No summary provided.")
                    </div>
                </div>
            </div>
        </div>

        @* State Snapshot Diffs *@
        <div class="admin-card" style="padding: 24px;">
            <h2 style="font-size: 16px; font-weight: 600; color: var(--admin-text); margin-bottom: 16px;">Cryptographic State Snapshots (Diff)</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                @* Old State *@
                <div>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                        <span style="font-size: 12px; font-weight: 600; color: #f87171;">Previous State (Before)</span>
                        <span style="font-size: 10px; color: var(--admin-text-muted);">JSON</span>
                    </div>
                    @if (string.IsNullOrWhiteSpace(Model.AuditEntry.OldValues))
                    {
                        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 20px; text-align: center; color: var(--admin-text-muted); font-size: 12px;">
                            (No pre-existing state recorded — newly created entity)
                        </div>
                    }
                    else
                    {
                        <pre style="background: rgba(15, 23, 42, 0.8); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 14px; color: #fca5a5; font-family: monospace; font-size: 12px; line-height: 1.5; max-height: 400px; overflow: auto; margin: 0;">@Model.AuditEntry.OldValues</pre>
                    }
                </div>

                @* New State *@
                <div>
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                        <span style="font-size: 12px; font-weight: 600; color: #34d399;">Updated State (After)</span>
                        <span style="font-size: 10px; color: var(--admin-text-muted);">JSON</span>
                    </div>
                    @if (string.IsNullOrWhiteSpace(Model.AuditEntry.NewValues))
                    {
                        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 20px; text-align: center; color: var(--admin-text-muted); font-size: 12px;">
                            (No post-operation state recorded — deleted entity)
                        </div>
                    }
                    else
                    {
                        <pre style="background: rgba(15, 23, 42, 0.8); border: 1px solid var(--admin-card-border); border-radius: 8px; padding: 14px; color: #86efac; font-family: monospace; font-size: 12px; line-height: 1.5; max-height: 400px; overflow: auto; margin: 0;">@Model.AuditEntry.NewValues</pre>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Right Column: Telemetry & Caller Identification *@
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <div class="admin-card" style="padding: 20px;">
            <h3 style="font-size: 14px; font-weight: 600; color: var(--admin-text); margin-bottom: 16px;">Caller Telemetry &amp; Provenance</h3>
            
            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Operator Username</div>
                <div style="font-size: 13px; font-weight: 600; color: var(--admin-text); margin-top: 2px;">
                    @(string.IsNullOrEmpty(Model.AuditEntry.UserName) ? "System Automation Engine" : Model.AuditEntry.UserName)
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Identity User ID</div>
                <div style="font-size: 12px; font-family: monospace; color: #93c5fd; margin-top: 2px; word-break: break-all;">
                    @(Model.AuditEntry.UserId ?? "SYSTEM_INTERNAL")
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">Client IP Address</div>
                <div style="font-size: 13px; font-family: monospace; color: var(--admin-text); margin-top: 2px;">
                    @(string.IsNullOrEmpty(Model.AuditEntry.IpAddress) ? "127.0.0.1 / Loopback" : Model.AuditEntry.IpAddress)
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <div style="font-size: 11px; color: var(--admin-text-muted);">User-Agent Signature</div>
                <div style="font-size: 11px; color: #94a3b8; margin-top: 2px; line-height: 1.4; word-break: break-all; background: rgba(255, 255, 255, 0.02); padding: 8px; border-radius: 4px; border: 1px solid var(--admin-card-border);">
                    @(string.IsNullOrEmpty(Model.AuditEntry.UserAgent) ? "Internal CLR Process" : Model.AuditEntry.UserAgent)
                </div>
            </div>

            <div>
                <div style="font-size: 11px; color: var(--admin-text-muted);">Audit Record Immutability</div>
                <div style="font-size: 12px; color: #34d399; margin-top: 2px;">
                    ✓ Signed &amp; cryptographically persisted
                </div>
            </div>
        </div>
    </div>
</div>
