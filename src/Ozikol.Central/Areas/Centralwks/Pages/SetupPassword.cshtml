@page
@model Ozikol.Central.Areas.Centralwks.Pages.SetupPasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Activate Operator Account";
    ViewData["CardTitle"] = "Activate Operator Account";
    ViewData["CardSubtitle"] = "Establish your secret password to complete your Central onboarding.";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-box alert-danger" role="alert">
        <span style="display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 16px;">error</span>
            @Model.ErrorMessage
        </span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.OperatorUserName))
{
    <div class="operator-badge">
        <div class="operator-avatar">
            @(Model.OperatorName.Length > 0 ? Model.OperatorName[0].ToString().ToUpperInvariant() : "O")
        </div>
        <div style="min-width: 0; flex: 1;">
            <div style="font-weight: 700; font-size: 13.5px; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                @Model.OperatorName
            </div>
            <div style="font-size: 12px; color: #64748b; display: flex; align-items: center; gap: 6px;">
                <span>@@@Model.OperatorUserName</span>
                <span>&bull;</span>
                <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@Model.OperatorEmail</span>
            </div>
        </div>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Token" />

        <div class="form-group">
            <label asp-for="Input.Password" class="form-label">Create Secret Password <span class="required">*</span></label>
            <div class="password-input-wrap">
                <input asp-for="Input.Password" id="passwordInput" type="password" class="form-control" placeholder="Minimum 8 characters" autocomplete="new-password" required />
                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('passwordInput', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                    <span class="material-symbols-outlined" style="font-size: 20px;">visibility</span>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="field-validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password <span class="required">*</span></label>
            <div class="password-input-wrap">
                <input asp-for="Input.ConfirmPassword" id="confirmPasswordInput" type="password" class="form-control" placeholder="Re-enter secret password" autocomplete="new-password" required />
                <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility('confirmPasswordInput', this)" title="Show/Hide Password" aria-label="Toggle password visibility">
                    <span class="material-symbols-outlined" style="font-size: 20px;">visibility</span>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
        </div>

        <button type="submit" class="btn-submit">
            <span>Activate Account &amp; Complete Onboarding</span>
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
        </button>
    </form>
}
else
{
    <div style="text-align: center; margin-top: 16px;">
        <a href="/centralwks/login" class="forgot-link">
            &larr; Return to Sign In
        </a>
    </div>
}

@section Scripts {
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (!input || !icon) return;
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
                btn.style.color = 'var(--auth-primary)';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
                btn.style.color = '#94a3b8';
            }
        }
    </script>
}
