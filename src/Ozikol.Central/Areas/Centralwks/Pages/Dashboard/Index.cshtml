@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Chart Payload safely parsed from Server-side Model
            let rawData = null;
            try {
                rawData = JSON.parse('@Html.Raw(Model.ChartPayloadJson)');
            } catch (err) {
                console.error("Failed to parse chart payload JSON:", err);
                rawData = {
                    weekly: { labels: [], totalRevenue: [], paidRevenue: [], freeTrialValue: [], couponValue: [], activeSubscriptions: [] },
                    monthly: { labels: [], totalRevenue: [], paidRevenue: [], freeTrialValue: [], couponValue: [], activeSubscriptions: [] },
                    quarterly: { labels: [], totalRevenue: [], paidRevenue: [], freeTrialValue: [], couponValue: [], activeSubscriptions: [] },
                    yearly: { labels: [], totalRevenue: [], paidRevenue: [], freeTrialValue: [], couponValue: [], activeSubscriptions: [] },
                    forecast: { labels: [], totalRevenue: [], paidRevenue: [], freeTrialValue: [], couponValue: [], activeSubscriptions: [] },
                    donutLabels: [],
                    donutData: [],
                    histogramLabels: [],
                    histogramRevenue: [],
                    histogramAccounts: []
                };
            }

            // High contrast colors
            const themeColors = {
                primary: '#2563eb',
                primaryLight: 'rgba(37, 99, 235, 0.14)',
                success: '#10b981',
                successLight: 'rgba(16, 185, 129, 0.14)',
                indigo: '#4f46e5',
                indigoLight: 'rgba(79, 70, 229, 0.14)',
                amber: '#d97706',
                amberLight: 'rgba(217, 119, 6, 0.14)',
                purple: '#7c3aed',
                purpleLight: 'rgba(124, 58, 237, 0.14)',
                emerald: '#059669',
                emeraldLight: 'rgba(5, 150, 105, 0.14)',
                rose: '#e11d48',
                gridLine: 'rgba(148, 163, 184, 0.18)',
                textColor: '#334155',
                darkText: '#0f172a'
            };

            let currentPeriod = 'monthly';
            let currentChannel = 'all';

            // Chart instances
            let trendChart = null;
            let histogramChart = null;
            let donutChart = null;

            const initialData = rawData.monthly || { labels: [], totalRevenue: [], activeSubscriptions: [] };

            // 1. Initialize Line / Area Trend Chart (with Click Handler)
            const trendCtx = document.getElementById('revenueTrendChart')?.getContext('2d');
            if (trendCtx) {
                trendChart = new Chart(trendCtx, {
                    type: 'line',
                    data: {
                        labels: initialData.labels || [],
                        datasets: [
                            {
                                label: 'Revenue ($)',
                                data: initialData.totalRevenue || [],
                                borderColor: themeColors.primary,
                                backgroundColor: themeColors.primaryLight,
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2.5,
                                pointBackgroundColor: themeColors.primary,
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Active Subscriptions',
                                data: initialData.activeSubscriptions || [],
                                borderColor: themeColors.success,
                                backgroundColor: 'transparent',
                                borderDash: [4, 4],
                                tension: 0.35,
                                borderWidth: 2,
                                pointBackgroundColor: themeColors.success,
                                pointRadius: 5,
                                pointHoverRadius: 8,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        onClick: function (event, elements) {
                            if (elements.length > 0) {
                                const index = elements[0].index;
                                const label = trendChart.data.labels[index];
                                openDrillDown('datepoint', label);
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleColor: '#f8fafc',
                                bodyColor: '#f8fafc',
                                padding: 12,
                                cornerRadius: 8,
                                callbacks: {
                                    label: function (ctx) {
                                        if (ctx.datasetIndex === 0) {
                                            return ' Revenue: $' + Number(ctx.parsed.y).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                                        }
                                        return ' Subscriptions: ' + Number(ctx.parsed.y).toLocaleString();
                                    },
                                    afterBody: function () {
                                        return '➜ Click to inspect transactions';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { color: themeColors.gridLine },
                                ticks: { color: themeColors.textColor, font: { weight: '600', size: 11 } }
                            },
                            y: {
                                type: 'linear',
                                display: true,
                                position: 'left',
                                grid: { color: themeColors.gridLine },
                                ticks: {
                                    color: themeColors.textColor,
                                    font: { size: 11 },
                                    callback: val => '$' + Number(val).toLocaleString()
                                }
                            },
                            y1: {
                                type: 'linear',
                                display: true,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                ticks: {
                                    color: themeColors.textColor,
                                    font: { size: 11 },
                                    callback: val => val + ' subs'
                                }
                            }
                        }
                    }
                });
            }

            // 2. Initialize Histogram / Bar Chart (with Click Handler)
            const histCtx = document.getElementById('channelHistogramChart')?.getContext('2d');
            if (histCtx) {
                histogramChart = new Chart(histCtx, {
                    type: 'bar',
                    data: {
                        labels: rawData.histogramLabels || ['Direct Paid', 'Free Trial', 'Coupons/Vouchers'],
                        datasets: [
                            {
                                label: 'Financial Value ($)',
                                data: rawData.histogramRevenue || [1000, 200, 150],
                                backgroundColor: [
                                    'rgba(37, 99, 235, 0.85)',
                                    'rgba(16, 185, 129, 0.85)',
                                    'rgba(217, 119, 6, 0.85)'
                                ],
                                borderColor: ['#2563eb', '#10b981', '#d97706'],
                                borderWidth: 1.5,
                                borderRadius: 6,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Accounts / Tenancy Count',
                                data: rawData.histogramAccounts || [10, 3, 2],
                                backgroundColor: 'rgba(79, 70, 229, 0.35)',
                                borderColor: '#4f46e5',
                                borderWidth: 1.5,
                                borderRadius: 6,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        onClick: function (event, elements) {
                            if (elements.length > 0) {
                                const index = elements[0].index;
                                if (index === 0) openDrillDown('channelpaid');
                                else if (index === 1) openDrillDown('trialtenants');
                                else if (index === 2) openDrillDown('coupons');
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { color: themeColors.textColor, font: { size: 11, weight: '600' } }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleColor: '#ffffff',
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    afterBody: function () {
                                        return '➜ Click to inspect records';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: themeColors.textColor, font: { weight: '600', size: 11 } }
                            },
                            y: {
                                position: 'left',
                                grid: { color: themeColors.gridLine },
                                ticks: {
                                    color: themeColors.textColor,
                                    font: { size: 10 },
                                    callback: val => '$' + Number(val).toLocaleString()
                                }
                            },
                            y1: {
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                ticks: {
                                    color: themeColors.textColor,
                                    font: { size: 10 },
                                    callback: val => val + ' accts'
                                }
                            }
                        }
                    }
                });
            }

            // 3. Initialize Donut / Pie Chart (with Click Handler)
            const donutCtx = document.getElementById('modularCapabilitiesPieChart')?.getContext('2d');
            if (donutCtx) {
                const donutColors = [
                    '#2563eb', '#7c3aed', '#10b981', '#d97706', '#06b6d4', '#e11d48'
                ];
                donutChart = new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: rawData.donutLabels || [],
                        datasets: [{
                            data: (rawData.donutData && rawData.donutData.length) ? rawData.donutData : [100],
                            backgroundColor: donutColors,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        onClick: function (event, elements) {
                            if (elements.length > 0) {
                                const index = elements[0].index;
                                const label = donutChart.data.labels[index];
                                if (label === 'Base Platform Tiers') {
                                    openDrillDown('activetenants');
                                } else {
                                    openDrillDown('feature', label);
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    color: themeColors.textColor,
                                    font: { size: 11, weight: '600' },
                                    boxWidth: 12,
                                    padding: 10
                                }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                titleColor: '#ffffff',
                                padding: 10,
                                cornerRadius: 8,
                                callbacks: {
                                    label: function (ctx) {
                                        return ` $${Number(ctx.parsed).toLocaleString(undefined, { minimumFractionDigits: 2 })} MRR Contribution`;
                                    },
                                    afterBody: function () {
                                        return '➜ Click to inspect subscribers';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Function to update Line Chart according to selected Period and Channel filter
            function updateTrendChart() {
                if (!trendChart) return;

                const dataset = rawData[currentPeriod] || rawData.monthly;
                const titleElem = document.getElementById('trendChartTitle');
                const subtitleElem = document.getElementById('trendChartSubtitle');

                let revData = dataset.totalRevenue || [];
                let subData = dataset.activeSubscriptions || [];
                let channelText = 'All Active Billing Channels';

                if (currentChannel === 'paid') {
                    revData = dataset.paidRevenue || dataset.totalRevenue.map(v => v * 0.8);
                    subData = dataset.activeSubscriptions.map(v => Math.max(1, Math.round(v * 0.75)));
                    channelText = 'Paid Subscriptions (Direct Revenue)';
                } else if (currentChannel === 'free') {
                    revData = dataset.freeTrialValue || dataset.totalRevenue.map(v => v * 0.12);
                    subData = dataset.activeSubscriptions.map(v => Math.max(1, Math.round(v * 0.25)));
                    channelText = 'Free Tier & Trial Accounts';
                } else if (currentChannel === 'coupons') {
                    revData = dataset.couponValue || dataset.totalRevenue.map(v => v * 0.08);
                    subData = dataset.activeSubscriptions.map(v => Math.max(1, Math.round(v * 0.15)));
                    channelText = 'Coupons & Vouchers Applied';
                }

                // Period Titles
                const periodLabels = {
                    weekly: '7-Day Granular Telemetry',
                    monthly: '12-Month Performance Trajectory',
                    quarterly: '4-Quarter Historical Summary',
                    yearly: '5-Year Macro Growth',
                    forecast: '12-Month Forward Forecast Projections',
                    custom: 'Custom Date Range Telemetry'
                };

                if (titleElem) {
                    titleElem.textContent = (currentPeriod === 'forecast' ? 'Forward Forecast Projections' : (currentPeriod === 'custom' ? 'Custom Date Range Telemetry' : 'Revenue & Subscription Trajectory'));
                }
                if (subtitleElem) {
                    subtitleElem.textContent = `Showing ${periodLabels[currentPeriod] || 'Selected View'} for [${channelText}] (Click any point to drill down)`;
                }

                trendChart.data.labels = dataset.labels;
                trendChart.data.datasets[0].data = revData;
                trendChart.data.datasets[1].data = subData;

                if (currentPeriod === 'forecast') {
                    trendChart.data.datasets[0].borderColor = themeColors.purple;
                    trendChart.data.datasets[0].backgroundColor = themeColors.purpleLight;
                    trendChart.data.datasets[0].borderDash = [5, 5];
                } else if (currentPeriod === 'custom') {
                    trendChart.data.datasets[0].borderColor = themeColors.emerald;
                    trendChart.data.datasets[0].backgroundColor = themeColors.emeraldLight;
                    trendChart.data.datasets[0].borderDash = [];
                } else {
                    trendChart.data.datasets[0].borderColor = themeColors.primary;
                    trendChart.data.datasets[0].backgroundColor = themeColors.primaryLight;
                    trendChart.data.datasets[0].borderDash = [];
                }

                trendChart.update();
            }

            // Period Button Click Handlers
            document.querySelectorAll('.period-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const period = this.getAttribute('data-period');
                    document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const customDrawer = document.getElementById('customDateRangeDrawer');
                    if (period === 'custom') {
                        if (customDrawer) {
                            customDrawer.style.display = 'flex';
                        }
                        currentPeriod = 'custom';
                        if (!rawData.custom) {
                            fetchCustomRange();
                        } else {
                            updateTrendChart();
                        }
                    } else {
                        if (customDrawer) {
                            customDrawer.style.display = 'none';
                        }
                        currentPeriod = period;
                        updateTrendChart();
                    }
                });
            });

            // Channel Filter Pill Handlers
            document.querySelectorAll('.channel-pill').forEach(pill => {
                pill.addEventListener('click', function () {
                    document.querySelectorAll('.channel-pill').forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    currentChannel = this.getAttribute('data-channel');
                    updateTrendChart();
                });
            });

            // Custom Range Initializer
            const todayStr = new Date().toISOString().split('T')[0];
            const d30Ago = new Date();
            d30Ago.setDate(d30Ago.getDate() - 30);
            const d30AgoStr = d30Ago.toISOString().split('T')[0];

            const startInput = document.getElementById('customStartDate');
            const endInput = document.getElementById('customEndDate');
            if (startInput) startInput.value = d30AgoStr;
            if (endInput) endInput.value = todayStr;

            const applyBtn = document.getElementById('applyCustomDateBtn');
            if (applyBtn) {
                applyBtn.addEventListener('click', function () {
                    fetchCustomRange();
                });
            }

            function fetchCustomRange() {
                const sDate = startInput ? startInput.value : '';
                const eDate = endInput ? endInput.value : '';
                const statusElem = document.getElementById('customRangeStatus');
                if (statusElem) statusElem.textContent = 'Querying database transactions...';

                fetch(`/centralwks?handler=CustomRange&startDate=${encodeURIComponent(sDate)}&endDate=${encodeURIComponent(eDate)}`)
                    .then(res => res.json())
                    .then(data => {
                        rawData.custom = data;
                        if (statusElem) statusElem.textContent = `Loaded ${data.labels.length} intervals from database.`;
                        updateTrendChart();
                    })
                    .catch(err => {
                        console.error("Failed to query custom range:", err);
                        if (statusElem) statusElem.textContent = 'Error querying date range.';
                    });
            }

            // ── Live Telemetry Drill-Down System ──
            const modal = document.getElementById('drillDownModal');
            const titleElem = document.getElementById('drillModalTitle');
            const subElem = document.getElementById('drillModalSubtitle');
            const countBadge = document.getElementById('drillModalCountBadge');
            const summaryElem = document.getElementById('drillModalSummary');
            const tableBody = document.getElementById('drillModalTableBody');
            const searchInput = document.getElementById('drillModalSearch');
            let currentDrillItems = [];

            // Card & Sub-badge click listeners
            document.querySelectorAll('.clickable-stat-card').forEach(card => {
                card.addEventListener('click', function (e) {
                    if (e.target.closest('.badge-sub-click')) return; // handled by sub-badge
                    const drillType = this.getAttribute('data-drill');
                    openDrillDown(drillType);
                });
            });

            document.querySelectorAll('.badge-sub-click').forEach(badge => {
                badge.addEventListener('click', function (e) {
                    e.stopPropagation();
                    const drillType = this.getAttribute('data-drill');
                    openDrillDown(drillType);
                });
            });

            document.querySelectorAll('.feature-leaderboard-row').forEach(row => {
                row.addEventListener('click', function () {
                    const featureKey = this.getAttribute('data-key');
                    openDrillDown('feature', featureKey);
                });
            });

            // Open Drill Down Function
            window.openDrillDown = function (drillType, key = '') {
                if (!modal) return;
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';

                if (tableBody) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: var(--admin-text-muted, #64748b);">
                                <span class="material-symbols-outlined" style="font-size: 28px; animation: spin 1s linear infinite; display: inline-block; vertical-align: middle;">sync</span>
                                <div style="margin-top: 8px; font-weight: 600;">Querying live database records...</div>
                            </td>
                        </tr>`;
                }

                fetch(`/centralwks?handler=DrillDown&drillType=${encodeURIComponent(drillType)}&key=${encodeURIComponent(key)}`)
                    .then(res => res.json())
                    .then(data => {
                        if (titleElem) titleElem.textContent = data.title || 'Telemetry Records';
                        if (subElem) subElem.textContent = data.subtitle || 'Database records';
                        if (countBadge) countBadge.textContent = `${data.totalCount || 0} records`;
                        if (summaryElem) summaryElem.textContent = data.totalSummary || '';

                        currentDrillItems = data.items || [];
                        renderDrillTable(currentDrillItems);
                    })
                    .catch(err => {
                        console.error("Failed to load drill-down data:", err);
                        if (tableBody) {
                            tableBody.innerHTML = `
                                <tr>
                                    <td colspan="7" style="text-align: center; padding: 36px; color: #dc2626; font-weight: 600;">
                                        Failed to load records from database. Please try again.
                                    </td>
                                </tr>`;
                        }
                    });
            };

            function renderDrillTable(items) {
                if (!tableBody) return;
                if (!items || items.length === 0) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 36px; color: var(--admin-text-muted, #64748b);">
                                No records found matching this criteria.
                            </td>
                        </tr>`;
                    return;
                }

                let html = '';
                items.forEach((item, idx) => {
                    const statusBadgeClass = item.status === 'Active' || item.status === 'Completed' || item.status === 'Paid'
                        ? 'background: rgba(5,150,105,0.12); color:#059669;'
                        : (item.status === 'Suspended' ? 'background: rgba(220,38,38,0.12); color:#dc2626;' : 'background: var(--admin-bg-surface-elevated,#f1f5f9); color: var(--admin-text-muted,#64748b);');

                    html += `
                        <tr style="border-bottom: 1px solid var(--admin-border, #f1f5f9); transition: background 0.15s ease;">
                            <td style="padding: 10px 16px;">
                                <code style="background: var(--admin-bg-surface-elevated, #f1f5f9); padding: 2px 6px; border-radius: 4px; font-size: 11.5px; border: 1px solid var(--admin-border, #e2e8f0); color: var(--admin-text, #0f172a);">${escapeHtml(item.referenceKey)}</code>
                            </td>
                            <td style="padding: 10px 16px;">
                                <strong style="color: var(--admin-text, #0f172a);">${escapeHtml(item.title)}</strong>
                                ${item.subtitle ? `<div style="font-size: 11px; color: var(--admin-text-muted, #64748b);">${escapeHtml(item.subtitle)}</div>` : ''}
                            </td>
                            <td style="padding: 10px 16px; color: var(--admin-text-muted, #64748b);">
                                ${escapeHtml(item.category)}
                            </td>
                            <td style="padding: 10px 16px; font-weight: 700; color: #059669;">
                                ${escapeHtml(item.amountOrValue)}
                            </td>
                            <td style="padding: 10px 16px;">
                                <span class="badge" style="font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; ${statusBadgeClass}">
                                    ${escapeHtml(item.status)}
                                </span>
                            </td>
                            <td style="padding: 10px 16px; color: var(--admin-text-muted, #64748b); font-size: 11.5px;">
                                ${escapeHtml(item.dateOrTime)}
                            </td>
                            <td style="padding: 10px 16px; text-align: right;">
                                ${item.actionUrl ? `<a href="${item.actionUrl}" class="btn-admin btn-admin-secondary btn-admin-sm" style="font-size: 11.5px; padding: 3px 8px;">${escapeHtml(item.actionText || 'View')}</a>` : '—'}
                            </td>
                        </tr>`;
                });

                tableBody.innerHTML = html;
            }

            function escapeHtml(text) {
                if (!text) return '';
                return String(text)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            // Search filtering within modal
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    const q = this.value.toLowerCase().trim();
                    if (!q) {
                        renderDrillTable(currentDrillItems);
                        return;
                    }
                    const filtered = currentDrillItems.filter(item =>
                        (item.title && item.title.toLowerCase().includes(q)) ||
                        (item.referenceKey && item.referenceKey.toLowerCase().includes(q)) ||
                        (item.subtitle && item.subtitle.toLowerCase().includes(q)) ||
                        (item.category && item.category.toLowerCase().includes(q))
                    );
                    renderDrillTable(filtered);
                });
            }

            // Close Modal Handlers
            function closeModal() {
                if (modal) modal.style.display = 'none';
                document.body.style.overflow = '';
                if (searchInput) searchInput.value = '';
            }

            document.getElementById('closeDrillModalBtn')?.addEventListener('click', closeModal);
            document.getElementById('closeDrillModalFooterBtn')?.addEventListener('click', closeModal);

            if (modal) {
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) closeModal();
                });
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
                    closeModal();
                }
            });
        });
    </script>
}
