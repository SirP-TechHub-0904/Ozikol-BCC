@page
@model Ozikol.Central.Areas.Centralwks.Pages.Subscriptions.DetailsModel
@{
    ViewData["Title"] = $"{Model.Tenant.OrganizationName} — Subscription Posture";
    ViewData["BreadcrumbSection"] = "Platform Core";
}

<!-- Page Header -->
<div class="admin-page-header" style="margin-bottom: 24px;">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
            <a href="/centralwks/subscriptions" class="btn-admin btn-admin-secondary" style="padding: 6px 12px; height: 32px; display: inline-flex; align-items: center; gap: 4px; font-size: 12px;">
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
                Back to Subscriptions
            </a>
            <span style="color: var(--admin-text-dim);">/</span>
            <span style="font-size: 13px; color: var(--admin-text-muted); font-weight: 500;">Tenant Subscription Posture</span>
        </div>
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <h1 class="admin-title" style="margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -0.03em;">
                @Model.Tenant.OrganizationName
            </h1>
            <code style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); padding: 3px 8px; border-radius: var(--radius-sm); font-size: 12px; font-weight: 600; color: var(--admin-primary);">
                @Model.Tenant.TenantKey
            </code>
            @if (Model.Tenant.IsSuspended)
            {
                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: var(--admin-danger); font-size: 12px; padding: 4px 10px;">
                    <span class="material-symbols-outlined" style="font-size: 14px;">block</span>
                    Tenant Suspended
                </span>
            }
            else
            {
                <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success); font-size: 12px; padding: 4px 10px;">
                    <span class="material-symbols-outlined" style="font-size: 14px;">check_circle</span>
                    Operational Active
                </span>
            }
        </div>
        <div style="display: flex; align-items: center; gap: 14px; margin-top: 6px; font-size: 13px; color: var(--admin-text-muted); flex-wrap: wrap;">
            <span style="display: inline-flex; align-items: center; gap: 4px;">
                <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-text-dim);">language</span>
                <strong>Domain:</strong> @Model.Tenant.PrimaryDomain
            </span>
            <span>•</span>
            <span style="display: inline-flex; align-items: center; gap: 4px;">
                <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-text-dim);">mail</span>
                <strong>Admin Email:</strong> @(string.IsNullOrWhiteSpace(Model.Tenant.AdminEmail) ? "Not configured" : Model.Tenant.AdminEmail)
            </span>
            <span>•</span>
            <span style="display: inline-flex; align-items: center; gap: 4px;">
                <span class="material-symbols-outlined" style="font-size: 16px; color: var(--admin-text-dim);">database</span>
                <strong>DB:</strong> <code>@Model.Tenant.DatabaseName</code>
            </span>
        </div>
    </div>

    <div class="admin-actions" style="display: flex; gap: 10px; flex-wrap: wrap;">
        @if (!string.IsNullOrWhiteSpace(Model.Tenant.AdminEmail) && Model.ActiveFeaturesCount > 0)
        {
            <form method="post" asp-page-handler="SendRenewalNotice" asp-route-tenantId="@Model.Tenant.Id" style="display: inline; margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-admin btn-admin-secondary" style="display: inline-flex; align-items: center; gap: 6px;" onclick="return confirm('Send renewal reminder email to @Model.Tenant.AdminEmail?');">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-indigo);">send</span>
                    Send Renewal Notice
                </button>
            </form>
        }
        <a href="/centralwks/billing/create?tenantId=@Model.Tenant.Id" class="btn-admin btn-admin-secondary" style="display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 18px;">receipt</span>
            Record Invoice
        </a>
        <a href="/centralwks/tenants/features?tenantId=@Model.Tenant.Id" class="btn-admin btn-admin-primary" style="display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 18px;">tune</span>
            Configure Tenant Features
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.25); color: var(--admin-success); border-radius: var(--radius-md); padding: 12px 18px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <span class="material-symbols-outlined" style="font-size: 20px;">check_circle</span>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.25); color: var(--admin-danger); border-radius: var(--radius-md); padding: 12px 18px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <span class="material-symbols-outlined" style="font-size: 20px;">error</span>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- Key Metric Posture Cards -->
<div class="metrics-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <!-- Metric 1: Next Billing Amount -->
    <div class="admin-card" style="margin: 0; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; border-left: 4px solid var(--admin-success);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-dim); letter-spacing: 0.05em;">
                    Next Billing Amount
                </div>
                <div style="font-size: 28px; font-weight: 800; color: var(--admin-text); margin-top: 6px; letter-spacing: -0.03em;">
                    $@Model.TotalMonthlyRate.ToString("N2")
                </div>
            </div>
            <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(16, 185, 129, 0.12); display: flex; align-items: center; justify-content: center; color: var(--admin-success);">
                <span class="material-symbols-outlined" style="font-size: 22px;">payments</span>
            </div>
        </div>
        <div style="margin-top: 14px; font-size: 12px; color: var(--admin-text-muted); display: flex; align-items: center; gap: 6px;">
            <span class="badge" style="background: rgba(16, 185, 129, 0.1); color: var(--admin-success); font-size: 11px; padding: 2px 6px;">
                @Model.PaidFeaturesCount Paid Modular @(Model.PaidFeaturesCount == 1 ? "Add-on" : "Add-ons")
            </span>
            <span>•</span>
            <span>@Model.ActiveFeaturesCount total active</span>
        </div>
    </div>

    <!-- Metric 2: Earliest Next Billing Date -->
    <div class="admin-card" style="margin: 0; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; border-left: 4px solid var(--admin-primary);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-dim); letter-spacing: 0.05em;">
                    Earliest Next Billing Date
                </div>
                <div style="font-size: 22px; font-weight: 800; color: var(--admin-text); margin-top: 6px; letter-spacing: -0.02em;">
                    @(Model.NextBillingDateUtc.HasValue ? Model.NextBillingDateUtc.Value.ToString("MMMM dd, yyyy") : "Perpetual Platform")
                </div>
            </div>
            <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(99, 102, 241, 0.12); display: flex; align-items: center; justify-content: center; color: var(--admin-primary);">
                <span class="material-symbols-outlined" style="font-size: 22px;">event_repeat</span>
            </div>
        </div>
        <div style="margin-top: 14px; font-size: 12px;">
            @if (Model.NextBillingDateUtc.HasValue)
            {
                @if (Model.DaysRemaining < 0)
                {
                    <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: var(--admin-danger); font-size: 11.5px; font-weight: 700; padding: 3px 8px;">
                        <span class="material-symbols-outlined" style="font-size: 14px;">error</span>
                        Overdue by @Math.Abs(Model.DaysRemaining) days
                    </span>
                }
                else if (Model.DaysRemaining <= 30)
                {
                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: var(--admin-warning); font-size: 11.5px; font-weight: 700; padding: 3px 8px;">
                        <span class="material-symbols-outlined" style="font-size: 14px;">schedule</span>
                        @Model.DaysRemaining days remaining
                    </span>
                }
                else
                {
                    <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success); font-size: 11.5px; font-weight: 600; padding: 3px 8px;">
                        <span class="material-symbols-outlined" style="font-size: 14px;">verified</span>
                        @Model.DaysRemaining days remaining
                    </span>
                }
            }
            else
            {
                <span style="color: var(--admin-text-dim);">No recurring renewal cycle pending</span>
            }
        </div>
    </div>

    <!-- Metric 3: Feature Expiration Posture -->
    <div class="admin-card" style="margin: 0; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; border-left: 4px solid var(--admin-warning);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-dim); letter-spacing: 0.05em;">
                    Feature Expiration Posture
                </div>
                <div style="font-size: 28px; font-weight: 800; color: var(--admin-text); margin-top: 6px; letter-spacing: -0.03em;">
                    @Model.ActiveFeaturesCount <span style="font-size: 16px; font-weight: 500; color: var(--admin-text-dim);">/ @Model.TotalFeaturesCount Features</span>
                </div>
            </div>
            <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(245, 158, 11, 0.12); display: flex; align-items: center; justify-content: center; color: var(--admin-warning);">
                <span class="material-symbols-outlined" style="font-size: 22px;">hourglass_top</span>
            </div>
        </div>
        <div style="margin-top: 14px; display: flex; gap: 6px; flex-wrap: wrap;">
            @if (Model.OverdueFeaturesCount > 0)
            {
                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: var(--admin-danger); font-size: 11px; padding: 2px 6px;">
                    @Model.OverdueFeaturesCount Overdue
                </span>
            }
            <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: var(--admin-warning); font-size: 11px; padding: 2px 6px;">
                @Model.Expiring30DaysCount in ≤30d
            </span>
            <span class="badge" style="background: rgba(59, 130, 246, 0.12); color: #3b82f6; font-size: 11px; padding: 2px 6px;">
                @Model.Expiring60DaysCount in 31–60d
            </span>
            <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success); font-size: 11px; padding: 2px 6px;">
                @Model.Beyond60DaysCount >60d / Core
            </span>
        </div>
    </div>

    <!-- Metric 4: Renewal Notification Telemetry -->
    <div class="admin-card" style="margin: 0; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; border-left: 4px solid var(--admin-indigo);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-dim); letter-spacing: 0.05em;">
                    Renewal Notification Status
                </div>
                <div style="font-size: 20px; font-weight: 700; color: var(--admin-text); margin-top: 6px;">
                    @if (Model.NotificationCount > 0)
                    {
                        <span style="color: var(--admin-indigo);">@Model.NotificationStatus</span>
                    }
                    else
                    {
                        <span style="color: var(--admin-text-muted);">Not Sent</span>
                    }
                </div>
            </div>
            <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(99, 102, 241, 0.12); display: flex; align-items: center; justify-content: center; color: var(--admin-indigo);">
                <span class="material-symbols-outlined" style="font-size: 22px;">mark_email_read</span>
            </div>
        </div>
        <div style="margin-top: 14px; font-size: 12px; color: var(--admin-text-dim);">
            Target: <strong>@(string.IsNullOrWhiteSpace(Model.Tenant.AdminEmail) ? "No admin email" : Model.Tenant.AdminEmail)</strong>
        </div>
    </div>
</div>

<!-- Subscribed Modular Capabilities Section -->
<div class="admin-card" style="margin-bottom: 24px;">
    <div class="admin-card-header" style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div>
            <h2 class="admin-card-title" style="margin: 0; font-size: 16px; display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-outlined" style="font-size: 20px; color: var(--admin-primary);">widgets</span>
                Subscribed Modular Capabilities &amp; Feature Rates
            </h2>
            <p style="margin: 2px 0 0; font-size: 12px; color: var(--admin-text-muted);">
                Granular line-item breakdown of contracted platform features, custom pricing overrides, and independent renewal lifecycles.
            </p>
        </div>
        <div style="display: flex; align-items: center; gap: 8px;">
            <!-- Bulk Test Renewal Days Trigger -->
            <div style="position: relative; display: inline-block;">
                <button type="button" class="btn-admin btn-admin-secondary btn-admin-sm" style="border-color: rgba(245, 158, 11, 0.4); color: var(--admin-warning);" onclick="var m = document.getElementById('bulk-test-menu'); m.style.display = m.style.display === 'block' ? 'none' : 'block';">
                    <span class="material-symbols-outlined" style="font-size: 16px;">bolt</span>
                    Test Renewal Days
                    <span class="material-symbols-outlined" style="font-size: 14px;">arrow_drop_down</span>
                </button>
                <div id="bulk-test-menu" style="display: none; position: absolute; right: 0; top: 100%; margin-top: 4px; z-index: 1000; min-width: 240px; background: var(--admin-bg-surface-elevated, #ffffff); border: 1px solid var(--admin-border); border-radius: 8px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2); padding: 8px 0;">
                    <div style="padding: 6px 14px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--admin-text-dim); border-bottom: 1px solid var(--admin-border); margin-bottom: 4px;">Set All Features Expiry</div>
                    <form method="post" asp-page-handler="SetAllFeaturesExpiryDays" asp-route-tenantId="@Model.Tenant.Id" asp-route-days="2" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="width: 100%; text-align: left; padding: 8px 14px; font-size: 12.5px; background: none; border: none; cursor: pointer; color: var(--admin-warning); font-weight: 700; display: flex; align-items: center; gap: 8px;" onclick="return confirm('Bulk set ALL feature subscriptions to expire in 2 days for renewal testing?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">bolt</span>
                            <span>All Features to 2 Days</span>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="SetAllFeaturesExpiryDays" asp-route-tenantId="@Model.Tenant.Id" asp-route-days="30" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="width: 100%; text-align: left; padding: 8px 14px; font-size: 12.5px; background: none; border: none; cursor: pointer; color: var(--admin-text); display: flex; align-items: center; gap: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">calendar_month</span>
                            <span>Reset All to 30 Days (Monthly)</span>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="SetAllFeaturesExpiryDays" asp-route-tenantId="@Model.Tenant.Id" asp-route-days="365" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="width: 100%; text-align: left; padding: 8px 14px; font-size: 12.5px; background: none; border: none; cursor: pointer; color: var(--admin-text); display: flex; align-items: center; gap: 8px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">event_repeat</span>
                            <span>Reset All to 365 Days (Yearly)</span>
                        </button>
                    </form>
                    <form method="post" asp-page-handler="SetAllFeaturesExpiryDays" asp-route-tenantId="@Model.Tenant.Id" asp-route-days="-1" style="margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" style="width: 100%; text-align: left; padding: 8px 14px; font-size: 12.5px; background: none; border: none; cursor: pointer; color: var(--admin-danger); display: flex; align-items: center; gap: 8px;" onclick="return confirm('Simulate overdue/expired status for ALL features (-1 day)?');">
                            <span class="material-symbols-outlined" style="font-size: 16px;">warning</span>
                            ⚠️ Simulate All Expired (-1 Day)
                        </button>
                    </form>
                </div>
            </div>

            <a href="/centralwks/tenants/features?tenantId=@Model.Tenant.Id" class="btn-admin btn-admin-secondary btn-admin-sm">
                <span class="material-symbols-outlined" style="font-size: 16px;">add</span>
                Add / Manage Features
            </a>
        </div>
    </div>

    <!-- Feature Expiration & Status Filter Tabs -->
    <div style="border-bottom: 1px solid var(--admin-border); padding: 0 20px; display: flex; align-items: center; gap: 8px; overflow-x: auto; background: var(--admin-bg-surface-elevated);">
        <a href="?tenantId=@Model.Tenant.Id&featureSearch=@Model.FeatureSearch" class="nav-tab @(string.IsNullOrEmpty(Model.FeatureFilter) ? "active" : "")" style="padding: 12px 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none; color: @(string.IsNullOrEmpty(Model.FeatureFilter) ? "var(--admin-primary)" : "var(--admin-text-muted)"); border-bottom: 2px solid @(string.IsNullOrEmpty(Model.FeatureFilter) ? "var(--admin-primary)" : "transparent");">
            All Capabilities
            <span class="badge" style="background: var(--admin-bg-hover); font-size: 11px;">@Model.TotalFeaturesCount</span>
        </a>
        <a href="?tenantId=@Model.Tenant.Id&featureFilter=expiring_30d&featureSearch=@Model.FeatureSearch" class="nav-tab @(Model.FeatureFilter == "expiring_30d" ? "active" : "")" style="padding: 12px 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none; color: @(Model.FeatureFilter == "expiring_30d" ? "var(--admin-warning)" : "var(--admin-text-muted)"); border-bottom: 2px solid @(Model.FeatureFilter == "expiring_30d" ? "var(--admin-warning)" : "transparent");">
            Expiring in ≤30d
            @if (Model.Expiring30DaysCount > 0)
            {
                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: var(--admin-warning); font-size: 11px;">@Model.Expiring30DaysCount</span>
            }
        </a>
        <a href="?tenantId=@Model.Tenant.Id&featureFilter=expiring_60d&featureSearch=@Model.FeatureSearch" class="nav-tab @(Model.FeatureFilter == "expiring_60d" ? "active" : "")" style="padding: 12px 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none; color: @(Model.FeatureFilter == "expiring_60d" ? "#3b82f6" : "var(--admin-text-muted)"); border-bottom: 2px solid @(Model.FeatureFilter == "expiring_60d" ? "#3b82f6" : "transparent");">
            Expiring in 31–60d
            @if (Model.Expiring60DaysCount > 0)
            {
                <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-size: 11px;">@Model.Expiring60DaysCount</span>
            }
        </a>
        <a href="?tenantId=@Model.Tenant.Id&featureFilter=beyond_60d&featureSearch=@Model.FeatureSearch" class="nav-tab @(Model.FeatureFilter == "beyond_60d" ? "active" : "")" style="padding: 12px 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none; color: @(Model.FeatureFilter == "beyond_60d" ? "var(--admin-success)" : "var(--admin-text-muted)"); border-bottom: 2px solid @(Model.FeatureFilter == "beyond_60d" ? "var(--admin-success)" : "transparent");">
            >60d / Perpetual Core
            <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success); font-size: 11px;">@Model.Beyond60DaysCount</span>
        </a>
        <a href="?tenantId=@Model.Tenant.Id&featureFilter=paid_only&featureSearch=@Model.FeatureSearch" class="nav-tab @(Model.FeatureFilter == "paid_only" ? "active" : "")" style="padding: 12px 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none; color: @(Model.FeatureFilter == "paid_only" ? "var(--admin-primary)" : "var(--admin-text-muted)"); border-bottom: 2px solid @(Model.FeatureFilter == "paid_only" ? "var(--admin-primary)" : "transparent");">
            Paid Add-ons (@Model.PaidFeaturesCount)
        </a>
        @if (Model.SuspendedFeaturesCount > 0)
        {
            <a href="?tenantId=@Model.Tenant.Id&featureFilter=suspended&featureSearch=@Model.FeatureSearch" class="nav-tab @(Model.FeatureFilter == "suspended" ? "active" : "")" style="padding: 12px 14px; display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; text-decoration: none; color: @(Model.FeatureFilter == "suspended" ? "var(--admin-danger)" : "var(--admin-text-muted)"); border-bottom: 2px solid @(Model.FeatureFilter == "suspended" ? "var(--admin-danger)" : "transparent");">
                Suspended (@Model.SuspendedFeaturesCount)
            </a>
        }
    </div>

    <!-- Feature Search Bar -->
    <div style="padding: 14px 20px; border-bottom: 1px solid var(--admin-border);">
        <form method="get" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <input type="hidden" name="tenantId" value="@Model.Tenant.Id" />
            <input type="hidden" name="featureFilter" value="@Model.FeatureFilter" />
            <div style="flex: 1; min-width: 240px; position: relative;">
                <span class="material-symbols-outlined" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); font-size: 18px; color: var(--admin-text-muted);">search</span>
                <input type="text" name="featureSearch" value="@Model.FeatureSearch" placeholder="Search feature name, code, or category..." class="form-control" style="padding-left: 36px; height: 36px; font-size: 13px;" />
            </div>
            <button type="submit" class="btn-admin btn-admin-secondary" style="height: 36px; padding: 0 14px; font-size: 12.5px;">
                Filter
            </button>
            @if (!string.IsNullOrEmpty(Model.FeatureSearch) || !string.IsNullOrEmpty(Model.FeatureFilter))
            {
                <a href="?tenantId=@Model.Tenant.Id" class="btn-admin btn-admin-secondary" style="height: 36px; padding: 0 12px; font-size: 12.5px;">
                    Reset
                </a>
            }
        </form>
    </div>

    <!-- Feature Table -->
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 40px;">S/N</th>
                    <th>Modular Capability</th>
                    <th>Category</th>
                    <th>Cadence</th>
                    <th>Effective Rate</th>
                    <th>Expiration &amp; Renewal Posture</th>
                    <th>Auto-Renew</th>
                    <th>Status</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DisplayedFeatures.Any())
                {
                    int featureIndex = 1;
                    @foreach (var feat in Model.DisplayedFeatures)
                    {
                        <tr style="@(!feat.IsActive ? "opacity: 0.65; background: rgba(0,0,0,0.02);" : "")">
                            <td style="color: var(--admin-text-dim); font-size: 12px; font-weight: 500;">
                                @(featureIndex++)
                            </td>
                            <td>
                                <div>
                                    <div style="font-weight: 700; color: var(--admin-text); font-size: 13.5px; display: flex; align-items: center; gap: 6px;">
                                        @feat.FeatureName
                                        @if (feat.IsCompulsory)
                                        {
                                            <span class="badge" style="background: rgba(99, 102, 241, 0.1); color: var(--admin-primary); font-size: 10.5px; padding: 1px 5px;">Core</span>
                                        }
                                    </div>
                                    <div style="font-size: 11px; color: var(--admin-text-dim); margin-top: 2px; display: flex; align-items: center; gap: 6px;">
                                        <code>@feat.FeatureCode</code>
                                        @if (!string.IsNullOrEmpty(feat.Description) && feat.Description != "Platform modular capability.")
                                        {
                                            <span>•</span>
                                            <span style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@feat.Description">@feat.Description</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-size: 11px;">
                                    @feat.Category
                                </span>
                            </td>
                            <td>
                                @if (feat.IsCompulsory)
                                {
                                    <span class="badge" style="background: rgba(99, 102, 241, 0.12); color: var(--admin-indigo); font-size: 11.5px; font-weight: 700; padding: 4px 8px;">
                                        Yearly (Base Plan)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text); font-size: 11.5px; font-weight: 600; padding: 4px 8px;">
                                        @feat.DurationType
                                    </span>
                                }
                            </td>
                            <td>
                                <div>
                                    @if (feat.IsCompulsory)
                                    {
                                        <div style="font-weight: 700; font-size: 13.5px; color: var(--admin-success);">
                                            Included
                                        </div>
                                        <div style="font-size: 10.5px; color: var(--admin-text-dim);">
                                            Annual Base Plan
                                        </div>
                                    }
                                    else
                                    {
                                        <div style="font-weight: 700; font-size: 14px; color: var(--admin-text);">
                                            $@feat.EffectivePrice.ToString("N2") <small style="font-size: 11px; font-weight: 600; color: var(--admin-text-muted);">/@(feat.DurationType == "Yearly" ? "yr" : "mo")</small>
                                        </div>
                                        <div style="font-size: 10.5px; color: var(--admin-text-dim);">
                                            @if (feat.CustomPriceOverride.HasValue)
                                            {
                                                <span style="color: var(--admin-indigo); font-weight: 600;">Custom Override</span>
                                            }
                                            else
                                            {
                                                <span>Standard Catalog</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (!feat.IsActive)
                                {
                                    <span class="badge" style="background: rgba(239, 68, 68, 0.1); color: var(--admin-danger); font-size: 11px;">
                                        Suspended (Inactive)
                                    </span>
                                }
                                else
                                {
                                    <div>
                                        <div style="font-weight: 600; color: var(--admin-text); font-size: 12.5px;">
                                            @feat.ExpiresAtUtc.ToString("MMM dd, yyyy")
                                        </div>
                                        <div style="margin-top: 2px;">
                                            @if (feat.DaysRemaining < 0)
                                            {
                                                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: var(--admin-danger); font-size: 11px; font-weight: 700; padding: 2px 6px;">
                                                    Overdue by @Math.Abs(feat.DaysRemaining)d
                                                </span>
                                            }
                                            else if (feat.DaysRemaining <= 30)
                                            {
                                                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: var(--admin-warning); font-size: 11px; font-weight: 700; padding: 2px 6px;">
                                                    @feat.DaysRemaining days remaining
                                                </span>
                                            }
                                            else if (feat.DaysRemaining <= 60)
                                            {
                                                <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-size: 11px; font-weight: 600; padding: 2px 6px;">
                                                    @feat.DaysRemaining days remaining
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success); font-size: 11px; font-weight: 600; padding: 2px 6px;">
                                                    @feat.DaysRemaining days remaining @(feat.IsCompulsory || feat.DurationType == "Yearly" ? "(1-Yr Plan)" : "")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </td>
                            <td>
                                @if (feat.AutoRenew)
                                {
                                    <span class="badge" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success); font-size: 11px; font-weight: 600;">
                                        Enabled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-dim); font-size: 11px;">
                                        Disabled
                                    </span>
                                }
                            </td>
                            <td>
                                @if (feat.IsActive)
                                {
                                    <span class="badge badge-success" style="font-size: 11px;">
                                        <span class="badge-dot"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger" style="font-size: 11px;">
                                        <span class="badge-dot"></span> Suspended
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; align-items: center; gap: 6px;">
                                    <form method="post" asp-page-handler="SetFeatureExpiryDays" asp-route-subscriptionId="@feat.SubscriptionId" asp-route-tenantId="@Model.Tenant.Id" asp-route-days="2" style="display: inline; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-admin btn-admin-secondary btn-admin-sm" title="Quick Test: Set expiry to 2 days from now" onclick="return confirm('Set expiry to 2 days from now for @feat.FeatureName to test renewal?');" style="color: var(--admin-warning); font-weight: 700; padding: 3px 8px; border-color: rgba(245, 158, 11, 0.4); display: inline-flex; align-items: center; gap: 4px;">
                                            <span class="material-symbols-outlined" style="font-size: 14px;">bolt</span>
                                            <span>2d</span>
                                        </button>
                                    </form>
                                    <a href="/centralwks/subscriptions/edit?id=@feat.SubscriptionId" class="btn-admin btn-admin-secondary btn-admin-sm" title="Edit Subscription Terms & Pricing">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">edit</span>
                                    </a>
                                    <form method="post" asp-page-handler="ToggleFeatureStatus" asp-route-subscriptionId="@feat.SubscriptionId" asp-route-tenantId="@Model.Tenant.Id" style="display: inline; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-admin @(feat.IsActive ? "btn-admin-danger" : "btn-admin-primary") btn-admin-sm" onclick="return confirm('Toggle status for @feat.FeatureName?');">
                                            @(feat.IsActive ? "Suspend" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="text-align: center; padding: 36px 20px; color: var(--admin-text-muted);">
                            <span class="material-symbols-outlined" style="font-size: 32px; color: var(--admin-text-dim); margin-bottom: 8px; display: block;">search_off</span>
                            No subscribed modular capabilities match the active search and filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Grand Total Accumulation Footer -->
    <div style="padding: 16px 20px; background: var(--admin-bg-surface-elevated); border-top: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="font-size: 13px; color: var(--admin-text-muted);">
            Displaying <strong>@Model.DisplayedFeatures.Count</strong> of <strong>@Model.TotalFeaturesCount</strong> total contracted modular capabilities
        </div>
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="text-align: right;">
                <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-dim);">
                    Total Accumulated Monthly Rate
                </div>
                <div style="font-size: 18px; font-weight: 800; color: var(--admin-success);">
                    $@Model.TotalMonthlyRate.ToString("N2") <small style="font-size: 12px; font-weight: 600; color: var(--admin-text-muted);">USD / mo</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Linked Payment Invoices & Billing History -->
<div class="admin-card">
    <div class="admin-card-header" style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;">
        <h2 class="admin-card-title" style="margin: 0; font-size: 15px; display: flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-primary);">receipt_long</span>
            Linked Billing Invoices &amp; Transactions (@Model.Transactions.Count)
        </h2>
        <a href="/centralwks/billing/create?tenantId=@Model.Tenant.Id" class="btn-admin btn-admin-secondary btn-admin-sm">
            <span class="material-symbols-outlined" style="font-size: 16px;">add</span>
            Record New Invoice
        </a>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Invoice Number</th>
                    <th>Amount</th>
                    <th>Provider</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Transactions.Any())
                {
                    @foreach (var tx in Model.Transactions)
                    {
                        <tr>
                            <td>
                                <code>@tx.InvoiceNumber</code>
                            </td>
                            <td>
                                <strong>$@tx.Amount.ToString("N2")</strong>
                                <small style="color: var(--admin-text-dim);">@tx.Currency</small>
                            </td>
                            <td>
                                <span class="badge" style="background: var(--admin-bg-hover); font-size: 11px;">
                                    @(tx.PaymentProvider ?? "Direct Manual")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(tx.Status == "Completed" ? "badge-success" : (tx.Status == "Failed" ? "badge-danger" : "badge-warning"))" style="font-size: 11px;">
                                    @tx.Status
                                </span>
                            </td>
                            <td style="font-size: 12px; color: var(--admin-text-muted);">
                                @tx.CreatedUtc.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td style="text-align: right;">
                                <a href="/centralwks/billing/details?id=@tx.Id" class="btn-admin btn-admin-secondary btn-admin-sm">
                                    Invoice Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 24px; color: var(--admin-text-muted);">
                            No billing invoice transactions recorded yet for @Model.Tenant.OrganizationName.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function(e) {
            const menu = document.getElementById('bulk-test-menu');
            if (menu && menu.style.display === 'block') {
                const trigger = e.target.closest('button[onclick*="bulk-test-menu"]');
                const inside = e.target.closest('#bulk-test-menu');
                if (!trigger && !inside) {
                    menu.style.display = 'none';
                }
            }
        });
    </script>
}
