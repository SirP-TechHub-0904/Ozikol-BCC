@page
@model Ozikol.Central.Areas.Centralwks.Pages.Subscriptions.IndexModel
@{
    ViewData["Title"] = "Subscription Matrix";
    ViewData["BreadcrumbSection"] = "Platform Core";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Fleet Subscription Matrix</h1>
        <p class="admin-subtitle">Live cross-tenant matrix of activated modular capabilities, recurring subscription billing, and expiration schedules.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/tenants" class="btn-admin btn-admin-primary">
            <span>+</span> Manage by Tenant
        </a>
    </div>
</div>

@* ── Stat Cards ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 20px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-indigo" style="width: 40px; height: 40px; font-size: 18px;">📋</div>
        <div class="stat-details">
            <span class="stat-label">Active Subscriptions</span>
            <span class="stat-value" style="font-size: 20px; color: var(--admin-indigo);">@Model.ActiveCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px; font-size: 18px;">💰</div>
        <div class="stat-details">
            <span class="stat-label">Contracted Recurring / Mo</span>
            <span class="stat-value" style="font-size: 20px; color: var(--admin-success);">$@Model.TotalMonthlyValue.ToString("N2")</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-warning" style="width: 40px; height: 40px; font-size: 18px;">⏸</div>
        <div class="stat-details">
            <span class="stat-label">Suspended</span>
            <span class="stat-value" style="font-size: 20px; color: var(--admin-warning);">@Model.SuspendedCount</span>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="table-toolbar">
        <form method="get" class="table-filters" style="flex: 1; display: flex; gap: 12px; align-items: center;">
            <div class="table-search-box">
                <span class="search-icon">🔍</span>
                <input type="text" name="search" value="@Model.Search" placeholder="Search tenant or feature..." />
            </div>

            <select name="status" class="form-select" style="width: 160px; padding: 8px 12px; font-size: 13px;">
                <option value="">All Statuses</option>
                <option value="active" selected="@(Model.Status == "active")">Active Only</option>
                <option value="suspended" selected="@(Model.Status == "suspended")">Suspended Only</option>
            </select>

            <button type="submit" class="btn-admin btn-admin-secondary btn-admin-sm">Filter</button>
            @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status) || Model.TenantId.HasValue || Model.FeatureId.HasValue)
            {
                <a href="/centralwks/subscriptions" class="btn-admin btn-admin-secondary btn-admin-sm" style="color: var(--admin-danger);">Clear</a>
            }
        </form>

        <div style="font-size: 12.5px; color: var(--admin-text-muted);">
            Showing @Model.Subscriptions.Count of @Model.TotalCount subscriptions
        </div>
    </div>

    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Tenant Organization</th>
                    <th>Capability Module</th>
                    <th>Cadence</th>
                    <th>Recurring Rate</th>
                    <th>Expires At</th>
                    <th>Auto-Renew</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Subscriptions.Any())
                {
                    @foreach (var sub in Model.Subscriptions)
                    {
                        <tr>
                            <td>
                                <div>
                                    <a href="/centralwks/tenants/details?id=@sub.MasterTenantCatalogId" style="color: var(--admin-text); font-weight: 600; text-decoration: none;">
                                        @sub.MasterTenantCatalog.OrganizationName
                                    </a>
                                    <div style="font-size: 11.5px; color: var(--admin-text-dim);">
                                        <code>@sub.MasterTenantCatalog.TenantKey</code>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>
                                    <a href="/centralwks/features/details?id=@sub.MasterFeatureCatalogId" style="color: var(--admin-text); font-weight: 500; text-decoration: none;">
                                        @sub.MasterFeatureCatalog.Name
                                    </a>
                                    <div style="font-size: 11.5px; color: var(--admin-text-dim);">
                                        <code>@sub.MasterFeatureCatalog.FeatureCode</code> • @sub.MasterFeatureCatalog.Category
                                    </div>
                                </div>
                            </td>
                            <td>@sub.DurationType</td>
                            <td>
                                @if (sub.CustomPriceOverride.HasValue)
                                {
                                    <strong style="color: var(--admin-warning);">$@sub.CustomPriceOverride.Value.ToString("N2")</strong>
                                    <small style="font-size: 11px; color: var(--admin-text-dim);">(Custom)</small>
                                }
                                else
                                {
                                    <span>$@sub.RecurringPrice.ToString("N2")</span>
                                }
                            </td>
                            <td style="font-size: 12px; color: var(--admin-text-muted);">
                                @sub.ExpiresAtUtc.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                @if (sub.AutoRenew)
                                {
                                    <span class="badge badge-success">On</span>
                                }
                                else
                                {
                                    <span class="badge badge-neutral">Off</span>
                                }
                            </td>
                            <td>
                                @if (sub.IsActive)
                                {
                                    <span class="badge badge-success"><span class="badge-dot"></span> @sub.Status</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><span class="badge-dot"></span> @sub.Status</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; align-items: center; gap: 6px;">
                                    <a href="/centralwks/subscriptions/details?id=@sub.Id" class="btn-admin btn-admin-secondary btn-admin-sm">Details</a>
                                    <a href="/centralwks/subscriptions/edit?id=@sub.Id" class="btn-admin btn-admin-secondary btn-admin-sm">Edit</a>
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@sub.Id" style="display: inline; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-admin @(sub.IsActive ? "btn-admin-danger" : "btn-admin-primary") btn-admin-sm" onclick="return confirm('Toggle status for this subscription?');">
                                            @(sub.IsActive ? "Suspend" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <div class="empty-state-icon">📋</div>
                                <h3 class="empty-state-title">No Subscriptions Found</h3>
                                <p class="empty-state-desc">No active or suspended subscriptions match your filter criteria.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="admin-card-footer">
            <div style="font-size: 12.5px; color: var(--admin-text-muted);">
                Page @Model.PageNumber of @Model.TotalPages
            </div>
            <ul class="admin-pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" href="?pageNumber=@(Model.PageNumber - 1)&search=@Model.Search&status=@Model.Status">‹ Previous</a>
                </li>
                @for (int p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="?pageNumber=@p&search=@Model.Search&status=@Model.Status">@p</a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="?pageNumber=@(Model.PageNumber + 1)&search=@Model.Search&status=@Model.Status">Next ›</a>
                </li>
            </ul>
        </div>
    }
</div>
