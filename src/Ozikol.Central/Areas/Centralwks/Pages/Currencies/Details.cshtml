@page "{id:int}"
@model Ozikol.Central.Areas.Centralwks.Pages.Currencies.DetailsModel
@{
    ViewData["Title"] = $"Currency: {Model.Currency.CurrencyCode}";
    ViewData["BreadcrumbSection"] = "Currencies";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">@Model.Currency.DisplayName (@Model.Currency.CurrencyCode)</h1>
        <p class="admin-subtitle">Inspect currency formatting, live FX multiplier simulations, and geographic auto-assignment rules.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/currencies/edit/@Model.Currency.Id" class="btn-admin btn-admin-primary">
            <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
            Edit Currency
        </a>
        <a href="/centralwks/currencies" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
            Back to Currencies
        </a>
    </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
    @* ── Left: Main Currency Overview & Sample Calculator ── *@
    <div>
        <div class="admin-card" style="padding: 28px; margin-bottom: 24px;">
            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--admin-border); padding-bottom: 20px; margin-bottom: 24px;">
                <div style="display: flex; align-items: center; gap: 16px;">
                    <div style="width: 56px; height: 56px; border-radius: var(--radius-md); background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.25); display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 800; color: var(--admin-indigo);">
                        @Model.Currency.CurrencySymbol
                    </div>
                    <div>
                        <div style="font-size: 20px; font-weight: 700; color: var(--admin-text);">@Model.Currency.DisplayName</div>
                        <div style="font-size: 13px; color: var(--admin-text-muted); margin-top: 2px;">
                            ISO Code: <span style="color: var(--admin-text); font-family: monospace; font-weight: 600;">@Model.Currency.CurrencyCode</span> &bull; 
                            Culture: <span style="color: var(--admin-text); font-family: monospace;">@Model.Currency.CultureName</span> &bull;
                            Pill: <span style="color: var(--admin-text); font-weight: 500;">@Model.Currency.PillLabel</span>
                        </div>
                    </div>
                </div>
                <div>
                    @if (Model.Currency.IsBaseCurrency)
                    {
                        <span class="badge" style="background: rgba(245, 158, 11, 0.12); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.3); font-size: 12px; padding: 6px 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                            <span class="material-symbols-outlined" style="font-size: 14px;">star</span>
                            Global Base Currency
                        </span>
                    }
                    else
                    {
                        <span class="badge @(Model.Currency.IsActive ? "badge-success" : "badge-danger")" style="font-size: 12px; padding: 6px 12px; font-weight: 700;">
                            @(Model.Currency.IsActive ? "Active" : "Inactive")
                        </span>
                    }
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 28px;">
                <div style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-sm); padding: 16px;">
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted); margin-bottom: 4px;">Rate Multiplier</div>
                    <div style="font-size: 22px; font-weight: 800; font-family: monospace; color: var(--admin-primary);">
                        @Model.Currency.RateFromUsd.ToString("N4")
                    </div>
                    <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 2px;">Relative to 1.00 USD</div>
                </div>

                <div style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-sm); padding: 16px;">
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted); margin-bottom: 4px;">Display Sort Order</div>
                    <div style="font-size: 22px; font-weight: 800; color: var(--admin-text);">
                        #@Model.Currency.SortOrder
                    </div>
                    <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 2px;">Selector sequence</div>
                </div>

                <div style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-sm); padding: 16px;">
                    <div style="font-size: 11px; text-transform: uppercase; font-weight: 700; color: var(--admin-text-muted); margin-bottom: 4px;">Last Rate Update</div>
                    <div style="font-size: 13.5px; font-weight: 600; color: var(--admin-text); margin-top: 4px;">
                        @(Model.Currency.UpdatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? Model.Currency.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm"))
                    </div>
                    <div style="font-size: 11px; color: var(--admin-text-muted); margin-top: 2px;">UTC Timestamp</div>
                </div>
            </div>

            @* ── Live FX Conversion Simulator Table ── *@
            <h3 style="font-size: 16px; font-weight: 700; color: var(--admin-text); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-primary);">monitoring</span>
                Live FX Pricing Simulation
            </h3>
            <p style="font-size: 13px; color: var(--admin-text-muted); margin-bottom: 16px;">
                Demonstrates how base tier prices are dynamically evaluated in public checkout and pricing pages.
            </p>

            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--admin-border); text-align: left;">
                        <th style="padding: 10px 8px; font-size: 12px; text-transform: uppercase; color: var(--admin-text-muted);">Package / Plan</th>
                        <th style="padding: 10px 8px; font-size: 12px; text-transform: uppercase; color: var(--admin-text-muted); text-align: right;">USD Base Price</th>
                        <th style="padding: 10px 8px; font-size: 12px; text-transform: uppercase; color: var(--admin-text-muted); text-align: right;">Converted Local Value</th>
                        <th style="padding: 10px 8px; font-size: 12px; text-transform: uppercase; color: var(--admin-text-muted); text-align: right;">Formatted Display</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sample in Model.SampleCalculations)
                    {
                        <tr style="border-bottom: 1px solid var(--admin-border);">
                            <td style="padding: 14px 8px; font-weight: 600; color: var(--admin-text);">@sample.TierName</td>
                            <td style="padding: 14px 8px; text-align: right; color: var(--admin-text-muted); font-family: monospace;">$@sample.BaseUsdPrice.ToString("N2")</td>
                            <td style="padding: 14px 8px; text-align: right; color: var(--admin-text); font-family: monospace; font-weight: 600;">@sample.CalculatedLocalPrice.ToString("N2")</td>
                            <td style="padding: 14px 8px; text-align: right; color: var(--admin-primary); font-weight: 700;">@sample.FormattedDisplay</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Right: GeoIP Mappings & Actions ── *@
    <div>
        <div class="admin-card" style="margin-bottom: 24px;">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.12); color: var(--admin-success);">
                    <span class="material-symbols-outlined" style="font-size: 20px;">public</span>
                </div>
                <div>
                    <h3 class="card-header-title">GeoIP Mappings</h3>
                    <p class="card-header-subtitle">Countries routing to this currency.</p>
                </div>
            </div>

            <div style="padding: 20px;">
                @if (Model.CountryCodes.Any())
                {
                    <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px;">
                        @foreach (var code in Model.CountryCodes)
                        {
                            <div style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: 6px; padding: 6px 12px; font-family: monospace; font-weight: 700; color: var(--admin-info); font-size: 13px; display: inline-flex; align-items: center; gap: 4px;">
                                <span class="material-symbols-outlined" style="font-size: 14px;">flag</span>
                                @code
                            </div>
                        }
                    </div>
                    <p style="font-size: 12px; color: var(--admin-text-muted); line-height: 1.5;">
                        Clients connecting with IP addresses belonging to these ISO alpha-2 countries will automatically see checkout amounts in @Model.Currency.CurrencyCode.
                    </p>
                }
                else
                {
                    <p style="font-size: 13px; color: var(--admin-text-muted); font-style: italic;">
                        No geographic country codes mapped to this currency. It will be available strictly via explicit manual selection.
                    </p>
                }
            </div>
        </div>

        <div class="admin-card">
            <div class="card-header-styled">
                <div class="card-header-icon" style="background: rgba(229, 23, 63, 0.12); color: var(--admin-primary);">
                    <span class="material-symbols-outlined" style="font-size: 20px;">settings</span>
                </div>
                <div>
                    <h3 class="card-header-title">Operations</h3>
                    <p class="card-header-subtitle">Quick state updates.</p>
                </div>
            </div>

            <div style="padding: 20px; display: flex; flex-direction: column; gap: 10px;">
                <a href="/centralwks/currencies/edit/@Model.Currency.Id" class="btn-admin btn-admin-primary" style="justify-content: center; display: inline-flex; align-items: center; gap: 6px;">
                    <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
                    Edit Currency Configuration
                </a>

                @if (!Model.Currency.IsBaseCurrency)
                {
                    <form method="post" asp-page-handler="ToggleActive" asp-route-id="@Model.Currency.Id">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center; display: inline-flex; align-items: center; gap: 6px;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">@(Model.Currency.IsActive ? "pause_circle" : "play_circle")</span>
                            @(Model.Currency.IsActive ? "Deactivate Currency" : "Activate Currency")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
