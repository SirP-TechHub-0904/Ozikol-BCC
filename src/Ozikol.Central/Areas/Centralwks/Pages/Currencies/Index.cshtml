@page
@model Ozikol.Central.Areas.Centralwks.Pages.Currencies.IndexModel
@{
    ViewData["Title"] = "Platform Currencies & FX Rates";
    ViewData["BreadcrumbSection"] = "Platform Core";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Currencies & FX Rates</h1>
        <p class="admin-subtitle">Manage global currencies, exchange rates against base USD, culture string formatting, and GeoIP detection mappings.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/currencies/create" class="btn-admin btn-admin-primary">
            <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
            Add Currency
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.25); color: var(--admin-info); border-radius: var(--radius-sm); padding: 12px 18px; margin-bottom: 24px; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="font-size: 18px;">info</span>
        <span>@Model.StatusMessage</span>
    </div>
}

@* ── Currency Metrics Cards ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-primary" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">currency_exchange</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Total Currencies</span>
            <span class="stat-value" style="font-size: 22px;">@Model.TotalCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-success" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">check_circle</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Active for Checkout</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-success);">@Model.ActiveCount</span>
        </div>
    </div>
    <div class="stat-card" style="padding: 16px;">
        <div class="stat-icon-wrapper stat-icon-warning" style="width: 40px; height: 40px;">
            <span class="material-symbols-outlined" style="font-size: 20px;">star</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Base Pricing Currency</span>
            <span class="stat-value" style="font-size: 22px; color: var(--admin-warning);">@Model.BaseCurrencyCode</span>
        </div>
    </div>
</div>

@* ── Filters ── *@
<div class="admin-card" style="margin-bottom: 24px; padding: 16px 20px;">
    <form method="get" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 240px; position: relative;">
            <span class="material-symbols-outlined" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 18px; pointer-events: none;">search</span>
            <input type="text" name="Search" value="@Model.Search" placeholder="Search by code (e.g. NGN, EUR), name, symbol, or country code..." 
                   class="form-control" style="padding-left: 38px; height: 38px; font-size: 13px;" />
        </div>
        <div style="min-width: 150px;">
            <select name="Status" class="form-select" style="height: 38px; font-size: 13px;">
                <option value="">All Statuses</option>
                <option value="active" selected="@(Model.Status == "active")">Active Only</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Inactive Only</option>
            </select>
        </div>
        <button type="submit" class="btn-admin btn-admin-secondary" style="height: 38px; padding: 0 16px; display: inline-flex; align-items: center; gap: 6px;">
            <span class="material-symbols-outlined" style="font-size: 16px;">filter_alt</span>
            Filter
        </button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status))
        {
            <a href="/centralwks/currencies" class="btn-admin btn-admin-secondary" style="height: 38px; padding: 0 14px; color: var(--admin-danger); display: inline-flex; align-items: center; gap: 4px;">
                <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
                Clear
            </a>
        }
    </form>
</div>

@* ── Currencies Table ── *@
<div class="admin-card">
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 60px; text-align: center;">Order</th>
                    <th>Currency</th>
                    <th>Symbol</th>
                    <th>Rate Multiplier (from 1 USD)</th>
                    <th>Culture Format</th>
                    <th>Mapped Countries</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Currencies.Any())
                {
                    @foreach (var c in Model.Currencies)
                    {
                        <tr>
                            <td style="text-align: center; font-family: monospace; color: var(--admin-text-muted); font-size: 12px; font-weight: 600;">
                                @c.SortOrder
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <div style="width: 36px; height: 36px; border-radius: var(--radius-sm); background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.25); display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--admin-indigo); font-size: 13.5px;">
                                        @c.CurrencySymbol
                                    </div>
                                    <div>
                                        <div style="font-weight: 700; color: var(--admin-text); font-size: 13.5px;">@c.CurrencyCode</div>
                                        <div style="font-size: 12px; color: var(--admin-text-muted);">@c.DisplayName</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span style="font-size: 15px; font-weight: 700; color: var(--admin-text);">
                                    @c.CurrencySymbol
                                </span>
                            </td>
                            <td>
                                <span style="font-family: monospace; font-size: 13.5px; font-weight: 700; color: @(c.IsBaseCurrency ? "var(--admin-primary)" : "var(--admin-text)");">
                                    @c.RateFromUsd.ToString("N4")
                                </span>
                                @if (c.IsBaseCurrency)
                                {
                                    <span style="font-size: 11px; color: var(--admin-primary); font-weight: 600; margin-left: 4px;">(Base)</span>
                                }
                            </td>
                            <td>
                                <code style="font-size: 11.5px; padding: 2px 6px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: 4px; color: var(--admin-info); font-weight: 600;">
                                    @c.CultureName
                                </code>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(c.AssociatedCountryCodes))
                                {
                                    <div style="display: flex; gap: 4px; flex-wrap: wrap; max-width: 220px;">
                                        @foreach (var code in c.AssociatedCountryCodes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4))
                                        {
                                            <span style="font-size: 10.5px; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); color: var(--admin-text); font-family: monospace;">
                                                @code
                                            </span>
                                        }
                                        @if (c.AssociatedCountryCodes.Split(',').Length > 4)
                                        {
                                            <span style="font-size: 10.5px; color: var(--admin-text-muted); font-weight: 500;">+@(c.AssociatedCountryCodes.Split(',').Length - 4) more</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size: 12px; color: var(--admin-text-muted); font-style: italic;">None</span>
                                }
                            </td>
                            <td>
                                @if (c.IsBaseCurrency)
                                {
                                    <span class="badge" style="background: rgba(245, 158, 11, 0.12); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.3); font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                                        <span class="material-symbols-outlined" style="font-size: 12px;">star</span>
                                        Global Base
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary" style="font-size: 11px; font-weight: 600;">Regional</span>
                                }
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge badge-success" style="font-size: 11px; font-weight: 700;">
                                        <span class="badge-dot" style="background-color: var(--admin-success);"></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger" style="font-size: 11px; font-weight: 700;">
                                        <span class="badge-dot" style="background-color: var(--admin-danger);"></span>
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; gap: 4px; align-items: center;">
                                    <a href="/centralwks/currencies/details/@c.Id" class="btn-admin btn-admin-secondary btn-admin-sm" style="padding: 4px 8px;" title="View Details">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">visibility</span>
                                    </a>
                                    <a href="/centralwks/currencies/edit/@c.Id" class="btn-admin btn-admin-secondary btn-admin-sm" style="padding: 4px 8px;" title="Edit Currency">
                                        <span class="material-symbols-outlined" style="font-size: 15px;">edit</span>
                                    </a>
                                    @if (!c.IsBaseCurrency)
                                    {
                                        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@c.Id" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-admin btn-admin-secondary btn-admin-sm" style="padding: 4px 8px;" title="@(c.IsActive ? "Deactivate" : "Activate")">
                                                <span class="material-symbols-outlined" style="font-size: 15px;">@(c.IsActive ? "pause_circle" : "play_circle")</span>
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" style="display: inline;" onsubmit="return confirm('Permanently delete currency @c.CurrencyCode?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm" style="padding: 4px 8px;" title="Delete Currency">
                                                <span class="material-symbols-outlined" style="font-size: 15px;">delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" style="text-align: center; padding: 48px; color: var(--admin-text-muted);">
                            <span class="material-symbols-outlined" style="font-size: 36px; color: var(--admin-text-muted); margin-bottom: 8px; display: block;">currency_exchange</span>
                            <div style="font-size: 15px; font-weight: 600; color: var(--admin-text);">No Currencies Found</div>
                            <div style="font-size: 13px; margin-top: 4px;">Try refining your search filter or add a new currency.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

