@page
@model Ozikol.Central.Areas.Centralwks.Pages.Currencies.CreateModel
@{
    ViewData["Title"] = "Add Platform Currency";
    ViewData["BreadcrumbSection"] = "Currencies";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Add Supported Currency</h1>
        <p class="admin-subtitle">Register a new global currency, define its exchange multiplier relative to USD, culture string formatting, and country associations.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/currencies" class="btn-admin btn-admin-secondary">
            <span>&larr;</span> Back to Currencies
        </a>
    </div>
</div>

<form method="post" style="max-width: 800px;">
    @Html.AntiForgeryToken()

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: 8px; padding: 14px 18px; margin-bottom: 24px;">
            <div asp-validation-summary="All" style="margin: 0; padding-left: 20px;"></div>
        </div>
    }

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">💱</div>
            <div>
                <h3 class="card-header-title">Identity & Formatting</h3>
                <p class="card-header-subtitle">Specify currency code, symbol, localized name, and .NET formatting culture.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.CurrencyCode" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Currency ISO Code <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.CurrencyCode" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px; text-transform: uppercase;" placeholder="e.g. JPY, KES, ZAR" />
                    <span asp-validation-for="Input.CurrencyCode" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.CurrencySymbol" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Symbol <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.CurrencySymbol" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="e.g. ¥, Ksh, R" />
                    <span asp-validation-for="Input.CurrencySymbol" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.DisplayName" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Display Name <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.DisplayName" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="e.g. Japanese Yen, Kenyan Shilling" />
                    <span asp-validation-for="Input.DisplayName" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.CultureName" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        .NET Culture Name <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.CultureName" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="e.g. ja-JP, en-KE, en-ZA" />
                    <span asp-validation-for="Input.CultureName" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 8px;">
                <label asp-for="Input.PillLabel" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Selector Pill Label (Optional)
                </label>
                <input asp-for="Input.PillLabel" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="e.g. JPY (¥) — defaults to Code (Symbol)" />
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom: 24px;">
        <div class="card-header-styled">
            <div class="card-header-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">📈</div>
            <div>
                <h3 class="card-header-title">Exchange Rate & GeoIP Routing</h3>
                <p class="card-header-subtitle">Configure conversion rate against 1.0 USD and country codes for automatic client detection.</p>
            </div>
        </div>

        <div style="padding: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div class="form-group">
                    <label asp-for="Input.RateFromUsd" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Multiplier Rate from 1.0 USD <span style="color: var(--admin-danger); font-weight: bold;">*</span>
                    </label>
                    <input asp-for="Input.RateFromUsd" type="number" step="0.0001" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" placeholder="1.0000" />
                    <span asp-validation-for="Input.RateFromUsd" class="text-danger" style="font-size: 12px; color: var(--admin-danger); margin-top: 4px; display: block;"></span>
                    <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Formula: Local Price = USD Base Price * Multiplier</span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.SortOrder" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                        Display Sort Order
                    </label>
                    <input asp-for="Input.SortOrder" type="number" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px;" />
                    <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Lower numbers appear first in the header currency selector.</span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="Input.AssociatedCountryCodes" class="form-label" style="display: block; margin-bottom: 8px; font-weight: 500; font-size: 13px; color: var(--admin-text-muted);">
                    Mapped Country Codes (Comma-separated ISO 3166-1 alpha-2)
                </label>
                <input asp-for="Input.AssociatedCountryCodes" class="form-control" style="width: 100%; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 10px 14px; color: var(--admin-text); font-size: 14px; font-family: monospace;" placeholder="e.g. JP or KE,UG,TZ or DE,FR,ES,IT" />
                <span style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Visitors from these countries will automatically see prices formatted in this currency.</span>
            </div>

            <div style="display: flex; gap: 24px; padding-top: 8px;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input asp-for="Input.IsActive" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--admin-primary);" />
                    <span style="font-size: 14px; color: #fff;">Active for Public Checkout</span>
                </label>

                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input asp-for="Input.IsBaseCurrency" type="checkbox" style="width: 18px; height: 18px; accent-color: #f59e0b;" />
                    <span style="font-size: 14px; color: #f59e0b;">Set as Global Base Currency (USD)</span>
                </label>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 24px;">
        <a href="/centralwks/currencies" class="btn-admin btn-admin-secondary">Cancel</a>
        <button type="submit" class="btn-admin btn-admin-primary">
            <span>💾</span> Save Currency
        </button>
    </div>
</form>
