@page
@model Ozikol.Central.Areas.Centralwks.Pages.Coupons.CreateModel
@{
    ViewData["Title"] = "Create Voucher & Coupon";
    ViewData["BreadcrumbSection"] = "Billing & Plans";
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <h1 class="admin-title">Create Voucher / Promo Code</h1>
        <p class="admin-subtitle">Generate a promotional discount voucher with percentage discounts, feature restrictions, and max redemption quotas.</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/coupons" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
            Back to Vouchers
        </a>
    </div>
</div>

<form method="post">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
        
        @* Left Column: Primary Configurations *@
        <div style="display: flex; flex-direction: column; gap: 24px;">
            
            <div class="admin-card">
                <div class="admin-card-header">
                    <h2 class="admin-card-title">
                        <span class="material-symbols-outlined" style="color: var(--admin-primary); font-size: 20px;">confirmation_number</span>
                        Voucher Parameters
                    </h2>
                </div>
                <div class="admin-card-body" style="display: flex; flex-direction: column; gap: 18px;">
                    
                    <div>
                        <label asp-for="Input.Code" class="form-label" style="font-weight: 700; font-size: 13px; color: var(--admin-text); display: flex; justify-content: space-between;">
                            <span>Promo Code <span style="color: var(--admin-danger);">*</span></span>
                            <button type="button" onclick="generateRandomCode()" style="background: none; border: none; color: var(--admin-primary); font-size: 12px; font-weight: 600; cursor: pointer;">
                                Generate Random Code
                            </button>
                        </label>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <input asp-for="Input.Code" id="inputCode" placeholder="e.g. LAUNCH100, SUMMER50, ACADEMICS2026" 
                                   class="form-control" style="font-family: monospace; font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;" required />
                        </div>
                        <span asp-validation-for="Input.Code" class="text-danger" style="font-size: 12px;"></span>
                        <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px;">
                            Unique code entered by tenant organizations during registration or checkout.
                        </div>
                    </div>

                    <div>
                        <label asp-for="Input.Description" class="form-label" style="font-weight: 700; font-size: 13px; color: var(--admin-text);">
                            Campaign / Voucher Description
                        </label>
                        <textarea asp-for="Input.Description" rows="2" placeholder="e.g. 100% Launch waiver for early adopter institutions" class="form-control"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger" style="font-size: 12px;"></span>
                    </div>

                    @* Discount Type & Amount *@
                    <div style="background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); padding: 18px;">
                        <label class="form-label" style="font-weight: 700; font-size: 13px; color: var(--admin-text); margin-bottom: 12px;">
                            Discount Valuation Model
                        </label>

                        <div style="display: flex; gap: 20px; margin-bottom: 16px;">
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--admin-text);">
                                <input type="radio" asp-for="Input.IsPercentage" value="true" id="radioPct" onchange="toggleDiscountType(true)" />
                                Percentage Discount (%)
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--admin-text);">
                                <input type="radio" asp-for="Input.IsPercentage" value="false" id="radioAmt" onchange="toggleDiscountType(false)" />
                                Fixed Amount ($ USD)
                            </label>
                        </div>

                        <div id="pctGroup">
                            <label asp-for="Input.DiscountPercentage" class="form-label" style="font-size: 12.5px; color: var(--admin-text-muted);">
                                Percentage Off (1% – 100%)
                            </label>
                            <div style="display: flex; align-items: center; gap: 14px;">
                                <input asp-for="Input.DiscountPercentage" id="inputPct" type="range" min="1" max="100" step="1" 
                                       style="flex: 1; accent-color: var(--admin-primary); cursor: pointer;" 
                                       oninput="document.getElementById('numPct').value = this.value; updatePreview();" />
                                <div style="display: flex; align-items: center; gap: 4px; min-width: 90px;">
                                    <input type="number" id="numPct" value="@Model.Input.DiscountPercentage" min="1" max="100" 
                                           class="form-control" style="width: 70px; text-align: right; font-weight: 700;" 
                                           oninput="document.getElementById('inputPct').value = this.value; updatePreview();" />
                                    <span style="font-weight: 700; color: var(--admin-text); font-size: 14px;">%</span>
                                </div>
                            </div>
                            <div style="font-size: 12px; color: #10b981; font-weight: 600; margin-top: 6px;" id="freeNotice">
                                ✦ Set to 100% to grant completely free access to all selected capabilities.
                            </div>
                        </div>

                        <div id="amtGroup" style="display: none;">
                            <label asp-for="Input.DiscountAmount" class="form-label" style="font-size: 12.5px; color: var(--admin-text-muted);">
                                Fixed Dollar Discount ($ USD)
                            </label>
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <span style="font-size: 16px; font-weight: 700; color: var(--admin-text);">$</span>
                                <input asp-for="Input.DiscountAmount" id="inputAmt" type="number" step="0.01" min="0" placeholder="0.00" 
                                       class="form-control" style="width: 150px; font-weight: 700;" oninput="updatePreview();" />
                            </div>
                        </div>
                    </div>

                    @* Feature Restriction Scope *@
                    <div>
                        <label asp-for="Input.SpecificFeatureId" class="form-label" style="font-weight: 700; font-size: 13px; color: var(--admin-text);">
                            Feature Application Scope
                        </label>
                        <select asp-for="Input.SpecificFeatureId" class="form-select" style="width: 100%; padding: 10px 12px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-md); color: var(--admin-text);">
                            <option value="">Universal Voucher (Applies to Base Annual Fee &amp; All Capabilities)</option>
                            @foreach (var opt in Model.FeatureOptions)
                            {
                                <option value="@opt.Value">@opt.Text</option>
                            }
                        </select>
                        <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px;">
                            Leave set to <strong>Universal Voucher</strong> unless this code should only be applied to a specific module.
                        </div>
                    </div>

                </div>
            </div>

        </div>

        @* Right Column: Quotas & Lifecycle Governance *@
        <div style="display: flex; flex-direction: column; gap: 24px;">
            
            <div class="admin-card">
                <div class="admin-card-header">
                    <h2 class="admin-card-title">
                        <span class="material-symbols-outlined" style="color: var(--admin-primary); font-size: 20px;">tune</span>
                        Quotas &amp; Lifecycle
                    </h2>
                </div>
                <div class="admin-card-body" style="display: flex; flex-direction: column; gap: 16px;">
                    
                    <div>
                        <label asp-for="Input.MaxRedemptions" class="form-label" style="font-weight: 700; font-size: 13px; color: var(--admin-text);">
                            Max Redemptions Cap
                        </label>
                        <input asp-for="Input.MaxRedemptions" type="number" min="0" placeholder="0 = Unlimited" class="form-control" style="font-weight: 600;" />
                        <span asp-validation-for="Input.MaxRedemptions" class="text-danger" style="font-size: 12px;"></span>
                        <div style="font-size: 12px; color: var(--admin-text-muted); margin-top: 4px;">
                            Enter <strong>0</strong> for unlimited redemptions across all tenants.
                        </div>
                    </div>

                    <div>
                        <label asp-for="Input.StartsAtUtc" class="form-label" style="font-weight: 700; font-size: 13px; color: var(--admin-text);">
                            Valid From (UTC)
                        </label>
                        <input asp-for="Input.StartsAtUtc" type="datetime-local" class="form-control" />
                    </div>

                    <div>
                        <label asp-for="Input.ExpiresAtUtc" class="form-label" style="font-weight: 700; font-size: 13px; color: var(--admin-text);">
                            Expiration Date (UTC - Optional)
                        </label>
                        <input asp-for="Input.ExpiresAtUtc" type="datetime-local" class="form-control" />
                    </div>

                    <div style="padding-top: 8px; border-top: 1px solid var(--admin-border);">
                        <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--admin-text);">
                            <input type="checkbox" asp-for="Input.IsActive" style="width: 18px; height: 18px; accent-color: var(--admin-primary);" />
                            <span>Voucher Active Immediately</span>
                        </label>
                    </div>

                </div>
            </div>

            @* Live Voucher Preview Box *@
            <div class="admin-card" style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%); border: 1px dashed var(--admin-primary); padding: 18px;">
                <div style="font-size: 11.5px; font-weight: 700; color: var(--admin-text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">
                    Live Voucher Badge Preview
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; background: var(--admin-bg-surface); padding: 12px 16px; border-radius: var(--radius-md); border: 1px solid var(--admin-border);">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="material-symbols-outlined" style="color: var(--admin-primary);">confirmation_number</span>
                        <span id="previewCode" style="font-family: monospace; font-size: 15px; font-weight: 800; color: var(--admin-text);">LAUNCH100</span>
                    </div>
                    <span id="previewBadge" class="badge badge-success" style="font-size: 12.5px; font-weight: 700; padding: 4px 10px;">
                        100% OFF (FREE)
                    </span>
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; justify-content: center; padding: 12px;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">add_circle</span>
                    Create Voucher &amp; Activate
                </button>
                <a href="/centralwks/coupons" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center;">
                    Cancel
                </a>
            </div>

        </div>

    </div>
</form>

<script>
function generateRandomCode() {
    const prefixes = ['LAUNCH', 'PROMO', 'GROWTH', 'VIP', 'SPECIAL', 'SAVE'];
    const prefix = prefixes[Math.floor(Math.random() * prefixes.length)];
    const num = Math.floor(10 + Math.random() * 90);
    const code = `${prefix}${num}`;
    document.getElementById('inputCode').value = code;
    updatePreview();
}

function toggleDiscountType(isPct) {
    document.getElementById('pctGroup').style.display = isPct ? 'block' : 'none';
    document.getElementById('amtGroup').style.display = isPct ? 'none' : 'block';
    updatePreview();
}

function updatePreview() {
    const codeInput = document.getElementById('inputCode');
    const previewCode = document.getElementById('previewCode');
    const previewBadge = document.getElementById('previewBadge');
    const isPct = document.getElementById('radioPct').checked;

    previewCode.innerText = (codeInput.value || 'PROMO100').toUpperCase();

    if (isPct) {
        const val = parseFloat(document.getElementById('numPct').value) || 100;
        if (val >= 100) {
            previewBadge.innerText = '100% OFF (FREE)';
            previewBadge.className = 'badge badge-success';
        } else {
            previewBadge.innerText = `${val}% OFF`;
            previewBadge.className = 'badge badge-primary';
        }
    } else {
        const amt = parseFloat(document.getElementById('inputAmt').value) || 0;
        previewBadge.innerText = `$${amt.toFixed(2)} OFF`;
        previewBadge.className = 'badge badge-info';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const codeInput = document.getElementById('inputCode');
    if (codeInput) {
        codeInput.addEventListener('input', updatePreview);
    }
    updatePreview();
});
</script>
