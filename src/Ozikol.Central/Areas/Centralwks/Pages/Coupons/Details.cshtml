@page
@model Ozikol.Central.Areas.Centralwks.Pages.Coupons.DetailsModel
@{
    ViewData["Title"] = $"Voucher: {Model.Coupon.Code}";
    ViewData["BreadcrumbSection"] = "Billing & Plans";
    var c = Model.Coupon;
}

<div class="admin-page-header">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 4px;">
            <h1 class="admin-title" style="font-family: monospace; font-size: 26px; letter-spacing: 1px;">@c.Code</h1>
            @if (c.IsActive)
            {
                <span class="badge badge-success" style="font-size: 12px;">Active Promo</span>
            }
            else
            {
                <span class="badge badge-neutral" style="font-size: 12px;">Inactive</span>
            }

            @if (c.IsPercentage && c.DiscountPercentage >= 100m)
            {
                <span class="badge badge-primary" style="font-size: 12px; background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.4);">
                    100% OFF (FREE)
                </span>
            }
        </div>
        <p class="admin-subtitle">@(c.Description ?? "Platform campaign promo code")</p>
    </div>
    <div class="admin-actions">
        <a href="/centralwks/coupons" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span>
            Back to Vouchers
        </a>
        <a href="/centralwks/coupons/edit?id=@c.Id" class="btn-admin btn-admin-secondary">
            <span class="material-symbols-outlined" style="font-size: 16px;">edit</span>
            Edit
        </a>
        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@c.Id" style="display: inline;">
            <button type="submit" class="btn-admin @(c.IsActive ? "btn-admin-danger" : "btn-admin-primary")">
                <span class="material-symbols-outlined" style="font-size: 16px;">@(c.IsActive ? "pause" : "play_arrow")</span>
                @(c.IsActive ? "Deactivate Promo" : "Activate Promo")
            </button>
        </form>
    </div>
</div>

@* ── Top Metric Cards ── *@
<div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 24px;">
    <div class="stat-card">
        <div class="stat-icon-wrapper stat-icon-primary">
            <span class="material-symbols-outlined">percent</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Discount Value</span>
            <span class="stat-value">
                @(c.IsPercentage ? $"{c.DiscountPercentage:G29}%" : $"${c.DiscountAmount:N2}")
            </span>
            <span style="font-size: 11.5px; color: var(--admin-text-muted);">
                @(c.IsPercentage ? (c.DiscountPercentage >= 100m ? "Full 100% Free Waiver" : "Percentage Off") : "Fixed Dollar Reduction")
            </span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-wrapper stat-icon-success">
            <span class="material-symbols-outlined">redeem</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Times Redeemed</span>
            <span class="stat-value" style="color: var(--admin-success);">@c.TimesRedeemed.ToString("N0")</span>
            <span style="font-size: 11.5px; color: var(--admin-text-muted);">
                @(c.MaxRedemptions > 0 ? $"Of {c.MaxRedemptions:N0} max allowable cap" : "Unlimited allowable redemptions")
            </span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-wrapper" style="background: rgba(168, 85, 247, 0.15); color: #a855f7;">
            <span class="material-symbols-outlined">savings</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Total Granted Savings</span>
            <span class="stat-value" style="color: #a855f7;">$@Model.TotalDiscountsGranted.ToString("N2")</span>
            <span style="font-size: 11.5px; color: var(--admin-text-muted);">Across @Model.RedemptionsList.Count tenant checkouts</span>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon-wrapper stat-icon-info">
            <span class="material-symbols-outlined">tune</span>
        </div>
        <div class="stat-details">
            <span class="stat-label">Application Scope</span>
            <span class="stat-value" style="font-size: 16px;">
                @(c.SpecificFeature != null ? c.SpecificFeature.Name : "Universal")
            </span>
            <span style="font-size: 11.5px; color: var(--admin-text-muted);">
                @(c.SpecificFeature != null ? $"Restricted to {c.SpecificFeature.Category}" : "Applies across all platform subscriptions")
            </span>
        </div>
    </div>
</div>

@* ── Voucher Specification Card ── *@
<div class="admin-card" style="margin-bottom: 24px;">
    <div class="admin-card-header">
        <h2 class="admin-card-title">
            <span class="material-symbols-outlined" style="color: var(--admin-primary); font-size: 20px;">info</span>
            Voucher Specifications &amp; Timeline
        </h2>
    </div>
    <div class="admin-card-body">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
            <div>
                <div style="font-size: 12px; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Promo Code</div>
                <code style="font-size: 16px; font-weight: 800; color: var(--admin-primary); background: var(--admin-bg-surface-elevated); padding: 4px 10px; border-radius: 4px; border: 1px solid var(--admin-border);">
                    @c.Code
                </code>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Valid From</div>
                <div style="font-size: 14px; font-weight: 600; color: var(--admin-text);">
                    @c.StartsAtUtc.ToString("MMM dd, yyyy HH:mm") UTC
                </div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Expiration Date</div>
                <div style="font-size: 14px; font-weight: 600; color: var(--admin-text);">
                    @(c.ExpiresAtUtc.HasValue ? c.ExpiresAtUtc.Value.ToString("MMM dd, yyyy HH:mm") + " UTC" : "Never Expires (Perpetual)")
                </div>
            </div>
            <div>
                <div style="font-size: 12px; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Quota Consumed</div>
                @if (c.MaxRedemptions > 0)
                {
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="flex: 1; height: 8px; background: var(--admin-bg-hover); border-radius: 4px; overflow: hidden;">
                            <div style="width: @Model.QuotaConsumptionPercentage%; height: 100%; background: var(--admin-primary); border-radius: 4px;"></div>
                        </div>
                        <span style="font-size: 12.5px; font-weight: 700; color: var(--admin-text);">
                            @Model.QuotaConsumptionPercentage.ToString("F0")%
                        </span>
                    </div>
                }
                else
                {
                    <div style="font-size: 13.5px; color: var(--admin-success); font-weight: 600;">Unlimited Available</div>
                }
            </div>
        </div>
    </div>
</div>

@* ── Tenant Organizations Redemption Audit Trail ── *@
<div class="admin-card">
    <div class="admin-card-header">
        <h2 class="admin-card-title">
            <span class="material-symbols-outlined" style="color: var(--admin-primary); font-size: 20px;">history</span>
            Tenant Redemption Audit Trail (@Model.RedemptionsList.Count)
        </h2>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 50px; text-align: center;">S/N</th>
                    <th>Tenant Organization</th>
                    <th>Redeemed Feature / Plan</th>
                    <th>Original Price</th>
                    <th>Discount Applied</th>
                    <th>Net Amount Paid</th>
                    <th>Redeemed Date (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RedemptionsList.Any())
                {
                    @for (int i = 0; i < Model.RedemptionsList.Count; i++)
                    {
                        var r = Model.RedemptionsList[i];
                        <tr>
                            <td style="text-align: center;">
                                <span class="badge" style="background: var(--admin-bg-hover); color: var(--admin-text-muted); font-weight: 600;">@(i + 1)</span>
                            </td>
                            <td>
                                <div>
                                    <a href="/centralwks/tenants/details?id=@r.MasterTenantCatalogId" style="font-weight: 700; color: var(--admin-text); text-decoration: none;">
                                        @(r.MasterTenantCatalog?.OrganizationName ?? $"Tenant #{r.MasterTenantCatalogId}")
                                    </a>
                                    <div style="font-size: 11.5px; color: var(--admin-text-muted);">
                                        <code>@(r.MasterTenantCatalog?.TenantKey ?? "")</code>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (r.MasterFeatureCatalog != null)
                                {
                                    <span class="badge badge-neutral">@r.MasterFeatureCatalog.Name</span>
                                }
                                else
                                {
                                    <span class="badge badge-primary">Workspace Onboarding / Annual Base</span>
                                }
                            </td>
                            <td>
                                <span style="font-weight: 600; color: var(--admin-text-muted); text-decoration: line-through;">
                                    $@r.OriginalPrice.ToString("N2")
                                </span>
                            </td>
                            <td>
                                <span style="font-weight: 700; color: var(--admin-success);">
                                    -$@r.DiscountApplied.ToString("N2")
                                </span>
                            </td>
                            <td>
                                <span style="font-weight: 800; color: @(r.FinalPricePaid == 0 ? "var(--admin-success)" : "var(--admin-text)");">
                                    @(r.FinalPricePaid == 0 ? "$0.00 Free" : $"${r.FinalPricePaid:N2}")
                                </span>
                            </td>
                            <td>
                                <span style="font-size: 12.5px; color: var(--admin-text-muted);">
                                    @r.RedeemedAtUtc.ToString("MMM dd, yyyy HH:mm")
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="empty-state" style="padding: 36px; text-align: center;">
                                <div class="empty-state-icon" style="margin-bottom: 10px;">
                                    <span class="material-symbols-outlined" style="font-size: 36px; color: var(--admin-text-dim);">redeem</span>
                                </div>
                                <h3 class="empty-state-title">No Redemptions Yet</h3>
                                <p class="empty-state-desc" style="color: var(--admin-text-muted);">This promotional coupon has not been applied by any tenant organization yet.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
