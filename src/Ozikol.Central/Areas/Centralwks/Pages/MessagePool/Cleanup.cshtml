@page "/centralwks/message-pool/cleanup"
@model Ozikol.Central.Areas.Centralwks.Pages.MessagePool.CleanupModel
@{
    ViewData["Title"] = "Message Pool Cleanup & Purge";
    ViewData["BreadcrumbSection"] = "Support";
}

<div class="admin-page-header" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/message-pool" style="color: #64748b; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 13px;">
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span> Back to Message Pool
            </a>
        </div>
        <h1 class="admin-title" style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">Message Pool Cleanup &amp; Purge</h1>
        <p class="admin-subtitle" style="color: #64748b; font-size: 14px; margin: 0;">Inspect outbox queue volumes, view first &amp; last message timestamps, and safely delete records across all tenants or individual tenants by date range or all-time.</p>
    </div>
    <div class="admin-actions" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <button type="button" onclick="openPurgeModal('All', 'All Tenants (Platform-Wide)')" class="btn btn-sm" style="background: #dc2626; color: #ffffff; border: none; font-weight: 700; padding: 8px 16px; border-radius: 8px; font-size: 13px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; box-shadow: 0 2px 6px rgba(220,38,38,0.25);">
            <span class="material-symbols-outlined" style="font-size: 18px;">delete_sweep</span> Clear All Tenants
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var isAlertError = Model.StatusMessage.StartsWith("Error", StringComparison.OrdinalIgnoreCase);
    <div class="alert" style="background: @(isAlertError ? "#fef2f2" : "#f0fdf4"); border: 1px solid @(isAlertError ? "#fecaca" : "#bbf7d0"); color: @(isAlertError ? "#991b1b" : "#166534"); border-radius: 8px; padding: 12px 18px; margin-bottom: 20px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <span class="material-symbols-outlined" style="font-size: 20px;">@(isAlertError ? "error" : "check_circle")</span>
        @Model.StatusMessage
    </div>
}

@* ── Tenant Filter Bar ── *@
<form method="get" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 20px; display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 240px;">
        <label style="display: block; font-size: 11.5px; font-weight: 700; color: #475569; margin-bottom: 5px;">Tenant Filter</label>
        <select name="TenantFilter" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; height: 38px;">
            <option value="All" selected="@(string.IsNullOrWhiteSpace(Model.TenantFilter) || Model.TenantFilter.Equals("All", StringComparison.OrdinalIgnoreCase))">All Tenants (Platform-Wide Overview)</option>
            @foreach (var t in Model.Tenants)
            {
                <option value="@t.TenantKey" selected="@(string.Equals(Model.TenantFilter, t.TenantKey, StringComparison.OrdinalIgnoreCase))">@t.OrganizationName (@t.TenantKey)</option>
            }
        </select>
    </div>
    <div style="display: flex; gap: 8px;">
        <button type="submit" style="padding: 8px 18px; height: 38px; background: #0050e5; color: #ffffff; border: none; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer;">Apply Filter</button>
        <a href="/centralwks/message-pool/cleanup" style="padding: 8px 14px; height: 38px; box-sizing: border-box; background: #f1f5f9; color: #334155; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center;">Reset</a>
    </div>
</form>

@* ── Summary KPI Cards ── *@
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-bottom: 24px;">
    @* Total Messages *@
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; display: flex; align-items: center; gap: 16px;">
        <div style="width: 44px; height: 44px; border-radius: 10px; background: #eff6ff; color: #0050e5; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <span class="material-symbols-outlined" style="font-size: 22px;">all_inbox</span>
        </div>
        <div>
            <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">Total Messages</div>
            <div style="font-size: 24px; font-weight: 800; color: #0f172a; margin-top: 2px;">@Model.TotalMessageCount</div>
        </div>
    </div>

    @* First Message Date (Oldest) *@
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; display: flex; align-items: center; gap: 16px;">
        <div style="width: 44px; height: 44px; border-radius: 10px; background: #fefce8; color: #b45309; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <span class="material-symbols-outlined" style="font-size: 22px;">history</span>
        </div>
        <div>
            <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">Oldest (First) Date</div>
            <div style="font-size: 14px; font-weight: 700; color: #0f172a; margin-top: 4px;">
                @(Model.PlatformEarliestDate.HasValue ? Model.PlatformEarliestDate.Value.ToString("MMM dd, yyyy HH:mm") + " UTC" : "—")
            </div>
        </div>
    </div>

    @* Last Message Date (Newest) *@
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; display: flex; align-items: center; gap: 16px;">
        <div style="width: 44px; height: 44px; border-radius: 10px; background: #ecfdf5; color: #047857; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <span class="material-symbols-outlined" style="font-size: 22px;">update</span>
        </div>
        <div>
            <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">Newest (Last) Date</div>
            <div style="font-size: 14px; font-weight: 700; color: #0f172a; margin-top: 4px;">
                @(Model.PlatformLatestDate.HasValue ? Model.PlatformLatestDate.Value.ToString("MMM dd, yyyy HH:mm") + " UTC" : "—")
            </div>
        </div>
    </div>

    @* Status Breakdown *@
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px;">
        <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 6px;">Status Breakdown</div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; font-size: 11.5px; font-weight: 700;">
            <span style="background: #eff6ff; color: #0050e5; padding: 3px 8px; border-radius: 6px;">Queued: @Model.TotalQueuedCount</span>
            <span style="background: #ecfdf5; color: #047857; padding: 3px 8px; border-radius: 6px;">Sent: @Model.TotalSentCount</span>
            <span style="background: #fef2f2; color: #dc2626; padding: 3px 8px; border-radius: 6px;">Failed: @Model.TotalFailedCount</span>
        </div>
    </div>
</div>

@* ── Tenant Breakdown Table ── *@
<div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; margin-bottom: 24px;">
    <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; background: #f8fafc;">
        <div style="font-weight: 700; color: #0f172a; font-size: 14px;">Tenant Organizations Queue Metrics</div>
        <div style="font-size: 12px; color: #64748b;">Showing @Model.TenantStats.Count tenant(s)</div>
    </div>

    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
            <thead>
                <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; text-align: left; color: #475569; font-size: 11.5px; text-transform: uppercase;">
                    <th style="padding: 12px 14px; width: 44px; text-align: center;">#</th>
                    <th style="padding: 12px 14px;">Tenant Organization</th>
                    <th style="padding: 12px 14px; text-align: center;">Total Messages</th>
                    <th style="padding: 12px 14px;">Status Breakdown</th>
                    <th style="padding: 12px 14px;">First (Oldest) Message</th>
                    <th style="padding: 12px 14px;">Last (Newest) Message</th>
                    <th style="padding: 12px 14px; text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TenantStats.Count == 0)
                {
                    <tr>
                        <td colspan="7" style="padding: 32px; text-align: center; color: #94a3b8;">No active tenants found.</td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var stat in Model.TenantStats)
                    {
                        var escapedName = stat.OrganizationName.Replace("'", "\\'");
                        <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.12s ease;">
                            <td style="padding: 12px 14px; text-align: center; color: #94a3b8; font-weight: 600;">@index</td>
                            <td style="padding: 12px 14px;">
                                <div style="font-weight: 700; color: #0f172a;">@stat.OrganizationName</div>
                                <div style="font-size: 11.5px; color: #64748b; font-family: monospace;">@stat.TenantKey</div>
                            </td>
                            <td style="padding: 12px 14px; text-align: center;">
                                <span style="font-size: 14px; font-weight: 800; color: #0f172a;">@stat.TotalCount</span>
                            </td>
                            <td style="padding: 12px 14px;">
                                <div style="display: flex; gap: 6px; flex-wrap: wrap; font-size: 11px; font-weight: 600;">
                                    <span style="background: #eff6ff; color: #0050e5; padding: 2px 6px; border-radius: 4px;">Queued: @stat.QueuedCount</span>
                                    <span style="background: #ecfdf5; color: #047857; padding: 2px 6px; border-radius: 4px;">Sent: @stat.SentCount</span>
                                    <span style="background: #fef2f2; color: #dc2626; padding: 2px 6px; border-radius: 4px;">Failed: @stat.FailedCount</span>
                                </div>
                            </td>
                            <td style="padding: 12px 14px; font-size: 12px; color: #334155;">
                                @(stat.OldestMessageDate.HasValue ? stat.OldestMessageDate.Value.ToString("MMM dd, yyyy HH:mm") : "—")
                            </td>
                            <td style="padding: 12px 14px; font-size: 12px; color: #334155;">
                                @(stat.NewestMessageDate.HasValue ? stat.NewestMessageDate.Value.ToString("MMM dd, yyyy HH:mm") : "—")
                            </td>
                            <td style="padding: 12px 14px; text-align: right;">
                                <button type="button" onclick="openPurgeModal('@stat.TenantKey', '@escapedName (@stat.TenantKey)')" class="btn btn-sm" style="background: #ffffff; color: #dc2626; border: 1px solid #fca5a5; font-weight: 700; padding: 6px 12px; border-radius: 6px; font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                    <span class="material-symbols-outlined" style="font-size: 15px;">delete_sweep</span> Clear
                                </button>
                            </td>
                        </tr>
                        index++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Interactive Purge Modal (All-Time vs Date Range) ── *@
<div id="purgeModal" style="display: none; position: fixed; inset: 0; background: rgba(15,23,42,0.55); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #ffffff; border-radius: 14px; width: 100%; max-width: 540px; max-height: 90vh; overflow-y: auto; display: flex; flex-direction: column; box-shadow: 0 24px 48px rgba(15,23,42,0.2);">
        <form method="post" asp-page-handler="Clear">
            <input type="hidden" name="targetTenantKey" id="modalTargetTenantKey" value="All" />

            <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="color: #dc2626; font-size: 22px;">delete_sweep</span>
                    <h3 style="margin: 0; font-size: 17px; font-weight: 800; color: #0f172a;">Clear Message Pool</h3>
                </div>
                <button type="button" onclick="closePurgeModal()" style="background: #f1f5f9; border: none; border-radius: 8px; padding: 6px 12px; font-weight: 700; cursor: pointer; color: #334155; font-size: 12.5px;">Close</button>
            </div>

            <div style="padding: 20px; font-size: 13px;">
                @* Target Display Badge *@
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #64748b;">apartment</span>
                    <div>
                        <div style="font-size: 11px; color: #64748b; font-weight: 600;">TARGET SELECTION</div>
                        <div id="modalTargetDisplay" style="font-weight: 700; color: #0f172a; font-size: 13px;">All Tenants</div>
                    </div>
                </div>

                @* Purge Mode (All-Time vs Date Range) *@
                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-weight: 700; color: #334155; margin-bottom: 8px;">Deletion Mode</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <label style="display: flex; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; cursor: pointer; background: #ffffff;">
                            <input type="radio" name="purgeMode" value="all" onchange="toggleDateRangeSection(false)" checked />
                            <div>
                                <strong style="color: #0f172a; display: block;">All Time</strong>
                                <span style="font-size: 11px; color: #64748b;">Clear all matching history</span>
                            </div>
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; cursor: pointer; background: #ffffff;">
                            <input type="radio" name="purgeMode" value="range" onchange="toggleDateRangeSection(true)" />
                            <div>
                                <strong style="color: #0f172a; display: block;">Date Range</strong>
                                <span style="font-size: 11px; color: #64748b;">Specify From / To dates</span>
                            </div>
                        </label>
                    </div>
                </div>

                @* Date Range Selector (Hidden unless 'range' is selected) *@
                <div id="dateRangeSection" style="display: none; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; margin-bottom: 16px;">
                    <label style="display: block; font-weight: 700; color: #334155; margin-bottom: 8px;">Select Date Range (UTC)</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px;">
                        <div>
                            <span style="font-size: 11.5px; color: #64748b; display: block; margin-bottom: 4px;">From Date</span>
                            <input type="date" name="fromDate" id="modalFromDate" style="width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12.5px;" />
                        </div>
                        <div>
                            <span style="font-size: 11.5px; color: #64748b; display: block; margin-bottom: 4px;">To Date</span>
                            <input type="date" name="toDate" id="modalToDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" style="width: 100%; box-sizing: border-box; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 12.5px;" />
                        </div>
                    </div>
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <button type="button" onclick="setDatePreset(7)" style="padding: 3px 8px; font-size: 11px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; font-weight: 600; color: #475569;">Older than 7d</button>
                        <button type="button" onclick="setDatePreset(30)" style="padding: 3px 8px; font-size: 11px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; font-weight: 600; color: #475569;">Older than 30d</button>
                        <button type="button" onclick="setDatePreset(90)" style="padding: 3px 8px; font-size: 11px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; cursor: pointer; font-weight: 600; color: #475569;">Older than 90d</button>
                    </div>
                </div>

                @* Status Scope Selection *@
                <div style="margin-bottom: 18px;">
                    <label style="display: block; font-weight: 700; color: #334155; margin-bottom: 8px;">Status Scope</label>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <label style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer; background: #f8fafc;">
                            <input type="radio" name="clearScope" value="sent_failed" checked />
                            <div>
                                <strong style="color: #0f172a;">Sent &amp; Failed Messages</strong> (Recommended)
                                <div style="font-size: 11.5px; color: #64748b;">Cleans historical delivered items and permanent failures. Keeps <code style="color: #0050e5;">Queued</code> safe.</div>
                            </div>
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
                            <input type="radio" name="clearScope" value="sent" />
                            <div>
                                <strong style="color: #0f172a;">Sent Messages Only</strong>
                                <div style="font-size: 11.5px; color: #64748b;">Deletes only successfully delivered messages.</div>
                            </div>
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
                            <input type="radio" name="clearScope" value="failed" />
                            <div>
                                <strong style="color: #0f172a;">Failed Messages Only</strong>
                                <div style="font-size: 11.5px; color: #64748b;">Purges error/failed messages without touching delivered items.</div>
                            </div>
                        </label>
                        <label style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid #fecaca; border-radius: 8px; cursor: pointer; background: #fff5f5;">
                            <input type="radio" name="clearScope" value="all" />
                            <div>
                                <strong style="color: #dc2626;">Purge Entire Pool (Everything)</strong>
                                <div style="font-size: 11.5px; color: #991b1b;">Wipes all pool records including currently Queued items.</div>
                            </div>
                        </label>
                    </div>
                </div>

                @* Safety Notice *@
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; border-radius: 8px; padding: 10px 12px; font-size: 12px; line-height: 1.4; margin-bottom: 20px;">
                    <strong>In-App Notification Safety:</strong> Clearing the Message Pool only removes delivery queue records (<code style="background: #dcfce7; padding: 1px 4px; border-radius: 4px;">BcpMessagePools</code>). Users' topbar notification bells (<code style="background: #dcfce7; padding: 1px 4px; border-radius: 4px;">BcpNotifications</code>) remain completely untouched.
                </div>

                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button type="button" onclick="closePurgeModal()" style="padding: 8px 16px; background: #f1f5f9; color: #334155; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">Cancel</button>
                    <button type="submit" onclick="return confirm('Are you sure you want to permanently delete these message pool records?');" style="padding: 8px 18px; background: #dc2626; color: #ffffff; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                        <span class="material-symbols-outlined" style="font-size: 16px;">delete_forever</span> Confirm &amp; Delete
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openPurgeModal(tenantKey, tenantLabel) {
            document.getElementById('modalTargetTenantKey').value = tenantKey || 'All';
            document.getElementById('modalTargetDisplay').textContent = tenantLabel || (tenantKey === 'All' ? 'All Tenants (Platform-Wide)' : tenantKey);
            
            // Reset to All-Time by default
            const allRadio = document.querySelector('input[name="purgeMode"][value="all"]');
            if (allRadio) allRadio.checked = true;
            toggleDateRangeSection(false);

            document.getElementById('purgeModal').style.display = 'flex';
        }

        function closePurgeModal() {
            document.getElementById('purgeModal').style.display = 'none';
        }

        function toggleDateRangeSection(show) {
            const section = document.getElementById('dateRangeSection');
            if (section) {
                section.style.display = show ? 'block' : 'none';
            }
        }

        function setDatePreset(daysAgo) {
            const to = new Date();
            to.setDate(to.getDate() - daysAgo);
            const toStr = to.toISOString().split('T')[0];
            
            // End date is daysAgo, start date is 1 year prior
            const from = new Date(to);
            from.setFullYear(from.getFullYear() - 1);
            const fromStr = from.toISOString().split('T')[0];

            document.getElementById('modalFromDate').value = fromStr;
            document.getElementById('modalToDate').value = toStr;
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closePurgeModal();
            }
        });
    </script>
}
