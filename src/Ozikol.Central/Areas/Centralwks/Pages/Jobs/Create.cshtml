@page "/centralwks/jobs/create"
@model Ozikol.Central.Areas.Centralwks.Pages.Jobs.CreateModel
@{
    ViewData["Title"] = "Register Background Job";
    ViewData["BreadcrumbSection"] = "System";
}

<div class="admin-page-header" style="width: 100%; margin-bottom: 24px;">
    <div class="admin-title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
            <a href="/centralwks/jobs" class="btn-admin btn-admin-secondary" style="padding: 4px 10px; font-size: 12px; text-decoration: none;">
                <span class="material-symbols-outlined" style="font-size: 16px;">arrow_back</span> Back to Jobs
            </a>
        </div>
        <h1 class="admin-title" style="display: flex; align-items: center; gap: 10px;">
            <span class="material-symbols-outlined" style="font-size: 28px; color: var(--admin-primary);">add_task</span>
            Register Background Job
        </h1>
        <p class="admin-subtitle">Configure and schedule a new automated worker for Central platform tasks or isolated Tenant organizations.</p>
    </div>
</div>

<form method="post" style="width: 100%;">
    @Html.AntiForgeryToken()
    <div style="display: flex; flex-direction: column; gap: 24px; width: 100%;">

        <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert-danger" role="alert" style="margin-bottom: 0;"></div>

        @* Handler Quick-Select Template *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); padding: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                <label style="font-size: 13.5px; font-weight: 700; color: var(--admin-text); margin: 0; display: flex; align-items: center; gap: 6px;">
                    <span class="material-symbols-outlined" style="font-size: 20px; color: #2563eb;">auto_fix_high</span>
                    Quick-Fill from Registered Handler Template
                </label>
                <span style="font-size: 12px; color: var(--admin-text-muted);">Auto-populates handler defaults &amp; intervals</span>
            </div>
            <select id="handlerTemplateSelect" onchange="applyHandlerTemplate(this)" class="form-select" style="font-size: 13px; padding: 10px 14px; border-radius: var(--radius-md); border: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated); color: var(--admin-text);">
                <option value="">-- Choose a pre-built handler template --</option>
                @foreach (var handler in Model.AvailableHandlers)
                {
                    <option value="@handler.JobKey" 
                            data-name="@handler.DisplayName" 
                            data-desc="@handler.Description" 
                            data-cat="@handler.Category" 
                            data-scope="@((int)handler.Scope)" 
                            data-interval="@handler.DefaultIntervalSeconds">
                        [@handler.Scope] @handler.DisplayName (@handler.JobKey)
                    </option>
                }
            </select>
        </div>

        @* Section 1: Basic Information *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden;">
            <div style="padding: 16px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <h2 style="font-size: 15px; font-weight: 600; color: var(--admin-text); margin: 0;">1. Job Identification &amp; Handler Key</h2>
            </div>
            <div style="padding: 24px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
                    <div>
                        <label asp-for="Input.Name" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Job Display Name <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="Input.Name" id="inputJobName" class="form-control" placeholder="e.g. Nightly Tenant Activity Sync" required 
                               style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.Name" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="Input.JobKey" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Handler Unique Key <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <input asp-for="Input.JobKey" id="inputJobKey" class="form-control" placeholder="e.g. tenant.daily-digest" required 
                               style="font-family: monospace; background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.JobKey" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                        <span style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Must match a registered IBackgroundJobHandler key in the system.</span>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                    <div>
                        <label asp-for="Input.Category" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Category
                        </label>
                        <input asp-for="Input.Category" id="inputJobCategory" class="form-control" placeholder="e.g. Tenant Operations" 
                               style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.Category" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="Input.Description" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Description
                        </label>
                        <input asp-for="Input.Description" id="inputJobDesc" class="form-control" placeholder="e.g. Aggregates daily telemetry and activity summaries" 
                               style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.Description" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>
                </div>
            </div>
        </div>

        @* Section 2: Operational Scope & Target *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden;">
            <div style="padding: 16px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <h2 style="font-size: 15px; font-weight: 600; color: var(--admin-text); margin: 0;">2. Scope &amp; Target Tenant Organization</h2>
            </div>
            <div style="padding: 24px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
                    <div>
                        <label asp-for="Input.Scope" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Job Scope <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <select asp-for="Input.Scope" id="selectJobScope" onchange="onScopeChanged(this)" class="form-select" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border); color: var(--admin-text);">
                            <option value="@((int)Ozikol.MasterDomain.Models.BackgroundJobScope.Central)">Central Platform System Job</option>
                            <option value="@((int)Ozikol.MasterDomain.Models.BackgroundJobScope.Tenant)">Tenant Project Job</option>
                        </select>
                        <span asp-validation-for="Input.Scope" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div id="tenantTargetGroup">
                        <label asp-for="Input.TargetTenantCatalogId" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Target Tenant Organization
                        </label>
                        <select asp-for="Input.TargetTenantCatalogId" asp-items="Model.TenantOptions" id="selectTargetTenant" class="form-select" style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border); color: var(--admin-text);">
                        </select>
                        <span asp-validation-for="Input.TargetTenantCatalogId" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                        <span style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Select 'All Active Tenants' to execute across every tenant.</span>
                    </div>
                </div>
            </div>
        </div>

        @* Section 3: Schedule & Interval *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); overflow: hidden;">
            <div style="padding: 16px 24px; border-bottom: 1px solid var(--admin-border); background: var(--admin-bg-surface-elevated);">
                <h2 style="font-size: 15px; font-weight: 600; color: var(--admin-text); margin: 0;">3. Schedule &amp; Execution Frequency</h2>
            </div>
            <div style="padding: 24px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 20px;">
                    <div>
                        <label asp-for="Input.IntervalSeconds" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Interval (Seconds) <span style="color: var(--admin-danger);">*</span>
                        </label>
                        <div style="display: flex; gap: 8px;">
                            <input asp-for="Input.IntervalSeconds" id="inputIntervalSeconds" type="number" min="30" class="form-control" placeholder="e.g. 3600" required 
                                   style="background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                            <select onchange="applyIntervalPreset(this)" class="form-select" style="width: 160px; font-size: 12.5px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border); color: var(--admin-text);">
                                <option value="">Presets...</option>
                                <option value="300">Every 5 Mins</option>
                                <option value="900">Every 15 Mins</option>
                                <option value="1800">Every 30 Mins</option>
                                <option value="3600">Hourly (1h)</option>
                                <option value="21600">Every 6 Hours</option>
                                <option value="43200">Every 12 Hours</option>
                                <option value="86400">Daily (24h)</option>
                            </select>
                        </div>
                        <span asp-validation-for="Input.IntervalSeconds" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                    </div>

                    <div>
                        <label asp-for="Input.ScheduleCron" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                            Cron Schedule (Optional)
                        </label>
                        <input asp-for="Input.ScheduleCron" class="form-control" placeholder="e.g. 0 * * * * or leave blank" 
                               style="font-family: monospace; background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" />
                        <span asp-validation-for="Input.ScheduleCron" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                        <span style="font-size: 11.5px; color: var(--admin-text-muted); margin-top: 4px; display: block;">Optional 5-part cron syntax (minute hour day month day-of-week).</span>
                    </div>
                </div>

                <div>
                    <label asp-for="Input.JobParametersJson" style="display: block; font-size: 13px; font-weight: 600; color: var(--admin-text); margin-bottom: 8px;">
                        Job Runtime Parameters (JSON)
                    </label>
                    <textarea asp-for="Input.JobParametersJson" rows="3" class="form-control" style="font-family: monospace; font-size: 12.5px; background: var(--admin-bg-surface); border: 1px solid var(--admin-border);" placeholder='e.g. { "batchSize": 100, "dryRun": false }'></textarea>
                    <span asp-validation-for="Input.JobParametersJson" style="color: var(--admin-danger); font-size: 12px; margin-top: 4px; display: block;"></span>
                </div>
            </div>
        </div>

        @* Immediate Activation *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; padding: 18px 24px; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); display: flex; align-items: center; gap: 12px;">
            <input asp-for="Input.IsEnabled" type="checkbox" id="checkIsEnabled" class="form-check-input" style="width: 18px; height: 18px; accent-color: var(--admin-primary); cursor: pointer;" checked />
            <div>
                <label for="checkIsEnabled" style="font-size: 13.5px; font-weight: 600; color: var(--admin-text); margin: 0; cursor: pointer;">
                    Activate and schedule this background job immediately upon creation
                </label>
                <span style="font-size: 12px; color: var(--admin-text-muted); display: block; margin-top: 2px;">When checked, the job scheduler will automatically queue the initial run.</span>
            </div>
        </div>

        @* Submit Buttons Footer *@
        <div class="admin-card" style="width: 100%; margin-bottom: 0; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; background: var(--admin-bg-surface-elevated); border: 1px solid var(--admin-border); border-radius: var(--radius-lg); flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--admin-text-muted);">
                <span class="material-symbols-outlined" style="font-size: 18px; color: var(--admin-text-dim);">schedule</span>
                <span>Job execution logs and telemetry will be recorded after each automated or manual run.</span>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="/centralwks/jobs" class="btn-admin btn-admin-secondary" style="padding: 10px 22px; font-size: 13.5px;">Cancel</a>
                <button type="submit" class="btn-admin btn-admin-primary" style="padding: 10px 28px; font-size: 13.5px;">
                    <span class="material-symbols-outlined" style="font-size: 18px;">save</span>
                    Register Background Job
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function applyHandlerTemplate(select) {
            const opt = select.options[select.selectedIndex];
            if (!opt || !opt.value) return;

            document.getElementById('inputJobKey').value = opt.value;
            document.getElementById('inputJobName').value = opt.dataset.name || '';
            document.getElementById('inputJobDesc').value = opt.dataset.desc || '';
            document.getElementById('inputJobCategory').value = opt.dataset.cat || '';
            
            if (opt.dataset.interval) {
                document.getElementById('inputIntervalSeconds').value = opt.dataset.interval;
            }

            if (opt.dataset.scope) {
                const scopeSelect = document.getElementById('selectJobScope');
                scopeSelect.value = opt.dataset.scope;
                onScopeChanged(scopeSelect);
            }
        }

        function onScopeChanged(select) {
            const tenantGroup = document.getElementById('tenantTargetGroup');
            if (select.value === '2') {
                tenantGroup.style.display = 'block';
            } else {
                tenantGroup.style.display = 'block';
            }
        }

        function applyIntervalPreset(select) {
            if (select.value) {
                document.getElementById('inputIntervalSeconds').value = select.value;
            }
        }
    </script>
}
