@page "/vouchers/apply"
@model Ozikol.Central.Pages.Vouchers.ApplyModel
@{
    ViewData["Title"] = SharedLocalizer["Voucher_Page_Title"].Value;
    var currentCulture = Model.CurrentCulture;
}

<div class="oz-corp-page" style="min-height: 100vh; padding-bottom: 80px;">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-corp-container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@currentCulture">@SharedLocalizer["Breadcrumb_Home"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/@currentCulture/pricing">@SharedLocalizer["Nav_Pricing"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@SharedLocalizer["Voucher_Breadcrumb_Title"]</span>
                </div>
                <a href="/@currentCulture/pricing" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>@SharedLocalizer["Voucher_Btn_BackToPricing"]</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Header (Standard Corporate Light Theme) -->
    <section class="oz-corp-banner">
        <div class="oz-corp-banner-wrap">
            <div class="oz-corp-badge">
                <span class="oz-corp-badge-dot"></span>
                @SharedLocalizer["Voucher_Hero_Badge"]
            </div>
            <h1 class="oz-corp-title">
                @SharedLocalizer["Voucher_Hero_Title"]
            </h1>
            <p class="oz-corp-lead">
                @SharedLocalizer["Voucher_Hero_Lead"]
            </p>
        </div>
    </section>

    <!-- Main Content Container -->
    <main class="oz-corp-container oz-corp-section" style="max-width: 900px; margin: 0 auto; padding-top: 36px;">
        @if (Model.IsSuccess)
        {
            <!-- Application Success State -->
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 48px 32px; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
                <div style="width: 72px; height: 72px; background: #ecfdf5; border: 2px solid #a7f3d0; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <span class="material-symbols-outlined" style="font-size: 38px; color: #059669;">check_circle</span>
                </div>
                <h2 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0 0 10px;">@SharedLocalizer["Voucher_Success_Title"]</h2>
                <p style="font-size: 15px; color: #64748b; max-width: 580px; margin: 0 auto 24px; line-height: 1.6;">
                    @SharedLocalizer["Voucher_Success_Desc"]
                </p>

                <div style="background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 12px; padding: 20px; max-width: 440px; margin: 0 auto 32px; text-align: center;">
                    <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">@SharedLocalizer["Voucher_Success_RefLabel"]</div>
                    <div style="font-size: 28px; font-weight: 900; color: #0f172a; letter-spacing: 2px; font-family: monospace; margin-top: 4px;">@Model.SubmittedReferenceNumber</div>
                    <div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">@SharedLocalizer["Voucher_Success_EmailNotice"]</div>
                </div>

                <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
                    <a href="/@currentCulture" style="display: inline-flex; align-items: center; gap: 8px; background: #0f172a; color: #ffffff; padding: 12px 28px; border-radius: 8px; font-weight: 700; font-size: 14px; text-decoration: none;">
                        @SharedLocalizer["Voucher_Success_BtnHome"]
                    </a>
                    <a href="/@currentCulture/pricing" style="display: inline-flex; align-items: center; gap: 8px; background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; padding: 12px 28px; border-radius: 8px; font-weight: 700; font-size: 14px; text-decoration: none;">
                        @SharedLocalizer["Voucher_Success_BtnPricing"] &rarr;
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Application Form -->
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 36px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
                
                <!-- Notice Banner: How It Works -->
                <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 12px; padding: 20px; margin-bottom: 32px;">
                    <div style="display: flex; align-items: flex-start; gap: 14px;">
                        <span class="material-symbols-outlined" style="font-size: 28px; color: #2563eb; margin-top: 2px;">info</span>
                        <div style="flex: 1;">
                            <h3 style="font-size: 16px; font-weight: 800; color: #1e3a8a; margin: 0 0 4px;">@SharedLocalizer["Voucher_Notice_Title"]</h3>
                            <p style="font-size: 13.5px; color: #3b82f6; line-height: 1.5; margin: 0;">
                                @SharedLocalizer["Voucher_Notice_Desc"]
                            </p>
                        </div>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div style="background: #fef2f2; border: 1.5px solid #fecaca; border-radius: 10px; padding: 16px 20px; margin-bottom: 24px; color: #b91c1c;">
                        <div asp-validation-summary="All" style="font-size: 13.5px; font-weight: 600; margin: 0; padding-left: 20px;"></div>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <!-- SECTION 1: Organization & Contact Profile -->
                    <div style="margin-bottom: 36px;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 12px;">
                            <div style="width: 32px; height: 32px; background: #0f172a; color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;">1</div>
                            <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">@SharedLocalizer["Voucher_Section1_Title"]</h2>
                        </div>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
                            <div>
                                <label asp-for="Input.FullName" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">@SharedLocalizer["Voucher_Field_FullName"]</label>
                                <input asp-for="Input.FullName" placeholder="@SharedLocalizer["Voucher_Field_FullName_Placeholder"]" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" required />
                                <span asp-validation-for="Input.FullName" style="color: #ef4444; font-size: 12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Input.WorkEmail" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">@SharedLocalizer["Voucher_Field_Email"]</label>
                                <input asp-for="Input.WorkEmail" type="email" placeholder="@SharedLocalizer["Voucher_Field_Email_Placeholder"]" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" required />
                                <span asp-validation-for="Input.WorkEmail" style="color: #ef4444; font-size: 12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Input.OrganizationName" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">@SharedLocalizer["Voucher_Field_OrgName"]</label>
                                <input asp-for="Input.OrganizationName" placeholder="@SharedLocalizer["Voucher_Field_OrgName_Placeholder"]" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" required />
                                <span asp-validation-for="Input.OrganizationName" style="color: #ef4444; font-size: 12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Input.PhoneNumber" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">@SharedLocalizer["Voucher_Field_Phone"]</label>
                                <input asp-for="Input.PhoneNumber" placeholder="@SharedLocalizer["Voucher_Field_Phone_Placeholder"]" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
                            </div>

                            <div style="grid-column: 1 / -1;">
                                <label asp-for="Input.WorkspaceSlug" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">@SharedLocalizer["Voucher_Field_Subdomain"]</label>
                                <div style="display: flex; align-items: center; border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; background: #ffffff;">
                                    <span style="background: #f1f5f9; padding: 11px 14px; font-size: 13px; color: #64748b; font-weight: 600; border-right: 1px solid #cbd5e1;">https://</span>
                                    <input asp-for="Input.WorkspaceSlug" placeholder="@SharedLocalizer["Voucher_Field_Subdomain_Placeholder"]" style="flex: 1; padding: 11px 14px; border: none; font-size: 14px; outline: none;" />
                                    <span style="background: #f1f5f9; padding: 11px 14px; font-size: 13px; color: #64748b; font-weight: 600; border-left: 1px solid #cbd5e1;">.ozikol.cloud</span>
                                </div>
                                <div style="font-size: 11.5px; color: #94a3b8; margin-top: 4px;">@SharedLocalizer["Voucher_Field_SubdomainHelp"]</div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: Mandatory Social Media Engagement Tasks -->
                    <div style="margin-bottom: 36px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <div style="width: 32px; height: 32px; background: #0f172a; color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;">2</div>
                                <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">@SharedLocalizer["Voucher_Section2_Title"]</h2>
                            </div>
                            <span id="taskProgressBadge" style="font-size: 12px; color: #059669; font-weight: 800; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 4px 12px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 6px;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">task_alt</span>
                                <span id="taskProgressText">0 / 6 Tasks</span>
                            </span>
                        </div>

                        <!-- Animated Progress Bar -->
                        <div style="width: 100%; height: 6px; background: #e2e8f0; border-radius: 9999px; margin-bottom: 16px; overflow: hidden;">
                            <div id="taskProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #10b981 0%, #059669 100%); transition: width 0.4s ease;"></div>
                        </div>

                        <p style="font-size: 13.5px; color: #64748b; margin: 0 0 20px 0; line-height: 1.5;">
                            @SharedLocalizer["Voucher_Section2_Subtitle"]
                        </p>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
                            
                            <!-- 1. X / Twitter -->
                            <div id="card-twitter" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; background: #000000; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                            <svg width="17" height="17" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                        </div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">X (Twitter)</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.TwitterHandle</div>
                                        </div>
                                    </div>
                                    <a id="btn-twitter" href="@Model.CommunityLinks.TwitterUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('twitter')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #0f172a; padding: 7px 14px; border-radius: 7px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                                        <span>@SharedLocalizer["Voucher_Btn_Follow"]</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.TwitterHandle" id="input-twitter" oninput="checkTaskInput('twitter')" placeholder="@("@username")" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 2. LinkedIn -->
                            <div id="card-linkedin" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; background: #0a66c2; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 0 0-1.66 1.64 1.65 1.65 0 0 0 1.66 1.65 1.65 1.65 0 0 0 1.66-1.65c0-.9-.74-1.64-1.66-1.64z"/></svg>
                                        </div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">LinkedIn</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.LinkedInName</div>
                                        </div>
                                    </div>
                                    <a id="btn-linkedin" href="@Model.CommunityLinks.LinkedInUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('linkedin')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #0a66c2; padding: 7px 14px; border-radius: 7px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                                        <span>@SharedLocalizer["Voucher_Btn_Follow"]</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.LinkedInProfile" id="input-linkedin" oninput="checkTaskInput('linkedin')" placeholder="e.g. linkedin.com/in/username" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 3. YouTube -->
                            <div id="card-youtube" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; background: #ff0000; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                        </div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">YouTube</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.YouTubeName</div>
                                        </div>
                                    </div>
                                    <a id="btn-youtube" href="@Model.CommunityLinks.YouTubeUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('youtube')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #ff0000; padding: 7px 14px; border-radius: 7px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                                        <span>@SharedLocalizer["Voucher_Btn_Subscribe"]</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.YouTubeHandle" id="input-youtube" oninput="checkTaskInput('youtube')" placeholder="@("@channelname")" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 4. Facebook -->
                            <div id="card-facebook" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; background: #1877f2; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                                        </div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">Facebook</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.FacebookName</div>
                                        </div>
                                    </div>
                                    <a id="btn-facebook" href="@Model.CommunityLinks.FacebookUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('facebook')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #1877f2; padding: 7px 14px; border-radius: 7px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                                        <span>@SharedLocalizer["Voucher_Btn_Follow"]</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.FacebookProfile" id="input-facebook" oninput="checkTaskInput('facebook')" placeholder="e.g. facebook.com/profile" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 5. Instagram -->
                            <div id="card-instagram" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                                        </div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">Instagram</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.InstagramName</div>
                                        </div>
                                    </div>
                                    <a id="btn-instagram" href="@Model.CommunityLinks.InstagramUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('instagram')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #e1306c; padding: 7px 14px; border-radius: 7px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                                        <span>@SharedLocalizer["Voucher_Btn_Follow"]</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.InstagramHandle" id="input-instagram" oninput="checkTaskInput('instagram')" placeholder="@("@username")" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 6. Snapchat -->
                            <div id="card-snapchat" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 34px; height: 34px; background: #fffc00; color: #000000; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid #e2e8f0;">
                                            <svg width="19" height="19" fill="currentColor" viewBox="0 0 24 24"><path d="M12.003 2c-3.14 0-5.405 2.146-5.484 5.342-.036 1.43.377 2.68.742 3.486.134.296.223.49.198.586-.037.14-.236.257-.597.35-1.042.268-1.898.718-2.032 1.474-.085.48.243.914.81 1.25.688.406 1.637.587 2.062 1.096.23.276.126.697.051.996-.06.238-.117.464-.06.666.088.31.393.513.784.513.25 0 .54-.083.876-.25.597-.297 1.344-.668 2.65-.668 1.306 0 2.053.37 2.65.668.336.167.626.25.876.25.391 0 .696-.203.784-.513.057-.202 0-.428-.06-.666-.075-.3-.18-.72.051-.996.425-.509 1.374-.69 2.062-1.096.567-.336.895-.77.81-1.25-.134-.756-.99-1.206-2.032-1.474-.361-.093-.56-.21-.597-.35-.025-.096.064-.29.198-.586.365-.806.778-2.056.742-3.486C17.408 4.146 15.143 2 12.003 2z"/></svg>
                                        </div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">Snapchat</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.SnapchatName</div>
                                        </div>
                                    </div>
                                    <a id="btn-snapchat" href="@Model.CommunityLinks.SnapchatUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('snapchat')" style="font-size: 12px; font-weight: 700; color: #0f172a; background: #fffc00; border: 1px solid #cbd5e1; padding: 7px 14px; border-radius: 7px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                                        <span>@SharedLocalizer["Voucher_Btn_Add"]</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.SnapchatHandle" id="input-snapchat" oninput="checkTaskInput('snapchat')" placeholder="e.g. username" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                        </div>
                    </div>

                    <!-- SECTION 3: Additional Notes & Consent -->
                    <div style="margin-bottom: 32px;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 12px;">
                            <div style="width: 32px; height: 32px; background: #0f172a; color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;">3</div>
                            <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">@SharedLocalizer["Voucher_Section3_Title"]</h2>
                        </div>

                        <div style="margin-bottom: 16px;">
                            <label asp-for="Input.Remarks" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">@SharedLocalizer["Voucher_Field_Remarks"]</label>
                            <textarea asp-for="Input.Remarks" rows="3" placeholder="@SharedLocalizer["Voucher_Field_Remarks_Placeholder"]" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
                        </div>

                        <div style="display: flex; align-items: center; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px 16px; border-radius: 8px;">
                            <input asp-for="Input.IsNewsletterSubscribed" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--ozikol-primary);" />
                            <label asp-for="Input.IsNewsletterSubscribed" style="font-size: 13.5px; font-weight: 600; color: #334155; cursor: pointer; margin: 0;">
                                @SharedLocalizer["Voucher_Field_Newsletter"]
                            </label>
                        </div>
                    </div>

                    <!-- Submit Action Button -->
                    <button type="submit" id="submitBtn" style="width: 100%; background: #d97706; color: #ffffff; font-size: 16px; font-weight: 800; padding: 16px; border: none; border-radius: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px rgba(217, 119, 6, 0.25); transition: background 0.15s ease;">
                        <span class="material-symbols-outlined" style="font-size: 22px;">card_giftcard</span>
                        <span>@SharedLocalizer["Voucher_Btn_Submit"] &rarr;</span>
                    </button>
                </form>

            </div>
        }
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const completedTasks = new Set();
        let pendingTask = null;

        function trackTaskClick(taskName) {
            pendingTask = taskName;
        }

        // Detect window return / focus event (Gleam-style auto-verification)
        function handleTabReturn() {
            if (pendingTask) {
                markTaskAsCompleted(pendingTask);
                pendingTask = null;
            }
        }

        window.addEventListener('focus', handleTabReturn);
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
                handleTabReturn();
            }
        });

        function markTaskAsCompleted(taskName) {
            completedTasks.add(taskName);

            const card = document.getElementById(`card-${taskName}`);
            const btn = document.getElementById(`btn-${taskName}`);
            const input = document.getElementById(`input-${taskName}`);

            if (card) {
                card.style.background = '#f0fdf4';
                card.style.borderColor = '#10b981';
                card.style.boxShadow = '0 0 0 2px rgba(16, 185, 129, 0.15)';
            }

            if (btn) {
                btn.style.background = '#10b981';
                btn.style.color = '#ffffff';
                btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px;">check_circle</span> <span>Done</span>';
            }

            if (input && !input.value.trim()) {
                input.focus();
            }

            updateTaskProgress();
        }

        function checkTaskInput(taskName) {
            const input = document.getElementById(`input-${taskName}`);
            if (input && input.value.trim().length > 0) {
                markTaskAsCompleted(taskName);
            }
        }

        function updateTaskProgress() {
            const totalTasks = 6;
            const count = completedTasks.size;
            const percentage = Math.min(100, Math.round((count / totalTasks) * 100));

            const progressText = document.getElementById('taskProgressText');
            const progressBar = document.getElementById('taskProgressBar');
            const progressBadge = document.getElementById('taskProgressBadge');

            if (progressText) {
                progressText.innerText = `${count} of ${totalTasks} Tasks Completed`;
            }

            if (progressBar) {
                progressBar.style.width = `${percentage}%`;
            }

            if (count >= 2 && progressBadge) {
                progressBadge.style.background = '#ecfdf5';
                progressBadge.style.borderColor = '#10b981';
                progressBadge.style.color = '#047857';
            }
        }
    </script>
}
