@page "/vouchers/apply"
@model Ozikol.Central.Pages.Vouchers.ApplyModel
@{
    ViewData["Title"] = "Apply for Free 1-Year Promotional Voucher | Ozikol";
}

<div class="oz-corp-page" style="background: #f8fafc; min-height: 100vh; padding-bottom: 80px;">
    <!-- Hero Header -->
    <section class="oz-corp-banner" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff; padding: 60px 20px; text-align: center;">
        <div style="max-width: 800px; margin: 0 auto;">
            <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(245, 158, 11, 0.15); border: 1px solid #f59e0b; color: #fbbf24; padding: 6px 18px; border-radius: 9999px; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 16px;">
                <span class="material-symbols-outlined" style="font-size: 18px;">card_giftcard</span>
                <span>Community Empowerment Program</span>
            </div>
            <h1 style="font-size: 34px; font-weight: 900; line-height: 1.25; margin: 0 0 16px; color: #ffffff; letter-spacing: -0.5px;">
                Apply for a Free 1-Year Promotional Voucher
            </h1>
            <p style="font-size: 16px; color: #94a3b8; line-height: 1.6; margin: 0; max-width: 680px; margin: 0 auto;">
                Empower your organization with sovereign cloud infrastructure. Complete our community engagement steps below to receive a 100% discount promotional voucher for your workspace.
            </p>
        </div>
    </section>

    <!-- Main Content Container -->
    <main style="max-width: 900px; margin: -30px auto 0; padding: 0 20px;">
        @if (Model.IsSuccess)
        {
            <!-- Application Success State -->
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 48px 32px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
                <div style="width: 72px; height: 72px; background: #ecfdf5; border: 2px solid #a7f3d0; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <span class="material-symbols-outlined" style="font-size: 38px; color: #059669;">check_circle</span>
                </div>
                <h2 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0 0 10px;">Application Submitted Successfully!</h2>
                <p style="font-size: 15px; color: #64748b; max-width: 580px; margin: 0 auto 24px; line-height: 1.6;">
                    Thank you for applying for the Ozikol Free 1-Year Promotional Voucher. Our partnership team is verifying your community engagement activity and will dispatch your voucher code via email shortly.
                </p>

                <div style="background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 12px; padding: 20px; max-width: 440px; margin: 0 auto 32px; text-align: center;">
                    <div style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px;">Your Application Reference:</div>
                    <div style="font-size: 28px; font-weight: 900; color: #0f172a; letter-spacing: 2px; font-family: monospace; margin-top: 4px;">@Model.SubmittedReferenceNumber</div>
                    <div style="font-size: 12px; color: #94a3b8; margin-top: 4px;">A confirmation receipt has been dispatched to your email address.</div>
                </div>

                <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
                    <a href="/" style="display: inline-flex; align-items: center; gap: 8px; background: #0f172a; color: #ffffff; padding: 12px 28px; border-radius: 8px; font-weight: 700; font-size: 14px; text-decoration: none;">
                        Return to Homepage
                    </a>
                    <a href="/auth/get-started" style="display: inline-flex; align-items: center; gap: 8px; background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; padding: 12px 28px; border-radius: 8px; font-weight: 700; font-size: 14px; text-decoration: none;">
                        Explore Workspace Onboarding &rarr;
                    </a>
                </div>
            </div>
        }
        else
        {
            <!-- Application Form -->
            <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 36px; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
                
                <!-- Notice Banner: How It Works -->
                <div style="background: #eff6ff; border: 1.5px solid #bfdbfe; border-radius: 12px; padding: 20px; margin-bottom: 32px;">
                    <div style="display: flex; align-items: flex-start; gap: 14px;">
                        <span class="material-symbols-outlined" style="font-size: 28px; color: #2563eb; margin-top: 2px;">info</span>
                        <div style="flex: 1;">
                            <h3 style="font-size: 16px; font-weight: 800; color: #1e3a8a; margin: 0 0 4px;">How the 1-Year Voucher Program Works</h3>
                            <p style="font-size: 13.5px; color: #3b82f6; line-height: 1.5; margin: 0;">
                                We support growing organizations, startups, and community builders. Follow our official community accounts, enter your public handles/links for verification, and our team will issue an official 100% discount voucher covering your workspace capabilities.
                            </p>
                        </div>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div style="background: #fef2f2; border: 1.5px solid #fecaca; border-radius: 10px; padding: 16px 20px; margin-bottom: 24px; color: #b91c1c;">
                        <div asp-validation-summary="All" style="font-size: 13.5px; font-weight: 600; margin: 0; padding-left: 20px;"></div>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <!-- SECTION 1: Organization & Contact Profile -->
                    <div style="margin-bottom: 36px;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 12px;">
                            <div style="width: 32px; height: 32px; background: #0f172a; color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;">1</div>
                            <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">Organization & Administrator Information</h2>
                        </div>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
                            <div>
                                <label asp-for="Input.FullName" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">Full Name *</label>
                                <input asp-for="Input.FullName" placeholder="e.g. John Doe" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" required />
                                <span asp-validation-for="Input.FullName" style="color: #ef4444; font-size: 12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Input.WorkEmail" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">Work Email Address *</label>
                                <input asp-for="Input.WorkEmail" type="email" placeholder="name@company.com" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" required />
                                <span asp-validation-for="Input.WorkEmail" style="color: #ef4444; font-size: 12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Input.OrganizationName" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">Organization / Company Name *</label>
                                <input asp-for="Input.OrganizationName" placeholder="e.g. Acme Corporation" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" required />
                                <span asp-validation-for="Input.OrganizationName" style="color: #ef4444; font-size: 12px;"></span>
                            </div>

                            <div>
                                <label asp-for="Input.PhoneNumber" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">Contact Phone Number</label>
                                <input asp-for="Input.PhoneNumber" placeholder="e.g. +1 (555) 000-0000" style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
                            </div>

                            <div style="grid-column: 1 / -1;">
                                <label asp-for="Input.WorkspaceSlug" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">Target Workspace Domain (Optional)</label>
                                <div style="display: flex; align-items: center; border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; background: #ffffff;">
                                    <span style="background: #f1f5f9; padding: 11px 14px; font-size: 13px; color: #64748b; font-weight: 600; border-right: 1px solid #cbd5e1;">https://</span>
                                    <input asp-for="Input.WorkspaceSlug" placeholder="e.g. mycompany" style="flex: 1; padding: 11px 14px; border: none; font-size: 14px; outline: none;" />
                                    <span style="background: #f1f5f9; padding: 11px 14px; font-size: 13px; color: #64748b; font-weight: 600; border-left: 1px solid #cbd5e1;">.ozikol.cloud</span>
                                </div>
                                <div style="font-size: 11.5px; color: #94a3b8; margin-top: 4px;">If you already have a preferred subdomain slug in mind, enter it above.</div>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: Mandatory Social Media Engagement Tasks -->
                    <div style="margin-bottom: 36px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 12px; flex-wrap: wrap; gap: 8px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <div style="width: 32px; height: 32px; background: #0f172a; color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;">2</div>
                                <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">Community Engagement & Eligibility Checklist</h2>
                            </div>
                            <span id="taskProgressBadge" style="font-size: 12px; color: #059669; font-weight: 800; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 4px 12px; border-radius: 9999px; display: inline-flex; align-items: center; gap: 6px;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">task_alt</span>
                                <span id="taskProgressText">0 of 6 Tasks Completed</span>
                            </span>
                        </div>

                        <!-- Animated Progress Bar -->
                        <div style="width: 100%; height: 6px; background: #e2e8f0; border-radius: 9999px; margin-bottom: 16px; overflow: hidden;">
                            <div id="taskProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #10b981 0%, #059669 100%); transition: width 0.4s ease;"></div>
                        </div>

                        <p style="font-size: 13.5px; color: #64748b; margin: 0 0 20px 0; line-height: 1.5;">
                            Click the action buttons to follow our official channels. When you return to this tab, your visit will automatically tick as completed!
                        </p>

                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
                            
                            <!-- 1. X / Twitter -->
                            <div id="card-twitter" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 32px; height: 32px; background: #000000; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 15px;">𝕏</div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">X (Twitter)</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.TwitterHandle</div>
                                        </div>
                                    </div>
                                    <a id="btn-twitter" href="@Model.CommunityLinks.TwitterUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('twitter')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #0f172a; padding: 6px 14px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s ease;">
                                        <span>Follow 𝕏</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.TwitterHandle" id="input-twitter" oninput="checkTaskInput('twitter')" placeholder="e.g. @@username" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 2. LinkedIn -->
                            <div id="card-linkedin" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 32px; height: 32px; background: #0a66c2; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 15px;">in</div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">LinkedIn</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.LinkedInName</div>
                                        </div>
                                    </div>
                                    <a id="btn-linkedin" href="@Model.CommunityLinks.LinkedInUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('linkedin')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #0a66c2; padding: 6px 14px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s ease;">
                                        <span>Follow in</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.LinkedInProfile" id="input-linkedin" oninput="checkTaskInput('linkedin')" placeholder="e.g. linkedin.com/in/username" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 3. YouTube -->
                            <div id="card-youtube" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 32px; height: 32px; background: #ff0000; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 15px;">▶</div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">YouTube</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.YouTubeName</div>
                                        </div>
                                    </div>
                                    <a id="btn-youtube" href="@Model.CommunityLinks.YouTubeUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('youtube')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #ff0000; padding: 6px 14px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s ease;">
                                        <span>Subscribe ▶</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.YouTubeHandle" id="input-youtube" oninput="checkTaskInput('youtube')" placeholder="e.g. @@channelname" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 4. Facebook -->
                            <div id="card-facebook" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 32px; height: 32px; background: #1877f2; color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 15px;">f</div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">Facebook</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.FacebookName</div>
                                        </div>
                                    </div>
                                    <a id="btn-facebook" href="@Model.CommunityLinks.FacebookUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('facebook')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #1877f2; padding: 6px 14px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s ease;">
                                        <span>Follow f</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.FacebookProfile" id="input-facebook" oninput="checkTaskInput('facebook')" placeholder="e.g. facebook.com/profile" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 5. Instagram -->
                            <div id="card-instagram" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 32px; height: 32px; background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); color: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 15px;">📷</div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">Instagram</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.InstagramName</div>
                                        </div>
                                    </div>
                                    <a id="btn-instagram" href="@Model.CommunityLinks.InstagramUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('instagram')" style="font-size: 12px; font-weight: 700; color: #ffffff; background: #e1306c; padding: 6px 14px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s ease;">
                                        <span>Follow 📷</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.InstagramHandle" id="input-instagram" oninput="checkTaskInput('instagram')" placeholder="e.g. @@username" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                            <!-- 6. Snapchat -->
                            <div id="card-snapchat" class="social-task-card" style="background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 16px; transition: all 0.25s ease;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 32px; height: 32px; background: #fffc00; color: #000000; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 16px; border: 1px solid #e2e8f0;">👻</div>
                                        <div>
                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">Snapchat</div>
                                            <div style="font-size: 11.5px; color: #64748b;">@Model.CommunityLinks.SnapchatName</div>
                                        </div>
                                    </div>
                                    <a id="btn-snapchat" href="@Model.CommunityLinks.SnapchatUrl" target="_blank" rel="noopener noreferrer" onclick="trackTaskClick('snapchat')" style="font-size: 12px; font-weight: 700; color: #0f172a; background: #fffc00; border: 1px solid #cbd5e1; padding: 6px 14px; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s ease;">
                                        <span>Add 👻</span>
                                        <span>&rarr;</span>
                                    </a>
                                </div>
                                <input asp-for="Input.SnapchatHandle" id="input-snapchat" oninput="checkTaskInput('snapchat')" placeholder="e.g. username" style="width: 100%; padding: 9px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; background: #ffffff;" />
                            </div>

                        </div>
                    </div>

                    <!-- SECTION 3: Additional Notes & Consent -->
                    <div style="margin-bottom: 32px;">
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px; border-bottom: 1.5px solid #f1f5f9; padding-bottom: 12px;">
                            <div style="width: 32px; height: 32px; background: #0f172a; color: #ffffff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;">3</div>
                            <h2 style="font-size: 18px; font-weight: 800; color: #0f172a; margin: 0;">Organization Goals & Confirmation</h2>
                        </div>

                        <div style="margin-bottom: 16px;">
                            <label asp-for="Input.Remarks" style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">How will your organization use the platform? (Optional)</label>
                            <textarea asp-for="Input.Remarks" rows="3" placeholder="Describe your organization's goals, intended features, or expected usage..." style="width: 100%; padding: 11px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; resize: vertical;"></textarea>
                        </div>

                        <div style="display: flex; align-items: center; gap: 10px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px 16px; border-radius: 8px;">
                            <input asp-for="Input.IsNewsletterSubscribed" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--ozikol-primary);" />
                            <label asp-for="Input.IsNewsletterSubscribed" style="font-size: 13.5px; font-weight: 600; color: #334155; cursor: pointer; margin: 0;">
                                Subscribe to official technical briefings, security bulletins, and feature releases.
                            </label>
                        </div>
                    </div>

                    <!-- Submit Action Button -->
                    <button type="submit" id="submitBtn" style="width: 100%; background: #d97706; color: #ffffff; font-size: 16px; font-weight: 800; padding: 16px; border: none; border-radius: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 14px rgba(217, 119, 6, 0.25); transition: background 0.15s ease;">
                        <span class="material-symbols-outlined" style="font-size: 22px;">card_giftcard</span>
                        <span>Submit Voucher Application &rarr;</span>
                    </button>
                </form>

            </div>
        }
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const completedTasks = new Set();
        let pendingTask = null;

        function trackTaskClick(taskName) {
            pendingTask = taskName;
        }

        // Detect window return / focus event (Gleam-style auto-verification)
        function handleTabReturn() {
            if (pendingTask) {
                markTaskAsCompleted(pendingTask);
                pendingTask = null;
            }
        }

        window.addEventListener('focus', handleTabReturn);
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
                handleTabReturn();
            }
        });

        function markTaskAsCompleted(taskName) {
            completedTasks.add(taskName);

            const card = document.getElementById(`card-${taskName}`);
            const btn = document.getElementById(`btn-${taskName}`);
            const input = document.getElementById(`input-${taskName}`);

            if (card) {
                card.style.background = '#f0fdf4';
                card.style.borderColor = '#10b981';
                card.style.boxShadow = '0 0 0 2px rgba(16, 185, 129, 0.15)';
            }

            if (btn) {
                btn.style.background = '#10b981';
                btn.style.color = '#ffffff';
                btn.innerHTML = '<span class="material-symbols-outlined" style="font-size: 15px;">check_circle</span> <span>Done</span>';
            }

            if (input && !input.value.trim()) {
                input.focus();
            }

            updateTaskProgress();
        }

        function checkTaskInput(taskName) {
            const input = document.getElementById(`input-${taskName}`);
            if (input && input.value.trim().length > 0) {
                markTaskAsCompleted(taskName);
            }
        }

        function updateTaskProgress() {
            const totalTasks = 6;
            const count = completedTasks.size;
            const percentage = Math.min(100, Math.round((count / totalTasks) * 100));

            const progressText = document.getElementById('taskProgressText');
            const progressBar = document.getElementById('taskProgressBar');
            const progressBadge = document.getElementById('taskProgressBadge');

            if (progressText) {
                progressText.innerText = `${count} of ${totalTasks} Tasks Completed`;
            }

            if (progressBar) {
                progressBar.style.width = `${percentage}%`;
            }

            if (count >= 2 && progressBadge) {
                progressBadge.style.background = '#ecfdf5';
                progressBadge.style.borderColor = '#10b981';
                progressBadge.style.color = '#047857';
            }
        }
    </script>
}
