@page "/about-us/reliability"
@model Ozikol.Central.Pages.AboutUs.ReliabilityModel
@{
    ViewData["Title"] = "Cloud Reliability & Backups - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                Cloud Infrastructure
            </div>
            <h1 class="ozikol-hero-title">
                Always Accessible, Continuously Protected
            </h1>
            <p class="ozikol-hero-desc">
                Dependable 99.9% cloud availability backed by automated daily snapshots and disaster recovery safeguards.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-3">
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">99.9% Uptime SLA</h3>
                <p class="ozikol-card-desc">Engineered on modern cloud infrastructure to keep your business running smoothly 24/7.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Daily Automated Backups</h3>
                <p class="ozikol-card-desc">Automated nightly database snapshots with geo-redundant storage safeguards.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Disaster Recovery Ready</h3>
                <p class="ozikol-card-desc">Rapid failover architecture designed to restore operations swiftly in any unexpected event.</p>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
