@page "/about-us/security"
@model Ozikol.Central.Pages.AboutUs.SecurityModel
@{
    ViewData["Title"] = "Account Security & Access Control - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                Account Protection
            </div>
            <h1 class="ozikol-hero-title">
                Enterprise-Grade Account Safety for Every Team
            </h1>
            <p class="ozikol-hero-desc">
                Protect your organization with multi-layered login verification, role-based permissions, and session safeguards.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-3">
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Two-Factor Auth (2FA)</h3>
                <p class="ozikol-card-desc">Enforce TOTP authenticator app and SMS two-factor verification across all user accounts.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Role-Based Permissions</h3>
                <p class="ozikol-card-desc">Granular controls for Admins, Managers, Staff, and Members across all 33 modular applications.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Safe Session Management</h3>
                <p class="ozikol-card-desc">Automatic timeout, device authorization alerts, and single-click remote session revocation.</p>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
