@page "/about-us/offices"
@model Ozikol.Central.Pages.AboutUs.OfficesModel
@{
    ViewData["Title"] = "Global Locations & Offices - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                Global Presence
            </div>
            <h1 class="ozikol-hero-title">
                Connecting Organizations Worldwide
            </h1>
            <p class="ozikol-hero-desc">
                Ozikol operates across major operational centres and high-speed cloud infrastructure regions.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-2">
            <div class="ozikol-card">
                <span style="display: inline-block; font-size: 12px; font-weight: 700; color: var(--ozikol-primary); text-transform: uppercase; margin-bottom: 8px;">Global Headquarters</span>
                <h3 style="font-size: 20px; font-weight: 700; color: var(--ozikol-dark); margin-bottom: 12px;">London, United Kingdom</h3>
                <p class="ozikol-card-desc" style="margin-bottom: 14px;">100 Technology Square, Suite 400<br/>London, United Kingdom</p>
                <div style="font-size: 13.5px; color: #334155; font-weight: 600;">Support: +44 (0) 20 7946 0912</div>
            </div>
            <div class="ozikol-card">
                <span style="display: inline-block; font-size: 12px; font-weight: 700; color: #0284c7; text-transform: uppercase; margin-bottom: 8px;">Cloud Operations & Support</span>
                <h3 style="font-size: 20px; font-weight: 700; color: var(--ozikol-dark); margin-bottom: 12px;">24/7 Global Digital Network</h3>
                <p class="ozikol-card-desc" style="margin-bottom: 14px;">Distributed engineering, 99.9% uptime monitoring, and customer support desks.</p>
                <div style="font-size: 13.5px; color: #334155; font-weight: 600;">support@ozikol.cloud</div>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
