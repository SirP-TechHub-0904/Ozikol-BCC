@page "/about-us/offices"
@model Ozikol.Central.Pages.AboutUs.OfficesModel
@{
    ViewData["Title"] = SharedLocalizer["Offices_Page_Title"];
}

<div class="oz-corp-page">
    <!-- Hero Banner -->
    <section class="oz-corp-banner">
        <div class="oz-corp-banner-wrap">
            <div class="oz-corp-badge">
                <span class="oz-corp-badge-dot"></span>
                @SharedLocalizer["Offices_Hero_Badge"]
            </div>
            <h1 class="oz-corp-title">
                @Html.Raw(SharedLocalizer["Offices_Hero_Title"].Value)
            </h1>
            <p class="oz-corp-lead">
                @SharedLocalizer["Offices_Hero_Lead"]
            </p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support#contact" class="oz-btn-primary-hero">
                    <span>@SharedLocalizer["Offices_Hero_BtnPrimary"]</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a href="/@Model.CurrentCulture/about-us" class="oz-btn-outline-hero">
                    <span>@SharedLocalizer["Offices_Hero_BtnSecondary"]</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="oz-corp-container">
        <!-- Direct Inquiry Channels Grid -->
        <section class="oz-corp-section">
            <div class="oz-corp-section-header">
                <span class="oz-corp-section-tag">@SharedLocalizer["Offices_Hubs_Tag"]</span>
                <h2 class="oz-corp-section-title">@SharedLocalizer["Offices_Hubs_Title"]</h2>
                <p class="oz-corp-section-desc">@SharedLocalizer["Offices_Hubs_Desc"]</p>
            </div>
            <div class="oz-corp-grid-2">
                <div class="oz-corp-card">
                    <div class="oz-corp-card-icon oz-icon-blue" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                    </div>
                    <span class="oz-corp-badge-pill">@SharedLocalizer["Offices_Hub1_Badge"]</span>
                    <h3 class="oz-corp-card-title">@SharedLocalizer["Offices_Hub1_Title"]</h3>
                    <p class="oz-corp-card-desc">@SharedLocalizer["Offices_Hub1_Desc"]</p>
                    <div class="oz-corp-card-footer">
                        <a href="mailto:@SharedLocalizer["Offices_Hub1_Contact"]" class="oz-corp-email-link">@SharedLocalizer["Offices_Hub1_Contact"]</a>
                        <span>@SharedLocalizer["Offices_Hub1_Team"]</span>
                    </div>
                </div>
                <div class="oz-corp-card">
                    <div class="oz-corp-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                    </div>
                    <span class="oz-corp-badge-pill">@SharedLocalizer["Offices_Hub2_Badge"]</span>
                    <h3 class="oz-corp-card-title">@SharedLocalizer["Offices_Hub2_Title"]</h3>
                    <p class="oz-corp-card-desc">@SharedLocalizer["Offices_Hub2_Desc"]</p>
                    <div class="oz-corp-card-footer">
                        <a href="mailto:@SharedLocalizer["Offices_Hub2_Contact"]" class="oz-corp-email-link">@SharedLocalizer["Offices_Hub2_Contact"]</a>
                        <span>@SharedLocalizer["Offices_Hub2_Team"]</span>
                    </div>
                </div>
                <div class="oz-corp-card">
                    <div class="oz-corp-card-icon oz-icon-crimson" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                    </div>
                    <span class="oz-corp-badge-pill">@SharedLocalizer["Offices_Hub3_Badge"]</span>
                    <h3 class="oz-corp-card-title">@SharedLocalizer["Offices_Hub3_Title"]</h3>
                    <p class="oz-corp-card-desc">@SharedLocalizer["Offices_Hub3_Desc"]</p>
                    <div class="oz-corp-card-footer">
                        <a href="mailto:@SharedLocalizer["Offices_Hub3_Contact"]" class="oz-corp-email-link">@SharedLocalizer["Offices_Hub3_Contact"]</a>
                        <span>@SharedLocalizer["Offices_Hub3_Team"]</span>
                    </div>
                </div>
                <div class="oz-corp-card">
                    <div class="oz-corp-card-icon oz-icon-amber" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </div>
                    <span class="oz-corp-badge-pill">@SharedLocalizer["Offices_Hub4_Badge"]</span>
                    <h3 class="oz-corp-card-title">@SharedLocalizer["Offices_Hub4_Title"]</h3>
                    <p class="oz-corp-card-desc">@SharedLocalizer["Offices_Hub4_Desc"]</p>
                    <div class="oz-corp-card-footer">
                        <a href="mailto:@SharedLocalizer["Offices_Hub4_Contact"]" class="oz-corp-email-link">@SharedLocalizer["Offices_Hub4_Contact"]</a>
                        <span>@SharedLocalizer["Offices_Hub4_Team"]</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <div class="oz-feat-cta-badge">
                <span class="oz-feat-cta-badge-dot"></span>
                @SharedLocalizer["Offices_Cta_Badge"]
            </div>
            <h2>@SharedLocalizer["Offices_Cta_Title"]</h2>
            <p>@SharedLocalizer["Offices_Cta_Desc"]</p>
            <div class="oz-feat-cta-actions">
                <a href="/support#contact" class="oz-btn-primary-hero">
                    <span>@SharedLocalizer["Offices_Cta_BtnPrimary"]</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                    <span>@SharedLocalizer["Offices_Cta_BtnSecondary"]</span>
                </a>
            </div>
        </section>
    </main>
</div>
