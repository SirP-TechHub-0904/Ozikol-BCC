@page "/about-us/partners"
@model Ozikol.Central.Pages.AboutUs.PartnersModel
@{
    ViewData["Title"] = "Partner & Affiliate Network - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                Ecosystem & Growth
            </div>
            <h1 class="ozikol-hero-title">
                Grow Your Business with the Ozikol Partner Network
            </h1>
            <p class="ozikol-hero-desc">
                Join our community of agency partners, system integrators, and software affiliates driving modern digital transformation.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-3">
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Agency & Solution Partners</h3>
                <p class="ozikol-card-desc">Implement and customize Ozikol BCP for your enterprise clients with co-selling support.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">UI Marketplace Creators</h3>
                <p class="ozikol-card-desc">Publish layout blueprints, header navbars, and hero sections to earn recurring revenue.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Affiliate Advocates</h3>
                <p class="ozikol-card-desc">Earn generous lifetime commissions referring organizations to Ozikol Cloud.</p>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
