@page "/about-us/privacy"
@model Ozikol.Central.Pages.AboutUs.PrivacyModel
@{
    ViewData["Title"] = "Data Privacy & Export - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                Privacy First
            </div>
            <h1 class="ozikol-hero-title">
                Your Data is Yours. Always.
            </h1>
            <p class="ozikol-hero-desc">
                We believe in total transparency, GDPR compliance, and giving you instant 1-click access to export your records anytime.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support#contact" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-3">
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">GDPR & UK Compliance</h3>
                <p class="ozikol-card-desc">Strict data processing principles ensuring organizational and member privacy by design.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">1-Click Data Export</h3>
                <p class="ozikol-card-desc">Download complete member directories, shift schedules, financial ledgers, and logs in CSV/JSON anytime.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Zero Third-Party Selling</h3>
                <p class="ozikol-card-desc">We never monetize, sell, or advertise against your organizational data. Period.</p>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support#contact" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
