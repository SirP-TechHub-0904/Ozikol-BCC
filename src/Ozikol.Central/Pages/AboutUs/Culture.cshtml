@page "/about-us/culture"
@model Ozikol.Central.Pages.AboutUs.CultureModel
@{
    ViewData["Title"] = "Core Values & Culture - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                The Ozikol Way
            </div>
            <h1 class="ozikol-hero-title">
                Built on Simplicity, Transparency & Impact
            </h1>
            <p class="ozikol-hero-desc">
                Our culture defines how we build software, how we support customers, and how we empower teams worldwide.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-3">
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Simplicity First</h3>
                <p class="ozikol-card-desc">We believe software should be intuitive and fast to deploy without requiring weeks of specialized training.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Customer Sovereignty</h3>
                <p class="ozikol-card-desc">Your data belongs entirely to you. We provide 1-click exports and transparent modular controls.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Continuous Innovation</h3>
                <p class="ozikol-card-desc">We deliver rapid monthly feature drops and keep our platform flexible with the UI Marketplace.</p>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
