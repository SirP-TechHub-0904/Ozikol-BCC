@page "/about-us/ai-security"
@model Ozikol.Central.Pages.AboutUs.AiSecurityModel
@{
    ViewData["Title"] = "AI Privacy & Data Protection - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                Responsible AI
            </div>
            <h1 class="ozikol-hero-title">
                Intelligent Automation with Uncompromising Privacy
            </h1>
            <p class="ozikol-hero-desc">
                Harness powerful AI workflows while maintaining complete sovereignty over your confidential operational data.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support#contact" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-3">
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Bring Your Own Key (BYOK)</h3>
                <p class="ozikol-card-desc">Connect your own OpenAI, Anthropic, or Azure AI API keys directly for direct billing and sovereignty.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Zero Model Training</h3>
                <p class="ozikol-card-desc">Your prompts and organizational records are never used to train public or foundation AI models.</p>
            </div>
            <div class="ozikol-card">
                <h3 class="ozikol-card-title">Permission-Bounded Context</h3>
                <p class="ozikol-card-desc">AI assistants can only retrieve information that the active user is explicitly authorized to view.</p>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support#contact" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
