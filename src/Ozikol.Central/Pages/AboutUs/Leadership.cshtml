@page "/about-us/leadership"
@model Ozikol.Central.Pages.AboutUs.LeadershipModel
@{
    ViewData["Title"] = "Leadership & Governance - Ozikol";
}

<div class="about-subpage">
    <section class="ozikol-hero-banner branded-banner branded-banner--evo">
        <div class="ozikol-hero-container">
            <div class="ozikol-hero-badge">
                <span class="ozikol-hero-dot"></span>
                Executive Leadership
            </div>
            <h1 class="ozikol-hero-title">
                Guided by Experience, Driven by Innovation
            </h1>
            <p class="ozikol-hero-desc">
                Meet the leaders, product architects, and engineering directors shaping the future of the Ozikol Business Cloud Platform.
            </p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Get in Touch</a>
                <a href="/about-us" class="btn btn-secondary--alt">About Ozikol</a>
            </div>
        </div>
    </section>

    <main class="container" style="max-width: 1100px; margin: 50px auto; padding: 0 20px;">
        <div class="ozikol-grid-3">
            <div class="ozikol-card ozikol-card--center">
                <div class="ozikol-avatar-initials">OE</div>
                <h3 class="ozikol-card-title">Executive Leadership</h3>
                <div style="font-size: 13px; color: var(--ozikol-primary); font-weight: 600; margin-bottom: 12px;">Global Strategy & Operations</div>
                <p class="ozikol-card-desc">Leading global enterprise expansion, customer excellence, and platform vision.</p>
            </div>
            <div class="ozikol-card ozikol-card--center">
                <div class="ozikol-avatar-initials" style="color: #0284c7;">CT</div>
                <h3 class="ozikol-card-title">Cloud Architecture</h3>
                <div style="font-size: 13px; color: #0284c7; font-weight: 600; margin-bottom: 12px;">Infrastructure & DevOps</div>
                <p class="ozikol-card-desc">Architecting high-availability cloud fleets, modular data pipelines, and security.</p>
            </div>
            <div class="ozikol-card ozikol-card--center">
                <div class="ozikol-avatar-initials" style="color: #16a34a;">PD</div>
                <h3 class="ozikol-card-title">Product & Ecosystem</h3>
                <div style="font-size: 13px; color: #16a34a; font-weight: 600; margin-bottom: 12px;">UI Marketplace & Modules</div>
                <p class="ozikol-card-desc">Directing modular application experiences, creator toolsets, and user workflows.</p>
            </div>
        </div>

        <section class="ozikol-bottom-cta">
            <h2>Ready to learn more about Ozikol?</h2>
            <p>Connect with our team to discover how our modular cloud platform can power your organization.</p>
            <div class="ozikol-hero-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All Features</a>
            </div>
        </section>
    </main>
</div>
