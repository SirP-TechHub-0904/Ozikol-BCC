@page
@model Ozikol.Central.Pages.SignupModel
@{
    ViewData["Title"] = "Create Your Workspace - Ozikol Cloud";
}

<div class="signup-page-container">
    <div class="signup-card">
        <div class="signup-header">
            <div class="brand-badge">
                <span class="badge-dot"></span>
                <span>Ozikol Multi-Tenant Cloud</span>
            </div>
            <h1 class="signup-title">Launch Your Workspace</h1>
            <p class="signup-subtitle">Set up your dedicated organization, isolated SQL database, and executive MIS dashboard in seconds.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <div class="alert-icon">⚠️</div>
                <div class="alert-text">@Model.ErrorMessage</div>
            </div>
        }

        <form method="post" class="signup-form" id="signupForm">
            <div class="form-section-title">1. Organization & Domain Details</div>

            <div class="form-group">
                <label asp-for="Input.OrganizationName">Organization / Company Name</label>
                <input asp-for="Input.OrganizationName" class="form-control" placeholder="e.g. Acme Global Corporation" id="orgNameInput" />
                <span asp-validation-for="Input.OrganizationName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.TenantKey">Workspace Subdomain (Key)</label>
                <div class="subdomain-input-wrap">
                    <input asp-for="Input.TenantKey" class="form-control font-mono" placeholder="acme" id="tenantKeyInput" />
                    <span class="subdomain-suffix">.localhost:4200</span>
                </div>
                <span class="form-hint">Your dedicated MIS application will be live at this URL.</span>
                <span asp-validation-for="Input.TenantKey" class="text-danger"></span>
            </div>

            <div class="form-section-title" style="margin-top: 24px;">2. Primary Administrator Profile</div>

            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="Input.AdminFirstName">First Name</label>
                    <input asp-for="Input.AdminFirstName" class="form-control" placeholder="John" />
                    <span asp-validation-for="Input.AdminFirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.AdminLastName">Last Name</label>
                    <input asp-for="Input.AdminLastName" class="form-control" placeholder="Doe" />
                    <span asp-validation-for="Input.AdminLastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="Input.AdminEmail">Admin Email</label>
                    <input asp-for="Input.AdminEmail" type="email" class="form-control" placeholder="admin@acme.com" />
                    <span asp-validation-for="Input.AdminEmail" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.PhoneNumber">Phone Number (Optional)</label>
                    <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1 (555) 000-0000" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="Input.AdminPassword">Password</label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input asp-for="Input.AdminPassword" type="password" id="passwordInput" class="form-control" placeholder="••••••••" style="padding-right: 42px;" />
                        <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('passwordInput', this)" title="Show / Hide Password" style="position: absolute; right: 12px; background: none; border: none; cursor: pointer; color: #94a3b8; display: flex; align-items: center; justify-content: center; padding: 0;">
                            <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.AdminPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <div style="position: relative; display: flex; align-items: center;">
                        <input asp-for="Input.ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control" placeholder="••••••••" style="padding-right: 42px;" />
                        <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('confirmPasswordInput', this)" title="Show / Hide Password" style="position: absolute; right: 12px; background: none; border: none; cursor: pointer; color: #94a3b8; display: flex; align-items: center; justify-content: center; padding: 0;">
                            <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section-title" style="margin-top: 24px;">3. Referral Partner Code (Optional)</div>

            <div class="form-group">
                <label asp-for="Input.ReferredBy">Referred By Partner Code</label>
                <input asp-for="Input.ReferredBy" class="form-control font-mono" placeholder="e.g. ALEX20 or BIZGROWTH" />
                <span class="form-hint">Enter your promoter's referral code if you were introduced by an affiliate partner.</span>
            </div>

            <!-- Google reCAPTCHA Section -->
            <div class="form-group" style="margin-top: 20px; display: flex; justify-content: center;">
                <div class="g-recaptcha" data-sitekey="@Model.GoogleRecaptchaSiteKey" data-theme="dark"></div>
            </div>

            <div class="provision-info-box">
                <div class="info-row">
                    <span class="info-icon">🛡️</span>
                    <span>Generates isolated SQL Server database with dedicated user credentials.</span>
                </div>
                <div class="info-row">
                    <span class="info-icon">⚡</span>
                    <span>Applies all schema migrations and seeds executive SuperAdmin credentials.</span>
                </div>
            </div>

            <button type="submit" class="btn btn-launch-workspace" id="btnLaunch">
                <span>Create Organization & Launch MIS</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
        </form>

        <div class="signup-footer">
            <span>Already have an account?</span>
            <a asp-page="/Account/Login" class="login-link">Access Operations Hub</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        // Auto-slugify tenant key from organization name
        const orgInput = document.getElementById('orgNameInput');
        const keyInput = document.getElementById('tenantKeyInput');

        if (orgInput && keyInput) {
            orgInput.addEventListener('input', function() {
                if (!keyInput.dataset.manual) {
                    keyInput.value = this.value
                        .toLowerCase()
                        .trim()
                        .replace(/[^a-z0-9]/g, '-')
                        .replace(/-+/g, '-')
                        .replace(/^-|-$/g, '');
                }
            });

            keyInput.addEventListener('input', function() {
                this.dataset.manual = 'true';
            });
        }

        // Toggle Password Visibility
        function togglePasswordVisibility(inputId, button) {
            const input = document.getElementById(inputId);
            if (!input) return;

            if (input.type === 'password') {
                input.type = 'text';
                button.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;
            } else {
                input.type = 'password';
                button.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
            }
        }
    </script>
}
