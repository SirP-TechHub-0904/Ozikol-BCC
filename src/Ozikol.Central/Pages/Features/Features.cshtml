@page "/features"
@model Ozikol.Central.Pages.FeaturesModel
@{
    ViewData["Title"] = SharedLocalizer["Features_Meta_Title"].Value;
    ViewData["MetaDescription"] = SharedLocalizer["Features_Meta_Desc"].Value;
    ViewData["MetaDescription"] = "Explore all 37 modular cloud capabilities across 9 integrated suites on Ozikol. Included in one simple annual subscription.";
}

<div class="oz-features-page">
    <!-- Section 1: Hero Banner -->
    <section class="oz-features-hero">
        <div class="container">
            <div class="oz-section-header">
                <div class="oz-pricing-hero-badge">
                    <span class="oz-pricing-hero-badge-dot"></span>
                    <span>@SharedLocalizer["Features_Hero_Badge"]</span>
                </div>
                <h1 class="oz-pricing-hero-title">
                    @SharedLocalizer["Features_Hero_Title"]
                </h1>
                <p class="oz-pricing-hero-desc">
                    @SharedLocalizer["Features_Hero_Desc"]
                </p>
            </div>

            <div class="oz-single-cta-group">
                <a href="/@Model.CurrentCulture/register" class="oz-single-btn-primary">
                    <span>@SharedLocalizer["Features_Hero_Btn_Trial"]</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a href="#suite-people" class="oz-features-btn-outline">
                    @SharedLocalizer["Features_Hero_Btn_Explore"]
                </a>
            </div>
        </div>
    </section>

    <!-- Sticky Jump Navigation Bar -->
    <nav class="oz-features-jump-bar" aria-label="Suite Quick Navigation">
        <div class="container">
            <div class="oz-features-jump-row">
                <span class="oz-jump-label">@SharedLocalizer["Features_Jump_Label"]</span>
                <a href="#suite-people" class="oz-jump-chip">@SharedLocalizer["Features_Suite_01_Chip"]</a>
                <a href="#suite-workforce" class="oz-jump-chip">@SharedLocalizer["Features_Suite_02_Chip"]</a>
                <a href="#suite-reports" class="oz-jump-chip">@SharedLocalizer["Features_Suite_03_Chip"]</a>
                <a href="#suite-events" class="oz-jump-chip">@SharedLocalizer["Features_Suite_04_Chip"]</a>
                <a href="#suite-finance" class="oz-jump-chip">@SharedLocalizer["Features_Suite_05_Chip"]</a>
                <a href="#suite-operations" class="oz-jump-chip">@SharedLocalizer["Features_Suite_06_Chip"]</a>
                <a href="#suite-communication" class="oz-jump-chip">@SharedLocalizer["Features_Suite_07_Chip"]</a>
                <a href="#suite-compliance" class="oz-jump-chip">@SharedLocalizer["Features_Suite_08_Chip"]</a>
                <a href="#suite-demographics" class="oz-jump-chip">@SharedLocalizer["Features_Suite_09_Chip"]</a>
            </div>
        </div>
    </nav>

    <!-- Main Content: All 9 Suites -->
    <main class="container">
        <!-- Suite 01: @SharedLocalizer["Features_Suite_01_Title"] -->
        <section id="suite-people" class="oz-features-suite-block">
            <div class="oz-section-header">
                <div class="oz-pricing-hero-badge">
                    <span class="oz-pricing-hero-badge-dot"></span>
                    <span>@SharedLocalizer["Features_Suite_01_Badge"]</span>
                </div>
                <h2 class="oz-pricing-hero-title">@SharedLocalizer["Features_Suite_01_Title"]</h2>
                <p class="oz-pricing-hero-desc">
                    @SharedLocalizer["Features_Suite_01_Desc"]
                </p>
            </div>

            <div class="oz-features-grid">
                <!-- Feature 1: Community Messenger -->
                <article class="oz-feat-card">
                    <div class="oz-feat-card-top">
                        <div class="oz-feat-card-icon oz-feat-card-icon--crimson" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </div>
                        <h3 class="oz-feat-card-title">@SharedLocalizer["Feat_CommunityMessenger_Title"]</h3>
                        <p class="oz-feat-card-desc">
                            @SharedLocalizer["Feat_CommunityMessenger_Desc"]
                        </p>
                        <ul class="oz-feat-checklist">
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>@SharedLocalizer["Feat_CommunityMessenger_Pt1"]</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>@SharedLocalizer["Feat_CommunityMessenger_Pt2"]</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>@SharedLocalizer["Feat_CommunityMessenger_Pt3"]</span>
                            </li>
                        </ul>
                    </div>
                    <div class="oz-feat-card-actions">
                        <a href="/@Model.CurrentCulture/features/community-messenger" class="oz-btn-readmore">
                            <span>@SharedLocalizer["Features_Btn_ReadMore"]</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                        <a href="/@Model.CurrentCulture/register" class="oz-btn-getstarted">@SharedLocalizer["Features_Btn_GetStarted"]</a>
                    </div>
                </article>

                <!-- Feature 2: Committees and Sub-Groups -->
