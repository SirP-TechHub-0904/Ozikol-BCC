@page "/features"
@model Ozikol.Central.Pages.FeaturesModel
@{
    ViewData["Title"] = "Platform Capabilities & 9 Enterprise Suites - Ozikol";
    ViewData["MetaDescription"] = "Explore all 37 modular cloud capabilities across 9 integrated suites on Ozikol. Included in one simple annual subscription.";
}

<div class="oz-features-page">
    <!-- Section 1: Hero Banner -->
    <section class="oz-features-hero">
        <div class="container">
            <div class="oz-section-header">
                <div class="oz-pricing-hero-badge">
                    <span class="oz-pricing-hero-badge-dot"></span>
                    <span>Ozikol Platform Capabilities</span>
                </div>
                <h1 class="oz-pricing-hero-title">
                    Everything Your Organization Needs to Collaborate, Operate, and Scale
                </h1>
                <p class="oz-pricing-hero-desc">
                    Explore all 37 integrated cloud capabilities across 9 modular enterprise suites. Every feature is unlocked out of the box with your single annual subscription.
                </p>
            </div>

            <div class="oz-single-cta-group">
                <a href="/@Model.CurrentCulture/register" class="oz-single-btn-primary">
                    <span>Start 14-Day Free Trial</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a href="#suite-people" class="oz-features-btn-outline">
                    Explore All 9 Suites
                </a>
            </div>
        </div>
    </section>

    <!-- Sticky Jump Navigation Bar -->
    <nav class="oz-features-jump-bar" aria-label="Suite Quick Navigation">
        <div class="container">
            <div class="oz-features-jump-row">
                <span class="oz-jump-label">Jump to Suite:</span>
                <a href="#suite-people" class="oz-jump-chip">People & Community</a>
                <a href="#suite-workforce" class="oz-jump-chip">Workforce & Shifts</a>
                <a href="#suite-reports" class="oz-jump-chip">Reports & Forms</a>
                <a href="#suite-events" class="oz-jump-chip">Events & Training</a>
                <a href="#suite-finance" class="oz-jump-chip">Finance & Revenue</a>
                <a href="#suite-operations" class="oz-jump-chip">Operations & Assets</a>
                <a href="#suite-communication" class="oz-jump-chip">Communication & AI</a>
                <a href="#suite-compliance" class="oz-jump-chip">Compliance & Certs</a>
                <a href="#suite-demographics" class="oz-jump-chip">Demographics & Census</a>
            </div>
        </div>
    </nav>

    <!-- Main Content: All 9 Suites -->
    <main class="container">
        <!-- Suite 01: People, Community and Collaboration -->
        <section id="suite-people" class="oz-features-suite-block">
            <div class="oz-section-header">
                <div class="oz-pricing-hero-badge">
                    <span class="oz-pricing-hero-badge-dot"></span>
                    <span>Suite 01</span>
                </div>
                <h2 class="oz-pricing-hero-title">People, Community, and Collaboration</h2>
                <p class="oz-pricing-hero-desc">
                    Connect internal staff, leadership teams, volunteers, and external alumni networks on a secure unified communication fabric.
                </p>
            </div>

            <div class="oz-features-grid">
                <!-- Feature 1: Community Messenger -->
                <article class="oz-feat-card">
                    <div class="oz-feat-card-top">
                        <div class="oz-feat-card-icon oz-feat-card-icon--crimson" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </div>
                        <h3 class="oz-feat-card-title">Community Messenger</h3>
                        <p class="oz-feat-card-desc">
                            Real-time direct messaging and departmental channels that replace fragmented third-party chat apps with an internal audit trail.
                        </p>
                        <ul class="oz-feat-checklist">
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Real-time direct messages and topic rooms</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Floating live web chat widget</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Secure file sharing with audit logs</span>
                            </li>
                        </ul>
                    </div>
                    <div class="oz-feat-card-actions">
                        <a href="/@Model.CurrentCulture/features/community-messenger" class="oz-btn-readmore">
                            <span>Read More</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                        <a href="/@Model.CurrentCulture/register" class="oz-btn-getstarted">
                            Get Started
                        </a>
                    </div>
                </article>

                <!-- Feature 2: Committees and Sub-Groups -->
                <article class="oz-feat-card">
                    <div class="oz-feat-card-top">
                        <div class="oz-feat-card-icon oz-feat-card-icon--indigo" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <h3 class="oz-feat-card-title">Committees and Sub-Groups</h3>
                        <p class="oz-feat-card-desc">
                            Empower leadership councils, project task forces, and regional boards with meeting agendas, attendance records, and resolutions.
                        </p>
                        <ul class="oz-feat-checklist">
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Committee roster and officer roles</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Meeting calendar and agenda scheduling</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Formal resolutions archive with voting</span>
                            </li>
                        </ul>
                    </div>
                    <div class="oz-feat-card-actions">
                        <a href="/@Model.CurrentCulture/features/committees" class="oz-btn-readmore">
                            <span>Read More</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                        <a href="/@Model.CurrentCulture/register" class="oz-btn-getstarted">
                            Get Started
                        </a>
                    </div>
                </article>

                <!-- Feature 3: Alumni Networking Directory -->
                <article class="oz-feat-card">
                    <div class="oz-feat-card-top">
                        <div class="oz-feat-card-icon oz-feat-card-icon--emerald" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                            </svg>
                        </div>
                        <h3 class="oz-feat-card-title">Alumni Networking Directory</h3>
                        <p class="oz-feat-card-desc">
                            A searchable member directory for associations, universities, and professional networks with chapter filtering and profile management.
                        </p>
                        <ul class="oz-feat-checklist">
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Searchable graduation class and chapter registry</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Member profile self-updates</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Career directory and mentor matching</span>
                            </li>
                        </ul>
                    </div>
                    <div class="oz-feat-card-actions">
                        <a href="/@Model.CurrentCulture/features/alumni-directory" class="oz-btn-readmore">
                            <span>Read More</span>
