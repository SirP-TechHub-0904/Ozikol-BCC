@page "/features"
@model Ozikol.Central.Pages.FeaturesModel
@{
    ViewData["Title"] = SharedLocalizer["Features_Meta_Title"].Value;
    ViewData["MetaDescription"] = SharedLocalizer["Features_Meta_Desc", Model.TotalFeaturesCount, Model.TotalSuitesCount].Value;
    var firstAnchor = Model.Suites.FirstOrDefault()?.AnchorId ?? "suite-people";
}

<div class="oz-features-page">
    <!-- Section 1: Hero Banner -->
    <section class="oz-features-hero">
        <div class="container">
            <div class="oz-section-header">
                <div class="oz-pricing-hero-badge">
                    <span class="oz-pricing-hero-badge-dot"></span>
                    <span>@SharedLocalizer["Features_Hero_Badge"]</span>
                </div>
                <h1 class="oz-pricing-hero-title">
                    @SharedLocalizer["Features_Hero_Title", Model.TotalFeaturesCount, Model.TotalSuitesCount]
                </h1>
                <p class="oz-pricing-hero-desc">
                    @SharedLocalizer["Features_Hero_Desc", Model.TotalFeaturesCount, Model.TotalSuitesCount]
                </p>
            </div>

            <div class="oz-single-cta-group">
                <a href="/@Model.CurrentCulture/register" class="oz-single-btn-primary">
                    <span>@SharedLocalizer["Features_Hero_Btn_Trial"]</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a href="#@firstAnchor" class="oz-features-btn-outline">
                    @SharedLocalizer["Features_Hero_Btn_Explore"]
                </a>
            </div>
        </div>
    </section>

    <!-- Sticky Jump Navigation Bar (Dynamic by Suite SortOrder) -->
    <nav class="oz-features-jump-bar" aria-label="Suite Quick Navigation">
        <div class="container">
            <div class="oz-features-jump-row">
                <span class="oz-jump-label">@SharedLocalizer["Features_Jump_Label"]</span>
                @foreach (var suite in Model.Suites)
                {
                    <a href="#@suite.AnchorId" class="oz-jump-chip">@suite.MenuTitle</a>
                }
            </div>
        </div>
    </nav>

    <!-- Main Content: All Active Suites & Features Ordered Strictly by SortOrder -->
    <main class="container">
        @foreach (var suite in Model.Suites)
        {
            <section id="@suite.AnchorId" class="oz-features-suite-block">
                <div class="oz-section-header">
                    <div class="oz-pricing-hero-badge">
                        <span class="oz-pricing-hero-badge-dot"></span>
                        <span>@suite.MenuTitle Suite</span>
                    </div>
                    <h2 class="oz-pricing-hero-title">@suite.Name</h2>
                    <p class="oz-pricing-hero-desc">
                        @suite.Description
                    </p>
                </div>

                <div class="oz-features-grid">
                    @foreach (var feat in suite.Features)
                    {
                        <article class="oz-feat-card">
                            <div class="oz-feat-card-top">
                                <div class="oz-feat-card-icon @feat.IconColorClass" aria-hidden="true">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
                                        <polyline points="9 12 11 14 15 10"></polyline>
                                    </svg>
                                </div>
                                <h3 class="oz-feat-card-title">@feat.Name</h3>
                                <p class="oz-feat-card-desc">
                                    @feat.Description
                                </p>
                                <ul class="oz-feat-checklist">
                                    @foreach (var pt in feat.BulletPoints)
                                    {
                                        <li class="oz-feat-check-item">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            <span>@pt</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="oz-feat-card-actions">
                                <a href="/@Model.CurrentCulture/features/@feat.PublicSlug" class="oz-btn-readmore">
                                    <span>@SharedLocalizer["Features_Btn_ReadMore"]</span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                </a>
                                <a href="/@Model.CurrentCulture/register" class="oz-btn-getstarted">@SharedLocalizer["Features_Btn_GetStarted"]</a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </main>

    <!-- Bottom Conversion CTA Banner -->
    <section class="oz-pricing-cta-banner">
        <div class="container">
            <div class="oz-pricing-cta-box">
                <h2>@SharedLocalizer["Features_Cta_Title"]</h2>
                <p>@SharedLocalizer["Features_Cta_Desc"]</p>
                <div class="oz-pricing-cta-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-single-btn-primary">
                        <span>@SharedLocalizer["Features_Hero_Btn_Trial"]</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/contact" class="oz-cta-btn-outline">
                        @SharedLocalizer["Features_Cta_Btn_Sales"]
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
