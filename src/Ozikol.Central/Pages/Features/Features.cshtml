                        <a href="/@Model.CurrentCulture/register" class="oz-btn-getstarted">
                            Get Started
                        </a>
                    </div>
                </article>
            </div>
        </section>

        <!-- Suite 02: Workforce Scheduling & Shift Management -->
        <section id="suite-workforce" class="oz-features-suite-block">
            <div class="oz-section-header">
                <div class="oz-pricing-hero-badge">
                    <span class="oz-pricing-hero-badge-dot"></span>
                    <span>Suite 02</span>
                </div>
                <h2 class="oz-pricing-hero-title">Workforce Scheduling and Shift Management</h2>
                <p class="oz-pricing-hero-desc">
                    Eliminate scheduling headaches, control labor costs, and streamline clock-ins across physical branches and remote teams.
                </p>
            </div>

            <div class="oz-features-grid">
                <!-- Feature 5: Staff Rota -->
                <article class="oz-feat-card">
                    <div class="oz-feat-card-top">
                        <div class="oz-feat-card-icon oz-feat-card-icon--blue" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <h3 class="oz-feat-card-title">Staff Rota</h3>
                        <p class="oz-feat-card-desc">
                            Drag-and-drop weekly and monthly rota scheduling with automatic shift conflict detection, labor budgeting, and instant publishing.
                        </p>
                        <ul class="oz-feat-checklist">
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Multi-branch weekly drag-and-drop grid</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Automatic overtime and conflict alerts</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Mobile shift notifications to workers</span>
                            </li>
                        </ul>
                    </div>
                    <div class="oz-feat-card-actions">
                        <a href="/@Model.CurrentCulture/features/staff-rota" class="oz-btn-readmore">
                            <span>Read More</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </a>
                        <a href="/@Model.CurrentCulture/register" class="oz-btn-getstarted">
                            Get Started
                        </a>
                    </div>
                </article>

                <!-- Feature 6: Shift Swaps and Leave -->
                <article class="oz-feat-card">
                    <div class="oz-feat-card-top">
                        <div class="oz-feat-card-icon oz-feat-card-icon--violet" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="17 1 21 5 17 9"></polyline>
                                <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                                <polyline points="7 23 3 19 7 15"></polyline>
                                <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                            </svg>
