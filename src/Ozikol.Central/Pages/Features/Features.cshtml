                        </a>
                        <a href="/@Model.CurrentCulture/register" class="oz-btn-getstarted">
                            Get Started
                        </a>
                    </div>
                </article>

                <!-- Feature 4: Anonymous Whistleblowing -->
                <article class="oz-feat-card">
                    <div class="oz-feat-card-top">
                        <div class="oz-feat-card-icon oz-feat-card-icon--amber" aria-hidden="true">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <h3 class="oz-feat-card-title">Anonymous Whistleblowing</h3>
                        <p class="oz-feat-card-desc">
                            Encrypted, zero-knowledge reporting channel allowing staff and stakeholders to report sensitive ethical or compliance concerns safely.
                        </p>
                        <ul class="oz-feat-checklist">
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Zero-knowledge identity protection</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Encrypted two-way investigative chat</span>
                            </li>
                            <li class="oz-feat-check-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Audited case resolution workflows</span>
                            </li>
                        </ul>
                    </div>
                    <div class="oz-feat-card-actions">
                        <a href="/@Model.CurrentCulture/features/whistleblowing-feedback" class="oz-btn-readmore">
                            <span>Read More</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
