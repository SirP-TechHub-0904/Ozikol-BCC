@page "/features/digital-brochures-magazines"
@model Ozikol.Central.Pages.Features.DigitalBrochuresMagazinesModel
@{
    ViewData["Title"] = "Digital Brochures & Magazine Publishing - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#life-events-publications">Life Events & Publications</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Digital Brochures & Magazine Publishing</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Life Events & Digital Publications
                </div>
                <h1 class="oz-feat-title">
                    Digital Brochures & Magazine Publishing
                </h1>
                <p class="oz-feat-lead">
                    Publish interactive digital flipbooks, event brochures, corporate magazines, and souvenir booklets with one-click PDF export, embedded video, and analytics.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="oz-feat-body">
        <section class="oz-feat-overview-card">
            <h2>Transform Static Publications into Interactive Digital Experiences</h2>
            <p>
                Ozikol's Digital Brochures & Magazine Publishing module allows organizations, event planners, and publishers to design and distribute realistic digital flipbooks. Combine smooth page-flipping animations with downloadable PDF versions, embedded video trailers, and direct interactive links.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-section">
            <h2 class="oz-feat-section-title">Core Capabilities</h2>
            
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </div>
                    <h3>Interactive Page-Turning Flipbooks</h3>
                    <p>Deliver realistic 3D page-flip animations for digital magazines, event souvenir brochures, company profiles, and annual reports on mobile and desktop.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                    </div>
                    <h3>One-Click PDF Generation & Download</h3>
                    <p>Provide readers with a crisp, vector-rendered PDF download button so they can save brochures for offline reading or high-res printing.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                    </div>
                    <h3>Embedded Video & Audio Media</h3>
                    <p>Embed YouTube videos, audio interviews, background music, and pop-up galleries directly inside publication pages for an immersive experience.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                    </div>
                    <h3>Clickable Call-to-Action Links</h3>
                    <p>Add hyperlink hotspots for external websites, ticket purchases, registration forms, e-commerce products, and sponsor portals.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    </div>
                    <h3>Reader Analytics & Insights</h3>
                    <p>Track publication performance with real-time metrics on total reader views, average time per spread, link clicks, and PDF download counts.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                    <h3>Access Control & DRM</h3>
                    <p>Protect exclusive publications with password authentication, subscriber-only paywalls, or domain-restricted distribution controls.</p>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="oz-feat-cta">
            <h2>Start Publishing Digital Magazines & Brochures</h2>
            <p>Convert your event programs, brochures, and magazines into interactive digital publications with instant PDF downloads.</p>
            <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                <span>Deploy Sovereign Workspace</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
        </section>
    </main>
</div>
