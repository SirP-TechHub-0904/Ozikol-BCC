@page "/features/gocall-ai"
@model Ozikol.Central.Pages.Features.GoCallAiModel
@{
    ViewData["Title"] = "GoCall AI Emergency & Voice Dispatch - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#suite-communication">Communication, AI & Support</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">GoCall AI Emergency & Voice Dispatch</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Communication, AI & Support
                </div>
                <h1 class="oz-feat-title">
                    GoCall AI Emergency & Voice Dispatch
                </h1>
                <p class="oz-feat-lead">
                    Institutional directory pool with autonomous voice and text calling AI for emergency dispatch and prioritized communications.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Empower your organization with autonomous conversational AI calling capabilities. Maintains an intelligent directory pool of emergency contacts, healthcare institutions, and private bodies. Users simply instruct the AI via voice or text, and the system autonomously selects the right institution and conducts the call with real-time situational reporting.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-rose" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </div>
                    <h3>Verified Directory Pool</h3>
                    <p>Curated and verified repository of institutional, healthcare, emergency, and private corporate contacts.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-indigo" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"></circle><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path></svg>
                    </div>
                    <h3>Autonomous Voice & Text Calling</h3>
                    <p>Natural conversational AI agents that place phone calls, communicate intent, and extract required answers.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-amber" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <h3>Contextual Intent Matching</h3>
                    <p>AI automatically analyzes user prompts to identify the optimal institution, emergency responder, or specialist to dial.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </div>
                    <h3>Live Call Transcripts & Summaries</h3>
                    <p>Real-time speech-to-text transcription, audio logging, and automated structured summary generation.</p>
                </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Directory pool management, AI dialing policies, call recording archives, and emergency dispatch tracking.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Institutional contact directory management
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Autonomous AI call permissions & rate limits
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Real-time emergency broadcast & dispatch view
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Full audio archive & transcript compliance search
                        </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Intuitive voice and text prompt interface for initiating AI calls and reviewing outcome summaries.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Voice-to-call & text-to-call AI assistant
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Live call progression & status indicator
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Instant post-call executive summary
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> One-touch emergency assistance trigger
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">1</div>
                    <h3 class="oz-feat-step-title">Prompt GoCall AI</h3>
                    <p class="oz-feat-step-desc">Instruct the AI via voice or text with your question, situation, or emergency need.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">2</div>
                    <h3 class="oz-feat-step-title">Intelligent Directory Selection</h3>
                    <p class="oz-feat-step-desc">AI analyzes the prompt, identifies the verified contact, and dials autonomously.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">3</div>
                    <h3 class="oz-feat-step-title">Real-Time Dispatch & Reporting</h3>
                    <p class="oz-feat-step-desc">Call is conducted, transcription generated, and actionable summary delivered.</p>
                </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <div class="oz-feat-cta-inner">
                <div class="oz-feat-cta-badge">
                    <span class="oz-feat-cta-badge-dot"></span>
                    <span>All-Inclusive Enterprise Suite</span>
                </div>
                <h2 class="oz-feat-cta-title">Ready to Upgrade with GoCall AI Emergency & Voice Dispatch?</h2>
                <p class="oz-feat-cta-desc">
                    Get full access to GoCall AI Emergency & Voice Dispatch and all @CurrencyService.GetActiveFeaturesCount() integrated cloud capabilities with your single annual subscription. Start your 7-day free trial today.
                </p>
                <div class="oz-feat-cta-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All @CurrencyService.GetActiveFeaturesCount() Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
</div>
