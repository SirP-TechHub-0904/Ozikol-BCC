@page "/features/kyc-verification"
@model Ozikol.Central.Pages.Features.KycVerificationModel
@{
    ViewData["Title"] = "KYC & Official Verification - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#suite-compliance">Compliance, Learning & Certification</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">KYC & Official Verification</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Compliance, Learning & Certification
                </div>
                <h1 class="oz-feat-title">
                    KYC & Official Verification
                </h1>
                <p class="oz-feat-lead">
                    Official government ID verification, biometric facial liveness checks, automated AML screening, and tamper-proof compliance audits.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Enterprise-grade identity verification and KYC compliance suite. Validate national IDs, passports, and driver's licenses across 200+ countries with AI OCR, 3D biometric facial liveness detection, and global AML/sanction list screening.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                    </div>
                    <h3>Global ID OCR & Validation</h3>
                    <p>Instantly scan and verify passports, driver's licenses, and national IDs across 200+ jurisdictions.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-blue" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
                    </div>
                    <h3>Biometric 3D Liveness Detection</h3>
                    <p>Anti-spoofing facial recognition and liveness verification ensuring the applicant is physically present.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-rose" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    </div>
                    <h3>Real-Time AML & Sanction Screening</h3>
                    <p>Continuous screening against global PEP, OFAC, and international law enforcement watchlists.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-purple" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </div>
                    <h3>Tamper-Proof Audit Certificates</h3>
                    <p>Cryptographically signed compliance verification certificates ready for regulatory inspection.</p>
                </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Verification review queue, risk score thresholds, AML alert remediation, and compliance audit exports.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Real-time identity verification queue
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> AML / PEP match review & manual overrides
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Customizable risk tolerance thresholds
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Regulatory compliance export package
                        </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Step-by-step guided mobile KYC onboarding flow with instant feedback and verification status badge.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Guided document camera capture
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Fast 3D biometric selfie scan
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Real-time verification status badge
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Secure encrypted document storage
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">1</div>
                    <h3 class="oz-feat-step-title">Capture ID & Selfie</h3>
                    <p class="oz-feat-step-desc">User photographs official government ID and completes quick 3D liveness check.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">2</div>
                    <h3 class="oz-feat-step-title">Automated AI Verification</h3>
                    <p class="oz-feat-step-desc">System extracts OCR data, validates security features, and screens AML watchlists.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">3</div>
                    <h3 class="oz-feat-step-title">Instant KYC Approval</h3>
                    <p class="oz-feat-step-desc">Verified badge is issued with an immutable audit certificate for compliance records.</p>
                </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <div class="oz-feat-cta-inner">
                <div class="oz-feat-cta-badge">
                    <span class="oz-feat-cta-badge-dot"></span>
                    <span>All-Inclusive Enterprise Suite</span>
                </div>
                <h2 class="oz-feat-cta-title">Ready to Upgrade with KYC & Official Verification?</h2>
                <p class="oz-feat-cta-desc">
                    Get full access to KYC & Official Verification and all @CurrencyService.GetActiveFeaturesCount() integrated cloud capabilities with your single annual subscription. Start your 14-day free trial today.
                </p>
                <div class="oz-feat-cta-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All @CurrencyService.GetActiveFeaturesCount() Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
</div>
