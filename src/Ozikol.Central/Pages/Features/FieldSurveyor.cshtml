@page "/features/field-surveyor"
@model Ozikol.Central.Pages.Features.FieldSurveyorModel
@{
    ViewData["Title"] = "Field Enumeration & Mobile Surveyor - Ozikol BCP Feature";
    ViewData["MetaDescription"] = "Equip door-to-door field enumerators with offline mobile census tools, GPS location tagging, photo verification, and real-time cloud synchronization.";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#demographics-census">Demographics & Civic Census</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Field Enumeration & Mobile Surveyor</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Suite 09 &bull; Demographics & Civic Census
                </div>
                <h1 class="oz-feat-title">
                    Field Enumeration & Mobile Surveyor
                </h1>
                <p class="oz-feat-lead">
                    Conduct door-to-door community surveys with offline-capable mobile apps. Capture household coordinates, verify residents with photos, and auto-sync records the moment you are back online.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        <section class="oz-feat-overview-card">
            <h2>Field Operations Overview</h2>
            <p>
                Traditional field censuses suffer from clipboard fatigue and transcription errors. Ozikol equips your field enumerators with a mobile-optimized Progressive Web App and native apps that work in remote areas with zero cell coverage. Surveyors record household interviews, capture building GPS coordinates, and submit tamper-proof records with cryptographic digital timestamps.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Field-Ready Technology</div>
                <h2>Key Surveyor Capabilities</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-indigo" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                    </div>
                    <h3>100% Offline Mode</h3>
                    <p>Enumerate in rural areas or basements with zero connectivity. Data saves locally in encrypted storage and auto-uploads when Wi-Fi or cellular returns.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    </div>
                    <h3>GPS Location Pinning</h3>
                    <p>Automated high-accuracy GPS coordinates pin the exact location of each enumerated structure to prevent fictitious submissions.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-amber" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    </div>
                    <h3>Photo & Document Attachment</h3>
                    <p>Snap resident verification photos, utility bill proof of residence, or tenancy agreements directly from device cameras.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-crimson" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                    <h3>Digital Signature Capture</h3>
                    <p>Heads of household provide touch screen e-signatures attesting to the accuracy of family declarations.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-blue" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    </div>
                    <h3>Enumerator Quotas & Live Tracking</h3>
                    <p>Supervisors track field agent coverage heatmaps, daily completion targets, and average interview durations in real time.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-cyan" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                    </div>
                    <h3>Automated Duplicate Detection</h3>
                    <p>Smart algorithms detect and flag duplicate phone numbers, identical names, or overlapping street addresses immediately upon sync.</p>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="oz-feat-cta-box">
            <h2>Equip your field surveyors with Ozikol Mobile</h2>
            <p>Downloadable directly to any Android or iOS device with instant team onboarding.</p>
            <div class="oz-feat-cta-actions">
                <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All 37 Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
            </div>
        </section>
    </main>
</div>
