@page "/features/community-census"
@model Ozikol.Central.Pages.Features.CommunityCensusModel
@{
    ViewData["Title"] = "Community & Household Census - Ozikol BCP Feature";
    ViewData["MetaDescription"] = "Enumerate populations, manage household hierarchies, map residency records, and maintain verified community demographic registries with Ozikol.";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#demographics-census">Demographics & Civic Census</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Community & Household Census</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Suite 09 &bull; Demographics & Civic Census
                </div>
                <h1 class="oz-feat-title">
                    Community & Household Census
                </h1>
                <p class="oz-feat-lead">
                    Enumerate populations, structure family trees, validate residency status, and maintain an immutable demographic registry for any municipal ward, residential community, or association.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Platform Overview</h2>
            <p>
                Ozikol's Community Census platform replaces chaotic paper forms and outdated spreadsheets with a unified demographic database. Whether you are conducting a municipal town census, an estate residency registration, or a diaspora headcount, Ozikol structures data by household, verifies identities, and keeps population records up to date automatically.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Comprehensive Enumeration</div>
                <h2>Core Census Features</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-indigo" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                    </div>
                    <h3>Household & Family Trees</h3>
                    <p>Link heads of household to spouses, children, dependents, and resident domestic staff in unified genealogical trees.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <h3>Geo-Zoning & Street Clusters</h3>
                    <p>Organize populations by ward, residential street, apartment blocks, or municipal clusters with GPS coordinate bounds.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-amber" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"></rect><circle cx="9" cy="10" r="2"></circle><line x1="15" y1="8" x2="17" y2="8"></line><line x1="15" y1="12" x2="17" y2="12"></line><line x1="7" y1="16" x2="17" y2="16"></line></svg>
                    </div>
                    <h3>Residency & Tenancy Status</h3>
                    <p>Categorize individuals as owner-occupiers, long-term tenants, temporary visitors, or verified diaspora members.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-crimson" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                    <h3>Vulnerability & Social Aid Indexing</h3>
                    <p>Flag senior citizens, persons with disabilities, and low-income households for targeted community welfare and food aid.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-blue" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <h3>Privacy & GDPR Compliance</h3>
                    <p>Granular data permissioning ensures sensitive demographic information is encrypted and accessible only to certified administrators.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-cyan" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                    </div>
                    <h3>1-Click Data Import & Export</h3>
                    <p>Bulk import past paper records via CSV/Excel or export verified census registries for government or legal filings.</p>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="oz-feat-cta-box">
            <h2>Ready to conduct your community's official census?</h2>
            <p>Join hundreds of community unions, estates, and municipal bodies using Ozikol for accurate population data.</p>
            <div class="oz-feat-cta-actions">
                <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All 37 Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
            </div>
        </section>
    </main>
</div>
