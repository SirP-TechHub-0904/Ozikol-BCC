@page "/features/attendance-tracking"
@model Ozikol.Central.Pages.Features.AttendanceTrackingModel
@{
    ViewData["Title"] = "Attendance & Time Tracking - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#workforce-scheduling">Workforce, Rota & Scheduling</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Attendance & Time Tracking</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Workforce, Rota & Scheduling
                </div>
                <h1 class="oz-feat-title">
                    Attendance & Time Tracking
                </h1>
                <p class="oz-feat-lead">
                    Geo-fenced digital clock-in/out, live attendance monitoring, and timesheet sign-offs.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Accurate, tamper-proof attendance logging. Employees clock in/out via mobile with GPS geo-fencing, QR scanner, or on-site PIN kiosk. Automatically generates weekly timesheets, tracks breaks, and exports clean payroll data.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-indigo" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><rect x="9" y="11" width="6" height="4" rx="1"></rect></svg>
                    </div>
                        <h3>GPS Geo-Fenced Clock-In</h3>
                        <p>Ensures employees clock in only when within physical proximity of the work site or office.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    </div>
                        <h3>On-Site PIN & QR Kiosk</h3>
                        <p>Stationary tablet kiosk mode for warehouse, retail, or clinic entrances.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-amber" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    </div>
                        <h3>Automated Timesheets</h3>
                        <p>Converts raw punch entries into clean weekly timesheets with rounded hours and break deductions.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-crimson" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
                    </div>
                        <h3>Payroll Integration & CSV</h3>
                        <p>Export verified timesheet data directly to payroll systems with zero manual re-entry.</p>
                    </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Complete control, configuration, audit reporting, and supervisory approval queues.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Live on-site attendance roster
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Missed-punch correction tools
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Timesheet approval workflows
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Payroll export generator
                            </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Streamlined interfaces optimized for rapid collaboration and daily task execution.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> One-touch mobile punch clock
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Break start/end logger
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Review accumulated work hours
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Sign off on weekly timesheet
                            </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            1
                        </div>
                        <h3 class="oz-feat-step-title">Punch In/Out</h3>
                        <p class="oz-feat-step-desc">Staff clock in via geo-fenced mobile button or on-site entrance kiosk.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            2
                        </div>
                        <h3 class="oz-feat-step-title">Review Timesheets</h3>
                        <p class="oz-feat-step-desc">Manager reviews attendance exceptions, missed punches, and overtime.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            3
                        </div>
                        <h3 class="oz-feat-step-title">Approve for Payroll</h3>
                        <p class="oz-feat-step-desc">Timesheets are signed off and exported directly to payroll.</p>
                    </div>
            </div>
        </section>

                <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <div class="oz-feat-cta-inner">
                <div class="oz-feat-cta-badge">
                    <span class="oz-feat-cta-badge-dot"></span>
                    <span>All-Inclusive Enterprise Suite</span>
                </div>
                <h2 class="oz-feat-cta-title">Ready to Upgrade with Attendance & Time Tracking?</h2>
                <p class="oz-feat-cta-desc">
                    Get full access to Attendance & Time Tracking and all @CurrencyService.GetActiveFeaturesCount() integrated cloud capabilities with your single annual subscription. Start your 7-day free trial today.
                </p>
                <div class="oz-feat-cta-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All @CurrencyService.GetActiveFeaturesCount() Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
</div>


