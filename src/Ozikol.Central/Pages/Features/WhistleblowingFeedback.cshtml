@page "/features/whistleblowing-feedback"
@model Ozikol.Central.Pages.Features.WhistleblowingFeedbackModel
@{
    ViewData["Title"] = "Anonymous Whistleblowing & Feedback - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#people-community">People, Community & Collaboration</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Anonymous Whistleblowing & Feedback</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    People, Community & Collaboration
                </div>
                <h1 class="oz-feat-title">
                    Anonymous Whistleblowing & Feedback
                </h1>
                <p class="oz-feat-lead">
                    Encrypted, anonymous reporting and secure two-way feedback.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Protect organizational integrity with a secure, anonymous reporting portal. Enables employees, members, and external stakeholders to submit encrypted reports for safety, ethical, or compliance issues with zero identity exposure.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-indigo" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><rect x="9" y="11" width="6" height="4" rx="1"></rect></svg>
                    </div>
                        <h3>End-to-End Encryption</h3>
                        <p>Reports are encrypted with zero IP address logging or identifiable metadata tracking.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 2-2 2m-1.5 1.5L14 9l-2-2-4 4 2 2-3 3 1.5 1.5L10 16l2 2 3.5-3.5"></path><circle cx="7.5" cy="16.5" r="4.5"></circle></svg>
                    </div>
                        <h3>Anonymous Tracking Key</h3>
                        <p>Whistleblowers receive a 16-character cryptographic key to check case progress securely.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-amber" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    </div>
                        <h3>Two-Way Anonymous Chat</h3>
                        <p>Investigators communicate directly with the whistleblower without uncovering their identity.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon oz-icon-crimson" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                        <h3>Evidence Locker</h3>
                        <p>Securely upload PDF receipts, images, and audio/video evidence with metadata stripping.</p>
                    </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Complete control, configuration, audit reporting, and supervisory approval queues.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Triage report queue
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Assign internal investigators
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Anonymous two-way messaging
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Audit trail & compliance logs
                            </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Streamlined interfaces optimized for rapid collaboration and daily task execution.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Submit encrypted incident report
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Track case via private key
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Reply to investigator queries
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Attach sanitized evidence
                            </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            1
                        </div>
                        <h3 class="oz-feat-step-title">Submit Incident</h3>
                        <p class="oz-feat-step-desc">User submits an encrypted report and receives a secret tracking code.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            2
                        </div>
                        <h3 class="oz-feat-step-title">Triage & Investigate</h3>
                        <p class="oz-feat-step-desc">Compliance officer reviews the case and asks questions anonymously.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            3
                        </div>
                        <h3 class="oz-feat-step-title">Resolution & Audit</h3>
                        <p class="oz-feat-step-desc">Case is investigated, actions are logged, and the case is closed securely.</p>
                    </div>
            </div>
        </section>

                <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <div class="oz-feat-cta-inner">
                <div class="oz-feat-cta-badge">
                    <span class="oz-feat-cta-badge-dot"></span>
                    <span>All-Inclusive Enterprise Suite</span>
                </div>
                <h2 class="oz-feat-cta-title">Ready to Upgrade with Anonymous Whistleblowing & Feedback?</h2>
                <p class="oz-feat-cta-desc">
                    Get full access to Anonymous Whistleblowing & Feedback and all @CurrencyService.GetActiveFeaturesCount() integrated cloud capabilities with your single annual subscription. Start your 7-day free trial today.
                </p>
                <div class="oz-feat-cta-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All @CurrencyService.GetActiveFeaturesCount() Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
</div>


