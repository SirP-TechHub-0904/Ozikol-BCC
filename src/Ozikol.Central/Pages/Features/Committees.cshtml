@page "/features/committees"
@model Ozikol.Central.Pages.Features.CommitteesModel
@{
    ViewData["Title"] = "Committees & Sub-Groups - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#people-community">People, Community & Collaboration</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Committees & Sub-Groups</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-icon-badge"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg></div>
<div class="oz-feat-suite-pill">
                    People, Community & Collaboration
                </div>
                <h1 class="oz-feat-title">
                    Committees & Sub-Groups
                </h1>
                <p class="oz-feat-lead">
                    Manage committee leadership, meeting schedules, minutes, and resolutions.
                </p>
                <div class="oz-feat-actions">
                    <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Demo</a>
                    <a href="#capabilities" class="btn btn-secondary--alt">Explore Capabilities</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Streamline organizational governance. Manage executive committees, boards, task forces, and working groups with structured rosters, automated meeting reminders, agenda distribution, minutes documentation, and resolution tracking.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Roster & Leadership Structure</h3>
                        <p>Define committee chairs, secretaries, voting members, and advisory roles with term limits.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Meeting Agendas & Scheduling</h3>
                        <p>Schedule recurring meetings, sync with personal calendars, and distribute pre-read packs.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Minutes & Document Repository</h3>
                        <p>Upload official meeting minutes, record attendance, and maintain an immutable historical archive.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Resolution Tracking</h3>
                        <p>Track formal board resolutions from proposal through vote, implementation, and sign-off.</p>
                    </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Complete control, configuration, audit reporting, and supervisory approval queues.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Create & manage committees
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Appoint leadership & members
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Publish official resolutions
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Monitor governance compliance
                            </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Streamlined interfaces optimized for rapid collaboration and daily task execution.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> View committee assignments
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Download agendas and minutes
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> RSVP to scheduled meetings
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Submit agenda items
                            </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            1
                        </div>
                        <h3 class="oz-feat-step-title">Establish Committee</h3>
                        <p class="oz-feat-step-desc">Configure terms of reference, assign leadership, and invite voting members.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            2
                        </div>
                        <h3 class="oz-feat-step-title">Convene & Document</h3>
                        <p class="oz-feat-step-desc">Host structured meetings, record attendance, and circulate draft minutes.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            3
                        </div>
                        <h3 class="oz-feat-step-title">Adopt Resolutions</h3>
                        <p class="oz-feat-step-desc">Formally pass resolutions and track post-meeting action items.</p>
                    </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <h2>50</h2>
            <p>36</p>
            <div class="oz-feat-cta-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Contact Sales</a>
                <a href="/features" class="btn btn-secondary--alt">View All Features</a>
            </div>
        </section>
    </main>
</div>


