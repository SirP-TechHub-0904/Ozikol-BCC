@page "/features/bio-link-tree"
@model Ozikol.Central.Pages.Features.BioLinkTreeModel
@{
    ViewData["Title"] = "Bio Link Hub (Link Tree) - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#communication-ai">Communication, AI & Support</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Bio Link Hub (Link Tree)</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-icon-badge"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg></div>
<div class="oz-feat-suite-pill">
                    Communication, AI & Support
                </div>
                <h1 class="oz-feat-title">
                    Bio Link Hub (Link Tree)
                </h1>
                <p class="oz-feat-lead">
                    Single-link customizable bio page to showcase all your links, socials, products, and campaigns.
                </p>
                <div class="oz-feat-actions">
                    <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Demo</a>
                    <a href="#capabilities" class="btn btn-secondary--alt">Explore Capabilities</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Consolidate your entire digital presence into a single high-converting micro-landing page. Perfect for social media bios (Instagram, X/Twitter, TikTok, YouTube). Add unlimited custom links, embed YouTube videos, showcase products, collect email newsletter subscribers, and receive tip donations with real-time analytics.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Customizable Bio Micro-Page</h3>
                        <p>Drag-and-drop link builder with custom themes, colors, typography, avatar logos, and custom domains.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Rich Media & Social Embeds</h3>
                        <p>Embed YouTube videos, Spotify playlists, podcast episodes, and social media profile icons.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Monetization & Tip Jar</h3>
                        <p>Direct buttons for digital product sales, event ticket checkouts, and supporter tips.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Click Analytics & UTM Tracking</h3>
                        <p>Real-time dashboard tracking page visits, individual link clicks, CTR percentages, and visitor geolocations.</p>
                    </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Complete control, configuration, audit reporting, and supervisory approval queues.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Design bio page themes
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Track multi-link click analytics
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Manage custom domain mapping
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Export subscriber lead lists
                            </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Streamlined interfaces optimized for rapid collaboration and daily task execution.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Update bio profile & links
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Reorder links with drag-and-drop
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Embed latest media releases
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Review real-time link clicks
                            </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            1
                        </div>
                        <h3 class="oz-feat-step-title">Design Bio Page</h3>
                        <p class="oz-feat-step-desc">Customize your avatar, bio description, background theme, and brand color palette.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            2
                        </div>
                        <h3 class="oz-feat-step-title">Add Links & Media</h3>
                        <p class="oz-feat-step-desc">Add destination URLs, embed media players, and insert payment or donation buttons.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            3
                        </div>
                        <h3 class="oz-feat-step-title">Share & Analyze</h3>
                        <p class="oz-feat-step-desc">Place your bio link in social profiles and track live click-through engagement.</p>
                    </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <h2>50</h2>
            <p>36</p>
            <div class="oz-feat-cta-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Contact Sales</a>
                <a href="/features" class="btn btn-secondary--alt">View All Features</a>
            </div>
        </section>
    </main>
</div>


