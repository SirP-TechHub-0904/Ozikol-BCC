@page "/features/reference-forms"
@model Ozikol.Central.Pages.Features.ReferenceFormsModel
@{
    ViewData["Title"] = "Reference Form System - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#suite-reports">Reports, Forms & Analytics</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Reference Form System</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Reports, Forms & Analytics
                </div>
                <h1 class="oz-feat-title">
                    Reference Form System
                </h1>
                <p class="oz-feat-lead">
                    Custom reference form builder, secure referee magic links, automated verification workflows, and structured audit dossiers.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Streamline and digitize employment, character, and membership vetting. Design custom reference questionnaires, securely dispatch magic links to referees, track completion status in real-time, and generate consolidated compliance dossiers with IP and timestamp verification.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-purple" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    </div>
                    <h3>Drag-and-Drop Form Designer</h3>
                    <p>Build tailored reference questionnaires with rating scales, conditional logic, and required file uploads.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-indigo" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                    </div>
                    <h3>Referee Magic Link Portals</h3>
                    <p>Secure, passwordless mobile portals enabling external referees to provide feedback in minutes.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-amber" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                    <h3>Automated Chasing & Reminders</h3>
                    <p>Automated SMS and email cadences dispatched to referees until references are completed.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                    </div>
                    <h3>Consolidated Compliance Dossiers</h3>
                    <p>Generate downloadable PDF verification packages complete with digital timestamps and audit trails.</p>
                </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Complete form lifecycle management, candidate vetting pipeline, and compliance verification dossiers.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Custom reference form template builder
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Real-time referee response tracker & pipeline
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Automated referee follow-up & reminder rules
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Tamper-evident PDF dossier export
                        </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Simple portal for candidates to submit referee contact details and monitor verification progress.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Easy referee nomination submission
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Real-time reference progress tracking
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Change / re-send referee request links
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Mobile-friendly status notifications
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">1</div>
                    <h3 class="oz-feat-step-title">Design Form Template</h3>
                    <p class="oz-feat-step-desc">Configure tailored questions, rating scales, and required verification criteria.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">2</div>
                    <h3 class="oz-feat-step-title">Dispatch Magic Links</h3>
                    <p class="oz-feat-step-desc">Nominated referees receive secure magic links to complete forms on any device.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">3</div>
                    <h3 class="oz-feat-step-title">Generate Dossier</h3>
                    <p class="oz-feat-step-desc">Responses are verified, digitally signed, and compiled into compliance dossiers.</p>
                </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <div class="oz-feat-cta-inner">
                <div class="oz-feat-cta-badge">
                    <span class="oz-feat-cta-badge-dot"></span>
                    <span>All-Inclusive Enterprise Suite</span>
                </div>
                <h2 class="oz-feat-cta-title">Ready to Upgrade with Reference Form System?</h2>
                <p class="oz-feat-cta-desc">
                    Get full access to Reference Form System and all @CurrencyService.GetActiveFeaturesCount() integrated cloud capabilities with your single annual subscription. Start your 7-day free trial today.
                </p>
                <div class="oz-feat-cta-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All @CurrencyService.GetActiveFeaturesCount() Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
</div>
