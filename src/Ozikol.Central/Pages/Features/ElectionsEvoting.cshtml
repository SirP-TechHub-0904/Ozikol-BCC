@page "/features/elections-evoting"
@model Ozikol.Central.Pages.Features.ElectionsEvotingModel
@{
    ViewData["Title"] = "Elections & E-Voting - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#operations-workflows">Operations & Workflows</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Elections & E-Voting</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-icon-badge"><svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg></div>
<div class="oz-feat-suite-pill">
                    Operations & Workflows
                </div>
                <h1 class="oz-feat-title">
                    Elections & E-Voting
                </h1>
                <p class="oz-feat-lead">
                    Secure cryptographic voting, voter accreditation, and live certified tallying.
                </p>
                <div class="oz-feat-actions">
                    <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Demo</a>
                    <a href="#capabilities" class="btn btn-secondary--alt">Explore Capabilities</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Conduct tamper-evident, verifiable digital elections. Perfect for board elections, AGM resolutions, union votes, and executive leadership ballots. Includes voter accreditation, encrypted ballot secrecy, and audit receipts.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Ballot Builder & Candidate Bios</h3>
                        <p>Configure multi-candidate races, preferential voting, or yes/no referendums with candidate manifestos.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Voter Accreditation & Tokens</h3>
                        <p>Ensure only eligible members vote with unique one-time cryptographic voting tokens.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Cryptographic Ballot Secrecy</h3>
                        <p>Zero voter-identity link to ballot selections ensuring 100% ballot privacy.</p>
                    </div>
                    <div class="oz-feat-card">
                        <div class="oz-feat-card-icon">
                            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        </div>
                        <h3>Live Certified Tally & Receipts</h3>
                        <p>Instant auditable vote tally with downloadable verification receipts for voters.</p>
                    </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Complete control, configuration, audit reporting, and supervisory approval queues.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Configure election ballots
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Accredit eligible voter rolls
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Monitor live voter turnout
                            </li>
                            <li class="oz-feat-list-item-dark">
                                <span class="oz-feat-check">&#10003;</span> Certify & publish results
                            </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Streamlined interfaces optimized for rapid collaboration and daily task execution.</p>
                    <ul class="oz-feat-list">
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Review candidate manifestos
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Cast secret digital ballot
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> Receive verifiable vote receipt
                            </li>
                            <li class="oz-feat-list-item-light">
                                <span class="oz-feat-check">&#10003;</span> View certified election results
                            </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            1
                        </div>
                        <h3 class="oz-feat-step-title">Build Ballot</h3>
                        <p class="oz-feat-step-desc">Define candidates, voting rules, eligibility criteria, and open/close dates.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            2
                        </div>
                        <h3 class="oz-feat-step-title">Accredit Voters</h3>
                        <p class="oz-feat-step-desc">Eligible voters receive secure one-time voting credentials.</p>
                    </div>
                    <div class="oz-feat-step-card">
                        <div class="oz-feat-step-num">
                            3
                        </div>
                        <h3 class="oz-feat-step-title">Vote & Tally</h3>
                        <p class="oz-feat-step-desc">Voters cast encrypted ballots, and the system tallies certified results instantly.</p>
                    </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <h2>50</h2>
            <p>36</p>
            <div class="oz-feat-cta-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Contact Sales</a>
                <a href="/features" class="btn btn-secondary--alt">View All Features</a>
            </div>
        </section>
    </main>
</div>


