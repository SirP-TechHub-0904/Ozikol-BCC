@page "/features/wedding-celebration-portals"
@model Ozikol.Central.Pages.Features.WeddingCelebrationPortalsModel
@{
    ViewData["Title"] = "Weddings & Celebration Portals - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#life-events-publications">Life Events & Publications</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Weddings & Celebration Portals</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Life Events & Digital Publications
                </div>
                <h1 class="oz-feat-title">
                    Weddings & Celebration Portals
                </h1>
                <p class="oz-feat-lead">
                    Elevate weddings, anniversaries, and galas with digital invitations, interactive programs of the day, in-app live camera capture, and real-time guest photo streams.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="oz-feat-body">
        <section class="oz-feat-overview-card">
            <h2>Seamless Celebration Experiences from RSVP to Live Photo Wall</h2>
            <p>
                Ozikol's Wedding & Celebration Portals provide couples and event organizers with a complete digital command center. From digital invitations and seating management to in-app camera snapping where guests take photos live from their browser, every detail of your special day is synchronized.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-section">
            <h2 class="oz-feat-section-title">Core Capabilities</h2>
            
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                    </div>
                    <h3>In-App Live Camera Photo Capture</h3>
                    <p>Guests scan a QR code or click a event link to open an online camera interface right in their mobile browser—snap photos directly from the app and instantly stream them to the live venue projector photo wall.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    </div>
                    <h3>Digital Invites & RSVP Management</h3>
                    <p>Send branded web invitations, track guest responses, manage dietary preferences, plus-one counts, and automated SMS/email reminders.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                    <h3>Program of the Day & Order of Service</h3>
                    <p>Interactive event timeline, venue directions, ceremony schedules, speech lineups, and party details accessible on any smartphone.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>
                    </div>
                    <h3>Digital Guestbook & Well Wishes</h3>
                    <p>Collect digital signatures, written wishes, and video toasts from attendees both in person and joining remotely around the world.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                    </div>
                    <h3>Gift Registry & Honeymoon Fund</h3>
                    <p>Integrate direct links to commercial registries, custom gift lists, or secure cash contribution funds for the celebrating couple.</p>
                </div>

                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    </div>
                    <h3>Downloadable Event Souvenirs & PDF</h3>
                    <p>Allow guests to download high-resolution event brochures, commemorative programs, and curated photo albums as PDF files after the celebration.</p>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="oz-feat-cta">
            <h2>Plan Your Celebration with Ozikol</h2>
            <p>Create your custom wedding or celebration portal with digital invites, live camera capture, and digital programs.</p>
            <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                <span>Deploy Sovereign Workspace</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
        </section>
    </main>
</div>
