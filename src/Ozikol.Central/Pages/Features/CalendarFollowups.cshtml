@page "/features/calendar-followups"
@model Ozikol.Central.Pages.Features.CalendarFollowupsModel
@{
    ViewData["Title"] = "Calendar & Follow-Up Routine - Ozikol BCP Feature";
}

<div class="feature-detail-page">
    <!-- Breadcrumb & Back Link -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-breadcrumb-wrap">
            <div class="oz-breadcrumb-trail">
                <a href="/features">Features</a>
                <span>&rsaquo;</span>
                <a href="/features#suite-workforce">Workforce, Rota & Scheduling</a>
                <span>&rsaquo;</span>
                <span class="oz-breadcrumb-current">Calendar & Follow-Up Routine</span>
            </div>
            <partial name="_BackToFeaturesLink" />
        </div>
    </div>

    <!-- Hero Section -->
    <section class="oz-feat-hero">
        <div class="oz-feat-hero-container">
            <div class="oz-feat-hero-content">
                <div class="oz-feat-suite-pill">
                    Workforce, Rota & Scheduling
                </div>
                <h1 class="oz-feat-title">
                    Calendar & Follow-Up Routine
                </h1>
                <p class="oz-feat-lead">
                    Bi-directional calendar integration with Google Calendar and Microsoft Outlook, smart booking links, and automated follow-up cadences.
                </p>
                <div class="oz-feat-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="#capabilities" class="oz-btn-outline-hero">
                        <span>Explore Capabilities</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Body -->
    <main class="oz-feat-body">
        
        <!-- Overview & Context -->
        <section class="oz-feat-overview-card">
            <h2>Feature Overview</h2>
            <p>
                Unify organizational appointments and automated follow-up cadences. Seamlessly synchronizes with Google Calendar, Microsoft Outlook, and Apple iCal, providing automated reminders, appointment booking pages, and intelligent routine follow-up triggers for staff and clients.
            </p>
        </section>

        <!-- Key Capabilities Grid -->
        <section id="capabilities" class="oz-feat-capabilities-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Built for Performance</div>
                <h2>Core Capabilities</h2>
                <p class="oz-feat-card-desc">Everything you need to operate efficiently without complex third-party bolt-ons.</p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-blue" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    </div>
                    <h3>2-Way Google & Outlook Sync</h3>
                    <p>Real-time bi-directional synchronization preventing double bookings across personal and work calendars.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-indigo" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 17H2a3 3 0 0 0 3-3V9a7 7 0 0 1 14 0v5a3 3 0 0 0 3 3zm-8.27 4a2 2 0 0 1-3.46 0"></path></svg>
                    </div>
                    <h3>Automated Follow-Up Cadences</h3>
                    <p>Trigger customizable follow-up SMS, emails, and reminders based on event completion or no-show status.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-emerald" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                    </div>
                    <h3>Smart Booking Links</h3>
                    <p>Shareable appointment booking links with customizable availability buffers and time zone detection.</p>
                </div>
                <div class="oz-feat-card">
                    <div class="oz-feat-card-icon oz-icon-purple" aria-hidden="true">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                    </div>
                    <h3>Recurring Routine Workflows</h3>
                    <p>Schedule recurring audits, check-ins, and client reviews with automated escalation rules.</p>
                </div>
            </div>
        </section>

        <!-- Dual View: Console vs Workspace -->
        <section class="oz-feat-dual-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Tailored User Experiences</div>
                <h2>Console & Workspace Views</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-dual-grid dual-view-grid">
                <div class="oz-feat-console-card">
                    <div class="oz-feat-suite-pill">
                        Console View (Admins & Managers)
                    </div>
                    <h3 class="oz-feat-console-title">Administrative Oversight</h3>
                    <p class="oz-feat-console-desc">Complete control, configuration, calendar sync auditing, and organization-wide schedule visibility.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Organization-wide unified calendar view
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Automated follow-up rule builder & triggers
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> External calendar sync status & audit logs
                        </li>
                        <li class="oz-feat-list-item-dark">
                            <span class="oz-feat-check">&#10003;</span> Missed follow-up escalation tracking
                        </li>
                    </ul>
                </div>
                <div class="oz-feat-workspace-card">
                    <div class="oz-feat-suite-pill">
                        Workspace View (Employees & Members)
                    </div>
                    <h3 class="oz-feat-workspace-title">User Self-Service</h3>
                    <p class="oz-feat-workspace-desc">Streamlined calendar interface for quick booking, availability setting, and follow-up management.</p>
                    <ul class="oz-feat-list">
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> One-click Google / Outlook calendar integration
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Personal booking page link generation
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Automated follow-up task checklist
                        </li>
                        <li class="oz-feat-list-item-light">
                            <span class="oz-feat-check">&#10003;</span> Mobile appointment notifications & reminders
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3-Step Workflow -->
        <section class="oz-feat-steps-section">
            <div class="oz-feat-section-header">
                <div class="oz-feat-tagline">Process Flow</div>
                <h2>How It Works</h2>
                <p class="oz-feat-card-desc"></p>
            </div>
            <div class="oz-feat-grid">
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">1</div>
                    <h3 class="oz-feat-step-title">Connect Calendars</h3>
                    <p class="oz-feat-step-desc">Link Google Calendar, Microsoft Outlook, or Apple iCal in seconds with OAuth2.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">2</div>
                    <h3 class="oz-feat-step-title">Configure Follow-Up Cadence</h3>
                    <p class="oz-feat-step-desc">Set automated multi-channel follow-up reminders before and after appointments.</p>
                </div>
                <div class="oz-feat-step-card">
                    <div class="oz-feat-step-num">3</div>
                    <h3 class="oz-feat-step-title">Synchronize & Execute</h3>
                    <p class="oz-feat-step-desc">Events sync bi-directionally in real-time while routine follow-ups execute automatically.</p>
                </div>
            </div>
        </section>

        <!-- Bottom CTA -->
        <section class="oz-feat-cta-banner">
            <div class="oz-feat-cta-inner">
                <div class="oz-feat-cta-badge">
                    <span class="oz-feat-cta-badge-dot"></span>
                    <span>All-Inclusive Enterprise Suite</span>
                </div>
                <h2 class="oz-feat-cta-title">Ready to Upgrade with Calendar & Follow-Up Routine?</h2>
                <p class="oz-feat-cta-desc">
                    Get full access to Calendar & Follow-Up Routine and all @CurrencyService.GetActiveFeaturesCount() integrated cloud capabilities with your single annual subscription. Start your 7-day free trial today.
                </p>
                <div class="oz-feat-cta-actions">
                    <a href="/@Model.CurrentCulture/register" class="oz-btn-primary-hero">
                        <span>Start 14-Day Free Trial</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/@Model.CurrentCulture/features" class="oz-btn-outline-hero">
                        <span>View All @CurrencyService.GetActiveFeaturesCount() Features</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
</div>
