@page
@model Ozikol.Central.Pages.FeaturesModel
@{
    ViewData["Title"] = "Executive MIS Features - Ozikol BCC Cloud";
}

<div class="marketing-page">
    <section class="page-hero-section">
        <div class="marketing-container">
            <span class="section-badge">MODULAR MIS PLATFORM</span>
            <h1 class="page-hero-title">Everything Your Organization Needs to Operate & Scale</h1>
            <p class="page-hero-sub">
                From executive financial governance to customer storefronts and member management, explore the full suite of Ozikol BCC capabilities.
            </p>
        </div>
    </section>

    <section class="section-marketing">
        <div class="marketing-container">
            <div class="features-grid">
                <div class="feature-detail-card">
                    <div class="feature-badge-row">
                        <span class="feature-icon-badge">💳</span>
                        <span class="feature-tag">FINANCIAL LEDGER</span>
                    </div>
                    <h3 class="feature-title">Multi-Tier Finance & Invoicing</h3>
                    <p class="feature-desc">
                        Full double-entry ledger records, transaction audit trails, automated invoicing, multi-currency conversion, payment gateway integration, and real-time revenue projection graphs.
                    </p>
                    <ul class="feature-list">
                        <li>✓ Automated recurring subscription billing</li>
                        <li>✓ Real-time ledger audit logs</li>
                        <li>✓ Multi-gateway support (Stripe, Paystack, PayPal)</li>
                    </ul>
                </div>

                <div class="feature-detail-card">
                    <div class="feature-badge-row">
                        <span class="feature-icon-badge">🛍️</span>
                        <span class="feature-tag">COMMERCE & PRODUCTS</span>
                    </div>
                    <h3 class="feature-title">Integrated Storefront & Digital Products</h3>
                    <p class="feature-desc">
                        Manage physical inventory, digital downloads, software licenses, categories, product variants, and promotional discount codes seamlessly within your executive dashboard.
                    </p>
                    <ul class="feature-list">
                        <li>✓ Digital licenses and instant download fulfillment</li>
                        <li>✓ Inventory tracking with stock threshold alerts</li>
                        <li>✓ Category taxonomy and variant pricing</li>
                    </ul>
                </div>

                <div class="feature-detail-card">
                    <div class="feature-badge-row">
                        <span class="feature-icon-badge">👥</span>
                        <span class="feature-tag">MEMBERS & ROLES</span>
                    </div>
                    <h3 class="feature-title">Role Governance & Identity Security</h3>
                    <p class="feature-desc">
                        Granular ASP.NET Core Identity with role-based access control (SuperAdmin, Admin, Manager, Member), compulsory two-factor authentication, and user profile management.
                    </p>
                    <ul class="feature-list">
                        <li>✓ Compulsory 2FA (Google/Microsoft Authenticator & Email)</li>
                        <li>✓ Granular permission policies per module</li>
                        <li>✓ User activity timelines and login audits</li>
                    </ul>
                </div>

                <div class="feature-detail-card">
                    <div class="feature-badge-row">
                        <span class="feature-icon-badge">🎨</span>
                        <span class="feature-tag">DYNAMIC CMS</span>
                    </div>
                    <h3 class="feature-title">Customizable Web Pages & Themes</h3>
                    <p class="feature-desc">
                        Dynamic website content management system with drag-and-drop hero sliders, custom navigation links, footer builders, and instant theme switching from the Marketplace.
                    </p>
                    <ul class="feature-list">
                        <li>✓ One-click template layout activation</li>
                        <li>✓ SEO meta tag configuration and sitemap generation</li>
                        <li>✓ Dynamic media library with Cloudinary & S3 support</li>
                    </ul>
                </div>
            </div>

            <div class="bottom-cta-card" style="margin-top: 48px;">
                <h2 class="bottom-cta-title">Experience the Power of Ozikol BCC</h2>
                <p class="bottom-cta-sub">Start managing your organization with our executive MIS cloud today.</p>
                <a asp-page="/Signup" class="btn-hero-primary" style="margin-top: 16px;">
                    <span>Get Started to Own Your MIS</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </section>
</div>
