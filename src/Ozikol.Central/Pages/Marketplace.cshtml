                    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=600&q=80" alt="Apex Glassmorphism Sticky Navbar" loading="lazy" />
                    <span class="template-card__badge">Popular</span>
                </div>
                <div class="template-card__body">
                    <div class="template-card__category">Menu / Navigation</div>
                    <h3 class="template-card__title">Apex Glassmorphism Sticky Navbar</h3>
                    <p class="template-card__desc">Translucent frosted glass sticky navigation with company branding, 5 primary links, user profile badge, and call-to-action button.</p>
                    <div class="template-card__tags">
                        <span class="tpl-tag">Backdrop Blur</span><span class="tpl-tag">Sticky Header</span><span class="tpl-tag">Responsive Drawer</span>
                    </div>
                    <div class="template-card__actions">
                        <button type="button" class="btn-install js-installBtn" data-template-name="Apex Glassmorphism Sticky Navbar">
