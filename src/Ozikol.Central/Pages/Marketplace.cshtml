@page "/marketplace"
@model Ozikol.Central.Pages.MarketplaceModel
@{
    ViewData["Title"] = "UI Marketplace - Blueprints & Pre-Built Page Sections";
}

<div class="marketplace-page">
    <!-- Hero Banner -->
    <section class="branded-banner branded-banner--evo" style="background: linear-gradient(135deg, #090d16 0%, #150f24 50%, #1f0817 100%); color: #ffffff; padding: 75px 0 55px 0; text-align: center; position: relative; overflow: hidden;">
        <div class="container" style="position: relative; z-index: 2; max-width: 960px; margin: 0 auto; padding: 0 20px;">
            <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(229, 23, 63, 0.15); border: 1px solid rgba(229, 23, 63, 0.4); border-radius: 9999px; padding: 6px 16px; margin-bottom: 20px; font-size: 13.5px; font-weight: 700; color: #ff5277; text-transform: uppercase; letter-spacing: 0.05em;">
                <span style="display: inline-block; width: 8px; height: 8px; background: #e5173f; border-radius: 50%;"></span>
                Ozikol Cloud UI Marketplace
            </div>
            <h1 style="font-size: 46px; font-weight: 800; line-height: 1.15; margin-bottom: 18px; letter-spacing: -0.03em;">
                Pre-Built UI Components & <span style="color: #e5173f;">Page Templates</span>
            </h1>
            <p style="font-size: 18px; line-height: 1.6; color: #cbd5e1; max-width: 740px; margin: 0 auto 30px auto;">
                Instant-install layout blueprints, sticky navigation bars, responsive hero sections, pricing tables, and multi-column footers ready for your workspace.
            </p>
            <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
                <a href="#marketplace-grid" class="btn btn-primary" style="padding: 13px 28px; font-size: 15px;">Browse 8 Templates</a>
                <a href="#how-it-works" class="btn btn-secondary--alt" style="padding: 13px 28px; font-size: 15px; border: 1px solid rgba(255,255,255,0.3); color: #fff;">How It Works</a>
            </div>
        </div>
    </section>

    <!-- How the UI Marketplace Works -->
    <section id="how-it-works" style="background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 48px 0;">
        <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
            <div style="text-align: center; margin-bottom: 36px;">
                <div style="font-size: 12px; font-weight: 700; color: #e5173f; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;">Seamless Integration</div>
                <h2 style="font-size: 28px; font-weight: 800; color: #0f172a; margin: 0;">How the UI Marketplace Works</h2>
            </div>
            <div class="how-it-works-grid">
                <div class="step-card">
                    <div class="step-badge">01</div>
                    <h3>Browse & Preview</h3>
                    <p>Filter through 7 UI categories including navigation bars, split heroes, bento grids, and responsive footers.</p>
                </div>
                <div class="step-card">
                    <div class="step-badge">02</div>
                    <h3>1-Click Installation</h3>
                    <p>Click the <strong>Install Template</strong> button on any blueprint to automatically import the HTML/CSS structure into your workspace.</p>
                </div>
                <div class="step-card">
                    <div class="step-badge">03</div>
                    <h3>Customize & Launch</h3>
                    <p>Adjust colors, fonts, and content copy to match your organization's brand identity, then publish live in seconds.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Category Filter Bar -->
    <nav style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; position: sticky; top: 70px; z-index: 30; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
        <div class="container" style="max-width: 1240px; margin: 0 auto; padding: 14px 20px; overflow-x: auto; white-space: nowrap; scrollbar-width: none;">
            <div style="display: flex; gap: 8px; align-items: center;" id="categoryTabs">
                <button type="button" class="cat-filter-btn active" data-filter="all">All Templates (8)</button>
                <button type="button" class="cat-filter-btn" data-filter="menu">Menu / Nav</button>
                <button type="button" class="cat-filter-btn" data-filter="hero">Hero / Sliders</button>
                <button type="button" class="cat-filter-btn" data-filter="bodysections">Body Sections</button>
                <button type="button" class="cat-filter-btn" data-filter="marquee">Marquee & Tickers</button>
                <button type="button" class="cat-filter-btn" data-filter="contactus">Contact & Booking</button>
                <button type="button" class="cat-filter-btn" data-filter="footer">Footers</button>
            </div>
        </div>
    </nav>

    <!-- Template Grid Section -->
    <main id="marketplace-grid" class="container" style="max-width: 1240px; margin: 40px auto; padding: 0 20px;">
        <div class="marketplace-grid-layout">
            <article class="template-card" data-category="menu">
