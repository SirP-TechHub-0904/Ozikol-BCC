        <div class="preview-modal-header">
            <div class="preview-header-left">
                <span id="modalCategoryBadge" class="modal-category-badge">Category</span>
                <h3 id="modalTemplateTitle" class="modal-template-title">Template Title</h3>
            </div>
            
            <!-- Code vs Preview Tabs & Device Switcher -->
            <div class="preview-center-controls">
                <!-- Mode Tabs -->
                <div class="mode-tabs-group">
                    <button type="button" class="mode-tab-btn active" data-mode="preview">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        <span>Preview</span>
                    </button>
                    <button type="button" class="mode-tab-btn" data-mode="html">
                        <span>HTML</span>
                    </button>
                    <button type="button" class="mode-tab-btn" data-mode="css">
                        <span>CSS</span>
                    </button>
                    <button type="button" class="mode-tab-btn" data-mode="js">
                        <span>JS</span>
                    </button>
                </div>

                <!-- Viewport Switcher (Visible in Preview mode) -->
                <div id="viewportControls" class="preview-viewport-controls">
                    <button type="button" class="viewport-btn active" data-width="100%">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        <span>Desktop</span>
                    </button>
                    <button type="button" class="viewport-btn" data-width="768px">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                        <span>Tablet</span>
                    </button>
                    <button type="button" class="viewport-btn" data-width="375px">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                        <span>Mobile</span>
                    </button>
                </div>
            </div>

            <!-- Modal Action Buttons -->
            <div class="preview-header-right">
                <button type="button" id="copyCodeBtn" class="btn-copy-code" style="display: none;">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                    <span>Copy Code</span>
                </button>
                <button type="button" id="modalInstallBtn" class="btn-modal-install">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    <span>Install Template</span>
                </button>
                <button type="button" id="closeModalBtn" class="btn-modal-close" aria-label="Close Preview">&times;</button>
            </div>
        </div>

        <!-- Modal Body Container -->
        <div class="preview-modal-body">
            <!-- Visual Interactive Sandbox Pane -->
            <div id="previewPane" class="tab-pane active" style="width: 100%;">
                <div id="previewSandboxFrame" class="preview-sandbox-frame">
                    <div id="sandboxRenderArea" class="sandbox-render-area">
                        <!-- Live Component Mockup -->
                    </div>
                </div>
            </div>

            <!-- Code Inspector Pane -->
            <div id="codePane" class="tab-pane" style="display: none; width: 100%;">
                <div class="code-viewer-container">
                    <pre><code id="codeContent" class="code-block"></code></pre>
                </div>
            </div>
        </div>

        <!-- Modal Footer Summary -->
        <div class="preview-modal-footer">
            <p id="modalTemplateDesc">Template description and configuration details.</p>
            <span class="preview-shortcut-hint">Press <kbd>ESC</kbd> to exit preview</span>
        </div>
    </div>
</div>

<!-- Install Toast / Feedback -->
<div id="installToast" style="display: none; position: fixed; bottom: 30px; right: 30px; background: #0f172a; color: #ffffff; padding: 16px 24px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); z-index: 20000; border: 1px solid #334155; align-items: center; gap: 12px; animation: slideUp 0.3s ease;">
    <div style="width: 28px; height: 28px; border-radius: 50%; background: #22c55e; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px;">&#10003;</div>
    <div>
        <div id="toastTitle" style="font-weight: 700; font-size: 14px;">Template Installed</div>
        <div id="toastDesc" style="font-size: 12.5px; color: #94a3b8;">Blueprint imported successfully to your workspace.</div>
    </div>
</div>

<style>
