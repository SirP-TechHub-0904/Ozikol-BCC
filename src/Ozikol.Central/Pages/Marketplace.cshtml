;&quot;>                 <h1 style=&quot;font-size: 34px; font-weight: 800; color: #0f172a; margin-bottom: 12px; letter-spacing: -0.02em;&quot;>Translucent Sticky Navigation</h1>                 <p style=&quot;color: #64748b; font-size: 16px; max-width: 520px; margin: 0 auto 24px auto;&quot;>Scrolls with page content and renders a high-clarity frosted glass blur over underlying elements.</p>                 <button style=&quot;background: #0f172a; color: #fff; border: none; padding: 12px 24px; border-radius: 8px; font-weight: 700; font-size: 14px;&quot;>Explore Interactive Showcase</button>             </div>         </div>         "
                                data-html-code="<header class=&quot;apex-glass-nav&quot;>&#10;  <div class=&quot;container nav-flex&quot;>&#10;    <a href=&quot;/&quot; class=&quot;nav-brand&quot;>ApexCloud</a>&#10;    <nav class=&quot;nav-links&quot;>&#10;      <a href=&quot;#features&quot; class=&quot;active&quot;>Features</a>&#10;      <a href=&quot;#solutions&quot;>Solutions</a>&#10;      <a href=&quot;#pricing&quot;>Pricing</a>&#10;      <a href=&quot;#docs&quot;>Docs</a>&#10;    </nav>&#10;    <div class=&quot;nav-actions&quot;>&#10;      <a href=&quot;/login&quot; class=&quot;btn-login&quot;>Sign In</a>&#10;      <a href=&quot;/signup&quot; class=&quot;btn-primary&quot;>Get Started &rarr;</a>&#10;    </div>&#10;  </div>&#10;</header>"
                                data-css-code=".apex-glass-nav {&#10;  position: sticky;&#10;  top: 0;&#10;  z-index: 1000;&#10;  backdrop-filter: blur(16px);&#10;  -webkit-backdrop-filter: blur(16px);&#10;  background: rgba(255, 255, 255, 0.85);&#10;  border-bottom: 1px solid #e2e8f0;&#10;  padding: 16px 0;&#10;}&#10;.nav-flex {&#10;  display: flex;&#10;  align-items: center;&#10;  justify-content: space-between;&#10;}&#10;.nav-links a {&#10;  color: #475569;&#10;  margin: 0 14px;&#10;  text-decoration: none;&#10;  font-weight: 600;&#10;  transition: color 0.2s;&#10;}&#10;.nav-links a.active, .nav-links a:hover {&#10;  color: #e5173f;&#10;}"
                                data-js-code="document.addEventListener('DOMContentLoaded', () => {&#10;  const header = document.querySelector('.apex-glass-nav');&#10;  window.addEventListener('scroll', () => {&#10;    if (window.scrollY > 20) {&#10;      header.classList.add('is-scrolled');&#10;    } else {&#10;      header.classList.remove('is-scrolled');&#10;    }&#10;  });&#10;});">
                            Live Preview & Code
                        </button>
                    </div>
                </div>
            </article>
            <article class="template-card" data-category="menu">
                <div class="template-card__media">
