@page "/login"
@model Ozikol.Central.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In to Sovereign Workspace - Ozikol";
}

<div class="auth-page-wrapper">
    <div class="auth-card">
        <!-- Dual Mode Navigation Pills -->
        <div style="display: flex; background: #f1f5f9; padding: 4px; border-radius: 10px; margin-bottom: 24px;">
            <button type="button" id="tabBtnWorkspace" onclick="switchAuthTab('workspace')" style="flex: 1; padding: 8px 12px; border: none; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; background: @(Model.ActiveTab == "workspace" ? "#ffffff" : "transparent"); color: @(Model.ActiveTab == "workspace" ? "var(--ozikol-primary)" : "#64748b"); box-shadow: @(Model.ActiveTab == "workspace" ? "0 2px 6px rgba(0,0,0,0.06)" : "none");">
                Organization Workspace
            </button>
            <button type="button" id="tabBtnOperator" onclick="switchAuthTab('operator')" style="flex: 1; padding: 8px 12px; border: none; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; background: @(Model.ActiveTab == "operator" ? "#ffffff" : "transparent"); color: @(Model.ActiveTab == "operator" ? "var(--ozikol-primary)" : "#64748b"); box-shadow: @(Model.ActiveTab == "operator" ? "0 2px 6px rgba(0,0,0,0.06)" : "none");">
                Platform Operator
            </button>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 8px; font-size: 13.5px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 12px 16px; border-radius: 8px; font-size: 13.5px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>@Model.SuccessMessage</span>
            </div>
        }

        <!-- TAB 1: Organization Workspace Access -->
        <div id="workspaceAuthPanel" style="display: @(Model.ActiveTab == "workspace" ? "block" : "none");">
            <div class="auth-header">
                <h1 class="auth-title">Welcome to Ozikol</h1>
                <p class="auth-subtitle">Sign in to your organization's dedicated sovereign workspace.</p>
            </div>

            <div class="social-login-stack">
                <!-- Google SSO -->
                <button type="button" class="btn-social" onclick="resolveSocialLogin('Google')">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/><path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/></svg>
                    <span>Single Sign-On with Google Workspace</span>
                </button>

                <!-- Microsoft SSO -->
                <button type="button" class="btn-social" onclick="resolveSocialLogin('Microsoft')">
                    <svg width="18" height="18" viewBox="0 0 23 23"><path fill="#f35325" d="M1 1h10v10H1z"/><path fill="#81bc06" d="M12 1h10v10H12z"/><path fill="#05a6f0" d="M1 12h10v10H1z"/><path fill="#ffba08" d="M12 12h10v10H12z"/></svg>
                    <span>Single Sign-On with Microsoft 365</span>
                </button>

                <!-- Secondary SSO options -->
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="btn-social" style="flex: 1; padding: 8px 10px; font-size: 12.5px;" onclick="resolveSocialLogin('GitHub')">
                        <svg width="16" height="16" fill="#181717" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                        <span>GitHub</span>
                    </button>
                    <button type="button" class="btn-social" style="flex: 1; padding: 8px 10px; font-size: 12.5px;" onclick="resolveSocialLogin('LinkedIn')">
                        <svg width="16" height="16" fill="#0A66C2" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
                        <span>LinkedIn</span>
                    </button>
                    <button type="button" class="btn-social" style="flex: 1; padding: 8px 10px; font-size: 12.5px;" onclick="resolveSocialLogin('Apple')">
                        <svg width="16" height="16" fill="#000000" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.66-.8 1.1-1.92.98-3.04-.95.04-2.1.63-2.78 1.43-.6.69-1.12 1.83-1 2.93 1.06.08 2.14-.52 2.8-1.32z"/></svg>
                        <span>Apple</span>
                    </button>
                </div>
            </div>

            <div class="auth-divider">
                <div class="auth-divider__line"></div>
                <span class="auth-divider__text">or find your workspace address</span>
                <div class="auth-divider__line"></div>
            </div>

            <!-- Workspace Lookup Form -->
            <form method="post" asp-page-handler="FindWorkspace">
                <div class="form-group">
                    <label class="form-label">
                        Workspace Name or Corporate Email
                    </label>
                    <div style="position: relative;">
                        <input asp-for="WorkspaceQuery" id="workspaceQueryInput" required placeholder="e.g. acme or jane@company.com" class="form-input" style="padding-right: 36px;" />
                        <span style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8;">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </span>
                    </div>
                    <div style="font-size: 12px; color: #64748b; margin-top: 5px;">
                        Tip: Enter your organization subdomain (e.g. <code>acme</code>) or your registered work email.
                    </div>
                </div>

                <button type="submit" class="btn-auth-submit">
                    Continue to Organization Workspace &rarr;
                </button>
            </form>

            @if (Model.FoundWorkspaces != null && Model.FoundWorkspaces.Count > 0)
            {
                <!-- Multiple Workspaces Discovered -->
                <div style="margin-top: 24px;">
                    <div style="font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 12px;">
                        Select your workspace to sign in:
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        @foreach (var ws in Model.FoundWorkspaces)
                        {
                            <a href="@ws.DirectUrl" style="display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; text-decoration: none; transition: all 0.2s ease;">
                                <div>
                                    <div style="font-size: 14.5px; font-weight: 800; color: #0f172a;">@ws.OrganizationName</div>
                                    <div style="font-size: 12.5px; color: #64748b; margin-top: 2px;">@ws.PrimaryDomain</div>
                                </div>
                                <span style="font-size: 13px; font-weight: 700; color: var(--ozikol-primary);">Launch &rarr;</span>
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="auth-footer">
                Don't have an organization workspace? <a href="/get-started">Create a free workspace</a>
            </div>
        </div>

        <!-- TAB 2: Platform Operator Access -->
        <div id="operatorAuthPanel" style="display: @(Model.ActiveTab == "operator" ? "block" : "none");">
            <div class="auth-header">
                <h1 class="auth-title">Platform Operator</h1>
                <p class="auth-subtitle">Authorized credentials for Central platform operators and SuperAdmins.</p>
            </div>

            <form method="post" asp-page-handler="OperatorLogin">
                <input type="hidden" name="ActiveTab" value="operator" />
                <div class="form-group">
                    <label class="form-label">Operator Work Email</label>
                    <input asp-for="OperatorEmail" type="email" required placeholder="operator@ozikol.cloud" class="form-input" />
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" style="margin-bottom: 0;">Password</label>
                        <button type="button" onclick="togglePasswordVisibility('operatorPassword', this)" style="background: none; border: none; font-size: 12.5px; color: var(--ozikol-primary); cursor: pointer; font-weight: 600;">Show</button>
                    </div>
                    <input asp-for="OperatorPassword" type="password" id="operatorPassword" required placeholder="Enter operator password" class="form-input" />
                </div>

                <div class="form-checkbox-wrap">
                    <input asp-for="RememberMe" id="rememberMeOp" type="checkbox" style="width: 16px; height: 16px; cursor: pointer;" />
                    <label for="rememberMeOp" class="form-checkbox-label">Keep this session active for 7 days</label>
                </div>

                <button type="submit" class="btn-auth-submit">
                    Sign In as Platform Operator &rarr;
                </button>
            </form>

            <div class="auth-footer" style="margin-top: 24px;">
                Looking for your business system? <a href="javascript:void(0)" onclick="switchAuthTab('workspace')">Access Workspace</a>
            </div>
        </div>
    </div>
</div>

<script>
function switchAuthTab(tab) {
    const wsPanel = document.getElementById('workspaceAuthPanel');
    const opPanel = document.getElementById('operatorAuthPanel');
    const wsBtn = document.getElementById('tabBtnWorkspace');
    const opBtn = document.getElementById('tabBtnOperator');

    if (tab === 'operator') {
        wsPanel.style.display = 'none';
        opPanel.style.display = 'block';
        opBtn.style.background = '#ffffff';
        opBtn.style.color = 'var(--ozikol-primary)';
        opBtn.style.boxShadow = '0 2px 6px rgba(0,0,0,0.06)';
        wsBtn.style.background = 'transparent';
        wsBtn.style.color = '#64748b';
        wsBtn.style.boxShadow = 'none';
    } else {
        opPanel.style.display = 'none';
        wsPanel.style.display = 'block';
        wsBtn.style.background = '#ffffff';
        wsBtn.style.color = 'var(--ozikol-primary)';
        wsBtn.style.boxShadow = '0 2px 6px rgba(0,0,0,0.06)';
        opBtn.style.background = 'transparent';
        opBtn.style.color = '#64748b';
        opBtn.style.boxShadow = 'none';
    }
}

function togglePasswordVisibility(id, btn) {
    const p = document.getElementById(id);
    if (p.type === 'password') {
        p.type = 'text';
        btn.innerText = 'Hide';
    } else {
        p.type = 'password';
        btn.innerText = 'Show';
    }
}

async function resolveSocialLogin(provider) {
    const email = prompt(`Single Sign-On with ${provider}:\nEnter your corporate email:`, "admin@company.com");
    if (!email) return;

    try {
        const resp = await fetch(`/login?handler=Lookup&query=${encodeURIComponent(email)}`);
        const data = await resp.json();

        if (data.found && data.primaryUrl) {
            alert(`✓ Verified ${provider} identity for ${email}.\nDirecting you to your organization workspace...`);
            window.location.href = data.primaryUrl;
        } else {
            const createNew = confirm(`Notice: No workspace found for ${email}.\n\nWould you like to start a sovereign workspace now with this email?`);
            if (createNew) {
                window.location.href = `/get-started?email=${encodeURIComponent(email)}`;
            }
        }
    } catch (e) {
        document.getElementById('workspaceQueryInput').value = email;
        document.querySelector('#workspaceAuthPanel form').submit();
    }
}
</script>
