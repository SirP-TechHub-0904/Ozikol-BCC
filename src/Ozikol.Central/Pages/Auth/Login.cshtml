@page
@model Ozikol.Central.Pages.LoginModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Ozikol.Central.SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Auth_Login_Title"];
}

<div class="auth-page-wrapper">
    <div class="auth-card">
        <div class="auth-header" style="text-align: center; margin-bottom: 24px;">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: #fee2e2; color: var(--ozikol-primary); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m0 0v2m0-2h2m-2 0H10m4-8a4 4 0 10-8 0v4h8V7z"/></svg>
            </div>
            <h1 class="auth-title" style="font-size: 24px; color: #0f172a; margin: 0 0 6px;">Administrator Sign-In</h1>
            <p class="auth-subtitle" style="color: #64748b; font-size: 14px; margin: 0;">Sign in to access administration</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 8px; font-size: 13.5px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post">
            <div class="form-group">
                <label class="form-label">Email</label>
                <input asp-for="Email" type="email" required placeholder="admin@example.com" class="form-input" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label class="form-label" style="margin-bottom: 0;">Password</label>
                    <button type="button" onclick="togglePasswordVisibility('opPassword', this)" style="background: none; border: none; font-size: 12.5px; color: var(--ozikol-primary); cursor: pointer; font-weight: 600;">Show</button>
                </div>
                <input asp-for="Password" type="password" id="opPassword" required placeholder="••••••••" class="form-input" />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div class="form-checkbox-wrap" style="margin-bottom: 20px;">
                <input asp-for="RememberMe" id="rememberMe" type="checkbox" style="width: 16px; height: 16px; cursor: pointer;" />
                <label for="rememberMe" class="form-checkbox-label">Remember me</label>
            </div>

            <button type="submit" class="btn-auth-submit" style="width: 100%; padding: 12px; font-size: 15px; font-weight: 700;">
                Access Administration &rarr;
            </button>
        </form>

        <div class="auth-footer" style="margin-top: 24px; text-align: center; font-size: 13.5px; color: #64748b;">
            Can't sign in? <a href="/support/contact#ozContactForm" style="color: var(--ozikol-primary); font-weight: 600; text-decoration: none;">Contact Support &rarr;</a>
        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(id, btn) {
    const p = document.getElementById(id);
    if (p.type === 'password') {
        p.type = 'text';
        btn.innerText = 'Hide';
    } else {
        p.type = 'password';
        btn.innerText = 'Show';
    }
}
</script>
