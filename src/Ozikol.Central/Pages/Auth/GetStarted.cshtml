@page
@model Ozikol.Central.Pages.GetStartedModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Ozikol.Central.SharedResource> SharedLocalizer
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    ViewData["Title"] = "Get Started — Provision Your Organization Workspace";
}

<div class="auth-page-wrapper" style="max-width: 960px; margin: 0 auto; padding: 40px 20px;">
    <div class="auth-card auth-card--wide" style="max-width: 900px; padding: 36px 40px; border-radius: 16px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,0.06); background: #ffffff;">

        @* Step Indicator Header *@
        <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 28px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <div id="stepBadge1" style="display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13.5px; color: var(--ozikol-primary); background: rgba(59, 130, 246, 0.1); padding: 6px 14px; border-radius: 20px;">
                    <span style="width: 22px; height: 22px; border-radius: 50%; background: var(--ozikol-primary); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">1</span>
                    Organization Details
                </div>
                <div style="width: 40px; height: 2px; background: #e2e8f0;" id="stepDivider"></div>
                <div id="stepBadge2" style="display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13.5px; color: #94a3b8; background: #f8fafc; padding: 6px 14px; border-radius: 20px;">
                    <span style="width: 22px; height: 22px; border-radius: 50%; background: #e2e8f0; color: #64748b; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">2</span>
                    Features &amp; Promo
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 8px; font-size: 13.5px; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form id="onboardingForm" method="post" onsubmit="handleOnboardingSubmit(event)">
            
            @* ── STEP 1: Organization & Root Admin Details ── *@
            <div id="step1Container">
                <div class="auth-header" style="text-align: left; margin-bottom: 24px;">
                    <h1 class="auth-title" style="font-size: 24px; color: #0f172a; margin: 0 0 6px;">Setup Your Organization Workspace</h1>
                    <p class="auth-subtitle" style="margin: 0; color: #64748b;">Enter your organization details and root administrator credentials.</p>
                </div>

                <div class="form-grid-2">
                    <div>
                        <label class="form-label">Full Name <span style="color: #ef4444;">*</span></label>
                        <input asp-for="Input.FullName" id="inputFullName" required placeholder="e.g. First Last" class="form-input" />
                        <span asp-validation-for="Input.FullName" class="text-danger" style="font-size: 12px;"></span>
                    </div>
                    <div>
                        <label class="form-label">Organization / Business Name <span style="color: #ef4444;">*</span></label>
                        <input asp-for="Input.OrganizationName" id="inputOrgName" required placeholder="e.g. Your Organization Name" oninput="handleOrgNameInput(this.value)" class="form-input" />
                        <span asp-validation-for="Input.OrganizationName" class="text-danger" style="font-size: 12px;"></span>
                    </div>
                </div>

                <!-- Workspace Subdomain Address -->
                <div class="form-group" style="margin-top: 14px;">
                    <label class="form-label">
                        Workspace Subdomain Address <span style="color: #ef4444;">*</span>
                        <span style="font-weight: normal; color: #64748b; font-size: 12px;">(Unique cloud workspace portal URL)</span>
                    </label>
                    <div style="display: flex; align-items: center; background: #fff; border: 1px solid var(--ozikol-border-hover); border-radius: 8px; overflow: hidden;">
                        <span style="padding: 10px 12px; background: #f8fafc; color: #64748b; font-size: 13.5px; border-right: 1px solid #e2e8f0; font-weight: 600;">https://</span>
                        <input asp-for="Input.WorkspaceSlug" id="inputWorkspaceSlug" required placeholder="e.g. mycompany" oninput="handleSlugInput(this.value)" style="flex: 1; border: none; padding: 11px 12px; font-size: 14px; font-weight: 700; color: var(--ozikol-primary); outline: none;" />
                        <span style="padding: 10px 12px; background: #f8fafc; color: #64748b; font-size: 13.5px; border-left: 1px solid #e2e8f0; font-weight: 600;">.ozikol.cloud</span>
                    </div>
                    <div id="slugFeedback" style="font-size: 12px; margin-top: 5px; display: flex; align-items: center; gap: 6px; color: #64748b;">
                        Enter your desired workspace subdomain.
                    </div>
                    <span asp-validation-for="Input.WorkspaceSlug" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Root Administrator Email <span style="color: #ef4444;">*</span></label>
                    <input asp-for="Input.WorkEmail" id="inputWorkEmail" type="email" required placeholder="name@company.com" class="form-input" />
                    <span asp-validation-for="Input.WorkEmail" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" style="margin-bottom: 0;">Master Password <span style="color: #ef4444;">*</span></label>
                        <button type="button" onclick="togglePasswordVisibility('regPassword', this)" style="background: none; border: none; font-size: 12.5px; color: var(--ozikol-primary); cursor: pointer; font-weight: 600;">Show Password</button>
                    </div>
                    <input asp-for="Input.Password" type="password" id="regPassword" autocomplete="new-password" required placeholder="Create a strong password" oninput="updateStrength(this.value)" class="form-input" />
                    <div class="strength-meter" style="margin-top: 6px; height: 4px; background: #e2e8f0; border-radius: 2px; overflow: hidden;">
                        <div id="strengthFill" style="height: 100%; width: 0; transition: width 0.3s ease, background 0.3s ease;"></div>
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="form-grid-2">
                    <div>
                        <label class="form-label">Industry / Organization Sector</label>
                        <select asp-for="Input.OrganizationType" class="form-select">
                            <option>Business & Enterprise</option>
                            <option>Non-Profit & Foundation</option>
                            <option>Healthcare & Care Services</option>
                            <option>Education & Academy</option>
                            <option>Government & Public Agency</option>
                            <option>Technology & Software</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Phone Number <span style="font-weight: normal; color: #94a3b8;">(Optional)</span></label>
                        <input asp-for="Input.PhoneNumber" placeholder="e.g. +0 (000) 000-0000" class="form-input" />
                    </div>
                </div>

                <div style="margin: 16px 0;">
                    <a href="javascript:void(0)" onclick="document.getElementById('refGroup').style.display = document.getElementById('refGroup').style.display === 'none' ? 'block' : 'none';" style="font-size: 12.5px; color: var(--ozikol-primary); text-decoration: none; font-weight: 600;">
                        Have an Affiliate Referral Code?
                    </a>
                    <div id="refGroup" style="display: @(string.IsNullOrEmpty(Model.Input.ReferralCode) ? "none" : "block"); margin-top: 8px;">
                        <input asp-for="Input.ReferralCode" placeholder="e.g. REF-XXXX" class="form-input" />
                    </div>
                </div>

                <!-- Google reCAPTCHA Verification Widget -->
                <div class="oz-recaptcha-wrap" style="margin: 18px 0 10px; display: flex; justify-content: center;">
                    <div class="g-recaptcha" data-sitekey="@Model.RecaptchaSiteKey"></div>
                </div>

                <button type="button" onclick="goToStep2()" class="btn-auth-submit" style="margin-top: 10px; width: 100%; font-size: 15px; font-weight: 700; padding: 14px;">
                    Continue to Feature Selection &rarr;
                </button>
            </div>

            @* ── STEP 2: Feature Selection & Voucher / Trial ── *@
            <div id="step2Container" style="display: none;">
                <div class="auth-header" style="text-align: left; margin-bottom: 20px;">
                    <h1 class="auth-title" style="font-size: 24px; color: #0f172a; margin: 0 0 6px;">Select Features</h1>
                    <p class="auth-subtitle" style="margin: 0; color: #64748b;">Review included platform capabilities and apply any promotional discounts.</p>
                </div>

                @* 1. Included Features (Auto-Included in Base Plan) *@
                <div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.06) 0%, rgba(16, 185, 129, 0.06) 100%); border: 1px solid #bfdbfe; border-radius: 14px; padding: 22px; margin-bottom: 24px;">
                    
                    @* Center Header: Big, Bold Free Trial Badge & Base Plan Price *@
                    <div style="text-align: center; margin-bottom: 20px;">
                        <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 18px; font-weight: 900; color: #065f46; background: #ecfdf5; border: 2px solid #10b981; padding: 8px 24px; border-radius: 9999px; box-shadow: 0 4px 14px rgba(16, 185, 129, 0.18); margin-bottom: 10px;">
                            <span class="material-symbols-outlined" style="font-size: 22px; color: #059669;">verified</span>
                            <span>@Model.TrialDays-Day Free Trial</span>
                        </div>
                        <div style="font-size: 22px; font-weight: 900; color: #0f172a; margin-top: 6px; letter-spacing: -0.3px;">
                            <span>Annual Base Plan: @Model.FormattedBasePlanPrice</span>
                            <span style="color: #059669; font-weight: 900; margin-left: 8px;">(Pay Nothing Today)</span>
                        </div>
                        <p style="font-size: 13.5px; color: #64748b; margin: 8px auto 0 auto; font-weight: 500; max-width: 600px;">
                            Core foundational capabilities automatically provisioned with dedicated secure cloud infrastructure and daily automated backups.
                        </p>
                    </div>

                    @* Alert Note: Request for Free 1-Year Voucher *@
                    <div style="background: #fffbeb; border: 1.5px solid #fcd34d; border-radius: 12px; padding: 14px 20px; margin-bottom: 22px; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.08);">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <span class="material-symbols-outlined" style="font-size: 26px; color: #d97706;">card_giftcard</span>
                            <div>
                                <div style="font-size: 14px; font-weight: 800; color: #92400e;">
                                    @SharedLocalizer["GetStarted_Voucher_Title"]
                                </div>
                                <div style="font-size: 13px; font-weight: 500; color: #b45309; margin-top: 2px;">
                                    @SharedLocalizer["GetStarted_Voucher_Desc"]
                                </div>
                            </div>
                        </div>
                        <a href="/@currentCulture/vouchers/apply" target="_blank" rel="noopener noreferrer" style="font-size: 13px; font-weight: 800; color: #ffffff; background: #d97706; padding: 8px 16px; border-radius: 8px; text-decoration: none; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(217, 119, 6, 0.25); transition: background 0.15s ease;">
                            <span class="material-symbols-outlined" style="font-size: 17px;">redeem</span>
                            <span>@SharedLocalizer["GetStarted_Voucher_Btn"]</span>
                            <span style="font-size: 15px;">&rarr;</span>
                        </a>
                    </div>

                    @{
                        // Shared serial counter — continuous numbering across compulsory AND addon feature sections
                        int featureSerialNo = 0;

                        // Build a letter index (A, B, C...) for all unique suite categories across both sections
                        var allSuiteCategories = Model.CompulsoryFeatures
                            .Select(f => f.Category)
                            .Union(Model.AddonFeatures.Select(f => f.Category))
                            .OrderBy(c => c)
                            .ToList();
                        var suiteLetterMap = new Dictionary<string, char>();
                        for (int i = 0; i < allSuiteCategories.Count; i++)
                        {
                            suiteLetterMap[allSuiteCategories[i]] = (char)('A' + i);
                        }
                    }

                    @if (Model.CompulsoryFeatures.Any())
                    {
                        var featureGroups = Model.CompulsoryFeatures.GroupBy(f => f.Category).OrderBy(g => g.Key);
                        <div style="display: flex; flex-direction: column; gap: 22px;">
                            @foreach (var suite in featureGroups)
                            {
                                <div>
                                    <div style="display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1.5px dashed #cbd5e1;">
                                        <span style="background: var(--ozikol-primary); color: #ffffff; font-size: 10.5px; font-weight: 800; padding: 3px 10px; border-radius: 4px; letter-spacing: 0.06em; white-space: nowrap;">Suite @suiteLetterMap[suite.Key]</span>
                                        <span style="color: #334155;">@suite.Key</span>
                                    </div>
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                                        @foreach (var feat in suite)
                                        {
                                            featureSerialNo++;
                                            <div style="display: flex; align-items: center; gap: 8px; background: #ffffff; border: 1px solid #e2e8f0; padding: 10px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 600; color: #1e293b;">
                                                <span style="color: #10b981; font-weight: 800;">✓</span>
                                                <span>@featureSerialNo. @feat.Name</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
                            <div style="display: flex; align-items: center; gap: 8px; background: #ffffff; border: 1px solid #e2e8f0; padding: 10px 14px; border-radius: 6px; font-size: 12.5px; font-weight: 600; color: #1e293b;">
                                <span style="color: #10b981; font-weight: 800;">✓</span>
                                <span>Identity, RBAC, Cloud Storage, Audit Logs, Backups</span>
                            </div>
                        </div>
                    }
                </div>

                @* 2. Additional Features (Rendered dynamically only when extra features exist) *@
                @if (Model.AddonFeatures.Any())
                {
                    <div style="margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                            <h3 style="font-size: 15px; font-weight: 800; color: #0f172a; margin: 0; display: flex; align-items: center; gap: 8px;">
                                <span class="material-symbols-outlined" style="color: var(--ozikol-primary); font-size: 20px;">widgets</span>
                                Additional Features (@Model.AddonFeatures.Count Available)
                            </h3>
                            <div style="font-size: 12px; color: #64748b;">
                                Select extra capabilities to activate for your organization
                            </div>
                        </div>

                        <div style="max-height: 420px; overflow-y: auto; padding: 8px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc;">
                            @{
                                var addonGroups = Model.AddonFeatures.GroupBy(f => f.Category).OrderBy(g => g.Key);
                            }
                            @foreach (var suite in addonGroups)
                            {
                                <div style="margin-bottom: 22px;">
                                    <div style="display: flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 12px; padding: 6px 12px 8px; border-bottom: 1.5px dashed #cbd5e1;">
                                        <span style="background: var(--ozikol-primary); color: #ffffff; font-size: 10.5px; font-weight: 800; padding: 3px 10px; border-radius: 4px; letter-spacing: 0.06em; white-space: nowrap;">Suite @suiteLetterMap[suite.Key]</span>
                                        <span style="color: #334155;">@suite.Key</span>
                                    </div>
                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; padding: 0 4px;">
                                        @foreach (var feat in suite)
                                        {
                                            featureSerialNo++;
                                            var featYearlyPrice = feat.YearlyPrice > 0 ? feat.YearlyPrice : feat.MonthlyPrice * 10;
                                            <div style="background: #ffffff; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 14px; transition: all 0.15s ease;" class="feature-card-wrapper" id="card_@feat.Id">
                                                <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer; margin: 0;">
                                                    <input type="checkbox" name="Input.SelectedFeatureIds" value="@feat.Id" id="cb_@feat.Id"
                                                           data-monthly-price="@feat.MonthlyPrice"
                                                           data-yearly-price="@featYearlyPrice"
                                                           onchange="updateCartTotal()"
                                                           style="width: 18px; height: 18px; margin-top: 2px; accent-color: var(--ozikol-primary); cursor: pointer;" />
                                                    <div style="flex: 1;">
                                                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                                            <div style="font-size: 13.5px; font-weight: 700; color: #0f172a;">@featureSerialNo. @feat.Name</div>
                                                            <span id="priceBadge_@feat.Id" style="font-size: 11.5px; font-weight: 700; color: var(--ozikol-primary); background: #eff6ff; padding: 2px 6px; border-radius: 4px; white-space: nowrap;">
                                                                @(feat.MonthlyPrice == 0 ? "Free" : $"{Model.ActiveCurrencySymbol}{feat.MonthlyPrice:N0}/mo")
                                                            </span>
                                                        </div>
                                                        <div style="font-size: 11.5px; color: #64748b; margin-top: 4px; line-height: 1.4;">
                                                            @(feat.Description ?? feat.Category)
                                                        </div>
                                                    </div>
                                                </label>
                                                <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed #e2e8f0; display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                                                    <span style="font-size: 11px; font-weight: 600; color: #64748b;">Billing Cadence:</span>
                                                    <select class="feature-cadence-select" id="cadence_@feat.Id" data-feature-id="@feat.Id" onchange="onFeatureCadenceChanged('@feat.Id')" style="font-size: 11.5px; font-weight: 700; padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1; background: #f8fafc; color: #0f172a; cursor: pointer;">
                                                        <option value="Monthly" data-price="@feat.MonthlyPrice" selected>Monthly (@Model.ActiveCurrencySymbol@feat.MonthlyPrice.ToString("N0")/mo)</option>
                                                        <option value="Yearly" data-price="@featYearlyPrice">Yearly (@Model.ActiveCurrencySymbol@featYearlyPrice.ToString("N0")/yr — Save 20%)</option>
                                                    </select>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <input type="hidden" asp-for="Input.FeatureCadencesJson" id="hiddenFeatureCadencesJson" />

                @* 3. Coupon Voucher / Promo Box *@
                <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-bottom: 24px;">
                    <label class="form-label" style="font-weight: 700; font-size: 13px; color: #0f172a; margin-bottom: 8px;">
                        Promotional Voucher / Partner Coupon
                    </label>
                    <div style="display: flex; gap: 10px;">
                        <input asp-for="Input.CouponCode" id="inputCouponCode" placeholder="e.g. PROMO-XXXX" 
                               class="form-input" style="flex: 1; font-family: monospace; font-size: 14px; font-weight: 700; text-transform: uppercase;" />
                        <button type="button" onclick="applyCouponCode()" class="btn-auth-outline" style="padding: 10px 18px; font-weight: 700; font-size: 13px; white-space: nowrap; border: 1.5px solid var(--ozikol-primary); color: var(--ozikol-primary); background: transparent; border-radius: 8px; cursor: pointer;">
                            Apply Voucher
                        </button>
                    </div>
                    <div id="couponFeedback" style="font-size: 12.5px; margin-top: 8px; display: none;"></div>
                </div>

                @* 4. Cart Breakdown & Live Total *@
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-bottom: 24px;">
                    <div style="display: flex; justify-content: space-between; font-size: 13.5px; color: #64748b; margin-bottom: 6px;">
                        <span>Annual Platform Plan</span>
                        <span id="basePlanDisplay" style="font-weight: 600; color: #0f172a;">@Model.FormattedBasePlanPrice</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-size: 13.5px; color: #10b981; font-weight: 600; margin-bottom: 6px;">
                        <span>Complimentary Free Trial</span>
                        <span>@Model.TrialDays Days (@Model.ActiveCurrencySymbol 0.00 Due Today)</span>
                    </div>
                    @if (Model.AddonFeatures.Any())
                    {
                        <div style="display: flex; justify-content: space-between; font-size: 13.5px; color: #64748b; margin-bottom: 6px;">
                            <span>Selected Additional Features (<span id="selectedCount">0</span> selected)</span>
                            <span id="addonsTotalDisplay" style="font-weight: 600; color: #0f172a;">@Model.ActiveCurrencySymbol 0.00/mo</span>
                        </div>
                    }
                    <div id="discountRow" style="display: none; justify-content: space-between; font-size: 13.5px; color: #10b981; font-weight: 700; margin-bottom: 6px;">
                        <span>Promotional Voucher Discount (<span id="discountBadgeText">100% OFF</span>)</span>
                        <span id="discountAmountDisplay">-@Model.FormattedBasePlanPrice</span>
                    </div>
                    <div style="height: 1px; background: #e2e8f0; margin: 10px 0;"></div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-size: 15px; font-weight: 800; color: #0f172a;">Total Due Today</div>
                            <div id="trialGuaranteeText" style="font-size: 11.5px; color: #10b981; font-weight: 600;">Pay nothing today • Full access for @Model.TrialDays days</div>
                        </div>
                        <div id="finalTotalDisplay" style="font-size: 22px; font-weight: 800; color: #10b981;">
                            @Model.ActiveCurrencySymbol 0.00 Free
                        </div>
                    </div>
                </div>

                @* Navigation & Submission Buttons *@
                <div style="display: flex; gap: 12px;">
                    <button type="button" onclick="goToStep1()" class="btn-auth-outline" style="flex: 1; padding: 12px; font-weight: 700; border-radius: 8px; border: 1px solid #cbd5e1; color: #64748b; background: #fff; cursor: pointer;">
                        &larr; Back to Step 1
                    </button>
                    <button type="submit" id="btnSubmit" class="btn-auth-submit" style="flex: 2; padding: 14px; font-size: 15px; font-weight: 700; margin: 0;">
                        <span id="submitBtnText">🚀 Start @Model.TrialDays-Day Free Trial</span>
                    </button>
                </div>
            </div>

            <!-- Hidden reCAPTCHA token backup: persists the verification token across step transitions -->
            <input type="hidden" id="recaptchaTokenBackup" />
        </form>

        <div class="auth-footer" style="font-size: 13px; color: #64748b; text-align: center; margin-top: 24px; padding-top: 18px; border-top: 1px solid #f1f5f9; line-height: 1.6;">
            Already have an organization workspace? Log in directly via your dedicated company URL (e.g. <span style="font-weight: 600; color: #0f172a;">https://[company].ozikol.cloud</span>) or your linked domain.
        </div>
    </div>
</div>

<!-- Enterprise Provisioning Progress Modal Overlay -->
<div id="provisioningModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.78); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #ffffff; border-radius: 20px; padding: 36px 32px; max-width: 490px; width: 100%; box-shadow: 0 25px 60px -12px rgba(0,0,0,0.3); text-align: center; border: 1px solid rgba(226, 232, 240, 0.8);">
        
        <!-- Step A: Database & Environment Provisioning View -->
        <div id="provisioningProgressView">
            <div style="width: 56px; height: 56px; border-radius: 50%; border: 4px solid #e2e8f0; border-top-color: var(--ozikol-primary); animation: spin 1s linear infinite; margin: 0 auto 20px;"></div>
            <h2 style="font-size: 22px; font-weight: 800; color: #0f172a; margin: 0 0 8px;">Setting Up Your Workspace</h2>
            <p style="font-size: 14px; color: #64748b; margin: 0 0 24px;">Please wait while we provision your dedicated cloud environment...</p>

            <div style="display: flex; flex-direction: column; gap: 12px; text-align: left; background: #f8fafc; padding: 18px; border-radius: 14px; border: 1px solid #e2e8f0; font-size: 13.5px;">
                <div id="step1" style="display: flex; align-items: center; gap: 10px; color: #0f172a; font-weight: 600;">
                    <span style="color: var(--ozikol-primary);">●</span> Validating workspace parameters...
                </div>
                <div id="step2" style="display: flex; align-items: center; gap: 10px; color: #94a3b8;">
                    <span>○</span> Provisioning dedicated cloud environment...
                </div>
                <div id="step3" style="display: flex; align-items: center; gap: 10px; color: #94a3b8;">
                    <span>○</span> Initializing organization modules & admin credentials...
                </div>
                <div id="step4" style="display: flex; align-items: center; gap: 10px; color: #94a3b8;">
                    <span>○</span> Finalizing business command center...
                </div>
            </div>
        </div>

        <!-- Step B: Interactive Seed Default Website Choice View -->
        <div id="seedChoiceView" style="display: none; text-align: center;">
            <div style="width: 58px; height: 58px; border-radius: 18px; background: var(--ozikol-primary-subtle, rgba(229, 23, 63, 0.08)); border: 1.5px solid var(--ozikol-primary-border, rgba(229, 23, 63, 0.25)); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                <span class="material-symbols-outlined" style="font-size: 28px; color: var(--ozikol-primary, #e5173f);">auto_awesome</span>
            </div>
            <h2 style="font-size: 21px; font-weight: 800; color: #0f172a; margin: 0 0 8px; letter-spacing: -0.3px;">Initialize Default Website?</h2>
            <p style="font-size: 13.5px; color: #64748b; margin: 0 auto 22px; line-height: 1.5; max-width: 400px;">
                Would you like to seed turnkey website templates, interactive forms, and sample blogs? Your public URL will have live, working content right away.
            </p>

            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button type="button" id="btnSeedYes" onclick="submitSeedChoice(true)" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 13px; background: var(--ozikol-primary, #e5173f); color: #ffffff; border: none; border-radius: 12px; font-weight: 700; font-size: 14px; cursor: pointer; box-shadow: 0 4px 14px var(--ozikol-primary-glow, rgba(229, 23, 63, 0.35)); transition: all 0.2s;">
                    <span>🚀 Yes, Seed Default Website (Recommended)</span>
                </button>
                <button type="button" id="btnSeedNo" onclick="submitSeedChoice(false)" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 11px; background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; border-radius: 12px; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s;">
                    <span>No, Start with Blank Slate</span>
                </button>
            </div>

            <div id="seedingProgressStatus" style="display: none; margin-top: 16px; font-size: 13px; color: var(--ozikol-primary, #e5173f); font-weight: 600; align-items: center; justify-content: center; gap: 8px;">
                <div style="width: 14px; height: 14px; border: 2px solid var(--ozikol-primary, #e5173f); border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
                <span>Applying turnkey website suite...</span>
            </div>
        </div>

    </div>
</div>

<style>
@@keyframes spin {
    to { transform: rotate(360deg); }
}
#btnSeedYes:hover {
    background: var(--ozikol-primary-hover, #cc1033) !important;
    box-shadow: 0 6px 20px rgba(229, 23, 63, 0.45) !important;
}
#btnSeedNo:hover {
    background: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
}
.feature-checkbox-label:hover {
    border-color: var(--ozikol-primary) !important;
    background: #f0f7ff !important;
}
</style>

<script>
let currentDiscountPct = 0; // Default zero discount until valid coupon is entered
let savedRecaptchaToken = ''; // Stores reCAPTCHA token from Step 1 for use in Step 2 submission
let slugDebounceTimer = null;

function goToStep2() {
    const fullName = document.getElementById('inputFullName');
    const orgName = document.getElementById('inputOrgName');
    const slug = document.getElementById('inputWorkspaceSlug');
    const email = document.getElementById('inputWorkEmail');
    const pwd = document.getElementById('regPassword');

    if (!fullName.value.trim() || !orgName.value.trim() || !slug.value.trim() || !email.value.trim() || !pwd.value) {
        alert('Please fill in all required fields (Full Name, Organization, Address, Email, Password) to proceed.');
        return;
    }

    // Preserve reCAPTCHA token before hiding Step 1 container (tokens expire after ~2 min)
    const recaptchaEl = document.querySelector('#step1Container [name="g-recaptcha-response"]');
    if (recaptchaEl && recaptchaEl.value) {
        savedRecaptchaToken = recaptchaEl.value;
        const backup = document.getElementById('recaptchaTokenBackup');
        if (backup) backup.value = recaptchaEl.value;
    }

    document.getElementById('step1Container').style.display = 'none';
    document.getElementById('step2Container').style.display = 'block';

    document.getElementById('stepBadge1').style.color = '#10b981';
    document.getElementById('stepBadge1').style.background = '#ecfdf5';
    document.getElementById('stepBadge1').innerHTML = '<span style="width: 22px; height: 22px; border-radius: 50%; background: #10b981; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">✓</span> Organization Details';

    document.getElementById('stepBadge2').style.color = 'var(--ozikol-primary)';
    document.getElementById('stepBadge2').style.background = 'rgba(59, 130, 246, 0.1)';
    document.getElementById('stepBadge2').innerHTML = '<span style="width: 22px; height: 22px; border-radius: 50%; background: var(--ozikol-primary); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">2</span> Features & Promo';

    updateCartTotal();

    const codeInput = document.getElementById('inputCouponCode');
    if (codeInput && codeInput.value.trim() && currentDiscountPct === 0) {
        applyCouponCode();
    }
}

function goToStep1() {
    document.getElementById('step2Container').style.display = 'none';
    document.getElementById('step1Container').style.display = 'block';

    document.getElementById('stepBadge1').style.color = 'var(--ozikol-primary)';
    document.getElementById('stepBadge1').style.background = 'rgba(59, 130, 246, 0.1)';
    document.getElementById('stepBadge1').innerHTML = '<span style="width: 22px; height: 22px; border-radius: 50%; background: var(--ozikol-primary); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">1</span> Organization Details';

    document.getElementById('stepBadge2').style.color = '#94a3b8';
    document.getElementById('stepBadge2').style.background = '#f8fafc';
    document.getElementById('stepBadge2').innerHTML = '<span style="width: 22px; height: 22px; border-radius: 50%; background: #e2e8f0; color: #64748b; display: inline-flex; align-items: center; justify-content: center; font-size: 12px;">2</span> Features & Promo';
}

function handleOrgNameInput(val) {
    const slugInput = document.getElementById('inputWorkspaceSlug');
    if (!slugInput.dataset.manualEdited) {
        const clean = val.toLowerCase()
            .trim()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-');
        slugInput.value = clean;
        checkSlugAvailability(clean);
    }
}

function handleSlugInput(val) {
    const slugInput = document.getElementById('inputWorkspaceSlug');
    slugInput.dataset.manualEdited = "true";
    checkSlugAvailability(val);
}

function checkSlugAvailability(slug) {
    clearTimeout(slugDebounceTimer);
    const feedback = document.getElementById('slugFeedback');
    if (!slug || slug.length < 3) {
        feedback.innerHTML = '<span style="color: #64748b;">Enter at least 3 characters.</span>';
        return;
    }

    feedback.innerHTML = '<span style="color: #64748b;">Checking availability...</span>';

    slugDebounceTimer = setTimeout(async () => {
        try {
            const resp = await fetch(`?handler=CheckWorkspace&slug=${encodeURIComponent(slug)}`);
            const data = await resp.json();
            if (data.available) {
                feedback.innerHTML = `<span style="color: #10b981; font-weight: 600;">✓ Available: ${data.slug}.ozikol.cloud</span>`;
            } else {
                feedback.innerHTML = `<span style="color: #ef4444; font-weight: 600;">✗ ${data.message}</span>`;
            }
        } catch (e) {
            feedback.innerHTML = '<span style="color: #64748b;">Enter your desired workspace subdomain.</span>';
        }
    }, 350);
}

function updateStrength(val) {
    const fill = document.getElementById('strengthFill');
    if (!val) { fill.style.width = '0'; return; }
    if (val.length < 6) {
        fill.style.width = '30%';
        fill.style.background = '#ef4444';
    } else if (val.length < 10) {
        fill.style.width = '65%';
        fill.style.background = '#f59e0b';
    } else {
        fill.style.width = '100%';
        fill.style.background = '#10b981';
    }
}

function togglePasswordVisibility(fieldId, btn) {
    const p = document.getElementById(fieldId);
    if (p.type === 'password') {
        p.type = 'text';
        btn.innerText = 'Hide';
    } else {
        p.type = 'password';
        btn.innerText = 'Show';
    }
}

async function applyCouponCode() {
    const codeInput = document.getElementById('inputCouponCode');
    const feedback = document.getElementById('couponFeedback');
    const code = (codeInput.value || '').trim();

    if (!code) {
        feedback.style.display = 'block';
        feedback.innerHTML = '<span style="color: #ef4444; font-weight: 600;">Please enter a coupon code.</span>';
        return;
    }

    try {
        const resp = await fetch(`?handler=ValidateCoupon&code=${encodeURIComponent(code)}`);
        const data = await resp.json();

        feedback.style.display = 'block';
        if (data.valid) {
            currentDiscountPct = data.discountPercent;
            feedback.innerHTML = `<span style="color: #10b981; font-weight: 700;">✓ ${data.message}</span>`;
        } else {
            currentDiscountPct = 0;
            feedback.innerHTML = `<span style="color: #ef4444; font-weight: 600;">✗ ${data.message}</span>`;
        }
    } catch (e) {
        feedback.style.display = 'block';
        feedback.innerHTML = '<span style="color: #ef4444;">Failed to validate coupon.</span>';
    }

    updateCartTotal();
}

function onFeatureCadenceChanged(featureId) {
    const cadenceSelect = document.getElementById(`cadence_${featureId}`);
    const priceBadge = document.getElementById(`priceBadge_${featureId}`);
    const currencySymbol = '@Html.Raw(Model.ActiveCurrencySymbol)';

    if (cadenceSelect && priceBadge) {
        const isYearly = cadenceSelect.value === 'Yearly';
        const opt = cadenceSelect.options[cadenceSelect.selectedIndex];
        const price = parseFloat(opt.dataset.price) || 0;

        if (price === 0) {
            priceBadge.innerText = 'Free';
        } else if (isYearly) {
            priceBadge.innerText = `${currencySymbol}${price.toFixed(0)}/yr`;
        } else {
            priceBadge.innerText = `${currencySymbol}${price.toFixed(0)}/mo`;
        }
    }

    updateCartTotal();
}

function updateCartTotal() {
    const checkboxes = document.querySelectorAll('input[name="Input.SelectedFeatureIds"]:checked');
    let monthlyAddonsTotal = 0;
    let yearlyAddonsTotal = 0;
    let monthlyCount = 0;
    let yearlyCount = 0;
    const cadencesMap = {};

    checkboxes.forEach(cb => {
        const featureId = cb.value;
        const cadenceSelect = document.getElementById(`cadence_${featureId}`);
        const isYearly = cadenceSelect && cadenceSelect.value === 'Yearly';

        cadencesMap[featureId] = isYearly ? 'Yearly' : 'Monthly';

        if (isYearly) {
            const price = parseFloat(cb.dataset.yearlyPrice) || 0;
            yearlyAddonsTotal += price;
            yearlyCount++;
        } else {
            const price = parseFloat(cb.dataset.monthlyPrice) || 0;
            monthlyAddonsTotal += price;
            monthlyCount++;
        }
    });

    // Serialize cadence choices for backend binding
    const hiddenCadencesInput = document.getElementById('hiddenFeatureCadencesJson');
    if (hiddenCadencesInput) {
        hiddenCadencesInput.value = JSON.stringify(cadencesMap);
    }

    const basePlan = @Model.BasePlanAnnualPrice;
    const currencySymbol = '@Html.Raw(Model.ActiveCurrencySymbol)';
    const trialDays = @Model.TrialDays;
    const subtotal = basePlan + yearlyAddonsTotal + (monthlyAddonsTotal * 12); // Annualized contract volume

    const selectedCountEl = document.getElementById('selectedCount');
    if (selectedCountEl) {
        selectedCountEl.innerText = checkboxes.length;
    }

    const addonsTotalEl = document.getElementById('addonsTotalDisplay');
    if (addonsTotalEl) {
        let textParts = [];
        if (monthlyCount > 0) textParts.push(`${currencySymbol}${monthlyAddonsTotal.toFixed(2)}/mo (${monthlyCount} monthly)`);
        if (yearlyCount > 0) textParts.push(`${currencySymbol}${yearlyAddonsTotal.toFixed(2)}/yr (${yearlyCount} yearly)`);
        addonsTotalEl.innerText = textParts.length > 0 ? textParts.join(' + ') : `${currencySymbol}0.00`;
    }

    const discountRow = document.getElementById('discountRow');
    const discountBadgeText = document.getElementById('discountBadgeText');
    const discountAmountDisplay = document.getElementById('discountAmountDisplay');
    const finalTotalDisplay = document.getElementById('finalTotalDisplay');
    const trialGuaranteeText = document.getElementById('trialGuaranteeText');
    const submitBtnText = document.getElementById('submitBtnText');

    if (currentDiscountPct > 0) {
        const discountVal = (subtotal * (currentDiscountPct / 100));
        const finalNet = Math.max(0, subtotal - discountVal);

        discountRow.style.display = 'flex';
        discountBadgeText.innerText = `${currentDiscountPct}% OFF`;
        discountAmountDisplay.innerText = `-${currencySymbol}${discountVal.toFixed(2)}`;

        if (finalNet === 0) {
            finalTotalDisplay.innerHTML = `<span style="color: #10b981;">${currencySymbol}0.00 Free</span>`;
            if (trialGuaranteeText) {
                trialGuaranteeText.innerText = 'Promotional voucher applied (100% OFF)';
            }
            submitBtnText.innerText = '🚀 Initialize Workspace (Free)';
        } else {
            finalTotalDisplay.innerText = `${currencySymbol}${finalNet.toFixed(2)}`;
            if (trialGuaranteeText) {
                trialGuaranteeText.innerText = `Promotional voucher applied (${currentDiscountPct}% OFF)`;
            }
            submitBtnText.innerText = `🚀 Start ${trialDays}-Day Free Trial`;
        }
    } else {
        discountRow.style.display = 'none';
        // Free trial default state: $0.00 / ₦0.00 due today during trial period
        finalTotalDisplay.innerHTML = `<span style="color: #10b981;">${currencySymbol}0.00 Free</span>`;
        if (trialGuaranteeText) {
            trialGuaranteeText.innerText = `Pay nothing today • Full access for ${trialDays} days`;
        }
        submitBtnText.innerText = `🚀 Start ${trialDays}-Day Free Trial`;
    }
}

async function handleOnboardingSubmit(e) {
    e.preventDefault();
    const form = document.getElementById('onboardingForm');
    const modal = document.getElementById('provisioningModal');

    modal.style.display = 'flex';

    setTimeout(() => {
        const step2 = document.getElementById('step2');
        if (step2) { step2.style.color = '#0f172a'; step2.style.fontWeight = '600'; step2.innerHTML = '<span style="color: var(--ozikol-primary);">●</span> Provisioning dedicated cloud environment...'; }
    }, 1200);

    setTimeout(() => {
        const step3 = document.getElementById('step3');
        if (step3) { step3.style.color = '#0f172a'; step3.style.fontWeight = '600'; step3.innerHTML = '<span style="color: var(--ozikol-primary);">●</span> Initializing organization modules & admin credentials...'; }
    }, 2500);

    try {
        const formData = new FormData(form);

        // Explicitly include the reCAPTCHA token (widget is inside hidden Step 1 container)
        if (savedRecaptchaToken) {
            formData.set('g-recaptcha-response', savedRecaptchaToken);
        }

        const resp = await fetch(form.action || window.location.pathname, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        });

        const result = await resp.json();

        if (result.success) {
            const step4 = document.getElementById('step4');
            if (step4) { step4.style.color = '#10b981'; step4.style.fontWeight = '700'; step4.innerHTML = '<span style="color: #10b981;">✓</span> Workspace Ready!'; }

            const regPwd = document.getElementById('regPassword');
            if (regPwd) {
                regPwd.value = '';
            }
            form.reset();

            pendingOnboardingResult = result;
            const progressView = document.getElementById('provisioningProgressView');
            const choiceView = document.getElementById('seedChoiceView');
            if (progressView && choiceView) {
                setTimeout(() => {
                    progressView.style.display = 'none';
                    choiceView.style.display = 'block';
                }, 700);
            } else {
                window.location.href = result.redirectUrl;
            }
        } else {
            modal.style.display = 'none';
            alert('Setup Notice: ' + (result.message || 'Please verify the highlighted fields and try again.'));
        }
    } catch (err) {
        form.submit();
    }
}

let pendingOnboardingResult = null;

async function submitSeedChoice(seedDefaults) {
    const btnYes = document.getElementById('btnSeedYes');
    const btnNo = document.getElementById('btnSeedNo');
    const statusNotice = document.getElementById('seedingProgressStatus');

    if (btnYes) btnYes.disabled = true;
    if (btnNo) btnNo.disabled = true;
    if (statusNotice) statusNotice.style.display = 'inline-flex';

    const tenantKey = pendingOnboardingResult?.tenantKey || '';
    const orgName = pendingOnboardingResult?.orgName || '';
    const redirectUrl = pendingOnboardingResult?.redirectUrl || '/';

    const handler = seedDefaults ? 'SeedDefaults' : 'SkipDefaults';
    const postUrl = `${window.location.pathname}?handler=${handler}&tenantKey=${encodeURIComponent(tenantKey)}&orgName=${encodeURIComponent(orgName)}`;

    try {
        const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenEl ? tokenEl.value : '';

        await fetch(postUrl, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'RequestVerificationToken': token
            }
        });
    } catch (e) {
        console.warn('Seeding request notice:', e);
    }

    // Now proceed directly to the finish page
    window.location.href = redirectUrl;
}
</script>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}
