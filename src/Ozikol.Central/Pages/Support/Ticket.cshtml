@page "/support/ticket/{referenceNumber?}"
@model Ozikol.Central.Pages.Support.TicketModel
@{
    ViewData["Title"] = Model.TicketFound ? $"Ticket #{Model.Inquiry!.ReferenceNumber} - {Model.Inquiry.Subject}" : "Support Ticket Portal";
}

<div class="oz-ticket-portal py-5">
    <div class="container" style="max-width: 960px;">

        @* Breadcrumb Navigation *@
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb bg-transparent p-0 m-0" style="font-size: 0.875rem;">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item"><a href="/support" class="text-decoration-none text-muted">Support</a></li>
                <li class="breadcrumb-item"><a href="/support/contact" class="text-decoration-none text-muted">Contact</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Ticket Portal</li>
            </ol>
        </nav>

        @* Alert Messages *@
        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@Model.SuccessMessage</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@Model.ErrorMessage</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.TicketFound)
        {
            @* Ticket Search / Lookup View *@
            <div class="card border-0 shadow-lg" style="background: #0f172a; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08);">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 72px; height: 72px; border-radius: 50%; background: rgba(56, 189, 248, 0.12); color: #38bdf8;">
                        <i class="bi bi-ticket-detailed fs-1"></i>
                    </div>

                    <h2 class="text-white fw-bold mb-2">Support Ticket Tracking Portal</h2>
                    <p class="text-muted mx-auto mb-4" style="max-width: 540px;">
                        Enter your unique ticket tracking code received via email upon submitting your enterprise inquiry to review specialist updates, post replies, and manage ticket status.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.ReferenceNumber))
                    {
                        <div class="alert alert-warning mb-4 mx-auto text-start" style="max-width: 540px; border-radius: 10px; background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                            <i class="bi bi-info-circle me-1"></i> No active inquiry was found matching reference code <code>@Model.ReferenceNumber</code>. Please check your reference format.
                        </div>
                    }

                    <form method="post" asp-page-handler="Search" class="mx-auto" style="max-width: 480px;">
                        @Html.AntiForgeryToken()
                        <div class="input-group input-group-lg mb-3" style="box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                            <span class="input-group-text border-0 bg-dark text-muted" style="border-radius: 12px 0 0 12px; border: 1px solid rgba(255,255,255,0.1); border-right: none;">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="SearchReference" value="@Model.ReferenceNumber" class="form-control border-0 bg-dark text-white" placeholder="OZK-SUP-XXXXXXXX-XXXX" style="border: 1px solid rgba(255,255,255,0.1); border-left: none; border-right: none; font-family: monospace; letter-spacing: 0.5px;" required />
                            <button type="submit" class="btn btn-primary px-4 fw-bold" style="border-radius: 0 12px 12px 0; background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none;">
                                Track Ticket
                            </button>
                        </div>
                        <div class="form-text text-muted small">
                            Format: <code>OZK-SUP-YYYYMMDD-HEX</code> &bull; Found in your confirmation email.
                        </div>
                    </form>

                    <div class="mt-5 pt-4 border-top border-secondary border-opacity-25 d-flex justify-content-center gap-4 flex-wrap">
                        <a href="/support/contact" class="text-decoration-none text-muted small hover-text-white">
                            <i class="bi bi-plus-circle me-1"></i> Open a New Ticket
                        </a>
                        <span class="text-muted opacity-25">&bull;</span>
                        <a href="/support/knowledge-base" class="text-decoration-none text-muted small hover-text-white">
                            <i class="bi bi-book me-1"></i> Browse Knowledge Base
                        </a>
                        <span class="text-muted opacity-25">&bull;</span>
                        <a href="/support/sla" class="text-decoration-none text-muted small hover-text-white">
                            <i class="bi bi-shield-check me-1"></i> Service Level Agreements (SLA)
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* Active Ticket Discussion Thread View *@
            var inquiry = Model.Inquiry!;
            var isClosed = inquiry.Status.Equals("Closed", StringComparison.OrdinalIgnoreCase);

            @* Ticket Header Card *@
            <div class="card border-0 shadow-lg mb-4" style="background: #0f172a; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08);">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 border-bottom border-secondary border-opacity-25">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                <span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); font-family: monospace; font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                                    #@inquiry.ReferenceNumber
                                </span>
                                <span class="badge" style="background: rgba(148, 163, 184, 0.15); color: #cbd5e1; font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                                    @inquiry.InquiryType
                                </span>
                                @if (isClosed)
                                {
                                    <span class="badge bg-secondary" style="font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                                        <i class="bi bi-check2-circle me-1"></i> Closed
                                    </span>
                                }
                                else if (inquiry.Status == "AwaitingStaff")
                                {
                                    <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                                        <i class="bi bi-hourglass-split me-1"></i> Awaiting Staff
                                    </span>
                                }
                                else if (inquiry.Status == "AwaitingUser")
                                {
                                    <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                                        <i class="bi bi-chat-dots me-1"></i> Awaiting Your Response
                                    </span>
                                }
                                else if (inquiry.Status == "Reopened")
                                {
                                    <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                                        <i class="bi bi-arrow-repeat me-1"></i> Reopened
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 0.85rem; padding: 6px 12px; border-radius: 8px;">
                                        <i class="bi bi-sparkles me-1"></i> New
                                    </span>
                                }
                            </div>
                            <h3 class="text-white fw-bold mb-1">@inquiry.Subject</h3>
                            <div class="text-muted small">
                                Submitted by <span class="text-light">@inquiry.FullName</span> &bull; @inquiry.Organization &bull;
                                <span>Opened @inquiry.CreatedUtc.ToString("MMM dd, yyyy HH:mm") UTC</span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 align-items-center">
                            @if (!isClosed)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm px-3" data-bs-toggle="collapse" data-bs-target="#closeTicketCard">
                                    <i class="bi bi-check-circle me-1"></i> Resolve & Close
                                </button>
                            }
                            <a href="/support/ticket" class="btn btn-outline-secondary btn-sm px-3 text-white-50">
                                <i class="bi bi-search me-1"></i> Switch Ticket
                            </a>
                        </div>
                    </div>

                    @* Metadata Bar & Inactivity Policy Note *@
                    <div class="row pt-3 g-2 text-muted small align-items-center">
                        <div class="col-md-6">
                            <i class="bi bi-clock-history me-1 text-info"></i>
                            <strong>Last Activity:</strong> @inquiry.LastActivityUtc.ToString("MMM dd, yyyy HH:mm") UTC
                        </div>
                        <div class="col-md-6 text-md-end">
                            <i class="bi bi-shield-check me-1 text-success"></i>
                            <span>Inactive tickets auto-close after 24h of inactivity</span>
                        </div>
                    </div>

                    @* Collapsible Close Form *@
                    @if (!isClosed)
                    {
                        <div class="collapse mt-3" id="closeTicketCard">
                            <div class="p-3 border border-danger border-opacity-25 rounded-3" style="background: rgba(239, 68, 68, 0.05);">
                                <form method="post" asp-page-handler="Close" asp-route-referenceNumber="@inquiry.ReferenceNumber">
                                    @Html.AntiForgeryToken()
                                    <h6 class="text-danger fw-bold mb-2"><i class="bi bi-exclamation-circle me-1"></i> Mark Ticket as Resolved</h6>
                                    <p class="text-muted small mb-3">Has your question or issue been successfully resolved? You can close this ticket now. You can always reopen it later by posting a new reply.</p>
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Optional Resolution Note:</label>
                                        <input type="text" name="CloseReason" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Reason for closing ticket..." />
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-danger btn-sm fw-bold">Confirm & Close Ticket</button>
                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#closeTicketCard">Cancel</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }

                    @* Closed Banner *@
                    @if (isClosed)
                    {
                        <div class="alert alert-secondary mt-3 mb-0" style="background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 10px;">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-archive me-2 fs-5 text-muted"></i>
                                <div>
                                    <strong class="text-light">This ticket is marked as Closed.</strong>
                                    <div class="small text-muted">
                                        @(string.IsNullOrWhiteSpace(inquiry.AutoClosedReason) ? "Closed at customer request." : inquiry.AutoClosedReason)
                                        @if (inquiry.ClosedAtUtc.HasValue)
                                        {
                                            <span>(on @inquiry.ClosedAtUtc.Value.ToString("MMM dd, yyyy HH:mm") UTC)</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Conversation Thread Timeline *@
            <div class="mb-4">
                <h5 class="text-white fw-bold mb-3 d-flex align-items-center">
                    <i class="bi bi-chat-left-text me-2 text-info"></i> Conversation Thread
                    <span class="badge bg-dark text-muted ms-2" style="font-size: 0.75rem;">@(inquiry.Replies.Count + 1) messages</span>
                </h5>

                @* 1. Original Customer Inquiry Message *@
                <div class="card border-0 shadow-sm mb-3" style="background: #1e293b; border-radius: 12px; border-left: 4px solid #0284c7 !important;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center justify-content-center fw-bold text-white" style="width: 36px; height: 36px; border-radius: 50%; background: #0284c7; font-size: 0.9rem;">
                                    @inquiry.FullName.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div class="text-white fw-bold" style="font-size: 0.95rem;">@inquiry.FullName</div>
                                    <div class="text-muted small">@inquiry.Email &bull; Initial Submission</div>
                                </div>
                            </div>
                            <div class="text-muted small">
                                @inquiry.CreatedUtc.ToString("MMM dd, yyyy HH:mm") UTC
                            </div>
                        </div>
                        <div class="text-light pt-2" style="white-space: pre-wrap; line-height: 1.6; font-size: 0.95rem;">@inquiry.Message</div>
                    </div>
                </div>

                @* 2. Chronological Thread Replies *@
                @foreach (var reply in inquiry.Replies)
                {
                    if (reply.IsStaffReply)
                    {
                        @* Staff Specialist Reply Bubble *@
                        <div class="card border-0 shadow-sm mb-3 ms-md-4" style="background: #0b1c2d; border-radius: 12px; border-left: 4px solid #38bdf8 !important; border: 1px solid rgba(56, 189, 248, 0.2);">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-flex align-items-center justify-content-center fw-bold text-white shadow" style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);">
                                            <i class="bi bi-shield-check"></i>
                                        </div>
                                        <div>
                                            <div class="text-white fw-bold d-flex align-items-center gap-2" style="font-size: 0.95rem;">
                                                <span>@reply.SenderName</span>
                                                <span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 0.7rem; border: 1px solid rgba(56, 189, 248, 0.4);">
                                                    Ozikol Specialist
                                                </span>
                                            </div>
                                            <div class="text-muted small">Support & Engineering</div>
                                        </div>
                                    </div>
                                    <div class="text-muted small">
                                        @reply.CreatedUtc.ToString("MMM dd, yyyy HH:mm") UTC
                                    </div>
                                </div>
                                <div class="text-light pt-2" style="white-space: pre-wrap; line-height: 1.6; font-size: 0.95rem;">@reply.Message</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Customer Follow-Up Reply Bubble *@
                        <div class="card border-0 shadow-sm mb-3" style="background: #1e293b; border-radius: 12px; border-left: 4px solid #64748b !important;">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-flex align-items-center justify-content-center fw-bold text-white" style="width: 36px; height: 36px; border-radius: 50%; background: #475569; font-size: 0.9rem;">
                                            @reply.SenderName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="text-white fw-bold" style="font-size: 0.95rem;">@reply.SenderName</div>
                                            <div class="text-muted small">@reply.SenderEmail &bull; Client</div>
                                        </div>
                                    </div>
                                    <div class="text-muted small">
                                        @reply.CreatedUtc.ToString("MMM dd, yyyy HH:mm") UTC
                                    </div>
                                </div>
                                <div class="text-light pt-2" style="white-space: pre-wrap; line-height: 1.6; font-size: 0.95rem;">@reply.Message</div>
                            </div>
                        </div>
                    }
                }
            </div>

            @* Reply Form Card *@
            <div class="card border-0 shadow-lg" style="background: #0f172a; border-radius: 16px; border: 1px solid rgba(255,255,255,0.08);">
                <div class="card-body p-4">
                    <h5 class="text-white fw-bold mb-3 d-flex align-items-center">
                        <i class="bi bi-reply-fill me-2 text-primary"></i>
                        @(isClosed ? "Reopen & Reply to Ticket" : "Post a Reply")
                    </h5>

                    @if (isClosed)
                    {
                        <div class="alert alert-info small mb-3" style="background: rgba(2, 132, 199, 0.15); color: #38bdf8; border: 1px solid rgba(2, 132, 199, 0.3); border-radius: 8px;">
                            <i class="bi bi-info-circle me-1"></i> Posting a reply will automatically reopen this ticket and notify our support engineers.
                        </div>
                    }

                    <form method="post" asp-page-handler="Reply" asp-route-referenceNumber="@inquiry.ReferenceNumber">
                        @Html.AntiForgeryToken()

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Your Name <span class="text-danger">*</span></label>
                                <input type="text" name="ReplySenderName" value="@Model.ReplySenderName" class="form-control bg-dark text-white border-secondary border-opacity-50" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold">Your Email <span class="text-danger">*</span></label>
                                <input type="email" name="ReplySenderEmail" value="@Model.ReplySenderEmail" class="form-control bg-dark text-white border-secondary border-opacity-50" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Reply Message <span class="text-danger">*</span></label>
                            <textarea name="ReplyMessage" rows="5" class="form-control bg-dark text-white border-secondary border-opacity-50" placeholder="Type your follow-up questions, additional details, or clarifications here..." required style="line-height: 1.6;"></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="text-muted small">
                                <i class="bi bi-envelope-check me-1 text-success"></i> Our specialists will be alerted via email immediately.
                            </div>
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-bold" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); border: none; border-radius: 8px;">
                                <i class="bi bi-send-fill me-1"></i> Send Reply
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

    </div>
</div>

<style>
    .oz-ticket-portal {
        min-height: 80vh;
        background: radial-gradient(circle at top right, rgba(14, 165, 233, 0.05) 0%, transparent 60%),
                    radial-gradient(circle at bottom left, rgba(99, 102, 241, 0.05) 0%, transparent 60%);
    }
    .hover-text-white:hover {
        color: #ffffff !important;
    }
</style>
