@page "/news/{slug}"
@model Ozikol.Central.Pages.NewsDetailModel
@{
    ViewData["Title"] = $"{Model.Article.Title} | Ozikol News";
}

<div class="oz-corp-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-corp-container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@Model.CurrentCulture">@SharedLocalizer["Breadcrumb_Home"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/@Model.CurrentCulture/news">@SharedLocalizer["News_Breadcrumb_Newsroom"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@Model.Article.CategoryName</span>
                </div>
                <a href="/@Model.CurrentCulture/news" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>@SharedLocalizer["News_Btn_BackToNews"]</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Article Header -->
    <header class="oz-article-header">
        <div class="oz-corp-container oz-article-container">
            <div class="oz-news-card-meta oz-article-meta-bar">
                <a href="/@Model.CurrentCulture/news?category=@Model.Article.CategoryKey" class="oz-corp-badge-pill">@Model.Article.CategoryName</a>
                <span class="oz-news-meta-bullet">&bull;</span>
                <span class="oz-news-meta-date">@Model.Article.PublishedAtUtc.ToString("MMMM dd, yyyy")</span>
                <span class="oz-news-meta-bullet">&bull;</span>
                <span class="oz-news-meta-read">@Model.Article.ReadTimeText</span>
                <span class="oz-news-meta-bullet">&bull;</span>
                <span class="oz-news-meta-reads" style="display: inline-flex; align-items: center; gap: 4px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    @Model.Article.ReadCount.ToString("N0") @(Model.Article.ReadCount == 1 ? "read" : "reads")
                </span>
            </div>
            <h1 class="oz-article-title">@Model.Article.Title</h1>
            <p class="oz-article-lead">@Model.Article.Excerpt</p>
            
            <!-- Author Card -->
            <div class="oz-article-author-card">
                <div class="oz-article-author-avatar" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <div>
                    <div class="oz-article-author-name">@Model.Article.AuthorName</div>
                    <div class="oz-article-author-role">@Model.Article.AuthorRole</div>
                </div>
            </div>
        </div>
    </header>

    <!-- Article Body -->
    <main class="oz-corp-container oz-article-container oz-article-body-wrap">
        <article class="oz-article-body">
            @Html.Raw(Model.Article.ContentHtml)
        </article>

        <!-- Topic Tags -->
        @if (Model.Article.Tags.Count > 0)
        {
            <div class="oz-article-tags-wrap">
                <span class="oz-article-tags-label">@SharedLocalizer["News_Tags_Label"]:</span>
                <div class="oz-article-tags-list">
                    @foreach (var tag in Model.Article.Tags)
                    {
                        <span class="oz-article-tag">@tag</span>
                    }
                </div>
            </div>
        }

        <!-- Share & Return Footer -->
        <div class="oz-article-nav-footer">
            <a href="/@Model.CurrentCulture/news" class="oz-btn-outline-hero">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                <span>@SharedLocalizer["News_Btn_BackToNews"]</span>
            </a>
            <a href="/@Model.CurrentCulture/features" class="oz-btn-primary-hero">
                <span>@SharedLocalizer["News_Btn_ExploreFeatures"]</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
        </div>
    </main>

    <!-- Related Articles Section -->
    @if (Model.RelatedArticles.Count > 0)
    {
        <section class="oz-corp-section oz-related-news-section">
            <div class="oz-corp-container">
                <div class="oz-corp-section-header">
                    <span class="oz-corp-section-tag">@SharedLocalizer["News_Related_Tag"]</span>
                    <h2 class="oz-corp-section-title">@SharedLocalizer["News_Related_Title"]</h2>
                </div>
                <div class="oz-corp-grid-3">
                    @foreach (var related in Model.RelatedArticles)
                    {
                        <article class="oz-corp-card oz-news-card">
                            <div class="oz-news-card-cover @related.CoverGradientClass">
                                <span class="oz-corp-badge-pill">@related.CategoryName</span>
                            </div>
                            <div class="oz-news-card-meta">
                                <span class="oz-news-meta-date">@related.PublishedAtUtc.ToString("MMMM yyyy")</span>
                                <span class="oz-news-meta-bullet">&bull;</span>
                                <span class="oz-news-meta-read">@related.ReadTimeText</span>
                            </div>
                            <h3 class="oz-corp-card-title oz-news-card-title">
                                <a href="/@Model.CurrentCulture/news/@related.Slug">@related.Title</a>
                            </h3>
                            <p class="oz-corp-card-desc oz-news-card-excerpt">@related.Excerpt</p>
                            <div class="oz-corp-card-footer oz-news-card-footer">
                                <span class="oz-news-author-name">@related.AuthorName</span>
                                <a href="/@Model.CurrentCulture/news/@related.Slug" class="oz-news-link-action">
                                    <span>@SharedLocalizer["News_Btn_ReadArticle"]</span>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </a>
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }
</div>
