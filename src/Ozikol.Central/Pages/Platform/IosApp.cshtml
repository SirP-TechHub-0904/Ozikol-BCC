@page "/platform/ios-app"
@model Ozikol.Central.Pages.Platform.IosAppModel
@{
    ViewData["Title"] = "iOS Mobile App - Ozikol on Apple App Store - Ozikol";
    ViewData["MetaDescription"] = "Native Apple iOS experience, Face ID biometric authentication, Apple Wallet digital ID integration, live roster alerts, and member workflows.";
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>iOS Mobile App - Ozikol on Apple App Store</span>
                </div>
                <partial name="_BackToFeaturesLink" />
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <span class="oz-feat-pill">Mobile Channel • Apple App Store</span>
            </div>
            <h1 class="oz-feat-title">Sleek Apple iOS Experience for iPhone & iPad</h1>
            <p class="oz-feat-lead">Engineered exclusively for iOS with Face ID authentication, Apple Wallet digital membership passes, real-time rota synchronization, and offline resilience.</p>
            <div class="oz-feat-actions">
                <a href="/support#contact" class="btn btn-primary">Book iOS Walkthrough</a>
                <a href="/features/resident-id-cards" class="btn btn-secondary--alt">Digital Pass Features</a>
            </div>
        </div>
    </section>

    <!-- Capabilities Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">Apple Ecosystem</div>
            <h2>Premium Mobile Experience</h2>
            <p class="oz-feat-card-desc">Harnessing native iOS design principles and system security.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Face ID & Touch ID Security</h3>
                <p class="oz-feat-card-desc">Zero friction biometric login ensuring that sensitive workforce rosters, census records, and financial dues remain fully protected.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Apple Wallet Integration</h3>
                <p class="oz-feat-card-desc">Store cryptographic digital ID cards, event tickets, and gate access passes directly in Apple Wallet for NFC and QR tap-and-go access.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Live Dynamic Updates</h3>
                <p class="oz-feat-card-desc">Interactive rota countdowns and live shift change notifications displayed seamlessly on lock screen and dynamic island.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Experience the Power of Ozikol</h2>
            <p>Deploy custom modules, automate operations, and empower your organization today.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support#contact" class="btn btn-primary">Book a Platform Demo</a>
                <partial name="_ExploreFeaturesButton" />
            </div>
        </div>
    </section>
</div>
