@page "/platform/desktop-app"
@model Ozikol.Central.Pages.Platform.DesktopAppModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Desktop_Meta_Title"].Value;
    ViewData["MetaDescription"] = SharedLocalizer["Desktop_Meta_Description"].Value;
    var currentCulture = Model.CurrentCulture;
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@currentCulture">@SharedLocalizer["Desktop_Breadcrumb_Home"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/@currentCulture/platform/website">@SharedLocalizer["Desktop_Breadcrumb_Platform"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@SharedLocalizer["Desktop_Breadcrumb_Current"]</span>
                </div>
                <a href="/@currentCulture" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>@SharedLocalizer["Desktop_Breadcrumb_Back"]</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <span class="oz-feat-pill">@SharedLocalizer["Desktop_Hero_Pill"]</span>
            </div>
            <h1 class="oz-feat-title">@SharedLocalizer["Desktop_Hero_Title"]</h1>
            <p class="oz-feat-lead">@SharedLocalizer["Desktop_Hero_Lead"]</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="#downloads" class="btn btn-primary">@SharedLocalizer["Desktop_Hero_Btn_Download"]</a>
                <a href="#specs" class="btn btn-secondary--alt">@SharedLocalizer["Desktop_Hero_Btn_Specs"]</a>
                <a href="/@currentCulture/support/contact?type=Enterprise" class="btn btn-outline-secondary oz-hero-btn-pill">@SharedLocalizer["Desktop_Hero_Btn_Support"]</a>
            </div>
        </div>
    </section>

    <!-- Core Capabilities Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">@SharedLocalizer["Desktop_Cap_Tagline"]</div>
            <h2>@SharedLocalizer["Desktop_Cap_Heading"]</h2>
            <p class="oz-feat-card-desc">@SharedLocalizer["Desktop_Cap_Desc"]</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Desktop_Card_Printers_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Desktop_Card_Printers_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Desktop_Card_MultiMon_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Desktop_Card_MultiMon_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Desktop_Card_Sqlite_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Desktop_Card_Sqlite_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--blue">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Desktop_Card_Rfid_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Desktop_Card_Rfid_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--rose">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Desktop_Card_Keys_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Desktop_Card_Keys_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--purple">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Desktop_Card_Kiosk_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Desktop_Card_Kiosk_Desc"]</p>
            </div>
        </div>
    </section>

    <!-- Download Section -->
    <section id="downloads" class="container">
        <div class="oz-platform-download-box">
            <h2>@SharedLocalizer["Desktop_Download_Heading"]</h2>
            <p>@SharedLocalizer["Desktop_Download_Desc"]</p>

            <div class="oz-platform-download-grid oz-platform-download-grid--single">
                <!-- Standard Installer Card -->
                <div class="oz-platform-download-card">
                    <div class="oz-platform-card-header">
                        <div class="oz-platform-card-icon oz-platform-card-icon--windows">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        </div>
                        <div>
                            <h4>@SharedLocalizer["Desktop_Card_Exe_Title"]</h4>
                            <span>@SharedLocalizer["Desktop_Card_Exe_Sub"]</span>
                        </div>
                    </div>
                    <p class="oz-platform-card-desc oz-platform-card-desc--sm">@SharedLocalizer["Desktop_Card_Exe_Desc"]</p>
                    <a href="/@currentCulture/support/contact?type=Enterprise" class="oz-platform-btn-download">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        <span>@SharedLocalizer["Desktop_Btn_Download"]</span>
                    </a>
                </div>
            </div>

            <!-- Hardware Specifications Card -->
            <div id="specs" class="oz-platform-specs oz-platform-specs--bordered">
                <span><strong>OS:</strong> @SharedLocalizer["Desktop_Specs_Os"]</span>
                <span><strong>Memory:</strong> @SharedLocalizer["Desktop_Specs_Ram"]</span>
                <span><strong>Storage:</strong> @SharedLocalizer["Desktop_Specs_Disk"]</span>
                <span><strong>Runtime:</strong> @SharedLocalizer["Desktop_Specs_Runtime"]</span>
            </div>
        </div>
    </section>
</div>
