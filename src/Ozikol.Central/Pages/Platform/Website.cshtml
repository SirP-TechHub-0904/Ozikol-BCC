@page "/platform/website"
@model Ozikol.Central.Pages.Platform.WebsiteModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = "Dedicated Website & Custom Web Portal - Ozikol";
    ViewData["MetaDescription"] = "Deploy your organization's custom-branded public web portal with custom domain, SSL, member self-service, and seamless MIS sync.";
    var currentCulture = Model.CurrentCulture;
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@currentCulture">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/platform/website">Platform</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>Dedicated Website &amp; Web Portal</span>
                </div>
                <a href="/@currentCulture" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>Back to Portal</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                </div>
                <span class="oz-feat-pill">Digital Front Door • Web Experience</span>
            </div>
            <h1 class="oz-feat-title">Your Own Dedicated, Branded Organization Website</h1>
            <p class="oz-feat-lead">Launch a fully customized, institutional web presence under your own custom domain (e.g., <code>portal.yourorg.com</code>). Designed as the public front door for members, residents, and visitors with automatic SSL, instant MIS sync, and on-demand feature activation.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/@currentCulture/register" class="btn btn-primary">Deploy Your Website</a>
                <a href="/marketplace" class="btn btn-secondary--alt">Browse UI Templates</a>
                <a href="/@currentCulture/support/contact?type=Sales" class="btn btn-outline-secondary" style="border-radius: 9999px; padding: 10px 22px;">Request Demo</a>
            </div>
        </div>
    </section>

    <!-- Core Capabilities Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">What The Website Does</div>
            <h2>Built Specifically for Your Community &amp; Brand</h2>
            <p class="oz-feat-card-desc">Complete freedom to deliver a tailored digital experience while automating back-office synchronization.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Custom Domain &amp; Brand Identity</h3>
                <p class="oz-feat-card-desc">Bind your own custom domain or use your dedicated subdomain. Custom logo injection, brand color palette matching, and automatic wildcard SSL certificate issuance.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Member Self-Service &amp; Dues Payments</h3>
                <p class="oz-feat-card-desc">Residents and members can log in securely to update profiles, register visitors, download digital ID passes, register for community events, and pay membership dues online.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Activate Modules On Demand</h3>
                <p class="oz-feat-card-desc">Need an event ticketing calendar, staff roster viewer, or public facility booking portal? Turn modules on or off with a single toggle in your administrative dashboard.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--blue">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Responsive &amp; Mobile-Optimized</h3>
                <p class="oz-feat-card-desc">Engineered to look gorgeous on every display: large desktop screens, iPads, and smartphones with fast CDN caching and sub-second page loads.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--rose">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Real-Time Sync with MIS Console</h3>
                <p class="oz-feat-card-desc">Zero manual updates or dual data entry. Any changes made by administrators in the back-office MIS system instantly reflect on the public website.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--purple">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Enterprise Security &amp; Isolation</h3>
                <p class="oz-feat-card-desc">Hardened with Content Security Policies (CSP), automated DDoS shielding, CSRF tokens on all public forms, and isolated database connectivity.</p>
            </div>
        </div>
    </section>

    <!-- Quick Deployment Section -->
    <section class="container">
        <div class="oz-platform-download-box">
            <h2>Ready to Deploy Your Organization's Web Presence?</h2>
            <p>Select your preferred template, configure your custom domain, and launch within minutes.</p>

            <div class="oz-platform-download-grid" style="max-width: 800px; margin: 32px auto 0 auto;">
                <div class="oz-platform-download-card">
                    <div class="oz-platform-card-header">
                        <div class="oz-platform-card-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        </div>
                        <div>
                            <h4>Instant Cloud Deployment</h4>
                            <span>Automated Setup • Multi-Tenant</span>
                        </div>
                    </div>
                    <p style="font-size: 13.5px; color: var(--ozikol-text-secondary); margin: 0 0 12px 0;">Provision your dedicated subdomain or custom domain with turnkey SSL and templates.</p>
                    <a href="/@currentCulture/register" class="oz-platform-btn-download">
                        <span>Deploy Web Portal</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>

                <div class="oz-platform-download-card">
                    <div class="oz-platform-card-header">
                        <div class="oz-platform-card-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                        </div>
                        <div>
                            <h4>Custom Theme Staging</h4>
                            <span>Tailored UI • Dedicated Escort</span>
                        </div>
                    </div>
                    <p style="font-size: 13.5px; color: var(--ozikol-text-secondary); margin: 0 0 12px 0;">Need bespoke UI development or custom migration of your legacy portal?</p>
                    <a href="/@currentCulture/support/contact?type=Sales" class="oz-platform-btn-outline">
                        <span>Contact Solutions Team</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Experience the Unified Power of Ozikol</h2>
            <p>Connect your website directly with your MIS, mobile workforce, and desktop back-office.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/@currentCulture/support/contact?type=Sales" class="btn btn-primary">Book an Architecture Demo</a>
                <a href="/features" class="btn btn-secondary--alt">Explore All 37 Modules</a>
            </div>
        </div>
    </section>
</div>
