@page "/platform/website"
@model Ozikol.Central.Pages.Platform.WebsiteModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Website_Meta_Title"].Value;
    ViewData["MetaDescription"] = SharedLocalizer["Website_Meta_Description"].Value;
    var currentCulture = Model.CurrentCulture;
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@currentCulture">@SharedLocalizer["Website_Breadcrumb_Home"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/@currentCulture/platform/website">@SharedLocalizer["Website_Breadcrumb_Platform"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@SharedLocalizer["Website_Breadcrumb_Current"]</span>
                </div>
                <a href="/@currentCulture" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>@SharedLocalizer["Website_Breadcrumb_Back"]</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <span class="oz-feat-pill">@SharedLocalizer["Website_Hero_Badge"]</span>
            </div>
            <h1 class="oz-feat-title">@SharedLocalizer["Website_Hero_Title"]</h1>
            <p class="oz-feat-lead">@Html.Raw(SharedLocalizer["Website_Hero_Lead"].Value)</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/@currentCulture/get-started" class="btn btn-primary">@SharedLocalizer["Website_Btn_GetStarted"]</a>
                <a href="/@currentCulture/marketplace" class="btn btn-secondary--alt">@SharedLocalizer["Website_Hero_Btn_Marketplace"]</a>
                <a href="/@currentCulture/support/contact?type=Sales" class="btn btn-secondary--alt">@SharedLocalizer["Website_Hero_Btn_Demo"]</a>
            </div>
        </div>
    </section>

    <!-- Core Capabilities Grid -->
    <section class="container oz-feat-capabilities-section" style="padding-top: 60px;">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">@SharedLocalizer["Website_Cap_Tagline"]</div>
            <h2>@SharedLocalizer["Website_Cap_Heading"]</h2>
            <p class="oz-feat-card-desc">@SharedLocalizer["Website_Cap_Desc"]</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Website_Card_CustomDomain_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Website_Card_CustomDomain_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Website_Card_SelfService_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Website_Card_SelfService_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Website_Card_Modules_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Website_Card_Modules_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--blue">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Website_Card_Mobile_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Website_Card_Mobile_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--rose">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Website_Card_Sync_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Website_Card_Sync_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--purple">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Website_Card_Security_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Website_Card_Security_Desc"]</p>
            </div>
        </div>
    </section>

    <!-- Quick Deployment Section -->
    <section class="container">
        <div class="oz-platform-download-box">
            <h2>@SharedLocalizer["Website_Deploy_Heading"]</h2>
            <p>@SharedLocalizer["Website_Deploy_Sub"]</p>

            <div class="oz-platform-download-grid" style="max-width: 800px; margin: 32px auto 0 auto;">
                <div class="oz-platform-download-card">
                    <div class="oz-platform-card-header">
                        <div class="oz-platform-card-icon">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        </div>
                        <div>
                            <h4>@SharedLocalizer["Website_Deploy_Instant_Title"]</h4>
                            <span>@SharedLocalizer["Website_Deploy_Instant_Badge"]</span>
                        </div>
                    </div>
                    <p style="font-size: 13.5px; color: var(--ozikol-text-secondary); margin: 0 0 16px 0;">@SharedLocalizer["Website_Deploy_Instant_Desc"]</p>
                    <a href="/@currentCulture/get-started" class="oz-platform-btn-download">
                        <span>@SharedLocalizer["Website_Btn_GetStarted"]</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>

                <div class="oz-platform-download-card">
                    <div class="oz-platform-card-header">
                        <div class="oz-platform-card-icon" style="background: rgba(124, 58, 237, 0.1); color: #7c3aed;">
                            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        </div>
                        <div>
                            <h4>@SharedLocalizer["Website_Deploy_Marketplace_Title"]</h4>
                            <span>@SharedLocalizer["Website_Deploy_Marketplace_Badge"]</span>
                        </div>
                    </div>
                    <p style="font-size: 13.5px; color: var(--ozikol-text-secondary); margin: 0 0 16px 0;">@SharedLocalizer["Website_Deploy_Marketplace_Desc"]</p>
                    <a href="/@currentCulture/marketplace" class="oz-platform-btn-download" style="background: #1e293b;">
                        <span>@SharedLocalizer["Website_Deploy_Marketplace_Btn"]</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>@SharedLocalizer["Website_CTA_Heading"]</h2>
            <p>@SharedLocalizer["Website_CTA_Desc"]</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/@currentCulture/get-started" class="btn btn-primary">@SharedLocalizer["Website_Btn_GetStarted"]</a>
                <a href="/@currentCulture/features" class="btn btn-secondary--alt">@SharedLocalizer["Website_CTA_Btn_Features"]</a>
            </div>
        </div>
    </section>
</div>
