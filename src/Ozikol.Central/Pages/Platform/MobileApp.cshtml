@page "/platform/mobile-app"
@model Ozikol.Central.Pages.Platform.MobileAppModel
@{
    ViewData["Title"] = "Mobile Apps for iOS & Android - Ozikol";
    ViewData["MetaDescription"] = "Native mobile apps for iPhone, iPad, and Android devices. Offline field sync, instant shift swap push notifications, Apple Wallet passkeys, and camera QR scanning.";
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/platform/website">Platform</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>Mobile Apps (iOS &amp; Android)</span>
                </div>
                <partial name="_BackToFeaturesLink" />
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <span class="oz-feat-pill">Mobile Channel • iOS &amp; Android</span>
            </div>
            <h1 class="oz-feat-title">Unified Mobile Apps for iOS &amp; Android</h1>
            <p class="oz-feat-lead">Empower your distributed team, field enumerators, and community members with native mobile applications designed for Apple iOS and Google Android. Fast, secure, and resilient even when offline.</p>
            <div class="oz-feat-actions">
                <a href="/support#contact" class="btn btn-primary">Request Mobile Deployment</a>
                <a href="/features/staff-rota" class="btn btn-secondary--alt">Explore Shift Rota Features</a>
            </div>
        </div>
    </section>

    <!-- Capabilities Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">Native Mobile Architecture</div>
            <h2>Built for Field Operations &amp; Everyday Convenience</h2>
            <p class="oz-feat-card-desc">Seamlessly connected with your dedicated website and MIS executive system.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Offline-First Field Data Collection</h3>
                <p class="oz-feat-card-desc">Conduct demographic census interviews, asset inspections, and survey data collection without cellular signal; automatically syncs when online.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Push Notifications &amp; Rota Swaps</h3>
                <p class="oz-feat-card-desc">Instant alerts for open shifts, shift trade requests, emergency team broadcasts, and manager approvals delivered directly to home screens.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Apple Wallet &amp; Camera QR Scanner</h3>
                <p class="oz-feat-card-desc">Store digital ID cards in Apple Wallet. Scan visitor passes, event tickets, and equipment barcodes with the device's built-in high-speed camera scanner.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Take Your Operations Mobile</h2>
            <p>Publish under your organization's brand on Google Play and Apple App Store.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support#contact" class="btn btn-primary">Talk to an App Specialist</a>
                <partial name="_ExploreFeaturesButton" />
            </div>
        </div>
    </section>
</div>
