@page "/platform/mobile-app"
@model Ozikol.Central.Pages.Platform.MobileAppModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Mobile_Meta_Title"].Value;
    ViewData["MetaDescription"] = SharedLocalizer["Mobile_Meta_Description"].Value;
    var currentCulture = Model.CurrentCulture;
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@currentCulture">@SharedLocalizer["Mobile_Breadcrumb_Home"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/@currentCulture/platform/website">@SharedLocalizer["Mobile_Breadcrumb_Platform"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@SharedLocalizer["Mobile_Breadcrumb_Current"]</span>
                </div>
                <a href="/@currentCulture" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>@SharedLocalizer["Mobile_Breadcrumb_Back"]</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <span class="oz-feat-pill">@SharedLocalizer["Mobile_Hero_Pill"]</span>
            </div>
            <h1 class="oz-feat-title">@SharedLocalizer["Mobile_Hero_Title"]</h1>
            <p class="oz-feat-lead">@SharedLocalizer["Mobile_Hero_Lead"]</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="#downloads" class="btn btn-primary">@SharedLocalizer["Mobile_Hero_Btn_Download"]</a>
                <a href="#connect" class="btn btn-secondary--alt">@SharedLocalizer["Mobile_Hero_Btn_Connect"]</a>
            </div>
        </div>
    </section>

    <!-- Core Capabilities Grid -->
    <section class="container oz-feat-capabilities-section" style="padding-top: 60px;">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">@SharedLocalizer["Mobile_Cap_Tagline"]</div>
            <h2>@SharedLocalizer["Mobile_Cap_Heading"]</h2>
            <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Cap_Desc"]</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 4.243a9 9 0 01-2.828-6.364m0 0a9 9 0 012.828-6.364m0 0L5.636 2.808M3 3l18 18"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Mobile_Card_Offline_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Card_Offline_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Mobile_Card_Qr_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Card_Qr_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Mobile_Card_Push_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Card_Push_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--blue">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Mobile_Card_Wallet_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Card_Wallet_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--rose">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Mobile_Card_Bio_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Card_Bio_Desc"]</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--purple">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                </div>
                <h3 class="oz-feat-card-title">@SharedLocalizer["Mobile_Card_Swaps_Title"]</h3>
                <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Card_Swaps_Desc"]</p>
            </div>
        </div>
    </section>

    <!-- Download Section -->
    <section id="downloads" class="container">
        <div class="oz-platform-download-box">
            <h2>@SharedLocalizer["Mobile_Download_Heading"]</h2>
            <p>@SharedLocalizer["Mobile_Download_Desc"]</p>

            <div class="oz-platform-download-grid" style="max-width: 800px; margin: 32px auto 0 auto;">
                <!-- Apple iOS Card -->
                <div class="oz-platform-download-card">
                    <div class="oz-platform-card-header">
                        <div class="oz-platform-card-icon" style="background: rgba(0, 0, 0, 0.06); color: #000000;">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-1.99.6-2.61 1.34-.55.63-1.03 1.68-.9 2.69.99.08 2.02-.51 2.59-1.18z"/></svg>
                        </div>
                        <div>
                            <h4>@SharedLocalizer["Mobile_Card_Ios_Title"]</h4>
                            <span>@SharedLocalizer["Mobile_Card_Ios_Sub"]</span>
                        </div>
                    </div>
                    <p style="font-size: 13.5px; color: var(--ozikol-text-secondary); margin: 0 0 12px 0;">@SharedLocalizer["Mobile_Card_Ios_Desc"]</p>
                    <a href="https://apps.apple.com" target="_blank" rel="noopener" class="oz-platform-btn-download">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-1.99.6-2.61 1.34-.55.63-1.03 1.68-.9 2.69.99.08 2.02-.51 2.59-1.18z"/></svg>
                        <span>@SharedLocalizer["Mobile_Card_Ios_Btn"]</span>
                    </a>
                </div>

                <!-- Google Android Card -->
                <div class="oz-platform-download-card">
                    <div class="oz-platform-card-header">
                        <div class="oz-platform-card-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993.0001.5511-.4482.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.9973-3.4592a.416.416 0 00-.1521-.5676.416.416 0 00-.5676.1521l-2.0223 3.503C15.5902 8.411 13.856 8 12 8s-3.5902.411-5.1367.9507L4.841 5.4467a.4161.4161 0 00-.5677-.1521.4157.4157 0 00-.152 5676l1.9972 3.4592C2.6889 11.1867.3432 14.6589 0 18.761h24c-.3432-4.1021-2.6889-7.5743-6.1185-9.4396"/></svg>
                        </div>
                        <div>
                            <h4>@SharedLocalizer["Mobile_Card_Android_Title"]</h4>
                            <span>@SharedLocalizer["Mobile_Card_Android_Sub"]</span>
                        </div>
                    </div>
                    <p style="font-size: 13.5px; color: var(--ozikol-text-secondary); margin: 0 0 12px 0;">@SharedLocalizer["Mobile_Card_Android_Desc"]</p>
                    <a href="https://play.google.com" target="_blank" rel="noopener" class="oz-platform-btn-download">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.793 12 3.61 22.186c-.347-.376-.554-.91-.554-1.554V3.368c0-.644.207-1.178.553-1.554zm11.605 11.605l2.42 2.42-12.87 7.43 10.45-9.85zm0-2.838l-10.45-9.85 12.87 7.43-2.42 2.42zm1.42 1.419l3.58 2.07c1.05.61 1.05 1.6 0 2.21l-3.58 2.07-2.14-2.14 2.14-2.21z"/></svg>
                        <span>@SharedLocalizer["Mobile_Card_Android_Btn"]</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- How to Connect Guide -->
    <section id="connect" class="container" style="padding-bottom: 60px;">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">@SharedLocalizer["Mobile_Steps_Tagline"]</div>
            <h2>@SharedLocalizer["Mobile_Steps_Heading"]</h2>
            <p class="oz-feat-card-desc">@SharedLocalizer["Mobile_Steps_Desc"]</p>
        </div>

        <div class="oz-platform-step-grid">
            <div class="oz-platform-step-card">
                <div class="oz-platform-step-num">1</div>
                <h4>@SharedLocalizer["Mobile_Step1_Title"]</h4>
                <p>@SharedLocalizer["Mobile_Step1_Desc"]</p>
            </div>
            <div class="oz-platform-step-card">
                <div class="oz-platform-step-num">2</div>
                <h4>@SharedLocalizer["Mobile_Step2_Title"]</h4>
                <p>@SharedLocalizer["Mobile_Step2_Desc"]</p>
            </div>
            <div class="oz-platform-step-card">
                <div class="oz-platform-step-num">3</div>
                <h4>@SharedLocalizer["Mobile_Step3_Title"]</h4>
                <p>@SharedLocalizer["Mobile_Step3_Desc"]</p>
            </div>
        </div>
    </section>
</div>
