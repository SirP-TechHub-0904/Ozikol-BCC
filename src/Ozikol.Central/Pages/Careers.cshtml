@page "/careers"
@model Ozikol.Central.Pages.CareersModel
@{
    ViewData["Title"] = "Careers at Ozikol | Love Work. Love Life. Be You.";
    ViewData["MetaDescription"] = "Join Ozikol's mission to revolutionize enterprise business management software. Explore open roles across engineering, customer care, regional leadership, and partnerships.";
}

<!-- Preserved Signature Hero Banner -->
<div class="oz-careers-hero-wrap">
    <section class="main-banner main-banner--inner" id="hero">
        <div class="main-banner__inner container--lg">
            <div class="main-banner__text-block container">
                <div class="oz-corp-badge">
                    <span class="oz-corp-badge-dot"></span>
                    <span>Join Our Global Team</span>
                </div>
                <h1 class="main-banner__title">
                    <div><span class="text-highlight">Love Work. Love Life. Be You.</span></div>
                </h1>
                <div class="main-banner__text rte">
                    <p>
                        It’s that simple. It’s the Ozikol Way. It’s what makes us unique. It’s what we want you to experience as you accelerate your career and fuel your passion for work while building the next generation of business management intelligence. Our mission gives customers and our people the freedom to do more.
                    </p>
                </div>
                <div class="main-banner__ctas">
                    <a href="#openings" class="btn btn-primary">View Open Roles</a>
                    <a href="#culture" class="btn btn-secondary">Life at Ozikol</a>
                </div>
            </div>

            <div class="main-banner__media-block">
                <div class="oz-hero-stat-card">
                    <div class="oz-hero-stat-num">@Model.Openings.Count</div>
                    <div class="oz-hero-stat-label">Active Global Openings</div>
                    <div class="oz-hero-stat-sub">Across UK, Europe &amp; Global Remote Teams</div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-around text-start">
                        <div>
                            <div class="fw-bold text-dark fs-5">3</div>
                            <div class="text-muted small">Supported Languages</div>
                        </div>
                        <div class="vr"></div>
                        <div>
                            <div class="fw-bold text-dark fs-5">100%</div>
                            <div class="text-muted small">Hybrid / Remote Ready</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Single In-Page Smooth Anchor Bar (Replaces duplicate second menu) -->
<nav class="oz-careers-nav-bar" aria-label="Careers Section Navigation">
    <div class="container">
        <div class="oz-careers-nav-wrap">
            <a href="#openings" class="oz-careers-nav-link active">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Open Roles (@Model.Openings.Count)
            </a>
            <a href="#culture" class="oz-careers-nav-link">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                Culture &amp; Life
            </a>
            <a href="#values" class="oz-careers-nav-link">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Our Values
            </a>
            <a href="#benefits" class="oz-careers-nav-link">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Global Benefits
            </a>
        </div>
    </div>
</nav>

<!-- Active Job Openings Section -->
<section class="oz-corp-section py-5" id="openings">
    <div class="oz-corp-container">
        <div class="oz-corp-section-header text-center mb-5">
            <span class="oz-corp-section-tag">Current Opportunities</span>
            <h2 class="oz-corp-section-title">Explore Open Positions at Ozikol</h2>
            <p class="oz-corp-section-desc">
                Find your calling in a team that values your voice, accelerates your growth, and respects your life outside work.
            </p>
        </div>

        <!-- Filter & Search Controls -->
        <div class="oz-jobs-filter-card">
            <form method="get" class="oz-jobs-filter-row">
                <!-- Search Input -->
                <div class="oz-filter-search-box">
                    <svg class="oz-filter-search-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input type="text"
                           name="query"
                           value="@Model.Query"
                           placeholder="Search roles by title, skill, or keyword (e.g. 'Admin', 'Customer Care', 'French')..."
                           class="oz-filter-search-input" />
                </div>

                <div class="row g-4 pt-2">
                    <!-- Department Filter Pills -->
                    <div class="col-lg-6 oz-filter-group">
                        <span class="oz-filter-group-title">Department:</span>
                        <div class="oz-filter-pills">
                            <a href="@Url.Page("/Careers", new { department = (string?)null, language = Model.Language, query = Model.Query })#openings"
                               class="oz-filter-pill @(string.IsNullOrEmpty(Model.Department) ? "is-active" : "")">
                                All Departments
                            </a>
                            @foreach (var dept in Model.Departments)
                            {
                                <a href="@Url.Page("/Careers", new { department = dept, language = Model.Language, query = Model.Query })#openings"
                                   class="oz-filter-pill @(Model.Department == dept ? "is-active" : "")">
                                    @dept
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Language Filter Pills -->
                    <div class="col-lg-6 oz-filter-group">
                        <span class="oz-filter-group-title">Language Requirements:</span>
                        <div class="oz-filter-pills">
                            <a href="@Url.Page("/Careers", new { department = Model.Department, language = (string?)null, query = Model.Query })#openings"
                               class="oz-filter-pill @(string.IsNullOrEmpty(Model.Language) ? "is-active" : "")">
                                All Languages
                            </a>
                            <a href="@Url.Page("/Careers", new { department = Model.Department, language = "English", query = Model.Query })#openings"
                               class="oz-filter-pill @(Model.Language == "English" ? "is-active" : "")">
                                English
                            </a>
                            <a href="@Url.Page("/Careers", new { department = Model.Department, language = "French", query = Model.Query })#openings"
                               class="oz-filter-pill @(Model.Language == "French" ? "is-active" : "")">
                                French (Bilingual)
                            </a>
                            <a href="@Url.Page("/Careers", new { department = Model.Department, language = "Italian", query = Model.Query })#openings"
                               class="oz-filter-pill @(Model.Language == "Italian" ? "is-active" : "")">
                                Italian (Bilingual)
                            </a>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Department) || !string.IsNullOrEmpty(Model.Language) || !string.IsNullOrEmpty(Model.Query))
                {
                    <div class="pt-2 d-flex align-items-center justify-content-between">
                        <span class="small text-muted">
                            Showing filtered results (@Model.Openings.Count positions found)
                        </span>
                        <a href="@Url.Page("/Careers")#openings" class="small text-danger fw-semibold text-decoration-none">
                            Reset all filters
                        </a>
                    </div>
                }
            </form>
        </div>

        <!-- Role Listings Grid -->
        @if (Model.Openings.Count > 0)
        {
            <div class="oz-jobs-grid">
                @foreach (var job in Model.Openings)
                {
                    <article class="oz-job-card">
                        <div class="oz-job-card-top">
                            <div class="oz-job-card-meta">
                                <span class="oz-job-badge-dept">@job.Department</span>
                                @if (!string.IsNullOrEmpty(job.LanguageRequirements))
                                {
                                    <span class="oz-job-badge-lang">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                                        </svg>
                                        @job.LanguageRequirements
                                    </span>
                                }
                                <span class="oz-job-badge-loc">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                    @job.Location
                                </span>
                            </div>
                            <h3 class="oz-job-card-title">@job.Title</h3>
                            <p class="oz-job-card-desc">@job.Summary</p>
                        </div>

                        <div class="oz-job-card-footer">
                            <span class="oz-job-type-pill">@job.EmploymentType</span>
                            <a href="/careers/@job.Slug" class="oz-job-card-btn">
                                View Role &amp; Apply
                                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 my-4 bg-light rounded-4 border p-5">
                <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-muted mb-3">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h4 class="fw-bold text-dark mb-2">No matching positions found</h4>
                <p class="text-muted mb-4 max-w-md mx-auto">
                    We couldn't find any openings matching your filter criteria. Try resetting your search filters or check back soon as new positions open regularly.
                </p>
                <a href="@Url.Page("/Careers")#openings" class="btn btn-outline-primary">View All Open Positions</a>
            </div>
        }
    </div>
</section>

<!-- Preserved & Polished Culture & Life Section -->
<section class="oz-corp-section bg-light border-top border-bottom py-5" id="culture">
    <div class="oz-corp-container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="oz-corp-section-tag">Life at Ozikol</span>
                <h2 class="oz-corp-section-title">People are at the heart of everything we build</h2>
                <p class="lead text-dark fw-semibold mb-3">
                    Our team members are game-changers, life-lovers, culture-builders, and free-thinkers.
                </p>
                <p class="oz-corp-section-desc mb-4">
                    We strive to create an environment where everyone feels valued, respected, and empowered to contribute their best. Whether you are leading regional strategy or providing frontline support to enterprise clients across Europe, you are an essential pillar of the Ozikol story.
                </p>
                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="oz-job-check-dot">&#10003;</div>
                        <div>
                            <strong class="text-dark">Curiosity &amp; Innovation:</strong>
                            <span class="text-muted"> We encourage questions, experimentation, and novel ideas that elevate our software and team.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="oz-job-check-dot">&#10003;</div>
                        <div>
                            <strong class="text-dark">Collective Celebration:</strong>
                            <span class="text-muted"> We win together as one united global squad and celebrate personal and team milestones.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3">
                        <div class="oz-job-check-dot">&#10003;</div>
                        <div>
                            <strong class="text-dark">Serious Fun:</strong>
                            <span class="text-muted"> Enterprise software is serious business, but our daily culture is relaxed, collaborative, and joyful.</span>
                        </div>
                    </div>
                </div>
                <a href="#openings" class="btn btn-primary">Find Your Role Today</a>
            </div>
            <div class="col-lg-6">
                <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm">
                    <h4 class="fw-bold text-dark mb-4">What Our Employees Say</h4>
                    <figure class="mb-4">
                        <blockquote class="blockquote fs-6 text-secondary mb-3">
                            &ldquo;Working at Ozikol has given me the autonomy to innovate and lead. The team genuinely cares about your wellbeing, and the global flexibility is unmatched.&rdquo;
                        </blockquote>
                        <figcaption class="blockquote-footer text-muted mb-0">
                            Regional Operations Lead &bull; <cite>Ozikol EMEA</cite>
                        </figcaption>
                    </figure>
                    <hr class="my-4" />
                    <figure class="mb-0">
                        <blockquote class="blockquote fs-6 text-secondary mb-3">
                            &ldquo;Providing support in French and Italian while collaborating with our global engineering team makes every single day rewarding and fast-paced.&rdquo;
                        </blockquote>
                        <figcaption class="blockquote-footer text-muted mb-0">
                            Customer Success Specialist &bull; <cite>Multilingual Support Hub</cite>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Preserved Our Values: The Ozikol Way -->
<section class="oz-corp-section py-5" id="values">
    <div class="oz-corp-container">
        <div class="oz-corp-section-header text-center mb-5">
            <span class="oz-corp-section-tag">Our Guiding Compass</span>
            <h2 class="oz-corp-section-title">Our Values: The Ozikol Way</h2>
            <p class="oz-corp-section-desc">
                Our values define how we support each other, serve our customers, and build durable software that empowers businesses worldwide.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="p-4 p-lg-5 bg-white border rounded-4 h-100 shadow-sm d-flex flex-column">
                    <div class="oz-feat-card-icon oz-icon-crimson mb-4">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="fs-4 fw-bold text-dark mb-3">Winning With Customers</h3>
                    <p class="text-secondary mb-0">
                        We are a team that gets it right. We make complex business management simple, transparent, and dependable. We are obsessed with making our customers’ lives better every single day.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 p-lg-5 bg-white border rounded-4 h-100 shadow-sm d-flex flex-column">
                    <div class="oz-feat-card-icon oz-icon-indigo mb-4">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                        </svg>
                    </div>
                    <h3 class="fs-4 fw-bold text-dark mb-3">Making Ozikol Better Daily</h3>
                    <p class="text-secondary mb-0">
                        We always make things happen. We stay endlessly curious. We believe learn-it-alls beat know-it-alls every single time, and we have serious fun while continuously learning.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 p-lg-5 bg-white border rounded-4 h-100 shadow-sm d-flex flex-column">
                    <div class="oz-feat-card-icon oz-icon-emerald mb-4">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <h3 class="fs-4 fw-bold text-dark mb-3">Helping Everyone Thrive</h3>
                    <p class="text-secondary mb-0">
                        Everyone belongs here &mdash; no exceptions. Your wellbeing and balance matter. We look after one another, our communities, and our planet. When everyone thrives, we all do.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Global Benefits Grid -->
<section class="oz-corp-section bg-light border-top py-5" id="benefits">
    <div class="oz-corp-container">
        <div class="oz-corp-section-header text-center mb-5">
            <span class="oz-corp-section-tag">Total Rewards &amp; Wellbeing</span>
            <h2 class="oz-corp-section-title">Designed to Help You Thrive</h2>
            <p class="oz-corp-section-desc">
                We believe in providing industry-leading benefits that empower your work, support your family, and secure your future.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="p-4 bg-white border rounded-4 h-100 shadow-sm">
                    <div class="oz-feat-card-icon oz-icon-rose mb-3">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Competitive Compensation</h4>
                    <p class="text-muted small mb-0">Market-benchmarked base salaries, annual merit reviews, and performance bonuses that reward direct impact.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="p-4 bg-white border rounded-4 h-100 shadow-sm">
                    <div class="oz-feat-card-icon oz-icon-blue mb-3">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Remote &amp; Hybrid Freedom</h4>
                    <p class="text-muted small mb-0">Flexible working models allowing you to work from home, regional hubs, or across borders with work-from-anywhere allowances.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="p-4 bg-white border rounded-4 h-100 shadow-sm">
                    <div class="oz-feat-card-icon oz-icon-cyan mb-3">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Health &amp; Wellness</h4>
                    <p class="text-muted small mb-0">Comprehensive private medical, dental, and vision insurance coverage plus mental health counseling resources.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="p-4 bg-white border rounded-4 h-100 shadow-sm">
                    <div class="oz-feat-card-icon oz-icon-amber mb-3">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Learning &amp; Growth Budget</h4>
                    <p class="text-muted small mb-0">Annual personal training budget, professional certifications, language lessons, and access to learning platforms.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="p-4 bg-white border rounded-4 h-100 shadow-sm">
                    <div class="oz-feat-card-icon oz-icon-violet mb-3">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Generous Paid Leave</h4>
                    <p class="text-muted small mb-0">28+ days of paid annual vacation plus regional public holidays, volunteer charity days, and parental leave packages.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="p-4 bg-white border rounded-4 h-100 shadow-sm">
                    <div class="oz-feat-card-icon oz-icon-emerald mb-3">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
