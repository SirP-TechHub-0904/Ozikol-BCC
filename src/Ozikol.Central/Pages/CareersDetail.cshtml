@page "/careers/{slug}"
@model Ozikol.Central.Pages.CareersDetailModel
@{
    ViewData["Title"] = $"{Model.Opening?.Title ?? SharedLocalizer["Careers_Detail_OpportunityFallback"].Value} | Ozikol Careers";
    ViewData["MetaDescription"] = Model.Opening?.Summary ?? SharedLocalizer["Careers_Detail_MetaFallback"].Value;
}

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        function updateFileName(input, targetId) {
            const target = document.getElementById(targetId);
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                target.textContent = file.name + " (" + sizeMb + " MB)";
                target.style.color = "#059669";
                target.style.fontWeight = "700";
            }
        }
    </script>
}

<div class="oz-corp-page">
    <!-- Breadcrumb & Header Bar -->
    <header class="oz-corp-banner" style="padding: 48px 24px; text-align: left;">
        <div class="oz-corp-container">
            <nav aria-label="breadcrumb" style="margin-bottom: 20px;">
                <div class="d-flex align-items-center gap-2" style="font-size: 13.5px;">
                    <a href="/@Model.CurrentCulture" style="text-decoration: none; color: #64748b; font-weight: 500;">@SharedLocalizer["Careers_Detail_Breadcrumb_Home"]</a>
                    <span style="color: #cbd5e1;">/</span>
                    <a href="/@Model.CurrentCulture/careers" style="text-decoration: none; color: #64748b; font-weight: 500;">@SharedLocalizer["Careers_Detail_Breadcrumb_Careers"]</a>
                    <span style="color: #cbd5e1;">/</span>
                    <span style="color: #0f172a; font-weight: 700;">@Model.Opening.Title</span>
                </div>
            </nav>

            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px;">
                <span class="oz-job-badge-dept">@Model.Opening.Department</span>
                @if (!string.IsNullOrEmpty(Model.Opening.LanguageRequirements))
                {
                    <span class="oz-job-badge-lang">
                        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                        </svg>
                        @Model.Opening.LanguageRequirements
                    </span>
                }
                <span class="oz-job-badge-loc">
                    <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    @Model.Opening.Location
                </span>
                <span class="oz-job-type-pill" style="margin-left: auto;">@Model.Opening.EmploymentType</span>
            </div>

            <h1 class="oz-corp-title" style="text-align: left; margin-bottom: 12px;">@Model.Opening.Title</h1>
            <p class="oz-corp-lead" style="text-align: left; margin: 0; max-width: 860px;">@Model.Opening.Summary</p>
        </div>
    </header>

    <!-- Main Content & Application Form Grid -->
    <main class="oz-corp-section py-5">
        <div class="oz-corp-container">
            <div class="oz-job-detail-grid">
                
                <!-- Left: Full Job Description & Requirements -->
                <div class="oz-job-content-card">
                    <!-- About the Role -->
                    <div class="oz-job-content-block">
                        <h2 class="oz-job-content-title">@SharedLocalizer["Careers_Detail_AboutTitle"]</h2>
                        <div style="color: #475569; font-size: 15px; line-height: 1.75;">
                            @Html.Raw(Model.Opening.DescriptionHtml.Replace("\n", "<br />"))
                        </div>
                    </div>

                    <!-- Key Responsibilities -->
                    <div class="oz-job-content-block">
                        <h2 class="oz-job-content-title">@SharedLocalizer["Careers_Detail_ResponsibilitiesTitle"]</h2>
                        <ul class="oz-job-list">
                            @foreach (var resp in Model.Opening.Responsibilities)
                            {
                                <li class="oz-job-list-item">
                                    <span class="oz-job-check-dot">&#10003;</span>
                                    <span>@resp</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Qualifications -->
                    <div class="oz-job-content-block">
                        <h2 class="oz-job-content-title">@Html.Raw(SharedLocalizer["Careers_Detail_QualificationsTitle"].Value)</h2>
                        <ul class="oz-job-list">
                            @foreach (var qual in Model.Opening.Qualifications)
                            {
                                <li class="oz-job-list-item">
                                    <span class="oz-job-check-dot">&#10003;</span>
                                    <span>@qual</span>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- Role Benefits -->
                    <div class="oz-job-content-block mb-0">
                        <h2 class="oz-job-content-title">@SharedLocalizer["Careers_Detail_BenefitsTitle"]</h2>
                        <ul class="oz-job-list">
                            @foreach (var ben in Model.Opening.Benefits)
                            {
                                <li class="oz-job-list-item">
                                    <span class="oz-job-check-dot">&#10003;</span>
                                    <span>@ben</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Right: Application Form / Submission Confirmation -->
                <div class="oz-job-form-wrapper">
                    @if (Model.IsSubmitted)
                    {
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; padding: 40px 32px; text-align: center; box-shadow: 0 12px 36px rgba(15, 23, 42, 0.08); position: sticky; top: 90px;">
                            <div style="margin-bottom: 24px;">
                                <div class="oz-icon-emerald" style="width: 56px; height: 56px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                                    <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                                <h3 style="font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 8px;">@SharedLocalizer["Careers_Apply_Success_Title"]</h3>
                                <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0;">
                                    @SharedLocalizer["Careers_Apply_Success_Desc"]
                                </p>
                            </div>

                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px; margin-bottom: 24px; text-align: left;">
                                <div style="font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 6px;">@SharedLocalizer["Careers_Apply_Success_RefLabel"]</div>
                                <div style="font-size: 20px; font-weight: 800; color: #e5173f; font-family: monospace;">@Model.AssignedReference</div>
                                <div style="font-size: 12.5px; color: #64748b; margin-top: 8px; line-height: 1.5;">
                                    @SharedLocalizer["Careers_Apply_Success_Note"]
                                </div>
                            </div>

                            <div>
                                <a href="/@Model.CurrentCulture/careers#openings" class="oz-features-btn-outline" style="width: 100%; box-sizing: border-box; justify-content: center;">
                                    @SharedLocalizer["Careers_Apply_Success_BtnBrowse"]
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; padding: 36px 30px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05); position: sticky; top: 90px;">
                            <div style="border-bottom: 1px solid #f1f5f9; padding-bottom: 18px; margin-bottom: 24px;">
                                <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; margin: 0 0 6px 0;">@SharedLocalizer["Careers_Apply_Form_Title"]</h3>
                                <p style="font-size: 13.5px; color: #64748b; margin: 0;">@Html.Raw(SharedLocalizer["Careers_Apply_Form_Desc"].Value)</p>
                            </div>

                            @if (!ModelState.IsValid && HttpContext.Request.Method == "POST")
                            {
                                <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 14px 18px; margin-bottom: 20px; font-size: 13.5px; color: #991b1b;">
                                    <div style="font-weight: 700; margin-bottom: 6px;">@SharedLocalizer["Careers_Apply_ReviewErrors"]</div>
                                    <ul style="margin: 0; padding-left: 20px;">
                                        @foreach (var modelError in ModelState.Values)
                                        {
                                            @foreach (var err in modelError.Errors)
                                            {
                                                <li>@err.ErrorMessage</li>
                                            }
                                        }
                                    </ul>
                                </div>
                            }

                            <form method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Input.JobOpeningId" />

                                <!-- Full Name -->
                                <div class="oz-partner-field">
                                    <label asp-for="Input.FullName" class="oz-partner-label">
                                        @SharedLocalizer["Careers_Apply_FullName"] <span class="oz-partner-req">*</span>
                                    </label>
                                    <input asp-for="Input.FullName"
                                           class="oz-partner-input"
                                           placeholder="@SharedLocalizer["Careers_Apply_FullName_Placeholder"]"
                                           required />
                                    <span asp-validation-for="Input.FullName" class="oz-partner-field-error"></span>
                                </div>

                                <!-- Email Address -->
                                <div class="oz-partner-field">
                                    <label asp-for="Input.Email" class="oz-partner-label">
                                        @SharedLocalizer["Careers_Apply_Email"] <span class="oz-partner-req">*</span>
                                    </label>
                                    <input asp-for="Input.Email"
                                           type="email"
                                           class="oz-partner-input"
                                           placeholder="@SharedLocalizer["Careers_Apply_Email_Placeholder"]"
                                           required />
                                    <span asp-validation-for="Input.Email" class="oz-partner-field-error"></span>
                                </div>

                                <!-- Phone Number -->
                                <div class="oz-partner-field">
                                    <label asp-for="Input.PhoneNumber" class="oz-partner-label">
                                        @SharedLocalizer["Careers_Apply_Phone"] <span class="oz-partner-req">*</span>
                                    </label>
                                    <input asp-for="Input.PhoneNumber"
                                           class="oz-partner-input"
                                           placeholder="@SharedLocalizer["Careers_Apply_Phone_Placeholder"]"
                                           required />
                                    <span asp-validation-for="Input.PhoneNumber" class="oz-partner-field-error"></span>
                                </div>

                                <!-- City & Country Row -->
                                <div class="oz-partner-row">
                                    <div class="oz-partner-field">
                                        <label asp-for="Input.City" class="oz-partner-label">
                                            @SharedLocalizer["Careers_Apply_City"] <span class="oz-partner-req">*</span>
                                        </label>
                                        <input asp-for="Input.City"
                                               class="oz-partner-input"
                                               placeholder="@SharedLocalizer["Careers_Apply_City_Placeholder"]"
                                               required />
                                        <span asp-validation-for="Input.City" class="oz-partner-field-error"></span>
                                    </div>
                                    <div class="oz-partner-field">
                                        <label asp-for="Input.Country" class="oz-partner-label">
                                            @SharedLocalizer["Careers_Apply_Country"] <span class="oz-partner-req">*</span>
                                        </label>
                                        <input asp-for="Input.Country"
                                               class="oz-partner-input"
                                               placeholder="@SharedLocalizer["Careers_Apply_Country_Placeholder"]"
                                               required />
                                        <span asp-validation-for="Input.Country" class="oz-partner-field-error"></span>
                                    </div>
                                </div>

                                <!-- LinkedIn Profile -->
                                <div class="oz-partner-field">
                                    <label asp-for="Input.LinkedInOrPortfolioUrl" class="oz-partner-label">
                                        @SharedLocalizer["Careers_Apply_LinkedIn"] <span style="font-weight: normal; color: #94a3b8;">@SharedLocalizer["Careers_Apply_Optional"]</span>
                                    </label>
                                    <input asp-for="Input.LinkedInOrPortfolioUrl"
                                           type="url"
                                           class="oz-partner-input"
                                           placeholder="@SharedLocalizer["Careers_Apply_LinkedIn_Placeholder"]" />
                                </div>

                                <!-- Cover Letter -->
                                <div class="oz-partner-field">
                                    <label asp-for="Input.CoverLetter" class="oz-partner-label">
                                        @SharedLocalizer["Careers_Apply_CoverLetter"] <span class="oz-partner-req">*</span>
                                    </label>
                                    <textarea asp-for="Input.CoverLetter"
                                              rows="4"
                                              class="oz-partner-textarea"
                                              placeholder="@SharedLocalizer["Careers_Apply_CoverLetter_Placeholder"]"
                                              required></textarea>
                                    <span asp-validation-for="Input.CoverLetter" class="oz-partner-field-error"></span>
                                </div>

                                <!-- CV File Upload -->
                                <div class="oz-partner-field">
                                    <label class="oz-partner-label">
                                        @SharedLocalizer["Careers_Apply_UploadCv"] <span class="oz-partner-req">*</span>
                                    </label>
                                    <div class="oz-file-upload-box">
                                        <input type="file"
                                               asp-for="Input.CvFile"
                                               class="oz-file-upload-input"
                                               accept=".pdf,.docx,.doc"
                                               onchange="updateFileName(this, 'cvFileNamePreview')"
                                               required />
                                        <div class="oz-file-upload-icon">
                                            <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                        </div>
                                        <div class="oz-file-upload-title" id="cvFileNamePreview">
                                            @SharedLocalizer["Careers_Apply_UploadCv_Select"]
                                        </div>
                                        <div class="oz-file-upload-hint">@SharedLocalizer["Careers_Apply_UploadCv_Format"]</div>
                                    </div>
                                    <span asp-validation-for="Input.CvFile" class="oz-partner-field-error"></span>
                                </div>

                                <!-- Passport File Upload -->
                                <div class="oz-partner-field">
                                    <label class="oz-partner-label">
                                        @SharedLocalizer["Careers_Apply_UploadPassport"] <span class="oz-partner-req">*</span>
                                    </label>
                                    <div class="oz-file-upload-box">
                                        <input type="file"
                                               asp-for="Input.PassportFile"
                                               class="oz-file-upload-input"
                                               accept=".pdf,.jpg,.jpeg,.png"
                                               onchange="updateFileName(this, 'passportFileNamePreview')"
                                               required />
                                        <div class="oz-file-upload-icon">
                                            <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2" />
                                            </svg>
                                        </div>
                                        <div class="oz-file-upload-title" id="passportFileNamePreview">
                                            @SharedLocalizer["Careers_Apply_UploadPassport_Select"]
                                        </div>
                                        <div class="oz-file-upload-hint">@SharedLocalizer["Careers_Apply_UploadPassport_Format"]</div>
                                    </div>
                                    <span asp-validation-for="Input.PassportFile" class="oz-partner-field-error"></span>
                                </div>

                                <!-- Terms & Privacy Checkbox -->
                                <div class="oz-partner-field" style="margin-top: 10px;">
                                    <label class="oz-partner-checkbox-label">
                                        <input type="checkbox"
                                               asp-for="Input.AgreeTerms"
                                               id="agreeTermsCheck"
                                               style="margin-top: 3px;"
                                               required />
                                        <span>
                                            @SharedLocalizer["Careers_Apply_Terms"] <span class="oz-partner-req">*</span>
                                        </span>
                                    </label>
                                    <span asp-validation-for="Input.AgreeTerms" class="oz-partner-field-error"></span>
                                </div>

                                <!-- Google reCAPTCHA -->
                                <div class="oz-recaptcha-wrap">
                                    <div class="g-recaptcha" data-sitekey="@Model.RecaptchaSiteKey"></div>
                                </div>

                                <!-- Submit Button -->
                                <div class="oz-partner-submit-wrap" style="margin-top: 16px;">
                                    <button type="submit" class="oz-btn-primary-hero oz-partner-submit-btn" style="width: 100%; justify-content: center;">
                                        <span>@SharedLocalizer["Careers_Apply_BtnSubmit"]</span>
                                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                        </svg>
                                    </button>
                                </div>

                                <div style="text-align: center; color: #94a3b8; font-size: 12px; margin-top: 14px; display: flex; align-items: center; justify-content: center; gap: 6px;">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                    <span>@Html.Raw(SharedLocalizer["Careers_Apply_SecurityBadge"].Value)</span>
                                </div>
                            </form>
                        </div>
                    }
                </div>

            </div>
        </div>
    </main>
</div>
