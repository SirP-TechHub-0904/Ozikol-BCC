@page "/marketplace/creator-program"
@model Ozikol.Central.Pages.Marketplace.CreatorProgramModel
@{
    ViewData["Title"] = SharedLocalizer["Creator_Page_Title"];
}

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
}

<div class="oz-corp-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="oz-corp-container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@Model.CurrentCulture">@SharedLocalizer["Breadcrumb_Home"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/@Model.CurrentCulture/marketplace">@SharedLocalizer["Marketplace_Nav"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@SharedLocalizer["Creator_Breadcrumb_Title"]</span>
                </div>
                <a href="/@Model.CurrentCulture/marketplace" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>@SharedLocalizer["Creator_Btn_BackToMarketplace"]</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-corp-banner">
        <div class="oz-corp-banner-wrap">
            <div class="oz-corp-badge">
                <span class="oz-corp-badge-dot"></span>
                @SharedLocalizer["Creator_Hero_Badge"]
            </div>
            <h1 class="oz-corp-title">
                @Html.Raw(SharedLocalizer["Creator_Hero_Title"].Value)
            </h1>
            <p class="oz-corp-lead">
                @SharedLocalizer["Creator_Hero_Lead"]
            </p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="#apply" class="oz-btn-primary-hero">
                    <span>@SharedLocalizer["Creator_Hero_BtnPrimary"]</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <polyline points="19 12 12 19 5 12"></polyline>
                    </svg>
                </a>
                <a href="/@Model.CurrentCulture/marketplace" class="oz-btn-outline-hero">
                    <span>@SharedLocalizer["Creator_Hero_BtnSecondary"]</span>
                </a>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="oz-corp-container oz-corp-section">
        @if (Model.IsSubmitted)
        {
            <!-- Success Confirmation Screen -->
            <div class="oz-partner-success-wrap">
                <div class="oz-partner-success-card">
                    <div class="oz-corp-card-icon oz-icon-emerald oz-partner-success-icon" aria-hidden="true">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    </div>
                    <span class="oz-corp-badge-pill">@SharedLocalizer["Creator_Success_Badge"]</span>
                    <h2 class="oz-partner-success-title">@SharedLocalizer["Creator_Success_Title"]</h2>
                    <p class="oz-partner-success-desc">@SharedLocalizer["Creator_Success_Desc"]</p>

                    <div class="oz-partner-ref-box">
                        <div class="oz-partner-ref-label">@SharedLocalizer["Creator_Success_RefLabel"]</div>
                        <div class="oz-partner-ref-code">@Model.AssignedCreatorCode</div>
                    </div>

                    <div class="oz-partner-next-steps">
                        <h4>@SharedLocalizer["Creator_Success_StepsTitle"]</h4>
                        <ul class="oz-corp-list">
                            <li class="oz-corp-list-item">
                                <span class="oz-corp-check">&#10003;</span>
                                <span>@SharedLocalizer["Creator_Success_Step1"]</span>
                            </li>
                            <li class="oz-corp-list-item">
                                <span class="oz-corp-check">&#10003;</span>
                                <span>@SharedLocalizer["Creator_Success_Step2"]</span>
                            </li>
                            <li class="oz-corp-list-item">
                                <span class="oz-corp-check">&#10003;</span>
                                <span>@SharedLocalizer["Creator_Success_Step3"]</span>
                            </li>
                        </ul>
                    </div>

                    <div class="oz-partner-success-actions">
                        <a href="/@Model.CurrentCulture/marketplace" class="oz-btn-primary-hero">
                            <span>@SharedLocalizer["Creator_Success_BtnMarketplace"]</span>
                        </a>
                        <a href="/@Model.CurrentCulture" class="oz-btn-outline-hero">
                            <span>@SharedLocalizer["Creator_Success_BtnHome"]</span>
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Section 1: What Creators Build -->
            <section class="oz-corp-section">
                <div class="oz-corp-section-header">
                    <span class="oz-corp-section-tag">@SharedLocalizer["Creator_Categories_Tag"]</span>
                    <h2 class="oz-corp-section-title">@SharedLocalizer["Creator_Categories_Title"]</h2>
                    <p class="oz-corp-section-desc">@SharedLocalizer["Creator_Categories_Desc"]</p>
                </div>
                <div class="oz-corp-grid-3">
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-blue" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        </div>
                        <span class="oz-corp-badge-pill">@SharedLocalizer["Creator_Cat1_Badge"]</span>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Cat1_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Cat1_Desc"]</p>
                    </div>
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-indigo" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        </div>
                        <span class="oz-corp-badge-pill">@SharedLocalizer["Creator_Cat2_Badge"]</span>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Cat2_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Cat2_Desc"]</p>
                    </div>
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-emerald" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </div>
                        <span class="oz-corp-badge-pill">@SharedLocalizer["Creator_Cat3_Badge"]</span>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Cat3_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Cat3_Desc"]</p>
                    </div>
                </div>
            </section>

            <!-- Section 2: Creator Benefits (Zero Figures) -->
            <section class="oz-corp-section">
                <div class="oz-corp-section-header">
                    <span class="oz-corp-section-tag">@SharedLocalizer["Creator_Benefits_Tag"]</span>
                    <h2 class="oz-corp-section-title">@SharedLocalizer["Creator_Benefits_Title"]</h2>
                    <p class="oz-corp-section-desc">@SharedLocalizer["Creator_Benefits_Desc"]</p>
                </div>
                <div class="oz-corp-grid-3">
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-amber" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg>
                        </div>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Ben1_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Ben1_Desc"]</p>
                    </div>
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-crimson" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                        </div>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Ben2_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Ben2_Desc"]</p>
                    </div>
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-teal" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                        </div>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Ben3_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Ben3_Desc"]</p>
                    </div>
                </div>
            </section>

            <!-- Section 3: 3-Step Journey -->
            <section class="oz-corp-section">
                <div class="oz-corp-section-header">
                    <span class="oz-corp-section-tag">@SharedLocalizer["Creator_Steps_Tag"]</span>
                    <h2 class="oz-corp-section-title">@SharedLocalizer["Creator_Steps_Title"]</h2>
                    <p class="oz-corp-section-desc">@SharedLocalizer["Creator_Steps_Desc"]</p>
                </div>
                <div class="oz-corp-grid-3">
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-blue" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                        </div>
                        <span class="oz-corp-badge-pill">Step 01</span>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Step1_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Step1_Desc"]</p>
                    </div>
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-indigo" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        </div>
                        <span class="oz-corp-badge-pill">Step 02</span>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Step2_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Step2_Desc"]</p>
                    </div>
                    <div class="oz-corp-card">
                        <div class="oz-corp-card-icon oz-icon-emerald" aria-hidden="true">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                        </div>
                        <span class="oz-corp-badge-pill">Step 03</span>
                        <h3 class="oz-corp-card-title">@SharedLocalizer["Creator_Step3_Title"]</h3>
                        <p class="oz-corp-card-desc">@SharedLocalizer["Creator_Step3_Desc"]</p>
                    </div>
                </div>
            </section>

            <!-- Section 4: Application Form with reCAPTCHA -->
            <section id="apply" class="oz-corp-section oz-partner-form-section">
                <div class="oz-partner-form-card">
                    <div class="oz-partner-form-header">
                        <span class="oz-corp-badge-pill">@SharedLocalizer["Creator_Form_Badge"]</span>
                        <h2>@SharedLocalizer["Creator_Form_Title"]</h2>
                        <p>@SharedLocalizer["Creator_Form_Desc"]</p>
                    </div>

                    <form method="post" class="oz-partner-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="oz-form-validation-error"></div>

                        <div class="oz-form-grid-2">
                            <div class="oz-form-group">
                                <label asp-for="Input.FullName" class="oz-form-label">@SharedLocalizer["Creator_Field_FullName"] *</label>
                                <input asp-for="Input.FullName" class="oz-form-input" placeholder="e.g. Elena Rostova" />
                                <span asp-validation-for="Input.FullName" class="oz-field-error"></span>
                            </div>
                            <div class="oz-form-group">
                                <label asp-for="Input.StudioName" class="oz-form-label">@SharedLocalizer["Creator_Field_StudioName"]</label>
                                <input asp-for="Input.StudioName" class="oz-form-input" placeholder="e.g. Apex Interface Lab" />
                                <span asp-validation-for="Input.StudioName" class="oz-field-error"></span>
                            </div>
                        </div>

                        <div class="oz-form-grid-2">
                            <div class="oz-form-group">
                                <label asp-for="Input.Email" class="oz-form-label">@SharedLocalizer["Creator_Field_Email"] *</label>
                                <input asp-for="Input.Email" type="email" class="oz-form-input" placeholder="elena@apexstudio.design" />
                                <span asp-validation-for="Input.Email" class="oz-field-error"></span>
                            </div>
                            <div class="oz-form-group">
                                <label asp-for="Input.Phone" class="oz-form-label">@SharedLocalizer["Creator_Field_Phone"]</label>
                                <input asp-for="Input.Phone" type="tel" class="oz-form-input" placeholder="+1 (555) 019-2834" />
                                <span asp-validation-for="Input.Phone" class="oz-field-error"></span>
                            </div>
                        </div>

                        <div class="oz-form-grid-2">
                            <div class="oz-form-group">
                                <label asp-for="Input.PortfolioUrl" class="oz-form-label">@SharedLocalizer["Creator_Field_PortfolioUrl"] *</label>
                                <input asp-for="Input.PortfolioUrl" class="oz-form-input" placeholder="https://figma.com/@@studio or https://github.com/profile" />
                                <span asp-validation-for="Input.PortfolioUrl" class="oz-field-error"></span>
                            </div>
                            <div class="oz-form-group">
                                <label asp-for="Input.Specialization" class="oz-form-label">@SharedLocalizer["Creator_Field_Specialization"] *</label>
                                <select asp-for="Input.Specialization" class="oz-form-input">
                                    <option value="Landing Suites & Heros">Landing Suites &amp; Hero Showcases</option>
                                    <option value="Suite Navigation & Headers">Suite Navigation &amp; Mega Menus</option>
                                    <option value="Operational Dashboards">Operational Dashboards &amp; Widgets</option>
                                    <option value="Form Kits & Interactive Inputs">Form Kits &amp; Workflow Surveys</option>
                                    <option value="Industry Blueprints">Industry &amp; Nonprofit Full Blueprints</option>
                                </select>
                                <span asp-validation-for="Input.Specialization" class="oz-field-error"></span>
                            </div>
                        </div>

                        <div class="oz-form-group">
                            <label asp-for="Input.ProposalPitch" class="oz-form-label">@SharedLocalizer["Creator_Field_Pitch"] *</label>
                            <textarea asp-for="Input.ProposalPitch" rows="4" class="oz-form-textarea" placeholder="@SharedLocalizer["Creator_Field_PitchPlaceholder"]"></textarea>
                            <span asp-validation-for="Input.ProposalPitch" class="oz-field-error"></span>
                        </div>

                        <!-- Terms & Conditions Checkbox -->
                        <div class="oz-form-group oz-checkbox-group">
                            <label class="oz-checkbox-label">
                                <input asp-for="Input.AgreeTerms" type="checkbox" class="oz-checkbox-input" />
                                <span>
                                    @SharedLocalizer["Creator_Field_AgreeTerms"]
                                    <a href="/@Model.CurrentCulture/legal/terms-conditions" target="_blank" class="oz-link-accent">Creator Program Terms</a>
                                </span>
                            </label>
                            <span asp-validation-for="Input.AgreeTerms" class="oz-field-error"></span>
                        </div>

                        <!-- Google reCAPTCHA Verification Widget -->
                        <div class="oz-recaptcha-wrap">
                            <div class="g-recaptcha" data-sitekey="@Model.RecaptchaSiteKey"></div>
                        </div>

                        <div class="oz-partner-form-actions">
                            <button type="submit" class="oz-btn-primary-hero oz-btn-block">
                                <span>@SharedLocalizer["Creator_Btn_Submit"]</span>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        }
    </main>
</div>
