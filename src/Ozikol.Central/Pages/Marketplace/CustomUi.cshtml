@page "/marketplace/custom-ui"
@model Ozikol.Central.Pages.Marketplace.CustomUiModel
@{
    ViewData["Title"] = "Request Custom UI & Bespoke Enterprise Design - Ozikol";
    ViewData["MetaDescription"] = "Request custom-tailored branding, bespoke component packs, and custom-coded sections crafted specifically for your enterprise.";
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>Request Custom UI & Bespoke Enterprise Design</span>
                </div>
                <partial name="_BackToFeaturesLink" />
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                </div>
                <span class="oz-feat-pill">Bespoke Design • Enterprise UI</span>
            </div>
            <h1 class="oz-feat-title">Custom UI Development for Your Organization</h1>
            <p class="oz-feat-lead">Need a bespoke operational layout, specialized department dashboard, or white-labeled custom front-end? Our design engineering team builds and tests custom UI components tailored to your exact specifications.</p>
            <div class="oz-feat-actions">
                <a href="/support#contact" class="btn btn-primary">Submit Design Brief</a>
                <a href="/marketplace" class="btn btn-secondary--alt">Browse Existing Blueprints</a>
            </div>
        </div>
    </section>

    <!-- Custom Design Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">Bespoke Engineering</div>
            <h2>Tailored from Wireframe to Code</h2>
            <p class="oz-feat-card-desc">End-to-end bespoke design services delivered within your Ozikol environment.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">White-Label Branding</h3>
                <p class="oz-feat-card-desc">Custom color palettes, custom typography, logos, and custom UI micro-interactions aligned with your corporate brand guidelines.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Bespoke Department Dashboards</h3>
                <p class="oz-feat-card-desc">Purpose-built views for specialized workflows such as ward patient bed tracking, census district mapping, and heavy equipment telemetry.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Accessibility &amp; WCAG AAA</h3>
                <p class="oz-feat-card-desc">All custom designs are engineered to strict WCAG 2.1 AAA accessibility standards with full keyboard navigation and screen reader support.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Experience the Power of Ozikol</h2>
            <p>Deploy custom modules, automate operations, and empower your organization today.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support#contact" class="btn btn-primary">Book a Platform Demo</a>
                <partial name="_ExploreFeaturesButton" />
            </div>
        </div>
    </section>
</div>
