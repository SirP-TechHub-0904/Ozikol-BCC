@page "/sitemap"
@model Ozikol.Central.Pages.SitemapModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<Ozikol.Central.SharedResource> SharedLocalizer
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    ViewData["Title"] = $"{SharedLocalizer["Sitemap_Hero_Title"]} - Ozikol";
}

<div class="oz-sitemap-page">
    <!-- Hero Header -->
    <header class="oz-sitemap-hero">
        <div class="container">
            <div class="oz-sitemap-hero-content">
                <div class="oz-sitemap-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"></circle><path d="M3 12h6m6 0h6M12 3v6m0 6v6"></path></svg>
                    <span>@SharedLocalizer["Sitemap_Hero_Badge"]</span>
                </div>
                <h1 class="oz-sitemap-title">@SharedLocalizer["Sitemap_Hero_Title"]</h1>
                <p class="oz-sitemap-desc">@SharedLocalizer["Sitemap_Hero_Desc"]</p>

                <div class="oz-sitemap-actions">
                    <div class="oz-sitemap-search-wrap">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" id="sitemapFilter" placeholder="@SharedLocalizer["Sitemap_Search_Placeholder"]" oninput="filterSitemap(this.value)" />
                    </div>
                    <a href="/sitemap.xml" target="_blank" class="oz-sitemap-xml-btn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span>@SharedLocalizer["Sitemap_Xml_Badge"]</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Directory Grid -->
    <main class="oz-sitemap-main">
        <div class="container">
            <div class="oz-sitemap-grid" id="sitemapGrid">
                
                <!-- Section 1: Platform Suite -->
                <section class="oz-sitemap-col">
                    <div class="oz-sitemap-col-header">
                        <span class="oz-sitemap-col-icon platform">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                        </span>
                        <h2>@SharedLocalizer["Sitemap_Sec_Platform"]</h2>
                    </div>
                    <ul class="oz-sitemap-list">
                        <li><a href="/@currentCulture/platform/website">@SharedLocalizer["Nav_Website"]</a></li>
                        <li><a href="/@currentCulture/platform/mis-system">@SharedLocalizer["Nav_MisSystem"]</a></li>
                        <li><a href="/@currentCulture/platform/mobile-app">@SharedLocalizer["Nav_MobileApp"]</a></li>
                        <li><a href="/@currentCulture/platform/desktop-app">@SharedLocalizer["Nav_DesktopApp"]</a></li>
                    </ul>

                    <div class="oz-sitemap-col-header" style="margin-top: 32px;">
                        <span class="oz-sitemap-col-icon commercial">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
                        </span>
                        <h2>Commercial & Pricing</h2>
                    </div>
                    <ul class="oz-sitemap-list">
                        <li><a href="/@currentCulture/">@SharedLocalizer["Nav_Home"]</a></li>
                        <li><a href="/@currentCulture/pricing">@SharedLocalizer["Nav_Pricing"]</a></li>
                        <li><a href="/@currentCulture/features">@SharedLocalizer["Nav_Features"]</a></li>
                        <li><a href="/@currentCulture/marketplace">@SharedLocalizer["Nav_Marketplace"]</a></li>
                        <li><a href="/@currentCulture/marketplace/creator-program">Creator Program</a></li>
                    </ul>
                </section>

                <!-- Section 2: Support & Helpdesk -->
                <section class="oz-sitemap-col">
                    <div class="oz-sitemap-col-header">
                        <span class="oz-sitemap-col-icon support">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                        </span>
