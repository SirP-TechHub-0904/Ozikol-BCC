                        <li><a href="/@currentCulture/about-us/offices">@SharedLocalizer["Nav_Offices"]</a></li>
                        <li><a href="/@currentCulture/about-us/partners">@SharedLocalizer["Nav_Partners"]</a></li>
                        <li><a href="/@currentCulture/partners/register">Partner Registration</a></li>
                        <li><a href="/@currentCulture/careers">@SharedLocalizer["Nav_Careers"]</a></li>
                        <li><a href="/@currentCulture/news">Newsroom & Press</a></li>
                        <li><a href="/@currentCulture/developer-api">@SharedLocalizer["Nav_DeveloperApi"]</a></li>
                        <li><a href="/@currentCulture/auth/login">Console Sign-In</a></li>
                        <li><a href="/@currentCulture/auth/get-started">Start Sovereign Trial</a></li>
                    </ul>
                </section>

                <!-- Section 4: Enterprise Modules & Features (Span 2 or Full Width) -->
