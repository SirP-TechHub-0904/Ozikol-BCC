                            <li><a href="/@currentCulture/features/committees">Committees & Governance</a></li>
                            <li><a href="/@currentCulture/features/community-census">Community Census & Household Rosters</a></li>
                            <li><a href="/@currentCulture/features/community-messenger">Community Messenger</a></li>
                            <li><a href="/@currentCulture/features/company-assets">Asset Tracking & QR Check-Out</a></li>
                            <li><a href="/@currentCulture/features/demographic-analytics">Demographic & Population Analytics</a></li>
                            <li><a href="/@currentCulture/features/document-management">Document Vault & ISO Governance</a></li>
                        </ul>
                        <ul class="oz-sitemap-list">
                            <li><a href="/@currentCulture/features/elections-evoting">E-Voting & General Elections</a></li>
                            <li><a href="/@currentCulture/features/equipment-fleet">Equipment & Fleet Allocation</a></li>
                            <li><a href="/@currentCulture/features/event-ticketing">Event Ticketing & Payments</a></li>
                            <li><a href="/@currentCulture/features/field-surveyor">Offline Field Surveyor Agent</a></li>
                            <li><a href="/@currentCulture/features/form-builder">Custom Dynamic Form Builder</a></li>
                            <li><a href="/@currentCulture/features/grant-ledger">Grant & Fund Tracking Ledger</a></li>
                            <li><a href="/@currentCulture/features/helpdesk-support">Internal Helpdesk & Ticket SLAs</a></li>
                            <li><a href="/@currentCulture/features/interval-reporting">Interval & Activity Reporting</a></li>
                            <li><a href="/@currentCulture/features/invoicing-dues">Invoicing & Dues Collection</a></li>
                            <li><a href="/@currentCulture/features/learning-management">Learning Management & Courses</a></li>
                            <li><a href="/@currentCulture/features/live-chat">Live Visitor Chat & Helpdesk</a></li>
                            <li><a href="/@currentCulture/features/mass-communication">Multi-Channel Mass Broadcasts</a></li>
                        </ul>
                        <ul class="oz-sitemap-list">
                            <li><a href="/@currentCulture/features/project-task-tracking">Project & Task Kanban Tracking</a></li>
                            <li><a href="/@currentCulture/features/proposal-pipeline">Bid & Proposal Pipeline</a></li>
                            <li><a href="/@currentCulture/features/recruitment-hiring">Job Boards & Candidate Pipeline</a></li>
                            <li><a href="/@currentCulture/features/resident-id-cards">Smart Resident NFC/RFID ID Cards</a></li>
                            <li><a href="/@currentCulture/features/shift-swaps-leave">Shift Swaps & Leave Approval</a></li>
                            <li><a href="/@currentCulture/features/social-media-manager">Social Media Multi-Publishing</a></li>
                            <li><a href="/@currentCulture/features/speaker-sessions">Speaker Management & Agendas</a></li>
                            <li><a href="/@currentCulture/features/staff-rota">Staff Rota & Shift Scheduling</a></li>
                            <li><a href="/@currentCulture/features/store-ecommerce">Store & Merchandise E-Commerce</a></li>
                            <li><a href="/@currentCulture/features/survey-analytics">Survey Builder & Feedback Analytics</a></li>
                            <li><a href="/@currentCulture/features/visitor-gate-management">Visitor Gate & Vehicle Passes</a></li>
                            <li><a href="/@currentCulture/features/whistleblowing-feedback">Whistleblowing & Feedback</a></li>
                        </ul>
                    </div>
                </section>

            </div>
        </div>
    </main>
</div>

<script>
function filterSitemap(query) {
    const q = (query || '').toLowerCase().trim();
    const links = document.querySelectorAll('.oz-sitemap-list li');
    links.forEach(li => {
        const text = li.innerText.toLowerCase();
        if (!q || text.includes(q)) {
            li.style.display = '';
        } else {
            li.style.display = 'none';
        }
    });
}
</script>
