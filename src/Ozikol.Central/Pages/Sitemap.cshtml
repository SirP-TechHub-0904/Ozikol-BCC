                    </div>
                    <div class="oz-sitemap-features-grid">
                        <ul class="oz-sitemap-list">
                            <li><a href="/@currentCulture/features/ai-smart-assist">AI Copilot & Workflow Automation</a></li>
                            <li><a href="/@currentCulture/features/alumni-directory">Alumni Directory</a></li>
                            <li><a href="/@currentCulture/features/appointment-booking">Appointment Booking</a></li>
                            <li><a href="/@currentCulture/features/attendance-tracking">Biometric & Attendance Tracking</a></li>
                            <li><a href="/@currentCulture/features/attendee-management">Badge Printing & Check-In</a></li>
