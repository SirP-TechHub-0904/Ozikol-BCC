@page "/pricing/pay-as-you-go"
@model Ozikol.Central.Pages.Pricing.PayAsYouGoModel
@{
    ViewData["Title"] = "Pay-As-You-Go Pricing - Usage-Based Cloud - Ozikol";
    ViewData["MetaDescription"] = "Pay only for active staff seats, SMS credits, census records, and verification checks with zero monthly minimums.";
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>Pay-As-You-Go Pricing - Usage-Based Cloud</span>
                </div>
                <partial name="_BackToFeaturesLink" />
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="oz-feat-pill">Usage-Based Pricing • Zero Minimums</span>
            </div>
            <h1 class="oz-feat-title">Pay Only for What You Actually Use</h1>
            <p class="oz-feat-lead">No rigid long-term contracts or mandatory seat minimums. Scale dynamically up or down each month based on actual active usage across all 37 capabilities.</p>
            <div class="oz-feat-actions">
                <a href="/get-started" class="btn btn-primary">Start Free Trial</a>
                <a href="/pricing" class="btn btn-secondary--alt">View Subscription Plans</a>
            </div>
        </div>
    </section>

    <!-- Rates Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">Metered Rates</div>
            <h2>Transparent Usage Units</h2>
            <p class="oz-feat-card-desc">Direct pay-per-unit billing with real-time spend caps and alerts.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Staff Shift Seats</h3>
                <p class="oz-feat-card-desc"><strong>&pound;1.50</strong> per active scheduled staff member per month. Only pay for staff who actually work shifts.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">SMS &amp; Mass Broadcasts</h3>
                <p class="oz-feat-card-desc"><strong>&pound;0.025</strong> per delivered SMS notification globally. Email broadcasts and in-app messaging are 100% free.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Digital Verification &amp; Census</h3>
                <p class="oz-feat-card-desc"><strong>&pound;0.05</strong> per cryptographic certificate verification check or digital ID issued. Free unlimited data export.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Experience the Power of Ozikol</h2>
            <p>Deploy custom modules, automate operations, and empower your organization today.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <partial name="_ExploreFeaturesButton" />
            </div>
        </div>
    </section>
</div>
