@page "/pricing/custom"
@model Ozikol.Central.Pages.Pricing.CustomModel
@{
    ViewData["Title"] = "Custom Enterprise Solutions & Quotes - Ozikol";
    ViewData["MetaDescription"] = "Custom enterprise quotes, dedicated cloud infrastructure, custom API limits, and tailored SLAs for large organizations.";
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>Custom Enterprise Solutions & Quotes</span>
                </div>
                <partial name="_BackToFeaturesLink" />
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                </div>
                <span class="oz-feat-pill">Enterprise Tier • Custom Architecture</span>
            </div>
            <h1 class="oz-feat-title">Tailored Enterprise Solutions &amp; Quotes</h1>
            <p class="oz-feat-lead">For governments, healthcare trusts, large municipal councils, and global organizations requiring dedicated cloud hosting, custom REST integrations, and custom SLA guarantees.</p>
            <div class="oz-feat-actions">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Request Custom Proposal</a>
                <a href="/about-us/security" class="btn btn-secondary--alt">Enterprise Security Standards</a>
            </div>
        </div>
    </section>

    <!-- Enterprise Features Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">Enterprise Assurance</div>
            <h2>Built to Comply With Strict Mandates</h2>
            <p class="oz-feat-card-desc">Dedicated engineering, isolated tenancy, and custom master services agreements.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Dedicated Private Cloud Hosting</h3>
                <p class="oz-feat-card-desc">Single-tenant isolated database infrastructure in your preferred geographic cloud region (UK, EU, US, APAC).</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">99.99% Guaranteed SLA</h3>
                <p class="oz-feat-card-desc">24/7/365 priority phone support with dedicated Technical Account Managers (TAM) and 15-minute response guarantees.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Custom Integrations &amp; SSO</h3>
                <p class="oz-feat-card-desc">Seamless synchronization with existing ERP, SAP, Oracle, Active Directory, Okta, and legacy database systems.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Experience the Power of Ozikol</h2>
            <p>Deploy custom modules, automate operations, and empower your organization today.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <partial name="_ExploreFeaturesButton" />
            </div>
        </div>
    </section>
</div>
