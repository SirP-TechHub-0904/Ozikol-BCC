<div class="oz-pricing-page">
    <!-- Hero Section -->
    <section class="oz-pricing-hero">
        <div class="container">
            <div class="oz-pricing-hero-badge">
                <span class="oz-pricing-hero-badge-dot"></span>
                <span>Transparent, Predictable Value</span>
            </div>
            <h1 class="oz-pricing-hero-title">
                Simple, transparent pricing for <span>every organisation</span>
            </h1>
            <p class="oz-pricing-hero-desc">
                Access all 33 modular business, workforce, and community management tools. No per-user penalties, no hidden add-ons, and no lock-in contracts.
            </p>

            <!-- Billing Toggle -->
            <div class="oz-pricing-toggle-wrap">
                <span class="oz-pricing-toggle-label is-active" id="labelMonthly">Monthly</span>
                <button type="button" class="oz-pricing-toggle-btn" id="billingToggle" aria-label="Toggle annual or monthly billing" aria-checked="false" role="switch">
                    <span class="oz-pricing-toggle-thumb"></span>
                </button>
                <span class="oz-pricing-toggle-label" id="labelAnnual">
                    Annual
                    <span class="oz-pricing-save-badge">Save 20%</span>
                </span>
            </div>
        </div>
    </section>

    <!-- Pricing Cards Section -->
    <section class="oz-pricing-cards-section">
        <div class="container">
            <div class="oz-pricing-grid">
                <!-- Tier 1: Starter -->
                <div class="oz-pricing-card">
                    <div class="oz-pricing-card-header">
                        <div class="oz-pricing-card-tag">Starter</div>
                        <h3 class="oz-pricing-card-name">Small Teams & Clubs</h3>
                        <p class="oz-pricing-card-sub">Perfect for growing community groups, local non-profits, and small setups.</p>
                        <div class="oz-pricing-price-wrap">
                            <span class="oz-pricing-currency">&pound;</span>
                            <span class="oz-pricing-amount" data-monthly="49" data-annual="39">49</span>
                            <span class="oz-pricing-period">/ month</span>
                        </div>
                        <div class="oz-pricing-billed-note" data-monthly="Billed monthly" data-annual="Billed &pound;468 annually (Save 20%)">Billed monthly</div>
                    </div>
                    <div class="oz-pricing-card-body">
                        <a href="/get-started" class="oz-pricing-btn oz-pricing-btn--outline">Start 14-Day Free Trial</a>
                        <ul class="oz-pricing-features-list">
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Up to <strong>25 Active Users</strong></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <strong>Core 10 Modules</strong> (Rota, Chat, Invoicing)</li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Web Application & Mobile PWA Access</li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 10 GB Cloud Document Storage</li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Standard Email & Knowledge Base Support</li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> 99.5% Uptime Availability SLA</li>
                        </ul>
                    </div>
