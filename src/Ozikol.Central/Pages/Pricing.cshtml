@page "/pricing"
@model Ozikol.Central.Pages.PricingModel
@{
    ViewData["Title"] = SharedLocalizer["Pricing_Meta_Title"].Value;
    ViewData["MetaDescription"] = SharedLocalizer["Pricing_Meta_Desc"].Value;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    if (currentCulture != "en" && currentCulture != "fr" && currentCulture != "es" && currentCulture != "de")
    {
        currentCulture = "en";
    }
}

<div class="oz-pricing-page">
    <!-- Section 1: Hero Banner & Billing Cycle Toggle -->
    <section class="oz-pricing-hero">
        <div class="container">
            <div class="oz-pricing-hero-badge">
                <span class="oz-pricing-hero-badge-dot"></span>
                <span>@SharedLocalizer["Pricing_Hero_Badge"]</span>
            </div>
            <h1 class="oz-pricing-hero-title">
                @SharedLocalizer["Pricing_Hero_Title"]
            </h1>
            <p class="oz-pricing-hero-desc">
                @SharedLocalizer["Pricing_Hero_Desc"]
            </p>

            <!-- Billing Toggle -->
            <div class="oz-pricing-toggle-wrap">
                <span class="oz-pricing-toggle-label is-active" id="labelMonthly">@SharedLocalizer["Pricing_Toggle_Monthly"]</span>
                <button type="button" class="oz-pricing-toggle-btn" id="billingToggle" aria-label="Toggle annual or monthly billing" aria-checked="false" role="switch">
                    <span class="oz-pricing-toggle-thumb"></span>
                </button>
                <span class="oz-pricing-toggle-label" id="labelAnnual">
                    @SharedLocalizer["Pricing_Toggle_Annual"]
                    <span class="oz-pricing-save-badge">@SharedLocalizer["Pricing_Toggle_Save"]</span>
                </span>
            </div>
        </div>
    </section>

    <!-- Section 2: 4 Tier Pricing Cards -->
    <section class="oz-pricing-cards-section">
        <div class="container">
            <div class="oz-pricing-grid">
                <!-- Tier 1: Starter -->
                <div class="oz-pricing-card">
                    <div class="oz-pricing-card-header">
                        <div class="oz-pricing-card-tag">@SharedLocalizer["Pricing_Tier1_Tag"]</div>
                        <h2 class="oz-pricing-card-name">@SharedLocalizer["Pricing_Tier1_Title"]</h2>
                        <p class="oz-pricing-card-sub">@SharedLocalizer["Pricing_Tier1_Desc"]</p>
                        <div class="oz-pricing-price-wrap">
                            <span class="oz-pricing-currency">@SharedLocalizer["Pricing_Currency"]</span>
                            <span class="oz-pricing-amount" data-monthly="@SharedLocalizer["Pricing_Tier1_Price_Monthly"]" data-annual="@SharedLocalizer["Pricing_Tier1_Price_Annual"]">@SharedLocalizer["Pricing_Tier1_Price_Monthly"]</span>
                            <span class="oz-pricing-period">@SharedLocalizer["Pricing_Period"]</span>
                        </div>
                        <div class="oz-pricing-billed-note" data-monthly="@SharedLocalizer["Pricing_Billed_Monthly"]" data-annual="@SharedLocalizer["Pricing_Billed_Annual_Save"]">@SharedLocalizer["Pricing_Billed_Monthly"]</div>
                    </div>
                    <div class="oz-pricing-card-body">
                        <a href="/@currentCulture/auth/get-started?plan=starter" class="oz-pricing-btn oz-pricing-btn--outline">@SharedLocalizer["Pricing_Tier1_Btn"]</a>
                        <ul class="oz-pricing-features-list">
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Up to <strong>25 Active Users</strong></span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span><strong>Core Suites</strong> (Messenger, Rota, Forms)</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Responsive Web Application &amp; Mobile PWA</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>15 GB Sovereign Cloud Document Storage</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Standard Community &amp; Knowledge Support</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>99.5% Uptime Availability SLA</span></li>
                        </ul>
                    </div>
                </div>

                <!-- Tier 2: Professional (Popular) -->
                <div class="oz-pricing-card is-popular">
                    <div class="oz-pricing-popular-badge">@SharedLocalizer["Pricing_Tier2_Badge"]</div>
                    <div class="oz-pricing-card-header">
                        <div class="oz-pricing-card-tag">@SharedLocalizer["Pricing_Tier2_Tag"]</div>
                        <h2 class="oz-pricing-card-name">@SharedLocalizer["Pricing_Tier2_Title"]</h2>
                        <p class="oz-pricing-card-sub">@SharedLocalizer["Pricing_Tier2_Desc"]</p>
                        <div class="oz-pricing-price-wrap">
                            <span class="oz-pricing-currency">@SharedLocalizer["Pricing_Currency"]</span>
                            <span class="oz-pricing-amount" data-monthly="@SharedLocalizer["Pricing_Tier2_Price_Monthly"]" data-annual="@SharedLocalizer["Pricing_Tier2_Price_Annual"]">@SharedLocalizer["Pricing_Tier2_Price_Monthly"]</span>
                            <span class="oz-pricing-period">@SharedLocalizer["Pricing_Period"]</span>
                        </div>
                        <div class="oz-pricing-billed-note" data-monthly="@SharedLocalizer["Pricing_Billed_Monthly"]" data-annual="@SharedLocalizer["Pricing_Billed_Annual_Save"]">@SharedLocalizer["Pricing_Billed_Monthly"]</div>
                    </div>
                    <div class="oz-pricing-card-body">
                        <a href="/@currentCulture/auth/get-started?plan=pro" class="oz-pricing-btn oz-pricing-btn--primary">@SharedLocalizer["Pricing_Tier2_Btn"]</a>
                        <ul class="oz-pricing-features-list">
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Up to <strong>150 Active Users</strong></span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span><strong>All 37 Capabilities in 9 Suites</strong></span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Private AI Gateway (Bring Your Own Key)</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Android &amp; iOS Mobile Applications</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Verifiable Cryptographic QR Badges &amp; Passes</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Field Surveyor Mobile Census &amp; GPS Sync</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Priority 24/7 Support &amp; 99.9% Uptime SLA</span></li>
                        </ul>
                    </div>
                </div>

                <!-- Tier 3: Enterprise -->
                <div class="oz-pricing-card">
                    <div class="oz-pricing-card-header">
                        <div class="oz-pricing-card-tag">@SharedLocalizer["Pricing_Tier3_Tag"]</div>
                        <h2 class="oz-pricing-card-name">@SharedLocalizer["Pricing_Tier3_Title"]</h2>
                        <p class="oz-pricing-card-sub">@SharedLocalizer["Pricing_Tier3_Desc"]</p>
                        <div class="oz-pricing-price-wrap">
                            <span class="oz-pricing-currency">@SharedLocalizer["Pricing_Currency"]</span>
                            <span class="oz-pricing-amount" data-monthly="@SharedLocalizer["Pricing_Tier3_Price_Monthly"]" data-annual="@SharedLocalizer["Pricing_Tier3_Price_Annual"]">@SharedLocalizer["Pricing_Tier3_Price_Monthly"]</span>
                            <span class="oz-pricing-period">@SharedLocalizer["Pricing_Period"]</span>
                        </div>
                        <div class="oz-pricing-billed-note" data-monthly="@SharedLocalizer["Pricing_Billed_Monthly"]" data-annual="@SharedLocalizer["Pricing_Billed_Annual_Save"]">@SharedLocalizer["Pricing_Billed_Monthly"]</div>
                    </div>
                    <div class="oz-pricing-card-body">
                        <a href="/@currentCulture/auth/get-started?plan=enterprise" class="oz-pricing-btn oz-pricing-btn--outline">@SharedLocalizer["Pricing_Tier3_Btn"]</a>
                        <ul class="oz-pricing-features-list">
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span><strong>Unlimited Active Users</strong> &amp; Multi-Branch</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Dedicated Tenant Database Schema Isolation</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Fine-Grained Role-Based Access Control (RBAC)</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Audit Vault &amp; Anonymous Whistleblowing Hub</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Automated Financial Ledger Bi-Directional Sync</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Dedicated Account Manager &amp; Migration Specialist</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>99.99% High-Availability Enterprise SLA</span></li>
                        </ul>
                    </div>
                </div>

                <!-- Tier 4: Sovereign Dedicated -->
                <div class="oz-pricing-card">
                    <div class="oz-pricing-card-header">
                        <div class="oz-pricing-card-tag">@SharedLocalizer["Pricing_Tier4_Tag"]</div>
                        <h2 class="oz-pricing-card-name">@SharedLocalizer["Pricing_Tier4_Title"]</h2>
                        <p class="oz-pricing-card-sub">@SharedLocalizer["Pricing_Tier4_Desc"]</p>
                        <div class="oz-pricing-price-wrap">
                            <span class="oz-pricing-amount">@SharedLocalizer["Pricing_Tier4_Price"]</span>
                        </div>
                        <div class="oz-pricing-billed-note">@SharedLocalizer["Pricing_Tier4_Period"]</div>
                    </div>
                    <div class="oz-pricing-card-body">
                        <a href="/@currentCulture/customer/contact-sales" class="oz-pricing-btn oz-pricing-btn--outline">@SharedLocalizer["Pricing_Tier4_Btn"]</a>
                        <ul class="oz-pricing-features-list">
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Private Cloud or On-Premises VPC Deployment</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Zero Model Retention Private AI Sovereignty</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Custom SSO / SAML / Active Directory &amp; LDAP</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Tailored Data Retention &amp; Regional Jurisdiction</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>Penetration Test Reports &amp; Custom Legal Rider</span></li>
                            <li><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>24/7 Phone Incident Line &amp; 15-Minute Response SLA</span></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

