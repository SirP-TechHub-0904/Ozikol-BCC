@page "/pricing"
@model Ozikol.Central.Pages.PricingModel
@{
    ViewData["Title"] = SharedLocalizer["Pricing_Meta_Title"].Value;
    ViewData["MetaDescription"] = SharedLocalizer["Pricing_Meta_Desc"].Value;
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    if (currentCulture != "en" && currentCulture != "fr" && currentCulture != "es" && currentCulture != "de")
    {
        currentCulture = "en";
    }
}

<div class="oz-pricing-page">
    <!-- Section 1: Hero Banner & Currency Selector -->
    <section class="oz-pricing-hero">
        <div class="container">
            <div class="oz-pricing-hero-badge">
                <span class="oz-pricing-hero-badge-dot"></span>
                <span>@SharedLocalizer["Pricing_Hero_Badge"]</span>
            </div>
            <h1 class="oz-pricing-hero-title">
                @SharedLocalizer["Pricing_Hero_Title"]
            </h1>
            <p class="oz-pricing-hero-desc">
                @SharedLocalizer["Pricing_Hero_Desc"]
            </p>

            <!-- Currency Selector Pills -->
            <div class="oz-currency-selector-wrap" role="group" aria-label="@SharedLocalizer["Pricing_Currency_Label"]">
                @foreach (var curr in Model.SupportedCurrencies)
                {
                    var isActive = curr.Code.Equals(Model.SelectedCurrency, StringComparison.OrdinalIgnoreCase);
                    <a href="?currency=@curr.Code" 
                       class="oz-currency-pill @(isActive ? "is-active" : "")" 
                       data-currency="@curr.Code"
                       aria-pressed="@(isActive ? "true" : "false")">
                        @curr.PillLabel
                    </a>
                }
            </div>
        </div>
    </section>

    <!-- Section 2: 40k All-Inclusive Spotlight Card -->
    <section class="oz-single-card-section">
        <div class="container">
            <div class="oz-single-price-card">
                <!-- Header -->
                <div class="oz-single-card-header">
                    <div class="oz-single-card-badge">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Badge"]</span>
                    </div>
                    <h2 class="oz-single-card-title">@SharedLocalizer["Pricing_Card_Title"]</h2>
                    <p class="oz-single-card-desc">@SharedLocalizer["Pricing_Card_Desc"]</p>
                </div>

                <!-- Price Block -->
                <div class="oz-single-price-wrap">
                    <div class="oz-single-price-row">
                        <span class="oz-single-price-figure" id="annualPriceDisplay">@Model.FormattedAnnualPrice</span>
                        <span class="oz-single-price-period">@SharedLocalizer["Pricing_Per_Year"]</span>
                    </div>
                    <div class="oz-single-price-subnote">
                        @SharedLocalizer["Pricing_Monthly_Equiv"] <strong id="monthlyEquivDisplay">@Model.FormattedMonthlyEquivalent</strong> @SharedLocalizer["Pricing_Monthly_Suffix"]
                    </div>
                </div>

                <!-- Domain Callout Box -->
                <div class="oz-domain-callout-box">
                    <div class="oz-domain-callout-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    </div>
                    <div class="oz-domain-callout-text">
                        <h4>@SharedLocalizer["Pricing_Domain_Callout_Title"]</h4>
                        <p>@SharedLocalizer["Pricing_Domain_Callout_Desc"]</p>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="oz-single-cta-group">
                    <a href="/@currentCulture/register" class="oz-single-btn-primary">
                        <span>@SharedLocalizer["Pricing_Btn_Trial"]</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>

                <!-- Trust Points -->
                <div class="oz-single-trust-row">
                    <div class="oz-single-trust-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Trust_Trial"]</span>
                    </div>
                    <div class="oz-single-trust-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Trust_NoCard"]</span>
                    </div>
                    <div class="oz-single-trust-item">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Trust_Setup"]</span>
                    </div>
                </div>

                <!-- All 9 Features Grid Inside Card -->
                <div class="oz-single-features-grid">
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat1"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat2"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat3"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat4"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat5"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat6"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat7"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat8"]</span>
                    </div>
                    <div class="oz-single-feat-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        <span>@SharedLocalizer["Pricing_Card_Feat9"]</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 3: Bring Your Own Domain 3-Step Guide -->
    <section class="oz-domain-section">
        <div class="container">
            <div class="oz-pricing-hero-badge">
                <span class="oz-pricing-hero-badge-dot"></span>
                <span>@SharedLocalizer["Pricing_Domain_Section_Badge"]</span>
            </div>
            <h2 class="oz-pricing-hero-title">@SharedLocalizer["Pricing_Domain_Section_Title"]</h2>
            <p class="oz-pricing-hero-desc">@SharedLocalizer["Pricing_Domain_Section_Desc"]</p>

            <div class="oz-domain-steps-grid">
                <!-- Step 1 -->
                <div class="oz-domain-step-card">
                    <div class="oz-domain-step-num">@SharedLocalizer["Pricing_Domain_Step1_Num"]</div>
                    <h3 class="oz-domain-step-title">@SharedLocalizer["Pricing_Domain_Step1_Title"]</h3>
                    <p class="oz-domain-step-desc">@SharedLocalizer["Pricing_Domain_Step1_Desc"]</p>
                </div>

                <!-- Step 2 -->
                <div class="oz-domain-step-card">
                    <div class="oz-domain-step-num">@SharedLocalizer["Pricing_Domain_Step2_Num"]</div>
                    <h3 class="oz-domain-step-title">@SharedLocalizer["Pricing_Domain_Step2_Title"]</h3>
                    <p class="oz-domain-step-desc">@SharedLocalizer["Pricing_Domain_Step2_Desc"]</p>
                </div>

                <!-- Step 3 -->
                <div class="oz-domain-step-card">
                    <div class="oz-domain-step-num">@SharedLocalizer["Pricing_Domain_Step3_Num"]</div>
                    <h3 class="oz-domain-step-title">@SharedLocalizer["Pricing_Domain_Step3_Title"]</h3>
                    <p class="oz-domain-step-desc">@SharedLocalizer["Pricing_Domain_Step3_Desc"]</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 4: Why ₦40,000 / Year? (Radical Value & Transparency) -->
    <section class="oz-why-section">
        <div class="container">
            <div class="oz-pricing-hero-badge">
                <span class="oz-pricing-hero-badge-dot"></span>
                <span>@SharedLocalizer["Pricing_Why_Badge"]</span>
            </div>
            <h2 class="oz-pricing-hero-title">@SharedLocalizer["Pricing_Why_Title"]</h2>
            <p class="oz-pricing-hero-desc">@SharedLocalizer["Pricing_Why_Desc"]</p>

            <div class="oz-why-grid">
                <div class="oz-why-card">
                    <div class="oz-why-icon-wrap" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                    </div>
                    <h3 class="oz-why-card-title">@SharedLocalizer["Pricing_Why1_Title"]</h3>
                    <p class="oz-why-card-desc">@SharedLocalizer["Pricing_Why1_Desc"]</p>
                </div>

                <div class="oz-why-card">
                    <div class="oz-why-icon-wrap" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3 class="oz-why-card-title">@SharedLocalizer["Pricing_Why2_Title"]</h3>
                    <p class="oz-why-card-desc">@SharedLocalizer["Pricing_Why2_Desc"]</p>
                </div>

                <div class="oz-why-card">
                    <div class="oz-why-icon-wrap" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>
                    <h3 class="oz-why-card-title">@SharedLocalizer["Pricing_Why3_Title"]</h3>
                    <p class="oz-why-card-desc">@SharedLocalizer["Pricing_Why3_Desc"]</p>
                </div>

                <div class="oz-why-card">
                    <div class="oz-why-icon-wrap" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
                        </svg>
                    </div>
                    <h3 class="oz-why-card-title">@SharedLocalizer["Pricing_Why4_Title"]</h3>
                    <p class="oz-why-card-desc">@SharedLocalizer["Pricing_Why4_Desc"]</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 5: What 40k Gets You (9 Suites Grid) -->
    <section class="oz-suites-section">
        <div class="container">
            <div class="oz-pricing-hero-badge">
                <span class="oz-pricing-hero-badge-dot"></span>
                <span>@SharedLocalizer["Pricing_Suites_Badge"]</span>
            </div>
            <h2 class="oz-pricing-hero-title">@SharedLocalizer["Pricing_Suites_Title"]</h2>
            <p class="oz-pricing-hero-desc">@SharedLocalizer["Pricing_Suites_Desc"]</p>

            <div class="oz-suites-grid">
                <!-- Suite 1 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="9" cy="21" r="1"></circle>
                            <circle cx="20" cy="21" r="1"></circle>
                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>1. Core Point of Sale (POS)</h4>
                        <p>Fast retail checkout, offline transactions, barcode printing, and cash drawer balancing.</p>
                    </div>
                </div>

                <!-- Suite 2 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>2. Omnichannel Inventory</h4>
                        <p>Real-time multi-branch stock levels, low-inventory alerts, and central catalog control.</p>
                    </div>
                </div>

                <!-- Suite 3 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                            <line x1="1" y1="10" x2="23" y2="10"></line>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>3. Payments & Settlements</h4>
                        <p>Integrated card terminals, bank transfers, mobile money, and automated reconciliations.</p>
                    </div>
                </div>

                <!-- Suite 4 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>4. CRM & VIP Customer Loyalty</h4>
                        <p>Customer profiles, purchase histories, loyalty points, and digital membership cards.</p>
                    </div>
                </div>

                <!-- Suite 5 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>5. Marketing Automation</h4>
                        <p>Targeted SMS and email campaigns, customer win-backs, and automated promotions.</p>
                    </div>
                </div>

                <!-- Suite 6 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>6. AI & Demand Forecasting</h4>
                        <p>Predictive inventory replenishment, smart pricing recommendations, and churn analytics.</p>
                    </div>
                </div>

                <!-- Suite 7 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="1" y="3" width="15" height="13"></rect>
                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>7. Supply Chain & Fulfillment</h4>
                        <p>Multi-warehouse routing, courier tracking, supplier purchase orders, and stock receiving.</p>
                    </div>
                </div>

                <!-- Suite 8 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 18 22 12 16 6"></polyline>
                            <polyline points="8 6 2 12 8 18"></polyline>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>8. Developer APIs & Webhooks</h4>
                        <p>REST & GraphQL endpoints, event webhooks, sandbox environment, and ERP integrations.</p>
                    </div>
                </div>

                <!-- Suite 9 -->
                <div class="oz-suite-card">
                    <div class="oz-suite-card-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <div class="oz-suite-card-body">
                        <h4>9. Security & Cloud Backups</h4>
                        <p>Isolated tenant architecture, role-based permissions, automated daily backups, and SSL.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 6: FAQ Accordion -->
    <section class="oz-faq-section">
        <div class="container">
            <div class="oz-pricing-hero-badge">
                <span class="oz-pricing-hero-badge-dot"></span>
                <span>@SharedLocalizer["Pricing_Faq_Badge"]</span>
            </div>
            <h2 class="oz-pricing-hero-title">@SharedLocalizer["Pricing_Faq_Title"]</h2>
            <p class="oz-pricing-hero-desc">@SharedLocalizer["Pricing_Faq_Desc"]</p>

            <div class="oz-faq-grid">
                <!-- FAQ 1 -->
                <div class="oz-faq-item is-open">
                    <button type="button" class="oz-faq-question" aria-expanded="true">
                        <span>@SharedLocalizer["Pricing_Faq1_Q"]</span>
                        <svg class="oz-faq-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <div class="oz-faq-answer">
                        <p>@SharedLocalizer["Pricing_Faq1_A"]</p>
                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="oz-faq-item">
                    <button type="button" class="oz-faq-question" aria-expanded="false">
                        <span>@SharedLocalizer["Pricing_Faq2_Q"]</span>
                        <svg class="oz-faq-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <div class="oz-faq-answer">
                        <p>@SharedLocalizer["Pricing_Faq2_A"]</p>
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="oz-faq-item">
                    <button type="button" class="oz-faq-question" aria-expanded="false">
                        <span>@SharedLocalizer["Pricing_Faq3_Q"]</span>
                        <svg class="oz-faq-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </button>
                    <div class="oz-faq-answer">
                        <p>@SharedLocalizer["Pricing_Faq3_A"]</p>
                    </div>
