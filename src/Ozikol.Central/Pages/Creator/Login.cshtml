@page "/creator/login"
@model Ozikol.Central.Pages.Creator.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Creator Studio Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Creator Sign In — Ozikol Studio</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/creator.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="/images/oz-logo-red.png" />
    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: radial-gradient(circle at top, #1e1333 0%, #0b0f19 70%);
            position: relative;
            overflow: hidden;
        }

        .auth-container::before {
            content: "";
            position: absolute;
            top: -20%;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            background: rgba(17, 24, 39, 0.85);
            border: 1px solid rgba(139, 92, 246, 0.25);
            backdrop-filter: blur(24px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            position: relative;
            z-index: 1;
        }

        .auth-badge {
            display: inline-block;
            background: rgba(139, 92, 246, 0.15);
            color: #8b5cf6;
            border: 1px solid rgba(139, 92, 246, 0.3);
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 12px;
        }
    </style>
</head>
<body class="admin-body">
    <div class="auth-container">
        <div class="auth-card">
            <div style="text-align: center;">
                <a href="/" style="display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-bottom: 20px;">
                    <img src="/images/oz-logo-red.png" alt="Ozikol" style="height: 38px;" />
                    <span style="font-size: 20px; font-weight: 700; color: #ffffff;">Creator Studio</span>
                </a>
                <div><span class="auth-badge">Template Monetization</span></div>
                <h1 style="font-size: 22px; font-weight: 700; color: #ffffff; margin: 0 0 6px 0;">Creator Sign In</h1>
                <p style="font-size: 13.5px; color: var(--admin-text-muted); margin: 0 0 28px 0;">Publish UI templates, track sales & manage your catalog</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="admin-alert admin-alert-danger" role="alert">
                    <span>⚠ @Model.ErrorMessage</span>
                </div>
            }

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Creator Email <span class="required">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="creator@studio.com" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Password <span class="required">*</span></label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-group" style="margin-top: 8px; margin-bottom: 20px;">
                    <label class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <span style="font-size: 13px; color: var(--admin-text-muted);">Keep me signed in</span>
                    </label>
                </div>

                <button type="submit" class="btn-admin btn-admin-primary" style="width: 100%; padding: 12px; font-size: 14px;">
                    Open Studio →
                </button>
            </form>

            <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.08); text-align: center; font-size: 13px;">
                <span style="color: var(--admin-text-muted);">Want to build and sell templates?</span>
                <a href="/creators" style="color: #8b5cf6; text-decoration: none; font-weight: 600; margin-left: 4px;">Join as Creator</a>
                <div style="margin-top: 12px;">
                    <a href="/" style="color: var(--admin-text-dim); text-decoration: none; font-size: 12px;">← Back to Ozikol Home</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
