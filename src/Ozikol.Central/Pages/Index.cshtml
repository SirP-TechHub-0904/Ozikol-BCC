@page ""
@model Ozikol.Central.Pages.IndexModel
@{
    ViewData["Title"] = "Ozikol | Unified Business Cloud Platform";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
    if (currentCulture != "en" && currentCulture != "fr" && currentCulture != "es" && currentCulture != "de")
    {
        currentCulture = "en";
    }
}

<div>
    <!-- Section 1: Hero Banner Section -->
    <section class="oz-hero-section">
        <div class="oz-hero-container">
            <div class="oz-hero-content">
                <div class="oz-hero-badge">
                    <span class="oz-hero-badge__dot"></span>
                    <span class="oz-hero-badge__text">@SharedLocalizer["Home_Hero_Badge"]</span>
                </div>

                <h1 class="oz-hero-title">
                    @SharedLocalizer["Home_Hero_Title"]
                </h1>

                <p class="oz-hero-desc">
                    @SharedLocalizer["Home_Hero_Desc"]
                </p>

                <div class="oz-hero-ctas">
                    <a href="#solutions" class="oz-hero-btn-outline">@SharedLocalizer["Home_Hero_BtnSolutions"]</a>

                    <a href="/@currentCulture/about-us" class="oz-hero-btn-white">
                        <span>@SharedLocalizer["Home_Hero_BtnStory"]</span>
                        <span class="oz-hero-btn-arrow">
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                                <path d="M1.5 5H8.5M8.5 5L5 1.5M8.5 5L5 8.5" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </a>
                </div>
            </div>

            <!-- In-Div Image: Hidden on Desktop, Shown on Mobile -->
            <div class="oz-hero-mobile-image-wrap" aria-hidden="true">
                <img src="/images/hero-banner.jpg"
                     alt="Ozikol Cloud Workspace"
                     class="oz-hero-mobile-img" />
                <div class="oz-hero-mobile-gradient"></div>
            </div>
        </div>
    </section>

    <!-- Section 2: Floating FastNav Solution Finder ("The Little Form") -->
    <section class="oz-fastnav-wrapper" id="solutions">
        <div class="oz-fastnav-card">
            <!-- Sector Field -->
            <div class="oz-fastnav-field" id="ozSectorField">
                <span class="oz-fastnav-label">@SharedLocalizer["FastNav_WorkIn"]</span>
                <div class="oz-fastnav-pill" id="ozSectorPill" tabindex="0" role="button" aria-haspopup="listbox" aria-expanded="false">
                    <span class="oz-fastnav-display is-placeholder" id="ozSectorDisplay">@SharedLocalizer["FastNav_ChooseSector"]</span>
                    <span class="oz-fastnav-chevron" aria-hidden="true">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                            <path d="M2 3.5L5 6.5L8 3.5" stroke="#e5173f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </div>
                <div class="oz-fastnav-menu" id="ozSectorMenu" role="listbox"></div>
                <select id="ozFastSector" class="oz-fastnav-native" aria-hidden="true">
                    <option value="">@SharedLocalizer["FastNav_ChooseSector"]</option>
                    <option value="not-for-profit" data-options='[{"title":"Grant Ledger &amp; Funding","url":"/@currentCulture/features/grant-ledger"},{"title":"Attendee &amp; Volunteer Management","url":"/@currentCulture/features/attendee-management"},{"title":"Community Messenger","url":"/@currentCulture/features/community-messenger"},{"title":"Custom Form Builder","url":"/@currentCulture/features/form-builder"},{"title":"Invoicing &amp; Dues Billing","url":"/@currentCulture/features/invoicing-dues"},{"title":"Document Vault","url":"/@currentCulture/features/document-management"}]'>Charities &amp; Not-for-Profit</option>
                    <option value="construction" data-options='[{"title":"Project &amp; Task Tracking","url":"/@currentCulture/features/project-task-tracking"},{"title":"Fleet &amp; Equipment Lifecycle","url":"/@currentCulture/features/equipment-fleet"},{"title":"Company Asset Management","url":"/@currentCulture/features/company-assets"},{"title":"Staff Rota &amp; Scheduling","url":"/@currentCulture/features/staff-rota"},{"title":"Invoicing &amp; Dues","url":"/@currentCulture/features/invoicing-dues"},{"title":"Anonymous Whistleblowing","url":"/@currentCulture/features/whistleblowing-feedback"}]'>Construction &amp; Engineering</option>
                    <option value="education" data-options='[{"title":"Learning Management (LMS)","url":"/@currentCulture/features/learning-management"},{"title":"Attendance &amp; Time Tracking","url":"/@currentCulture/features/attendance-tracking"},{"title":"Certificate Verification","url":"/@currentCulture/features/certificate-verification"},{"title":"Alumni Directory","url":"/@currentCulture/features/alumni-directory"},{"title":"Elections &amp; E-Voting","url":"/@currentCulture/features/elections-evoting"},{"title":"Mass Communication","url":"/@currentCulture/features/mass-communication"}]'>Education &amp; Academies</option>
                    <option value="event-management" data-options='[{"title":"Event Ticketing &amp; Check-In","url":"/@currentCulture/features/event-ticketing"},{"title":"Attendee &amp; Guest Management","url":"/@currentCulture/features/attendee-management"},{"title":"Speaker &amp; Session Management","url":"/@currentCulture/features/speaker-sessions"},{"title":"Visitor Gate Kiosk","url":"/@currentCulture/features/visitor-gate-management"},{"title":"Store &amp; E-Commerce","url":"/@currentCulture/features/store-ecommerce"}]'>Event Management &amp; Venues</option>
                    <option value="finance-accounting" data-options='[{"title":"Invoicing &amp; Dues Billing","url":"/@currentCulture/features/invoicing-dues"},{"title":"Grant Ledger &amp; Funding","url":"/@currentCulture/features/grant-ledger"},{"title":"Interval KPI Reporting","url":"/@currentCulture/features/interval-reporting"},{"title":"Company Assets","url":"/@currentCulture/features/company-assets"},{"title":"Proposal Pipeline","url":"/@currentCulture/features/proposal-pipeline"}]'>Finance &amp; Professional Services</option>
                    <option value="health-social-care" data-options='[{"title":"Shift Swaps &amp; Leave Approvals","url":"/@currentCulture/features/shift-swaps-leave"},{"title":"Staff Rota &amp; Scheduling","url":"/@currentCulture/features/staff-rota"},{"title":"Appointment Booking","url":"/@currentCulture/features/appointment-booking"},{"title":"Live Chat Support","url":"/@currentCulture/features/live-chat"},{"title":"Whistleblowing &amp; Safeguarding","url":"/@currentCulture/features/whistleblowing-feedback"}]'>Health &amp; Social Care</option>
                    <option value="hospitality" data-options='[{"title":"Staff Rota &amp; Shifts","url":"/@currentCulture/features/staff-rota"},{"title":"Shift Swaps &amp; Availability","url":"/@currentCulture/features/shift-swaps-leave"},{"title":"Appointment Booking","url":"/@currentCulture/features/appointment-booking"},{"title":"Store &amp; E-Commerce","url":"/@currentCulture/features/store-ecommerce"},{"title":"Visitor Gate Management","url":"/@currentCulture/features/visitor-gate-management"}]'>Hospitality &amp; Leisure</option>
                    <option value="hr-workforce" data-options='[{"title":"Recruitment &amp; ATS Hiring","url":"/@currentCulture/features/recruitment-hiring"},{"title":"Staff Rota &amp; Scheduling","url":"/@currentCulture/features/staff-rota"},{"title":"Shift Swaps &amp; Leave","url":"/@currentCulture/features/shift-swaps-leave"},{"title":"Geofenced Attendance","url":"/@currentCulture/features/attendance-tracking"},{"title":"Survey Analytics","url":"/@currentCulture/features/survey-analytics"}]'>HR &amp; People Operations</option>
                    <option value="legal-governance" data-options='[{"title":"Committees &amp; Sub-Groups","url":"/@currentCulture/features/committees"},{"title":"Cryptographic E-Voting","url":"/@currentCulture/features/elections-evoting"},{"title":"Document Policy Vault","url":"/@currentCulture/features/document-management"},{"title":"Whistleblowing &amp; Feedback","url":"/@currentCulture/features/whistleblowing-feedback"}]'>Legal &amp; Governance</option>
                    <option value="public-sector" data-options='[{"title":"Community Census &amp; Household","url":"/@currentCulture/features/community-census"},{"title":"Field Enumeration Surveyor","url":"/@currentCulture/features/field-surveyor"},{"title":"Resident Digital ID Cards","url":"/@currentCulture/features/resident-id-cards"},{"title":"Demographic Analytics","url":"/@currentCulture/features/demographic-analytics"},{"title":"Mass Communication","url":"/@currentCulture/features/mass-communication"}]'>Public Sector &amp; Civic Communities</option>
                </select>
            </div>

            <!-- Product / Solution Field -->
            <div class="oz-fastnav-field" id="ozProductField">
                <span class="oz-fastnav-label">@SharedLocalizer["FastNav_Need"]</span>
                <div class="oz-fastnav-pill" id="ozProductPill" tabindex="0" role="button" aria-haspopup="listbox" aria-expanded="false">
                    <span class="oz-fastnav-display is-placeholder" id="ozProductDisplay">@SharedLocalizer["FastNav_ChooseSolution"]</span>
                    <span class="oz-fastnav-chevron" aria-hidden="true">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                            <path d="M2 3.5L5 6.5L8 3.5" stroke="#e5173f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </div>
                <div class="oz-fastnav-menu" id="ozProductMenu" role="listbox"></div>
                <select id="ozFastProduct" class="oz-fastnav-native" aria-hidden="true">
                    <option value="">@SharedLocalizer["FastNav_ChooseSolution"]</option>
                </select>
            </div>

            <!-- Action Button -->
            <a id="ozFastBtn" href="/@currentCulture/features" class="oz-fastnav-btn">
                <span>@SharedLocalizer["FastNav_GetStarted"]</span>
                <span class="oz-fastnav-btn-arrow">
                    <svg width="9" height="9" viewBox="0 0 9 9" fill="none">
                        <path d="M1.5 4.5H7.5M7.5 4.5L4.5 1.5M7.5 4.5L4.5 7.5" stroke="#e5173f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </a>
        </div>
    </section>

    <!-- Section 3: The 9-Suite Architecture Grid -->
    <section class="oz-home-section">
        <div class="container">
            <div class="oz-section-header">
                <span class="oz-badge">@SharedLocalizer["Home_Suites_Badge"]</span>
                <h2 class="oz-section-title">@SharedLocalizer["Home_Suites_Title"]</h2>
                <p class="oz-section-desc">@SharedLocalizer["Home_Suites_Desc"]</p>
            </div>

            <div class="oz-suites-grid">
                <!-- Suite 1 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_People_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_People_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                </a>

                <!-- Suite 2 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Workforce_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Workforce_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
