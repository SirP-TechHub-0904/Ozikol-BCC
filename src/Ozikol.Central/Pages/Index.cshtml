                <!-- Suite 3 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Reports_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Reports_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                </a>

                <!-- Suite 4 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Events_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Events_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                </a>

                <!-- Suite 5 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Finance_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Finance_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                </a>

                <!-- Suite 6 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Operations_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Operations_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                </a>

                <!-- Suite 7 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Communication_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Communication_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                </a>

                <!-- Suite 8 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Compliance_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Compliance_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </span>
                </a>

                <!-- Suite 9 -->
                <a href="/@currentCulture/features" class="oz-suite-card">
                    <div class="oz-suite-icon-wrap">
                        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <h3 class="oz-suite-card-title">@SharedLocalizer["Suite_Demographics_Nav"]</h3>
                    <p class="oz-suite-card-desc">@SharedLocalizer["Suite_Demographics_Desc"]</p>
                    <span class="oz-suite-card-link">
                        <span>Explore suite</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
