    <!-- Custom Padded Dropdown Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var sectorPill = document.getElementById('ozSectorPill');
            var sectorMenu = document.getElementById('ozSectorMenu');
            var sectorDisplay = document.getElementById('ozSectorDisplay');
            var sectorSelect = document.getElementById('ozFastSector');

            var productPill = document.getElementById('ozProductPill');
            var productMenu = document.getElementById('ozProductMenu');
            var productDisplay = document.getElementById('ozProductDisplay');
            var productSelect = document.getElementById('ozFastProduct');

            var startBtn = document.getElementById('ozFastBtn');

            if (!sectorPill || !sectorMenu || !productPill || !productMenu) return;

            // Populate Sector Custom Menu Options from Native Select
            Array.from(sectorSelect.options).forEach(function (opt, idx) {
                if (idx === 0) return; // Skip placeholder
                var item = document.createElement('div');
                item.className = 'oz-fastnav-option';
                item.textContent = opt.textContent;
                item.setAttribute('role', 'option');
                item.addEventListener('click', function (e) {
                    e.stopPropagation();
                    selectSector(opt.value, opt.textContent, opt.getAttribute('data-options'));
                });
                sectorMenu.appendChild(item);
            });

            function closeAllMenus() {
                sectorMenu.classList.remove('is-open');
                sectorPill.classList.remove('is-active');
                sectorPill.setAttribute('aria-expanded', 'false');

                productMenu.classList.remove('is-open');
                productPill.classList.remove('is-active');
                productPill.setAttribute('aria-expanded', 'false');
            }

            sectorPill.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = sectorMenu.classList.contains('is-open');
                closeAllMenus();
                if (!isOpen) {
                    sectorMenu.classList.add('is-open');
                    sectorPill.classList.add('is-active');
                    sectorPill.setAttribute('aria-expanded', 'true');
                }
            });

            productPill.addEventListener('click', function (e) {
                e.stopPropagation();
                var isOpen = productMenu.classList.contains('is-open');
                closeAllMenus();
                if (!isOpen) {
                    productMenu.classList.add('is-open');
                    productPill.classList.add('is-active');
                    productPill.setAttribute('aria-expanded', 'true');
                }
            });

            document.addEventListener('click', function () {
                closeAllMenus();
            });

            function selectSector(val, text, rawOptions) {
                sectorSelect.value = val;
                sectorDisplay.textContent = text;
                sectorDisplay.classList.remove('is-placeholder');

                // Mark selected in sector menu
                Array.from(sectorMenu.children).forEach(function (child) {
                    child.classList.toggle('is-selected', child.textContent === text);
                });

                closeAllMenus();

                // Clear and rebuild product menu
                productMenu.innerHTML = '';
                productSelect.innerHTML = '<option value="">Choose solution</option>';
                productDisplay.textContent = 'Choose solution';
                productDisplay.classList.add('is-placeholder');

                if (rawOptions) {
                    try {
                        var items = JSON.parse(rawOptions);
                        items.forEach(function (sol, sIdx) {
                            // Native option
                            var nOpt = document.createElement('option');
                            nOpt.value = sol.url;
                            nOpt.textContent = sol.title;
                            productSelect.appendChild(nOpt);

                            // Custom option with generous padding
                            var cOpt = document.createElement('div');
                            cOpt.className = 'oz-fastnav-option';
                            cOpt.textContent = sol.title;
                            cOpt.setAttribute('role', 'option');
                            cOpt.addEventListener('click', function (e) {
                                e.stopPropagation();
                                selectProduct(sol.url, sol.title);
                            });
                            productMenu.appendChild(cOpt);

                            // Auto-select first item
                            if (sIdx === 0) {
                                selectProduct(sol.url, sol.title);
                            }
                        });
                    } catch (err) {
                        console.error('Error parsing solutions', err);
                    }
                }
            }

            function selectProduct(url, title) {
                productSelect.value = url;
                productDisplay.textContent = title;
                productDisplay.classList.remove('is-placeholder');

                Array.from(productMenu.children).forEach(function (child) {
                    child.classList.toggle('is-selected', child.textContent === title);
                });

                startBtn.setAttribute('href', url);
                closeAllMenus();
            }

            startBtn.addEventListener('click', function (e) {
                if (!sectorSelect.value) {
                    e.preventDefault();
                    sectorPill.click();
                }
            });
        });
    </script>
