    <!-- Section 4: Core Capabilities Modern Interactive Tabs -->
    <section class="oz-home-section">
        <div class="container">
            <div class="oz-section-header">
                <span class="oz-badge">@SharedLocalizer["Home_Tabs_Badge"]</span>
                <h2 class="oz-section-title">@SharedLocalizer["Home_Tabs_Title"]</h2>
                <p class="oz-section-desc">@SharedLocalizer["Home_Tabs_Desc"]</p>
            </div>

            <!-- Tab Buttons -->
            <div class="oz-tabs-nav" role="tablist">
                <button type="button" class="oz-tab-btn active" data-tab="tab-workspace" role="tab" aria-selected="true">1. Workspace &amp; Directory</button>
                <button type="button" class="oz-tab-btn" data-tab="tab-rota" role="tab" aria-selected="false">2. Rota &amp; Shifts</button>
                <button type="button" class="oz-tab-btn" data-tab="tab-census" role="tab" aria-selected="false">3. Civic Census</button>
                <button type="button" class="oz-tab-btn" data-tab="tab-ai" role="tab" aria-selected="false">4. Private AI (BYOK)</button>
                <button type="button" class="oz-tab-btn" data-tab="tab-credentials" role="tab" aria-selected="false">5. QR Credentials</button>
            </div>

            <!-- Tab Panes -->
            <div class="oz-tabs-content">
                <!-- Pane 1: Workspace -->
                <div class="oz-tab-pane active" id="tab-workspace" role="tabpanel">
                    <div class="oz-tab-content-card">
                        <div class="oz-tab-text-side">
                            <h3 class="oz-tab-text-title">@SharedLocalizer["Home_Tab1_Title"]</h3>
                            <p class="oz-tab-text-desc">@SharedLocalizer["Home_Tab1_Desc"]</p>
                            <ul class="oz-tab-bullets">
                                <li class="oz-tab-bullet-item">
                                    <span class="oz-tab-check-icon">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                    </span>
                                    <span>Single sign-on across all 37 organizational capabilities</span>
                                </li>
                                <li class="oz-tab-bullet-item">
                                    <span class="oz-tab-check-icon">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                    </span>
                                    <span>Granular committee and department role-based access</span>
                                </li>
                                <li class="oz-tab-bullet-item">
                                    <span class="oz-tab-check-icon">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                    </span>
                                    <span>Searchable alumni registry with verification filters</span>
                                </li>
                            </ul>
                        </div>
                        <div class="oz-tab-preview-box">
                            <div class="oz-preview-header">
                                <div class="oz-preview-dots">
                                    <span class="oz-preview-dot"></span>
                                    <span class="oz-preview-dot"></span>
