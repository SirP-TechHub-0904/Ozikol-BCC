@page "/terms-of-use"
@model Ozikol.Central.Pages.Legal.TermsOfUseModel
@{
    ViewData["Title"] = "Terms of Use & Service Agreement - Ozikol";
    ViewData["MetaDescription"] = "Official terms and conditions governing the use of Ozikol cloud platform, services, APIs, and subscriptions.";
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>Terms of Use & Service Agreement</span>
                </div>
                <partial name="_BackToFeaturesLink" />
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
                <span class="oz-feat-pill">Legal Agreement • Platform Governance</span>
            </div>
            <h1 class="oz-feat-title">Ozikol Terms of Use</h1>
            <p class="oz-feat-lead">These terms govern your organization's access to and use of Ozikol's cloud software, mobile applications, APIs, and modular tools.</p>
            <div class="oz-feat-actions">
                <a href="/privacy-notice" class="btn btn-secondary--alt">Read Privacy Notice</a>
                <a href="/legal-hub" class="btn btn-secondary--alt">Visit Legal Hub</a>
            </div>
        </div>
    </section>

    <!-- Terms Summary Grid -->
    <section class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">Governance Summary</div>
            <h2>Key Terms at a Glance</h2>
            <p class="oz-feat-card-desc">Clear, fair, and transparent commitments protecting your organization and data.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">100% Customer Data Ownership</h3>
                <p class="oz-feat-card-desc">You retain exclusive ownership of all organizational data, rosters, member records, and files uploaded to the platform.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--indigo">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Security &amp; Encryption</h3>
                <p class="oz-feat-card-desc">All data is encrypted in transit using TLS 1.3 and at rest using AES-256 in certified Tier 4 data centers.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--amber">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Export &amp; Portability</h3>
                <p class="oz-feat-card-desc">Export your entire organizational database at any time in standard JSON, CSV, or SQL formats with 1 click.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Experience the Power of Ozikol</h2>
            <p>Deploy custom modules, automate operations, and empower your organization today.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support#contact" class="btn btn-primary">Book a Platform Demo</a>
                <partial name="_ExploreFeaturesButton" />
            </div>
        </div>
    </section>
</div>
