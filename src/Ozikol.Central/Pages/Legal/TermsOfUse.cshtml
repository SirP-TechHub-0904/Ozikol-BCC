@page "/terms-of-use"
@model Ozikol.Central.Pages.Legal.TermsOfUseModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    var doc = Model.Document;
    var title = doc?.Title ?? "Terms of Use & Master Subscription Agreement";
    ViewData["Title"] = $"{title} | Ozikol Cloud";
    ViewData["MetaDescription"] = doc?.Summary ?? "Official terms and conditions governing enterprise organizations using Ozikol.";
    var currentCulture = Model.CurrentCulture;
}

<div class="oz-legal-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@currentCulture">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/policies-and-reports">Legal &amp; Governance</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@title</span>
                </div>
                <a href="/@currentCulture" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>Back to Portal</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Legal Header Banner -->
    <section class="oz-legal-hero">
        <div class="container">
            <div class="oz-legal-hero__badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <span>@(doc?.Category ?? "Terms & Service Agreement")</span>
            </div>
            <h1 class="oz-legal-hero__title">@title</h1>
            <p class="oz-legal-hero__desc">@(doc?.Summary ?? "Legal commitments, SLA guarantees, data ownership rights, and acceptable use policies.")</p>

            <!-- Metadata Timestamp Bar -->
            <div class="oz-legal-meta-bar">
                <div class="oz-legal-meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>Last Updated: <strong>@(doc?.LastUpdatedUtc.ToString("MMMM d, yyyy") ?? "September 5, 2026")</strong></span>
                </div>
                <div class="oz-legal-meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span>Effective: <strong>@(doc?.EffectiveDate.ToString("MMMM d, yyyy") ?? "January 1, 2026")</strong></span>
                </div>
                <div class="oz-legal-meta-badge">
                    Version @(doc?.Version ?? "2026.1")
                </div>
                <button type="button" class="oz-legal-print-btn" onclick="window.print()" title="Print this legal agreement">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    <span>Print Agreement</span>
                </button>
            </div>
        </div>
    </section>

    <!-- Content & Sidebar Layout -->
    <div class="oz-legal-container">
        <div class="oz-legal-layout">
            <!-- Main Legal Body -->
            <main class="oz-legal-body">
                @if (doc != null && !string.IsNullOrWhiteSpace(doc.ContentHtml))
                {
                    @Html.Raw(doc.ContentHtml)
                }
                else
                {
                    <div class="alert alert-info">
                        <p>This legal document is currently undergoing routine compliance review. Please check back shortly or consult our legal desk.</p>
                    </div>
                }
            </main>

            <!-- Sticky Sidebar -->
            <aside class="oz-legal-sidebar">
                <!-- Quick Navigation Box -->
                <div class="oz-legal-card">
                    <h3 class="oz-legal-card__title">Legal &amp; Governance Hub</h3>
                    <ul class="oz-legal-nav-list">
                        <li>
                            <a href="/privacy-notice" class="oz-legal-nav-link">
                                <span>Privacy Notice</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/terms-of-use" class="oz-legal-nav-link is-active">
                                <span>Terms of Use</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/cookies" class="oz-legal-nav-link">
                                <span>Cookie Policy</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/privacy-choices" class="oz-legal-nav-link">
                                <span>Privacy Choices &amp; Rights</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/policies-and-reports" class="oz-legal-nav-link">
                                <span>Policies &amp; Compliance Reports</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Legal Contact & Inquiries Card -->
                <div class="oz-legal-contact-card">
                    <h4>Enterprise Agreements &amp; Custom Terms</h4>
                    <p>Have custom procurement requirements, master enterprise riders, or bespoke SLA stipulations?</p>
                    <a href="/@currentCulture/support/contact?type=Enterprise" class="btn btn-primary btn-sm w-100" style="background: #e5173f; border: none; font-weight: 700;">
                        Consult Enterprise Sales
                    </a>
                </div>
            </aside>
        </div>
    </div>
</div>
