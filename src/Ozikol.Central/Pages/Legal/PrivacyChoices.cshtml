@page "/privacy-choices"
@model Ozikol.Central.Pages.Legal.PrivacyChoicesModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> SharedLocalizer
@{
    var doc = Model.Document;
    var title = doc?.Title ?? "Your Privacy Choices & Consent Management";
    ViewData["Title"] = $"{title} | Ozikol Cloud";
    ViewData["MetaDescription"] = doc?.Summary ?? "Manage your organizational data preferences, tracking consent, cookies, and regulatory privacy rights.";
    var currentCulture = Model.CurrentCulture;
}

<div class="oz-legal-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/@currentCulture">@SharedLocalizer["Legal_Breadcrumb_Home"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <a href="/@currentCulture/policies-and-reports">@SharedLocalizer["Legal_Breadcrumb_Hub"]</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>@title</span>
                </div>
                <a href="/@currentCulture" class="oz-breadcrumb-back">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                    <span>@SharedLocalizer["Legal_Breadcrumb_Back"]</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Legal Header Banner -->
    <section class="oz-legal-hero">
        <div class="container">
            <div class="oz-legal-hero__badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                <span>@(doc?.Category ?? "Privacy & Data Subject Rights")</span>
            </div>
            <h1 class="oz-legal-hero__title">@title</h1>
            <p class="oz-legal-hero__desc">@(doc?.Summary ?? "Granular transparency and controls over your organization's data preferences, cookie consent, and statutory privacy rights.")</p>

            <!-- Metadata Timestamp Bar -->
            <div class="oz-legal-meta-bar">
                <div class="oz-legal-meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>@SharedLocalizer["Legal_Meta_LastUpdated"]: <strong>@(doc?.LastUpdatedUtc.ToString("MMMM d, yyyy") ?? "September 5, 2026")</strong></span>
                </div>
                <div class="oz-legal-meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    <span>@SharedLocalizer["Legal_Meta_Effective"]: <strong>@(doc?.EffectiveDate.ToString("MMMM d, yyyy") ?? "January 1, 2026")</strong></span>
                </div>
                <div class="oz-legal-meta-badge">
                    Version @(doc?.Version ?? "2026.1")
                </div>
                <button type="button" class="oz-legal-print-btn" onclick="window.print()" title="Print this legal guide">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    <span>Print</span>
                </button>
            </div>
        </div>
    </section>

    <!-- Content & Sidebar Layout -->
    <div class="oz-legal-container">
        <div class="oz-legal-layout">
            <!-- Main Legal Body -->
            <main class="oz-legal-body">
                <!-- Interactive Consent Preferences Box -->
                <div style="background: #f8fafc; border: 1px solid var(--ozikol-border); border-radius: 12px; padding: 24px; margin-bottom: 36px;">
                    <h3 style="margin-top: 0; border: none; padding: 0;">Consent Management Dashboard</h3>
                    <p style="font-size: 14px; margin-bottom: 20px;">Review and configure tracking categories for this browser session:</p>

                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: white; border-radius: 8px; border: 1px solid var(--ozikol-border);">
                            <div>
                                <strong style="display: block; font-size: 14px;">Strictly Necessary Cookies</strong>
                                <span style="font-size: 12.5px; color: var(--ozikol-text-slate);">Required for cryptographic session auth, CSRF security, and tenant routing.</span>
                            </div>
                            <span class="badge bg-success" style="padding: 6px 12px; font-size: 12px;">Always Active</span>
                        </div>

                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: white; border-radius: 8px; border: 1px solid var(--ozikol-border);">
                            <div>
                                <strong style="display: block; font-size: 14px;">Performance &amp; Health Telemetry</strong>
                                <span style="font-size: 12.5px; color: var(--ozikol-text-slate);">Anonymized metrics to detect platform errors and monitor 99.99% uptime.</span>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="perfConsent" checked>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px; background: white; border-radius: 8px; border: 1px solid var(--ozikol-border);">
                            <div>
                                <strong style="display: block; font-size: 14px;">Functional Preferences</strong>
                                <span style="font-size: 12.5px; color: var(--ozikol-text-slate);">Remembers language selections and localized currency formatting.</span>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="funcConsent" checked>
                            </div>
                        </div>
                    </div>
                </div>

                @if (doc != null && !string.IsNullOrWhiteSpace(doc.ContentHtml))
                {
                    @if (currentCulture != "en" && doc != null && (doc.Culture == "en" || string.IsNullOrEmpty(doc.Culture)))
                {
                    <div class="oz-legal-callout oz-legal-callout--info mb-4">
                        <p><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg> @SharedLocalizer["Legal_Fallback_Notice"]</p>
                    </div>
                }
                @Html.Raw(doc.ContentHtml)
                }
            </main>

            <!-- Sticky Sidebar -->
            <aside class="oz-legal-sidebar">
                <!-- Quick Navigation Box -->
                <div class="oz-legal-card">
                    <h3 class="oz-legal-card__title">@SharedLocalizer["Legal_Nav_Title"]</h3>
                    <ul class="oz-legal-nav-list">
                        <li>
                            <a href="/@currentCulture/privacy-notice" class="oz-legal-nav-link">
                                <span>@SharedLocalizer["Legal_Nav_PrivacyNotice"]</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/@currentCulture/terms-of-use" class="oz-legal-nav-link">
                                <span>@SharedLocalizer["Legal_Nav_TermsOfUse"]</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/@currentCulture/cookies" class="oz-legal-nav-link">
                                <span>@SharedLocalizer["Legal_Nav_Cookies"]</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/@currentCulture/privacy-choices" class="oz-legal-nav-link is-active">
                                <span>@SharedLocalizer["Legal_Nav_PrivacyChoices"]</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                        <li>
                            <a href="/@currentCulture/policies-and-reports" class="oz-legal-nav-link">
                                <span>@SharedLocalizer["Legal_Nav_PoliciesReports"]</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- DSAR Rights Escalation Card -->
                <div class="oz-legal-contact-card">
                    <h4>Submit a Formal Data Request</h4>
                    <p>Want to exercise your Right of Access, Data Portability, or Erasure under GDPR/CCPA?</p>
                    <a href="/@currentCulture/support/contact?type=General" class="btn btn-primary btn-sm w-100" style="background: #e5173f; border: none; font-weight: 700;">
                        Submit Privacy Request
                    </a>
                </div>
            </aside>
        </div>
    </div>
</div>
