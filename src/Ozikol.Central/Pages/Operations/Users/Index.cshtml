@page
@model Ozikol.Central.Pages.Operations.Users.IndexModel
@{
    ViewData["Title"] = "Staff & Operator Management - Ozikol Central";
}

<div class="central-dashboard">
    <!-- Operations Sub-Nav Tabs -->
    <div style="display: flex; gap: 12px; margin-bottom: 24px; border-bottom: 1px solid #1e293b; padding-bottom: 12px;">
        <a asp-page="/Operations/Fleet" style="color: #94a3b8; font-weight: 700; font-size: 13.5px; text-decoration: none; padding: 6px 14px; border-radius: 6px; transition: all 0.15s ease;">
            📊 Database Fleet & Migrations
        </a>
        <a asp-page="/Operations/Users/Index" style="color: #38bdf8; font-weight: 800; font-size: 13.5px; text-decoration: none; padding: 6px 14px; background: rgba(56, 189, 248, 0.12); border-radius: 6px; border: 1px solid rgba(56, 189, 248, 0.25);">
            👥 Staff & Operator Roles
        </a>
    </div>

    <!-- Header -->
    <header class="central-header">
        <div class="header-left">
            <div class="brand-badge">
                <span class="badge-dot"></span>
                <span>CENTRAL ACCESS GOVERNANCE</span>
            </div>
            <h1 class="main-title">Staff & Platform Operators (@Model.StaffMembers.Count)</h1>
            <p class="subtitle">Manage SuperAdmins, Admins, Template Managers, and Referral Partner Managers with role-based access.</p>
        </div>
        <div class="header-actions">
            <a asp-page="/Operations/Users/Create" class="btn btn-sync-all">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                <span>Add New Staff Operator</span>
            </a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert @(Model.AlertIsError ? "alert-danger" : "alert-success")">
            <div class="alert-icon">@(Model.AlertIsError ? "⚠️" : "✅")</div>
            <div class="alert-text">@Model.AlertMessage</div>
        </div>
    }

    <!-- Staff Table Section -->
    <section class="section-card">
        <div class="tenants-table-wrapper">
            <table class="central-table">
                <thead>
                    <tr>
                        <th>Operator Name & Email</th>
                        <th>Department</th>
                        <th>Assigned Role</th>
                        <th>Status</th>
                        <th>Last Login</th>
                        <th>Date Added</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in Model.StaffMembers)
                    {
                        <tr>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <strong style="color: #ffffff; font-size: 13.5px;">@staff.FullName</strong>
                                    <span class="text-muted font-mono" style="font-size: 11.5px;">@staff.Email</span>
                                </div>
                            </td>
                            <td>
                                <span class="schema-badge">@staff.Department</span>
                            </td>
                            <td>
                                @if (staff.RoleName == "SuperAdmin")
                                {
                                    <span class="status-badge" style="background: rgba(245, 158, 11, 0.18); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35);">
                                        🛡️ SuperAdmin
                                    </span>
                                }
                                else if (staff.RoleName == "Admin")
                                {
                                    <span class="status-badge" style="background: rgba(0, 80, 229, 0.18); color: #38bdf8; border: 1px solid rgba(0, 80, 229, 0.35);">
                                        💼 Platform Admin
                                    </span>
                                }
                                else if (staff.RoleName == "TemplateManager")
                                {
                                    <span class="status-badge" style="background: rgba(147, 51, 234, 0.18); color: #c084fc; border: 1px solid rgba(147, 51, 234, 0.35);">
                                        🎨 Template Manager
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge" style="background: rgba(16, 185, 129, 0.18); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.35);">
                                        🤝 Referral Manager
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="status-pill @(staff.IsActive ? "status-online" : "status-offline")">
                                    @(staff.IsActive ? "Active" : "Suspended")
                                </span>
                            </td>
                            <td>
                                <span class="text-muted" style="font-size: 12px;">
                                    @(staff.LastLoginUtc.HasValue ? staff.LastLoginUtc.Value.ToString("dd MMM yyyy, HH:mm") : "Never")
                                </span>
                            </td>
                            <td>
                                <span class="text-muted" style="font-size: 12px;">@staff.CreatedUtc.ToString("dd MMM yyyy")</span>
                            </td>
                            <td class="text-right">
                                <form method="post" asp-page-handler="ToggleStatus" style="display: inline;">
                                    <input type="hidden" name="userId" value="@staff.Id" />
                                    <button type="submit" class="btn-link-action" style="background: none; border: none; font-size: 12px; font-weight: 700; cursor: pointer; color: @(staff.IsActive ? "#f87171" : "#34d399");">
                                        @(staff.IsActive ? "Suspend" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
