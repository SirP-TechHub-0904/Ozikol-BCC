@page
@model Ozikol.Central.Pages.Operations.Users.CreateModel
@{
    ViewData["Title"] = "Add New Staff Operator - Ozikol Central";
}

<div class="signup-page-container">
    <div class="signup-card" style="max-width: 580px;">
        <div class="signup-header">
            <div class="brand-badge">
                <span class="badge-dot"></span>
                <span>Staff & Operator Provisioning</span>
            </div>
            <h1 class="signup-title">Create Platform Staff Account</h1>
            <p class="signup-subtitle">Assign staff roles to manage database migrations, marketplace templates, and referral partner commissions.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <div class="alert-icon">⚠️</div>
                <div class="alert-text">@Model.ErrorMessage</div>
            </div>
        }

        <form method="post" class="signup-form">
            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="Input.FirstName">First Name</label>
                    <input asp-for="Input.FirstName" class="form-control" placeholder="Jane" />
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.LastName">Last Name</label>
                    <input asp-for="Input.LastName" class="form-control" placeholder="Doe" />
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.Email">Staff Email Address</label>
                <input asp-for="Input.Email" type="email" class="form-control" placeholder="jane@ozikol.cloud" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    <label asp-for="Input.Department">Department / Unit</label>
                    <input asp-for="Input.Department" class="form-control" placeholder="e.g. Customer Success, DevOps" />
                    <span asp-validation-for="Input.Department" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Role">Assigned Platform Role</label>
                    <select asp-for="Input.Role" class="form-control">
                        <option value="Admin">💼 Platform Admin (Tenant Management)</option>
                        <option value="SuperAdmin">🛡️ SuperAdmin (Full System & Migrations)</option>
                        <option value="TemplateManager">🎨 Template Manager (Marketplace)</option>
                        <option value="ReferralManager">🤝 Referral Manager (Affiliate Network)</option>
                    </select>
                    <span asp-validation-for="Input.Role" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Temporary Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="••••••••" />
                <span class="form-hint">Must be at least 6 characters. User will be required to complete 2FA on first login.</span>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-launch-workspace">
                <span>Create Staff Operator</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </button>
        </form>

        <div class="signup-footer">
            <a asp-page="/Operations/Users/Index" class="login-link">← Back to Staff Directory</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
