@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const videoModal = document.getElementById('ozVideoModal');
            const articleModal = document.getElementById('ozArticleModal');
            const videoFrame = document.getElementById('ozVideoFrame');
            const videoTitle = document.getElementById('ozVideoModalTitle');
            const videoDesc = document.getElementById('ozVideoModalDesc');

            const articleCategory = document.getElementById('ozArticleCategory');
            const articleSuite = document.getElementById('ozArticleSuite');
            const articleReadTime = document.getElementById('ozArticleReadTime');
            const articleTitle = document.getElementById('ozArticleTitle');
            const articleDate = document.getElementById('ozArticleDate');
            const articleViews = document.getElementById('ozArticleViews');
            const articleContent = document.getElementById('ozArticleContent');

            let activeArticleId = null;

            // Open Video Modal
            document.querySelectorAll('.js-open-video, .oz-video-card').forEach(card => {
                card.addEventListener('click', async function (e) {
                    const videoId = this.dataset.videoId || this.dataset.id;
                    const ytId = this.dataset.youtubeId;

                    if (videoId) {
                        try {
                            const res = await fetch(`?handler=VideoDetails&id=${videoId}`);
                            if (res.ok) {
                                const data = await res.json();
                                videoTitle.textContent = data.title;
                                videoDesc.textContent = data.description;
                                videoFrame.src = `https://www.youtube-nocookie.com/embed/${data.youtubeId}?autoplay=1`;
                                openModal(videoModal);
                                return;
                            }
                        } catch (err) {
                            console.error('Error fetching video details', err);
                        }
                    }

                    if (ytId) {
                        videoFrame.src = `https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1`;
                        openModal(videoModal);
                    }
                });
            });

            // Open Article Reader Modal
            document.querySelectorAll('.js-open-article, .oz-article-card').forEach(card => {
                card.addEventListener('click', async function (e) {
                    const articleId = this.dataset.articleId || this.dataset.id;
                    if (!articleId) return;

                    activeArticleId = articleId;
                    articleContent.innerHTML = '<div class="oz-loading-spinner">Loading guide...</div>';
                    openModal(articleModal);

                    try {
                        const res = await fetch(`?handler=ArticleDetails&id=${articleId}`);
                        if (res.ok) {
                            const data = await res.json();
                            articleTitle.textContent = data.title;
                            articleCategory.textContent = data.category;
                            articleSuite.textContent = (data.suiteCode || 'Platform').replace('suite-', '').toUpperCase();
                            articleReadTime.textContent = `${data.readMinutes} min read`;
                            articleDate.textContent = `Updated: ${data.updated}`;
                            articleViews.textContent = `👁 ${data.viewCount} views`;
                            articleContent.innerHTML = data.contentHtml;
                        } else {
                            articleContent.innerHTML = '<p class="text-danger">Unable to load article content.</p>';
                        }
                    } catch (err) {
                        console.error('Error fetching article', err);
                        articleContent.innerHTML = '<p class="text-danger">An error occurred while loading the article.</p>';
                    }
                });
            });

            // Helpful Article Voting
            document.querySelectorAll('.js-vote-article').forEach(btn => {
                btn.addEventListener('click', async function () {
                    if (!activeArticleId) return;
                    const helpful = this.dataset.helpful === 'true';
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                    const formData = new FormData();
                    formData.append('id', activeArticleId);
                    formData.append('helpful', helpful);

                    try {
                        await fetch('?handler=VoteArticle', {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': token },
                            body: formData
                        });
                        document.getElementById('ozArticleFeedbackPanel').innerHTML = '<span class="oz-feedback-thanks">Thank you for your feedback!</span>';
                    } catch (e) {
                        console.error('Vote failed', e);
                    }
                });
            });

            // Pre-fill Support Form Department
            document.querySelectorAll('.js-prefill-inquiry').forEach(link => {
                link.addEventListener('click', function () {
                    const type = this.dataset.type;
                    const select = document.getElementById('inquiryTypeSelect');
                    if (select && type) {
                        select.value = type;
                    }
                });
            });

            // Generic Modal Open/Close logic
            function openModal(modal) {
                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.classList.add('oz-modal-open');
            }

            function closeModal(modal) {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('oz-modal-open');
                if (modal === videoModal) {
                    videoFrame.src = ''; // Stop video playback
                }
            }

            document.querySelectorAll('.js-close-modal').forEach(btn => {
                btn.addEventListener('click', function () {
                    const m = this.closest('.oz-modal-backdrop');
                    if (m) closeModal(m);
                });
            });

            [videoModal, articleModal].forEach(modal => {
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) {
                        closeModal(modal);
                    }
                });
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    if (videoModal.classList.contains('is-open')) closeModal(videoModal);
                    if (articleModal.classList.contains('is-open')) closeModal(articleModal);
                }
            });
        });
    </script>
}
