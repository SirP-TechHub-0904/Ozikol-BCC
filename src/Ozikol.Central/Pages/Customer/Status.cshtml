@page "/status"
@model Ozikol.Central.Pages.Customer.StatusModel
@{
    ViewData["Title"] = "System Status & Real-Time Uptime - Ozikol";
    ViewData["MetaDescription"] = "Live system status, service health monitor, scheduled maintenance transparency, and 90-day historical uptime.";
}

<div class="oz-feat-page">
    <!-- Breadcrumb Bar -->
    <div class="oz-breadcrumb-bar">
        <div class="container">
            <div class="oz-breadcrumb-wrap">
                <div class="oz-breadcrumb-links">
                    <a href="/">Home</a>
                    <span class="oz-breadcrumb-sep">/</span>
                    <span>System Status & Real-Time Uptime</span>
                </div>
                <partial name="_BackToFeaturesLink" />
            </div>
        </div>
    </div>

    <!-- Hero Banner -->
    <section class="oz-feat-hero">
        <div class="container">
            <div class="oz-feat-badge-wrap">
                <div class="oz-feat-icon-box oz-feat-icon-box--primary">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <span class="oz-feat-pill">Live Health • 99.99% Uptime</span>
            </div>
            <h1 class="oz-feat-title">All Systems Operational</h1>
            <p class="oz-feat-lead">Real-time telemetry and infrastructure health monitoring across all Ozikol cloud suites, API gateways, database clusters, and background workers.</p>
            <div class="oz-feat-actions">
                <a href="#services" class="btn btn-primary">Check Service Breakdown</a>
                <a href="/support-hub" class="btn btn-secondary--alt">Contact Support Desk</a>
            </div>
        </div>
    </section>

    <!-- Services Health List -->
    <section id="services" class="container oz-feat-capabilities-section">
        <div class="oz-feat-section-header">
            <div class="oz-feat-tagline">Infrastructure Status</div>
            <h2>Service Components Health</h2>
            <p class="oz-feat-card-desc">Continuous synthetic monitoring and automated health checks refreshed every 60 seconds.</p>
        </div>
        <div class="oz-feat-grid">
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h3 class="oz-feat-card-title">Core Web App &amp; MIS Portal</h3>
                <p class="oz-feat-card-desc"><strong style="color: var(--ozikol-success);">Operational</strong> &bull; 99.99% uptime over the past 90 days. Average latency: 42ms.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h3 class="oz-feat-card-title">REST API &amp; Webhook Engine</h3>
                <p class="oz-feat-card-desc"><strong style="color: var(--ozikol-success);">Operational</strong> &bull; Zero dropped webhooks. Automated multi-region failover active.</p>
            </div>
            <div class="oz-feat-card">
                <div class="oz-feat-card-icon oz-feat-card-icon--teal">
                    <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h3 class="oz-feat-card-title">SMS &amp; Email Dispatch</h3>
                <p class="oz-feat-card-desc"><strong style="color: var(--ozikol-success);">Operational</strong> &bull; Carrier gateway delivery queue nominal. Instant push notifications active.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Banner -->
    <section class="oz-feat-cta-banner">
        <div class="container">
            <h2>Experience the Power of Ozikol</h2>
            <p>Deploy custom modules, automate operations, and empower your organization today.</p>
            <div class="oz-feat-actions oz-feat-actions--center">
                <a href="/support-hub/contact-sales" class="btn btn-primary">Book a Platform Demo</a>
                <partial name="_ExploreFeaturesButton" />
            </div>
        </div>
    </section>
</div>
