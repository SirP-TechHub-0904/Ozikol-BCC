@page
@model Ozikol.Central.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Platform Operator Login - Ozikol Central";
}

<div class="signup-page-container">
    <div class="signup-card" style="max-width: 480px;">
        <div class="signup-header">
            <div class="brand-badge">
                <span class="badge-dot"></span>
                <span>Ozikol Central Console</span>
            </div>
            <h1 class="signup-title">Platform Operator Login</h1>
            <p class="signup-subtitle">Secure access for SuperAdmins and DevOps operators to manage database fleets and platform migrations.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <div class="alert-icon">⚠️</div>
                <div class="alert-text">@Model.ErrorMessage</div>
            </div>
        }

        <form method="post" class="signup-form">
            <div class="form-group">
                <label asp-for="Input.Email">Operator Email</label>
                <input asp-for="Input.Email" type="email" class="form-control" placeholder="superadmin@ozikol.cloud" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-launch-workspace">
                <span>Sign In to Central Console</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
            </button>
        </form>

        <div class="signup-footer">
            <span>Want to register a new tenant?</span>
            <a asp-page="/Signup" class="login-link">Create Workspace</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
