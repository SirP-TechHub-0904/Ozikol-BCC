@page
@model Ozikol.Central.Pages.Account.TwoFactorVerifyModel
@{
    ViewData["Title"] = "Two-Factor Verification - Ozikol Central";
}

<div class="signup-page-container">
    <div class="signup-card" style="max-width: 480px;">
        <div class="signup-header">
            <div class="brand-badge">
                <span class="badge-dot"></span>
                <span>Compulsory 2FA Verification</span>
            </div>
            <h1 class="signup-title">Enter Security Code</h1>
            <p class="signup-subtitle">To protect the central database fleet, verify your identity using your Authenticator App or the 6-digit email code sent to <strong>@Model.OperatorEmail</strong>.</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                <div class="alert-icon">⚠️</div>
                <div class="alert-text">@Model.ErrorMessage</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.InfoMessage))
        {
            <div class="alert alert-success">
                <div class="alert-icon">📬</div>
                <div class="alert-text">@Model.InfoMessage</div>
            </div>
        }

        <form method="post" class="signup-form">
            <input type="hidden" name="email" value="@Model.OperatorEmail" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <div class="form-group" style="text-align: center;">
                <label asp-for="Input.Code" style="font-size: 13px; font-weight: 700; margin-bottom: 8px;">6-Digit Passcode</label>
                <input asp-for="Input.Code" class="form-control font-mono" placeholder="000000" maxlength="6" autofocus style="font-size: 26px; text-align: center; letter-spacing: 8px; font-weight: 800;" />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>

            <div class="provision-info-box">
                <div class="info-row">
                    <span class="info-icon">📱</span>
                    <span><strong>Authenticator App:</strong> Google or Microsoft Authenticator rolling code.</span>
                </div>
                <div class="info-row">
                    <span class="info-icon">✉️</span>
                    <span><strong>Email OTP:</strong> 6-digit one-time code sent to your registered inbox.</span>
                </div>
            </div>

            <button type="submit" class="btn btn-launch-workspace">
                <span>Verify & Access Console</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
            </button>
        </form>

        <div style="margin-top: 20px; text-align: center;">
            <form method="post" asp-page-handler="ResendCode" style="display: inline;">
                <input type="hidden" name="email" value="@Model.OperatorEmail" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn-link-action" style="background: none; border: none; color: #38bdf8; font-weight: 700; cursor: pointer; font-size: 12.5px;">
                    Didn't receive email code? Resend Code
                </button>
            </form>
        </div>

        <div class="signup-footer">
            <a asp-page="/Account/Login" class="login-link">← Return to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
