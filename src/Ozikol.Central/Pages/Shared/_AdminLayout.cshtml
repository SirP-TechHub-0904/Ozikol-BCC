@* ─────────────────────────────────────────────────────────────────────────────
    _AdminLayout.cshtml — Main Master Layout for the Ozikol Central Admin Console
   ───────────────────────────────────────────────────────────────────────────── *@
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin Console") — Ozikol Central</title>

    <!-- Google Material Symbols (Outlined, Sharp weight) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Fonts & Core Console Styling -->
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="/images/oz-logo-red.png" />
    <link rel="shortcut icon" type="image/png" href="/images/oz-logo-red.png" />
    <meta name="theme-color" content="#f8fafc" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-shell">
        @* ── Sidebar Partial ── *@
        <partial name="/Areas/Centralwks/Pages/_AdminSidebarPartial.cshtml" />
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        @* ── Main Content Wrapper ── *@
        <div class="admin-content-wrapper" id="adminContentWrapper">
            @* ── Topbar ── *@
            <header class="admin-topbar">
                <div class="topbar-left">
                    <button class="topbar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle navigation">
                        <span class="material-symbols-outlined">menu</span>
                    </button>
                    <nav class="topbar-breadcrumb" aria-label="Breadcrumb">
                        <a href="/centralwks/dashboard">Console</a>
                        @if (ViewData["BreadcrumbSection"] != null)
                        {
                            <span class="separator">/</span>
                            <span>@ViewData["BreadcrumbSection"]</span>
                        }
                        @if (ViewData["Title"] != null)
                        {
                            <span class="separator">/</span>
                            <span class="current">@ViewData["Title"]</span>
                        }
                    </nav>
                </div>

                <div class="topbar-right">
                    <div class="topbar-search">
                        <span class="search-icon">
                            <span class="material-symbols-outlined">search</span>
                        </span>
                        <input type="text" placeholder="Quick search... (Press /)" aria-label="Search" />
                    </div>

                    <button class="theme-toggle-btn" id="themeToggleBtn" title="Toggle dark/light theme" aria-label="Toggle Theme">
                        <span class="material-symbols-outlined" id="themeIcon">dark_mode</span>
                    </button>

                    <div class="topbar-user">
                        <button class="user-badge" id="userBadgeBtn" aria-haspopup="true" aria-expanded="false">
                            <div class="user-avatar">
                                @(User.Identity?.Name?.Substring(0, Math.Min(2, User.Identity.Name.Length)).ToUpperInvariant() ?? "AD")
                            </div>
                            <div class="user-info">
                                <span class="user-name">@(User.Identity?.Name ?? "Administrator")</span>
                                <span class="user-role">Super Admin</span>
                            </div>
                            <span class="material-symbols-outlined user-chevron">expand_more</span>
                        </button>
                        <div class="user-menu-dropdown" role="menu">
                            <a href="/centralwks/users" role="menuitem">
                                <span class="material-symbols-outlined">manage_accounts</span>
                                User Accounts
                            </a>
                            <a href="/centralwks/platform-settings" role="menuitem">
                                <span class="material-symbols-outlined">settings</span>
                                Platform Settings
                            </a>
                            <a href="/centralwks/audit-log" role="menuitem">
                                <span class="material-symbols-outlined">history</span>
                                Audit Trail
                            </a>
                            <div class="user-menu-divider"></div>
                            <form method="post" action="/centralwks/logout" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <button type="submit" role="menuitem" class="signout-btn">
                                    <span class="material-symbols-outlined">logout</span>
                                    Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            @* ── Main Content ── *@
            <main class="admin-main">
                @* ── Flash Messages ── *@
                @if (TempData["Success"] != null)
                {
                    <div class="admin-alert admin-alert-success" role="alert">
                        <span class="material-symbols-outlined alert-icon">check_circle</span>
                        <span class="alert-message">@TempData["Success"]</span>
                        <button type="button" class="admin-alert-close" aria-label="Close">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="admin-alert admin-alert-danger" role="alert">
                        <span class="material-symbols-outlined alert-icon">cancel</span>
                        <span class="alert-message">@TempData["Error"]</span>
                        <button type="button" class="admin-alert-close" aria-label="Close">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="admin-alert admin-alert-warning" role="alert">
                        <span class="material-symbols-outlined alert-icon">warning</span>
                        <span class="alert-message">@TempData["Warning"]</span>
                        <button type="button" class="admin-alert-close" aria-label="Close">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="admin-alert admin-alert-info" role="alert">
                        <span class="material-symbols-outlined alert-icon">info</span>
                        <span class="alert-message">@TempData["Info"]</span>
                        <button type="button" class="admin-alert-close" aria-label="Close">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
