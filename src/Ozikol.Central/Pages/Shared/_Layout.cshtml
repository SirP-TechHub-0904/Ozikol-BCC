                <div class="mega-menu__secondary-area">
                    @{
                        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();
                        if (currentCulture != "en" && currentCulture != "fr" && currentCulture != "es" && currentCulture != "de")
                        {
                            currentCulture = "en";
                        }

                        var pathValue = Context.Request.Path.Value ?? "/en";
                        var routeRemainder = System.Text.RegularExpressions.Regex.Replace(pathValue, @"^/(en|fr|es|de)(/|$)", "/");
                        if (!routeRemainder.StartsWith("/")) routeRemainder = "/" + routeRemainder;
                        if (routeRemainder == "/") routeRemainder = "";

                        string BuildLangUrl(string lang) => $"/{lang}{routeRemainder}{Context.Request.QueryString}";

                        var currentFlag = currentCulture switch
                        {
                            "fr" => "🇫🇷 FR",
                            "es" => "🇪🇸 ES",
                            "de" => "🇩🇪 DE",
                            _ => "🇬🇧 EN"
                        };
                    }
                    <div class="oz-lang-switcher" id="ozLangSwitcher">
                        <button type="button" class="oz-lang-btn" aria-expanded="false" aria-label="Select Language">
                            <span class="oz-lang-flag">@currentFlag</span>
                            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 1L5 5L9 1"/>
                            </svg>
                        </button>
                        <div class="oz-lang-menu">
                            <a href="@BuildLangUrl("en")" class="oz-lang-item @(currentCulture == "en" ? "active" : "")">
                                <span>🇬🇧</span>
                                <span>English</span>
                            </a>
                            <a href="@BuildLangUrl("fr")" class="oz-lang-item @(currentCulture == "fr" ? "active" : "")">
                                <span>🇫🇷</span>
                                <span>Français</span>
                            </a>
                            <a href="@BuildLangUrl("es")" class="oz-lang-item @(currentCulture == "es" ? "active" : "")">
                                <span>🇪🇸</span>
                                <span>Español</span>
                            </a>
                            <a href="@BuildLangUrl("de")" class="oz-lang-item @(currentCulture == "de" ? "active" : "")">
                                <span>🇩🇪</span>
                                <span>Deutsch</span>
                            </a>
                        </div>
                    </div>

                    <a href="/@currentCulture/auth/login" class="nav-login-link">
                        @SharedLocalizer["Nav_SignIn"]
                    </a>
                    <a href="/@currentCulture/auth/get-started" class="btn-get-started">
                        @SharedLocalizer["Nav_GetStarted"]
                    </a>
                </div>
        </div>
    </div>
