<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Ozikol") | Unified Business Cloud Platform</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content="Ozikol is the unified business cloud platform delivering 33 modular capabilities across workforce scheduling, verifiable credentials, bio links, mass communication, and responsible AI workflows." />
    <meta name="keywords" content="Ozikol, business management software, workforce rota, staff scheduling, LMS, digital certificates, live chat, mass SMS, AI workflows, UI marketplace, UK cloud" />
    <meta name="author" content="Ozikol Technologies Ltd" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://ozikol.cloud@(Context.Request.Path)" />
    <meta name="theme-color" content="#e5173f" />

    <!-- Open Graph / Social Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ozikol" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Ozikol") | Unified Business Cloud Platform" />
    <meta property="og:description" content="Connect teams, manage rotas, issue verifiable certificates, run community censuses, and scale your organization with 37 modular cloud tools across 9 enterprise suites." />
    <meta property="og:image" content="https://ozikol.cloud/images/ozikol-red.png" />
    <meta property="og:url" content="https://ozikol.cloud@(Context.Request.Path)" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@@ozikol" />
    <meta name="twitter:title" content="@(ViewData["Title"] ?? "Ozikol") | Unified Business Cloud Platform" />
    <meta name="twitter:description" content="Connect teams, manage rotas, issue verifiable certificates, run community censuses, and scale your organization with 37 modular cloud tools across 9 enterprise suites." />
    <meta name="twitter:image" content="https://ozikol.cloud/images/ozikol-red.png" />

    <!-- Favicon & Brand Icons -->
    <link rel="icon" type="image/png" href="/images/oz-logo-red.png" />
    <link rel="shortcut icon" type="image/png" href="/images/oz-logo-red.png" />
    <link rel="apple-touch-icon" href="/images/oz-logo-red.png" />

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ozikol-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/compound.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/activestyle.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
</head>
