@* ─────────────────────────────────────────────────────────────────────────────
    _AuthLayout.cshtml — Unified, high-fidelity Razor layout for Central authentication
    flows (Login, 2FA Verification, Forgot Password, Reset Password, Setup Password).
    Adheres strictly to Rule 7 (Universal Brand Color Royal Blue #0050E5, canonical
    logo /images/ozikol.png, zero red branding, zero duplicate boilerplate).
   ───────────────────────────────────────────────────────────────────────────── *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — Ozikol BCC" : "Administrative Sign In — Ozikol BCC")</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="/images/oz-logo.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <style>
        :root {
            --auth-primary: #0050e5;
            --auth-primary-hover: #003bb5;
            --auth-primary-glow: rgba(0, 80, 229, 0.25);
            --auth-primary-glow-hover: rgba(0, 80, 229, 0.35);
            --auth-primary-light: rgba(0, 80, 229, 0.12);
            --auth-primary-focus: rgba(0, 80, 229, 0.15);
            --auth-danger: #ef4444;
            --auth-danger-bg: #fef2f2;
            --auth-danger-border: #fecaca;
            --auth-danger-text: #991b1b;
            --auth-success: #10b981;
            --auth-success-bg: #f0fdf4;
            --auth-success-border: #bbf7d0;
            --auth-success-text: #166534;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif);
            background: linear-gradient(135deg, #f8fafc 0%, #eef2f6 50%, #f1f5f9 100%);
            color: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            position: relative;
            overflow-x: hidden;
        }

        /* Ambient Royal Blue background illumination */
        body::before {
            content: "";
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 700px;
            height: 700px;
            background: radial-gradient(circle, rgba(0, 80, 229, 0.08) 0%, rgba(0, 80, 229, 0.02) 50%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        body::after {
            content: "";
            position: absolute;
            bottom: -150px;
            right: 10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(0, 80, 229, 0.05) 0%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        .auth-container {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 1;
        }

        .auth-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 40px 36px;
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.07), 0 0 1px 1px rgba(15, 23, 42, 0.04);
            position: relative;
        }

        .auth-header {
            text-align: center;
        }

        .auth-brand {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            margin-bottom: 22px;
            transition: opacity 0.2s ease, transform 0.15s ease;
        }

        .auth-brand:hover {
            opacity: 0.85;
            transform: translateY(-1px);
        }

        .auth-brand img {
            height: 34px;
            width: auto;
            max-width: 170px;
            object-fit: contain;
        }

        .auth-title {
            font-size: 22px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }

        .auth-subtitle {
            font-size: 13.5px;
            color: #64748b;
            line-height: 1.5;
            margin-bottom: 26px;
        }

        /* Alert notifications */
        .alert-box {
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 13.5px;
            line-height: 1.4;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            text-align: left;
        }

        .alert-danger {
            background-color: var(--auth-danger-bg);
            border: 1px solid var(--auth-danger-border);
            color: var(--auth-danger-text);
        }

        .alert-success {
            background-color: var(--auth-success-bg);
            border: 1px solid var(--auth-success-border);
            color: var(--auth-success-text);
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-label .required {
            color: var(--auth-danger);
        }

        .form-control {
            width: 100%;
            height: 44px;
            padding: 10px 14px;
            font-size: 14px;
            color: #0f172a;
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            transition: all 0.2s ease;
            outline: none;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: var(--auth-primary);
            box-shadow: 0 0 0 3px var(--auth-primary-focus);
        }

        .form-control::placeholder {
            color: #94a3b8;
        }

        .form-control.otp-control {
            height: 48px;
            font-size: 20px;
            font-weight: 700;
            letter-spacing: 0.35em;
            text-align: center;
        }

        .password-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-input-wrap .form-control {
            padding-right: 42px;
        }

        .password-toggle-btn {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            padding: 6px;
            color: #94a3b8;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease, transform 0.1s ease;
            border-radius: 6px;
            z-index: 2;
        }

        .password-toggle-btn:hover {
            color: #334155;
        }

        .password-toggle-btn:focus-visible {
            outline: 2px solid var(--auth-primary);
            outline-offset: 2px;
        }

        .field-validation-error {
            display: block;
            color: var(--auth-danger);
            font-size: 12px;
            margin-top: 5px;
            font-weight: 500;
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 6px;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: #475569;
            user-select: none;
        }

        .form-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            border-radius: 4px;
            accent-color: var(--auth-primary);
            cursor: pointer;
        }

        .forgot-link {
            color: var(--auth-primary);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .forgot-link:hover {
            color: var(--auth-primary-hover);
            text-decoration: underline;
        }

        /* Buttons */
        .btn-submit {
            width: 100%;
            height: 46px;
            background-color: var(--auth-primary);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 14.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px var(--auth-primary-glow);
        }

        .btn-submit:hover {
            background-color: var(--auth-primary-hover);
            box-shadow: 0 6px 16px var(--auth-primary-glow-hover);
            transform: translateY(-1px);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .resend-section {
            margin-top: 16px;
            text-align: center;
        }

        .btn-resend {
            background: none;
            border: none;
            color: var(--auth-primary);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: underline;
            padding: 4px 8px;
            transition: color 0.2s ease;
        }

        .btn-resend:hover {
            color: var(--auth-primary-hover);
        }

        /* Operator Badge for Setup/Onboarding */
        .operator-badge {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            margin-bottom: 20px;
            text-align: left;
        }

        .operator-avatar {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--auth-primary);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 15px;
            flex-shrink: 0;
        }

        /* Footer */
        .auth-footer {
            margin-top: 26px;
            padding-top: 18px;
            border-top: 1px solid #f1f5f9;
            text-align: center;
            font-size: 12.5px;
            color: #94a3b8;
        }

        .auth-footer a {
            color: #64748b;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .auth-footer a:hover {
            color: #0f172a;
        }
    </style>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <a href="/" class="auth-brand" title="Return to Home">
                    <img src="/images/ozikol.png" alt="Ozikol" />
                </a>
                @if (ViewData["CardTitle"] != null)
                {
                    <h1 class="auth-title">@ViewData["CardTitle"]</h1>
                }
                @if (ViewData["CardSubtitle"] != null)
                {
                    <p class="auth-subtitle">@ViewData["CardSubtitle"]</p>
                }
                @await RenderSectionAsync("HeaderExtra", required: false)
            </div>

            @RenderBody()

            @if (IsSectionDefined("Footer"))
            {
                @await RenderSectionAsync("Footer", required: false)
            }
            else
            {
                <div class="auth-footer">
                    <div>Protected by Isolated Master Architecture &amp; Immutable Audit Trail</div>
                    <div style="margin-top: 8px;">
                        <a href="/">← Return to Public Website</a>
                    </div>
                </div>
            }
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
