# ===================================================================
# Ozikol.Central Environment Configuration Template (.env.example)
# Copy this file to .env and populate values for your environment.
# ===================================================================

# 1. Master Catalog SQL Server Database
TenantConfiguration__ConnectionString="Server=localhost;Database=Ozikol_MasterCatalogDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# 2. Initial SuperAdmin Bootstrap Password (used only on first database seed)
CENTRAL_SUPERADMIN_INITIAL_PASSWORD="ChangeMe_StrongAdminPassword123!"

# 3. Google reCAPTCHA v2 Checkbox Keys
GoogleReCaptcha__SiteKey="your-google-recaptcha-site-key"
GoogleReCaptcha__SecretKey="your-google-recaptcha-secret-key"

# 4. Transactional Email Suite (Postmark)
EmailSettings__Provider="Postmark"
EmailSettings__ApiKey=""
EmailSettings__FromEmail="noreply@ozikol.cloud"
EmailSettings__FromName="Ozikol Cloud Security"
POSTMARK_SERVER_TOKEN="your-postmark-server-token"
POSTMARK_DEFAULT_FROM="notifications@ozikol.cloud"

# 5. Cryptographic & Session Secrets (256-bit minimum recommended)
Jwt__Secret="replace-with-cryptographically-secure-random-secret-minimum-64-chars"
Security__MasterEncryptionKey="replace-with-cryptographically-secure-256-bit-aes-gcm-master-key"

# 6. Multi-Server Distributed Cache (Memory | Redis)
Cache__Provider="Memory"
Redis__ConnectionString=""
Redis__InstanceName="OzikolBcc:"

# 7. Tenant Base Domain (e.g. ozikol.cloud in production, localhost:4200 in local dev)
TenantSettings__BaseDomain="localhost:4200"

# 8. Cloud Error Telemetry (Sentry)
SENTRY_DSN=""

# 9. OneSignal Push Notifications
ONESIGNAL_APP_ID=""
ONESIGNAL_REST_API_KEY=""

# 10. AI Studio & Section Extractor Gateway
HTML_EXTRACTOR_API_URL="https://ai.ozikol.cloud"
AI_GATEWAY_URL="https://ai.ozikol.cloud"

# 11. Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 12. MongoDB Central System Logs (Optional)
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_URI=""
MONGODB_LOGS_CONNECTION_STRING=""
MONGODB_LOGS_DATABASE="OzikolLogsDb"
MONGODB_LOGS_COLLECTION="central_system_logs"

