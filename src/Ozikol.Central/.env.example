# ===================================================================
# Ozikol.Central Environment Configuration Template (.env.example)
# Copy this file to .env and populate bootstrap values for your environment.
# ===================================================================

# 1. Master Catalog SQL Server Database
TenantConfiguration__ConnectionString="Server=localhost;Database=Ozikol_MasterCatalogDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# 2. Cryptographic & Session Secrets (AES-256-GCM + JWT 256-bit)
Security__MasterEncryptionKey="replace-with-cryptographically-secure-256-bit-aes-gcm-master-key"
Jwt__Secret="replace-with-cryptographically-secure-random-secret-minimum-64-chars"

# 3. Multi-Server Distributed Cache (Memory | Redis)
Cache__Provider="Memory"
Redis__ConnectionString=""
Redis__InstanceName="OzikolBcc:"

# 4. Tenant Base Domain (e.g. ozikol.cloud in production, localhost:4200 in local dev)
TenantSettings__BaseDomain="localhost:4200"

# ===================================================================
# NOTE: Third-party platform service credentials are now managed
# centrally inside the Central Master Catalog Database (MasterPlatformSettings)
# and managed live via Central Works (/centralwks/platform-settings):
#   - Google reCAPTCHA v2 Checkbox (SiteKey, SecretKey)
#   - Postmark Transactional Email (ServerToken, DefaultFrom, FromName)
#   - Cloudinary Media Storage (CloudName, ApiKey, ApiSecret)
#   - Sentry Client Crash Telemetry (SENTRY_DSN)
#   - OneSignal Push Notifications (AppId, RestApiKey)
#   - AI Gateway & HTML Extractor Endpoints
#   - MongoDB Central System Logs
#
# Environment variables for the above can still be provided below to
# override database values in specialized/isolated testing environments.
# ===================================================================
