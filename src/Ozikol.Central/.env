# Single Master Catalog Database
TenantConfiguration__ConnectionString="Persist Security Info=True;Integrated Security=true;Server=JSS\SQLEXPRESS;Database=Ozikol_MasterCatalogDb;TrustServerCertificate=True;"

# Google reCAPTCHA v2 / v3 Keys
GoogleReCaptcha__SiteKey="6Lfprr4tAAAAAOXnim3_izVKT7om1vBKO6Q7uuRq"
GoogleReCaptcha__SecretKey="6Lfprr4tAAAAAHKvbx8N4Z0EmR29MSCBpt4EyQbt"

# Transactional Email Service (Postmark / SMTP)
EmailSettings__Provider="Postmark"
EmailSettings__ApiKey=""
EmailSettings__FromEmail="noreply@ozikol.cloud"
EmailSettings__FromName="Ozikol Cloud Security"

# Security & Platform Secrets
Jwt__Secret="OzikolEnterpriseMasterCatalogSuperSecretKey2026!#$%"

# Tenant Domain Configuration
# On production: set to your root domain (e.g. ozikol.cloud)
# On local dev:  set to localhost:4200
# This drives generated tenant URLs: https://{tenantKey}.{BaseDomain}
TenantSettings__BaseDomain="localhost:4200"
