# ===================================================================
# Ozikol-BCC.Api Environment Configuration Template (.env.example)
# Copy this file to .env and populate values for your environment.
# ===================================================================

# 1. Master Catalog SQL Server Connection (Resolves Tenant Connection Strings)
TenantConfiguration__ConnectionString="Server=localhost;Database=Ozikol_MasterCatalogDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# 2. JWT Bearer Authentication Keys
Jwt__Issuer="Ozikol-BCC.Api"
Jwt__Audience="Ozikol-BCC.Client"
Jwt__Key="replace-with-cryptographically-secure-random-secret-minimum-64-chars"

# 3. AES-256-GCM Master Encryption Key (Encrypts Tenant ConnectionStrings & Secrets at Rest)
Security__MasterEncryptionKey="replace-with-cryptographically-secure-256-bit-aes-gcm-master-key"

# 4. Distributed Cache & Redis / Valkey Settings
Cache__Provider="Memory"
Redis__ConnectionString=""
Redis__InstanceName="OzikolBcc:"

# 5. Cloudinary Media Storage
CloudinarySettings__CloudName="your-cloudinary-cloud-name"
CloudinarySettings__ApiKey="your-cloudinary-api-key"
CloudinarySettings__ApiSecret="your-cloudinary-api-secret"
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# 6. AWS S3 Storage (Optional)
AwsConfiguration__AWSAccessKey=""
AwsConfiguration__AWSSecretKey=""

# 7. Cloudflare R2 Object Storage & Global CDN
CloudflareR2__AccountId=""
CloudflareR2__AccessKeyId=""
CloudflareR2__SecretAccessKey=""
CloudflareR2__BucketName="ozikol-assets"
CloudflareR2__PublicCdnUrl=""

# 8. Transactional Email & SMS Providers
PostmarkSettings__ServerToken="your-postmark-server-token"
KudiSmsApiKey="your-sms-gateway-api-key"

# 9. Payment Gateways (Paystack / Stripe / Flutterwave)
Paystack__SecretKey="sk_test_your_paystack_secret_key"
Paystack__PublicKey="pk_test_your_paystack_public_key"

# 10. Google reCAPTCHA Keys
GoogleReCaptcha__SiteKey="your-google-recaptcha-site-key"
GoogleReCaptcha__SecretKey="your-google-recaptcha-secret-key"

# 11. MongoDB System Telemetry Logs (Optional)
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_URI=""
MONGODB_LOGS_CONNECTION_STRING=""
MONGODB_LOGS_DATABASE="OzikolLogsDb"
MONGODB_LOGS_COLLECTION="central_system_logs"

