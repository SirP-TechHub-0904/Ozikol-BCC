# ============================================================
# Ozikol HTML Extractor — environment variables
# Copy this file to .env and fill in your values
# ============================================================

# Server settings
HOST=0.0.0.0
PORT=8001
DEBUG=false

# CORS — comma-separated origins allowed to call this API
# Use * to allow all (fine for local dev, restrict in production)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000

# ============================================================
# Cloudinary — required for Phase 3 (CDN upload)
# Sign up free at https://cloudinary.com
# Find these values in your Cloudinary Dashboard > Settings > API Keys
# ============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Crawl limits
MAX_PAGES=100
REQUEST_TIMEOUT=20
MAX_CONCURRENT_REQUESTS=10
