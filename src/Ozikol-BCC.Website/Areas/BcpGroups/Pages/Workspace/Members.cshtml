@page "{id:guid}"
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Workspace.MembersModel
@attribute [Authorize]
@{
    ViewData["Title"] = Model.Group.Title + " Members";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Group Workspace",
    Title = Model.Group.Title + " Members",
    Subtitle = "Member directory for " + Model.Group.Title + " (" + Model.Members.Count + " members)",
    Icon = "group",
    BackUrl = "/BcpGroups/Workspace/Chat/" + Model.Group.Id,
    BackText = "Back to Chat"
})

<section class="m3-card bcp-card">
    <div class="bcp-table-wrap">
        <table class="bcp-table">
            <thead>
                <tr>
                    <th>Member Name</th>
                    <th>Email</th>
                    <th>Group Role</th>
                    <th>Presence</th>
                    <th>Joined</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td><strong>@m.UserProfile?.FullName</strong></td>
                        <td>@m.UserProfile?.Email</td>
                        <td><span class="badge bg-light text-primary">@m.GroupRole</span></td>
                        <td><span class="badge bg-light text-dark">@m.PresenceStatus</span></td>
                        <td>@m.DateJoined.ToString("MMM dd, yyyy")</td>
                        <td class="bcp-table-actions">
                            @if (m.UserProfileId != Model.CurrentUserId)
                            {
                                <a class="console-btn primary" href="/BcpGroups/Workspace/DirectMessage/@Model.Group.Id/@m.UserProfileId">
                                    <span class="material-symbols-outlined">chat_bubble</span>Send DM
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
