@page
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Workspace.BookmarksModel
@attribute [Authorize]
@{
    ViewData["Title"] = "My Saved Bookmarks";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "My Workspace",
    Title = "Saved Message Bookmarks",
    Subtitle = "Personal archive of saved messages across all your committees and groups.",
    Icon = "bookmark",
    BackUrl = "/BcpGroups/Workspace/Dashboard",
    BackText = "My Groups"
})

<section class="m3-card bcp-card">
    <div class="bcp-table-wrap">
        <table class="bcp-table">
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Author</th>
                    <th>Saved Content</th>
                    <th>Date Saved</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Bookmarks.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">You have no bookmarked messages yet. Click bookmark on any message to save it here.</td></tr>
                }
                @foreach (var b in Model.Bookmarks)
                {
                    <tr>
                        <td><span class="badge bg-light text-primary">@b.Group?.Title</span></td>
                        <td><strong>@b.Message?.UserProfile?.FullName</strong></td>
                        <td><p class="mb-0 text-truncate" style="max-width: 350px;">@b.Message?.Content</p></td>
                        <td><small class="text-muted">@b.BookmarkedAt.ToString("MMM dd, yyyy")</small></td>
                        <td class="bcp-table-actions">
                            <a class="console-btn primary" href="/BcpGroups/Workspace/Chat/@b.GroupId">
                                <span class="material-symbols-outlined">arrow_forward</span>Jump to Chat
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
