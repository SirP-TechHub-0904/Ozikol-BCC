@page "{groupId:guid}"
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Workspace.GroupSettingsModel
@attribute [Authorize]
@{
    ViewData["Title"] = Model.Group.Title + " Preferences";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "My Workspace",
    Title = Model.Group.Title + " Preferences",
    Subtitle = "Customize notification tones, volume, and privacy settings specifically for " + Model.Group.Title,
    Icon = "tune",
    BackUrl = "/BcpGroups/Workspace/Chat/" + Model.Group.Id,
    BackText = "Back to Chat"
})

<form method="post" class="m3-card bcp-card" style="width: 100%; max-width: 100%; box-sizing: border-box; overflow-x: hidden;">
    <h3 class="bcp-section-title"><span class="material-symbols-outlined">notifications</span> Group Notifications</h3>
    <div class="bcp-form-grid">
        <label class="bcp-field">
            Notification Tone
            <select class="bcp-input bcp-select" id="toneSelect" asp-for="Member.NotificationTone" onchange="playTonePreview()">
                <option value="default">Default Tone (Chime)</option>
                <option value="chime">Chime</option>
                <option value="bell">Bell</option>
                <option value="pop">Pop</option>
                <option value="ding">Ding</option>
            </select>
        </label>

        <label class="bcp-field">
            Volume (0 - 100)
            <input class="bcp-input" id="volumeInput" asp-for="Member.NotificationVolume" type="range" min="0" max="100" oninput="playTonePreview()" />
        </label>

        <div class="bcp-field-full mt-2">
            <label class="bcp-check">
                <input type="checkbox" asp-for="Member.IsNotificationMuted" />
                <span>Mute all notifications for this group</span>
            </label>
        </div>
    </div>

    <h3 class="bcp-section-title mt-4"><span class="material-symbols-outlined">lock</span> Group Privacy Settings</h3>
    <div class="bcp-form-grid">
        <div class="bcp-field-full d-flex flex-wrap gap-3 mt-2" style="max-width: 100%; box-sizing: border-box;">
            <label class="bcp-check">
                <input type="checkbox" asp-for="Member.ShowMyReadReceipts" />
                <span>Send Read Receipts (Blue Ticks) in this group</span>
            </label>
            <label class="bcp-check">
                <input type="checkbox" asp-for="Member.ShowMyTyping" />
                <span>Show my Typing status to group members</span>
            </label>
            <label class="bcp-check">
                <input type="checkbox" asp-for="Member.ShowMyLastSeen" />
                <span>Show my "Last Seen" timestamp in this group</span>
            </label>
        </div>
    </div>

    <div class="bcp-form-actions mt-4">
        <button class="console-btn primary bcp-form-submit" type="submit">
            <span class="material-symbols-outlined">save</span> Save Group Preferences
        </button>
        <a class="console-btn secondary" href="/BcpGroups/Workspace/Chat/@Model.Group.Id">Back to Chat</a>
    </div>
</form>

@section Scripts {
    <script>
        let audioCtx = null;

        function playTonePreview() {
            const tone = document.getElementById('toneSelect').value;
            const volume = parseInt(document.getElementById('volumeInput').value || '80', 10) / 100;

            if (volume <= 0) return;

            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (tone === 'pop') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, now);
                osc.frequency.exponentialRampToValueAtTime(200, now + 0.08);
                gain.gain.setValueAtTime(volume * 0.4, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                osc.start(now);
                osc.stop(now + 0.08);
            } else if (tone === 'bell') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, now); // A5
                gain.gain.setValueAtTime(volume * 0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
                osc.start(now);
                osc.stop(now + 0.6);
            } else if (tone === 'ding') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(1046.5, now); // C6
                gain.gain.setValueAtTime(volume * 0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            } else {
                // Chime / Default (Two-tone arpeggio)
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.setValueAtTime(659.25, now + 0.1); // E5
                gain.gain.setValueAtTime(volume * 0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            }
        }
    </script>
}
