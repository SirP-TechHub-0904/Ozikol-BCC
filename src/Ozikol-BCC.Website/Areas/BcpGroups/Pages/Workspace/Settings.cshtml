@page
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Workspace.SettingsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Global Chat Preferences";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "My Workspace",
    Title = "Platform Chat Preferences",
    Subtitle = "Configure default notification tones, volume, presence status, and global chat privacy.",
    Icon = "settings",
    BackUrl = "/BcpGroups/Workspace/Dashboard",
    BackText = "Dashboard"
})

<form method="post" class="m3-card bcp-card" style="width: 100%; max-width: 100%; box-sizing: border-box; overflow-x: hidden;">
    <h3 class="bcp-section-title"><span class="material-symbols-outlined">account_circle</span> Presence & Status</h3>
    <div class="bcp-form-grid">
        <label class="bcp-field">
            Default Presence On Login
            <select class="bcp-input bcp-select" asp-for="Setting.DefaultPresence" asp-items="Html.GetEnumSelectList<Ozikol_BCC.Domain.Enum.Enum.BcpPresenceStatus>()"></select>
        </label>
        <label class="bcp-field">
            Auto-Away Inactivity Timeout (minutes)
            <input class="bcp-input" asp-for="Setting.AutoAwayMinutes" type="number" />
        </label>
    </div>

    <h3 class="bcp-section-title mt-4"><span class="material-symbols-outlined">volume_up</span> Notification Audio</h3>
    <div class="bcp-form-grid">
        <label class="bcp-field">
            Default Notification Tone
            <select class="bcp-input bcp-select" asp-for="Setting.DefaultTone">
                <option value="default">Default Tone</option>
                <option value="chime">Chime</option>
                <option value="bell">Bell</option>
                <option value="pop">Pop</option>
            </select>
        </label>
        <label class="bcp-field">
            Master Volume (0 - 100)
            <input class="bcp-input" asp-for="Setting.DefaultVolume" type="range" min="0" max="100" />
        </label>
        <div class="bcp-field-full mt-2">
            <label class="bcp-check">
                <input type="checkbox" asp-for="Setting.GlobalMute" />
                <span>Master Mute (Silence all chat notifications platform-wide)</span>
            </label>
        </div>
    </div>

    <h3 class="bcp-section-title mt-4"><span class="material-symbols-outlined">shield</span> Global Privacy</h3>
    <div class="bcp-form-grid">
        <div class="bcp-field-full d-flex flex-wrap gap-3 mt-2" style="max-width: 100%; box-sizing: border-box;">
            <label class="bcp-check">
                <input type="checkbox" asp-for="Setting.GlobalReadReceipts" />
                <span>Send Read Receipts globally (Blue ticks)</span>
            </label>
            <label class="bcp-check">
                <input type="checkbox" asp-for="Setting.GlobalTypingIndicator" />
                <span>Show Typing Status globally</span>
            </label>
            <label class="bcp-check">
                <input type="checkbox" asp-for="Setting.GlobalLastSeen" />
                <span>Show "Last Seen" timestamp globally</span>
            </label>
        </div>
    </div>

    <div class="bcp-form-actions mt-4">
        <button class="console-btn primary bcp-form-submit" type="submit">
            <span class="material-symbols-outlined">save</span> Save Preferences
        </button>
        <a class="console-btn secondary" href="/BcpGroups/Workspace/Dashboard">Cancel</a>
    </div>
</form>
