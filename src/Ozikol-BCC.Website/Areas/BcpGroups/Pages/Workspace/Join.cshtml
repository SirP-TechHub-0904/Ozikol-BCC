@page
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Workspace.JoinModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = Model.Group != null ? Model.Group.Title + " - Group Invitation" : "Group Invitation";
    var canonicalUrl = $"{Request.Scheme}://{Request.Host}{Request.Path}{Request.QueryString}";
}

@section Meta {
    @if (Model.Group != null)
    {
        <meta property="og:title" content="@Model.Group.Title - Ozikol BCP Group Space" />
        <meta property="og:description" content="@(string.IsNullOrWhiteSpace(Model.Group.Description) ? "Join this group workspace on Ozikol BCP." : Model.Group.Description)" />
        <meta property="og:image" content="@Model.GroupCoverUrl" />
        <meta property="og:url" content="@canonicalUrl" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Ozikol BCP Platform" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@Model.Group.Title" />
        <meta name="twitter:description" content="@(string.IsNullOrWhiteSpace(Model.Group.Description) ? "Join this group workspace on Ozikol BCP." : Model.Group.Description)" />
        <meta name="twitter:image" content="@Model.GroupCoverUrl" />
    }
}

<div style="width: 100%; max-width: 580px; margin: 40px auto; padding: 0 16px; box-sizing: border-box;">
    
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="m3-card" style="padding: 36px 28px; border-radius: 20px; border: 1px solid var(--md-sys-color-outline-variant); box-shadow: 0 12px 36px rgba(0,0,0,0.08); text-align: center; background: var(--md-sys-color-surface);">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239,68,68,0.12); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
                <span class="material-symbols-outlined" style="font-size: 32px; color: #ef4444;">error</span>
            </div>
            <h2 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: var(--md-sys-color-on-surface);">Invitation Unavailable</h2>
            <p style="margin: 0 0 24px 0; font-size: 14.5px; color: var(--sidebar-color); line-height: 1.5;">@Model.Message</p>
            <a class="console-btn primary" href="/BcpGroups/Workspace/Dashboard" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 10px; font-size: 14.5px; font-weight: 600;">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Go to My Groups</span>
            </a>
        </div>
    }
    else
    {
        @* ── WhatsApp / Social Media Link Preview Card ────────────────── *@
        <div class="m3-card" style="border-radius: 20px; border: 1px solid var(--md-sys-color-outline-variant); box-shadow: 0 14px 40px rgba(0,0,0,0.08); overflow: hidden; background: var(--md-sys-color-surface); transition: transform 0.2s ease;">
            
            @* Background Cover Image Banner *@
            <div style="position: relative; width: 100%; height: 160px; background-image: url('@Model.GroupCoverUrl'); background-size: cover; background-position: center; border-bottom: 1px solid var(--md-sys-color-outline-variant);">
                <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.65) 100%);"></div>
                
                @* Category Badge *@
                <div style="position: absolute; top: 14px; right: 14px; padding: 4px 12px; border-radius: 20px; background: rgba(0,0,0,0.55); backdrop-filter: blur(8px); color: white; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; gap: 4px;">
                    <span class="material-symbols-outlined" style="font-size: 14px;">hub</span>
                    <span>@Model.Group.GroupType</span>
                </div>
            </div>

            @* Body Content Container *@
            <div style="padding: 0 24px 28px 24px; position: relative;">
                
                @* Profile Avatar Overlay *@
                <div style="margin-top: -46px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-end;">
                    <div style="width: 84px; height: 84px; border-radius: 20px; border: 4px solid var(--md-sys-color-surface); background-image: url('@Model.GroupAvatarUrl'); background-size: cover; background-position: center; box-shadow: 0 8px 24px rgba(0,0,0,0.12); flex-shrink: 0;"></div>
                    
                    @* Member Count Pill *@
                    <div style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 30px; background: var(--md-sys-color-surface-container-low); border: 1px solid var(--md-sys-color-outline-variant); font-size: 13px; font-weight: 700; color: var(--md-sys-color-on-surface);">
                        <span class="material-symbols-outlined" style="font-size: 16px; color: var(--md-sys-color-primary);">group</span>
                        <span>@Model.MemberCount Member@(Model.MemberCount == 1 ? "" : "s")</span>
                    </div>
                </div>

                @* Title & Subtitle *@
                <h1 style="margin: 0 0 8px 0; font-size: 24px; font-weight: 800; color: var(--md-sys-color-on-surface); line-height: 1.25;">@Model.Group.Title</h1>
                
                <p style="margin: 0 0 20px 0; font-size: 14.5px; color: var(--sidebar-color); line-height: 1.55; word-break: break-word;">
                    @(string.IsNullOrWhiteSpace(Model.Group.Description) ? "Join this collaboration group on Ozikol BCP to chat, share files, and collaborate in real-time." : Model.Group.Description)
                </p>

                @* Source Domain Badge *@
                <div style="display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px; background: var(--md-sys-color-surface-container-low); border: 1px solid var(--md-sys-color-outline-variant); margin-bottom: 24px; font-size: 12.5px; color: var(--sidebar-color);">
                    <span class="material-symbols-outlined" style="font-size: 18px; color: #2563eb;">language</span>
                    <span style="font-weight: 600; color: var(--md-sys-color-on-surface);">ozikol-bcc.com</span>
                    <span style="opacity: 0.5;">•</span>
                    <span>Official Group Space</span>
                </div>

                @* Action Buttons *@
                <div style="display: grid; gap: 12px;">
                    @if (Model.IsAlreadyMember)
                    {
                        <a href="/BcpGroups/Workspace/Chat/@Model.Group.Id" class="console-btn primary"
                           style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; font-size: 15.5px; font-weight: 700; border-radius: 12px; text-decoration: none; width: 100%; box-sizing: border-box; background: #2563eb; color: white;">
                            <span class="material-symbols-outlined" style="font-size: 22px;">chat_bubble</span>
                            <span>Open Real-Time Chatroom</span>
                        </a>
                    }
                    else if (Model.IsUserLoggedIn)
                    {
                        <form method="post" asp-page-handler="Join" style="margin: 0;">
                            <button type="submit" class="console-btn primary"
                                    style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; font-size: 15.5px; font-weight: 700; border-radius: 12px; width: 100%; box-sizing: border-box; background: #10b981; color: white; border: none; cursor: pointer;">
                                <span class="material-symbols-outlined" style="font-size: 22px;">group_add</span>
                                <span>Join Group Now</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a href="/BcpIdentity/Authenticate/Login?returnUrl=@(Uri.EscapeDataString($"/BcpGroups/Workspace/Join?id={Model.Group.Id}"))" class="console-btn primary"
                           style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; font-size: 15.5px; font-weight: 700; border-radius: 12px; text-decoration: none; width: 100%; box-sizing: border-box; background: #2563eb; color: white;">
                            <span class="material-symbols-outlined" style="font-size: 22px;">login</span>
                            <span>Sign In to Join Group</span>
                        </a>
                    }

                    <button type="button" onclick="copyShareUrl()" class="console-btn secondary"
                            style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 11px; font-size: 13.5px; font-weight: 600; border-radius: 10px; border: 1px solid var(--md-sys-color-outline); background: transparent; color: var(--md-sys-color-on-surface); cursor: pointer;">
                        <span class="material-symbols-outlined" style="font-size: 18px;">share</span>
                        <span id="copyBtnTxt">Copy Invitation Link</span>
                    </button>
                </div>

            </div>
        </div>
    }

</div>

<script>
    function copyShareUrl() {
        navigator.clipboard.writeText(window.location.href).then(() => {
            const txt = document.getElementById('copyBtnTxt');
            if (txt) {
                txt.textContent = 'Link Copied to Clipboard!';
                setTimeout(() => { txt.textContent = 'Copy Invitation Link'; }, 3000);
            }
        });
    }
</script>
