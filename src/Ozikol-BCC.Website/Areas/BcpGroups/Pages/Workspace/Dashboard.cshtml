@page
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Workspace.DashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "My Groups";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "My Workspace",
    Title = "My Collaboration Groups",
    Subtitle = "Personal portal for real-time chat, shared media, personal bookmarks, and direct messages.",
    Icon = "diversity_3",
    BackUrl = "/BcpWorkspace/Workspace/Dashboard",
    Buttons =
    [
        new("Pending Invitations", "/BcpGroups/Workspace/Invitations", "mail"),
        new("My Bookmarks", "/BcpGroups/Workspace/Bookmarks", "bookmark"),
        new("Chat Settings", "/BcpGroups/Workspace/Settings", "settings")
    ]
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div style="padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px; font-size:14px; margin-bottom:20px; display:flex; align-items:center; gap:8px;">
        <span class="material-symbols-outlined" style="font-size:20px;">info</span>
        <span>@Model.StatusMessage</span>
    </div>
}

<section class="console-grid" style="width:100%;">
    @* ── Row 1: Personal Activity Metric Cards (full width) ── *@
    <article class="console-widget span-12" data-widget="personal-metrics">
        <div class="widget-body">
            <div class="metric-grid">
                <a class="metric-card" href="/BcpGroups/Workspace/Dashboard">
                    <div class="metric-label">My Joined Groups</div>
                    <div class="metric-value">@Model.JoinedGroupsCount</div>
                    <div class="metric-note">Enrolled workspaces</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Workspace/Dashboard">
                    <div class="metric-label">Unread Messages</div>
                    <div class="metric-value text-danger">@Model.TotalUnreadCount</div>
                    <div class="metric-note">Across all groups</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Workspace/Bookmarks">
                    <div class="metric-label">Saved Bookmarks</div>
                    <div class="metric-value text-primary">@Model.SavedBookmarksCount</div>
                    <div class="metric-note">Bookmarked messages</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Workspace/Dashboard">
                    <div class="metric-label">Active DMs</div>
                    <div class="metric-value text-success">@Model.ActiveDmsCount</div>
                    <div class="metric-note">1-on-1 conversations</div>
                </a>
            </div>
        </div>
    </article>

    @if (Model.PendingInvitationsCount > 0)
    {
        <article class="console-widget span-12" style="background:#fff8e1; border-left:4px solid #ffc107;">
            <div class="widget-body d-flex justify-content-between align-items-center">
                <div>
                    <strong class="text-warning-emphasis"><span class="material-symbols-outlined align-middle me-1">mail</span> Pending Invitations</strong>
                    <p class="mb-0 small text-muted">You have @Model.PendingInvitationsCount pending group invitations awaiting your response.</p>
                </div>
                <a href="/BcpGroups/Workspace/Invitations" class="console-btn primary">Review Invitations</a>
            </div>
        </article>
    }

    @* ── Row 2: My Groups — responsive card grid (full width) ── *@
    @if (!Model.MyGroups.Any())
    {
        <article class="console-widget span-12 text-center py-5">
            <span class="material-symbols-outlined text-primary mb-2" style="font-size:48px;">groups</span>
            <h3>No Groups Joined Yet</h3>
            <p class="text-muted">You are not currently enrolled in any committees or workspace groups.</p>
            <a href="/BcpGroups/Workspace/Invitations" class="console-btn primary" style="padding:0 24px;">Check Pending Invitations</a>
        </article>
    }
    else
    {
        <div class="span-12" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:16px; width:100%;">
            @foreach (var g in Model.MyGroups)
            {
                <article class="console-widget" data-widget="group-card-@g.GroupId" style="grid-column:span 1;">
                    @* Cover banner *@
                    @if (!string.IsNullOrWhiteSpace(g.CoverImageUrl))
                    {
                        <div style="height:100px; overflow:hidden; border-radius:8px 8px 0 0;">
                            <img src="@g.CoverImageUrl" alt="@g.Title cover" style="width:100%; height:100%; object-fit:cover;" />
                        </div>
                    }
                    else
                    {
                        <div style="height:56px; background:linear-gradient(135deg, var(--sidebar-active-color), #60a5fa); border-radius:8px 8px 0 0;"></div>
                    }

                    <div class="widget-body" style="padding:16px;">
                        @* Title row with avatar *@
                        <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
                            @if (!string.IsNullOrWhiteSpace(g.AvatarUrl))
                            {
                                <img src="@g.AvatarUrl" alt="@g.Title" style="width:40px; height:40px; border-radius:50%; object-fit:cover; border:2px solid var(--md-sys-color-outline); flex-shrink:0;" />
                            }
                            else
                            {
                                <span class="material-symbols-outlined" style="font-size:32px; color:var(--sidebar-active-color);">hub</span>
                            }
                            <div style="min-width:0;">
                                <h3 style="margin:0; font-size:15px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@g.Title</h3>
                                <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:3px;">
                                    <span class="bcp-badge">@g.GroupType</span>
                                    <span class="bcp-badge">Role: @g.MyRole</span>
                                    @if (g.IsCurrentlyOpen)
                                    {
                                        <span class="bcp-badge success">Open</span>
                                    }
                                    else
                                    {
                                        <span class="bcp-badge danger">Closed</span>
                                    }
                                </div>
                            </div>
                            @if (g.UnreadCount > 0)
                            {
                                <span style="margin-left:auto; background:#ef4444; color:#fff; border-radius:999px; padding:2px 10px; font-size:11px; font-weight:800;">@g.UnreadCount</span>
                            }
                        </div>

                        @* Description *@
                        <p style="margin:0 0 12px; font-size:12px; color:var(--sidebar-color); line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                            @(string.IsNullOrWhiteSpace(g.Description) ? "No group description." : g.Description)
                        </p>

                        @* Last message preview *@
                        @if (!string.IsNullOrWhiteSpace(g.LastMessageContent))
                        {
                            <div style="padding:8px 12px; background:var(--md-sys-color-surface-variant); border-radius:8px; border-left:3px solid var(--sidebar-active-color); margin-bottom:12px;">
                                <small style="font-size:10px; color:var(--sidebar-color);">Last Message @(g.LastMessageTime?.ToString("HH:mm MMM dd"))</small>
                                <p style="margin:2px 0 0; font-size:12px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@g.LastMessageContent</p>
                            </div>
                        }

                        @* Footer: member count + Enter Chat *@
                        <div style="display:flex; justify-content:space-between; align-items:center; padding-top:10px; border-top:1px solid var(--md-sys-color-outline);">
                            <span style="font-size:12px; color:var(--sidebar-color); display:inline-flex; align-items:center; gap:4px;">
                                <span class="material-symbols-outlined" style="font-size:16px;">group</span> @g.MemberCount members
                            </span>
                            <a href="/BcpGroups/Workspace/Chat/@g.GroupId" class="console-btn primary" style="padding:0 16px; font-size:12px;">
                                Enter Chat <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    @* ── Row 3: Activity Chart (6) + Bookmarks (6) ── *@
    <article class="console-widget span-6" data-widget="weekly-activity-chart" data-title="My Participation">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-success">equalizer</span>
                <h2 class="widget-title">My Participation This Week</h2>
            </div>
        </div>
        <div class="widget-body">
            <canvas id="weeklyActivityChart" style="max-height:220px;"></canvas>
        </div>
    </article>

    <article class="console-widget span-6" data-widget="recent-bookmarks" data-title="My Bookmarks">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-warning">bookmark</span>
                <h2 class="widget-title">Recent Saved Bookmarks</h2>
            </div>
            <a class="info-link" href="/BcpGroups/Workspace/Bookmarks">View All</a>
        </div>
        <div class="widget-body p-0">
            <ul class="list-group list-group-flush">
                @if (!Model.RecentBookmarks.Any())
                {
                    <li class="list-group-item text-center py-4 text-muted">No saved bookmarks yet. Click bookmark on any message to save it here.</li>
                }
                @foreach (var b in Model.RecentBookmarks)
                {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between">
                            <strong class="small text-primary">@b.Group?.Title</strong>
                            <small class="text-muted">@b.BookmarkedAt.ToString("MMM dd")</small>
                        </div>
                        <p class="mb-1 small text-dark text-truncate">@b.Message?.Content</p>
                        <a href="/BcpGroups/Workspace/Chat/@b.GroupId" class="style-micro text-decoration-none">Jump to Chat →</a>
                    </li>
                }
            </ul>
        </div>
    </article>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const weeklyCtx = document.getElementById('weeklyActivityChart').getContext('2d');
        new Chart(weeklyCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Model.WeeklyDaysJson),
                datasets: [{
                    label: 'Messages Sent by Me',
                    data: @Html.Raw(Model.WeeklyMessagesJson),
                    backgroundColor: '#1cc88a'
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
    </script>
}
