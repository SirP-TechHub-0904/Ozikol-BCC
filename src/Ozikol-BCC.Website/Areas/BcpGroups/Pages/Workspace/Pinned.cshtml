@page "{id:guid}"
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Workspace.PinnedModel
@attribute [Authorize]
@{
    ViewData["Title"] = Model.Group.Title + " Pinned Messages";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Group Workspace",
    Title = "Pinned Messages",
    Subtitle = "Important messages pinned in " + Model.Group.Title,
    Icon = "push_pin",
    BackUrl = "/BcpGroups/Workspace/Chat/" + Model.Group.Id,
    BackText = "Back to Chat"
})

<section class="console-grid">
    @if (!Model.PinnedMessages.Any())
    {
        <article class="console-widget span-12 text-center py-5">
            <span class="material-symbols-outlined text-muted mb-2" style="font-size: 48px;">push_pin</span>
            <h3>No Pinned Messages</h3>
            <p class="text-muted">No messages have been pinned in this group yet.</p>
        </article>
    }
    @foreach (var msg in Model.PinnedMessages)
    {
        <article class="console-widget span-12" style="border-left: 4px solid #ffc107;">
            <div class="widget-head d-flex justify-content-between">
                <strong>@msg.UserProfile?.FullName</strong>
                <small class="text-muted">@msg.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
            <div class="widget-body">
                <p class="mb-0">@msg.Content</p>
            </div>
        </article>
    }
</section>
