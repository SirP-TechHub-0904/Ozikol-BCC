                <span class="material-symbols-outlined" style="font-size:18px;">close</span>
            </button>
        </div>

        <div style="padding:16px; display:flex; flex-direction:column; align-items:center; text-align:center; border-bottom:1px solid var(--md-sys-color-outline);">
