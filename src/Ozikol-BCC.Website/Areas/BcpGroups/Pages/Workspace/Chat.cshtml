                        <span class="bcp-emoji-tab" onclick="switchEmojiTab('animals', event)">🐻</span>
                        <span class="bcp-emoji-tab" onclick="switchEmojiTab('food', event)">🍔</span>
                        <span class="bcp-emoji-tab" onclick="switchEmojiTab('sports', event)">⚽</span>
                        <span class="bcp-emoji-tab" onclick="switchEmojiTab('travel', event)">🚀</span>
                        <span class="bcp-emoji-tab" onclick="switchEmojiTab('objects', event)">💡</span>
                        <span class="bcp-emoji-tab" onclick="switchEmojiTab('flags', event)">🚩</span>
