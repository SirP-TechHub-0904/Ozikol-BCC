    <!-- RIGHT PANEL: Message Info Panel -->
    <div class="bcp-chat-info-panel" id="messageInfoPanel">
        <div class="bcp-chat-info-header">
            <h3 class="bcp-section-title mb-0" style="font-size:14px;">
                <span class="material-symbols-outlined" style="font-size:18px; color:var(--sidebar-active-color);">info</span>
