            travel: ["🚗","🚕","🚙","🚌","🚎","🏎️","🚓","🚑","🚒","🚐","🛻","🚚","🚛","🚜","🛵","🏍️","🛺","🚨","🚔","🚍","🚘","🚖","🚡","🚠","🚟","🚃","🚋","🚝","🚄","🚅","🚆","🚇","🛳️","✈️","🛫","🛬","🚁","🛸","🚀","🛰️","⛵","🚤","🛥️","⚓","🏗️","🏭","🏢","🏬","🏦","🏨","🏪","🏫","🏩","💒","🏛️","🕌","🛕","🕍","⛩️"],
            objects: ["⌚","📱","📲","💻","⌨️","🖥️","🖨️","🖱️","🖲️","<ctrl42>","🗜️","💽","💾","💿","📀","📼","📷","📸","📹","🎥","📽️","🎞️","📞","☎️","📟","📠","📺","📻","🎙️","🎚️","🎛️","🧭","⏱️","⏲️","⏰","🕰️","⌛","⏳","📡","🔋","🔌","💡","🔦","🕯️","🧯","🗑️","🛢️","💸","💵","💴","💶","💷","🪙","💰","💳","💎","⚖️","🧰","🔧","🔨","⚒️","🛠️","⛏️","🔩","⚙️","🧱","⛓️","🧲","🔫","💣","🔪","🗡️","⚔️","🛡️","🚬","⚰️","🪦","⚱️","🏺","🔮","📿","🧿","💈"],
            flags: ["🏁","🚩","🎌","🏴","🏳️","🏳️‍🌈","🏳️‍⚧️","🏴‍☠️","🇳🇬","🇺🇸","🇬🇧","🇨🇦","🇦🇺","🇩🇪","🇫🇷","🇯🇵","🇨🇳","🇮🇳","🇧🇷","🇿🇦","🇲🇽","🇪🇸","🇮🇹","🇷🇺","🇰🇷","🇸🇦","🇦🇪","🇪🇬","🇰🇪","🇬🇭"]
        };

        function renderEmojiGrid(emojis) {
            const grid = document.getElementById('emojiGrid');
            if (!grid) return;
            let html = '';
            emojis.forEach(e => {
                html += `<span class="bcp-emoji-cell" onclick="insertEmoji('${e}')">${e}</span>`;
            });
            grid.innerHTML = html;
        }
        renderEmojiGrid(emojiCategories.smileys);

        // Accept event as second parameter to avoid relying on the global `event` object
        function switchEmojiTab(catKey, ev) {
            document.querySelectorAll('.bcp-emoji-tab').forEach(t => t.classList.remove('active'));
            try {
                if (ev && ev.target) ev.target.classList.add('active');
            } catch (e) {
                // ignore
            }
            if (emojiCategories[catKey]) {
                renderEmojiGrid(emojiCategories[catKey]);
            }
        }

        function filterEmojis(query) {
            if (!query.trim()) {
                renderEmojiGrid(emojiCategories.smileys);
                return;
            }
            const q = query.toLowerCase();
            let all = [];
            Object.values(emojiCategories).forEach(list => all = all.concat(list));
            renderEmojiGrid(all);
        }

        // WhatsApp Persistent Multi-Emoji Selection
        function insertEmoji(char) {
            const modalCap = document.getElementById('modalCaptionInput');
            const mainCap = document.getElementById('messageInput');
            const whatsappModal = document.getElementById('whatsappMediaModal');
            if (whatsappModal && whatsappModal.style && whatsappModal.style.display === 'flex' && modalCap) {
                modalCap.value += char;
                modalCap.focus();
            } else if (mainCap) {
                mainCap.value += char;
                mainCap.focus();
            }
        }

