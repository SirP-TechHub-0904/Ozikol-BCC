                        const sizeKb = Math.round(f.fileSize / 1024);
                        html += `
                            <div style="display:flex; align-items:center; justify-content:space-between; padding:10px; background:var(--md-sys-color-surface-variant); border-radius:8px;">
                                <div style="display:flex; align-items:center; gap:8px; overflow:hidden;">
                                    <span class="material-symbols-outlined">description</span>
                                    <div style="overflow:hidden;">
                                        <a href="${f.fileUrl}" target="_blank" style="font-size:13px; font-weight:600; text-decoration:none; color:var(--sidebar-active-color); display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${f.fileName}</a>
                                        <small style="font-size:11px; opacity:0.8;">${sizeKb} KB • ${f.uploadedByUserName || 'User'}</small>
                                    </div>
                                </div>
                                <a href="${f.fileUrl}" target="_blank" download class="console-btn secondary" style="padding:4px 8px; min-height:auto; font-size:11px;">Download</a>
                            </div>`;
                    });
                    html += '</div>';
                    document.getElementById('sharedFilesContent').innerHTML = html;
                }).catch(() => {
                    document.getElementById('sharedFilesContent').innerHTML = `<div style="padding:10px; font-size:12px; color:var(--sidebar-color);">Could not fetch shared files.</div>`;
                });
        }

        function toggleGroupInfoDrawer() {
            const panel = document.getElementById('groupInfoPanel');
            const isOpen = panel.classList.contains('open');
            closeAllDrawers();
            if (!isOpen) {
                panel.style.display = 'flex';
                panel.classList.add('open');
                document.getElementById('drawerBackdrop').style.display = 'block';
            }
        }

        function openMemberProfileDrawer(userId, name, presence, role) {
            closeAllDrawers();
            const panel = document.getElementById('memberProfilePanel');
            const content = document.getElementById('memberProfileContent');
            panel.style.display = 'flex';
            panel.classList.add('open');
            document.getElementById('drawerBackdrop').style.display = 'block';

            const initial = name ? name.charAt(0) : '?';
            const dmUrl = `/BcpGroups/Workspace/DirectMessage/${groupId}/${userId}`;
            const isMe = userId === currentUserId;

            content.innerHTML = `
                <div style="width:80px; height:80px; border-radius:50%; margin:0 auto 14px; background:#2563eb; color:#ffffff; font-size:32px; font-weight:700; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 14px rgba(0,0,0,0.15);">
                    ${initial}
                </div>
                <h3 style="margin:0 0 4px; font-size:17px; font-weight:700;">${name}</h3>
                ${role ? `<span class="bcp-badge ${role === 'Admin' ? 'danger' : 'success'}" style="font-size:11px; padding:2px 8px; margin-bottom:10px;">${role}</span>` : ''}
                <small style="color:var(--sidebar-color); font-size:12px; display:block; margin-bottom:16px;">Presence: ${presence || 'Online'}</small>

                <div style="width:100%; background:var(--md-sys-color-surface-variant); border-radius:10px; padding:12px; margin-bottom:20px; text-align:left; font-size:12px; display:flex; flex-direction:column; gap:6px;">
                    <div style="display:flex; justify-content:space-between;">
                        <span style="color:var(--sidebar-color);">User ID:</span>
                        <span style="font-family:monospace; font-size:11px;">${userId ? userId.substring(0, 8) : ''}…</span>
                    </div>
                    <div style="display:flex; justify-content:space-between;">
                        <span style="color:var(--sidebar-color);">Status:</span>
                        <strong style="color:var(--sidebar-active-color);">${presence || 'Active member'}</strong>
                    </div>
                </div>

                ${!isMe ? `
                    <button type="button" onclick="switchToDirectMessage('${userId}', '${name.replace("'", "\\'")}', '${presence}')" class="console-btn primary" style="width:100%; justify-content:center; padding:10px; border-radius:8px; font-size:13px;">
                        <span class="material-symbols-outlined" style="font-size:18px; margin-right:6px;">chat</span> Send Direct Message
                    </button>
                ` : '<div style="font-size:12px; color:var(--sidebar-color); font-style:italic;">This is your profile</div>'}
            `;
        }

        function toggleMembersDrawer() {
            const container = document.querySelector('.bcp-chat-container');
            const drawer = document.getElementById('membersDrawer');
            if (window.innerWidth > 1024) {
                if (container) container.classList.toggle('members-collapsed');
            } else {
                const isOpen = drawer.classList.contains('open');
                closeAllDrawers();
                if (!isOpen) {
                    drawer.classList.add('open');
                    document.getElementById('drawerBackdrop').style.display = 'block';
                }
            }
        }

        function closeAllDrawers() {
            document.querySelectorAll('.bcp-chat-info-panel').forEach(p => { p.classList.remove('open'); p.style.display = 'none'; });
            document.getElementById('membersDrawer').classList.remove('open');
            document.getElementById('drawerBackdrop').style.display = 'none';
        }

        // Member Search Filter
        const _memberSearchInput = document.getElementById('memberSearchInput');
        if (_memberSearchInput) {
            _memberSearchInput.addEventListener('input', function(e) {
                const query = e.target.value.toLowerCase();
                document.querySelectorAll('.member-item').forEach(item => {
                    const name = item.getAttribute('data-name')?.toLowerCase() || '';
                    item.style.display = name.includes(query) ? 'flex' : 'none';
                });
            });
        }

        // ──────────────────────────────────────────────
        //  UNIFIED SINGLE WORKSPACE CONVERSATION SWITCHER (OPTION 1)
        // ──────────────────────────────────────────────
        let activeChatType = 'group'; // 'group' or 'dm'
        let activeDmUserId = null;
        let activeDmUserName = '';
        let activeDmUserPresence = 'Online';

        function handleTopbarHeaderClick() {
            if (activeChatType === 'dm' && activeDmUserId) {
                openMemberProfileDrawer(activeDmUserId, activeDmUserName, activeDmUserPresence, '');
            } else {
                toggleGroupInfoDrawer();
            }
        }

        function switchToGroupChat() {
            activeChatType = 'group';
            activeDmUserId = null;
            if (window.innerWidth <= 1024) closeAllDrawers();

            if (window.history && window.history.pushState) {
                window.history.pushState({ type: 'group' }, '', `/BcpGroups/Workspace/Chat/${groupId}`);
            }

            const groupBtn = document.getElementById('btnGroupMainChat');
            if (groupBtn) {
                groupBtn.classList.add('primary');
                groupBtn.classList.remove('secondary');
            }
            document.querySelectorAll('.bcp-chat-member-item').forEach(el => el.classList.remove('active'));

            const avatarBox = document.getElementById('topbarAvatarContainer');
            const titleBox = document.getElementById('topbarTitleText');
            const subBox = document.getElementById('typingIndicatorText');

            if (avatarBox) {
                if (groupAvatarUrl) {
                    avatarBox.innerHTML = `<img src="${escapeHtml(groupAvatarUrl)}" class="bcp-avatar-circle lg" style="object-fit:cover;" alt="${escapeHtml(groupTitle)}" />`;
                } else {
                    avatarBox.innerHTML = `<div class="bcp-avatar-circle lg" style="display:flex; align-items:center; justify-content:center;"><span class="material-symbols-outlined" style="font-size:24px; color:var(--sidebar-active-color);">groups</span></div>`;
                }
            }
            if (titleBox) titleBox.textContent = groupTitle;
            if (subBox) subBox.textContent = groupModeText;

            window.location.href = `/BcpGroups/Workspace/Chat/${groupId}`;
        }

        function switchToDirectMessage(userId, userName, presence) {
            activeChatType = 'dm';
            activeDmUserId = userId;
            activeDmUserName = userName;
            activeDmUserPresence = presence;
            if (window.innerWidth <= 1024) closeAllDrawers();

            if (window.history && window.history.pushState) {
                window.history.pushState({ type: 'dm', userId: userId }, '', `/BcpGroups/Workspace/Chat/${groupId}?dmUserId=${userId}`);
            }

            const groupBtn = document.getElementById('btnGroupMainChat');
            if (groupBtn) {
                groupBtn.classList.remove('primary');
                groupBtn.classList.add('secondary');
            }
            document.querySelectorAll('.bcp-chat-member-item').forEach(el => el.classList.remove('active'));
            const item = document.querySelector(`.bcp-chat-member-item[data-userid="${userId}"]`);
            if (item) item.classList.add('active');

            const avatarBox = document.getElementById('topbarAvatarContainer');
            const titleBox = document.getElementById('topbarTitleText');
            const subBox = document.getElementById('typingIndicatorText');

            const initial = userName ? userName.charAt(0) : '?';
            const statusClass = (presence || 'online').toLowerCase();
            if (avatarBox) {
                avatarBox.innerHTML = `<div class="bcp-avatar-circle lg status-${statusClass}" style="display:flex; align-items:center; justify-content:center; position:relative;">${initial}<span class="presence-dot presence-${statusClass}"></span></div>`;
            }
            if (titleBox) titleBox.textContent = userName;
            if (subBox) subBox.textContent = `Direct Message • ${groupTitle}`;

            loadDirectMessages(userId);
        }

        function loadDirectMessages(userId) {
            const container = document.getElementById('chatMessagesContainer');
            if (!container) return;
            container.innerHTML = `
                <div style="text-align:center; padding:24px 0; color:var(--sidebar-color); font-size:12px;">
                    <span class="material-symbols-outlined" style="font-size:24px; vertical-align:middle; color:#2563eb;">lock</span>
                    End-to-End Direct Message thread with <strong>${activeDmUserName}</strong>
                </div>
                <div style="text-align:center; padding:20px 0; color:var(--sidebar-color); font-size:12px;">Loading messages...</div>
            `;

            fetch(`/api/groups/dm/${groupId}/${userId}`)
                .then(res => res.json())
                .then(messages => {
                    container.innerHTML = `
                        <div style="text-align:center; padding:24px 0; color:var(--sidebar-color); font-size:12px;">
                            <span class="material-symbols-outlined" style="font-size:24px; vertical-align:middle; color:#2563eb;">lock</span>
                            End-to-End Direct Message thread with <strong>${activeDmUserName}</strong>
                        </div>
                    `;
                    if (messages && messages.length > 0) {
                        messages.forEach(msg => appendMessage(msg));
                    }
                    scrollBottom();
                })
                .catch(err => {
                    console.error("Fetch DM error:", err);
                    container.innerHTML = `
                        <div style="text-align:center; padding:24px 0; color:var(--sidebar-color); font-size:12px;">
                            <span class="material-symbols-outlined" style="font-size:24px; vertical-align:middle; color:#2563eb;">lock</span>
                            End-to-End Direct Message thread with <strong>${activeDmUserName}</strong>
                        </div>
                    `;
                });
        }

        // Emoji toggle
        const _btnEmojiToggle = document.getElementById('btnEmojiToggle');
        if (_btnEmojiToggle) {
            _btnEmojiToggle.addEventListener('click', () => {
                const picker = document.getElementById('emojiPicker');
                if (picker) picker.style.display = picker.style.display === 'flex' ? 'none' : 'flex';
            });
        }

        // Auto-switch to requested DM on startup if dmUserId query parameter is present
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const targetDmUserId = urlParams.get('dmUserId');
            if (targetDmUserId) {
                const memberEl = document.querySelector(`.bcp-chat-member-item[data-userid="${targetDmUserId}"]`);
                if (memberEl) {
                    const userName = memberEl.getAttribute('data-name') || 'User';
                    const presence = memberEl.querySelector('.presence-text')?.textContent || 'Online';
                    switchToDirectMessage(targetDmUserId, userName, presence);
                }
            }
        });
    </script>
}
