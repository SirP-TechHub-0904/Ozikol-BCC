        function stageFilesForPreview(files) {
            files.forEach(file => {
                const isImg = file.type.startsWith('image/');
                const fileObj = {
                    file: file,
                    name: file.name,
                    size: file.size,
                    type: file.type,
                    isImage: isImg,
                    previewUrl: null
                };
                if (isImg) {
                    fileObj.previewUrl = URL.createObjectURL(file);
                }
                stagedFilesList.push(fileObj);
            });

            activeStagedIndex = stagedFilesList.length - 1;
            renderMediaModal();
            document.getElementById('mediaStagingModal').style.display = 'flex';
        }

        function renderMediaModal() {
            if (stagedFilesList.length === 0) {
                closeMediaModal();
                return;
            }
            if (activeStagedIndex >= stagedFilesList.length) {
                activeStagedIndex = stagedFilesList.length - 1;
            }

            const current = stagedFilesList[activeStagedIndex];
            const centerPreview = document.getElementById('mediaCenterPreview');
            document.getElementById('mediaModalTitle').innerText = `${activeStagedIndex + 1} of ${stagedFilesList.length}`;

            if (current.isImage && current.previewUrl) {
                centerPreview.innerHTML = `<img src="${current.previewUrl}" class="bcp-media-large-img" alt="${current.name}" />`;
            } else {
                const sizeKb = Math.round(current.size / 1024);
                centerPreview.innerHTML = `
                    <div class="bcp-media-file-card">
                        <span class="material-symbols-outlined" style="font-size:56px; color:#25d366;">description</span>
                        <div style="font-size:15px; font-weight:600;">${current.name}</div>
                        <div style="opacity:0.75; font-size:12px;">${sizeKb} KB • ${current.type || 'Document'}</div>
                    </div>`;
            }

            // Render Bottom Carousel Thumbnails
            let thumbsHtml = '';
            stagedFilesList.forEach((item, idx) => {
                const activeCls = idx === activeStagedIndex ? 'active' : '';
                if (item.isImage && item.previewUrl) {
                    thumbsHtml += `
                        <div class="bcp-media-thumb-item ${activeCls}" onclick="switchStagedMediaItem(${idx})">
                            <img src="${item.previewUrl}" class="bcp-media-thumb-img" />
                            <span class="bcp-media-thumb-remove" onclick="removeStagedMediaItem(event, ${idx})">✕</span>
                        </div>`;
                } else {
                    thumbsHtml += `
                        <div class="bcp-media-thumb-item ${activeCls}" onclick="switchStagedMediaItem(${idx})" style="background:#e2e8f0; display:flex; align-items:center; justify-content:center;">
                            <span class="material-symbols-outlined" style="font-size:24px; color:#475569;">description</span>
                            <span class="bcp-media-thumb-remove" onclick="removeStagedMediaItem(event, ${idx})">✕</span>
                        </div>`;
                }
            });
            document.getElementById('mediaCarouselThumbs').innerHTML = thumbsHtml;

            // Update Send Button Badge Count
            const sendBtn = document.getElementById('modalSendBtn');
            if (sendBtn) {
                const count = stagedFilesList.length;
                sendBtn.innerHTML = `
                    <span class="material-symbols-outlined" style="font-size:22px;">send</span>
                    ${count > 1 ? `<span style="position:absolute; top:-4px; right:-4px; background:#000000; color:#ffffff; font-size:10px; font-weight:700; border-radius:10px; padding:1px 5px;">${count}</span>` : ''}
                `;
            }
        }

        function switchStagedMediaItem(idx) {
            activeStagedIndex = idx;
            renderMediaModal();
        }

        function removeStagedMediaItem(e, idx) {
            e.stopPropagation();
            if (stagedFilesList[idx].previewUrl) {
                URL.revokeObjectURL(stagedFilesList[idx].previewUrl);
            }
            stagedFilesList.splice(idx, 1);
            renderMediaModal();
        }

        function closeMediaModal() {
            stagedFilesList.forEach(item => {
                if (item.previewUrl) URL.revokeObjectURL(item.previewUrl);
            });
            stagedFilesList = [];
            activeStagedIndex = 0;
            document.getElementById('mediaStagingModal').style.display = 'none';
            document.getElementById('modalCaptionInput').value = '';
            document.getElementById('fileInput').value = '';
        }

        // Submitting Media Upload (Optimistic Non-Blocking Asynchronous Background Upload)
        function submitMediaUpload() {
            if (stagedFilesList.length === 0) return;

            const caption = document.getElementById('modalCaptionInput').value.trim();
            const filesToSend = [...stagedFilesList.map(f => f.file)];
            const clientTempId = 'temp-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6);

            // Close modal immediately so user can continue chatting
            closeMediaModal();

            // Append Optimistic Uploading Bubble
            appendOptimisticUploadBubble(clientTempId, filesToSend[0].name, caption);

            // XHR Upload with Real-Time Progress Bar
            const formData = new FormData();
            filesToSend.forEach(f => formData.append('files', f));
            if (caption) formData.append('content', caption);
            if (activeReplyId) formData.append('replyToId', activeReplyId);
            formData.append('clientTempId', clientTempId);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', `/api/groups/${groupId}/chat/upload`, true);

            xhr.upload.onprogress = function(evt) {
                if (evt.lengthComputable) {
                    const percent = Math.round((evt.loaded / evt.total) * 100);
                    const fill = document.getElementById(`progress-fill-${clientTempId}`);
                    const txt = document.getElementById(`progress-text-${clientTempId}`);
                    if (fill) fill.style.width = percent + '%';
                    if (txt) txt.innerText = `Uploading ${percent}%...`;
                }
            };

            xhr.onload = function() {
                if (xhr.status === 200) {
                    console.log("File upload success:", xhr.responseText);
                    const optBubble = document.getElementById(`msg-${clientTempId}`);
                    if (optBubble) optBubble.remove();
                } else {
                    console.error("File upload error:", xhr.responseText);
                    const txt = document.getElementById(`progress-text-${clientTempId}`);
                    if (txt) {
                        txt.innerText = "❌ Upload failed. Please try again.";
                        txt.style.color = "#ef4444";
                    }
                }
            };

            xhr.onerror = function() {
                console.error("XHR Network Error");
                const txt = document.getElementById(`progress-text-${clientTempId}`);
                if (txt) {
                    txt.innerText = "❌ Network error during upload.";
                    txt.style.color = "#ef4444";
                }
            };

            xhr.send(formData);
        }

