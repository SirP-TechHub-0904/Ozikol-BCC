        // Custom Download File Naming Function ([CompanyName]_[YYYYMMDD_HHMMSS].[ext])
        function downloadMediaFile(fileUrl, originalFileName) {
            if (!fileUrl) return;
            const now = new Date();
            const dateStr = now.getFullYear().toString() + '-' +
                String(now.getMonth() + 1).padStart(2, '0') + '-' +
                String(now.getDate()).padStart(2, '0');
            const timeStr = String(now.getHours()).padStart(2, '0') + '.' +
                String(now.getMinutes()).padStart(2, '0') + '.' +
                String(now.getSeconds()).padStart(2, '0');

            let ext = '.jpg';
            if (originalFileName && originalFileName.includes('.')) {
                ext = originalFileName.substring(originalFileName.lastIndexOf('.'));
            } else {
                const match = fileUrl.match(/\.(jpg|jpeg|png|gif|webp|pdf|docx|xlsx|txt|zip)(\?.*)?$/i);
                if (match) ext = '.' + match[1].toLowerCase();
            }

            const groupName = '@(Model.Group?.Title ?? "group")'.toLowerCase().replace(/[^a-z0-9]/g, '_');
            const customFileName = `${groupName} ${dateStr} at ${timeStr}${ext}`;

            fetch(fileUrl)
                .then(res => res.blob())
                .then(blob => {
                    const a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = customFileName;
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    URL.revokeObjectURL(a.href);
                    showToast(`Downloaded ${customFileName}`, "success");
                })
                .catch(err => {
                    const a = document.createElement('a');
                    a.href = fileUrl;
                    a.download = customFileName;
                    a.target = '_blank';
                    a.click();
                });
        }

        function copyTextToClipboard(text) {
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
                showToast("Text copied to clipboard!", "success");
            }).catch(err => {
                console.error("Copy text error:", err);
            });
        }

        function copyImageToClipboard(imageUrl) {
            if (!imageUrl) return;
            showToast("Copying image...", "info");

            const img = new Image();
            img.crossOrigin = "anonymous";
            img.onload = function() {
                try {
                    const canvas = document.createElement("canvas");
                    canvas.width = img.naturalWidth || img.width;
                    canvas.height = img.naturalHeight || img.height;
                    const ctx = canvas.getContext("2d");
                    ctx.drawImage(img, 0, 0);

                    canvas.toBlob((blob) => {
                        if (!blob) {
                            fallbackCopyUrl(imageUrl);
                            return;
                        }
                        const item = new ClipboardItem({ "image/png": blob });
                        navigator.clipboard.write([item])
                            .then(() => showToast("Image copied to clipboard!", "success"))
                            .catch((err) => {
                                console.warn("Clipboard API write error:", err);
                                fallbackCopyUrl(imageUrl);
                            });
                    }, "image/png");
                } catch (e) {
                    console.warn("Canvas export error:", e);
                    fallbackCopyUrl(imageUrl);
                }
            };
            img.onerror = function() {
                fallbackCopyUrl(imageUrl);
            };
            img.src = imageUrl;
        }

        function fallbackCopyUrl(url) {
            navigator.clipboard.writeText(url)
                .then(() => showToast("Image URL copied to clipboard!", "success"))
                .catch(() => showToast("Unable to copy image", "error"));
        }

        // Global Portal Context Menu Logic with Text vs Image vs File Differentiation
        function toggleMsgDropdown(e, msgId, userName, content, isMine, fileUrl, fileName, isImg, fileSize, fileId) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('globalMsgContextMenu');
            if (!menu) return;

            if (currentMenuMsgId === msgId && menu.style.display === 'block') {
                menu.style.display = 'none';
                currentMenuMsgId = null;
                return;
            }

            currentMenuMsgId = msgId;

            const copyTextBtn = document.getElementById('menuItemCopyText');
            const copyImgBtn = document.getElementById('menuItemCopyImage');
            const downloadBtn = document.getElementById('menuItemDownload');

            if (content && content.trim()) {
                copyTextBtn.style.display = 'flex';
                copyTextBtn.onclick = () => { copyTextToClipboard(content); menu.style.display = 'none'; };
            } else {
                copyTextBtn.style.display = 'none';
            }

            if (fileUrl) {
                if (isImg) {
                    copyImgBtn.style.display = 'flex';
                    copyImgBtn.onclick = () => { copyImageToClipboard(fileUrl); menu.style.display = 'none'; };
                } else {
                    copyImgBtn.style.display = 'none';
                }

                downloadBtn.style.display = 'flex';
                downloadBtn.innerHTML = isImg ? '<span class="material-symbols-outlined" style="font-size:16px;">download</span> Download Image' : '<span class="material-symbols-outlined" style="font-size:16px;">download</span> Download File';
                downloadBtn.onclick = () => { downloadMediaFile(fileUrl, fileName); menu.style.display = 'none'; };
            } else {
                copyImgBtn.style.display = 'none';
                downloadBtn.style.display = 'none';
            }

            document.getElementById('menuItemReply').onclick = () => { prepareReply(msgId, userName, content); menu.style.display = 'none'; };
            document.getElementById('menuItemInfo').onclick = () => { toggleMsgInfo(msgId); menu.style.display = 'none'; };
            document.getElementById('menuItemPin').onclick = () => { pinMessage(msgId); menu.style.display = 'none'; };
            document.getElementById('menuItemShare').onclick = () => { openShareModal(msgId, content, fileUrl, fileName, fileSize, fileId); menu.style.display = 'none'; };

            const deleteBtn = document.getElementById('menuItemDelete');
            if (deleteBtn) {
                deleteBtn.style.display = isMine ? 'flex' : 'none';
                deleteBtn.onclick = () => { openDeleteModal(msgId); menu.style.display = 'none'; };
            }

            const btnRect = e.currentTarget.getBoundingClientRect();
            let top = btnRect.bottom + 4;
            let left = btnRect.right - 160;

            if (left < 10) left = 10;
            if (top + 240 > window.innerHeight) {
                top = btnRect.top - 240;
            }

            menu.style.top = top + 'px';
            menu.style.left = left + 'px';
            menu.style.display = 'block';
        }

        document.addEventListener('click', (e) => {
            const menu = document.getElementById('globalMsgContextMenu');
            if (menu && !menu.contains(e.target)) {
                menu.style.display = 'none';
                currentMenuMsgId = null;
            }
        });

