        function forwardMessageToMember(receiverUserId, receiverName, msgId, content, fileUrl, fileId) {
            const body = {
                groupId: groupId,
                receiverUserId: receiverUserId,
                content: content || (fileUrl ? "📎 Shared attachment" : ""),
                fileId: fileId || null
            };

            showToast(`Sharing message to ${receiverName}...`, "info");
            fetch('/api/groups/dm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
