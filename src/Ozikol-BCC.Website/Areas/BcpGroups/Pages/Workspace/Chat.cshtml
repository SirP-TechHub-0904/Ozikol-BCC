                        <span class="material-symbols-outlined" style="font-size:20px;">attach_file</span>
                    </button>

                    <div class="bcp-composer-input-wrap">
                        <textarea id="messageInput" class="bcp-input bcp-composer-textarea" rows="1" placeholder="Type a message... (@@ for mention, Shift+Enter for new line)" autocomplete="off"></textarea>
                        <div id="charCounter" style="position:absolute; right:14px; bottom:8px; color:var(--sidebar-color); font-size:11px;"></div>
                    </div>

                    <button type="submit" class="console-btn primary" style="padding:8px 14px; border-radius:20px;">
                        <span class="material-symbols-outlined" style="font-size:20px;">send</span>
                    </button>
