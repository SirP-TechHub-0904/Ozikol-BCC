        // Web Audio Synthesizer
        let audioCtx = null;
        function initAudioContext() {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            } catch (e) {
                console.warn("AudioContext init error:", e);
            }
        }
        document.addEventListener('click', initAudioContext);
        document.addEventListener('keydown', initAudioContext);

        function playNotificationSound() {
            if (isNotificationMuted || notificationVolume <= 0) return;
            try {
                initAudioContext();
                if (!audioCtx) return;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                const now = audioCtx.currentTime;

                if (notificationTone === 'pop') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(600, now);
                    osc.frequency.exponentialRampToValueAtTime(200, now + 0.08);
                    gain.gain.setValueAtTime(notificationVolume * 0.4, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                    osc.start(now);
                    osc.stop(now + 0.08);
                } else if (notificationTone === 'bell') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(880, now);
                    gain.gain.setValueAtTime(notificationVolume * 0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
                    osc.start(now);
                    osc.stop(now + 0.6);
                } else if (notificationTone === 'ding') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(1046.5, now);
                    gain.gain.setValueAtTime(notificationVolume * 0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                } else {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.1);
                    gain.gain.setValueAtTime(notificationVolume * 0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                }
            } catch (err) {
                console.error("Audio error:", err);
            }
        }

        // Initialize SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/group-chat")
            .withAutomaticReconnect()
            .build();

        // 1. Receive Message Handler (Handles both Multi-User Group & 2-User Private DMs)
        connection.on("ReceiveMessage", function (msg) {
            console.log("SignalR ReceiveMessage:", msg);
            const isDm = msg.isDirectMessage || msg.IsDirectMessage;
            const msgSenderId = msg.userId || msg.UserId || msg.senderUserId || msg.SenderUserId;
            const recipientId = msg.recipientUserId || msg.RecipientUserId || msg.receiverUserId || msg.ReceiverUserId;

            if (isDm) {
                if (activeChatType === 'dm' && (msgSenderId === activeDmUserId || recipientId === activeDmUserId)) {
                    appendMessage(msg);
                    scrollBottom();
                    if (msgSenderId && msgSenderId !== currentUserId) {
                        playNotificationSound();
                    }
                } else if (msgSenderId && msgSenderId !== currentUserId) {
                    playNotificationSound();
                    showToast(`💬 Private message from ${msg.userName || msg.UserName || 'Member'}`, "info");
                }
                return;
            }

            if (activeChatType === 'group') {
                const tempId = msg.clientTempId || msg.ClientTempId;
                if (tempId) {
                    const optBubble = document.getElementById(`msg-${tempId}`);
                    if (optBubble) optBubble.remove();
                }

                if (msgSenderId) {
                    const existingTyping = document.getElementById(`typing-bubble-${msgSenderId}`);
                    if (existingTyping) existingTyping.remove();
                }

                appendMessage(msg);
                scrollBottom();

                if (msgSenderId && msgSenderId !== currentUserId) {
                    playNotificationSound();
                }
            } else if (msgSenderId && msgSenderId !== currentUserId) {
                playNotificationSound();
                showToast(`👥 New message in ${groupTitle}`, "info");
            }
        });

        // 2. Message Pinned Live Handler
        connection.on("MessagePinned", function (msgId, isPinned, pinnerName, previewText) {
            playNotificationSound();
            const icon = document.getElementById(`pin-icon-${msgId}`);
            if (icon) {
                icon.style.display = isPinned ? 'inline-block' : 'none';
            }
            showToast(`📌 ${pinnerName} ${isPinned ? 'pinned' : 'unpinned'} a message`, "info");
            if (window.showToastAlert) {
                window.showToastAlert(pinnerName, groupTitle, `📌 ${isPinned ? 'Pinned' : 'Unpinned'}: "${previewText}"`, groupId, true);
            }
        });

        // 3. Message Deleted Live Handler
        connection.on("MessageDeleted", function (msgId, deletedContent) {
            const wrapper = document.getElementById(`msg-${msgId}`);
            if (wrapper) {
                let txt = wrapper.querySelector('.message-content');
                if (!txt) {
                    txt = document.createElement('div');
                    txt.className = 'message-content';
                    txt.id = `msg-text-${msgId}`;
                    const bubble = wrapper.querySelector('.bcp-msg-bubble');
                    if (bubble) {
                        const meta = bubble.querySelector('.bcp-msg-meta');
                        if (meta) {
                            bubble.insertBefore(txt, meta);
                        } else {
                            bubble.appendChild(txt);
                        }
                    }
                }
                if (txt) {
                    txt.innerHTML = `<em style="color:var(--sidebar-color); font-style:italic;">🚫 This message was deleted</em>`;
                }
                wrapper.querySelectorAll('.bcp-msg-menu-btn, .tick-icon, .bcp-reply-quote-preview, img, .bcp-file-attachment-card').forEach(el => el.remove());

                // Remove image thumbs, attachment cards, reply quotes, and options buttons inside this wrapper
                const imgThumb = wrapper.querySelector('.bcp-msg-image-thumb');
                if (imgThumb) imgThumb.closest('div').remove();

                const attachment = wrapper.querySelector('.bcp-msg-attachment');
                if (attachment) attachment.remove();

                const replyQuote = wrapper.querySelector('.bcp-reply-quote');
                if (replyQuote) replyQuote.remove();

                const menuBtn = wrapper.querySelector('.bcp-msg-menu-btn');
                if (menuBtn) menuBtn.remove();
            }
        });

        // 4. User Typing Handler
        connection.on("UserTyping", function (gId, uId, uName, isTyping) {
            if (String(gId).toLowerCase() === String(groupId).toLowerCase() && uId !== currentUserId) {
                const container = document.getElementById('chatMessagesContainer');
                let bubble = document.getElementById(`typing-bubble-${uId}`);

                if (isTyping) {
                    if (!bubble && container) {
                        const initial = uName ? uName.charAt(0) : '?';
                        bubble = document.createElement('div');
                        bubble.id = `typing-bubble-${uId}`;
                        bubble.className = 'bcp-typing-bubble';
                        bubble.innerHTML = `
                            <a href="/BcpUserManagement/Console/Details?id=${uId}" class="bcp-avatar-circle sm" style="text-decoration:none; color:inherit;" title="View Profile">${initial}</a>
                            <div class="bcp-typing-dots">
                                <span class="bcp-typing-dot"></span>
                                <span class="bcp-typing-dot"></span>
                                <span class="bcp-typing-dot"></span>
                            </div>`;
                        container.appendChild(bubble);
                        scrollBottom();
                    }
                } else {
                    if (bubble) {
                        bubble.remove();
                    }
                }
            }
        });

        // 5. Presence Update Handler
        connection.on("PresenceUpdate", function (uId, status, lastSeen) {
            const dot = document.getElementById(`presence-dot-${uId}`);
            const text = document.getElementById(`presence-text-${uId}`);
            if (dot) {
                dot.className = `presence-dot presence-${status.toLowerCase()}`;
            }
            if (text) {
                text.innerText = status;
            }
        });

        connection.start().then(() => {
            console.log("SignalR Connected!");
            connection.invoke("JoinGroup", groupId);
        }).catch(err => console.error(err));

        function scrollBottom() {
            const container = document.getElementById('chatMessagesContainer');
            if (container) container.scrollTop = container.scrollHeight;
        }
        scrollBottom();

        // Dynamically append incoming message bubble
        function appendMessage(msg) {
            const container = document.getElementById('chatMessagesContainer');
            if (!container) return;

            const msgUserId = msg.userId || msg.UserId;
            const msgUserName = msg.userName || msg.UserName || 'Unknown';
            const msgContent = msg.content || msg.Content || '';
            const msgCreatedAt = msg.createdAt || msg.CreatedAt;
            const msgFileUrl = msg.fileUrl || msg.FileUrl;
            const msgFileName = msg.fileName || msg.FileName;
            const msgFileSize = msg.fileSize || msg.FileSize;
            const msgFileId = msg.fileId || msg.FileId || (msg.file ? (msg.file.id || msg.file.Id) : (msg.File ? (msg.File.id || msg.File.Id) : ''));
            const msgContentType = msg.fileContentType || msg.ContentType || '';
            const msgReplyToContent = msg.replyToContent || msg.ReplyToContent;
            const msgReplyToUserName = msg.replyToUserName || msg.ReplyToUserName;
            const msgId = msg.id || msg.Id;

            const isMine = msgUserId === currentUserId;
            const timeStr = msgCreatedAt ? new Date(msgCreatedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
            const initial = msgUserName ? msgUserName.charAt(0) : '?';
            const safeUser = msgUserName.replace("'", "\\'");
            const safeContent = msgContent.replace("'", "\\'").replace("\n", " ");

            let fileHtml = '';
            if (msgFileUrl) {
                const ext = msgFileName ? msgFileName.split('.').pop().toLowerCase() : '';
                const isImg = ext === 'jpg' || ext === 'jpeg' || ext === 'png' || ext === 'gif' || ext === 'webp' || msgContentType.startsWith('image/');

                const safeFileName = msgFileName ? msgFileName.replace("'", "\\'") : '';
                if (isImg) {
                    fileHtml = `<div><img src="${msgFileUrl}" class="bcp-msg-image-thumb" onclick="openLightbox('${msgFileUrl}', '${safeFileName}')" alt="${msgFileName || 'Image'}" /></div>`;
                } else {
                    const sizeKb = msgFileSize ? Math.round(msgFileSize / 1024) : 0;
                    fileHtml = `
                        <div class="bcp-msg-attachment">
                            <span class="material-symbols-outlined" style="font-size:24px;">download</span>
                            <div style="overflow:hidden;">
                                <a href="javascript:void(0)" onclick="downloadMediaFile('${msgFileUrl}', '${safeFileName}')" class="bcp-msg-attachment-link">${msgFileName || 'Attachment.txt'}</a>
                                <small style="opacity:0.8; font-size:11px;">${sizeKb} KB</small>
                            </div>
                        </div>`;
                }
            }

            let replyHtml = '';
            if (msgReplyToContent) {
                replyHtml = `
                    <div class="bcp-reply-quote">
                        <span style="font-weight:700; display:block;">${msgReplyToUserName || 'User'}</span>
                        <span>${msgReplyToContent}</span>
                    </div>`;
            }

            const tickHtml = isMine ? `<span class="tick-icon"><span class="material-symbols-outlined" style="font-size:14px;">check</span></span>` : '';

            const isImgMsg = msgFileUrl && (msgContentType.startsWith('image/') || /\.(jpg|jpeg|png|gif|webp)$/i.test(msgFileName || ''));
            const safeFileUrl = msgFileUrl ? msgFileUrl.replace("'", "\\'") : '';
            const safeFileName = msgFileName ? msgFileName.replace("'", "\\'") : '';

            const wrapper = document.createElement('div');
            wrapper.className = `bcp-msg-wrapper ${isMine ? 'mine' : 'other'}`;
            wrapper.id = `msg-${msgId}`;
            wrapper.innerHTML = `
                <div class="bcp-msg-row ${isMine ? 'mine' : 'other'}">
                    ${!isMine ? `<a href="javascript:void(0)" onclick="openMemberProfileDrawer('${msgUserId}', '${safeUser}', '', '')" class="bcp-avatar-circle sm" style="text-decoration:none; color:inherit;" title="View Profile">${initial}</a>` : ''}
                    <div class="bcp-msg-bubble ${isMine ? 'mine' : 'other'}">
                        ${!isMine ? `<div style="margin-bottom:4px;"><a href="javascript:void(0)" onclick="openMemberProfileDrawer('${msgUserId}', '${safeUser}', '', '')" class="bcp-member-profile-link" style="font-weight:700; font-size:12px; color:var(--sidebar-active-color);" title="View Profile">${msgUserName}</a></div>` : ''}
                        ${replyHtml}
                        ${(msgContent && !msgContent.startsWith('📎 Attached file:')) ? `<div class="message-content" id="msg-text-${msgId}">${msgContent}</div>` : ''}
                        ${fileHtml}
                        <div class="bcp-msg-meta">
                            <span>${timeStr}</span>
                            <span id="pin-icon-${msgId}" style="display:none; color:#f59e0b;">
                                <span class="material-symbols-outlined" style="font-size:13px;">push_pin</span>
                            </span>
                            ${tickHtml}

                            <button type="button" class="bcp-msg-menu-btn" onclick="toggleMsgDropdown(event, '${msgId}', '${safeUser}', '${safeContent}', ${isMine}, '${safeFileUrl}', '${safeFileName}', ${isImgMsg ? 'true' : 'false'}, ${msgFileSize || 0}, '${msgFileId}')" title="Options">
                                <span class="material-symbols-outlined" style="font-size:16px;">expand_more</span>
                            </button>
                        </div>
                    </div>
                </div>`;

            container.appendChild(wrapper);
        }

        // Reply pre-populate
        function prepareReply(msgId, userName, content) {
            activeReplyId = msgId;
            document.getElementById('replyUserName').innerText = userName;
            document.getElementById('replyPreviewText').innerText = content;
            document.getElementById('replyBanner').style.display = 'flex';
            document.getElementById('messageInput').focus();
        }

        function cancelReply() {
            activeReplyId = null;
            document.getElementById('replyBanner').style.display = 'none';
        }

        function handleSendMessage(e) {
            if (e) e.preventDefault();
            const input = document.getElementById('messageInput');
            if (!input) return;

            let content = autoFileText || input.value.trim();
            if (!content) return;

            document.getElementById('emojiPicker').style.display = 'none';

            if (activeChatType === 'dm') {
                sendDirectMessage(content);
                return;
            }

            const mentions = mentionedUserIdsList.join(',');
            connection.invoke("SendMessage", groupId, content, activeReplyId, mentions)
                .then(() => {
                    input.value = "";
                    input.style.height = "auto";
                    cancelAutoFile();
                    cancelReply();
                    sendTypingSignal(false);
                    mentionedUserIdsList = [];
                })
                .catch(err => console.error(err));
        }

        function sendDirectMessage(content) {
            if (!activeDmUserId) return;
            const input = document.getElementById('messageInput');
            input.value = "";
            input.style.height = "auto";

            appendMyDmBubble(content);

            const body = {
                groupId: groupId,
                receiverUserId: activeDmUserId,
                content: content
            };

            fetch('/api/groups/dm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            })
            .then(res => {
                if (!res.ok) {
                    showToast("Failed to send direct message", "error");
                }
            })
            .catch(err => {
                console.error("DM send error:", err);
                showToast("DM send failed", "error");
            });
        }

        // Multiline Textarea, Typing Indicator & Auto-Convert Logic
        const msgInput = document.getElementById('messageInput');
        const modalCapInput = document.getElementById('modalCaptionInput');
        if (modalCapInput) {
            modalCapInput.addEventListener('input', function() {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';
            });
        }
        function sendTypingSignal(isTyping) {
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                if (activeChatType === 'dm' && activeDmUserId) {
                    connection.invoke("SendTypingIndicator", groupId, isTyping, activeDmUserId).catch(err => console.error(err));
                } else {
                    connection.invoke("SendTypingIndicator", groupId, isTyping).catch(err => console.error(err));
                }
            }
        }

        if (msgInput) {
            msgInput.addEventListener('focus', function() {
                sendTypingSignal(true);
            });

            msgInput.addEventListener('paste', function(e) {
                const items = (e.clipboardData || window.clipboardData)?.items;
                let imageFiles = [];
                if (items) {
                    for (let i = 0; i < items.length; i++) {
                        if (items[i].type.indexOf('image') !== -1) {
                            const file = items[i].getAsFile();
                            if (file) {
                                imageFiles.push(file);
                            }
                        }
                    }
                }

                if (imageFiles.length > 0) {
                    e.preventDefault();
                    stageFilesForPreview(imageFiles);
                    return;
                }

                const pastedText = (e.clipboardData || window.clipboardData)?.getData('text');
                if (pastedText && pastedText.length > 500) {
                    e.preventDefault();
                    convertTextToStagedFile(pastedText);
                }
            });

            msgInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    handleSendMessage(e);
                }
            });

            msgInput.addEventListener('input', function(e) {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 120) + 'px';

                sendTypingSignal(true);
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => {
                    sendTypingSignal(false);
                }, 4000);

                const text = this.value;
                if (text.length > 500) {
                    convertTextToStagedFile(text);
                }

                checkMentionTrigger(this);
            });
        }

        function convertTextToStagedFile(text) {
            if (!text || text.length <= 500) return;
            const now = new Date();
            const dateStr = now.getFullYear().toString() + '-' +
                String(now.getMonth() + 1).padStart(2, '0') + '-' +
                String(now.getDate()).padStart(2, '0');
            const timeStr = String(now.getHours()).padStart(2, '0') + '.' +
                String(now.getMinutes()).padStart(2, '0') + '.' +
                String(now.getSeconds()).padStart(2, '0');
            const groupName = '@(Model.Group?.Title ?? "group")'.toLowerCase().replace(/[^a-z0-9]/g, '_');
            const fileName = `${groupName} ${dateStr} at ${timeStr}.txt`;

            const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
            const txtFile = new File([blob], fileName, { type: 'text/plain' });

            const msgInput = document.getElementById('messageInput');
            if (msgInput) {
                msgInput.value = '';
                msgInput.style.height = 'auto';
            }

            stageFilesForPreview([txtFile]);
        }

        function cancelAutoFile() {
            autoFileText = null;
            const chip = document.getElementById('autoFileChip');
            if (chip) chip.style.display = 'none';
        }

        // Mention Autocomplete Popover Logic
        function checkMentionTrigger(input) {
            const val = input.value;
            const pos = input.selectionStart;
            const textBeforeCursor = val.substring(0, pos);
            const lastAt = textBeforeCursor.lastIndexOf('\x40');

            const popover = document.getElementById('mentionPopover');
            if (lastAt !== -1 && (lastAt === 0 || /\s/.test(textBeforeCursor.charAt(lastAt - 1)))) {
                const query = textBeforeCursor.substring(lastAt + 1).toLowerCase();
                const matches = groupMembers.filter(m => m.name.toLowerCase().includes(query));

                if (matches.length > 0) {
                    let html = '';
                    matches.forEach((m, idx) => {
                        html += `<div class="bcp-mention-item ${idx === 0 ? 'selected' : ''}" onclick="insertMention('${m.name}', '${m.id}', '${lastAt}')">
                                    <div class="bcp-avatar-circle sm">${m.firstName ? m.firstName.charAt(0) : '?'}</div>
                                    <span>${m.name}</span>
                                 </div>`;
                    });
                    popover.innerHTML = html;
                    popover.style.display = 'block';
                    return;
                }
            }
            popover.style.display = 'none';
        }

        function insertMention(name, memberId, atPos) {
            const input = document.getElementById('messageInput');
            const pos = parseInt(atPos, 10);
            const val = input.value;
            input.value = val.substring(0, pos) + `\x40${name} ` + val.substring(input.selectionStart);
            if (!mentionedUserIdsList.includes(memberId)) {
                mentionedUserIdsList.push(memberId);
            }
            document.getElementById('mentionPopover').style.display = 'none';
            input.focus();
        }

        function toggleMsgInfo(msgId) {
            closeAllDrawers();
            const panel = document.getElementById('messageInfoPanel');
            panel.style.display = 'flex';
            panel.classList.add('open');
            document.getElementById('drawerBackdrop').style.display = 'block';

            fetch(`/api/groups/${groupId}/chat/messages/${msgId}/info`)
                .then(r => r.json())
                .then(data => {
                    let html = `<div style="padding:10px; background:var(--md-sys-color-surface-variant); border-radius:8px; margin-bottom:14px; font-size:12px; font-weight:600;">${data.message.content}</div>`;
                    html += `<h4 style="font-size:12px; font-weight:700; color:#16a34a; margin:0 0 6px;">Read By (${data.readCount})</h4><ul style="list-style:none; padding:0; margin:0 0 14px;">`;
                    data.readBy.forEach(u => html += `<li style="font-size:12px; padding:3px 0;">✓✓ ${u.userName}</li>`);
                    html += `</ul><h4 style="font-size:12px; font-weight:700; color:var(--sidebar-color); margin:0 0 6px;">Delivered To (${data.deliveredCount})</h4><ul style="list-style:none; padding:0; margin:0 0 14px;">`;
                    data.deliveredTo.forEach(u => html += `<li style="font-size:12px; padding:3px 0;">✓✓ ${u.userName}</li>`);
                    html += `</ul><h4 style="font-size:12px; font-weight:700; color:var(--sidebar-color); opacity:0.7; margin:0 0 6px;">Not Delivered (${data.notDeliveredCount})</h4><ul style="list-style:none; padding:0; margin:0 0 14px;">`;
                    data.notDelivered.forEach(u => html += `<li style="font-size:12px; padding:3px 0;">⚫ ${u.userName}</li>`);
                    html += `</ul>`;
                    document.getElementById('messageInfoContent').innerHTML = html;
                }).catch(() => {
                    document.getElementById('messageInfoContent').innerHTML = `<div style="padding:10px; font-size:12px; color:var(--sidebar-color);">Could not fetch message info.</div>`;
                });
        }

        // In-Chat Shared Files Drawer Toggle
        function toggleSharedFilesDrawer() {
            closeAllDrawers();
            const panel = document.getElementById('sharedFilesPanel');
            panel.style.display = 'flex';
            panel.classList.add('open');
            document.getElementById('drawerBackdrop').style.display = 'block';

            fetch(`/api/groups/${groupId}/files`)
                .then(r => r.json())
                .then(files => {
                    if (!files || files.length === 0) {
                        document.getElementById('sharedFilesContent').innerHTML = `<div style="text-align:center; padding:30px 0; color:var(--sidebar-color);">No shared files in this group.</div>`;
