        // Refactored Media Staging Preview Modal Logic
        function handleFileSelect(e) {
            if (e.target.files && e.target.files.length > 0) {
                stageFilesForPreview(Array.from(e.target.files));
            }
        }

        function handleModalAddFiles(e) {
            if (e.target.files && e.target.files.length > 0) {
                stageFilesForPreview(Array.from(e.target.files));
