        <div class="bcp-chat-info-header">
            <h3 class="bcp-section-title mb-0" style="font-size:14px;">
                <span class="material-symbols-outlined" style="font-size:18px; color:var(--sidebar-active-color);">folder</span>
                Shared Files & Media
            </h3>
            <button type="button" class="console-btn secondary" style="padding:4px; min-height:auto;" onclick="closeAllDrawers()">
                <span class="material-symbols-outlined" style="font-size:18px;">close</span>
            </button>
        </div>
        <div id="sharedFilesContent" style="padding:10px; overflow-y:auto; flex:1;">
            <div style="text-align:center; padding:30px 0; color:var(--sidebar-color);">Loading files...</div>
        </div>
