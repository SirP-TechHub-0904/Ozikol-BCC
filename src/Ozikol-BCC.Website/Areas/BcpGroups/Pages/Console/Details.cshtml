@page "{id:guid}"
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Console.DetailsModel
@attribute [Authorize]
@{
    ViewData["Title"] = Model.Group.Title + " Details";
    var inviteUrl = $"{Request.Scheme}://{Request.Host}/BcpGroups/Workspace/Join?id={Model.Group.Id}";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Committees & Groups",
    Title = Model.Group.Title + " Details",
    Subtitle = "Type: " + Model.Group.GroupType + " | Created by " + (Model.Group.CreatedByUser?.FullName ?? "Admin") + " on " + Model.Group.CreatedAt.ToString("MMM dd, yyyy"),
    Icon = "info",
    BackUrl = "/BcpGroups/Console/Groups",
    BackText = "Groups",
    Buttons =
    [
        new("Enter Chat", "/BcpGroups/Workspace/Chat/" + Model.Group.Id, "chat_bubble", true),
        new("Export Backup (JSON)", "/api/groups/" + Model.Group.Id + "/export/json", "download"),
        new("Transcript (.txt)", "/api/groups/" + Model.Group.Id + "/export/txt", "description"),
        new("Edit Group", "/BcpGroups/Console/Edit/" + Model.Group.Id, "edit")
    ]
})

<!-- Row 1: KPI Cards -->
<section class="console-grid" style="margin-bottom: 24px; width: 100%; max-width: 100%;">
    <article class="console-widget span-4">
        <div class="widget-body">
            <div class="metric-label">Total Members</div>
            <div class="metric-value">@Model.MemberCount</div>
            <div class="metric-note">Active members in group</div>
        </div>
    </article>
    <article class="console-widget span-4">
        <div class="widget-body">
            <div class="metric-label">Chat Messages</div>
            <div class="metric-value text-primary">@Model.MessageCount</div>
            <div class="metric-note">Posted messages</div>
        </div>
    </article>
    <article class="console-widget span-4">
        <div class="widget-body">
            <div class="metric-label">Shared Files</div>
            <div class="metric-value">@Model.FileCount</div>
            <div class="metric-note">Cloudinary media</div>
        </div>
    </article>
</section>

<!-- Row 2: Shareable Group Invite Link & Quick Member Addition Widget -->
<section class="m3-card bcp-card mb-4" style="width: 100%; max-width: 100%; box-sizing: border-box;">
    <h3 class="bcp-section-title"><span class="material-symbols-outlined">link</span> Shareable Group Invite Link</h3>
    <p class="text-muted small">Share this unique invitation link with members or external guests to automatically join this group space.</p>
    <div class="d-flex gap-2 align-items-center">
        <input type="text" id="inviteUrlInput" class="bcp-input" value="@inviteUrl" readonly style="flex: 1;" />
        <button class="console-btn primary" onclick="copyInviteUrl()"><span class="material-symbols-outlined">content_copy</span>Copy Link</button>
        <a class="console-btn secondary" href="/BcpGroups/Console/Edit/@Model.Group.Id"><span class="material-symbols-outlined">person_add</span>Manage Members</a>
    </div>
</section>

<!-- Row 3: Members Overview Table -->
<section class="m3-card bcp-card" style="width: 100%; max-width: 100%; box-sizing: border-box;">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h3 class="bcp-section-title mb-0"><span class="material-symbols-outlined">group</span> Members Overview</h3>
        <a class="console-btn primary" href="/BcpGroups/Workspace/Chat/@Model.Group.Id">
            <span class="material-symbols-outlined">chat_bubble</span> Open Real-Time Chat
        </a>
    </div>
    <div class="bcp-table-wrap">
        <table class="bcp-table">
            <thead><tr><th>Member Name</th><th>Email</th><th>Role</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td><strong>@m.UserProfile?.FullName</strong></td>
                        <td>@m.UserProfile?.Email</td>
                        <td><span class="badge bg-light text-primary">@m.GroupRole</span></td>
                        <td>
                            @if (m.IsSuspended) { <span class="badge bg-danger">Suspended</span> }
                            else if (m.IsMuted) { <span class="badge bg-warning text-dark">Muted</span> }
                            else { <span class="badge bg-success">Active</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        function copyInviteUrl() {
            const input = document.getElementById('inviteUrlInput');
            input.select();
            navigator.clipboard.writeText(input.value);
            alert('Group invite link copied to clipboard!');
        }
    </script>
}
