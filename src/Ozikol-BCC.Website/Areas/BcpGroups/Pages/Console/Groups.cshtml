@page
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Console.GroupsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Groups Directory";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Committees & Groups",
    Title = "Groups Directory",
    Subtitle = "Manage all committee spaces, sub-groups, department chats, and member assignments across the platform.",
    Icon = "groups",
    BackUrl = "/BcpGroups/Console/Dashboard",
    Buttons =
    [
        new("Create Group", "/BcpGroups/Console/Create", "add_circle", true),
        new("Audit Log", "/BcpGroups/Console/AuditLog", "shield_check")
    ]
})

<form method="get" class="m3-card bcp-card mb-4" style="width:100%; padding:20px;">
    <div style="display:grid; grid-template-columns:1fr 1fr auto auto; gap:14px; align-items:end;">
        <label class="bcp-field">
            Search
            <input class="bcp-input" asp-for="Search" placeholder="Group title or description..." />
        </label>
        <label class="bcp-field">
            Filter
            <select class="bcp-input bcp-select" asp-for="Filter">
                <option value="">All Groups</option>
                <option value="active">Active Only</option>
                <option value="archived">Archived</option>
                <option value="public">Public</option>
                <option value="private">Private</option>
            </select>
        </label>
        <button class="console-btn primary" type="submit" style="min-height:44px;">
            <span class="material-symbols-outlined">search</span> Filter
        </button>
        <a class="console-btn secondary" href="/BcpGroups/Console/Groups" style="min-height:44px;">
            <span class="material-symbols-outlined">restart_alt</span> Reset
        </a>
    </div>
</form>

<section class="m3-card bcp-card" style="width:100%;">
    <div class="bcp-table-wrap">
        <table class="bcp-table">
            <thead>
                <tr>
                    <th style="width:25%;">Group Title</th>
                    <th style="width:10%;">Type</th>
                    <th style="width:10%;">Visibility</th>
                    <th style="width:10%;">Chat Mode</th>
                    <th style="width:8%;">Members</th>
                    <th style="width:8%;">Messages</th>
                    <th style="width:9%;">Status</th>
                    <th style="width:20%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Groups.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            No groups found matching your search criteria.
                        </td>
                    </tr>
                }
                @foreach (var g in Model.Groups)
                {
                    <tr class="@(g.IsArchived ? "table-secondary" : "")">
                        <td>
                            <span class="bcp-member-name">@g.Title</span>
                            <span class="bcp-member-email">Created @g.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </td>
                        <td><span class="bcp-badge">@g.GroupType</span></td>
                        <td><span class="bcp-badge">@g.Visibility</span></td>
                        <td><span class="bcp-badge">@g.ChatMode</span></td>
                        <td><strong>@g.MemberCount</strong></td>
                        <td><strong style="color:var(--sidebar-active-color);">@g.MessageCount</strong></td>
                        <td>
                            @if (g.IsArchived)
                            {
                                <span class="bcp-badge warning">Archived</span>
                            }
                            else if (g.IsActive)
                            {
                                <span class="bcp-badge success">Active</span>
                            }
                            else
                            {
                                <span class="bcp-badge danger">Disabled</span>
                            }
                        </td>
                        <td>
                            <div class="bcp-table-actions">
                                <a class="console-btn" href="/BcpGroups/Console/Details/@g.Id"><span class="material-symbols-outlined">visibility</span>View</a>
                                <a class="console-btn" href="/BcpGroups/Console/Edit/@g.Id"><span class="material-symbols-outlined">edit</span>Edit</a>
                                <a class="console-btn" href="/BcpGroups/Console/Edit/@g.Id"><span class="material-symbols-outlined">settings</span>Settings</a>
                                <form method="post" asp-page-handler="Archive" asp-route-id="@g.Id" style="display:inline;">
                                    <button type="submit" class="console-btn secondary">
                                        <span class="material-symbols-outlined">archive</span>@(g.IsArchived ? "Unarchive" : "Archive")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
