@page "{id:guid}"
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Console.EditModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Edit " + Model.Group.Title;
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Committees & Groups",
    Title = "Edit Group: " + Model.Group.Title,
    Subtitle = "Update configuration, images, operational rules, and add group members.",
    Icon = "edit",
    BackUrl = "/BcpGroups/Console/Groups",
    BackText = "Groups"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div style="padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px; font-size:14px; margin-bottom:20px; display:flex; align-items:center; gap:8px;">
        <span class="material-symbols-outlined" style="font-size:20px;">info</span>
        <span>@Model.StatusMessage</span>
    </div>
}

<form method="post" asp-page-handler="UpdateGroup" enctype="multipart/form-data" class="m3-card bcp-card mb-4" style="width:100%; max-width:100%; box-sizing:border-box; overflow-x:hidden;">
    <input type="hidden" asp-for="Group.Id" />

    <h3 class="bcp-section-title"><span class="material-symbols-outlined">settings</span> Group Configuration</h3>
    <div class="bcp-form-grid">
        <label class="bcp-field">
            Group Title *
            <input class="bcp-input" asp-for="Group.Title" required />
        </label>

        <label class="bcp-field">
            Description
            <input class="bcp-input" asp-for="Group.Description" />
        </label>

        @* ── Avatar Upload Zone ── *@
        <div class="bcp-field">
            <span style="font-size:12px; font-weight:700; color:var(--sidebar-color);">Profile Avatar Image</span>
            <div class="bcp-upload-zone" onclick="document.getElementById('avatarFileInput').click()">
                @if (!string.IsNullOrWhiteSpace(Model.Group.AvatarUrl))
                {
                    <img src="@Model.Group.AvatarUrl" alt="Avatar" class="bcp-upload-preview avatar" />
                }
                else
                {
                    <span class="material-symbols-outlined" style="font-size:36px; color:var(--sidebar-color); opacity:0.5;">account_circle</span>
                }
                <div class="bcp-upload-info">
                    <span class="upload-label">Upload Avatar</span>
                    <span class="upload-hint">JPG, PNG or WebP — max 5 MB</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Group.AvatarUrl))
                    {
                        <span class="upload-current" title="@Model.Group.AvatarUrl">Current: @Model.Group.AvatarUrl</span>
                    }
                </div>
                <span class="bcp-upload-btn"><span class="material-symbols-outlined" style="font-size:16px;">cloud_upload</span> Browse</span>
                <input type="file" id="avatarFileInput" name="AvatarFile" accept="image/*" onchange="previewUpload(this, 'avatarPreview', true)" />
            </div>
        </div>

        @* ── Cover Upload Zone ── *@
        <div class="bcp-field">
            <span style="font-size:12px; font-weight:700; color:var(--sidebar-color);">Background Cover Image</span>
            <div class="bcp-upload-zone" onclick="document.getElementById('coverFileInput').click()">
                @if (!string.IsNullOrWhiteSpace(Model.Group.CoverImageUrl))
                {
                    <img src="@Model.Group.CoverImageUrl" alt="Cover" class="bcp-upload-preview" />
                }
                else
                {
                    <span class="material-symbols-outlined" style="font-size:36px; color:var(--sidebar-color); opacity:0.5;">panorama</span>
                }
                <div class="bcp-upload-info">
                    <span class="upload-label">Upload Cover Banner</span>
                    <span class="upload-hint">JPG, PNG or WebP — recommended 1200×400</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Group.CoverImageUrl))
                    {
                        <span class="upload-current" title="@Model.Group.CoverImageUrl">Current: @Model.Group.CoverImageUrl</span>
                    }
                </div>
                <span class="bcp-upload-btn"><span class="material-symbols-outlined" style="font-size:16px;">cloud_upload</span> Browse</span>
                <input type="file" id="coverFileInput" name="CoverFile" accept="image/*" onchange="previewUpload(this, 'coverPreview', false)" />
            </div>
        </div>

        <label class="bcp-field">
            Group Type
            <select class="bcp-input bcp-select" asp-for="Group.GroupType" asp-items="Html.GetEnumSelectList<Ozikol_BCC.Domain.Enum.Enum.BcpGroupType>()"></select>
        </label>

        <label class="bcp-field">
            Visibility
            <select class="bcp-input bcp-select" asp-for="Group.Visibility" asp-items="Html.GetEnumSelectList<Ozikol_BCC.Domain.Enum.Enum.BcpGroupVisibility>()"></select>
        </label>

        <label class="bcp-field">
            Chat Mode
            <select class="bcp-input bcp-select" asp-for="Group.ChatMode" asp-items="Html.GetEnumSelectList<Ozikol_BCC.Domain.Enum.Enum.BcpGroupChatMode>()"></select>
        </label>

        <label class="bcp-field">
            Max Members
            <input class="bcp-input" asp-for="Group.MaxMembers" type="number" />
        </label>

        <div class="bcp-field-full" style="padding-top:4px;">
            <label class="bcp-toggle">
                <input type="checkbox" asp-for="Group.AllowGuestAccess" />
                <span class="bcp-toggle-track"></span>
                <span>Allow Guest Access</span>
            </label>
        </div>
    </div>

    <h3 class="bcp-section-title mt-4"><span class="material-symbols-outlined">schedule</span> Operational Hours</h3>
    <div class="bcp-form-grid">
        <div class="bcp-field-full" style="padding-bottom:2px;">
            <label class="bcp-toggle">
                <input type="checkbox" asp-for="Group.IsAlwaysOpen" />
                <span class="bcp-toggle-track"></span>
                <span>Always Open (24/7)</span>
            </label>
        </div>
        <label class="bcp-field">
            Operational Days
            <input class="bcp-input" asp-for="Group.OperationalDays" placeholder="Mon,Tue,Wed,Thu,Fri" />
        </label>
        <label class="bcp-field bcp-field-full">
            Closed Message
            <input class="bcp-input" asp-for="Group.ClosedMessage" />
        </label>
    </div>

    <div class="bcp-form-actions mt-4">
        <button class="console-btn primary" type="submit">
            <span class="material-symbols-outlined">save</span> Save Group Settings
        </button>
        <a class="console-btn secondary" href="/BcpGroups/Console/Groups">Back to Groups</a>
    </div>
</form>

@* ── Direct Member Directory Picker (Add Members) ── *@
<section class="m3-card bcp-card mb-4" style="width:100%; max-width:100%; box-sizing:border-box; overflow-x:hidden;">
    <div class="bcp-section-header-stack">
        <h3 class="bcp-section-title mb-0"><span class="material-symbols-outlined">person_add</span> Add Members from User Directory</h3>
        <form method="get" class="bcp-search-row">
            <input type="hidden" name="id" value="@Model.Group.Id" />
            <input type="text" name="SearchQuery" value="@Model.SearchQuery" placeholder="Search users by name, email..." class="bcp-input" />
            <button type="submit" class="console-btn secondary" style="padding:0 16px;">
                <span class="material-symbols-outlined" style="font-size:16px;">search</span> Filter
            </button>
        </form>
    </div>

    <form method="post" asp-page-handler="AddSelectedMembers">
        <input type="hidden" asp-for="Group.Id" />

        <div class="bcp-table-wrap">
            <table class="bcp-table">
                <thead>
                    <tr>
                        <th style="width:48px; text-align:center;">
                            <input type="checkbox" id="selectAllMembers" class="bcp-checkbox-styled" onclick="toggleAllUserCheckboxes(this)" />
                        </th>
                        <th style="width:40%;">User Name</th>
                        <th>Email Address</th>
                        <th style="width:120px; text-align:right;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.CandidateUsers.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No candidate users found matching your search.</td>
                        </tr>
                    }
                    @foreach (var u in Model.CandidateUsers)
                    {
                        <tr>
                            <td style="text-align:center;">
                                @if (u.IsAlreadyMember)
                                {
                                    <input type="checkbox" disabled checked class="bcp-checkbox-styled" />
                                }
                                else
                                {
                                    <input type="checkbox" name="SelectedUserIds" value="@u.UserId" class="bcp-checkbox-styled user-select-check" />
                                }
                            </td>
                            <td><strong>@u.FullName</strong></td>
                            <td style="color:var(--sidebar-color); font-size:12px;">@u.Email</td>
                            <td style="text-align:right;">
                                @if (u.IsAlreadyMember)
                                {
                                    <span class="bcp-badge success"><span class="material-symbols-outlined" style="font-size:13px;">check_circle</span> Member</span>
                                }
                                else
                                {
                                    <span class="bcp-badge">Eligible</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="bcp-table-footer">
            <span class="bcp-table-footer-info">
                Showing page @Model.PageIndex of @(Model.TotalPages < 1 ? 1 : Model.TotalPages) (@Model.TotalCandidateUsers total eligible users)
            </span>
            <div class="bcp-table-footer-actions">
                @if (Model.PageIndex > 1)
                {
                    <a href="?id=@Model.Group.Id&SearchQuery=@Model.SearchQuery&PageIndex=@(Model.PageIndex - 1)" class="console-btn secondary" style="padding:0 12px; font-size:13px;">Previous</a>
                }
                @if (Model.PageIndex < Model.TotalPages)
                {
                    <a href="?id=@Model.Group.Id&SearchQuery=@Model.SearchQuery&PageIndex=@(Model.PageIndex + 1)" class="console-btn secondary" style="padding:0 12px; font-size:13px;">Next</a>
                }
                <button type="submit" class="console-btn primary" style="padding:0 18px;">
                    <span class="material-symbols-outlined" style="font-size:18px;">group_add</span> Add Selected Members
                </button>
            </div>
        </div>
    </form>
</section>

@* ── Current Active Members List ── *@
<section class="m3-card bcp-card" style="width:100%; max-width:100%; box-sizing:border-box; overflow-x:hidden;">
    <div style="padding:16px 20px; border-bottom:1px solid var(--md-sys-color-outline);">
        <h3 class="bcp-section-title mb-0"><span class="material-symbols-outlined">group</span> Current Active Members (@Model.Members.Count)</h3>
    </div>
    <div class="bcp-table-wrap">
        <table class="bcp-table">
            <thead>
                <tr>
                    <th style="width:40%;">Member Name</th>
                    <th style="width:20%;">Role</th>
                    <th style="width:20%;">Status</th>
                    <th style="width:20%;">Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Members)
                {
                    <tr>
                        <td>
                            <span class="bcp-member-name">@m.UserProfile?.FullName</span>
                            <span class="bcp-member-email">@m.UserProfile?.Email</span>
                        </td>
                        <td><span class="bcp-badge">@m.GroupRole</span></td>
                        <td>
                            @if (m.IsSuspended) { <span class="bcp-badge danger">Suspended</span> }
                            else if (m.IsMuted) { <span class="bcp-badge warning">Muted</span> }
                            else { <span class="bcp-badge success">Active</span> }
                        </td>
                        <td style="font-size:12px; color:var(--sidebar-color);">@m.DateJoined.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<script>
    function toggleAllUserCheckboxes(master) {
        const checks = document.querySelectorAll('.user-select-check');
        checks.forEach(c => c.checked = master.checked);
    }

    function previewUpload(input, previewId, isAvatar) {
        if (input.files && input.files[0]) {
            const zone = input.closest('.bcp-upload-zone');
            let img = zone.querySelector('.bcp-upload-preview');
            if (!img) {
                // Replace the placeholder icon with an img
                const icon = zone.querySelector('.material-symbols-outlined');
                if (icon) {
                    img = document.createElement('img');
                    img.className = 'bcp-upload-preview' + (isAvatar ? ' avatar' : '');
                    icon.replaceWith(img);
                }
            }
            if (img) {
                img.src = URL.createObjectURL(input.files[0]);
            }
            // Update the label
            const label = zone.querySelector('.upload-label');
            if (label) label.textContent = input.files[0].name;
        }
    }

    // Drag-and-drop enhancement
    document.querySelectorAll('.bcp-upload-zone').forEach(zone => {
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('dragover'); });
        zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.classList.remove('dragover');
            const input = zone.querySelector('input[type="file"]');
            if (input && e.dataTransfer.files.length) {
                input.files = e.dataTransfer.files;
                const isAvatar = input.id === 'avatarFileInput';
                previewUpload(input, '', isAvatar);
            }
        });
    });
</script>
