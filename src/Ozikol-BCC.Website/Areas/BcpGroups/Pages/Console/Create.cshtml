@page
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Console.CreateModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Create Group";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Committees & Groups",
    Title = "Create New Group",
    Subtitle = "Setup a new committee, department, or team workspace with custom rules and operational hours.",
    Icon = "add_circle",
    BackUrl = "/BcpGroups/Console/Groups",
    BackText = "Groups"
})

<form method="post" class="m3-card bcp-card" style="width: 100%; max-width: 100%; box-sizing: border-box; overflow-x: hidden;">
    <div asp-validation-summary="ModelOnly" class="bcp-validation-summary"></div>

    <h3 class="bcp-section-title"><span class="material-symbols-outlined">info</span> Group Profile</h3>
    <div class="bcp-form-grid">
        <label class="bcp-field">
            Group Title *
            <input class="bcp-input" asp-for="Group.Title" placeholder="e.g. Executive Committee, IT Support Team..." required />
            <span asp-validation-for="Group.Title" class="bcp-validation-msg"></span>
        </label>

        <label class="bcp-field">
            Description
            <input class="bcp-input" asp-for="Group.Description" placeholder="Describe the purpose of this group..." />
        </label>

        <label class="bcp-field">
            Group Type
            <select class="bcp-input bcp-select" asp-for="Group.GroupType" asp-items="Html.GetEnumSelectList<Ozikol_BCC.Domain.Enum.Enum.BcpGroupType>()"></select>
        </label>

        <label class="bcp-field">
            Visibility
            <select class="bcp-input bcp-select" asp-for="Group.Visibility" asp-items="Html.GetEnumSelectList<Ozikol_BCC.Domain.Enum.Enum.BcpGroupVisibility>()"></select>
        </label>

        <label class="bcp-field">
            Chat Mode
            <select class="bcp-input bcp-select" asp-for="Group.ChatMode" asp-items="Html.GetEnumSelectList<Ozikol_BCC.Domain.Enum.Enum.BcpGroupChatMode>()"></select>
        </label>

        <label class="bcp-field">
            Max Members (Leave empty for unlimited)
            <input class="bcp-input" asp-for="Group.MaxMembers" type="number" placeholder="Unlimited" />
        </label>

        <div class="bcp-field-full mt-2">
            <label class="bcp-check">
                <input type="checkbox" asp-for="Group.AllowGuestAccess" />
                <span>Allow Guest Access (External Users)</span>
            </label>
        </div>
    </div>

    <h3 class="bcp-section-title mt-4"><span class="material-symbols-outlined">schedule</span> Operational Hours</h3>
    <div class="bcp-form-grid">
        <div class="bcp-field-full mb-2">
            <label class="bcp-check">
                <input type="checkbox" asp-for="Group.IsAlwaysOpen" id="isAlwaysOpenToggle" />
                <span>Always Open (24/7 Operational Hours)</span>
            </label>
        </div>

        <div id="hoursSchedule" class="bcp-field-full bcp-subgrid" style="display:none;">
            <label class="bcp-field">
                Operational Days
                <input class="bcp-input" asp-for="Group.OperationalDays" placeholder="Mon,Tue,Wed,Thu,Fri" />
            </label>
            <label class="bcp-field">
                Opening Time
                <input class="bcp-input" asp-for="Group.OpenTime" type="time" />
            </label>
            <label class="bcp-field">
                Closing Time
                <input class="bcp-input" asp-for="Group.CloseTime" type="time" />
            </label>
            <label class="bcp-field bcp-field-full">
                Closed Message (Auto-reply outside hours)
                <input class="bcp-input" asp-for="Group.ClosedMessage" placeholder="This group chat is currently closed." />
            </label>
        </div>
    </div>

    <h3 class="bcp-section-title mt-4"><span class="material-symbols-outlined">tune</span> Chat Rules & Privacy Configuration</h3>
    <div class="bcp-form-grid">
        <label class="bcp-field">
            Edit Window (minutes)
            <input class="bcp-input" asp-for="Group.EditWindowMinutes" type="number" />
        </label>

        <label class="bcp-field">
            Delete Window (minutes)
            <input class="bcp-input" asp-for="Group.DeleteWindowMinutes" type="number" />
        </label>

        <label class="bcp-field">
            Auto-Convert Text Threshold (chars)
            <input class="bcp-input" asp-for="Group.AutoConvertThreshold" type="number" />
            <small class="bcp-help-text">Texts over this length auto-convert to .txt download</small>
        </label>

        <label class="bcp-field">
            Rate Limit (messages per min)
            <input class="bcp-input" asp-for="Group.RateLimitPerMinute" type="number" />
        </label>

        <div class="bcp-field-full d-flex flex-wrap gap-3 mt-3" style="max-width: 100%; box-sizing: border-box;">
            <label class="bcp-check">
                <input type="checkbox" asp-for="Group.ReadReceiptsEnabled" />
                <span>Enable Read Receipts (Blue Ticks)</span>
            </label>

            <label class="bcp-check">
                <input type="checkbox" asp-for="Group.TypingIndicatorsEnabled" />
                <span>Enable Typing Indicators</span>
            </label>

            <label class="bcp-check">
                <input type="checkbox" asp-for="Group.LastSeenEnabled" />
                <span>Enable Member "Last Seen" Timestamps</span>
            </label>
        </div>
    </div>

    <div class="bcp-form-actions mt-4">
        <button class="console-btn primary bcp-form-submit" type="submit">
            <span class="material-symbols-outlined">save</span> Create Group
        </button>
        <a class="console-btn secondary" href="/BcpGroups/Console/Groups">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        const toggle = document.getElementById('isAlwaysOpenToggle');
        const sched = document.getElementById('hoursSchedule');
        function updateSched() {
            if (toggle && sched) {
                sched.style.display = toggle.checked ? 'none' : 'grid';
            }
        }
        if (toggle) {
            toggle.addEventListener('change', updateSched);
            updateSched();
        }
    </script>
}
