@page
@model Ozikol_BCC.Website.Areas.BcpGroups.Pages.Console.DashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Groups Console Dashboard";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Committees & Groups",
    Title = "Groups Console Dashboard",
    Subtitle = "Executive view for group engagement trends, peak chat hours, storage, and compliance.",
    Icon = "hub",
    BackUrl = "/BcpConsole/Console/Dashboard",
    Buttons =
    [
        new("Create Group", "/BcpGroups/Console/Create", "add_circle", true),
        new("Group Directory", "/BcpGroups/Console/Groups", "groups"),
        new("Audit Trail", "/BcpGroups/Console/AuditLog", "shield_check")
    ]
})

<section class="console-grid">
    <!-- Row 1: Full-Width Overview Metrics Widget -->
    <article class="console-widget span-12" data-widget="groups-overview" data-title="Groups Management Overview">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined drag-dot">drag_indicator</span>
                <h2 class="widget-title">Groups & Chat Management Overview</h2>
            </div>
        </div>
        <div class="widget-body">
            <div class="metric-grid">
                <a class="metric-card" href="/BcpGroups/Console/Groups">
                    <div class="metric-label">Total Groups</div>
                    <div class="metric-value">@Model.TotalGroups</div>
                    <div class="metric-note">@Model.ActiveGroups active spaces</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Console/Groups?filter=active">
                    <div class="metric-label">Active Groups</div>
                    <div class="metric-value">@Model.ActiveGroups</div>
                    <div class="metric-note">Operational rate 91.6%</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Console/Groups">
                    <div class="metric-label">Total Members</div>
                    <div class="metric-value">@Model.TotalMembers</div>
                    <div class="metric-note">Across all group spaces</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Console/Groups">
                    <div class="metric-label">Messages Today</div>
                    <div class="metric-value">@Model.MessagesToday</div>
                    <div class="metric-note">Past 24 hours</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Console/Groups">
                    <div class="metric-label">Shared Media</div>
                    <div class="metric-value">@Model.FilesShared</div>
                    <div class="metric-note">Cloudinary media assets</div>
                </a>
                <a class="metric-card" href="/BcpGroups/Console/Groups">
                    <div class="metric-label">Active Guests</div>
                    <div class="metric-value">@Model.ActiveGuests</div>
                    <div class="metric-note">External contractor accounts</div>
                </a>
            </div>
        </div>
    </article>

    <!-- Row 2: Charts (8 Cols Line Chart + 4 Cols Donut Chart) -->
    <article class="console-widget span-8" data-widget="message-trend-chart" data-title="Message Trend">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-primary">show_chart</span>
                <h2 class="widget-title">30-Day Message & Media Activity Trend</h2>
            </div>
        </div>
        <div class="widget-body">
            <canvas id="messageTrendChart" style="max-height: 260px;"></canvas>
        </div>
    </article>

    <article class="console-widget span-4" data-widget="group-type-chart" data-title="Group Breakdown">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-info">donut_large</span>
                <h2 class="widget-title">Group Types Breakdown</h2>
            </div>
        </div>
        <div class="widget-body">
            <canvas id="groupTypeChart" style="max-height: 260px;"></canvas>
        </div>
    </article>

    <!-- Row 3: Leaderboard (8 Cols) + Operational Hours (4 Cols) -->
    <article class="console-widget span-8" data-widget="top-groups-leaderboard" data-title="Leaderboard">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-warning">local_fire_department</span>
                <h2 class="widget-title">Most Active Groups Leaderboard</h2>
            </div>
            <a class="info-link" href="/BcpGroups/Console/Groups">View All</a>
        </div>
        <div class="widget-body p-0">
            <div class="bcp-table-wrap">
                <table class="bcp-table">
                    <thead>
                        <tr>
                            <th style="width:50px;">Rank</th>
                            <th>Group Name</th>
                            <th>Type</th>
                            <th>Members</th>
                            <th>Msgs Today</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.TopGroups.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted">No group activity recorded yet. <a href="/BcpGroups/Console/Create">Create First Group</a></td></tr>
                        }
                        @{ int rank = 1; }
                        @foreach (var g in Model.TopGroups)
                        {
                            <tr>
                                <td><span class="bcp-badge warning">#@rank</span></td>
                                <td>
                                    <span class="bcp-member-name">@g.Title</span>
                                    <span class="bcp-member-email">@(string.IsNullOrWhiteSpace(g.CloudinaryFolder) ? "auto-created" : g.CloudinaryFolder)</span>
                                </td>
                                <td><span class="bcp-badge">@g.GroupType</span></td>
                                <td>@g.MemberCount</td>
                                <td><strong style="color:var(--sidebar-active-color);">@g.MessageCount</strong></td>
                                <td style="text-align:right;">
                                    <div class="bcp-table-actions" style="justify-content:flex-end;">
                                        <a class="console-btn" href="/BcpGroups/Console/Details/@g.Id"><span class="material-symbols-outlined">visibility</span>View</a>
                                        <a class="console-btn" href="/BcpGroups/Console/Edit/@g.Id"><span class="material-symbols-outlined">edit</span>Edit</a>
                                    </div>
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </article>

    <article class="console-widget span-4" data-widget="operational-status" data-title="Status">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-primary">schedule</span>
                <h2 class="widget-title">Operational Hours & Moderation</h2>
            </div>
        </div>
        <div class="widget-body" style="display:grid; gap:16px;">
            <div style="display:grid; gap:8px; padding:14px; background:var(--md-sys-color-surface-variant); border-radius:8px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:13px; display:inline-flex; align-items:center; gap:6px;">🟢 Always Open (24/7)</span>
                    <strong style="font-size:14px;">@Model.AlwaysOpenCount</strong>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:13px; display:inline-flex; align-items:center; gap:6px;">🟡 Scheduled Hours</span>
                    <strong style="font-size:14px;">@Model.ScheduledHoursCount</strong>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:13px; display:inline-flex; align-items:center; gap:6px;">🔴 Currently Closed</span>
                    <strong style="font-size:14px; color:var(--md-sys-color-error);">@Model.CurrentlyClosedCount</strong>
                </div>
            </div>

            <div>
                <h4 style="font-size:13px; font-weight:700; margin:0 0 10px;">Moderation Summary</h4>
                <div style="display:grid; gap:6px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border:1px solid var(--md-sys-color-outline); border-radius:8px;">
                        <span style="font-size:12px; font-weight:600;">Locked Groups (Admin Only)</span>
                        <span class="bcp-badge danger">@Model.LockedGroupsCount</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border:1px solid var(--md-sys-color-outline); border-radius:8px;">
                        <span style="font-size:12px; font-weight:600;">Muted Members</span>
                        <span class="bcp-badge warning">@Model.MutedMembersCount</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border:1px solid var(--md-sys-color-outline); border-radius:8px;">
                        <span style="font-size:12px; font-weight:600;">Suspended Members</span>
                        <span class="bcp-badge">@Model.SuspendedMembersCount</span>
                    </div>
                </div>
            </div>
        </div>
    </article>

    <!-- Row 4: Peak Hours Heatmap (6 Cols) + Compliance Audit (6 Cols) -->
    <article class="console-widget span-6" data-widget="peak-hours-heatmap" data-title="Peak Hours">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-warning">access_time_filled</span>
                <h2 class="widget-title">Peak Activity Hourly Heatmap (24h)</h2>
            </div>
        </div>
        <div class="widget-body">
            <canvas id="hourlyHeatmapChart" style="max-height:220px;"></canvas>
        </div>
    </article>

    <article class="console-widget span-6" data-widget="audit-log" data-title="Audit Log">
        <div class="widget-head">
            <div class="widget-title-wrap">
                <span class="material-symbols-outlined text-info">verified_user</span>
                <h2 class="widget-title">Real-Time Compliance Audit Log</h2>
            </div>
        </div>
        <div class="widget-body p-0">
            <div class="bcp-table-wrap">
                <table class="bcp-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Action</th>
                            <th>Details</th>
                            <th style="text-align:right;">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentAuditLogs.Any())
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted">No moderation audit entries recorded yet.</td></tr>
                        }
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td><strong style="font-size:12px;">@(log.User?.FullName ?? "System")</strong></td>
                                <td><span class="bcp-badge">@log.Action</span></td>
                                <td style="font-size:12px; color:var(--sidebar-color);">@log.Details</td>
                                <td style="text-align:right; font-size:11px; color:var(--sidebar-color);">@log.Timestamp.ToString("yyyy-MM-dd HH:mm") UTC</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </article>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 1. Message Trend Line Chart
        const trendCtx = document.getElementById('messageTrendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Model.TrendDatesJson),
                datasets: [
                    {
                        label: 'Total Messages',
                        data: @Html.Raw(Model.TrendMessagesJson),
                        borderColor: '#4e73df',
                        backgroundColor: 'rgba(78, 115, 223, 0.05)',
                        fill: true,
                        tension: 0.3
                    },
                    {
                        label: 'Shared Media',
                        data: @Html.Raw(Model.TrendFilesJson),
                        borderColor: '#1cc88a',
                        backgroundColor: 'transparent',
                        borderDash: [5, 5]
                    }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // 2. Group Type Donut Chart
        const donutCtx = document.getElementById('groupTypeChart').getContext('2d');
        new Chart(donutCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Model.GroupTypeLabelsJson),
                datasets: [{
                    data: @Html.Raw(Model.GroupTypeDataJson),
                    backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#858796']
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

        // 3. Peak Hours Bar Chart
        const heatmapCtx = document.getElementById('hourlyHeatmapChart').getContext('2d');
        const hoursLabels = Array.from({length: 24}, (_, i) => `${i}:00`);
        new Chart(heatmapCtx, {
            type: 'bar',
            data: {
                labels: hoursLabels,
                datasets: [{
                    label: 'Messages Sent',
                    data: @Html.Raw(Model.HourlyHeatmapDataJson),
                    backgroundColor: '#f6c23e'
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
    </script>
}
