@page
@model DashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Console";
}

<section class="console-alert" data-tour="console-alert">
    <div>
        <strong>Platform console home</strong>
        <p>Monitor active features, inactive setup work, billing, security, reports, recommendations, and system health from one place.</p>
    </div>
    <button class="console-btn" type="button" data-action="Open console setup guide">
        <span class="material-symbols-outlined">rocket_launch</span>
        Setup guide
    </button>
</section>

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Command Center",
    Title = "Console Home",
    Subtitle = "Overall dashboard for the Ozikol Business Command Platform and all feature dashboards.",
    Icon = "space_dashboard",
    Buttons =
    [
        new("Add Widgets", "javascript:void(0)", "widgets", true) { AriaLabel = "Add widgets" },
        new("Reset Layout", "javascript:void(0)", "restart_alt"),
        new("Feature Setup", "/BcpUserManagement/Console/FeatureAccess", "toggle_on")
    ]
})


@if (!Model.DatabaseReady)
{
    <section class="console-alert danger">
        <div>
            <strong>Database unavailable</strong>
            <p>Run the tenant migrator and refresh this page before using the console dashboard.</p>
        </div>
    </section>
}

<section class="console-grid" data-tour="console-widget-grid">
    <article class="console-widget span-12" data-widget="overview" data-title="Platform Overview">
        <div class="widget-head">
            <div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Platform overview</h2><a class="info-link" href="javascript:void(0)">Info</a></div>
            <div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button" title="Minimize"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button" title="Dismiss"><span class="material-symbols-outlined">close</span></button></div>
        </div>
        <div class="widget-body">
            <div class="metric-grid">
                <a class="metric-card" href="/BcpConsole/Console/Dashboard"><div class="metric-label">Active features</div><div class="metric-value">@Model.ActiveFeatures / @Model.TotalCatalogFeatures</div><div class="metric-note">@Model.NeedsSetupFeatures features need setup</div></a>
                <a class="metric-card" href="/BcpConsole/Console/Dashboard"><div class="metric-label">Inactive</div><div class="metric-value">@Model.InactiveFeatures</div><div class="metric-note">@Model.SuspendedFeatures suspended</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/Users"><div class="metric-label">Users</div><div class="metric-value">@Model.TotalUsers / @Model.MaximumUsers</div><div class="metric-note">@Model.PendingUsers pending approval</div></a>
                <a class="metric-card" href="/BcpConsole/Console/Dashboard"><div class="metric-label">Current bill</div><div class="metric-value">@Model.CurrencyCode @Model.CurrentBill.ToString("0.##")</div><div class="metric-note">Forecast @Model.CurrencyCode @Model.ForecastBill.ToString("0.##")</div></a>
                <a class="metric-card" href="/BcpConsole/Console/Dashboard"><div class="metric-label">Needs attention</div><div class="metric-value">@Model.AttentionCount</div><div class="metric-note">Setup, providers, security</div></a>
                <a class="metric-card" href="/BcpConsole/Console/Dashboard"><div class="metric-label">System health</div><div class="metric-value">@Model.HealthScore%</div><div class="metric-note">@Model.DatabaseStatus database</div></a>
            </div>
        </div>
    </article>

    <article class="console-widget span-6" data-widget="recent" data-title="Recently Visited">
        <div class="widget-head">
            <div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Recently visited</h2><a class="info-link" href="javascript:void(0)">Info</a></div>
            <div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button" title="Minimize"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button" title="Dismiss"><span class="material-symbols-outlined">close</span></button></div>
        </div>
        <div class="widget-body"><div class="list-stack">@foreach (var item in Model.RecentVisits) { <a class="list-row" href="@item.Url"><span class="list-icon @item.Tone"><span class="material-symbols-outlined">@item.Icon</span></span><div class="row-main"><div class="row-title">@item.Title</div><div class="row-sub">@item.Subtitle</div></div></a> }</div></div>
        <div class="widget-footer"><a href="/BcpConsole/Console/Dashboard">View console history</a></div>
    </article>

    <article class="console-widget span-6" data-widget="features" data-title="Feature Status">
        <div class="widget-head">
            <div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Feature status</h2><a class="info-link" href="javascript:void(0)">Info</a></div>
            <div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button" title="Minimize"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button" title="Dismiss"><span class="material-symbols-outlined">close</span></button></div>
        </div>
        <div class="widget-body">
            <div class="feature-toolbar">
                <button class="feature-tab active" type="button" data-feature-filter="all">All @Model.TotalCatalogFeatures</button>
                <button class="feature-tab" type="button" data-feature-filter="active">Active</button>
                <button class="feature-tab" type="button" data-feature-filter="setup">Needs setup</button>
                <button class="feature-tab" type="button" data-feature-filter="inactive">Inactive</button>
                <button class="feature-tab" type="button" data-feature-filter="locked">Locked</button>
            </div>
            <div class="feature-list">
                @foreach (var feature in Model.FeatureRows)
                {
                    <a class="feature-row" data-status="@feature.Status" href="@feature.Url">
                        <span class="feature-icon"><span class="material-symbols-outlined">@feature.Icon</span></span>
                        <span class="row-main"><span class="row-title">@feature.Title</span><span class="row-sub">@feature.Subtitle</span></span>
                        <span class="status-pill @feature.PillClass">@feature.StatusLabel</span>
                    </a>
                }
            </div>
        </div>
        <div class="widget-footer"><a href="/BcpConsole/Console/Dashboard">Go to feature center</a></div>
    </article>

    <article class="console-widget span-4" data-widget="attention" data-title="Attention Required">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Attention required</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body"><div class="recommendation-list">@foreach (var item in Model.AttentionItems) { <a class="recommendation" href="@item.Url"><span class="list-icon @item.Tone"><span class="material-symbols-outlined">@item.Icon</span></span><span class="row-main"><span class="row-title">@item.Title</span><span class="row-sub">@item.Subtitle</span></span></a> }</div></div>
    </article>

    <article class="console-widget span-4" data-widget="health" data-title="System Health">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">System health</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body">
            <div class="list-stack">
                <div class="list-row"><div class="row-main"><div class="row-title">Database</div><div class="progress-track"><div class="progress-fill" style="--value:@(Model.DatabaseReady ? 100 : 10)%; background:@(Model.DatabaseReady ? "#22c55e" : "#ef4444");"></div></div></div><span class="status-pill @(Model.DatabaseReady ? "good" : "bad")">@Model.DatabaseStatus</span></div>
                <div class="list-row"><div class="row-main"><div class="row-title">Cache</div><div class="row-sub">@Model.RedisStatus</div></div><span class="status-pill @(Model.CacheProvider == "Redis" ? "good" : "info")">@Model.CacheProvider</span></div>
                <div class="list-row"><div class="row-main"><div class="row-title">Email</div><div class="row-sub">Provider readiness</div></div><span class="status-pill @(Model.EmailStatus == "Configured" ? "good" : "bad")">@Model.EmailStatus</span></div>
                <div class="list-row"><div class="row-main"><div class="row-title">SMS</div><div class="row-sub">Messaging readiness</div></div><span class="status-pill @(Model.SmsStatus == "Configured" ? "good" : "warn")">@Model.SmsStatus</span></div>
                <div class="list-row"><div class="row-main"><div class="row-title">Payment</div><div class="row-sub">Billing readiness</div></div><span class="status-pill @(Model.PaymentStatus == "Configured" ? "good" : "warn")">@Model.PaymentStatus</span></div>
            </div>
        </div>
    </article>

    <article class="console-widget span-4" data-widget="security" data-title="Security">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Security</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body">
            <div class="two-col">
                <a class="metric-card" href="/BcpIdentity/Console/Dashboard"><div class="metric-label">2FA users</div><div class="metric-value">@Model.TwoFactorUsers</div><div class="metric-note">Enabled accounts</div></a>
                <a class="metric-card" href="/BcpIdentity/Console/LockedAccounts"><div class="metric-label">Locked</div><div class="metric-value">@Model.LockedAccounts</div><div class="metric-note">Current lockouts</div></a>
                <a class="metric-card" href="/BcpIdentity/Console/Dashboard"><div class="metric-label">Confirmed</div><div class="metric-value">@Model.ConfirmedEmailUsers</div><div class="metric-note">Email confirmed</div></a>
                <a class="metric-card" href="/BcpIdentity/Console/LoginAudit"><div class="metric-label">Audit</div><div class="metric-value">@Model.AttentionCount</div><div class="metric-note">Signals to inspect</div></a>
            </div>
        </div>
        <div class="widget-footer"><a href="/BcpIdentity/Console/Dashboard">Go to Identity dashboard</a></div>
    </article>

    <article class="console-widget span-6" data-widget="billing" data-title="Billing and Usage">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Billing and usage</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body billing-layout">
            <div><div class="metric-label">Current month</div><div class="billing-amount">@Model.CurrencyCode @Model.CurrentBill.ToString("0.##") <span class="status-pill muted">0%</span></div><div class="metric-label">Forecasted month end</div><div class="billing-amount">@Model.CurrencyCode @Model.ForecastBill.ToString("0.##") <span class="status-pill muted">0%</span></div><div style="margin-top:10px;"><a class="console-link" href="/BcpConsole/Console/Dashboard">Savings opportunities: not enabled</a></div></div>
            <div class="bar-chart" aria-label="Monthly cost chart"><div class="bar" style="height:35%; --fill: 85%;"><span>Feb</span></div><div class="bar" style="height:42%; --fill: 87%;"><span>Mar</span></div><div class="bar" style="height:48%; --fill: 88%;"><span>Apr</span></div><div class="bar" style="height:52%; --fill: 90%;"><span>May</span></div><div class="bar" style="height:58%; --fill: 91%;"><span>Jun</span></div><div class="bar" style="height:64%; --fill: 92%;"><span>Jul</span></div></div>
        </div>
    </article>

    <article class="console-widget span-6" data-widget="reports" data-title="Reports">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Reports</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body"><div class="list-stack">@foreach (var item in Model.Reports) { <a class="list-row" href="@item.Url"><span class="list-icon @item.Tone"><span class="material-symbols-outlined">@item.Icon</span></span><span class="row-main"><span class="row-title">@item.Title</span><span class="row-sub">@item.Subtitle</span></span><span class="status-pill info">Preview</span></a> }</div></div>
    </article>

    <article class="console-widget span-4" data-widget="recommendations" data-title="Recommendations">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Recommendations</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body"><div class="recommendation-list">@foreach (var item in Model.Recommendations) { <a class="recommendation" href="@item.Url"><span class="list-icon @item.Tone"><span class="material-symbols-outlined">@item.Icon</span></span><span class="row-main"><span class="row-title">@item.Title</span><span class="row-sub">@item.Subtitle</span></span></a> }</div></div>
    </article>

    <article class="console-widget span-4" data-widget="announcements" data-title="Announcements">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Latest announcements</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body"><div class="list-stack">@foreach (var item in Model.Announcements) { <a class="list-row" href="@item.Url"><span class="list-icon @item.Tone"><span class="material-symbols-outlined">@item.Icon</span></span><span class="row-main"><span class="row-title">@item.Title</span><span class="row-sub">@item.Subtitle</span></span></a> }</div></div>
    </article>

    <article class="console-widget span-4" data-widget="quick-actions" data-title="Quick Actions">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Quick actions</h2></div><div class="widget-actions"><button class="widget-icon-btn minimize-widget" type="button"><span class="material-symbols-outlined">remove</span></button><button class="widget-icon-btn dismiss-widget" type="button"><span class="material-symbols-outlined">close</span></button></div></div>
        <div class="widget-body">
            <div class="quick-grid">
                <a class="quick-action" href="/BcpUserManagement/Console/Create"><span class="material-symbols-outlined">person_add</span><span>Create user</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/Dashboard"><span class="material-symbols-outlined">groups</span><span>User management</span></a>
                <a class="quick-action" href="/BcpIdentity/Console/Dashboard"><span class="material-symbols-outlined">admin_panel_settings</span><span>Identity</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/FeatureAccess"><span class="material-symbols-outlined">verified_user</span><span>Feature access</span></a>
                <a class="quick-action" href="/BcpConsole/Console/Dashboard"><span class="material-symbols-outlined">receipt_long</span><span>Billing</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/ActivityLogs"><span class="material-symbols-outlined">manage_search</span><span>Audit logs</span></a>
                <a class="quick-action" href="/BcpConsole/Console/Dashboard"><span class="material-symbols-outlined">health_and_safety</span><span>System health</span></a>
                <a class="quick-action" href="/Setup"><span class="material-symbols-outlined">rocket_launch</span><span>Setup guide</span></a>
            </div>
        </div>
    </article>
</section>

<div class="drawer" id="widget-drawer" aria-hidden="true">
    <div class="drawer-panel">
        <div class="drawer-head">
            <div>
                <h2 class="widget-title" style="font-size:18px;">Add widgets</h2>
                <p class="console-subtitle">Restore dismissed widgets or reset the console layout.</p>
            </div>
            <button class="widget-icon-btn" type="button" id="close-drawer" title="Close"><span class="material-symbols-outlined">close</span></button>
        </div>
        <div class="list-stack" id="restore-list"></div>
    </div>
</div>

<div class="toast" id="console-toast" role="status" aria-live="polite"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const storageKey = 'bcpConsoleWidgetState';
        const widgets = Array.from(document.querySelectorAll('.console-widget'));
        const drawer = document.getElementById('widget-drawer');
        const restoreList = document.getElementById('restore-list');
        const toast = document.getElementById('console-toast');
        let toastTimer;

        const headerButtons = Array.from(document.querySelectorAll('.bcp-page-actions a, .bcp-page-actions span'));
        const addWidgetsButton = headerButtons.find(x => x.textContent.trim().includes('Add Widgets'));
        const resetLayoutButton = headerButtons.find(x => x.textContent.trim().includes('Reset Layout'));

        function getState() {
            try {
                return JSON.parse(localStorage.getItem(storageKey)) || {};
            } catch {
                return {};
            }
        }

        function saveState(state) {
            localStorage.setItem(storageKey, JSON.stringify(state));
        }

        function showToast(message) {
            if (!toast) return;
            clearTimeout(toastTimer);
            toast.textContent = message;
            toast.classList.add('show');
            toastTimer = setTimeout(() => toast.classList.remove('show'), 1800);
        }

        function renderRestoreList() {
            if (!restoreList) return;
            const state = getState();
            const hiddenWidgets = widgets.filter(widget => state[widget.dataset.widget]?.hidden);
            restoreList.innerHTML = '';

            if (!hiddenWidgets.length) {
                restoreList.innerHTML = '<div class="bcp-muted">All widgets are visible.</div>';
                return;
            }

            hiddenWidgets.forEach(widget => {
                const row = document.createElement('button');
                row.type = 'button';
                row.className = 'quick-action';
                row.innerHTML = `<span class="material-symbols-outlined">add</span><span>${widget.dataset.title}</span>`;
                row.addEventListener('click', () => updateWidgetState(widget, { hidden: false, minimized: false }));
                restoreList.appendChild(row);
            });
        }

        function applyState() {
            const state = getState();
            widgets.forEach(widget => {
                const widgetState = state[widget.dataset.widget] || {};
                widget.classList.toggle('hidden-widget', !!widgetState.hidden);
                widget.classList.toggle('minimized', !!widgetState.minimized);
                const icon = widget.querySelector('.minimize-widget .material-symbols-outlined');
                if (icon) icon.textContent = widgetState.minimized ? 'add' : 'remove';
            });
            renderRestoreList();
        }

        function updateWidgetState(widget, patch) {
            const state = getState();
            const id = widget.dataset.widget;
            state[id] = { ...(state[id] || {}), ...patch };
            saveState(state);
            applyState();
            showToast(`${widget.dataset.title} updated`);
        }

        widgets.forEach(widget => {
            widget.querySelector('.minimize-widget')?.addEventListener('click', () => {
                updateWidgetState(widget, { minimized: !widget.classList.contains('minimized') });
            });

            widget.querySelector('.dismiss-widget')?.addEventListener('click', () => {
                updateWidgetState(widget, { hidden: true });
            });
        });

        document.querySelectorAll('[data-feature-filter]').forEach(button => {
            button.addEventListener('click', () => {
                const filter = button.dataset.featureFilter;
                document.querySelectorAll('[data-feature-filter]').forEach(item => item.classList.remove('active'));
                button.classList.add('active');
                document.querySelectorAll('.feature-row').forEach(row => {
                    row.style.display = filter === 'all' || row.dataset.status === filter ? 'flex' : 'none';
                });
            });
        });

        addWidgetsButton?.addEventListener('click', event => {
            event.preventDefault();
            drawer?.classList.add('open');
            drawer?.setAttribute('aria-hidden', 'false');
            renderRestoreList();
        });

        resetLayoutButton?.addEventListener('click', event => {
            event.preventDefault();
            localStorage.removeItem(storageKey);
            applyState();
            showToast('Console layout reset');
        });

        document.getElementById('close-drawer')?.addEventListener('click', () => {
            drawer?.classList.remove('open');
            drawer?.setAttribute('aria-hidden', 'true');
        });

        drawer?.addEventListener('click', event => {
            if (event.target === drawer) {
                drawer.classList.remove('open');
                drawer.setAttribute('aria-hidden', 'true');
            }
        });

        applyState();
    });
</script>

<script type="application/json" id="bcp-page-tour">
[
  {"selector":"[data-tour='console-alert']","title":"Platform console","text":"This is the overall command center. It oversees BCP as a whole, while each feature keeps its own dashboard.","placement":"bottom"},
  {"selector":"[data-widget='overview']","title":"Platform overview","text":"The top widget summarizes features, users, billing, attention items, and system health.","placement":"bottom"},
  {"selector":"[data-widget='features']","title":"Feature status","text":"Use the status tabs to filter active, inactive, setup-required, and suspended feature modules.","placement":"left"},
  {"selector":"[data-widget='quick-actions']","title":"Quick actions","text":"Common admin commands stay grouped here for fast daily work.","placement":"top"}
]
</script>
