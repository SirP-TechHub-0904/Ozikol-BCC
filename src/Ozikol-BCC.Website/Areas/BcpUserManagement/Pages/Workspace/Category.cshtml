@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Workspace.CategoryModel
@attribute [Authorize]
@{
    ViewData["Title"] = "My Category";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel { Eyebrow = "Workspace", Title = "My Category", Subtitle = "Review the tenant category attached to your profile.", Icon = "category", BackUrl = "/BcpWorkspace/Workspace/Dashboard", Buttons = [new("Profile", "/BcpUserManagement/Workspace/Profile", "badge")] })
<section class="m3-card bcp-card" data-tour="workspace-category"><div class="card-header"><span class="card-title">Assigned Category</span></div><div class="metric-value">@(Model.UserProfile?.BcpUserCategory?.Name ?? "Uncategorized")</div><p class="metric-note">Admins manage user categories from Console.</p></section>
<script type="application/json" id="bcp-page-tour">[{"selector":"[data-tour='workspace-category']","title":"My category","text":"This label helps your organization group users for dashboards, reports, permissions, and workflows.","placement":"top"}]</script>
