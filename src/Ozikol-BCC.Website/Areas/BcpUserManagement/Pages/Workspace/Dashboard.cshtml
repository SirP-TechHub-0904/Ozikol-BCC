@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Workspace.DashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "My User Management";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Workspace",
    Title = "My User Management",
    Subtitle = "Your business profile, category, feature access, performance history, notes, and recent activity.",
    Icon = "person",
    BackUrl = "/BcpWorkspace/Workspace/Dashboard",
    Buttons =
    [
        new("Profile", "/BcpUserManagement/Workspace/Profile", "badge", true),
        new("Performance", "/BcpUserManagement/Workspace/Performance", "monitoring"),
        new("Feature Access", "/BcpUserManagement/Workspace/FeatureAccess", "verified_user")
    ]
})

@if (Model.UserProfile is not null)
{
    <partial name="/Areas/BcpUserManagement/Pages/Common/ProfileCard.cshtml" model="Model.UserProfile" />
}

<section class="dashboard-grid" data-tour="workspace-user-management-dashboard">
    <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Feature Access</span></div><div class="metric-value">@Model.FeatureRoleCount</div><p class="metric-note">Assigned BCP modules.</p></article>
    <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">KPI Records</span></div><div class="metric-value">@Model.PerformanceCount</div><p class="metric-note">Performance entries recorded for you.</p></article>
    <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Visible Notes</span></div><div class="metric-value">@Model.VisibleNoteCount</div><p class="metric-note">Notes your admins marked visible to you.</p></article>
</section>

<script type="application/json" id="bcp-page-tour">
[{"selector":"[data-tour='workspace-user-management-dashboard']","title":"Workspace dashboard","text":"This is the user-side dashboard for the User Management feature. It only shows the current user's own records.","placement":"bottom"}]
</script>
