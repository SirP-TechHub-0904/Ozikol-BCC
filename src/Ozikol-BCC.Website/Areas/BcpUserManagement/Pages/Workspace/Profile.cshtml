@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Workspace.ProfileModel
@attribute [Authorize]
@{
    ViewData["Title"] = "My Profile";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel { Eyebrow = "Workspace", Title = "My Profile", Subtitle = "Review your business profile fields. Security changes stay under Identity My Account.", Icon = "badge", BackUrl = "/BcpWorkspace/Workspace/Dashboard", Buttons = [new("Security", "/BcpIdentity/Workspace/Security", "shield_lock"), new("Change Password", "/BcpIdentity/Workspace/ChangePassword", "lock_reset")] })
@if (Model.UserProfile is not null)
{
    <partial name="/Areas/BcpUserManagement/Pages/Common/ProfileCard.cshtml" model="Model.UserProfile" />
    <section class="m3-card bcp-card" data-tour="workspace-profile-details"><div class="bcp-definition-list"><div><strong>Phone</strong><span>@Model.UserProfile.PhoneNumber</span></div><div><strong>Category</strong><span>@(Model.UserProfile.BcpUserCategory?.Name ?? "Uncategorized")</span></div><div><strong>Status</strong><span>@Model.UserProfile.UserStatus</span></div><div><strong>Last Login</strong><span>@(Model.UserProfile.LastLogin?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "Never")</span></div></div></section>
}
<script type="application/json" id="bcp-page-tour">[{"selector":"[data-tour='workspace-profile-details']","title":"Profile details","text":"Workspace users can review business profile data here. Admin edits happen in Console.","placement":"top"}]</script>
