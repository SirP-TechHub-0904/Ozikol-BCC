@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.NotesModel
@attribute [Authorize]
@{
    ViewData["Title"] = "User Notes";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel { Eyebrow = "Profiles", Title = "User Notes", Subtitle = "Add and review private or user-visible notes attached to a BCP profile.", Icon = "sticky_note_2", BackUrl = "/BcpUserManagement/Console/Dashboard", Buttons = [new("Users", "/BcpUserManagement/Console/Users", "groups")] })
<section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Choose User</span></div><form method="get" class="bcp-inline-form"><label class="bcp-field">User<select class="bcp-input bcp-select" name="profileId" asp-items="Model.UserOptions"></select></label><button class="console-btn primary" type="submit"><span class="material-symbols-outlined">search</span>Open Notes</button></form></section>
@if (!string.IsNullOrWhiteSpace(Model.ProfileId)) { <section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Add Note</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/AddNoteModal.cshtml" model="Model.ProfileId" /></section><partial name="/Areas/BcpUserManagement/Pages/Common/NoteList.cshtml" model="Model.Notes" /> }
<script type="application/json" id="bcp-page-tour">[{"selector":"[data-tour='add-note-form']","title":"Add note","text":"Notes are part of User Management. Private notes should never be shown in workspace pages.","placement":"bottom"},{"selector":"[data-tour='note-list']","title":"Notes","text":"Visible notes can be shown to the user; private notes stay in Console only.","placement":"top"}]</script>
