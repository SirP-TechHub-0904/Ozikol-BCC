@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.DetailsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "User Details";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "User Directory",
    Title = "User Details",
    Subtitle = "Review one user's profile, Identity roles, feature access, KPI history, notes, and audit trail.",
    Icon = "badge",
    BackUrl = "/BcpUserManagement/Console/Users",
    BackText = "Users",
    Buttons =
    [
        new("Edit", $"/BcpUserManagement/Console/Edit?id={Model.UserProfile?.Id}", "edit", true),
        new("Notes", $"/BcpUserManagement/Console/Notes?profileId={Model.UserProfile?.Id}", "sticky_note_2"),
        new("Performance", $"/BcpUserManagement/Console/Performance?profileId={Model.UserProfile?.Id}", "monitoring")
    ]
})

@if (Model.UserProfile is not null)
{
    <partial name="/Areas/BcpUserManagement/Pages/Common/ProfileCard.cshtml" model="Model.UserProfile" />

    <section class="dashboard-grid">
        <article class="m3-card bcp-card" data-tour="identity-roles"><div class="card-header"><span class="card-title">Identity Roles</span></div><div class="bcp-inline-badges">@foreach (var role in Model.IdentityRoles) { <partial name="/Areas/BcpUserManagement/Pages/Common/RoleBadge.cshtml" model="role" /> }</div></article>
        <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Email</span></div><div class="metric-value">@(Model.UserProfile.EmailConfirmed ? "✅ Verified" : "⚠️ Pending OTP")</div><p class="metric-note">@Model.UserProfile.Email</p></article>
        <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Phone Verification</span></div><div class="metric-value">@(Model.UserProfile.PhoneNumberConfirmed ? "✅ Verified" : (string.IsNullOrWhiteSpace(Model.UserProfile.PhoneNumber) ? "— Unset" : "⚠️ Pending OTP"))</div><p class="metric-note">@(Model.UserProfile.PhoneNumber ?? "No phone number")</p></article>
        <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Feature Access</span></div><div class="metric-value">@Model.FeatureRoles.Count</div><p class="metric-note">Feature-level BCP assignments.</p></article>
    </section>

    <section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Feature Access</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/FeatureAccessMatrix.cshtml" model="Model.FeatureRoles" /></section>
    <section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Performance History</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/PerformanceScoreTable.cshtml" model="Model.PerformanceScores" /></section>
    <section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Notes</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/AddNoteModal.cshtml" model="Model.UserProfile.Id" /><partial name="/Areas/BcpUserManagement/Pages/Common/NoteList.cshtml" model="Model.Notes" /></section>
}

<script type="application/json" id="bcp-page-tour">
[{"selector":"[data-tour='profile-card']","title":"Profile summary","text":"This is the business profile layer. Identity security details remain in the Identity feature.","placement":"bottom"},{"selector":"[data-tour='feature-access-matrix']","title":"Feature roles","text":"Feature access is independent per module so each BCP feature can stand alone.","placement":"top"}]
</script>
