@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.SendNotificationModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Send Notification";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "User Management",
    Title = "Send Notification",
    Subtitle = "Compose and send targeted notifications, emails, or SMS to individual users, selected users, or all users.",
    Icon = "campaign",
    BackUrl = "/BcpUserManagement/Console/Dashboard",
    Buttons =
    [
        new("Users", "/BcpUserManagement/Console/Users", "groups"),
    ]
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert" style="margin-bottom:20px; padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px;">
        <div>
            <strong>Status</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

<form method="post">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
        @* ── Left: Compose Message ───────────────────────────── *@
        <section class="m3-card bcp-card" style="padding:24px;">
            <div class="card-header" style="margin-bottom:16px;">
                <span class="card-title" style="font-size:18px; font-weight:600;">Compose Message</span>
            </div>

            <div style="display:grid; gap:16px;">
                <div>
                    <label style="font-weight:500; display:block; margin-bottom:6px;">Title / Subject</label>
                    <input asp-for="Title" placeholder="e.g. Important Update" required
                           style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" />
                </div>

                <div>
                    <label style="font-weight:500; display:block; margin-bottom:6px;">Message Body</label>
                    <textarea asp-for="Body" rows="6" placeholder="Type your message here..." required
                              style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); resize:vertical; font-family:inherit;"></textarea>
                </div>

                <div>
                    <label style="font-weight:600; display:block; margin-bottom:10px;">Delivery Channels</label>
                    <div style="display:flex; gap:20px; flex-wrap:wrap;">
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; padding:10px 16px; border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; background:var(--md-sys-color-surface-container);">
                            <input type="checkbox" asp-for="SendInApp" style="width:18px; height:18px; accent-color:var(--md-sys-color-primary);" />
                            <span class="material-symbols-outlined" style="font-size:20px; color:var(--md-sys-color-primary);">notifications</span>
                            <span>In-App Notification</span>
                        </label>
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; padding:10px 16px; border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; background:var(--md-sys-color-surface-container);">
                            <input type="checkbox" asp-for="SendEmail" style="width:18px; height:18px; accent-color:var(--md-sys-color-primary);" />
                            <span class="material-symbols-outlined" style="font-size:20px; color:var(--md-sys-color-primary);">email</span>
                            <span>Email</span>
                        </label>
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; padding:10px 16px; border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; background:var(--md-sys-color-surface-container);">
                            <input type="checkbox" asp-for="SendSms" style="width:18px; height:18px; accent-color:var(--md-sys-color-primary);" />
                            <span class="material-symbols-outlined" style="font-size:20px; color:var(--md-sys-color-primary);">sms</span>
                            <span>SMS</span>
                        </label>
                    </div>
                </div>
            </div>
        </section>

        @* ── Right: Recipients ───────────────────────────────── *@
        <section class="m3-card bcp-card" style="padding:24px;">
            <div class="card-header" style="margin-bottom:16px;">
                <span class="card-title" style="font-size:18px; font-weight:600;">Recipients</span>
            </div>

            <div style="display:grid; gap:16px;">
                <div style="display:flex; gap:12px;">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer; padding:10px 16px; border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; background:var(--md-sys-color-surface-container); flex:1;">
                        <input type="radio" asp-for="RecipientMode" value="all" id="mode-all" style="width:18px; height:18px; accent-color:var(--md-sys-color-primary);" />
                        <span class="material-symbols-outlined" style="font-size:20px; color:var(--md-sys-color-primary);">groups</span>
                        <div>
                            <strong style="display:block;">All Users</strong>
                            <small style="color:var(--sidebar-color);">Send to everyone (@Model.UserOptions.Count users)</small>
                        </div>
                    </label>
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer; padding:10px 16px; border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; background:var(--md-sys-color-surface-container); flex:1;">
                        <input type="radio" asp-for="RecipientMode" value="selected" id="mode-selected" style="width:18px; height:18px; accent-color:var(--md-sys-color-primary);" />
                        <span class="material-symbols-outlined" style="font-size:20px; color:var(--md-sys-color-primary);">person_search</span>
                        <div>
                            <strong style="display:block;">Selected Users</strong>
                            <small style="color:var(--sidebar-color);">Choose specific recipients</small>
                        </div>
                    </label>
                </div>

                <div id="user-selection-panel" style="display:none;">
                    <label style="font-weight:500; display:block; margin-bottom:6px;">Select Users</label>
                    <div style="max-height:280px; overflow-y:auto; border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; padding:8px;">
                        @foreach (var user in Model.UserOptions)
                        {
                            <label style="display:flex; align-items:center; gap:10px; padding:8px 12px; border-radius:6px; cursor:pointer; transition:background 0.15s;"
                                   onmouseover="this.style.background='var(--md-sys-color-surface-container)'"
                                   onmouseout="this.style.background='transparent'">
                                <input type="checkbox" name="SelectedUserIds" value="@user.Value"
                                       style="width:16px; height:16px; accent-color:var(--md-sys-color-primary);" />
                                <span style="font-size:14px;">@user.Text</span>
                            </label>
                        }
                    </div>
                    <small style="color:var(--sidebar-color); margin-top:6px; display:block;">Scroll to see more users. Check the ones you want to notify.</small>
                </div>
            </div>

            <div style="margin-top:20px; padding-top:16px; border-top:1px solid var(--md-sys-color-outline-variant);">
                <button type="submit" class="btn-custom active" style="padding:12px 24px; border-radius:8px; display:inline-flex; align-items:center; gap:8px; font-size:15px;">
                    <span class="material-symbols-outlined">send</span>
                    <span>Send Notification</span>
                </button>
            </div>
        </section>
    </div>
</form>

@* ── Recent Sent Notifications ──────────────────────────────── *@
@if (Model.RecentlySent.Count > 0)
{
    <section class="m3-card bcp-card" style="padding:24px; margin-top:20px;">
        <div class="card-header" style="margin-bottom:16px;">
            <span class="card-title" style="font-size:18px; font-weight:600;">Recently Sent</span>
        </div>
        <div class="list-stack">
            @foreach (var item in Model.RecentlySent)
            {
                <div class="list-row" style="padding:12px 0; border-bottom:1px solid var(--md-sys-color-outline-variant);">
                    <span class="list-icon" style="background:var(--md-sys-color-primary-container);">
                        <span class="material-symbols-outlined" style="color:var(--md-sys-color-primary);">@(item.Icon ?? "campaign")</span>
                    </span>
                    <span class="row-main">
                        <span class="row-title">@item.Title</span>
                        <span class="row-sub">@item.Message</span>
                    </span>
                    <span style="font-size:12px; color:var(--sidebar-color); white-space:nowrap;">
                        @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </span>
                    @if (item.IsBroadcast)
                    {
                        <span class="status-pill info" style="font-size:11px;">Broadcast</span>
                    }
                    else
                    {
                        <span class="status-pill" style="font-size:11px;">Individual</span>
                    }
                </div>
            }
        </div>
    </section>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modeAll = document.getElementById('mode-all');
        const modeSelected = document.getElementById('mode-selected');
        const panel = document.getElementById('user-selection-panel');

        function togglePanel() {
            panel.style.display = modeSelected && modeSelected.checked ? 'block' : 'none';
        }

        if (modeAll) modeAll.addEventListener('change', togglePanel);
        if (modeSelected) modeSelected.addEventListener('change', togglePanel);
        togglePanel();
    });
</script>
