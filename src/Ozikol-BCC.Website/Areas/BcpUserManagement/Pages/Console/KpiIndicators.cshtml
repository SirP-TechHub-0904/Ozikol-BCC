@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.KpiIndicatorsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "KPI Indicators";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel { Eyebrow = "Performance", Title = "KPI Indicators", Subtitle = "Define the measurements that User Management will score for users.", Icon = "add_chart", BackUrl = "/BcpUserManagement/Console/Dashboard", Buttons = [new("Performance", "/BcpUserManagement/Console/Performance", "monitoring", true)] })
<section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Add KPI Indicator</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/AddKpiIndicatorModal.cshtml" /></section>
<section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Indicators</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/KpiIndicatorTable.cshtml" model="Model.Indicators" /></section>
<script type="application/json" id="bcp-page-tour">[{"selector":"[data-tour='add-kpi-form']","title":"Define KPI","text":"Admins create the measurements first. Scores are entered later per user and period.","placement":"bottom"},{"selector":"[data-tour='kpi-indicator-table']","title":"KPI list","text":"Every indicator has a maximum score so performance percentages can be calculated consistently.","placement":"top"}]</script>
