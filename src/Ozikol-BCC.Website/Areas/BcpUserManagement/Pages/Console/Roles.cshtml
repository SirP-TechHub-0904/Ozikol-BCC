@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.RolesModel
@attribute [Authorize]
@{
    ViewData["Title"] = "User Management Roles";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel { Eyebrow = "Permissions", Title = "User Management Roles", Subtitle = "Review broad Identity roles and BCP feature roles side by side.", Icon = "admin_panel_settings", BackUrl = "/BcpUserManagement/Console/Dashboard", Buttons = [new("Identity Roles", "/BcpIdentity/Console/Roles", "shield_person"), new("Feature Access", "/BcpUserManagement/Console/FeatureAccess", "verified_user", true)] })

<section class="dashboard-grid" data-tour="roles-summary">
    <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Identity Roles</span></div><div class="metric-value">@Model.IdentityRoleCount</div><p class="metric-note">Broad authentication/authorization roles.</p></article>
    <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Feature Assignments</span></div><div class="metric-value">@Model.FeatureRoleCount</div><p class="metric-note">Per-feature BCP access rows.</p></article>
    <article class="m3-card bcp-card"><div class="card-header"><span class="card-title">Editors</span></div><div class="metric-value">@Model.EditorCount</div><p class="metric-note">Global or feature editors in User Management.</p></article>
</section>

<section class="m3-card bcp-card"><div class="card-header"><span class="card-title">BCP Action Roles</span></div><div class="bcp-definition-list"><div><strong>GlobalEditor</strong><span>Can manage assigned BCP feature areas with the highest action level.</span></div><div><strong>FeatureEditor</strong><span>Can manage records inside the specific assigned feature.</span></div><div><strong>Readonly</strong><span>Can view records; create, update, and delete buttons should be hidden.</span></div></div></section>
<script type="application/json" id="bcp-page-tour">[{"selector":"[data-tour='roles-summary']","title":"Role layers","text":"Identity roles are broad. BCP feature roles are per-module, which keeps every feature independent.","placement":"bottom"}]</script>
