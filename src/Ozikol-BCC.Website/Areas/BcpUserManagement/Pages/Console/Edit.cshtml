@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.EditModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Edit User";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "User Directory",
    Title = "Edit User",
    Subtitle = "Update BCP profile fields, business status, category, and contact information.",
    Icon = "edit",
    BackUrl = "/BcpUserManagement/Console/Users",
    BackText = "Users",
    Buttons = [new("Details", $"/BcpUserManagement/Console/Details?id={Model.Input.Id}", "visibility")]
})

<form method="post" class="m3-card bcp-card bcp-wide-form" data-tour="edit-user-form">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="bcp-validation-summary"></div>
    <div class="bcp-form-grid">
        <label class="bcp-field">Title<input class="bcp-input" asp-for="Input.Title" /></label>
        <label class="bcp-field">Email<input class="bcp-input" asp-for="Input.Email" readonly style="opacity: 0.7; cursor: not-allowed; background: var(--md-sys-color-surface-container);" /></label>
        <label class="bcp-field">First Name<input class="bcp-input" asp-for="Input.FirstName" /></label>
        <label class="bcp-field">Middle Name<input class="bcp-input" asp-for="Input.MiddleName" /></label>
        <label class="bcp-field">Last Name<input class="bcp-input" asp-for="Input.LastName" /></label>
        <label class="bcp-field">Phone<input class="bcp-input" asp-for="Input.PhoneNumber" /></label>
        <label class="bcp-field">Status<select class="bcp-input bcp-select" asp-for="Input.UserStatus" asp-items="Model.StatusOptions"></select></label>
        <label class="bcp-field">Category<select class="bcp-input bcp-select" asp-for="Input.BcpUserCategoryId" asp-items="Model.CategoryOptions"></select></label>
    </div>
    <button class="console-btn primary bcp-form-submit" type="submit"><span class="material-symbols-outlined">save</span>Save Changes</button>
</form>

<script type="application/json" id="bcp-page-tour">
[{"selector":"[data-tour='edit-user-form']","title":"Edit business profile","text":"This page updates business user data. Password and MFA remain in Identity/security pages.","placement":"top"}]
</script>
