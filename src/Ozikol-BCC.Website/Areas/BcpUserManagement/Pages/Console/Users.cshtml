@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.UsersModel
@attribute [Authorize]
@{
    ViewData["Title"] = "User Directory";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "Console",
    Title = "User Directory",
    Subtitle = "Manage tenant users, profile status, category assignment, roles, and profile actions.",
    Icon = "groups",
    BackUrl = "/BcpUserManagement/Console/Dashboard",
    Buttons =
    [
        new("Create User", "/BcpUserManagement/Console/Create", "person_add", true),
        new("Categories", "/BcpUserManagement/Console/Categories", "category"),
        new("Notes", "/BcpUserManagement/Console/Notes", "sticky_note_2")
    ]
})

<form method="get" class="m3-card bcp-filter-card" data-tour="user-directory-filter">
    <label class="bcp-field">Search<input class="bcp-input" name="search" value="@Model.Search" placeholder="Name or email" /></label>
    <label class="bcp-field">Status<select class="bcp-input bcp-select" name="status" asp-items="Model.StatusOptions"></select></label>
    <button class="console-btn primary" type="submit"><span class="material-symbols-outlined">search</span>Filter</button>
</form>

<section class="m3-card bcp-card" data-tour="user-directory-table">
    <div class="bcp-table-wrap">
        <table class="bcp-table">
            <thead><tr><th>User</th><th>Email</th><th>Email Verified</th><th>Phone Verified</th><th>Status</th><th>Category</th><th>Last Login</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td><strong>@(string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : user.FullName)</strong></td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.EmailConfirmed)
                            {
                                <span style="display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:4px; background:rgba(16,185,129,0.15); color:#10b981; font-size:12px; font-weight:700;">
                                    <span class="material-symbols-outlined" style="font-size:14px;">check_circle</span> Verified
                                </span>
                            }
                            else
                            {
                                <span style="display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:4px; background:rgba(245,158,11,0.15); color:#f59e0b; font-size:12px; font-weight:700;">
                                    <span class="material-symbols-outlined" style="font-size:14px;">warning</span> Unverified
                                </span>
                            }
                        </td>
                        <td>
                            @if (user.PhoneNumberConfirmed)
                            {
                                <span style="display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:4px; background:rgba(16,185,129,0.15); color:#10b981; font-size:12px; font-weight:700;">
                                    <span class="material-symbols-outlined" style="font-size:14px;">check_circle</span> Verified
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                            {
                                <span style="display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:4px; background:rgba(245,158,11,0.15); color:#f59e0b; font-size:12px; font-weight:700;">
                                    <span class="material-symbols-outlined" style="font-size:14px;">warning</span> Unverified
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--sidebar-color); font-size:12px;">— No Phone</span>
                            }
                        </td>
                        <td><partial name="/Areas/BcpUserManagement/Pages/Common/UserStatusBadge.cshtml" model="user.UserStatus" /></td>
                        <td><partial name="/Areas/BcpUserManagement/Pages/Common/CategoryBadge.cshtml" model="user.BcpUserCategory?.Name" /></td>
                        <td>@(user.LastLogin?.ToLocalTime().ToString("dd MMM yyyy") ?? "Never")</td>
                        <td class="bcp-table-actions">
                            <a class="console-btn" href="/BcpUserManagement/Console/Details?id=@user.Id"><span class="material-symbols-outlined">visibility</span>View</a>
                            <a class="console-btn" href="/BcpUserManagement/Console/Edit?id=@user.Id"><span class="material-symbols-outlined">edit</span>Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<script type="application/json" id="bcp-page-tour">
[
  {"selector":"[data-tour='user-directory-filter']","title":"Directory filters","text":"Search and status filters help admins find the exact profile without leaving the feature.","placement":"bottom"},
  {"selector":"[data-tour='user-directory-table']","title":"User directory","text":"This table is the console command surface for business user records, categories, status, and profile actions.","placement":"top"}
]
</script>
