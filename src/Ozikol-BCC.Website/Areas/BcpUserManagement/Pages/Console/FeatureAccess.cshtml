@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.FeatureAccessModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Feature Access";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel { Eyebrow = "Permissions", Title = "Feature Access", Subtitle = "Assign BCP feature-level access independently from broad Identity roles.", Icon = "verified_user", BackUrl = "/BcpUserManagement/Console/Dashboard", Buttons = [new("Roles", "/BcpUserManagement/Console/Roles", "admin_panel_settings"), new("Users", "/BcpUserManagement/Console/Users", "groups")] })

<section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Assign Feature Access</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/AssignFeatureAccessModal.cshtml" model="Model.UserOptions" /></section>
<section class="m3-card bcp-card" data-tour="feature-access-list">
    <div class="bcp-table-wrap"><table class="bcp-table"><thead><tr><th>User</th><th>Feature</th><th>Role</th><th>Status</th><th>Assigned</th><th></th></tr></thead><tbody>@foreach (var item in Model.Assignments) { <tr><td>@(item.Profile?.FullName ?? item.Profile?.Email ?? item.ProfileId)</td><td>@item.FeatureAreaKey</td><td>@item.ActionRole</td><td><span class="bcp-badge @(item.IsActive ? "success" : "muted")">@(item.IsActive ? "Active" : "Inactive")</span></td><td>@item.Date.ToLocalTime().ToString("dd MMM yyyy")</td><td><form method="post" asp-page-handler="Revoke"><input type="hidden" name="id" value="@item.Id" /><button class="console-btn" type="submit"><span class="material-symbols-outlined">block</span>Revoke</button></form></td></tr> }</tbody></table></div>
</section>
<script type="application/json" id="bcp-page-tour">[{"selector":"[data-tour='assign-feature-access-form']","title":"Assign access","text":"This creates one feature-role row for one user. Other features can use the same pattern without coupling to User Management.","placement":"bottom"},{"selector":"[data-tour='feature-access-list']","title":"Access matrix","text":"This is the admin list of who can use which feature and at what action level.","placement":"top"}]</script>
