@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.DashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "User Management Console";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Eyebrow = "User Management",
    Title = "User Management Dashboard",
    Subtitle = "Console view for user directory health, category coverage, feature access, KPI readiness, notes, and activity.",
    Icon = "groups",
    BackUrl = "/BcpConsole/Console/Dashboard",
    Buttons =
    [
        new("Create User", "/BcpUserManagement/Console/Create", "person_add", true),
        new("Users", "/BcpUserManagement/Console/Users", "groups"),
        new("Feature Access", "/BcpUserManagement/Console/FeatureAccess", "verified_user")
    ]
})

@* This dashboard belongs to BcpUserManagement, not BcpIdentity. Authentication and MFA live in Identity;
   business user operations, profile categorization, feature access, KPI scoring, notes, and user activity live here. *@
<section class="console-grid" data-tour="user-management-dashboard">
    <article class="console-widget span-12" data-widget="um-overview" data-title="User Management Overview" data-tour="um-overview">
        <div class="widget-head">
            <div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">User management overview</h2><a class="info-link" href="javascript:void(0)">Info</a></div>
        </div>
        <div class="widget-body">
            <div class="metric-grid">
                <a class="metric-card" href="/BcpUserManagement/Console/Users"><div class="metric-label">Users</div><div class="metric-value">@Model.TotalUsers / @Model.MaximumUsers</div><div class="metric-note">@Model.ActiveUsers active users</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/Users?status=Pending"><div class="metric-label">Pending</div><div class="metric-value">@Model.PendingUsers</div><div class="metric-note">Awaiting onboarding</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/Users?status=Suspended"><div class="metric-label">Suspended</div><div class="metric-value">@Model.SuspendedUsers</div><div class="metric-note">Business-status blocks</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/Categories"><div class="metric-label">Categories</div><div class="metric-value">@Model.CategoryCount</div><div class="metric-note">@Model.UsersWithoutCategory users uncategorized</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/KpiIndicators"><div class="metric-label">KPI Indicators</div><div class="metric-value">@Model.KpiCount</div><div class="metric-note">@Model.PerformanceRecordCount score records</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/Notes"><div class="metric-label">Notes</div><div class="metric-value">@Model.NotesCount</div><div class="metric-note">Profile notes logged</div></a>
            </div>
        </div>
    </article>

    <article class="console-widget span-6" data-widget="status-breakdown" data-title="User Status Breakdown" data-tour="status-breakdown">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag_dot">drag_indicator</span><h2 class="widget-title">User status breakdown</h2></div></div>
        <div class="widget-body">
            <div class="bcp-horizontal-chart">
                @foreach (var slice in Model.StatusBreakdown)
                {
                    var width = Model.TotalUsers == 0 ? 0 : Math.Round((decimal)slice.Value / Model.TotalUsers * 100, 1);
                    <div class="bcp-chart-row">
                        <div class="bcp-chart-label"><span>@slice.Label</span><strong>@slice.Value</strong></div>
                        <div class="progress-track"><div class="progress-fill" style="--value:@width%; background:@slice.Color;"></div></div>
                    </div>
                }
            </div>
        </div>
        <div class="widget-footer"><a href="/BcpUserManagement/Console/Users">Open user directory</a></div>
    </article>

    <article class="console-widget span-6" data-widget="category-breakdown" data-title="Category Distribution" data-tour="category-breakdown">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Category distribution</h2></div></div>
        <div class="widget-body">
            <div class="bcp-horizontal-chart">
                @foreach (var slice in Model.CategoryBreakdown)
                {
                    var width = Model.TotalUsers == 0 ? 0 : Math.Round((decimal)slice.Value / Model.TotalUsers * 100, 1);
                    <div class="bcp-chart-row">
                        <div class="bcp-chart-label"><span>@slice.Label</span><strong>@slice.Value</strong></div>
                        <div class="progress-track"><div class="progress-fill" style="--value:@width%;"></div></div>
                    </div>
                }
            </div>
        </div>
        <div class="widget-footer"><a href="/BcpUserManagement/Console/Categories">Manage categories</a></div>
    </article>

    <article class="console-widget span-6" data-widget="performance-snapshot" data-title="Performance Snapshot" data-tour="performance-snapshot">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">KPI / performance snapshot</h2></div></div>
        <div class="widget-body billing-layout">
            <div>
                <div class="metric-label">Current period</div>
                <div class="billing-amount">@Model.AveragePerformance.ToString("0.#")%</div>
                <p class="metric-note">@Model.CurrentPeriod average performance.</p>
                <p class="metric-note">@Model.PerformanceRecordCount KPI score records across all users.</p>
            </div>
            <div class="bcp-donut" style="--value:@Model.AveragePerformance;">
                <span>@Model.AveragePerformance.ToString("0.#")%</span>
            </div>
        </div>
        <div class="widget-footer"><a href="/BcpUserManagement/Console/Performance">Open performance</a></div>
    </article>

    <article class="console-widget span-6" data-widget="feature-access-summary" data-title="Feature Access Summary" data-tour="feature-access-summary">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Feature access summary</h2></div></div>
        <div class="widget-body">
            <div class="metric-grid" style="grid-template-columns: repeat(4, minmax(0, 1fr));">
                <a class="metric-card" href="/BcpUserManagement/Console/FeatureAccess"><div class="metric-label">With access</div><div class="metric-value">@Model.UsersWithFeatureAccess</div><div class="metric-note">Distinct users</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/FeatureAccess"><div class="metric-label">Global</div><div class="metric-value">@Model.GlobalEditorCount</div><div class="metric-note">GlobalEditor rows</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/FeatureAccess"><div class="metric-label">Feature</div><div class="metric-value">@Model.FeatureEditorCount</div><div class="metric-note">FeatureEditor rows</div></a>
                <a class="metric-card" href="/BcpUserManagement/Console/FeatureAccess"><div class="metric-label">Readonly</div><div class="metric-value">@Model.ReadonlyCount</div><div class="metric-note">Readonly rows</div></a>
            </div>
        </div>
    </article>

    <article class="console-widget span-4" data-widget="attention" data-title="Users Needing Attention" data-tour="attention-users">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Users needing attention</h2></div></div>
        <div class="widget-body">
            <div class="recommendation-list">
                @foreach (var item in Model.AttentionItems)
                {
                    <a class="recommendation" href="@item.Url"><span class="list-icon @item.Tone"><span class="material-symbols-outlined">@item.Icon</span></span><span class="row-main"><span class="row-title">@item.Title</span><span class="row-sub">@item.Subtitle</span></span></a>
                }
            </div>
        </div>
    </article>

    <article class="console-widget span-4" data-widget="recent-users" data-title="Recent Users" data-tour="recent-users">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Recent users</h2></div></div>
        <div class="widget-body">
            <div class="list-stack">
                @foreach (var user in Model.RecentUsers)
                {
                    <a class="list-row" href="/BcpUserManagement/Console/Details?id=@user.Id"><span class="list-icon info"><span class="material-symbols-outlined">person</span></span><span class="row-main"><span class="row-title">@user.Name</span><span class="row-sub">@user.Email - @user.Category</span></span><span class="status-pill info">@user.Status</span></a>
                }
            </div>
        </div>
    </article>

    <article class="console-widget span-4" data-widget="quick-actions" data-title="Quick Actions" data-tour="quick-actions">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Quick actions</h2></div></div>
        <div class="widget-body">
            <div class="quick-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                <a class="quick-action" href="/BcpUserManagement/Console/Create"><span class="material-symbols-outlined">person_add</span><span>Create user</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/Users"><span class="material-symbols-outlined">groups</span><span>Directory</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/Categories"><span class="material-symbols-outlined">category</span><span>Categories</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/FeatureAccess"><span class="material-symbols-outlined">verified_user</span><span>Access</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/KpiIndicators"><span class="material-symbols-outlined">add_chart</span><span>KPI setup</span></a>
                <a class="quick-action" href="/BcpUserManagement/Console/ActivityLogs"><span class="material-symbols-outlined">history</span><span>Activity</span></a>
            </div>
        </div>
    </article>

    <article class="console-widget span-12" data-widget="recent-activity" data-title="Recent User Management Activity" data-tour="recent-user-activity">
        <div class="widget-head"><div class="widget-title-wrap"><span class="material-symbols-outlined drag-dot">drag_indicator</span><h2 class="widget-title">Recent User Management Activity</h2></div></div>
        <div class="widget-body">
            <partial name="/Areas/BcpUserManagement/Pages/Common/ActivityTimeline.cshtml" model="Model.RecentLogs" />
        </div>
    </article>
</section>

<script type="application/json" id="bcp-page-tour">
[
  {"selector":"[data-tour='user-management-dashboard']","title":"User Management dashboard","text":"This feature dashboard tracks user limit, profile state, categories, permissions, KPI setup, notes, and activity for this independent feature.","placement":"bottom"},
  {"selector":"[data-tour='status-breakdown']","title":"User status graph","text":"The status graph shows active, pending, suspended, leave, and deleted business profile states.","placement":"right"},
  {"selector":"[data-tour='performance-snapshot']","title":"KPI snapshot","text":"Performance data belongs to User Management. The score is calculated from KPI records for the current period.","placement":"left"},
  {"selector":"[data-tour='feature-access-summary']","title":"Feature access graph","text":"Feature access rows define what users can do inside each independent BCP feature.","placement":"top"},
  {"selector":"[data-tour='recent-user-activity']","title":"Activity log","text":"Sensitive user-management changes create activity rows so admin and audit pages can show who changed what.","placement":"top"},
  {"selector":".bcp-page-actions","title":"Page actions","text":"Header buttons are the page command group. They should stay here instead of being scattered around the screen.","placement":"left"}
]
</script>
