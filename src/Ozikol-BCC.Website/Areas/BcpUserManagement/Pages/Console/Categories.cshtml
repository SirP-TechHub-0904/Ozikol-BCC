@page
@model Ozikol_BCC.Website.Areas.BcpUserManagement.Pages.Console.CategoriesModel
@attribute [Authorize]
@{
    ViewData["Title"] = "User Categories";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel { Eyebrow = "Settings", Title = "User Categories", Subtitle = "Create tenant-specific user categories such as Staff, Member, Volunteer, Alumni, or Contractor.", Icon = "category", BackUrl = "/BcpUserManagement/Console/Dashboard", BackText = "Dashboard" })

<section class="m3-card bcp-card"><div class="card-header"><span class="card-title">Add Category</span></div><partial name="/Areas/BcpUserManagement/Pages/Common/AddCategoryModal.cshtml" /></section>
<section class="m3-card bcp-card" data-tour="category-table">
    <div class="bcp-table-wrap"><table class="bcp-table"><thead><tr><th>Name</th><th>Description</th><th>Sort</th><th>Status</th></tr></thead><tbody>@foreach (var item in Model.Categories) { <tr><td><strong>@item.Name</strong></td><td>@item.Description</td><td>@item.SortOrder</td><td><span class="bcp-badge @(item.IsActive ? "success" : "muted")">@(item.IsActive ? "Active" : "Inactive")</span></td></tr> }</tbody></table></div>
</section>
<script type="application/json" id="bcp-page-tour">[{"selector":"[data-tour='add-category-form']","title":"Add category","text":"Categories are tenant-defined labels used to group and report on users.","placement":"bottom"},{"selector":"[data-tour='category-table']","title":"Category list","text":"These values can later drive reports, filters, dashboard widgets, and feature rules.","placement":"top"}]</script>
