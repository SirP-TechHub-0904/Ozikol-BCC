@model Tuple<int, int>
<article class="m3-card bcp-card" data-tour="user-limit-widget">
    <div class="card-header"><span class="card-title">User Limit</span></div>
    <div class="metric-value">@Model.Item1 / @Model.Item2</div>
    <p class="metric-note">Default User Management starts with 10 users. Billing and feature settings can raise this later.</p>
</article>
