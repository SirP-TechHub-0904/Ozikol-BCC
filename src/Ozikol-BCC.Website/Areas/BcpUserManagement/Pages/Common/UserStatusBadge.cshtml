@model UserStatus
@{
    var css = Model switch
    {
        UserStatus.Active => "bcp-badge success",
        UserStatus.Suspended => "bcp-badge danger",
        UserStatus.Leave => "bcp-badge warning",
        UserStatus.Deleted => "bcp-badge muted",
        _ => "bcp-badge"
    };
}
<span class="@css">@Model</span>
