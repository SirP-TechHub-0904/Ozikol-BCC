@model IEnumerable<SelectListItem>
<form method="post" asp-page-handler="AssignAccess" class="bcp-inline-form" data-tour="assign-feature-access-form">
    <label class="bcp-field">User<select class="bcp-input bcp-select" name="ProfileId" asp-items="Model" required></select></label>
    <label class="bcp-field">Feature Key<input class="bcp-input" name="FeatureAreaKey" value="BcpUserManagement" required /></label>
    <label class="bcp-field">Action Role
        <select class="bcp-input bcp-select" name="ActionRole" required>
            <option value="1">Global Editor</option>
            <option value="2">Feature Editor</option>
            <option value="3">Read Only</option>
        </select>
    </label>
    <button class="console-btn primary" type="submit"><span class="material-symbols-outlined">verified_user</span>Assign Access</button>
</form>
