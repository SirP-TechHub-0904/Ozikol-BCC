@model IEnumerable<BcpUserNote>

<div class="bcp-note-list" data-tour="note-list">
    @foreach (var item in Model)
    {
        <article class="m3-card bcp-note-card">
            <div class="card-header">
                <span class="card-title">@(item.IsPrivate ? "Private Note" : "Visible Note")</span>
                <span class="bcp-muted">@item.Date.ToLocalTime().ToString("dd MMM yyyy")</span>
            </div>
            <p>@item.Note</p>
        </article>
    }
</div>
