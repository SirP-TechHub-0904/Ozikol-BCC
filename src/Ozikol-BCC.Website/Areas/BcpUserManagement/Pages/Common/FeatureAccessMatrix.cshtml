@model IEnumerable<BcpUserFeatureRole>

@* Common feature matrix for both Console review pages and Workspace self-service pages.
   Action buttons are intentionally supplied by the page, because edit rights depend on current user's feature role. *@
<div class="bcp-table-wrap" data-tour="feature-access-matrix">
    <table class="bcp-table">
        <thead>
            <tr>
                <th>Feature</th>
                <th>Action Role</th>
                <th>Status</th>
                <th>Assigned</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FeatureAreaKey</td>
                    <td>@item.ActionRole</td>
                    <td><span class="bcp-badge @(item.IsActive ? "success" : "muted")">@(item.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@item.Date.ToLocalTime().ToString("dd MMM yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
