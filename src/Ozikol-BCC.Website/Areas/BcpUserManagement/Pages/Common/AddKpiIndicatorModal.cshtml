<form method="post" asp-page-handler="AddIndicator" class="bcp-inline-form" data-tour="add-kpi-form">
    <label class="bcp-field">Title<input class="bcp-input" name="Title" required /></label>
    <label class="bcp-field">Description<input class="bcp-input" name="Description" /></label>
    <label class="bcp-field">Maximum Score<input class="bcp-input" name="MaxScore" type="number" step="0.01" value="100" required /></label>
    <label class="bcp-field">Sort Order<input class="bcp-input" name="SortOrder" type="number" value="0" /></label>
    <button class="console-btn primary" type="submit"><span class="material-symbols-outlined">add_chart</span>Add KPI</button>
</form>
