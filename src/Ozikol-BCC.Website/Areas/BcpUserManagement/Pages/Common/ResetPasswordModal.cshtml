@model string
<form method="post" asp-page-handler="ResetPassword" class="bcp-inline-form" data-tour="reset-password-form">
    <input type="hidden" name="ProfileId" value="@Model" />
    <label class="bcp-field">New Password<input class="bcp-input" type="password" name="NewPassword" required /></label>
    <button class="console-btn primary" type="submit"><span class="material-symbols-outlined">lock_reset</span>Reset Password</button>
</form>
