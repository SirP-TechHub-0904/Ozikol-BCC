@page
@model Ozikol_BCC.Website.Areas.BcpIdentity.Pages.Workspace.TwoFactorModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Manage Two-Factor Authentication";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "Two-Factor Authentication (2FA)",
    Subtitle = "Secure your login by choosing one of the four multi-factor verification options below.",
    Icon = "phonelink_lock",
    Eyebrow = "User Workspace",
    BackUrl = "/BcpIdentity/Workspace/Security"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    var isError = Model.StatusMessage.StartsWith("Error:");
    <section class="console-alert" style="margin-bottom:24px; padding:12px 16px; background:@(isError ? "var(--md-sys-color-error-container)" : "var(--md-sys-color-primary-container)"); color:@(isError ? "var(--md-sys-color-on-error-container)" : "var(--md-sys-color-on-primary-container)"); border-radius:8px;">
        <div>
            <strong>Status Update</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

@* ── TOP HERO CARD: STATE-OF-THE-ART ACTIVE CARD ── *@
@if (Model.Is2FaEnabled && Model.ActiveProvider != Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.None)
{
    var activeMethodName = "";
    var activeMethodIcon = "verified_user";
    var activeMethodDesc = "";

    switch (Model.ActiveProvider)
    {
        case Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.GoogleAuthenticator:
            activeMethodName = "Google Authenticator";
            activeMethodIcon = "shield";
            activeMethodDesc = "Generating dynamic TOTP verification codes on your Google Authenticator mobile app.";
            break;
        case Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.MicrosoftAuthenticator:
            activeMethodName = "Microsoft Authenticator";
            activeMethodIcon = "shield_with_heart";
            activeMethodDesc = "Generating dynamic TOTP verification codes on your Microsoft Authenticator mobile app.";
            break;
        case Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.Email:
            activeMethodName = "Email Verification";
            activeMethodIcon = "mail";
            activeMethodDesc = $"Receiving confirmation codes in your inbox at {Model.EmailAddress}.";
            break;
        case Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.SMS:
            activeMethodName = "SMS Verification";
            activeMethodIcon = "sms";
            activeMethodDesc = $"Receiving confirmation codes on your mobile phone at {Model.PhoneNumber}.";
            break;
    }

    <section class="m3-card" style="padding:28px; margin-bottom:32px; border-radius:16px; background: linear-gradient(135deg, #0052cc 0%, #002d9c 100%); color: #ffffff; box-shadow: 0 10px 30px rgba(0, 45, 156, 0.15);">
        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;">
            <div style="display:flex; align-items:flex-start; gap:20px; flex:1;">
                <div style="padding:12px; background:rgba(255,255,255,0.12); border-radius:12px; display:inline-flex; align-items:center; justify-content:center;">
                    <span class="material-symbols-outlined" style="font-size:42px; color:#ffffff;">@activeMethodIcon</span>
                </div>
                <div>
                    <span style="font-size:12px; text-transform:uppercase; letter-spacing:1.5px; opacity:0.8; font-weight:700; display:block;">Active Protection</span>
                    <h3 style="margin:4px 0 8px 0; font-size:22px; font-weight:800; color:#ffffff;">@activeMethodName</h3>
                    <p style="margin:0; opacity:0.9; font-size:14.5px; line-height:1.5; max-width:600px;">@activeMethodDesc</p>
                </div>
            </div>
            
            @* Equalized Header Buttons *@
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                @if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.GoogleAuthenticator || Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.MicrosoftAuthenticator)
                {
                    <button type="button" class="console-btn secondary" onclick="document.getElementById('active-reconfig-panel').style.display='block'; this.style.display='none';" 
                            style="height:42px; padding:0 20px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius:8px; background:rgba(255,255,255,0.15); color:#ffffff; border:1px solid rgba(255,255,255,0.25); box-sizing:border-box; line-height:1; font-family:inherit; cursor:pointer;">
                        <span class="material-symbols-outlined" style="font-size:18px;">settings</span> Reconfigure
                    </button>
                    
                    <a href="/BcpIdentity/Workspace/RecoveryCodes" class="console-btn secondary" 
                       style="height:42px; padding:0 20px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius:8px; background:rgba(255,255,255,0.15); color:#ffffff; border:1px solid rgba(255,255,255,0.25); box-sizing:border-box; line-height:1; font-family:inherit; text-decoration:none; cursor:pointer;">
                        <span class="material-symbols-outlined" style="font-size:18px;">key</span> Recovery Codes
                    </a>
                }
                
                <form method="post" asp-page-handler="Disable" style="margin:0; display:inline-flex; align-items:center;">
                    <button type="submit" class="console-btn danger" 
                            style="height:42px; padding:0 20px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; justify-content:center; gap:8px; border-radius:8px; background:#ef4444; color:white; border:none; box-sizing:border-box; line-height:1; font-family:inherit; cursor:pointer;">
                        <span class="material-symbols-outlined" style="font-size:18px;">no_encryption</span> Disable 2FA
                    </button>
                </form>
            </div>
        </div>

        @* Hidden active reconfigure panel *@
        <div id="active-reconfig-panel" style="display:none; margin-top:24px; padding-top:24px; border-top:1px solid rgba(255,255,255,0.15);">
            <div style="background: rgba(255,255,255,0.06); padding:20px; border-radius:12px; border:1px solid rgba(255,255,255,0.1);">
                <h4 style="margin:0 0 12px 0; color:#ffffff; font-size:16px; font-weight:700;">Reconfigure @activeMethodName</h4>
                
                @if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.GoogleAuthenticator || Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.MicrosoftAuthenticator)
                {
                    <div style="display:flex; justify-content:center; margin-bottom:20px;">
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@(Uri.EscapeDataString(Model.AuthenticatorUri))" alt="Authenticator QR Code" 
                             style="border: 8px solid white; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.15);" />
                    </div>
                    <p style="font-size:14px; margin-bottom:16px; opacity:0.9;">Scan the QR code above or enter the code manually:</p>
                    <div style="margin:16px 0; padding:12px; background:rgba(0,0,0,0.2); border:1px solid rgba(255,255,255,0.15); border-radius:8px; font-family:monospace; font-size:16px; letter-spacing:2px; text-align:center; color:#ffffff;">
                        @Model.SharedKey
                    </div>
                    <form method="post" asp-page-handler="EnableAuthenticator" style="display:grid; gap:12px; max-width:320px; margin-top:16px;">
                        <input type="hidden" name="provider" value="@Model.ActiveProvider" />
                        <label style="font-weight:500; font-size:14px; color:#ffffff;">Enter verification code from app</label>
                        <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" style="padding:10px; border:1px solid rgba(255,255,255,0.3); border-radius:6px; background:rgba(255,255,255,0.1); color:#ffffff; text-align:center; font-size:16px;" required />
                        <button type="submit" class="console-btn primary" style="padding:10px; font-size:14px; background:#ffffff; color:#002d9c; border:none; font-weight:700;">Verify & Update App</button>
                    </form>
                }
                else if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.Email)
                {
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                        <form method="post" asp-page-handler="SendEmailCode" style="margin:0;">
                            <button type="submit" class="console-btn secondary" style="padding:8px 14px; background:rgba(255,255,255,0.15); border:none; color:white;">Send Verification OTP</button>
                        </form>
                        <span style="font-size:13px; opacity:0.9;">Send confirmation code to <strong>@Model.EmailAddress</strong>.</span>
                    </div>
                    <form method="post" asp-page-handler="EnableEmail" style="display:grid; gap:12px; max-width:320px;">
                        <label style="font-weight:500; font-size:14px; color:white;">Enter verification code</label>
                        <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" style="padding:10px; border:1px solid rgba(255,255,255,0.3); border-radius:6px; background:rgba(255,255,255,0.1); color:#ffffff; text-align:center; font-size:16px;" required />
                        <button type="submit" class="console-btn primary" style="padding:10px; font-size:14px; background:#ffffff; color:#002d9c; border:none; font-weight:700;">Verify & Set Email 2FA</button>
                    </form>
                }
                else if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.SMS)
                {
                    <div style="margin-bottom:16px; max-width:400px;">
                        <label style="font-weight:500; font-size:14px; display:block; margin-bottom:6px; color:white;">Mobile Phone Number</label>
                        <div style="display:flex; gap:8px;">
                            <input type="tel" id="sms-phone-input-active" value="@Model.PhoneNumber" placeholder="+1234567890" 
                                   style="flex:1; padding:8px 12px; border:1px solid rgba(255,255,255,0.3); border-radius:6px; background:rgba(255,255,255,0.1); color:#ffffff;" />
                            <button type="button" class="console-btn secondary" style="padding:8px 14px; background:rgba(255,255,255,0.15); border:none; color:white;"
                                    onclick="var phone = document.getElementById('sms-phone-input-active').value; if(phone) { window.location.href='?handler=SendSmsCode&phoneNumber=' + encodeURIComponent(phone); } else { alert('Please enter phone number'); }">
                                Send SMS OTP
                            </button>
                        </div>
                    </div>
                    <form method="post" asp-page-handler="EnableSms" style="display:grid; gap:12px; max-width:320px;">
                        <label style="font-weight:500; font-size:14px; color:white;">Enter verification code</label>
                        <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" style="padding:10px; border:1px solid rgba(255,255,255,0.3); border-radius:6px; background:rgba(255,255,255,0.1); color:#ffffff; text-align:center; font-size:16px;" required />
                        <button type="submit" class="console-btn primary" style="padding:10px; font-size:14px; background:#ffffff; color:#002d9c; border:none; font-weight:700;">Verify & Update SMS 2FA</button>
                    </form>
                }
            </div>
        </div>
    </section>
}
else
{
    @* ── HERO CARD WHEN DISABLED ── *@
    <section class="m3-card" style="padding:28px; margin-bottom:32px; border-radius:16px; background: linear-gradient(135deg, #374151 0%, #1f2937 100%); color: #ffffff; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);">
        <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
            <div style="padding:12px; background:rgba(255,255,255,0.1); border-radius:12px; display:inline-flex;">
                <span class="material-symbols-outlined" style="font-size:42px; color:#ef4444;">gpp_maybe</span>
            </div>
            <div>
                <h3 style="margin:0 0 6px 0; font-size:20px; font-weight:800; color:#ffffff;">Two-Factor Authentication is Disabled</h3>
                <p style="margin:0; opacity:0.85; font-size:14px; line-height:1.4; max-width:600px;">Protect your account from unauthorized access. Select one of the verification options below to activate extra security.</p>
            </div>
        </div>
    </section>
}

@* ── ALTERNATIVE/INACTIVE METHODS LIST ── *@
<div style="margin-bottom:16px;">
    <h4 style="margin:0 0 16px 0; font-size:16px; font-weight:700; color:var(--md-sys-color-on-surface);">
        Alternative Verification Methods
    </h4>
</div>

<div style="display:grid; grid-template-columns: 1fr; gap:24px;">

    @* ── METHOD 1: Google Authenticator (Only if Inactive) ──────────────────────── *@
    @if (Model.ActiveProvider != Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.GoogleAuthenticator)
    {
        <section class="m3-card bcp-card" style="padding:24px; border-left: 6px solid var(--md-sys-color-outline-variant);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; margin-bottom:16px;">
                <div>
                    <h3 style="margin:0; font-size:16px; font-weight:700; display:flex; align-items:center; gap:8px;">
                        <span class="material-symbols-outlined" style="color:var(--md-sys-color-primary);">shield</span>
                        Google Authenticator
                    </h3>
                    <p style="margin:4px 0 0 0; color:var(--sidebar-color); font-size:14px;">Generate timed OTP codes on your Google Authenticator mobile app.</p>
                </div>
                <div style="display:flex; align-items:center; gap:12px;">
                    @if (Model.HasAuthenticatorKey)
                    {
                        <form method="post" asp-page-handler="SetPreferred" style="margin:0;">
                            <input type="hidden" name="provider" value="GoogleAuthenticator" />
                            <button type="submit" class="console-btn primary" style="font-size:12px; padding:6px 12px; min-width:80px;">Enable</button>
                        </form>
                    }
                    else
                    {
                        <button class="console-btn secondary" onclick="document.getElementById('setup-google-panel').style.display='block';" style="font-size:13px; padding:6px 12px; min-width:80px;">Configure</button>
                    }
                </div>
            </div>

            <div id="setup-google-panel" style="display:none; margin-top:20px; padding-top:20px; border-top:1px solid var(--md-sys-color-outline-variant);">
                <div style="display:flex; justify-content:center; margin-bottom:20px;">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@(Uri.EscapeDataString(Model.AuthenticatorUri))" alt="Google Authenticator QR Code" 
                         style="border: 8px solid white; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.08);" />
                </div>
                <p style="font-size:14px; margin-bottom:16px;">Scan this QR code in your Google Authenticator app, or copy the manual code below:</p>
                <div style="margin:16px 0; padding:12px; background:var(--md-sys-color-surface-container-low); border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; font-family:monospace; font-size:16px; letter-spacing:2px; text-align:center;">
                    @Model.SharedKey
                </div>
                <form method="post" asp-page-handler="EnableAuthenticator" style="display:grid; gap:12px; max-width:320px; margin-top:16px;">
                    <input type="hidden" name="provider" value="GoogleAuthenticator" />
                    <label style="font-weight:500; font-size:14px;">Enter verification code from app</label>
                    <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" style="padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); text-align:center; font-size:16px;" required />
                    <button type="submit" class="console-btn primary" style="padding:10px; font-size:14px;">Verify & Set Google Auth</button>
                </form>
            </div>
        </section>
    }

    @* ── METHOD 2: Microsoft Authenticator (Only if Inactive) ───────────────────── *@
    @if (Model.ActiveProvider != Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.MicrosoftAuthenticator)
    {
        <section class="m3-card bcp-card" style="padding:24px; border-left: 6px solid var(--md-sys-color-outline-variant);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; margin-bottom:16px;">
                <div>
                    <h3 style="margin:0; font-size:16px; font-weight:700; display:flex; align-items:center; gap:8px;">
                        <span class="material-symbols-outlined" style="color:#0078d4;">shield_with_heart</span>
                        Microsoft Authenticator
                    </h3>
                    <p style="margin:4px 0 0 0; color:var(--sidebar-color); font-size:14px;">Generate timed OTP codes on your Microsoft Authenticator mobile app.</p>
                </div>
                <div style="display:flex; align-items:center; gap:12px;">
                    @if (Model.HasAuthenticatorKey)
                    {
                        <form method="post" asp-page-handler="SetPreferred" style="margin:0;">
                            <input type="hidden" name="provider" value="MicrosoftAuthenticator" />
                            <button type="submit" class="console-btn primary" style="font-size:12px; padding:6px 12px; background:#0078d4; min-width:80px;">Enable</button>
                        </form>
                    }
                    else
                    {
                        <button class="console-btn secondary" onclick="document.getElementById('setup-microsoft-panel').style.display='block';" style="font-size:13px; padding:6px 12px; min-width:80px;">Configure</button>
                    }
                </div>
            </div>

            <div id="setup-microsoft-panel" style="display:none; margin-top:20px; padding-top:20px; border-top:1px solid var(--md-sys-color-outline-variant);">
                <div style="display:flex; justify-content:center; margin-bottom:20px;">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@(Uri.EscapeDataString(Model.AuthenticatorUri))" alt="Microsoft Authenticator QR Code" 
                         style="border: 8px solid white; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.08);" />
                </div>
                <p style="font-size:14px; margin-bottom:16px;">Scan this QR code in your Microsoft Authenticator app, or copy the manual code below:</p>
                <div style="margin:16px 0; padding:12px; background:var(--md-sys-color-surface-container-low); border:1px solid var(--md-sys-color-outline-variant); border-radius:8px; font-family:monospace; font-size:16px; letter-spacing:2px; text-align:center;">
                    @Model.SharedKey
                </div>
                <form method="post" asp-page-handler="EnableAuthenticator" style="display:grid; gap:12px; max-width:320px; margin-top:16px;">
                    <input type="hidden" name="provider" value="MicrosoftAuthenticator" />
                    <label style="font-weight:500; font-size:14px;">Enter verification code from app</label>
                    <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" style="padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); text-align:center; font-size:16px;" required />
                    <button type="submit" class="console-btn primary" style="padding:10px; font-size:14px; background:#0078d4;">Verify & Set Microsoft Auth</button>
                </form>
            </div>
        </section>
    }

    @* ── METHOD 3: Email Verification (Only if Inactive) ────────────────────────── *@
    @if (Model.ActiveProvider != Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.Email)
    {
        <section class="m3-card bcp-card" style="padding:24px; border-left: 6px solid var(--md-sys-color-outline-variant);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; margin-bottom:16px;">
                <div>
                    <h3 style="margin:0; font-size:16px; font-weight:700; display:flex; align-items:center; gap:8px;">
                        <span class="material-symbols-outlined" style="color:#4f46e5;">mail</span>
                        Email Verification
                    </h3>
                    <p style="margin:4px 0 0 0; color:var(--sidebar-color); font-size:14px;">Receive a 6-digit dynamic code in your email inbox on login. Target: <strong>@Model.EmailAddress</strong></p>
                </div>
                <div style="display:flex; align-items:center; gap:12px;">
                    @if (Model.IsEmailConfirmed)
                    {
                        <form method="post" asp-page-handler="SetPreferred" style="margin:0;">
                            <input type="hidden" name="provider" value="Email" />
                            <button type="submit" class="console-btn primary" style="font-size:12px; padding:6px 12px; background:#4f46e5; min-width:80px;">Enable</button>
                        </form>
                    }
                    else
                    {
                        <button class="console-btn secondary" onclick="document.getElementById('setup-email-panel').style.display='block';" style="font-size:13px; padding:6px 12px; min-width:80px;">Configure</button>
                    }
                </div>
            </div>

            <div id="setup-email-panel" style="display:none; margin-top:20px; padding-top:20px; border-top:1px solid var(--md-sys-color-outline-variant);">
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                    <form method="post" asp-page-handler="SendEmailCode" style="margin:0;">
                        <button type="submit" class="console-btn secondary" style="padding:8px 14px;">Send Verification OTP</button>
                    </form>
                    <span style="font-size:13px; color:var(--sidebar-color);">Click to receive an email confirmation code.</span>
                </div>
                <form method="post" asp-page-handler="EnableEmail" style="display:grid; gap:12px; max-width:320px;">
                    <label style="font-weight:500; font-size:14px;">Enter verification code sent to your inbox</label>
                    <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" style="padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); text-align:center; font-size:16px;" required />
                    <button type="submit" class="console-btn primary" style="padding:10px; font-size:14px; background:#4f46e5;">Verify & Set Email 2FA</button>
                </form>
            </div>
        </section>
    }

    @* ── METHOD 4: SMS Verification (Only if Inactive) ──────────────────────────── *@
    @if (Model.ActiveProvider != Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.SMS)
    {
        <section class="m3-card bcp-card" style="padding:24px; border-left: 6px solid var(--md-sys-color-outline-variant);">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:16px; margin-bottom:16px;">
                <div>
                    <h3 style="margin:0; font-size:16px; font-weight:700; display:flex; align-items:center; gap:8px;">
                        <span class="material-symbols-outlined" style="color:#0ab39c;">sms</span>
                        SMS Verification
                    </h3>
                    <p style="margin:4px 0 0 0; color:var(--sidebar-color); font-size:14px;">Receive a 6-digit dynamic text code on your mobile phone on login. Target: <strong>@(Model.PhoneNumber ?? "No mobile number configured")</strong></p>
                </div>
                <div style="display:flex; align-items:center; gap:12px;">
                    @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                    {
                        <form method="post" asp-page-handler="SetPreferred" style="margin:0;">
                            <input type="hidden" name="provider" value="SMS" />
                            <button type="submit" class="console-btn primary" style="font-size:12px; padding:6px 12px; background:#0ab39c; min-width:80px;">Enable</button>
                        </form>
                    }
                    else
                    {
                        <button class="console-btn secondary" onclick="document.getElementById('setup-sms-panel').style.display='block';" style="font-size:13px; padding:6px 12px; min-width:80px;">Configure</button>
                    }
                </div>
            </div>

            <div id="setup-sms-panel" style="display:none; margin-top:20px; padding-top:20px; border-top:1px solid var(--md-sys-color-outline-variant);">
                <div style="margin-bottom:16px; max-width:400px;">
                    <label style="font-weight:500; font-size:14px; display:block; margin-bottom:6px;">Mobile Phone Number</label>
                    <div style="display:flex; gap:8px;">
                        <input type="tel" id="sms-phone-input" value="@Model.PhoneNumber" placeholder="+1234567890" 
                               style="flex:1; padding:8px 12px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" />
                        <button type="button" class="console-btn secondary" style="padding:8px 14px;"
                                onclick="var phone = document.getElementById('sms-phone-input').value; if(phone) { window.location.href='?handler=SendSmsCode&phoneNumber=' + encodeURIComponent(phone); } else { alert('Please enter phone number'); }">
                            Send SMS OTP
                        </button>
                    </div>
                </div>
                <form method="post" asp-page-handler="EnableSms" style="display:grid; gap:12px; max-width:320px;">
                    <label style="font-weight:500; font-size:14px;">Enter verification code sent to your mobile</label>
                    <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" style="padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); text-align:center; font-size:16px;" required />
                    <button type="submit" class="console-btn primary" style="padding:10px; font-size:14px; background:#0ab39c;">Verify & Set SMS 2FA</button>
                </form>
            </div>
        </section>
    }

</div>
