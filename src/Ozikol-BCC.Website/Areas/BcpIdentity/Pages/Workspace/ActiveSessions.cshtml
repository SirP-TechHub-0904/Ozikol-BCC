@page
@model ActiveSessionsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "My Active Sessions";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "My Active Sessions",
    Subtitle = "Manage signed-in devices, view IP addresses, and forcefully log out suspicious sessions.",
    Icon = "devices",
    Eyebrow = "User Workspace",
    BackUrl = "/BcpIdentity/Workspace/Security"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert" style="margin-bottom:20px; padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px;">
        <div>
            <strong>Status Update</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

<div style="max-width:800px; display:flex; flex-direction:column; gap:20px;">
    <div style="display:flex; align-items:center; justify-content:space-between;">
        <h2 style="font-size:18px; font-weight:700; margin:0;">Logged-In Devices (@Model.ActiveSessions.Count)</h2>
        @if (Model.ActiveSessions.Count > 1)
        {
            <form method="post" asp-page-handler="RevokeOthers">
                <button type="submit" class="console-btn" style="color:var(--md-sys-color-error); border-color:var(--md-sys-color-error);">
                    <span class="material-symbols-outlined">power_settings_new</span>
                    <span>Sign Out All Other Devices</span>
                </button>
            </form>
        }
    </div>

    @if (Model.ActiveSessions.Count == 0)
    {
        <div class="m3-card bcp-card" style="padding:24px; text-align:center; color:var(--sidebar-header-color);">
            No active sessions found.
        </div>
    }
    else
    {
        @foreach (var session in Model.ActiveSessions)
        {
            var deviceIcon = session.DeviceType.ToLower() switch
            {
                "mobile" => "smartphone",
                "tablet" => "tablet",
                _ => "desktop_windows"
            };

            <article class="m3-card bcp-card" style="padding:20px; display:flex; align-items:center; justify-content:space-between; gap:16px;">
                <div style="display:flex; align-items:center; gap:16px;">
                    <div style="width:44px; height:44px; border-radius:12px; background:var(--sidebar-hover-bg); display:flex; align-items:center; justify-content:center; color:var(--sidebar-active-color);">
                        <span class="material-symbols-outlined" style="font-size:24px;">@deviceIcon</span>
                    </div>
                    <div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <strong style="font-size:15px; font-weight:600;">@session.DeviceName</strong>
                            @if (session.IsCurrentSession)
                            {
                                <span class="badge-pill" style="background:#0ab39c; color:#fff; font-size:10px; padding:2px 8px; border-radius:12px;">This Device</span>
                            }
                        </div>
                        <div style="font-size:12.5px; color:var(--sidebar-header-color); margin-top:4px; display:flex; gap:12px;">
                            <span><span class="material-symbols-outlined" style="font-size:14px; vertical-align:middle;">router</span> IP: @session.IpAddress</span>
                            <span><span class="material-symbols-outlined" style="font-size:14px; vertical-align:middle;">schedule</span> Last active: @session.LastActiveAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                        </div>
                    </div>
                </div>

                @if (!session.IsCurrentSession)
                {
                    <form method="post" asp-page-handler="RevokeSingle">
                        <input type="hidden" name="id" value="@session.Id" />
                        <button type="submit" class="console-btn" style="color:var(--md-sys-color-error);" title="Revoke Device Session">
                            <span class="material-symbols-outlined">logout</span>
                            <span>Revoke</span>
                        </button>
                    </form>
                }
            </article>
        }
    }
</div>
