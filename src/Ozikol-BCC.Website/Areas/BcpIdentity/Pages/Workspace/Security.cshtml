@page
@model SecurityModel
@attribute [Authorize]
@{
    ViewData["Title"] = "My Security";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "Account Security Center",
    Subtitle = "Manage your password, Multi-Factor Authentication (2FA), active sessions, and security history.",
    Icon = "security",
    Eyebrow = "User Workspace",
    BackUrl = "/BcpWorkspace/Workspace/Dashboard"
})

@* ── TOP PRIMARY CARDS (2-COLUMN GRID) ── *@
<section class="dashboard-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:24px; margin-bottom:28px;">
    
    @* 1. Two-Factor Authentication *@
    <article class="m3-card bcp-card" style="padding:24px; border-radius:14px; border-top: 4px solid #2563eb; display:flex; flex-direction:column; justify-space-between;">
        <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <span style="font-size:16.5px; font-weight:700; color:var(--md-sys-color-on-surface);">Two-Factor Authentication</span>
                <div style="padding:8px; background:rgba(37, 99, 235, 0.1); border-radius:10px; display:inline-flex;">
                    <span class="material-symbols-outlined" style="color:#2563eb; font-size:22px;">verified_user</span>
                </div>
            </div>
            
            <div style="margin:16px 0 20px 0;">
                <div style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--sidebar-color); margin-bottom:6px;">Current 2FA Status</div>
                @if (Model.Is2FaEnabled)
                {
                    <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:20px; background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.25); color:#10b981; font-weight:700; font-size:14px;">
                        <span style="width:8px; height:8px; border-radius:50%; background:#10b981; box-shadow:0 0 8px #10b981;"></span>
                        Enabled
                    </div>
                }
                else
                {
                    <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:20px; background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.25); color:#ef4444; font-weight:700; font-size:14px;">
                        <span style="width:8px; height:8px; border-radius:50%; background:#ef4444; box-shadow:0 0 8px #ef4444;"></span>
                        Disabled
                    </div>
                }
            </div>
        </div>

        <div style="margin-top:auto;">
            <a href="/BcpIdentity/Workspace/TwoFactor" class="console-btn primary" 
               style="height:40px; padding:0 18px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; gap:8px; border-radius:8px; background:#2563eb; color:white; text-decoration:none;">
                <span>Configure 2FA</span>
                <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
            </a>
        </div>
    </article>

    @* 2. Change Password & Strength *@
    <article class="m3-card bcp-card" style="padding:24px; border-radius:14px; border-top: 4px solid #4f46e5; display:flex; flex-direction:column; justify-space-between;">
        <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <span style="font-size:16.5px; font-weight:700; color:var(--md-sys-color-on-surface);">Change Password</span>
                <div style="padding:8px; background:rgba(79, 70, 229, 0.1); border-radius:10px; display:inline-flex;">
                    <span class="material-symbols-outlined" style="color:#4f46e5; font-size:22px;">password</span>
                </div>
            </div>

            <div style="margin:16px 0 20px 0;">
                <div style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:var(--sidebar-color); margin-bottom:6px;">Current Password Strength</div>
                <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:20px; background:rgba(16,185,129,0.12); border:1px solid rgba(16,185,129,0.25); color:#10b981; font-weight:700; font-size:14px;">
                    <span style="width:8px; height:8px; border-radius:50%; background:#10b981; box-shadow:0 0 8px #10b981;"></span>
                    Strong
                </div>
            </div>
        </div>

        <div style="margin-top:auto;">
            <a href="/BcpIdentity/Workspace/ChangePassword" class="console-btn primary" 
               style="height:40px; padding:0 18px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; gap:8px; border-radius:8px; background:#4f46e5; color:white; text-decoration:none; border:none;">
                <span>Change Password</span>
                <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
            </a>
        </div>
    </article>

</section>

@* ── SECONDARY FEATURE CARDS (3-COLUMN GRID) ── *@
<section class="dashboard-grid" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:24px;">
    
    @* 3. My Active Sessions *@
    <article class="m3-card bcp-card" style="padding:24px; border-radius:14px; border-top: 4px solid #0284c7; display:flex; flex-direction:column; justify-space-between;">
        <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <span style="font-size:16px; font-weight:700; color:var(--md-sys-color-on-surface);">My Active Sessions</span>
                <div style="padding:8px; background:rgba(2, 132, 199, 0.1); border-radius:10px; display:inline-flex;">
                    <span class="material-symbols-outlined" style="color:#0284c7; font-size:22px;">devices</span>
                </div>
            </div>

            <p style="margin:12px 0 20px 0; font-size:14px; color:var(--sidebar-color); line-height:1.4;">
                Monitor real-time devices logged into your account and revoke active sessions.
            </p>
        </div>

        <div style="margin-top:auto;">
            <a href="/BcpIdentity/Workspace/ActiveSessions" class="console-btn primary" 
               style="height:40px; padding:0 18px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; gap:8px; border-radius:8px; background:#0284c7; color:white; text-decoration:none; border:none;">
                <span>Manage Sessions</span>
                <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
            </a>
        </div>
    </article>

    @* 4. Trusted Devices *@
    <article class="m3-card bcp-card" style="padding:24px; border-radius:14px; border-top: 4px solid #059669; display:flex; flex-direction:column; justify-space-between;">
        <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <span style="font-size:16px; font-weight:700; color:var(--md-sys-color-on-surface);">Trusted Devices</span>
                <div style="padding:8px; background:rgba(5, 150, 105, 0.1); border-radius:10px; display:inline-flex;">
                    <span class="material-symbols-outlined" style="color:#059669; font-size:22px;">phonelink_setup</span>
                </div>
            </div>

            <p style="margin:12px 0 20px 0; font-size:14px; color:var(--sidebar-color); line-height:1.4;">
                Review registered browsers and devices configured for 2FA login bypass.
            </p>
        </div>

        <div style="margin-top:auto;">
            <a href="/BcpIdentity/Workspace/TrustedDevices" class="console-btn primary" 
               style="height:40px; padding:0 18px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; gap:8px; border-radius:8px; background:#059669; color:white; text-decoration:none; border:none;">
                <span>Manage Devices</span>
                <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
            </a>
        </div>
    </article>

    @* 5. Security Log *@
    <article class="m3-card bcp-card" style="padding:24px; border-radius:14px; border-top: 4px solid #7c3aed; display:flex; flex-direction:column; justify-space-between;">
        <div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                <span style="font-size:16px; font-weight:700; color:var(--md-sys-color-on-surface);">Security Log</span>
                <div style="padding:8px; background:rgba(124, 58, 237, 0.1); border-radius:10px; display:inline-flex;">
                    <span class="material-symbols-outlined" style="color:#7c3aed; font-size:22px;">history</span>
                </div>
            </div>

            <p style="margin:12px 0 20px 0; font-size:14px; color:var(--sidebar-color); line-height:1.4;">
                View complete personal audit timeline of authentication and security updates.
            </p>
        </div>

        <div style="margin-top:auto;">
            <a href="/BcpIdentity/Workspace/SecurityLog" class="console-btn primary" 
               style="height:40px; padding:0 18px; font-size:13.5px; font-weight:600; display:inline-flex; align-items:center; gap:8px; border-radius:8px; background:#7c3aed; color:white; text-decoration:none; border:none;">
                <span>View Security Log</span>
                <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
            </a>
        </div>
    </article>

</section>
