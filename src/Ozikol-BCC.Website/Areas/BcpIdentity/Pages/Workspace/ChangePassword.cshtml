@page
@model ChangePasswordModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Change Password";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "Change Password",
    Subtitle = "Update your login password. Passwords must comply with system complexity policy.",
    Icon = "password",
    Eyebrow = "User Workspace",
    BackUrl = "/BcpIdentity/Workspace/Security"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert" style="margin-bottom:20px; padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px;">
        <div>
            <strong>Status Update</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

<form method="post" style="max-width:540px;" class="m3-card bcp-card" style="padding:24px;">
    <div class="card-header" style="margin-bottom:16px;">
        <span class="card-title" style="font-size:18px; font-weight:600;">Update Password</span>
    </div>

    <div asp-validation-summary="ModelOnly" style="color:var(--md-sys-color-error); font-size:13px; margin-bottom:12px;"></div>

    <div style="display:grid; gap:16px;">
        <div>
            <label asp-for="Input.OldPassword" style="font-weight:500; display:block; margin-bottom:6px;"></label>
            <input asp-for="Input.OldPassword" type="password" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" required />
            <span asp-validation-for="Input.OldPassword" style="color:var(--md-sys-color-error); font-size:12px;"></span>
        </div>

        <div>
            <label asp-for="Input.NewPassword" style="font-weight:500; display:block; margin-bottom:6px;"></label>
            <input asp-for="Input.NewPassword" type="password" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" required />
            <span asp-validation-for="Input.NewPassword" style="color:var(--md-sys-color-error); font-size:12px;"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" style="font-weight:500; display:block; margin-bottom:6px;"></label>
            <input asp-for="Input.ConfirmPassword" type="password" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" required />
            <span asp-validation-for="Input.ConfirmPassword" style="color:var(--md-sys-color-error); font-size:12px;"></span>
        </div>

        <div style="margin-top:8px;">
            <button type="submit" class="btn-custom active" style="padding:10px 20px; border-radius:8px; display:inline-flex; align-items:center; gap:8px;">
                <span class="material-symbols-outlined">key</span>
                <span>Update Password</span>
            </button>
        </div>
    </div>
</form>
