@page
@model DashboardModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Account Security";
}

@* Workspace identity dashboard is the signed-in user's own security center.
   Administrative controls remain in Console; this surface is self-service. *@
<section class="console-head">
    <div>
        <h1 class="console-title">Account Security</h1>
        <p class="console-subtitle">Personal profile, password, MFA, recovery codes, sessions, and trusted devices.</p>
    </div>
    <div class="console-actions">
        <a class="console-btn" asp-page="/Workspace/ChangePassword" asp-area="BcpIdentity"><span class="material-symbols-outlined">password</span>Password</a>
        <a class="console-btn primary" asp-page="/Workspace/TwoFactor" asp-area="BcpIdentity"><span class="material-symbols-outlined">verified_user</span>Two-factor</a>
    </div>
</section>

<section class="dashboard-grid">
    <article class="m3-card bcp-card">
        <div class="card-header"><span class="card-title">Profile</span></div>
        <p class="metric-note">Keep your account identity and contact details current.</p>
    </article>
    <article class="m3-card bcp-card">
        <div class="card-header"><span class="card-title">Sessions</span></div>
        <p class="metric-note">Review devices currently signed in to your account.</p>
    </article>
    <article class="m3-card bcp-card">
        <div class="card-header"><span class="card-title">Security log</span></div>
        <p class="metric-note">Track password, MFA, and account access activity.</p>
    </article>
</section>
