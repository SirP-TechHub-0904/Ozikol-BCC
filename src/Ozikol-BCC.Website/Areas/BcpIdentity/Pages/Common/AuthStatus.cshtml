@page
@model AuthStatusModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Auth Status";
}

@* AuthStatus is a shared signed-in route for reporting the current identity state.
   It should be safe to call from topbar widgets, diagnostics, and account panels. *@
<section class="m3-card">
    <div class="card-header"><span class="card-title">Authentication status</span></div>
    <p style="color:var(--sidebar-color);">Reusable route for reporting current account and authentication state.</p>
</section>
