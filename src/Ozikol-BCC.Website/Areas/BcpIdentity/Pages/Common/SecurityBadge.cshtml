@page
@model SecurityBadgeModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Security Badge";
}

@* SecurityBadge is a reusable indicator for account protection state. Future widgets can
   surface MFA, password age, lockout, and trusted-device status through this route. *@
<section class="m3-card">
    <div class="card-header"><span class="card-title">Security badge</span></div>
    <p style="color:var(--sidebar-color);">Reusable security status badge and policy indicator route.</p>
</section>
