@page
@model AccessDeniedModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Access Denied";
}

@* Shared access-denied outcome for authorized BCP shells. The authorization decision
   must happen before this page; this route only communicates the result. *@
<section class="m3-card">
    <div class="empty-state">
        <span class="material-symbols-outlined">block</span>
        <strong>Access denied</strong>
        <span>The requested BCP resource is not available to this account.</span>
    </div>
</section>
