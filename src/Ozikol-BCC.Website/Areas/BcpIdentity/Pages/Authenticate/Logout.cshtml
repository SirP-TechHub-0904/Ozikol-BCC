@page
@model LogoutModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Sign Out";
}

@* Logout requires an authenticated session and posts before signing out so session termination
   is explicit and can later be audited with device/session metadata. *@
<form class="m3-card" method="post">
    <div class="card-header">
        <span class="card-title">Sign out</span>
    </div>
    <div style="display:grid; gap:16px;">
        <p style="margin:0; color:var(--sidebar-color);">End your current BCP session on this device.</p>
        <button class="console-btn primary" type="submit"><span class="material-symbols-outlined">logout</span>Sign out</button>
    </div>
</form>
