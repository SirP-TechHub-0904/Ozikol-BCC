@page
@model InviteAcceptModel
@{
    ViewData["Title"] = "Accept Invitation";
    Layout = "/Pages/Shared/Layouts/Bcp/_BcpAuthenticateLayout.cshtml";
}

<div class="auth-card" style="max-width:480px; margin:40px auto; padding:32px; background:var(--md-sys-color-surface); border:1px solid var(--md-sys-color-outline-variant); border-radius:12px;">
    <div style="text-align:center; margin-bottom:24px;">
        <h2 style="margin:0; font-size:22px; font-weight:600;">Accept Invitation</h2>
        <p style="margin:8px 0 0 0; color:var(--sidebar-color); font-size:14px;">Complete your account setup to join the platform.</p>
    </div>

    @if (Model.IsInvalidToken)
    {
        <div style="padding:16px; background:var(--md-sys-color-error-container); color:var(--md-sys-color-on-error-container); border-radius:8px; text-align:center;">
            <strong>Invalid or Expired Link</strong>
            <p style="margin:4px 0 0 0; font-size:13px;">This invitation token is invalid, expired, or has already been used.</p>
            <a href="/BcpIdentity/Authenticate/Login" style="display:inline-block; margin-top:12px; color:var(--md-sys-color-on-error-container); font-weight:600; text-decoration:underline;">Return to Sign In</a>
        </div>
    }
    else
    {
        <form method="post">
            <input type="hidden" asp-for="Input.Token" />
            <div asp-validation-summary="ModelOnly" style="color:var(--md-sys-color-error); font-size:13px; margin-bottom:16px;"></div>

            <div style="display:grid; gap:16px;">
                <div>
                    <label style="font-weight:500; font-size:13px; display:block; margin-bottom:4px;">Invited Email</label>
                    <input type="text" value="@Model.InvitationEmail" disabled style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline-variant); border-radius:6px; background:var(--md-sys-color-surface-container);" />
                </div>

                <div style="display:grid; grid-template-columns: 1fr 2fr; gap:10px;">
                    <div>
                        <label asp-for="Input.Title" style="font-weight:500; font-size:13px; display:block; margin-bottom:4px;"></label>
                        <input asp-for="Input.Title" placeholder="Mr. / Ms." style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px;" />
                    </div>
                    <div>
                        <label asp-for="Input.FirstName" style="font-weight:500; font-size:13px; display:block; margin-bottom:4px;"></label>
                        <input asp-for="Input.FirstName" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px;" required />
                    </div>
                </div>

                <div>
                    <label asp-for="Input.LastName" style="font-weight:500; font-size:13px; display:block; margin-bottom:4px;"></label>
                    <input asp-for="Input.LastName" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px;" required />
                </div>

                <div>
                    <label asp-for="Input.PhoneNumber" style="font-weight:500; font-size:13px; display:block; margin-bottom:4px;"></label>
                    <input asp-for="Input.PhoneNumber" placeholder="+1234567890" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px;" />
                </div>

                <div>
                    <label asp-for="Input.Password" style="font-weight:500; font-size:13px; display:block; margin-bottom:4px;"></label>
                    <input asp-for="Input.Password" type="password" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px;" required />
                    <span asp-validation-for="Input.Password" style="color:var(--md-sys-color-error); font-size:12px;"></span>
                </div>

                <div>
                    <label asp-for="Input.ConfirmPassword" style="font-weight:500; font-size:13px; display:block; margin-bottom:4px;"></label>
                    <input asp-for="Input.ConfirmPassword" type="password" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px;" required />
                    <span asp-validation-for="Input.ConfirmPassword" style="color:var(--md-sys-color-error); font-size:12px;"></span>
                </div>

                <button type="submit" class="btn-custom active" style="padding:12px; border-radius:8px; font-weight:600; text-align:center; width:100%; margin-top:8px;">Activate Account & Join</button>
            </div>
        </form>
    }
</div>
