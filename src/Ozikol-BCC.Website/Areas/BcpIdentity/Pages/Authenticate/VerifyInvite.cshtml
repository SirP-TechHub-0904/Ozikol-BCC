@page
@model VerifyInviteModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Verify Invite";
}

@* Invite verification is a public pre-check route for confirming that an invitation
   is valid before collecting account credentials. *@
<section class="m3-card">
    <div class="empty-state">
        <span class="material-symbols-outlined">fact_check</span>
        <strong>Invitation verification</strong>
        <span>This route will verify invite status before account creation.</span>
    </div>
</section>
