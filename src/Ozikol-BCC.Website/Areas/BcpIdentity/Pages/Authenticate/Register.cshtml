@page
@model RegisterModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Create Account";
}

@* Registration is public, but account activation should still respect invitation,
   approval, email confirmation, and tenant policy rules before granting BCP access. *@
<form class="m3-card" method="post">
    <div class="card-header">
        <span class="card-title">Create account</span>
    </div>
    <div style="display:grid; gap:16px;">
        <md-outlined-text-field label="Full name" name="fullName" type="text" required></md-outlined-text-field>
        <md-outlined-text-field label="Email" name="email" type="email" required></md-outlined-text-field>
        <md-outlined-text-field label="Password" name="password" type="password" required></md-outlined-text-field>
        <button class="console-btn primary" type="submit"><span class="material-symbols-outlined">person_add</span>Create account</button>
        <a class="console-link" asp-page="/Authenticate/Login" asp-area="BcpIdentity">Already have an account?</a>
    </div>
</form>
