@page
@model ConfirmPhoneModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Confirm Phone SMS OTP";
}

<div style="max-width:480px; margin: 60px auto;">
    
    @if (Model.VerificationAttempted)
    {
        @if (Model.VerificationSucceeded)
        {
            <div class="m3-card" style="padding:32px; border-radius:16px; border: 1px solid var(--md-sys-color-outline-variant); box-shadow: 0 10px 30px rgba(0,0,0,0.06); text-align:center;">
                <div style="margin-bottom:20px;">
                    <div style="width:64px; height:64px; border-radius:50%; background:rgba(16,185,129,0.12); display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                        <span class="material-symbols-outlined" style="font-size:32px; color:#10b981;">check_circle</span>
                    </div>
                    <h2 style="margin:0 0 6px 0; font-size:20px; font-weight:700; color:var(--md-sys-color-on-surface);">Phone Number Verified!</h2>
                    <p style="margin:0; font-size:14px; color:var(--sidebar-color); line-height:1.5;">
                        Your mobile phone number has been successfully verified with SMS OTP.
                    </p>
                </div>

                <a asp-page="/Workspace/Profile" asp-area="BcpIdentity" class="console-btn primary"
                   style="display:inline-flex; align-items:center; gap:8px; padding:12px 28px; font-size:15px; text-decoration:none; border-radius:8px;">
                    <span class="material-symbols-outlined" style="font-size:20px;">account_circle</span>
                    <span>Return to Profile</span>
                </a>
            </div>
        }
        else
        {
            <div class="m3-card" style="padding:32px; border-radius:16px; border: 1px solid var(--md-sys-color-outline-variant); box-shadow: 0 10px 30px rgba(0,0,0,0.06); text-align:center;">
                <div style="margin-bottom:20px;">
                    <div style="width:64px; height:64px; border-radius:50%; background:rgba(239,68,68,0.12); display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                        <span class="material-symbols-outlined" style="font-size:32px; color:#ef4444;">error</span>
                    </div>
                    <h2 style="margin:0 0 6px 0; font-size:20px; font-weight:700; color:var(--md-sys-color-on-surface);">Phone Verification Failed</h2>
                    <p style="margin:0; font-size:14px; color:var(--sidebar-color); line-height:1.5;">
                        @Model.StatusMessage
                    </p>
                </div>

                <div style="display:grid; gap:12px;">
                    <a asp-page="/Authenticate/ConfirmPhone" asp-area="BcpIdentity" class="console-btn primary"
                       style="display:inline-flex; align-items:center; gap:8px; padding:12px 28px; font-size:15px; text-decoration:none; border-radius:8px; justify-content:center;">
                        <span class="material-symbols-outlined" style="font-size:20px;">refresh</span>
                        <span>Try Entering Code Again</span>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="m3-card" style="padding:32px; border-radius:16px; border: 1px solid var(--md-sys-color-outline-variant); box-shadow: 0 10px 30px rgba(0,0,0,0.06); text-align:center;">
            <div style="margin-bottom:20px;">
                <div style="width:64px; height:64px; border-radius:50%; background:rgba(16,185,129,0.12); display:inline-flex; align-items:center; justify-content:center; margin-bottom:12px;">
                    <span class="material-symbols-outlined" style="font-size:32px; color:#10b981;">smartphone</span>
                </div>
                <h2 style="margin:0 0 6px 0; font-size:20px; font-weight:700; color:var(--md-sys-color-on-surface);">Verify Phone SMS OTP</h2>
                <p style="margin:0; font-size:14px; color:var(--sidebar-color); line-height:1.5;">
                    Enter the 6-digit verification code sent to your phone number.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div style="padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px; font-size:13.5px; margin-bottom:20px; line-height:1.4; text-align:left; display:flex; align-items:center; gap:8px;">
                    <span class="material-symbols-outlined" style="font-size:20px;">info</span>
                    <span>@Model.StatusMessage</span>
                </div>
            }

            <form method="post" asp-page-handler="ConfirmOtp" style="display:grid; gap:20px; text-align:left;">
                <input type="hidden" asp-for="DisplayPhone" />

                <div>
                    <label style="font-weight:600; font-size:13.5px; display:block; margin-bottom:8px; color:var(--md-sys-color-on-surface);">Enter 6-Digit SMS OTP Code</label>
                    <input type="text" asp-for="OtpCode" required placeholder="••••••" maxlength="6" autocomplete="off"
                           style="width:100%; padding:12px; border:2px solid #10b981; border-radius:8px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); font-size:24px; font-weight:700; text-align:center; letter-spacing:12px; box-sizing:border-box;" />
                    <span asp-validation-for="OtpCode" style="color:var(--md-sys-color-error); font-size:12px;"></span>
                </div>

                <button type="submit" class="console-btn primary"
                        style="display:inline-flex; align-items:center; gap:8px; padding:12px 28px; font-size:15px; text-decoration:none; border-radius:8px; justify-content:center; width:100%; box-sizing:border-box; background:#10b981; color:white; border:none; cursor:pointer;">
                    <span class="material-symbols-outlined" style="font-size:20px;">task_alt</span>
                    <span>Verify Phone SMS OTP</span>
                </button>
            </form>

            <form method="post" asp-page-handler="ResendOtp" style="margin-top:16px; text-align:center;">
                <input type="hidden" asp-for="DisplayPhone" />
                <button type="submit" id="resendSmsBtn" class="console-btn secondary" disabled
                        style="display:inline-flex; align-items:center; gap:6px; padding:10px 20px; font-size:13.5px; border-radius:8px;">
                    <span class="material-symbols-outlined" style="font-size:18px;">sms</span>
                    <span id="resendSmsTxt">Resend SMS Code (60s)</span>
                </button>
            </form>
        </div>
    }

</div>

<script>
    (function () {
        let timeLeft = 60;
        const btn = document.getElementById('resendSmsBtn');
        const txt = document.getElementById('resendSmsTxt');
        if (!btn || !txt) return;

        const timer = setInterval(() => {
            timeLeft--;
            if (timeLeft <= 0) {
                clearInterval(timer);
                btn.disabled = false;
                txt.textContent = 'Resend SMS Code';
            } else {
                txt.textContent = 'Resend SMS Code (' + timeLeft + 's)';
            }
        }, 1000);
    })();
</script>
