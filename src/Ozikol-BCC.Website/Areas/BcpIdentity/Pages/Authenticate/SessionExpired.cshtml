@page
@model SessionExpiredModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Session Expired";
}

@* Session expiry sends users back into the Authenticate flow without exposing private
   Console or Workspace state after the authentication cookie is no longer valid. *@
<section class="m3-card">
    <div class="empty-state">
        <span class="material-symbols-outlined">timer_off</span>
        <strong>Session expired</strong>
        <span>Please sign in again to continue working in BCP.</span>
        <a class="console-btn primary" asp-page="/Authenticate/Login" asp-area="BcpIdentity">Sign in</a>
    </div>
</section>
