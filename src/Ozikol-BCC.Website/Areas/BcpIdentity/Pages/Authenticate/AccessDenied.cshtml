@page
@model AccessDeniedModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Access Denied";
}

@* Access denied is reached after authorization has already rejected the request.
   Keep this page explanatory; do not duplicate permission decisions in the view. *@
<section class="m3-card">
    <div class="empty-state">
        <span class="material-symbols-outlined">block</span>
        <strong>Access denied</strong>
        <span>Your account does not have permission to open this BCP resource.</span>
        <a class="console-btn primary" asp-page="/Authenticate/Login" asp-area="BcpIdentity">Sign in with another account</a>
    </div>
</section>
