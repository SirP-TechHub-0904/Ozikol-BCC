@page
@model Ozikol_BCC.Website.Areas.BcpIdentity.Pages.Authenticate.TwoFactorLoginModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Two-Factor Verification";
}

<form class="m3-card" method="post" style="max-width:440px; margin: 60px auto; padding:32px; border-radius:16px; border: 1px solid var(--md-sys-color-outline-variant); box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
    <div style="text-align:center; margin-bottom:24px;">
        <span class="material-symbols-outlined" style="font-size:48px; color:var(--md-sys-color-primary);">shield</span>
        <h2 style="margin:8px 0 0 0; font-size:22px; font-weight:700;">Two-Factor Verification</h2>
        <p style="margin:4px 0 0 0; font-size:14px; color:var(--sidebar-color);">Your account is protected by multi-factor security.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div style="padding:10px 14px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px; font-size:13px; margin-bottom:20px; line-height:1.4;">
            @Model.StatusMessage
        </div>
    }

    <div asp-validation-summary="All" style="color:var(--md-sys-color-error); font-size:13px; margin-bottom:16px;"></div>

    <div style="display:grid; gap:20px;">
        <div>
            @if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.GoogleAuthenticator)
            {
                <label style="font-weight:600; font-size:14px; display:block; margin-bottom:6px;">Google Authenticator Code</label>
                <p style="margin:0 0 12px 0; font-size:13px; color:var(--sidebar-color);">Open your Google Authenticator app and enter the active 6-digit code.</p>
            }
            else if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.MicrosoftAuthenticator)
            {
                <label style="font-weight:600; font-size:14px; display:block; margin-bottom:6px;">Microsoft Authenticator Code</label>
                <p style="margin:0 0 12px 0; font-size:13px; color:var(--sidebar-color);">Open your Microsoft Authenticator app and enter the active 6-digit code.</p>
            }
            else if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.Email)
            {
                <label style="font-weight:600; font-size:14px; display:block; margin-bottom:6px;">Email Verification Code</label>
                <p style="margin:0 0 12px 0; font-size:13px; color:var(--sidebar-color);">Enter the code sent to your email address: <strong>@Model.MaskedDestination</strong></p>
            }
            else if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.SMS)
            {
                <label style="font-weight:600; font-size:14px; display:block; margin-bottom:6px;">SMS Verification Code</label>
                <p style="margin:0 0 12px 0; font-size:13px; color:var(--sidebar-color);">Enter the text code sent to your phone number: <strong>@Model.MaskedDestination</strong></p>
            }
            else
            {
                <label style="font-weight:600; font-size:14px; display:block; margin-bottom:6px;">Authenticator App Code</label>
            }

            <input asp-for="Input.Code" placeholder="6-digit code" autocomplete="off" required 
                   style="width:100%; padding:12px; border:1px solid var(--md-sys-color-outline); border-radius:8px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); font-size:18px; font-weight:700; text-align:center; letter-spacing:4px;" />
            <span asp-validation-for="Input.Code" style="color:var(--md-sys-color-error); font-size:12px; display:block; margin-top:4px;"></span>
        </div>

        <div style="display:flex; align-items:center; gap:10px; padding:10px 14px; background:var(--md-sys-color-surface-container-low); border-radius:8px; border:1px solid var(--md-sys-color-outline-variant);">
            <input asp-for="Input.RememberClient" type="checkbox" id="RememberClient"
                   style="width:18px; height:18px; accent-color:var(--md-sys-color-primary); cursor:pointer;" />
            <label for="RememberClient" style="font-size:13.5px; font-weight:500; color:var(--md-sys-color-on-surface); cursor:pointer; user-select:none;">
                Trust this browser <span style="color:var(--sidebar-color); font-weight:400;">(skip 2FA next time)</span>
            </label>
        </div>

        <button class="console-btn primary" type="submit" style="padding:12px; font-size:15px; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
            <span class="material-symbols-outlined" style="font-size:20px;">login</span>
            <span>Verify & Authenticate</span>
        </button>

        @if (Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.Email || Model.ActiveProvider == Ozikol_BCC.Domain.Enum.Enum.BcpTwoFactorProvider.SMS)
        {
            <div style="text-align:center;">
                <button type="submit" asp-page-handler="ResendCode" id="resend2faBtn" class="console-btn secondary" disabled
                        style="width:100%; padding:10px; font-size:13.5px; display:inline-flex; align-items:center; justify-content:center; gap:6px;">
                    <span class="material-symbols-outlined" style="font-size:18px;">autorenew</span>
                    <span id="resend2faTxt">Resend 2FA Code (60s)</span>
                </button>
            </div>
        }

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px; font-size:13px;">
            <a class="console-link" asp-page="/Authenticate/RecoveryCodeLogin" asp-area="BcpIdentity" style="text-decoration:none;">Use recovery code</a>
            <a class="console-link" asp-page="/Authenticate/Login" asp-area="BcpIdentity" style="text-decoration:none;">Back to login</a>
        </div>
    </div>
</form>

<script>
    (function () {
        let timeLeft = 60;
        const btn = document.getElementById('resend2faBtn');
        const txt = document.getElementById('resend2faTxt');
        if (!btn || !txt) return;

        const timer = setInterval(() => {
            timeLeft--;
            if (timeLeft <= 0) {
                clearInterval(timer);
                btn.disabled = false;
                txt.textContent = 'Resend 2FA Code';
            } else {
                txt.textContent = 'Resend 2FA Code (' + timeLeft + 's)';
            }
        }, 1000);
    })();
</script>
