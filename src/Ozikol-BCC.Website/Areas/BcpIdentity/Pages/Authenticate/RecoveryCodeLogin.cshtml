@page
@model RecoveryCodeLoginModel
@attribute [AllowAnonymous]
@{
    ViewData["Title"] = "Recovery Code Login";
}

<form class="m3-card" method="post" style="max-width:440px; margin: 60px auto; padding:32px; border-radius:16px; border: 1px solid var(--md-sys-color-outline-variant); box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
    <div style="text-align:center; margin-bottom:24px;">
        <span class="material-symbols-outlined" style="font-size:48px; color:var(--md-sys-color-primary);">key</span>
        <h2 style="margin:8px 0 0 0; font-size:22px; font-weight:700;">Recovery Code Verification</h2>
        <p style="margin:4px 0 0 0; font-size:14px; color:var(--sidebar-color);">Use one of your emergency recovery codes to authenticate.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" style="color:var(--md-sys-color-error); font-size:13px; margin-bottom:16px; padding:10px 14px; background:rgba(239,68,68,0.08); border-radius:8px; border:1px solid rgba(239,68,68,0.2);"></div>
    }

    <div style="display:grid; gap:20px;">
        <div>
            <label asp-for="Input.RecoveryCode" style="font-weight:600; font-size:14px; display:block; margin-bottom:6px;">Emergency Recovery Code</label>
            <input asp-for="Input.RecoveryCode" placeholder="xxxx-xxxx-xxxx" autocomplete="off" required 
                   style="width:100%; padding:12px; border:1px solid var(--md-sys-color-outline); border-radius:8px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface); font-size:16px; font-weight:700; text-align:center; letter-spacing:2px; box-sizing:border-box;" />
            <span asp-validation-for="Input.RecoveryCode" style="color:var(--md-sys-color-error); font-size:12px; display:block; margin-top:4px;"></span>
        </div>

        <button class="console-btn primary" type="submit" style="padding:12px; font-size:15px; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
            <span class="material-symbols-outlined" style="font-size:20px;">key</span>
            <span>Verify Recovery Code</span>
        </button>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:8px; font-size:13px;">
            <a class="console-link" asp-page="/Authenticate/TwoFactorLogin" asp-area="BcpIdentity" style="text-decoration:none;">Use standard 2FA code</a>
            <a class="console-link" asp-page="/Authenticate/Login" asp-area="BcpIdentity" style="text-decoration:none;">Back to login</a>
        </div>
    </div>
</form>
