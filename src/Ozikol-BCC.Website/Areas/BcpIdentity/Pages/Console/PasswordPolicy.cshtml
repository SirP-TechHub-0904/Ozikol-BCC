@page
@model PasswordPolicyModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Password Policy";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "Password & Lockout Policy",
    Subtitle = "Configure system password complexity requirements, expiration timelines, and account lockout rules.",
    Icon = "password",
    Eyebrow = "Identity Console",
    BackUrl = "/BcpConsole/Console/Dashboard"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert" style="margin-bottom:20px; padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px;">
        <div>
            <strong>Success</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

<form method="post" style="max-width:800px; display:grid; gap:24px;">
    <section class="m3-card bcp-card" style="padding:24px;">
        <div class="card-header" style="margin-bottom:16px;">
            <span class="card-title" style="font-size:18px; font-weight:600;">Password Complexity Rules</span>
        </div>

        <div style="display:grid; gap:16px;">
            <div>
                <label asp-for="Input.PasswordMinLength" style="font-weight:500; display:block; margin-bottom:6px;"></label>
                <input asp-for="Input.PasswordMinLength" type="number" style="width:100%; max-width:200px; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" />
                <span asp-validation-for="Input.PasswordMinLength" style="color:var(--md-sys-color-error); font-size:12px;"></span>
            </div>

            <div style="display:grid; gap:12px; margin-top:8px;">
                <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                    <input type="checkbox" asp-for="Input.PasswordRequireDigit" style="width:18px; height:18px;" />
                    <span>@Html.DisplayNameFor(x => x.Input.PasswordRequireDigit)</span>
                </label>

                <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                    <input type="checkbox" asp-for="Input.PasswordRequireLowercase" style="width:18px; height:18px;" />
                    <span>@Html.DisplayNameFor(x => x.Input.PasswordRequireLowercase)</span>
                </label>

                <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                    <input type="checkbox" asp-for="Input.PasswordRequireUppercase" style="width:18px; height:18px;" />
                    <span>@Html.DisplayNameFor(x => x.Input.PasswordRequireUppercase)</span>
                </label>

                <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                    <input type="checkbox" asp-for="Input.PasswordRequireNonAlphanumeric" style="width:18px; height:18px;" />
                    <span>@Html.DisplayNameFor(x => x.Input.PasswordRequireNonAlphanumeric)</span>
                </label>
            </div>
        </div>
    </section>

    <section class="m3-card bcp-card" style="padding:24px;">
        <div class="card-header" style="margin-bottom:16px;">
            <span class="card-title" style="font-size:18px; font-weight:600;">Expiration & Lockout Controls</span>
        </div>

        <div style="display:grid; gap:16px;">
            <div>
                <label asp-for="Input.PasswordExpirationDays" style="font-weight:500; display:block; margin-bottom:6px;"></label>
                <input asp-for="Input.PasswordExpirationDays" type="number" style="width:100%; max-width:200px; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" />
                <span asp-validation-for="Input.PasswordExpirationDays" style="color:var(--md-sys-color-error); font-size:12px;"></span>
            </div>

            <div>
                <label asp-for="Input.MaxFailedAccessAttempts" style="font-weight:500; display:block; margin-bottom:6px;"></label>
                <input asp-for="Input.MaxFailedAccessAttempts" type="number" style="width:100%; max-width:200px; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" />
                <span asp-validation-for="Input.MaxFailedAccessAttempts" style="color:var(--md-sys-color-error); font-size:12px;"></span>
            </div>

            <div>
                <label asp-for="Input.LockoutDurationMinutes" style="font-weight:500; display:block; margin-bottom:6px;"></label>
                <input asp-for="Input.LockoutDurationMinutes" type="number" style="width:100%; max-width:200px; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" />
                <span asp-validation-for="Input.LockoutDurationMinutes" style="color:var(--md-sys-color-error); font-size:12px;"></span>
            </div>
        </div>
    </section>

    <div>
        <button type="submit" class="btn-custom active" style="padding:12px 24px; border-radius:8px; display:inline-flex; align-items:center; gap:8px;">
            <span class="material-symbols-outlined">save</span>
            <span>Save Password Policy</span>
        </button>
    </div>
</form>
