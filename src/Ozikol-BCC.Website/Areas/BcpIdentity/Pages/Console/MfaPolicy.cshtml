@page
@model MfaPolicyModel
@attribute [Authorize]
@{
    ViewData["Title"] = "MFA Policy";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "Multi-Factor Authentication (MFA) Policy",
    Subtitle = "Set platform enforcement rules for TOTP authenticator apps and secondary verification.",
    Icon = "phonelink_lock",
    Eyebrow = "Identity Console",
    BackUrl = "/BcpConsole/Console/Dashboard"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert" style="margin-bottom:20px; padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px;">
        <div>
            <strong>Success</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

<form method="post" style="max-width:800px; display:grid; gap:24px;">
    <section class="m3-card bcp-card" style="padding:24px;">
        <div class="card-header" style="margin-bottom:16px;">
            <span class="card-title" style="font-size:18px; font-weight:600;">Enforcement Rules</span>
        </div>

        <div style="display:grid; gap:16px;">
            <label style="display:flex; align-items:center; gap:12px; cursor:pointer;">
                <input type="checkbox" asp-for="Input.MfaRequiredForAdmins" style="width:20px; height:20px;" />
                <div>
                    <strong style="display:block; font-size:15px;">@Html.DisplayNameFor(x => x.Input.MfaRequiredForAdmins)</strong>
                    <span style="font-size:13px; color:var(--sidebar-color);">Require all BCP Console administrative users to complete 2FA before accessing Console features.</span>
                </div>
            </label>

            <hr style="border:0; border-top:1px solid var(--md-sys-color-outline-variant); margin:8px 0;" />

            <label style="display:flex; align-items:center; gap:12px; cursor:pointer;">
                <input type="checkbox" asp-for="Input.MfaRequiredGlobally" style="width:20px; height:20px;" />
                <div>
                    <strong style="display:block; font-size:15px;">@Html.DisplayNameFor(x => x.Input.MfaRequiredGlobally)</strong>
                    <span style="font-size:13px; color:var(--sidebar-color);">Enforce 2FA for every single user account (both Console and Workspace) across the platform.</span>
                </div>
            </label>
        </div>
    </section>

    <div>
        <button type="submit" class="btn-custom active" style="padding:12px 24px; border-radius:8px; display:inline-flex; align-items:center; gap:8px;">
            <span class="material-symbols-outlined">save</span>
            <span>Save MFA Policy</span>
        </button>
    </div>
</form>
