@page
@model SessionsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Active Sessions";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "User Sessions Control",
    Subtitle = "Monitor real-time user device logins, IP addresses, and force revoke suspicious sessions.",
    Icon = "devices",
    Eyebrow = "Identity Console",
    BackUrl = "/BcpConsole/Console/Dashboard"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert" style="margin-bottom:20px; padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px;">
        <div>
            <strong>Status Update</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

<section class="m3-card bcp-card" style="padding:24px;">
    <div class="card-header" style="margin-bottom:16px; display:flex; justify-content:space-between; align-items:center;">
        <span class="card-title" style="font-size:18px; font-weight:600;">Active Device Sessions (@Model.ActiveUserSessions.Count)</span>
    </div>

    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:14px; text-align:left;">
            <thead>
                <tr style="border-bottom:1px solid var(--md-sys-color-outline-variant); background:var(--md-sys-color-surface-container-low);">
                    <th style="padding:12px;">User Account</th>
                    <th style="padding:12px;">Device / Browser</th>
                    <th style="padding:12px;">IP Address</th>
                    <th style="padding:12px;">Last Active</th>
                    <th style="padding:12px; text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ActiveUserSessions.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="padding:20px; text-align:center; color:var(--sidebar-header-color);">No active device sessions recorded.</td>
                    </tr>
                }
                @foreach (var session in Model.ActiveUserSessions)
                {
                    var deviceIcon = session.DeviceType.ToLower() switch
                    {
                        "mobile" => "smartphone",
                        "tablet" => "tablet",
                        _ => "desktop_windows"
                    };

                    <tr style="border-bottom:1px solid var(--md-sys-color-outline-variant);">
                        <td style="padding:12px;">
                            <div style="font-weight:600;">@session.FullName</div>
                            <div style="font-size:12px; color:var(--sidebar-header-color);">@session.Email</div>
                        </td>
                        <td style="padding:12px;">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span class="material-symbols-outlined" style="font-size:18px; color:var(--sidebar-active-color);">@deviceIcon</span>
                                <span>@session.DeviceName</span>
                            </div>
                        </td>
                        <td style="padding:12px;">@session.IpAddress</td>
                        <td style="padding:12px;">@session.LastActiveAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td style="padding:12px; text-align:right;">
                            <div style="display:flex; gap:8px; justify-content:flex-end;">
                                <form method="post" asp-page-handler="RevokeSingle" style="display:inline;">
                                    <input type="hidden" name="sessionId" value="@session.SessionId" />
                                    <button type="submit" class="console-btn" style="padding:4px 10px; font-size:12px; color:var(--md-sys-color-error);" title="Revoke Single Session">
                                        <span class="material-symbols-outlined" style="font-size:16px;">logout</span>
                                        <span>Revoke Device</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="RevokeUserAll" style="display:inline;">
                                    <input type="hidden" name="userId" value="@session.UserId" />
                                    <button type="submit" class="console-btn" style="padding:4px 10px; font-size:12px; color:var(--md-sys-color-error); border-color:var(--md-sys-color-error);" title="Log Out All User Devices">
                                        <span class="material-symbols-outlined" style="font-size:16px;">power_settings_new</span>
                                        <span>Revoke All Devices</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
