@page
@model InvitationsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "User Invitations";
}

@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "User Invitations",
    Subtitle = "Issue secure invitation links to onboard new members, staff, or system users.",
    Icon = "mail",
    Eyebrow = "Identity Console",
    BackUrl = "/BcpConsole/Console/Dashboard"
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert" style="margin-bottom:20px; padding:12px 16px; background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); border-radius:8px;">
        <div>
            <strong>Status Update</strong>
            <p style="margin:4px 0 0 0;">@Model.StatusMessage</p>
        </div>
    </section>
}

<div style="display:grid; grid-template-columns: 1fr 2fr; gap:24px; align-items:start;">
    <form method="post" class="m3-card bcp-card" style="padding:24px;">
        <div class="card-header" style="margin-bottom:16px;">
            <span class="card-title" style="font-size:18px; font-weight:600;">Send New Invitation</span>
        </div>

        <div style="display:grid; gap:16px;">
            <div>
                <label asp-for="Input.Email" style="font-weight:500; display:block; margin-bottom:6px;"></label>
                <input asp-for="Input.Email" type="email" placeholder="user@example.com" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" required />
                <span asp-validation-for="Input.Email" style="color:var(--md-sys-color-error); font-size:12px;"></span>
            </div>

            <div>
                <label asp-for="Input.BcpUserCategoryId" style="font-weight:500; display:block; margin-bottom:6px;"></label>
                <select asp-for="Input.BcpUserCategoryId" asp-items="Model.CategoryOptions" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);"></select>
            </div>

            <div>
                <label asp-for="Input.RoleName" style="font-weight:500; display:block; margin-bottom:6px;"></label>
                <select asp-for="Input.RoleName" asp-items="Model.RoleOptions" style="width:100%; padding:10px; border:1px solid var(--md-sys-color-outline); border-radius:6px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);"></select>
            </div>

            <button type="submit" class="btn-custom active" style="padding:12px 20px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
                <span class="material-symbols-outlined">send</span>
                <span>Issue Invitation</span>
            </button>
        </div>
    </form>

    <section class="m3-card bcp-card" style="padding:24px;">
        <div class="card-header" style="margin-bottom:16px;">
            <span class="card-title" style="font-size:18px; font-weight:600;">Sent Invitations (@Model.Invitations.Count)</span>
        </div>

        @if (Model.Invitations.Count == 0)
        {
            <div style="padding:32px; text-align:center; color:var(--sidebar-color);">
                <span class="material-symbols-outlined" style="font-size:48px; color:var(--sidebar-color);">forward_to_inbox</span>
                <p style="margin-top:12px; font-size:15px;">No invitations issued yet.</p>
            </div>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table style="width:100%; border-collapse:collapse; font-size:14px; text-align:left;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--md-sys-color-outline-variant); background:var(--md-sys-color-surface-container-low);">
                            <th style="padding:12px;">Recipient Email</th>
                            <th style="padding:12px;">Category / Role</th>
                            <th style="padding:12px;">Status</th>
                            <th style="padding:12px;">Expires</th>
                            <th style="padding:12px; text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invite in Model.Invitations)
                        {
                            var isExpired = !invite.IsAccepted && invite.ExpiresAt < DateTime.UtcNow;
                            <tr style="border-bottom:1px solid var(--md-sys-color-outline-variant);">
                                <td style="padding:12px; font-weight:500;">@invite.Email</td>
                                <td style="padding:12px;">
                                    <div>@(invite.CategoryName ?? "No Category")</div>
                                    <small style="color:var(--sidebar-color);">@(invite.RoleName ?? "No Role")</small>
                                </td>
                                <td style="padding:12px;">
                                    @if (invite.IsAccepted)
                                    {
                                        <span class="badge-pill" style="background:var(--md-sys-color-primary-container); color:var(--md-sys-color-on-primary-container); padding:2px 8px; border-radius:12px;">Accepted</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge-pill" style="background:var(--md-sys-color-error-container); color:var(--md-sys-color-on-error-container); padding:2px 8px; border-radius:12px;">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pill" style="background:var(--md-sys-color-tertiary-container); color:var(--md-sys-color-on-tertiary-container); padding:2px 8px; border-radius:12px;">Pending</span>
                                    }
                                </td>
                                <td style="padding:12px;">@invite.ExpiresAt.ToString("yyyy-MM-dd")</td>
                                <td style="padding:12px; text-align:right;">
                                    @if (!invite.IsAccepted)
                                    {
                                        <form method="post" asp-page-handler="Cancel" asp-route-id="@invite.Id" style="display:inline;">
                                            <button type="submit" class="btn-custom" style="padding:4px 8px; font-size:12px; border-radius:4px; border:1px solid var(--md-sys-color-outline); background:transparent;">Cancel</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
