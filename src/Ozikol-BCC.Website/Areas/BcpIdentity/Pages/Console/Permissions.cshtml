@page
@model PermissionsModel
@attribute [Authorize]
@{
    ViewData["Title"] = "Identity Permissions";
}

@* Permission Matrix is the bridge between identity users and BCP feature access.
   Assignments here determine what Console/Workspace menus and actions should become visible. *@
@await Html.PartialAsync("Layouts/Bcp/_BcpPageHeader", new BcpPageHeaderModel
{
    Title = "Permission Matrix",
    Subtitle = "Assign BCP feature access by user, feature, and action role.",
    Icon = "admin_panel_settings",
    Eyebrow = "Identity Console",
    BackUrl = "/BcpConsole/Console/Dashboard",
    Buttons =
    [
        new("User Directory", "/BcpUserManagement/Console/Users", "groups", isPrimary: true)
    ]
})

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <section class="console-alert">
        <div>
            <strong>Permission update</strong>
            <p>@Model.StatusMessage</p>
        </div>
    </section>
}

<section class="dashboard-grid">
    <article class="m3-card bcp-card">
        <div class="card-header"><span class="card-title">Users</span></div>
        <div class="metric-value">@Model.TotalUsers</div>
        <p class="metric-note">Identity accounts available for BCP assignment.</p>
    </article>

    <article class="m3-card bcp-card">
        <div class="card-header"><span class="card-title">With access</span></div>
        <div class="metric-value">@Model.UsersWithFeatureAccess</div>
        <p class="metric-note">Users with at least one active feature role.</p>
    </article>

    <article class="m3-card bcp-card">
        <div class="card-header"><span class="card-title">Active roles</span></div>
        <div class="metric-value">@Model.ActiveAssignments</div>
        <p class="metric-note">Live permission assignments.</p>
    </article>

    <article class="m3-card bcp-card">
        <div class="card-header"><span class="card-title">Inactive roles</span></div>
        <div class="metric-value">@Model.InactiveAssignments</div>
        <p class="metric-note">Revoked or disabled assignments retained for audit.</p>
    </article>
</section>

<section class="chart-grid" style="align-items:start;">
    @* This assignment form writes one user + feature + action role at a time so future
       audit logs can clearly explain who granted which BCP capability. *@
    <form class="m3-card" method="post" asp-page-handler="Assign">
        <div class="card-header">
            <span class="card-title">Assign feature permission</span>
        </div>

        <div asp-validation-summary="ModelOnly" style="color:var(--md-sys-color-error); font-size:13px; margin-bottom:12px;"></div>

        <div style="display:grid; gap:16px;">
            <label class="label-large" for="ProfileId">User</label>
            <select id="ProfileId" name="Input.ProfileId" class="custom-dropdown-container" style="width:100%; padding:12px; border:1px solid var(--md-sys-color-outline); border-radius:8px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" required>
                <option value="">Select user</option>
                @foreach (var user in Model.Users)
                {
                    <option value="@user.Id" selected="@(Model.Input.ProfileId == user.Id)">@user.Name (@user.Email)</option>
                }
            </select>
            <span asp-validation-for="Input.ProfileId" style="color:var(--md-sys-color-error); font-size:12px;"></span>

            <label class="label-large" for="FeatureAreaKey">Feature</label>
            <select id="FeatureAreaKey" name="Input.FeatureAreaKey" style="width:100%; padding:12px; border:1px solid var(--md-sys-color-outline); border-radius:8px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" required>
                <option value="">Select feature</option>
                @foreach (var feature in Model.Features)
                {
                    <option value="@feature.Key" selected="@(Model.Input.FeatureAreaKey == feature.Key)">@feature.Name</option>
                }
            </select>
            <span asp-validation-for="Input.FeatureAreaKey" style="color:var(--md-sys-color-error); font-size:12px;"></span>

            <label class="label-large" for="ActionRole">Action role</label>
            <select id="ActionRole" name="Input.ActionRole" style="width:100%; padding:12px; border:1px solid var(--md-sys-color-outline); border-radius:8px; background:var(--md-sys-color-surface); color:var(--md-sys-color-on-surface);" required>
                @foreach (var role in Model.ActionRoles)
                {
                    <option value="@role.Value" selected="@(Model.Input.ActionRole == role.Value)">@role.Label</option>
                }
            </select>
            <span asp-validation-for="Input.ActionRole" style="color:var(--md-sys-color-error); font-size:12px;"></span>

            <label style="display:flex; align-items:center; gap:8px; color:var(--sidebar-color); font-size:13px;">
                <input type="checkbox" name="Input.IsActive" value="true" @(Model.Input.IsActive ? "checked" : "") />
                Active assignment
            </label>

            <button class="console-btn primary" type="submit">
                <span class="material-symbols-outlined">admin_panel_settings</span>
                Save permission
            </button>
        </div>
    </form>

    <section class="m3-card">
        <div class="card-header">
            <span class="card-title">Role meaning</span>
        </div>
        <div class="list-stack">
            @foreach (var role in Model.ActionRoles)
            {
                <div class="list-row">
                    <span class="list-icon"><span class="material-symbols-outlined">shield_person</span></span>
                    <div class="row-main">
                        <div class="row-title">@role.Label</div>
                        <div class="row-sub">@role.Description</div>
                    </div>
                </div>
            }
        </div>
    </section>
</section>

<section class="m3-card" style="margin-top:24px;">
    @* Current assignments are retained after revocation so administrators can review
       historical feature access rather than losing the security trail. *@
    <div class="card-header">
        <span class="card-title">Current assignments</span>
    </div>

    <div class="table-responsive-container">
        <table class="orders-table table-dense">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Feature</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Permissions.Any())
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state" style="min-height:140px;">
                                <span class="material-symbols-outlined">admin_panel_settings</span>
                                <strong>No permissions yet</strong>
                                <span>Assign the first BCP feature permission from the form above.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var permission in Model.Permissions)
                    {
                        <tr>
                            <td>
                                <div class="row-title">@permission.UserName</div>
                                <div class="row-sub">@permission.Email</div>
                            </td>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span class="list-icon"><span class="material-symbols-outlined">@permission.Icon</span></span>
                                    <div>
                                        <div class="row-title">@permission.FeatureName</div>
                                        <div class="row-sub">@permission.FeatureAreaKey</div>
                                    </div>
                                </div>
                            </td>
                            <td>@permission.ActionRoleLabel</td>
                            <td>
                                <span class="status-pill @(permission.IsActive ? "good" : "muted")">
                                    @(permission.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@permission.Date.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                            <td>
                                @if (permission.IsActive)
                                {
                                    <form method="post" asp-page-handler="Revoke" asp-route-id="@permission.Id">
                                        <button class="console-btn" type="submit">
                                            <span class="material-symbols-outlined">block</span>
                                            Revoke
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="row-sub">Revoked</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
