@page "/Source/{id}/{title}"
@using System.Text.RegularExpressions;

@{
    Regex regex = new Regex("[^a-zA-Z0-9]");
}
@model Ozikol_BCC.Website.Pages.SitePageModel
@{
    ViewData["Title"] = Model.WebPage.Title;

    ViewData["PageName"] = Model.WebPage.Title;
    ViewData["Description"] = Model.ConfigSetting.CompanyDescription;
    ViewData["Image"] = Model.ConfigSetting.CompanyLogoUrl;
}

<partial name="Partials/_Breadcrum" model="Model.WebPage.Id" />
<partial name="Partials/_PageSection" model="new Ozikol_BCC.Application.Queries.PageSectionQueries.GetPageSectionsByCriteriaQuery { WebPageId = Model.WebPage.Id }" />
