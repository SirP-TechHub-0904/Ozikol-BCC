@using Ozikol_BCC.Application.Repository.Services
@inject ISettingsService SettingsService
@{
    var configDto = await SettingsService.GetConfigAsync();
    ViewBag.ConfigSetting = configDto;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="Partials/_WebTitle" model="configDto" />
    
    <!-- Default Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <style>
        body {
            padding-top: 5rem;
            background-color: #f8f9fa;
        }
        .starter-template {
            padding: 3rem 1.5rem;
            text-align: center;
        }
    </style>

    <partial name="Partials/_WebsiteCSS" model="configDto" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="Partials/_Reloader" />

    <partial name="Partials/_Menu" />

    <main class="container">
        @RenderBody()
    </main>
    
    <partial name="Partials/_Footer" />

    <!-- Default Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmxc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    
    <partial name="Partials/_CustomeJavascript" model="configDto" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
