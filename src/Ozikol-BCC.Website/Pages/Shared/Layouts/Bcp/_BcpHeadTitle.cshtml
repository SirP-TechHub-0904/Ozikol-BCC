@using Microsoft.EntityFrameworkCore
@using Ozikol_BCC.Domain.Models
@inject Ozikol_BCC.Persistence.EF.SQL.DashboardDbContext DbContext
@{
    ConfigSetting? bcpConfig = null;

    try
    {
        bcpConfig = await DbContext.ConfigSettings.AsNoTracking().FirstOrDefaultAsync();
    }
    catch
    {
        // The first-run setup and broken database states must still render a usable browser title.
    }

    var tenantTitle = bcpConfig?.DashboardTitle
        ?? bcpConfig?.WebsiteTitle
        ?? bcpConfig?.CompanyName
        ?? bcpConfig?.OrganizationDisplayName
        ?? "Dashboard";
    var pageTitle = ViewData["Title"]?.ToString();
}
<title>@(string.IsNullOrWhiteSpace(pageTitle) ? tenantTitle : $"{pageTitle} - {tenantTitle}")</title>
