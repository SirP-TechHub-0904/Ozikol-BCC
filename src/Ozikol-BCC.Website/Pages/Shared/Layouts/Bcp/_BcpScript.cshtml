@* Central BCP interaction script: sidebar/topbar standardization, theme, pinned tasks,
   dropdown behavior, and guided tour live here for every authorized BCP shell. *@
<script src="~/bcp/js/bcp-layout.js" asp-append-version="true"></script>

@if (User.Identity?.IsAuthenticated == true)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        (function() {
            if (window.bcpGlobalSignalRInitialized) return;
            window.bcpGlobalSignalRInitialized = true;

            const currentUserId = "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value";
            let globalAudioCtx = null;

            function playSound(isMention) {
                try {
                    if (!globalAudioCtx) {
                        globalAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                    }
                    if (globalAudioCtx.state === 'suspended') {
                        globalAudioCtx.resume();
                    }
                    const osc = globalAudioCtx.createOscillator();
                    const gain = globalAudioCtx.createGain();
                    osc.connect(gain);
                    gain.connect(globalAudioCtx.destination);
                    const now = globalAudioCtx.currentTime;

                    if (isMention) {
                        // Mention Chime: High pitched triple alert
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(880, now);
                        osc.frequency.setValueAtTime(1174.66, now + 0.1);
                        osc.frequency.setValueAtTime(1396.91, now + 0.2);
                        gain.gain.setValueAtTime(0.4, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
                        osc.start(now);
                        osc.stop(now + 0.6);
                    } else {
                        // Outside Chat Tone: High-pitched double chime
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(783.99, now);
                        osc.frequency.setValueAtTime(1046.50, now + 0.12);
                        gain.gain.setValueAtTime(0.3, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);
                        osc.start(now);
                        osc.stop(now + 0.5);
                    }
                } catch(e) {
                    console.error("Global Audio Error:", e);
                }
            }

            function showToastAlert(senderName, groupTitle, content, targetGroupId, isMention) {
                let container = document.getElementById('bcpToastContainer');
                if (!container) {
                    container = document.createElement('div');
                    container.id = 'bcpToastContainer';
                    container.className = 'bcp-toast-container';
                    document.body.appendChild(container);
                }

                // Truncate to first 5 words
                let displayContent = content || '';
                const words = displayContent.trim().split(/\s+/);
                if (words.length > 5) {
                    displayContent = words.slice(0, 5).join(' ') + '...';
                }

                const toast = document.createElement('div');
                toast.className = `bcp-chat-toast-alert ${isMention ? 'mention-alert' : ''}`;
                if (isMention) {
                    toast.style.borderLeftColor = '#f59e0b';
                }
                toast.onclick = function() {
                    window.location.href = `/BcpGroups/Workspace/Chat/${targetGroupId}`;
                };

                const titleHtml = isMention
                    ? `<strong style="color:#d97706;">📢 ${senderName} mentioned you</strong> in ${groupTitle || 'Group'}`
                    : `<strong>${senderName}</strong> sent a message in ${groupTitle || 'Group'}`;

                toast.innerHTML = `
                    <div class="bcp-chat-toast-icon" style="${isMention ? 'background:#fef3c7; color:#d97706;' : ''}">
                        <span class="material-symbols-outlined">${isMention ? 'alternate_email' : 'chat'}</span>
                    </div>
                    <div class="bcp-chat-toast-content">
                        <div class="bcp-chat-toast-title">${titleHtml}</div>
                        <div class="bcp-chat-toast-body">${displayContent}</div>
                    </div>
                    <button class="bcp-chat-toast-close" onclick="event.stopPropagation(); this.parentElement.remove();">✕</button>
                `;

                container.appendChild(toast);
                playSound(isMention);

                setTimeout(() => {
                    if (toast && toast.parentElement) toast.remove();
                }, 7000);
            }

            const globalConn = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/group-chat")
                .withAutomaticReconnect()
                .build();

            globalConn.on("ReceiveMessage", function(msg) {
                const senderId = msg.userId || msg.UserId;
                const targetGroupId = msg.groupId || msg.GroupId;
                const groupTitle = msg.groupTitle || msg.GroupTitle || 'Chat';
                const senderName = msg.userName || msg.UserName || 'Someone';
                const content = msg.content || msg.Content || '';
                const mentionedUserIds = msg.mentionedUserIds || msg.MentionedUserIds || '';

                if (senderId && senderId !== currentUserId) {
                    const isMention = (mentionedUserIds && mentionedUserIds.includes(currentUserId)) || content.includes('\x40');
                    const isCurrentChatPage = window.location.pathname.toLowerCase().includes(`/workspace/chat/${targetGroupId}`.toLowerCase());

                    if (isMention || !isCurrentChatPage) {
                        showToastAlert(senderName, groupTitle, content, targetGroupId, isMention);
                    }
                }
            });

            globalConn.start().catch(err => console.error("Global SignalR error:", err));
        })();
    </script>
}
