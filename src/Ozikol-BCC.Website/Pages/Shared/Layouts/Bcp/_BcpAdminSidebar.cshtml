@using Microsoft.EntityFrameworkCore
@using Ozikol_BCC.Domain.Models
@inject Ozikol_BCC.Persistence.EF.SQL.DashboardDbContext DbContext
@{
    ConfigSetting? bcpConfig = null;

    try
    {
        bcpConfig = await DbContext.ConfigSettings.AsNoTracking().FirstOrDefaultAsync();
    }
    catch
    {
        // Sidebar branding should not block navigation during first-run database work.
    }

    var path = Context.Request.Path.Value ?? string.Empty;
    var brandName = bcpConfig?.DashboardTitle
        ?? bcpConfig?.CompanyName
        ?? bcpConfig?.WebsiteTitle
        ?? "BCP";
    var logoUrl = !string.IsNullOrWhiteSpace(bcpConfig?.CompanyLogoUrl)
        ? bcpConfig.CompanyLogoUrl
        : !string.IsNullOrWhiteSpace(bcpConfig?.CompanyIconUrl)
            ? bcpConfig.CompanyIconUrl
            : "/bcp/img/Ozikol-Logo.png";
    var iconUrl = !string.IsNullOrWhiteSpace(bcpConfig?.CompanyIconUrl)
        ? bcpConfig.CompanyIconUrl
        : !string.IsNullOrWhiteSpace(bcpConfig?.CompanyLogoUrl)
            ? bcpConfig.CompanyLogoUrl
            : "/bcp/img/icon.png";

    string Active(string url) => path.Equals(url, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string Open(params string[] urls) => urls.Any(url => path.StartsWith(url, StringComparison.OrdinalIgnoreCase)) ? "open" : "";
}

