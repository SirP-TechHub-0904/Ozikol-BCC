<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @await Html.PartialAsync("Layouts/Bcp/_BcpHeadTitle")
    @await Html.PartialAsync("Layouts/Bcp/_BcpDashboardCSS")
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("Layouts/Bcp/_BcpAdminSidebar")

    <main id="main-content">
        @await Html.PartialAsync("Layouts/Bcp/_BcpTopbar")
        <div class="bcp-page-shell">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("Layouts/Bcp/_BcpContextualHelp")
    @await Html.PartialAsync("Layouts/Bcp/_BcpScript")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
