@model Ozikol_BCC.Website.Models.BcpPageHeaderModel

@* Shared page header for authorized BCP screens. Pages pass title metadata and grouped action
   buttons here so Console, Workspace, and feature dashboards keep the same command surface. *@
<section class="bcp-page-header">
    <div class="bcp-page-header-main">
        @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
        {
            <div class="bcp-header-eyebrow">@Model.Eyebrow</div>
        }

        <div class="bcp-header-title-row">
            @if (!string.IsNullOrWhiteSpace(Model.Icon))
            {
                <span class="bcp-header-icon material-symbols-outlined">@Model.Icon</span>
            }
            <h1 class="bcp-page-title">@Model.Title</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <p class="bcp-page-subtitle">@Model.Subtitle</p>
        }
    </div>

    @if (Model.Buttons.Count > 0 || !string.IsNullOrWhiteSpace(Model.BackUrl))
    {
        @* Button groups should contain page-level commands only. Feature/sidebar visibility is
           resolved elsewhere from enabled features, roles, and permission assignments. *@
        <div class="bcp-page-actions btn-group-outlined" role="group" aria-label="@Model.Title actions">
            @if (!string.IsNullOrWhiteSpace(Model.BackUrl))
            {
                <a class="btn-custom" href="@Model.BackUrl">
                    <span class="material-symbols-outlined">arrow_back</span>
                    <span>@(Model.BackText ?? "Back")</span>
                </a>
            }
            @foreach (var button in Model.Buttons)
            {
                var cssClass = button.IsPrimary ? "btn-custom active" : "btn-custom";
                if (button.IsDisabled)
                {
                    <span class="@cssClass disabled" aria-disabled="true">
                        <span class="material-symbols-outlined">@button.Icon</span>
                        <span>@button.Text</span>
                    </span>
                }
                else
                {
                    <a class="@cssClass" href="@button.Url" target="@button.Target" aria-label="@(button.AriaLabel ?? button.Text)">
                        <span class="material-symbols-outlined">@button.Icon</span>
                        <span>@button.Text</span>
                    </a>
                }
            }
        </div>
    }
</section>
