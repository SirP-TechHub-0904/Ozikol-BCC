@using Microsoft.AspNetCore.Identity
@using Ozikol_BCC.Domain.Models
@inject UserManager<Profile> UserManager
@{
    Profile? currentUser = null;
    string userEmail = "User";
    string userRole = "Signed in";

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            userEmail = currentUser.Email ?? currentUser.UserName ?? "User";
            var roles = await UserManager.GetRolesAsync(currentUser);
            userRole = roles.FirstOrDefault() ?? "Member";
        }
    }
}

@* Placeholder consumed by bcp-layout.js so every authorized BCP page receives the
   same search, task, notification, theme, and account command surface. *@
<header id="topbar" aria-label="BCP top bar" data-user-email="@userEmail" data-user-role="@userRole"></header>
