@using MediatR
@using Ozikol_BCC.Application.Queries.SliderQueries
@using Ozikol_BCC.Application.Queries.BlogQueries
@using System.Text.RegularExpressions;
@inject IMediator Mediator
@{
    var sliderData = await Mediator.Send(new GetSliderAggregatedDataQuery());
    var config = sliderData.ConfigSetting;
    var blogsData = await Mediator.Send(new GetRecentBlogsQuery { Limit = 5, PageNumber = 1 });

    Regex regex = new Regex("[^a-zA-Z0-9]");
}

@if (config != null && ViewBag.ConfigSetting.EnableBreakingNewsRibon == true && blogsData.Blogs.Any())
{
    <div class="containerx custom-data">
        <div class="headertext">@ViewBag.ConfigSetting.BreakingNewsRibonTitle</div>

        <div>
            <marquee style=""
                     onmouseover="this.stop();" onmouseout="this.start();"
                     direction="left" behavior="scroll" scrollamount="7">
                @foreach (var item in blogsData.Blogs)
                {
                    var cleanTitle = regex.Replace(item.Title ?? "", "-");
                    <a asp-page="/Blog" asp-route-id="@item.Id" asp-route-title="@cleanTitle" style="">@item.Title</a>
                }
            </marquee>
        </div>
    </div>
}
