@model Ozikol_BCC.Domain.Models.WebPage

@{
    string layoutKey = ViewBag.ConfigSetting?.TemplateLayoutKey ?? "_DefaultLayout";
    var themeData = Context.Request.Query["previewTheme"].FirstOrDefault() ?? layoutKey;
    var themeFolderName = themeData;
    var componentKey = ViewBag.ConfigSetting?.PageHeaderTemplateKey;
    
    // We attempt to load the specific component key template if it exists, otherwise fallback to the base template
    var partialPath = string.IsNullOrEmpty(componentKey) ? $"~/Pages/Shared/Templates/{themeFolderName}/_Breadcrum.cshtml" : $"~/Pages/Shared/Templates/{themeFolderName}/_Breadcrum_{componentKey}.cshtml";
}

@try
{
    @await Html.PartialAsync(partialPath, Model)
}
catch (Exception ex)
{
    try
    {
        // Fallback to base breadcrumb if the specific keyed one is missing
        @await Html.PartialAsync($"~/Pages/Shared/Templates/{themeFolderName}/_Breadcrum.cshtml", Model)
    }
    catch (Exception innerEx)
    {
        <!-- Breadcrum not found for theme @themeFolderName -->
    }
}
