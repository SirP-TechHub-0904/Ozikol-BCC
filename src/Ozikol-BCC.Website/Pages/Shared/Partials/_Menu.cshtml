@model Ozikol_BCC.Application.Dtos.UI.ConfigSettingDto

@{
    var themeData = Context.Request.Query["previewTheme"].FirstOrDefault() ?? Model.TemplateLayoutKey;
    var themeFolderName = themeData;
    
    // Always load the base template for the menu as there is no specific component key
    var partialPath = $"~/Pages/Shared/Templates/{themeFolderName}/_Menu.cshtml";
}

@try
{
    @await Html.PartialAsync(partialPath, Model)
}
catch (Exception ex)
{
    try
    {
        // Fallback to base menu if the specific keyed one is missing
        @await Html.PartialAsync($"~/Pages/Shared/Templates/{themeFolderName}/_Menu.cshtml", Model)
    }
    catch (Exception innerEx)
    {
        <!-- Menu not found for theme @themeFolderName -->
    }
}
