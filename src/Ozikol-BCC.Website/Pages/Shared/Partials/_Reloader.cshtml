@model Ozikol_BCC.Application.Dtos.UI.ConfigSettingDto

@{
    var themeData = Context.Request.Query["previewTheme"].FirstOrDefault() ?? Model.TemplateLayoutKey;
    var themeFolderName = themeData;
    var componentKey = Model.ReloaderTemplateKey;
}

@try
{
    @await Html.PartialAsync($"~/Pages/Shared/Templates/{themeFolderName}/_Reloader.cshtml", Model)
}
catch (Exception ex)
{
    <!-- Reloader not found for theme @themeFolderName -->
}
