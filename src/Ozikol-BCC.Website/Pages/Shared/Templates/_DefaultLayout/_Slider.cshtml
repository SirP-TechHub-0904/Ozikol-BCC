@using MediatR
@using Ozikol_BCC.Application.Queries.SliderQueries
@inject IMediator Mediator
@using System.Text.RegularExpressions;
@using Ozikol_BCC.Application.Services;

@{
    var sliderData = await Mediator.Send(new GetSliderAggregatedDataQuery());
    var sliders = sliderData.Sliders;
}

@if (sliders.Count() > 0)
{
    <div id="defaultCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @{ var isFirst = true; }
            @foreach (var item in sliders)
            {
                <div class="carousel-item @(isFirst ? "active" : "")">
                    <img src="@item.ImageUrl" class="d-block w-100" alt="@item.Title" style="height: 60vh; object-fit: cover;">
                    <div class="carousel-caption d-none d-md-block" style="background: rgba(0,0,0,0.5); border-radius: 10px;">
                        <h5>@Html.Raw(item.Title)</h5>
                        <p>@Html.Raw(item.Text)</p>
                        @if (item.Link != "0")
                        {
                            <a href="@(item.Link == "000" ? "/ContactUs" : $"/Page?id={item.Link}")" class="btn btn-primary">@Html.Raw(item.ButtonText)</a>
                        }
                    </div>
                </div>
                isFirst = false;
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#defaultCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#defaultCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}
