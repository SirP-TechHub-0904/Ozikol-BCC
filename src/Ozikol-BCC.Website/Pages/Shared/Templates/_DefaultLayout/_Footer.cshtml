@using MediatR
@using Ozikol_BCC.Application.Queries.SliderQueries
@inject IMediator Mediator
@using System.Text.RegularExpressions;
@using Ozikol_BCC.Application.Services;

@{
    var sliderData = await Mediator.Send(new GetSliderAggregatedDataQuery());
    var xsetting = sliderData.ConfigSetting;
    var configsetting = sliderData.ConfigSetting;
    var ViewBag_setting = sliderData.ConfigSetting;
    var pages = sliderData.MenuCategories;
    var linkExternal = sliderData.ExternalLinks;
    var SecPages = sliderData.FooterPages;
    Regex regex = new Regex("[^a-zA-Z0-9]");
}

<footer>
    <div class="container">
        <div class="row">
            <!-- Column 1 Start -->
            <div class="col-md-3 col-sm-6 col-12">
                <h3>About Us</h3>
                <div class="mt-25">
                    <p class="mt-25">
                        @ViewBag_setting.Qoute
                    </p>
                    <div class="footer-social-icons mt-25">
                        <ul>
                            <li><a href="@ViewBag_setting.FacebookPage"><i class="fab fa-facebook-square"></i></a></li>
                            <li><a href="@ViewBag_setting.InstagramPage"><i class="fab fa-instagram"></i></a></li>
                            <li><a href="@ViewBag_setting.TwitterPage"><i class="fab fa-twitter"></i></a></li>
                            <li><a href="@ViewBag_setting.YoutubeChannel"><i class="fab fa-youtube"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- Column 1 End -->
            <!-- Column 2 Start -->
            <div class="col-md-3 col-sm-6 col-12">
                <h3>Quick Links</h3>
                <ul class="footer-list">
                    @foreach (var item in pages)
                    {
                        <li><a asp-page="/Page" asp-route-id="@item.Id" asp-route-title="@MainServices.GenerateSlug(item.Title)">@item.Title</a></li>
                    }

                </ul>
            </div>
            <!-- Column 2 End -->
            <!-- Column 3 Start -->
            <div class="col-md-3 col-sm-6 col-12">
                <h3>Other Links</h3>
                <ul class="footer-list">
                    @if (ViewBag_setting.AddFaqToFooter == true)
                    {
                        <li><a asp-page="/FAQ">FAQs</a></li>
                    }
                    @if (ViewBag_setting.AddTestimonyToFooter == true)
                    {
                        <li><a asp-page="/Testimonials">Testimony</a></li>
                    }
                    @if (ViewBag_setting.AddBlogToMenu == true)
                    {
                        <li>
                            <a asp-page="/Insights">@ViewBag_setting.BlogDisplayTitle</a>

                        </li>
                    }
                    @if (ViewBag_setting.ShowProductsInFooter == true)
                    {
                        <li>
                            <a asp-page="/Catalog">@ViewBag.ConfigSetting.ProductTitle</a>

                        </li>
                    }
                    @if (ViewBag.ConfigSetting.ActivateProfilePortfolio == true && ViewBag.ConfigSetting.ShowInFooterPortfolio == true)
                    {
                        <li>
                            <a asp-page="/PortfolioAccount">@ViewBag.ConfigSetting.PortfolioTitle</a>

                        </li>
                    }
                    @if (ViewBag.ConfigSetting.ShowContactUsFooter == true)
                    {
                        <li>
                            <a asp-page="/ContactUs">Contact Us</a>

                        </li>
                    }
                    @if (ViewBag.ConfigSetting.AddCareerToFooter == true)
                    {
                        <li>
                            <a asp-page="/Careers">@ViewBag.ConfigSetting.CareerDisplayTitle</a>

                        </li>
                    }
                    @foreach (var item in linkExternal)
                    {
                        <li>
                            <a target="_blank" href="@item.DirectUrl">@item.Title</a>

                        </li>

                    }
                    @foreach (var item in SecPages)
                    {
                        <li><a asp-page="/Page" asp-route-id="@item.Id" asp-route-title="@MainServices.GenerateSlug(item.Title)">@item.Title</a></li>
                    }
                    @if (ViewBag.ConfigSetting.ActivateLogin == true)
                    {
                        <li><a asp-page="/AuthV2/Account/Login" asp-area="V2">Login</a></li>
                    }
                    <li><a asp-page="/Sitemap">Sitemap</a></li>
                </ul>
            </div>
            <!-- Column 3 End -->
            <!-- Column 4 Start -->
            <div class="col-md-3 col-sm-6 col-12">
                <h3>Working Hour</h3>
                <div class="footer-tags mt-25">
                    @Html.Raw(ViewBag_setting.WorkingHour)

                </div>

                <br />
                @if (ViewBag_setting.ShowEmailOneInFooter == true)
                {
                    <h3>Contact Details</h3>
                    <div class="footer-tags mt-25">
                        <ul>
                            @if (ViewBag_setting.ShowEmailOneInFooter == true)
                            {
                                <li>
                                    <i class="fa fa-envelope"></i>  @ViewBag_setting.EmailOne
                                </li>
                            }
                            @if (ViewBag_setting.ShowEmailTwoInFooter == true)
                            {
                                <li>
                                    <i class="fa fa-envelope"></i>  @ViewBag_setting.EmailTwo
                                </li>
                            }
                            @if (ViewBag_setting.ShowEmailThreeInFooter == true)
                            {
                                <li>
                                    <i class="fa fa-envelope"></i>  @ViewBag_setting.EmailThree
                                </li>
                            }
                            @if (ViewBag_setting.ShowPhoneOneInFooter == true)
                            {
                                <li>
                                    <i class="fas fa-phone"></i>  @ViewBag_setting.PhoneOne
                                </li>
                            }
                            @if (ViewBag_setting.ShowPhoneTwoInFooter == true)
                            {
                                <li>
                                    <i class="fas fa-phone"></i>  @ViewBag_setting.PhoneTwo
                                </li>
                            }
                            @if (ViewBag_setting.ShowPhoneThreeInFooter == true)
                            {
                                <li>
                                    <i class="fas fa-phone"></i>  @ViewBag_setting.PhoneThree
                                </li>
                            }

                        </ul>

                    </div>
                }
            </div>
            <!-- Column 4 End -->
        </div>

        <!-- Footer Bar Start -->
        <div class="footer-bar">
            <p>
                <span class="primary-color">@ViewBag.ConfigSetting.CompanyName</span> © @DateTime.UtcNow.Year. All Rights Reserved. @if (ViewBag.ConfigSetting.ShowMadeByJuray == true)
                {
                    <span>
                        Developed by

                        @if (ViewBag.ConfigSetting.ShowMadeByXYZ == true)
                        {
                            <a href="https://www.exwhyzee.ng/" target="_blank" style="color:white;" class="devby">
                                Exwhyzee Technologies Limited.
                            </a>
                        }
                        else
                        {
                            <a href="https://www.juray.ng/" target="_blank" style="color:white;" class="devby">
                                Juray Smart Solutions Limited.
                            </a>
                        }


                    </span>
                }
            </p>

            <p class="float-right"></p>

        </div>
        <!-- Footer Bar End -->
    </div>
</footer>
