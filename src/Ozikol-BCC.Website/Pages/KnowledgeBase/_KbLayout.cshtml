@using Ozikol_BCC.Persistence.EF.SQL
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Linq
@using System.Collections.Generic
@inject DashboardDbContext _context
@{
    var isSuperAdmin = User.Identity?.IsAuthenticated == true && User.IsInRole("PlatformOwner");
    var userRoles = User.Identity?.IsAuthenticated == true ? User.Claims.Where(c => c.Type == ClaimTypes.Role).Select(c => c.Value).ToList() : new List<string>();

    var allModules = await _context.BcpManuals
        .Include(m => m.BcpManualPages)
            .ThenInclude(p => p.BcpManualElements)
        .OrderBy(m => m.Title).ToListAsync();

    var modules = new List<Ozikol_BCC.Domain.Models.BcpManual>();
    foreach (var manual in allModules)
    {
        bool hasAccess = false;
        if (!manual.BcpManualPages.Any()) continue;
        foreach (var page in manual.BcpManualPages)
        {
            if (page.BcpManualElements == null || !page.BcpManualElements.Any())
            {
                hasAccess = true;
                break;
            }
            foreach (var el in page.BcpManualElements)
            {
                if (isSuperAdmin || string.IsNullOrEmpty(el.RequiredRole) || userRoles.Contains(el.RequiredRole))
                {
                    hasAccess = true;
                    break;
                }
            }
            if (hasAccess) break;
        }
        if (hasAccess) modules.Add(manual);
    }

    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Knowledge Base</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
            color: #343a40;
            display: flex;
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
        }

        /* Sidebar Sidebar */
        #kb-sidebar {
            width: 280px;
            background-color: #ffffff;
            border-right: 1px solid #e9ecef;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 1040;
        }

        .kb-sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid #e9ecef;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .kb-sidebar-nav {
            padding: 1rem 0;
            overflow-y: auto;
            flex-grow: 1;
        }

        .kb-nav-item {
            padding: 0.5rem 1.5rem;
            display: block;
            color: #495057;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .kb-nav-item:hover {
            color: #0d6efd;
            background-color: #f8f9fa;
        }

        .kb-nav-item.active {
            color: #0d6efd;
            background-color: #e7f1ff;
            border-right: 3px solid #0d6efd;
        }

        /* Main Content Area */
        #kb-main {
            flex-grow: 1;
            margin-left: 280px;
            display: flex;
            flex-direction: column;
            min-width: 0; /* Prevents overflow */
        }

        .kb-topbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e9ecef;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .kb-content {
            padding: 2rem 1.5rem;
            max-width: 900px;
            margin: 0 auto;
            width: 100%;
            flex-grow: 1;
        }

        /* Mobile Adjustments */
        @@media (max-width: 991.98px) {
            #kb-sidebar {
                transform: translateX(-100%);
            }
            #kb-sidebar.show {
                transform: translateX(0);
            }
            #kb-main {
                margin-left: 0;
            }
            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: rgba(0, 0, 0, 0.5);
                z-index: 1035;
            }
            .sidebar-overlay.show {
                display: block;
            }
        }
    </style>
</head>
<body>

    <!-- Mobile Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <aside id="kb-sidebar">
        <div class="kb-sidebar-header">
            <a href="/kb" class="text-decoration-none text-dark d-flex align-items-center">
                <i class="bi bi-journal-richtext text-primary fs-4 me-2"></i>
                <h5 class="mb-0 fw-bold">Knowledge Base</h5>
            </a>
            <button class="btn btn-sm btn-light d-lg-none" id="closeSidebarBtn">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="kb-sidebar-nav">
            <div class="px-4 mb-2 text-muted fs-8 fw-bold text-uppercase tracking-wide">Modules</div>
            @foreach (var module in modules)
            {
                var isActive = currentPath.Contains($"/kb/{module.ModuleFolder.ToLower()}");
                <a href="/kb/@module.ModuleFolder" class="kb-nav-item @(isActive ? "active" : "")">
                    <i class="bi bi-folder2 me-2 opacity-75"></i> @module.Title
                </a>
            }
        </div>
        <div class="p-3 border-top text-center">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/BcpUserManagement/Platform" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Back to Platform
                </a>
            }
            else
            {
                <a href="/" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                    <i class="bi bi-house me-1"></i> Back to Home
                </a>
            }
        </div>
    </aside>

    <!-- Main -->
    <main id="kb-main">
        <div class="kb-topbar shadow-sm">
            <div class="d-flex align-items-center">
                <button class="btn btn-light d-lg-none me-3" id="openSidebarBtn">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="input-group" style="max-width: 300px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="kbSearchInput" class="form-control bg-light border-start-0" placeholder="Search articles...">
                </div>
            </div>
            <div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; font-weight: 600;">
                            @User.Identity.Name.Substring(0, 1).ToUpper()
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Identity/Account/Login" class="btn btn-primary btn-sm rounded-pill px-3">Sign In</a>
                }
            </div>
        </div>

        <div class="kb-content">
            @RenderBody()
        </div>

        <footer class="mt-auto py-4 text-center text-muted fs-7 border-top">
            <p class="mb-0">&copy; @DateTime.Now.Year Knowledge Base. All rights reserved.</p>
        </footer>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('kb-sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const openBtn = document.getElementById('openSidebarBtn');
            const closeBtn = document.getElementById('closeSidebarBtn');

            function toggleSidebar() {
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            }

            if (openBtn) openBtn.addEventListener('click', toggleSidebar);
            if (closeBtn) closeBtn.addEventListener('click', toggleSidebar);
            if (overlay) overlay.addEventListener('click', toggleSidebar);

            // Simple client-side search across .searchable-item elements
            const searchInput = document.getElementById('kbSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const term = e.target.value.toLowerCase();
                    document.querySelectorAll('.searchable-item').forEach(item => {
                        const text = item.textContent.toLowerCase();
                        if (text.includes(term)) {
                            item.style.display = '';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

