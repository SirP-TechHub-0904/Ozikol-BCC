@page "/kb/{module}"
@model Ozikol_BCC.Website.Pages.KnowledgeBase.ModuleModel
@{
    ViewData["Title"] = Model.Manual.Title;
    Layout = "_KbLayout";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/kb" class="text-decoration-none">Knowledge Base</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Manual.Title</li>
    </ol>
</nav>

<div class="mb-5">
    <h2 class="fw-bold mb-2">@Model.Manual.Title</h2>
    <p class="text-muted fs-5">@Model.Manual.Overview</p>
</div>

<div class="row g-3">
    @foreach (var article in Model.AccessiblePages)
    {
        <div class="col-12 searchable-item">
            <a href="/kb/@Model.Manual.ModuleFolder/@article.Id" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 kb-list-card">
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 48px; height: 48px; flex-shrink: 0;">
                            <i class="bi bi-file-earmark-text fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold text-dark mb-1">@article.PageTitle</h5>
                            <p class="text-muted fs-7 mb-0 text-truncate" style="max-width: 600px;">@article.PageDescription</p>
                        </div>
                        <div class="text-primary ms-3">
                            <i class="bi bi-chevron-right"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<style>
    .kb-list-card {
        transition: background-color 0.2s ease, transform 0.2s ease;
    }
    .kb-list-card:hover {
        background-color: #f8f9fa;
        transform: translateX(4px);
    }
</style>

