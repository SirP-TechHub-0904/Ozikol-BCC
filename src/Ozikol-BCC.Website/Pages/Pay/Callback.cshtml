@page "/pay/callback"
@model Ozikol_BCC.Website.Pages.Pay.CallbackModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Payment @(Model.IsSuccess ? "Successful" : "Status") – @Model.Transaction?.Category?.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .result-card { border: none; border-radius: 24px; }
        .icon-circle { width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 2.5rem; }
    </style>
</head>
<body>
    <div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="card result-card shadow-lg p-4 p-md-5 text-center" style="max-width: 440px; width: 100%;">

            @if (Model.Transaction == null && Model.SmsTransaction == null)
            {
                <div class="icon-circle bg-danger bg-opacity-10 mx-auto">
                    <i class="bi bi-exclamation-circle text-danger"></i>
                </div>
                <h3 class="fw-bold mb-2">Transaction Not Found</h3>
                <p class="text-muted">This payment reference is invalid or has expired.</p>
                <a href="/pay" class="btn btn-primary rounded-pill px-4 mt-3">Browse Categories</a>
            }
            else if (Model.IsSuccess)
            {
                var title = Model.Transaction != null ? Model.Transaction.Category?.Title : "SMS Wallet Top-up";
                var amount = Model.Transaction != null ? Model.Transaction.Amount : Model.SmsTransaction.Amount;
                var reference = Model.Transaction != null ? Model.Transaction.TransactionReference : Model.SmsTransaction.Reference;

                <div class="icon-circle bg-success bg-opacity-10">
                    <i class="bi bi-check-circle-fill text-success"></i>
                </div>
                <h3 class="fw-bold mb-2">Payment Successful!</h3>
                <p class="text-muted mb-4">Your payment of <strong>@amount.ToString("N2") @title</strong> has been received.</p>

                <div class="bg-light rounded-3 p-3 mb-4 text-start">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Reference</span>
                        <code class="fs-8">@reference</code>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Description</span>
                        <strong>@title</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Amount</span>
                        <strong class="text-success">@amount.ToString("N2")</strong>
                    </div>
                </div>

                @if (Model.SmsTransaction != null)
                {
                    <a href="/BcpMassComm/Dashboard/Wallet/Index" class="btn btn-success rounded-pill px-4 w-100 mb-2">
                        <i class="bi bi-wallet2 me-2"></i> View Wallet
                    </a>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/BcpFinances/Platform/MyFinances" class="btn btn-success rounded-pill px-4 w-100 mb-2">
                        <i class="bi bi-wallet2 me-2"></i> View My Finances
                    </a>
                }
                
                @if (Model.SmsTransaction == null)
                {
                    <a href="/pay" class="btn btn-outline-secondary rounded-pill px-4 w-100">Back to Payments</a>
                }
            }
            else if ((Model.Transaction != null && Model.Transaction.Status == Ozikol_BCC.Domain.Enum.Enum.PaymentStatus.Failed) ||
                     (Model.SmsTransaction != null && Model.SmsTransaction.Status == Ozikol_BCC.Domain.Enum.Enum.PaymentStatus.Failed))
            {
                <div class="icon-circle bg-danger bg-opacity-10">
                    <i class="bi bi-x-circle-fill text-danger"></i>
                </div>
                <h3 class="fw-bold mb-2">Payment Failed</h3>
                <p class="text-muted mb-4">Your payment was declined or could not be processed. Please try again.</p>
                
                @if (Model.SmsTransaction != null)
                {
                    <a href="/BcpMassComm/Dashboard/Wallet/Fund" class="btn btn-danger rounded-pill px-4 w-100 mb-2">
                        <i class="bi bi-arrow-clockwise me-2"></i> Try Again
                    </a>
                }
                else
                {
                    <a href="/pay/@Model.Transaction.BcpFinanceCategoryId" class="btn btn-danger rounded-pill px-4 w-100 mb-2">
                        <i class="bi bi-arrow-clockwise me-2"></i> Try Again
                    </a>
                    <a href="/pay" class="btn btn-outline-secondary rounded-pill px-4 w-100">Back to Payments</a>
                }
            }
            else
            {
                var reference = Model.Transaction != null ? Model.Transaction.TransactionReference : Model.SmsTransaction.Reference;
                <div class="icon-circle bg-warning bg-opacity-10">
                    <i class="bi bi-hourglass-split text-warning"></i>
                </div>
                <h3 class="fw-bold mb-2">Payment Pending</h3>
                <p class="text-muted mb-4">Your payment is being confirmed. This page will update automatically.</p>
                <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">Loading...</span></div>
                <div class="text-muted fs-8 mb-3">Reference: <code>@reference</code></div>
                
                @if (Model.SmsTransaction == null)
                {
                    <a href="/pay" class="btn btn-outline-secondary rounded-pill px-4 w-100">Back to Payments</a>
                }
                
                <script>
                    // Auto-refresh every 5s to catch webhook update
                    setTimeout(() => location.reload(), 5000);
                </script>
            }

            <div class="mt-4 text-muted opacity-50">
                <small><i class="bi bi-shield-check me-1"></i> Secured by PixelPay</small>
            </div>
        </div>
    </div>
</body>
</html>

