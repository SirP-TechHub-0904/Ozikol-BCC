@page "/pay"
@model Ozikol_BCC.Website.Pages.Pay.IndexModel
@{
    ViewData["Title"] = "Payment Portal";
    Layout = null;
    var dues = Model.Categories.Where(c => c.IsCompulsory).ToList();
    var donations = Model.Categories.Where(c => !c.IsCompulsory).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.OrgName â€“ Pay</title>
    <meta name="description" content="Browse active payment categories and make secure online payments." />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .pay-card { border: none; border-radius: 20px; transition: transform .2s, box-shadow .2s; }
        .pay-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,.15) !important; }
        .badge-compulsory { background: #fee2e2; color: #dc2626; }
        .badge-optional { background: #dcfce7; color: #16a34a; }
        .hero-title { font-size: clamp(1.6rem, 4vw, 2.8rem); font-weight: 700; }
    </style>
</head>
<body>
    <div class="container py-5">
        <!-- Header -->
        <div class="text-center text-white mb-5">
            <div class="mb-3">
                <i class="bi bi-wallet2" style="font-size: 3rem; opacity: .9;"></i>
            </div>
            <h1 class="hero-title">@Model.OrgName</h1>
            <p class="opacity-75 fs-5">Secure Online Payments</p>
        </div>

        @if (Model.Categories.Any())
        {
            <!-- Compulsory Dues -->
            @if (dues.Any())
            {
                <h5 class="text-white fw-semibold mb-3 opacity-90"><i class="bi bi-lock-fill me-2"></i> Dues &amp; Subscriptions</h5>
                <div class="row g-4 mb-5">
                    @foreach (var cat in dues)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card pay-card shadow h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="rounded-3 p-2 bg-danger bg-opacity-10 flex-shrink-0">
                                            <i class="bi bi-credit-card-fill text-danger fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">@cat.Title</h6>
                                            <span class="badge badge-compulsory rounded-pill px-2 py-1 fs-8">Compulsory</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <p class="text-muted fs-8 mb-3">@cat.Description</p>
                                    }
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="fw-bold fs-5 text-dark">
                                            @if (cat.FixedAmount.HasValue)
                                            {
                                                <span>â‚¦</span>@cat.FixedAmount.Value.ToString("N2")
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-6 fw-normal">Open Amount</span>
                                            }
                                        </div>
                                        <a href="/pay/@cat.Id" class="btn btn-danger rounded-pill px-4">
                                            Pay Now <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Optional Donations -->
            @if (donations.Any())
            {
                <h5 class="text-white fw-semibold mb-3 opacity-90"><i class="bi bi-heart-fill me-2"></i> Donations &amp; Causes</h5>
                <div class="row g-4">
                    @foreach (var cat in donations)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card pay-card shadow h-100">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-start gap-3 mb-3">
                                        <div class="rounded-3 p-2 bg-success bg-opacity-10 flex-shrink-0">
                                            <i class="bi bi-heart-fill text-success fs-4"></i>
                                        </div>
                                        <div>
                                            <h6 class="fw-bold mb-1">@cat.Title</h6>
                                            <span class="badge badge-optional rounded-pill px-2 py-1 fs-8">Optional</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <p class="text-muted fs-8 mb-3">@cat.Description</p>
                                    }
                                    <div class="d-flex justify-content-end">
                                        <a href="/pay/@cat.Id" class="btn btn-success rounded-pill px-4">
                                            Donate <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center text-white py-5">
                <i class="bi bi-inbox fs-1 opacity-50 d-block mb-3"></i>
                <h4 class="fw-bold">No Active Payment Categories</h4>
                <p class="opacity-75">Please check back later or contact the admin.</p>
            </div>
        }

        <div class="text-center text-white mt-5 opacity-50">
            <small><i class="bi bi-shield-check me-1"></i> Secured by PixelPay</small>
        </div>
    </div>
        <!-- Inline Help Section -->
        <div class="mt-5 pt-4 border-top border-white border-opacity-25">
            <h5 class="text-white fw-semibold mb-3 opacity-90 text-center">
                <i class="bi bi-question-circle me-2"></i> How Payments Work
            </h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card border-0 rounded-4 h-100" style="background: rgba(255,255,255,.12); color: white;">
                        <div class="card-body p-4">
                            <div class="fs-2 mb-2">â‘ </div>
                            <h6 class="fw-bold">Choose a Category</h6>
                            <p class="opacity-75 fs-8 mb-0">Browse the available dues and donation causes. Compulsory payments are required from all members; donations are optional.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 rounded-4 h-100" style="background: rgba(255,255,255,.12); color: white;">
                        <div class="card-body p-4">
                            <div class="fs-2 mb-2">â‘¡</div>
                            <h6 class="fw-bold">Fill Your Details</h6>
                            <p class="opacity-75 fs-8 mb-0">Enter your name, email, and phone number. If you are a registered member and already logged in, your details are pre-filled automatically.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 rounded-4 h-100" style="background: rgba(255,255,255,.12); color: white;">
                        <div class="card-body p-4">
                            <div class="fs-2 mb-2">â‘¢</div>
                            <h6 class="fw-bold">Pay Securely</h6>
                            <p class="opacity-75 fs-8 mb-0">You will be redirected to PixelPay's secure checkout. Pay by Card, Bank Transfer, USSD, or PayAttitude. Your receipt is recorded automatically.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center text-white mt-5 opacity-50">
            <small><i class="bi bi-shield-check me-1"></i> Secured by PixelPay</small>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

