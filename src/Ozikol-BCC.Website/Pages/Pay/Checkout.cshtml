@page "/pay/{id:guid}"
@model Ozikol_BCC.Website.Pages.Pay.CheckoutModel
@{
    ViewData["Title"] = Model.Category?.Title ?? "Checkout";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Category?.Title – Pay</title>
    <meta name="description" content="Complete your payment securely." />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; }
        .checkout-card { border: none; border-radius: 24px; }
        .provider-card { transition: all .2s; border-color: #dee2e6 !important; }
        .provider-card:hover { border-color: #6c63ff !important; background: #f8f7ff; }
        .provider-card.selected { border-color: #6c63ff !important; background: #f0eeff; box-shadow: 0 0 0 2px #6c63ff33; }
    </style>
</head>
<body>
    <div class="container py-5" style="max-width: 540px;">
        <!-- Back Link -->
        <a href="/pay" class="text-white text-decoration-none d-inline-flex align-items-center gap-2 mb-4 opacity-75">
            <i class="bi bi-arrow-left"></i> All Categories
        </a>

        @if (Model.Category == null)
        {
            <div class="card checkout-card shadow-lg p-5 text-center">
                <i class="bi bi-exclamation-circle text-danger fs-1 mb-3 d-block"></i>
                <h4 class="fw-bold">Category Not Found</h4>
                <a href="/pay" class="btn btn-primary rounded-pill mt-3">Back to Categories</a>
            </div>
        }
        else
        {
            <div class="card checkout-card shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <!-- Category Info -->
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex p-3 mb-3">
                            <i class="bi @(Model.Category.IsCompulsory ? "bi-credit-card-fill text-danger" : "bi-heart-fill text-success") fs-2"></i>
                        </div>
                        <h2 class="h4 fw-bold mb-1">@Model.Category.Title</h2>
                        @if (!string.IsNullOrEmpty(Model.Category.Description))
                        {
                            <p class="text-muted mb-0">@Model.Category.Description</p>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        var isCredError = Model.StatusMessage.Contains("500") || Model.StatusMessage.Contains("Wrong details");
                        <div class="alert @(Model.StatusMessage.StartsWith("Error") ? "alert-danger" : "alert-info") rounded-3 mb-4">
                            <div class="fw-semibold mb-1">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                @(isCredError ? "Payment Gateway Error" : "Notice")
                            </div>
                            <div class="small">
                                @if (isCredError)
                                {
                                    <span>PixelPay rejected the request — the <strong>Client ID or Secret Key</strong> saved in settings appear to be incorrect.</span>
                                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                    {
                                        <br />
                                        <a href="/BcpSetting/Dashboard" class="alert-link">→ Go to BCP Settings to fix PixelPay credentials</a>
                                    }
                                    <hr class="my-2" />
                                    <div class="small text-muted">@Model.StatusMessage</div>
                                }
                                else
                                {
                                    @Model.StatusMessage
                                }
                            </div>
                        </div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CategoryId" value="@Model.Category.Id" />

                        @if (Model.IsLoggedIn)
                        {
                            <div class="alert alert-primary rounded-3 d-flex align-items-center gap-3 mb-4 border-0 bg-primary bg-opacity-10">
                                <i class="bi bi-person-check-fill text-primary fs-4"></i>
                                <div>
                                    <div class="fw-bold text-primary">Paying as @Model.PrefillName</div>
                                    <div class="text-muted fs-8">@Model.PrefillEmail</div>
                                </div>
                            </div>
                        }

                        <div class="mb-3 @(Model.IsLoggedIn ? "d-none" : "")">
                            <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg rounded-3" name="DonorName"
                                   value="@Model.PrefillName"
                                   @(Model.IsLoggedIn ? "readonly" : "required")
                                   placeholder="Enter your full name" />
                        </div>
                        <div class="mb-3 @(Model.IsLoggedIn ? "d-none" : "")">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control form-control-lg rounded-3" name="DonorEmail"
                                   value="@Model.PrefillEmail"
                                   @(Model.IsLoggedIn ? "readonly" : "required")
                                   placeholder="your@email.com" />
                        </div>
                        @if (!Model.IsLoggedIn)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Phone Number</label>
                                <input type="tel" class="form-control form-control-lg rounded-3" name="DonorPhone"
                                       value="@Model.PrefillPhone"
                                       placeholder="+1 234 567 8900" />
                            </div>
                        }
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                            @if (Model.Category.FixedAmount.HasValue)
                            {
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light border-end-0">₦</span>
                                    <input type="number" step="0.01" class="form-control rounded-end-3 bg-light"
                                           name="Amount" value="@Model.Category.FixedAmount" readonly />
                                </div>
                                <div class="form-text">Amount is fixed for this payment category.</div>
                            }
                            else
                            {
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">₦</span>
                                    <input type="number" step="0.01" min="0.01" class="form-control rounded-end-3"
                                           name="Amount" required placeholder="Enter amount" />
                                </div>
                                <div class="form-text">You may enter any amount you wish to contribute.</div>
                            }
                        </div>

                        <!-- Payment Provider Selector -->
                        @{
                            var bothAvailable = Model.PixelPayAvailable && Model.PaystackAvailable;
                            var noneAvailable = !Model.PixelPayAvailable && !Model.PaystackAvailable;
                            var onlyPixelPay = Model.PixelPayAvailable && !Model.PaystackAvailable;
                            var onlyPaystack = !Model.PixelPayAvailable && Model.PaystackAvailable;
                        }

                        @if (noneAvailable)
                        {
                            <div class="alert alert-warning rounded-3 mb-4">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>No payment method available.</strong>
                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                {
                                    <br /><a href="/BcpSetting/Dashboard" class="alert-link">→ Configure a payment provider in BCP Settings</a>
                                }
                            </div>
                        }
                        else if (onlyPixelPay)
                        {
                            <input type="hidden" name="PaymentProvider" value="PixelPay" />
                        }
                        else if (onlyPaystack)
                        {
                            <input type="hidden" name="PaymentProvider" value="Paystack" />
                        }
                        else
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Pay with</label>
                                <div class="d-flex gap-3">
                                    @if (Model.PixelPayAvailable)
                                    {
                                        <label class="flex-fill" style="cursor:pointer;">
                                            <input type="radio" name="PaymentProvider" value="PixelPay" class="d-none provider-radio" required />
                                            <div class="provider-card border rounded-3 p-3 text-center h-100" data-provider="PixelPay">
                                                <i class="bi bi-credit-card-2-front-fill fs-2 text-primary d-block mb-1"></i>
                                                <div class="fw-semibold small">PixelPay</div>
                                            </div>
                                        </label>
                                    }
                                    @if (Model.PaystackAvailable)
                                    {
                                        <label class="flex-fill" style="cursor:pointer;">
                                            <input type="radio" name="PaymentProvider" value="Paystack" class="d-none provider-radio" required />
                                            <div class="provider-card border rounded-3 p-3 text-center h-100" data-provider="Paystack">
                                                <i class="bi bi-wallet2 fs-2 text-success d-block mb-1"></i>
                                                <div class="fw-semibold small">Paystack</div>
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>
                        }

                        @if (!noneAvailable)
                        {
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3">
                                <i class="bi bi-lock-fill me-2"></i> Proceed to Secure Payment
                            </button>
                        }
                    </form>

                    <div class="text-center mt-4">
                        <small class="text-muted"><i class="bi bi-shield-check me-1"></i> Secured Payment · Your data is safe</small>
                    </div>
                </div>
            </div>
        }
    </div>
        <!-- Inline Help -->
        <div class="mt-4">
            <div class="card border-0 rounded-4" style="background: rgba(255,255,255,.12); color: white;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-question-circle me-2"></i> Payment Help</h6>
                    <div class="accordion accordion-flush" id="payHelpAccordion">
                        <div class="accordion-item border-0 bg-transparent text-white mb-2">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed bg-transparent text-white fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                    What payment methods are accepted?
                                </button>
                            </h2>
                            <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#payHelpAccordion">
                                <div class="accordion-body text-white opacity-75 fs-8">
                                    PixelPay accepts Visa, Mastercard, Verve cards, Bank Transfer (USSD / Pay-by-Transfer), and PayAttitude. All channels are available on the checkout page.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-0 bg-transparent text-white mb-2">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed bg-transparent text-white fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    Is my payment secure?
                                </button>
                            </h2>
                            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#payHelpAccordion">
                                <div class="accordion-body text-white opacity-75 fs-8">
                                    Yes. All payments are processed by PixelPay which is PCI-DSS compliant and supports 3D Secure authentication. We never store your card details.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-0 bg-transparent text-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed bg-transparent text-white fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    When will my payment be confirmed?
                                </button>
                            </h2>
                            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#payHelpAccordion">
                                <div class="accordion-body text-white opacity-75 fs-8">
                                    Card and transfer payments are usually confirmed instantly. If you are a registered member, your outstanding due will disappear from your dashboard automatically once confirmed.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Highlight selected provider card
        document.querySelectorAll('.provider-radio').forEach(radio => {
            radio.addEventListener('change', () => {
                document.querySelectorAll('.provider-card').forEach(c => c.classList.remove('selected'));
                radio.closest('label').querySelector('.provider-card').classList.add('selected');
            });
        });
    </script>
</body>
</html>

