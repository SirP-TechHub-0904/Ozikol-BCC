@page
@model Ozikol_BCC.Website.Pages.UnsubscribeModel
@{
    Layout = null;
    ViewData["Title"] = "Unsubscribe";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <div class="container my-5 py-5 text-center">
        @if (Model.Success)
        {
            <div class="card border-0 shadow-sm mx-auto" style="max-width: 500px;">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="mb-3 fw-bold">Successfully Unsubscribed</h3>
                    <p class="text-muted mb-4">
                        We've removed <strong>@Model.Email</strong> from our active mailing lists. You will no longer receive newsletter campaigns from us.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm mx-auto" style="max-width: 500px;">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-circle text-warning" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="mb-3 fw-bold">Oops!</h3>
                    <p class="text-muted mb-4">
                        You have already been unsubscribed. If you received this email, it means it was a scheduled campaign that was queued prior to your unsubscription.
                    </p>
                </div>
            </div>
        }
    </div>
</body>
</html>

