@using Ozikol_BCC.Application.Repository.Services
@inject ISettingsService SettingsService
@{
    var config = await SettingsService.GetConfigAsync();
    var themeData = Context.Request.Query["previewTheme"].FirstOrDefault() ?? config.TemplateLayoutKey;

    if (!string.IsNullOrEmpty(themeData))
    {
        Layout = $"/Pages/Shared/Layouts/{themeData}.cshtml";
    }
}
