<Project>
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0168;CS0219;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625;CS8981</NoWarn>
    <UseSharedCompilation>false</UseSharedCompilation>
    <CopyRetryCount>10</CopyRetryCount>
    <CopyRetryDelayMilliseconds>250</CopyRetryDelayMilliseconds>
  </PropertyGroup>
</Project>
